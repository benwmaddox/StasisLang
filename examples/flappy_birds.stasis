import "../src/stdlib/stdlib.stasis";
import "flappy_birds_core.stasis";
import "../src/stdlib/graphics.stasis";

const SCREEN_W: i32 = 400;
const SCREEN_H: i32 = 240;
const SCALE: f32 = 2.0;

const KEY_SPACE: i32 = 44;

global spr_bird: i32;
global spr_pipe: i32;

function init_assets() {
    spr_bird = gfx_load_sprite("assets_src/flappy-birds/bird.svg", 256, 256);
    spr_pipe = gfx_load_sprite("assets_src/flappy-birds/pipe.svg", 256, 256);
}

function to_screen_x(x: f32): f32 {
    return x * SCALE;
}

function to_screen_y(y: f32): f32 {
    return y * SCALE;
}

function draw_pipe(px: f32, gap: f32) {
    let pipe_w_px: i32 = f32_to_i32(PIPE_W * SCALE);

    let top_h: f32 = gap - GAP_HALF;
    if (top_h > 0.5) {
        let pipe_h_px: i32 = f32_to_i32(top_h * SCALE);
        let cx_top: i32 = f32_to_i32(to_screen_x(px + PIPE_W * 0.5));
        let cy_top: i32 = f32_to_i32(to_screen_y(top_h * 0.5));
        gfx_draw_sprite(spr_pipe, cx_top, cy_top, pipe_w_px, pipe_h_px, 0, 255);
    }

    let bottom_start: f32 = gap + GAP_HALF;
    let bottom_h: f32 = WORLD_H - bottom_start;
    if (bottom_h > 0.5) {
        let pipe_h_px2: i32 = f32_to_i32(bottom_h * SCALE);
        let cx_bottom: i32 = f32_to_i32(to_screen_x(px + PIPE_W * 0.5));
        let cy_bottom: i32 = f32_to_i32(to_screen_y(bottom_start + bottom_h * 0.5));
        gfx_draw_sprite(spr_pipe, cx_bottom, cy_bottom, pipe_w_px, pipe_h_px2, 0, 255);
    }
}

function draw_frame() {
    begin_frame();
    clear(0.05, 0.07, 0.12, 1.0);

    gfx_poll_reload(spr_bird);
    gfx_poll_reload(spr_pipe);

    let i: i32 = 0;
    for (i = 0; i < 3; i = i + 1) {
        draw_pipe(pipe_x[i], pipe_gap_y[i]);
    }

    let bird_w_px: i32 = f32_to_i32(BIRD_W * SCALE);
    let bird_h_px: i32 = f32_to_i32(BIRD_H * SCALE);
    let bird_cx: i32 = f32_to_i32(to_screen_x(BIRD_X + BIRD_W * 0.5));
    let bird_cy: i32 = f32_to_i32(to_screen_y(bird_y + BIRD_H * 0.5));
    gfx_draw_sprite(spr_bird, bird_cx, bird_cy, bird_w_px, bird_h_px, 0, 255);

    end_frame();
}

function main(): i32 {
    if (!init_window(SCREEN_W, SCREEN_H, "Stasis Flappy")) {
        return 1;
    }

    init_assets();
    reset();

    // Stasis does not currently support `while`; use a `for` as a conditional loop.
    let loop: i32 = 0;
    for (loop = 0; !should_quit(); loop = 0) {
        let do_flap: bool = is_key_down(KEY_SPACE);
        if (!step(do_flap)) {
            reset();
        }
        draw_frame();
        sleep_ms(16);
    }
    return 0;
}
