import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/ui_button_9slice.stasis";

global font_handle: i32;
global button_top_left: i32;
global button_top: i32;
global button_top_right: i32;
global button_left: i32;
global button_center: i32;
global button_right: i32;
global button_bottom_left: i32;
global button_bottom: i32;
global button_bottom_right: i32;
const BUTTON_SLICE_W: f32 = 32.0;
const BUTTON_SLICE_H: f32 = 32.0;
global icon_play: i32;
global icon_star: i32;

function load_assets(): void {
    button_top_left = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_00.png", 32, 32);
    button_top = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_01.png", 32, 32);
    button_top_right = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_02.png", 32, 32);
    button_left = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_10.png", 32, 32);
    button_center = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_11.png", 32, 32);
    button_right = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_12.png", 32, 32);
    button_bottom_left = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_20.png", 32, 32);
    button_bottom = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_21.png", 32, 32);
    button_bottom_right = gfx_load_sprite("docs/assets/ui/button_9slice_dark/btn_9slice_dark_22.png", 32, 32);

    icon_play = gfx_load_sprite("docs/assets/ui/button_9slice_dark/icon_play.png", 64, 64);
    icon_star = gfx_load_sprite("docs/assets/ui/button_9slice_dark/icon_star.png", 64, 64);
}

function draw_ui(): void {
    let row_y: f32 = 70.0;
    let row_x: f32 = 40.0;
    let row_w: f32 = 720.0;
    let row_h: f32 = 56.0;
    let gap: f32 = 16.0;

    let count: i32 = 3;
    let w: f32 = ui_row_button_width(row_w, count, gap);
    let h: f32 = row_h;
    let y0: f32 = row_y;

    let x0: f32 = ui_row_button_x(row_x, 0, w, gap);
    let x1: f32 = ui_row_button_x(row_x, 1, w, gap);
    let x2: f32 = ui_row_button_x(row_x, 2, w, gap);

    ui_draw_button_9slice(
        button_top_left, button_top, button_top_right,
        button_left, button_center, button_right,
        button_bottom_left, button_bottom, button_bottom_right,
        BUTTON_SLICE_W, BUTTON_SLICE_H,
        x0, y0, w, h, "Play", font_handle,
        0.96, 0.96, 0.96, 1.0, icon_play, 1.0, 16.0, 16.0);
    ui_draw_button_9slice(
        button_top_left, button_top, button_top_right,
        button_left, button_center, button_right,
        button_bottom_left, button_bottom, button_bottom_right,
        BUTTON_SLICE_W, BUTTON_SLICE_H,
        x1, y0, w, h, "Favorites", font_handle,
        0.96, 0.96, 0.96, 1.0, icon_star, 1.0, 16.0, 16.0);
    ui_draw_button_9slice(
        button_top_left, button_top, button_top_right,
        button_left, button_center, button_right,
        button_bottom_left, button_bottom, button_bottom_right,
        BUTTON_SLICE_W, BUTTON_SLICE_H,
        x2, y0, w, h, "No Icon", font_handle,
        0.96, 0.96, 0.96, 1.0, 0, 1.0, 16.0, 16.0);
}

function main(): i32 {
    let ok: bool = init_window(800, 480, "Stasis 9-slice Buttons");
    if (!ok) {
        return 1;
    }

    font_handle = 0;
    load_assets();

    let running: i32 = 1;
    for (; running == 1; ) {
        if (should_quit()) {
            running = 0;
        }

        begin_frame();
        clear(0.04, 0.06, 0.09, 1.0);
        draw_ui();
        end_frame();
        sleep_ms(16);
    }

    return 0;
}
