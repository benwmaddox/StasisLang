global Input {
    touch_x: i32;
    touch_y: i32;
    touch_active: i32;
    screen_w: i32;
    screen_h: i32;
}

global GameState {
    tick_count: i32;
    screen_w: i32;
    screen_h: i32;
    player_y: i32;
    ai_y: i32;
    ball_x: i32;
    ball_y: i32;
    ball_vx: i32;
    ball_vy: i32;
    ball_age_ticks: i32;
    enemy_paddle_speed_x100: i32;
    player_score: i32;
    ai_score: i32;
}

global Render {
    command_schema_version: i32;
    command_count: i32;
    command0_kind: i32;
    command0_x: i32;
    command0_y: i32;
    command0_w: i32;
    command0_h: i32;
    command0_color: i32;
    command0_asset: i32;
    command0_rotation_degrees: i32;
    command0_alpha: i32;
    command0_clip_x: i32; command0_clip_y: i32; command0_clip_w: i32; command0_clip_h: i32;
    command1_kind: i32;
    command1_x: i32;
    command1_y: i32;
    command1_w: i32;
    command1_h: i32;
    command1_color: i32;
    command1_asset: i32;
    command1_rotation_degrees: i32;
    command1_alpha: i32;
    command1_clip_x: i32; command1_clip_y: i32; command1_clip_w: i32; command1_clip_h: i32;
    command2_kind: i32;
    command2_x: i32;
    command2_y: i32;
    command2_w: i32;
    command2_h: i32;
    command2_color: i32;
    command2_asset: i32;
    command2_rotation_degrees: i32;
    command2_alpha: i32;
    command2_clip_x: i32; command2_clip_y: i32; command2_clip_w: i32; command2_clip_h: i32;
    command3_kind: i32;
    command3_x: i32;
    command3_y: i32;
    command3_w: i32;
    command3_h: i32;
    command3_color: i32;
    command3_asset: i32;
    command3_rotation_degrees: i32;
    command3_alpha: i32;
    command3_clip_x: i32; command3_clip_y: i32; command3_clip_w: i32; command3_clip_h: i32;
    command4_kind: i32;
    command4_x: i32;
    command4_y: i32;
    command4_w: i32;
    command4_h: i32;
    command4_color: i32;
    command4_asset: i32;
    command4_rotation_degrees: i32;
    command4_alpha: i32;
    command4_clip_x: i32; command4_clip_y: i32; command4_clip_w: i32; command4_clip_h: i32;
}

function pong_game_main(): void {
    init();
}

function init(): void {
    GameState.tick_count = 0;
    GameState.screen_w = 360;
    GameState.screen_h = 640;
    GameState.player_y = 320;
    GameState.ai_y = 320;
    GameState.ball_x = 180;
    GameState.ball_y = 320;
    GameState.ball_vx = 3;
    GameState.ball_vy = 3;
    GameState.ball_age_ticks = 0;
    GameState.enemy_paddle_speed_x100 = 1500;
    GameState.player_score = 0;
    GameState.ai_score = 0;
}

function pong_game_tick(): void {
    GameState.tick_count += 1;

    update_input();
    update_player_paddle();
    update_enemy_paddle();
    update_ball();
}

function update_input(): void {
    if (Input.screen_w > 0) {
        GameState.screen_w = Input.screen_w;
    }

    if (Input.screen_h > 0) {
        GameState.screen_h = Input.screen_h;
    }
}

function update_player_paddle(): void {
    if (Input.touch_active != 0) {
        GameState.player_y = Input.touch_y;
    }

    if (GameState.player_y < 36) {
        GameState.player_y = 36;
    }

    if (GameState.player_y > GameState.screen_h - 36) {
        GameState.player_y = GameState.screen_h - 36;
    }
}

function update_enemy_paddle(): void {
    if (GameState.ball_age_ticks <= 0) {
        GameState.enemy_paddle_speed_x100 = 1500;
    } else if (GameState.ball_age_ticks >= 3600) {
        GameState.enemy_paddle_speed_x100 = 250;
    } else {
        GameState.enemy_paddle_speed_x100 = 1500 - ((GameState.ball_age_ticks * 1250) / 3600);
    }

    if (GameState.enemy_paddle_speed_x100 < 250) {
        GameState.enemy_paddle_speed_x100 = 250;
    }

    let enemy_speed = GameState.enemy_paddle_speed_x100 / 100;

    if (GameState.ai_y < GameState.ball_y) {
        GameState.ai_y += enemy_speed;
    }

    if (GameState.ai_y > GameState.ball_y) {
        GameState.ai_y -= enemy_speed;
    }

    if (GameState.ai_y < 36) {
        GameState.ai_y = 36;
    }

    if (GameState.ai_y > GameState.screen_h - 36) {
        GameState.ai_y = GameState.screen_h - 36;
    }
}

function update_ball(): void {
    GameState.ball_age_ticks += 1;

    GameState.ball_x += GameState.ball_vx;
    GameState.ball_y += GameState.ball_vy;

    if (GameState.ball_y < 12) {
        GameState.ball_y = 12;
        GameState.ball_vy = 0 - GameState.ball_vy;
    }

    if (GameState.ball_y > GameState.screen_h - 12) {
        GameState.ball_y = GameState.screen_h - 12;
        GameState.ball_vy = 0 - GameState.ball_vy;
    }

    if (ball_overlaps_vertical_paddle(28, GameState.player_y) && GameState.ball_vx < 0) {
        GameState.ball_vx = 3;
    }

    if (ball_overlaps_vertical_paddle(GameState.screen_w - 28, GameState.ai_y) && GameState.ball_vx > 0) {
        GameState.ball_vx = -3;
    }

    if (GameState.ball_x < 0) {
        GameState.ai_score += 1;
        reset_ball();
    }

    if (GameState.ball_x > GameState.screen_w) {
        GameState.player_score += 1;
        reset_ball();
    }
}

function ball_overlaps_vertical_paddle(paddle_x: i32, paddle_y: i32): bool {
    let dx = GameState.ball_x - paddle_x;
    let dy = GameState.ball_y - paddle_y;

    return dx * dx < 324 && dy * dy < 2116;
}

function reset_ball(): void {
    GameState.ball_x = GameState.screen_w / 2;
    GameState.ball_y = GameState.screen_h / 2;
    GameState.ball_vx = 0 - GameState.ball_vx;
    GameState.ball_age_ticks = 0;
    GameState.enemy_paddle_speed_x100 = 1500;
}

function pong_game_render(): void {
    Render.command_schema_version = 3;
    Render.command_count = 5;

    Render.command0_kind = 1;
    Render.command0_x = 0;
    Render.command0_y = 0;
    Render.command0_w = GameState.screen_w;
    Render.command0_h = GameState.screen_h;
    Render.command0_asset = 0;
    Render.command0_color = 990236;
    Render.command0_rotation_degrees = 0;
    Render.command0_alpha = 255;

    Render.command1_kind = 1;
    Render.command1_x = 24;
    Render.command1_y = GameState.player_y - 36;
    Render.command1_w = 10;
    Render.command1_h = 72;
    Render.command1_asset = 0;
    Render.command1_color = 6013118;
    Render.command1_rotation_degrees = 0;
    Render.command1_alpha = 255;

    Render.command2_kind = 1;
    Render.command2_x = GameState.screen_w - 34;
    Render.command2_y = GameState.ai_y - 36;
    Render.command2_w = 10;
    Render.command2_h = 72;
    Render.command2_asset = 0;
    Render.command2_color = 6013118;
    Render.command2_rotation_degrees = 0;
    Render.command2_alpha = 255;

    Render.command3_kind = 2;
    Render.command3_x = GameState.ball_x - 7;
    Render.command3_y = GameState.ball_y - 7;
    Render.command3_w = 14;
    Render.command3_h = 14;
    Render.command3_asset = -1520461853;
    Render.command3_color = 16777215;
    Render.command3_rotation_degrees = (GameState.tick_count * 3) % 360;
    Render.command3_alpha = 255;

    Render.command4_kind = 1;
    Render.command4_x = (GameState.screen_w / 2) - 1;
    Render.command4_y = 0;
    Render.command4_w = 2;
    Render.command4_h = GameState.screen_h;
    Render.command4_asset = 0;
    Render.command4_color = 4473924;
    Render.command4_rotation_degrees = 0;
    Render.command4_alpha = 255;

    Render.command0_clip_x = 0; Render.command0_clip_y = 0; Render.command0_clip_w = GameState.screen_w; Render.command0_clip_h = GameState.screen_h;
    Render.command1_clip_x = 0; Render.command1_clip_y = 0; Render.command1_clip_w = GameState.screen_w; Render.command1_clip_h = GameState.screen_h;
    Render.command2_clip_x = 0; Render.command2_clip_y = 0; Render.command2_clip_w = GameState.screen_w; Render.command2_clip_h = GameState.screen_h;
    Render.command3_clip_x = 0; Render.command3_clip_y = 0; Render.command3_clip_w = GameState.screen_w; Render.command3_clip_h = GameState.screen_h;
    Render.command4_clip_x = 0; Render.command4_clip_y = 0; Render.command4_clip_w = GameState.screen_w; Render.command4_clip_h = GameState.screen_h;
}

function pong_game_on_code_swap(): void {
    pong_game_render();
}

@link("stasis_graphics");
global host_i32: i32[768];
global host_f32: f32[64];
global gfx_cmd_i32: i32[34848];
global gfx_cmd_f32: f32[92292];
global gfx_cmd_u8: u8[65536];
global PongHost { ball_sprite: i32; }
extern function gfx_load_sprite(path: string, max_w: i32, max_h: i32): i32;

function pong_host_line(x1: i32, y1: i32, x2: i32, y2: i32, r: f32, g: f32, b: f32): void {
    let index: i32 = gfx_cmd_i32[3];
    if (index >= 10000) { return; }
    let base: i32 = 4 + index * 8;
    gfx_cmd_f32[base].from_i32(x1); gfx_cmd_f32[base + 1].from_i32(y1);
    gfx_cmd_f32[base + 2].from_i32(x2); gfx_cmd_f32[base + 3].from_i32(y2);
    gfx_cmd_f32[base + 4] = r; gfx_cmd_f32[base + 5] = g;
    gfx_cmd_f32[base + 6] = b; gfx_cmd_f32[base + 7] = 1.0;
    gfx_cmd_i32[3] = index + 1;
}

function pong_host_filled_rect(x: i32, y: i32, w: i32, h: i32, r: f32, g: f32, b: f32): void {
    let column: i32 = 0;
    for (column = 0; column < w; column += 1) {
        pong_host_line(x + column, y, x + column, y + h, r, g, b);
    }
}

function pong_host_render(): void {
    pong_game_render();
    gfx_cmd_i32[0] = 1196967473; gfx_cmd_i32[1] = 1; gfx_cmd_i32[2] = 1;
    gfx_cmd_i32[3] = 0; gfx_cmd_i32[4] = 0; gfx_cmd_i32[7] = 0; gfx_cmd_i32[9] = 0;
    gfx_cmd_f32[0] = 0.0588; gfx_cmd_f32[1] = 0.0667;
    gfx_cmd_f32[2] = 0.1098; gfx_cmd_f32[3] = 1.0;
    pong_host_filled_rect(24, GameState.player_y - 36, 10, 72, 0.357, 0.749, 0.494);
    pong_host_filled_rect(GameState.screen_w - 34, GameState.ai_y - 36, 10, 72, 0.357, 0.749, 0.494);
    pong_host_filled_rect((GameState.screen_w / 2) - 1, 0, 2, GameState.screen_h, 0.267, 0.267, 0.267);
    gfx_cmd_i32[32] = PongHost.ball_sprite;
    gfx_cmd_i32[33] = GameState.ball_x - 7; gfx_cmd_i32[34] = GameState.ball_y - 7;
    gfx_cmd_i32[35] = 14; gfx_cmd_i32[36] = 14;
    gfx_cmd_i32[37] = (GameState.tick_count * 3) % 360; gfx_cmd_i32[38] = 255;
    gfx_cmd_i32[4] = 1;
    gfx_cmd_i32[2] = 3;
}

function main(): void {
    pong_game_main();
    PongHost.ball_sprite = gfx_load_sprite("../assets/ball.svg", 32, 32);
    pong_host_render();
}

function tick(): void {
    Input.screen_w = host_i32[5]; Input.screen_h = host_i32[6];
    Input.touch_active = host_i32[545];
    let touch_x: i32; touch_x.from_f32(host_f32[0]); Input.touch_x = touch_x;
    let touch_y: i32; touch_y.from_f32(host_f32[1]); Input.touch_y = touch_y;
    pong_game_tick();
}

function render(): void { pong_host_render(); }
function on_code_swap(): void { pong_host_render(); }
