import "/vendor/stasis/src/stdlib/graphics.stasis";

global host_i32: i32[768];
global host_f32: f32[64];

global PongHost {
    ball_sprite: Sprite;
    paddle_sprite: Sprite;
    center_sprite: Sprite;
    writer: SpriteRunWriter;
}

function pong_host_write_sprite(sprite_ref: SpriteRef, x: i32, y: i32, w: i32, h: i32, rotation: i32): bool {
    let width: f32 = i32_to_f32(w);
    let height: f32 = i32_to_f32(h);
    return PongHost.writer.write(
        sprite_ref,
        -1,
        0,
        i32_to_f32(x),
        i32_to_f32(y),
        width,
        height,
        0.0,
        0.0,
        0.0,
        0.0,
        width * 0.5,
        height * 0.5,
        1.0,
        1.0,
        i32_to_f32(rotation)
    );
}

function pong_host_render(): void {
    begin_frame();
    clear(0.0588, 0.0667, 0.1098, 1.0);
    if (PongHost.writer.reserve(4, -1, 0, 0, 0, 0, 0)) {
        let written: i32 = 0;
        if (
            pong_host_write_sprite(
                PongHost.paddle_sprite.reference(),
                Render.command1_x,
                Render.command1_y,
                Render.command1_w,
                Render.command1_h,
                0
            )
        ) {
            written += 1;
        }
        if (
            pong_host_write_sprite(
                PongHost.paddle_sprite.reference(),
                Render.command2_x,
                Render.command2_y,
                Render.command2_w,
                Render.command2_h,
                0
            )
        ) {
            written += 1;
        }
        if (
            pong_host_write_sprite(
                PongHost.center_sprite.reference(),
                Render.command4_x,
                Render.command4_y,
                Render.command4_w,
                Render.command4_h,
                0
            )
        ) {
            written += 1;
        }
        if (
            pong_host_write_sprite(
                PongHost.ball_sprite.reference(),
                Render.command3_x,
                Render.command3_y,
                Render.command3_w,
                Render.command3_h,
                (GameState.tick_count * 3) % 360
            )
        ) {
            written += 1;
        }
        if (written == 4) {
            PongHost.writer.finalize(4);
        } else {
            PongHost.writer.cancel();
        }
    }
    end_frame();
}
