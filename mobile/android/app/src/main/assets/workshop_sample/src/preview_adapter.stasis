import "/vendor/stasis/src/stdlib/graphics.stasis";

global host_i32: i32[768];
global host_f32: f32[64];

global PongHost {
    ball_sprite: Sprite;
    paddle_sprite: Sprite;
    center_sprite: Sprite;
}

function pong_host_render(): void {
    begin_frame();
    clear(0.0588, 0.0667, 0.1098, 1.0);
    draw_sprite(
        PongHost.paddle_sprite.handle,
        i32_to_f32(Render.command1_x),
        i32_to_f32(Render.command1_y),
        i32_to_f32(Render.command1_w),
        i32_to_f32(Render.command1_h),
        0,
        255
    );
    draw_sprite(
        PongHost.paddle_sprite.handle,
        i32_to_f32(Render.command2_x),
        i32_to_f32(Render.command2_y),
        i32_to_f32(Render.command2_w),
        i32_to_f32(Render.command2_h),
        0,
        255
    );
    draw_sprite(
        PongHost.center_sprite.handle,
        i32_to_f32(Render.command4_x),
        i32_to_f32(Render.command4_y),
        i32_to_f32(Render.command4_w),
        i32_to_f32(Render.command4_h),
        0,
        255
    );
    draw_sprite(
        PongHost.ball_sprite.handle,
        i32_to_f32(Render.command3_x),
        i32_to_f32(Render.command3_y),
        i32_to_f32(Render.command3_w),
        i32_to_f32(Render.command3_h),
        (GameState.tick_count * 3) % 360,
        255
    );
    end_frame();
}
