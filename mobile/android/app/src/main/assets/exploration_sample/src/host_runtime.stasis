import "/vendor/stasis/src/stdlib/graphics.stasis";

function exploration_host_request_window(): void {
    init_window(360, 640, "Exploration Garden");
}

function exploration_host_sync_input(): void {
    Input.screen_w.from_f32(gfx_logical_width());
    Input.screen_h.from_f32(gfx_logical_height());
    if (Input.screen_w <= 0) {
        Input.screen_w = 360;
    }
    if (Input.screen_h <= 0) {
        Input.screen_h = 640;
    }
    Input.touch_active = 0;
    if (input_pointer_count() > 0) {
        Input.touch_active = 1;
        Input.touch_x.from_f32(input_pointer_x_logical(0));
        Input.touch_y.from_f32(input_pointer_y_logical(0));
    }
}

function exploration_host_begin_frame(): void {
    begin_frame();
    if (GameState.tutorial_stage >= 2) {
        clear(0.09, 0.24, 0.13, 1.0);
    } else {
        clear(0.06, 0.10, 0.18, 1.0);
    }
}

function exploration_host_sprite(handle: i32, x: i32, y: i32, w: i32, h: i32, rotation: i32, alpha: i32): void {
    draw_sprite(handle, i32_to_f32(x), i32_to_f32(y), i32_to_f32(w), i32_to_f32(h), rotation, alpha);
}

function exploration_host_line(x1: i32, y1: i32, x2: i32, y2: i32, r: f32, g: f32, b: f32): void {
    draw_line(i32_to_f32(x1), i32_to_f32(y1), i32_to_f32(x2), i32_to_f32(y2), r, g, b, 1.0);
}

function exploration_host_present(): void {
    end_frame();
}
