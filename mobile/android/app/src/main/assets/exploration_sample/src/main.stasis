const MAX_ENTITIES: i32 = 8;
const PLAYER_SLOT: i32 = 0;
const MOVE_SPEED: i32 = 6;
const PICKUP_RADIUS: i32 = 24;
const HUD_HEIGHT: i32 = 56;
const WORLD_WIDTH: i32 = 720;
const WORLD_HEIGHT: i32 = 960;
const CAMERA_FOLLOW_STEP: i32 = 4;

global Input {
    touch_x: i32; touch_y: i32; touch_active: i32; screen_w: i32; screen_h: i32;
}

// Bounded structure-of-arrays storage. Slot order is deterministic and entity ID is slot + 1.
global World {
    entity_alive: i32[8]; entity_kind: i32[8];
    position_x: i32[8]; position_y: i32[8];
    destination_active: i32[8]; destination_x: i32[8]; destination_y: i32[8];
    move_speed: i32[8]; collectible_kind: i32[8]; collectible_active: i32[8];
    inventory_count: i32[3];
}

global GameState {
    tick_count: i32; screen_w: i32; screen_h: i32; previous_touch_active: i32;
    player_entity_id: i32; collected_count: i32; total_collectibles: i32; tutorial_stage: i32;
    camera_x: i32; camera_y: i32; last_collected_entity_id: i32;
}

global Render {
    command_schema_version: i32;
    command_count: i32;
    command0_kind: i32; command0_x: i32; command0_y: i32; command0_w: i32; command0_h: i32; command0_color: i32; command0_asset: i32; command0_rotation_degrees: i32; command0_alpha: i32;
    command1_kind: i32; command1_x: i32; command1_y: i32; command1_w: i32; command1_h: i32; command1_color: i32; command1_asset: i32; command1_rotation_degrees: i32; command1_alpha: i32;
    command2_kind: i32; command2_x: i32; command2_y: i32; command2_w: i32; command2_h: i32; command2_color: i32; command2_asset: i32; command2_rotation_degrees: i32; command2_alpha: i32;
    command3_kind: i32; command3_x: i32; command3_y: i32; command3_w: i32; command3_h: i32; command3_color: i32; command3_asset: i32; command3_rotation_degrees: i32; command3_alpha: i32;
    command4_kind: i32; command4_x: i32; command4_y: i32; command4_w: i32; command4_h: i32; command4_color: i32; command4_asset: i32; command4_rotation_degrees: i32; command4_alpha: i32;
    command5_kind: i32; command5_x: i32; command5_y: i32; command5_w: i32; command5_h: i32; command5_color: i32; command5_asset: i32; command5_rotation_degrees: i32; command5_alpha: i32;
    command6_kind: i32; command6_x: i32; command6_y: i32; command6_w: i32; command6_h: i32; command6_color: i32; command6_asset: i32; command6_rotation_degrees: i32; command6_alpha: i32;
    command7_kind: i32; command7_x: i32; command7_y: i32; command7_w: i32; command7_h: i32; command7_color: i32; command7_asset: i32; command7_rotation_degrees: i32; command7_alpha: i32;
}

function exploration_abs(value: i32): i32 {
    if (value < 0) { return 0 - value; }
    return value;
}

function exploration_max(left: i32, right: i32): i32 {
    if (left > right) { return left; }
    return right;
}

function exploration_clamp(value: i32, minimum: i32, maximum: i32): i32 {
    if (value < minimum) { return minimum; }
    if (value > maximum) { return maximum; }
    return value;
}

function exploration_spawn_collectible(slot: i32, x: i32, y: i32, kind: i32): bool {
    if (slot <= PLAYER_SLOT) { return false; }
    if (slot >= MAX_ENTITIES) { return false; }
    if (kind < 1 || kind > 2) { return false; }
    if (World.entity_alive[slot] != 0) { return false; }
    World.entity_alive[slot] = 1; World.entity_kind[slot] = 2;
    World.position_x[slot] = x; World.position_y[slot] = y;
    World.collectible_kind[slot] = kind; World.collectible_active[slot] = 1;
    return true;
}

function exploration_init_world(): void {
    GameState.tick_count = 0; GameState.screen_w = 360; GameState.screen_h = 640;
    GameState.previous_touch_active = 0; GameState.player_entity_id = 1;
    GameState.collected_count = 0; GameState.total_collectibles = 3;
    GameState.tutorial_stage = 0; GameState.camera_x = 180; GameState.camera_y = 280;
    GameState.last_collected_entity_id = 0;
    let slot: i32 = 0;
    for (slot = 0; slot < MAX_ENTITIES; slot = slot + 1) {
        World.entity_alive[slot] = 0; World.entity_kind[slot] = 0;
        World.position_x[slot] = 0; World.position_y[slot] = 0;
        World.destination_active[slot] = 0; World.destination_x[slot] = 0; World.destination_y[slot] = 0;
        World.move_speed[slot] = 0; World.collectible_kind[slot] = 0; World.collectible_active[slot] = 0;
    }
    World.inventory_count[0] = 0; World.inventory_count[1] = 0; World.inventory_count[2] = 0;
    World.entity_alive[0] = 1; World.entity_kind[0] = 1;
    World.position_x[0] = 360; World.position_y[0] = 600; World.move_speed[0] = MOVE_SPEED;
    exploration_spawn_collectible(1, 180, 220, 1);
    exploration_spawn_collectible(2, 540, 400, 2);
    exploration_spawn_collectible(3, 220, 720, 1);
}

function exploration_input_target_system(): void {
    if (Input.screen_w > 0) { GameState.screen_w = Input.screen_w; }
    if (Input.screen_h > 0) { GameState.screen_h = Input.screen_h; }
    if (Input.touch_active != 0 && GameState.previous_touch_active == 0) {
        let world_x: i32 = Input.touch_x + GameState.camera_x;
        let world_y: i32 = Input.touch_y + GameState.camera_y;
        World.destination_x[0] = exploration_clamp(world_x, 12, WORLD_WIDTH - 12);
        World.destination_y[0] = exploration_clamp(world_y, HUD_HEIGHT + 12, WORLD_HEIGHT - 12);
        World.destination_active[0] = 1;
    }
    GameState.previous_touch_active = Input.touch_active;
}

function exploration_move_slot(slot: i32): void {
    let dx: i32 = World.destination_x[slot] - World.position_x[slot];
    let dy: i32 = World.destination_y[slot] - World.position_y[slot];
    let span: i32 = exploration_max(exploration_abs(dx), exploration_abs(dy));
    let speed: i32 = World.move_speed[slot];
    if (span <= speed) {
        World.position_x[slot] = World.destination_x[slot];
        World.position_y[slot] = World.destination_y[slot];
        World.destination_active[slot] = 0;
        return;
    }
    let step_x: i32 = (dx * speed) / span;
    let step_y: i32 = (dy * speed) / span;
    if (step_x == 0 && dx > 0) { step_x = 1; }
    if (step_x == 0 && dx < 0) { step_x = -1; }
    if (step_y == 0 && dy > 0) { step_y = 1; }
    if (step_y == 0 && dy < 0) { step_y = -1; }
    World.position_x[slot] += step_x; World.position_y[slot] += step_y;
}

function exploration_movement_system(): void {
    let slot: i32 = 0;
    for (slot = 0; slot < MAX_ENTITIES; slot = slot + 1) {
        if (World.entity_alive[slot] != 0 && World.destination_active[slot] != 0) {
            exploration_move_slot(slot);
        }
    }
}

function exploration_collect_slot(slot: i32): void {
    World.collectible_active[slot] = 0; GameState.collected_count += 1;
    GameState.last_collected_entity_id = slot + 1;
    let kind: i32 = World.collectible_kind[slot];
    if (kind == 1) { World.inventory_count[1] += 1; }
    if (kind == 2) { World.inventory_count[2] += 1; }
}

function exploration_collection_system(): void {
    let slot: i32 = 1;
    for (slot = 1; slot < MAX_ENTITIES; slot = slot + 1) {
        if (World.entity_alive[slot] != 0 && World.collectible_active[slot] != 0) {
            let dx: i32 = World.position_x[slot] - World.position_x[0];
            let dy: i32 = World.position_y[slot] - World.position_y[0];
            if ((dx * dx) + (dy * dy) <= PICKUP_RADIUS * PICKUP_RADIUS) {
                exploration_collect_slot(slot);
            }
        }
    }
}

function exploration_tutorial_progress_system(): void {
    if (GameState.collected_count == 0) { GameState.tutorial_stage = 0; }
    if (GameState.collected_count > 0) { GameState.tutorial_stage = 1; }
    if (GameState.collected_count == GameState.total_collectibles) { GameState.tutorial_stage = 2; }
}

function exploration_approach(current: i32, target: i32, step: i32): i32 {
    if (current < target) {
        if (target - current <= step) { return target; }
        return current + step;
    }
    if (current > target) {
        if (current - target <= step) { return target; }
        return current - step;
    }
    return current;
}

function exploration_camera_follow_system(): void {
    let max_x: i32 = WORLD_WIDTH - GameState.screen_w;
    let max_y: i32 = WORLD_HEIGHT - GameState.screen_h;
    if (max_x < 0) { max_x = 0; }
    if (max_y < 0) { max_y = 0; }
    let target_x: i32 = exploration_clamp(World.position_x[0] - (GameState.screen_w / 2), 0, max_x);
    let target_y: i32 = exploration_clamp(World.position_y[0] - (GameState.screen_h / 2), 0, max_y);
    GameState.camera_x = exploration_approach(GameState.camera_x, target_x, CAMERA_FOLLOW_STEP);
    GameState.camera_y = exploration_approach(GameState.camera_y, target_y, CAMERA_FOLLOW_STEP);
}

function exploration_render_extract_system(): void {
    Render.command_schema_version = 2;
    Render.command_count = 8;
    Render.command0_kind = 1; Render.command0_x = 0; Render.command0_y = 0;
    Render.command0_w = GameState.screen_w; Render.command0_h = GameState.screen_h; Render.command0_color = 1007922; Render.command0_asset = 0;
    if (GameState.tutorial_stage == 1) { Render.command0_color = 1017139; }
    if (GameState.tutorial_stage == 2) { Render.command0_color = 1585208; }
    Render.command1_kind = World.collectible_active[1] * 2; Render.command1_x = World.position_x[1] - GameState.camera_x - 9; Render.command1_y = World.position_y[1] - GameState.camera_y - 9;
    Render.command1_w = 18; Render.command1_h = 18; Render.command1_color = 16763904; Render.command1_asset = 0;
    Render.command2_kind = World.collectible_active[2] * 2; Render.command2_x = World.position_x[2] - GameState.camera_x - 9; Render.command2_y = World.position_y[2] - GameState.camera_y - 9;
    Render.command2_w = 18; Render.command2_h = 18; Render.command2_color = 6737151; Render.command2_asset = 0;
    Render.command3_kind = World.collectible_active[3] * 2; Render.command3_x = World.position_x[3] - GameState.camera_x - 9; Render.command3_y = World.position_y[3] - GameState.camera_y - 9;
    Render.command3_w = 18; Render.command3_h = 18; Render.command3_color = 16763904; Render.command3_asset = 0;
    Render.command4_kind = 2; Render.command4_x = World.position_x[0] - GameState.camera_x - 12; Render.command4_y = World.position_y[0] - GameState.camera_y - 12;
    Render.command4_w = 24; Render.command4_h = 24; Render.command4_color = 5636095; Render.command4_asset = 0;
    Render.command5_kind = World.destination_active[0] * 2; Render.command5_x = World.destination_x[0] - GameState.camera_x - 5; Render.command5_y = World.destination_y[0] - GameState.camera_y - 5;
    Render.command5_w = 10; Render.command5_h = 10; Render.command5_color = 16777215; Render.command5_asset = 0;
    Render.command6_kind = 1; Render.command6_x = 12; Render.command6_y = 14; Render.command6_w = World.inventory_count[1] * 22;
    Render.command6_h = 12; Render.command6_color = 16763904; Render.command6_asset = 0;
    Render.command7_kind = 1; Render.command7_x = 12; Render.command7_y = 34; Render.command7_w = World.inventory_count[2] * 22;
    Render.command7_h = 12; Render.command7_color = 6737151; Render.command7_asset = 0;
    Render.command0_rotation_degrees = 0; Render.command0_alpha = 255;
    Render.command1_rotation_degrees = 0; Render.command1_alpha = 255;
    Render.command2_rotation_degrees = 0; Render.command2_alpha = 255;
    Render.command3_rotation_degrees = 0; Render.command3_alpha = 255;
    Render.command4_rotation_degrees = 0; Render.command4_alpha = 255;
    Render.command5_rotation_degrees = 0; Render.command5_alpha = 255;
    Render.command6_rotation_degrees = 0; Render.command6_alpha = 255;
    Render.command7_rotation_degrees = 0; Render.command7_alpha = 255;
}

function main(): void { exploration_init_world(); }

function tick(): void {
    GameState.tick_count += 1;
    exploration_input_target_system();
    exploration_movement_system();
    exploration_collection_system();
    exploration_camera_follow_system();
    exploration_tutorial_progress_system();
}

function render(): void { exploration_render_extract_system(); }
function on_code_swap(): void { render(); }
