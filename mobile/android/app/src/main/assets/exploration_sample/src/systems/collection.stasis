function exploration_emit_collection(slot: i32): void {
    let count: i32 = GameState.collection_event_count;
    if (count >= COLLECTION_EVENT_CAPACITY) {
        return;
    }
    GameState.collection_event_entity_id[count] = slot + 1;
    GameState.collection_event_kind[count] = World.collectible_kind[slot];
    GameState.collection_event_count = count + 1;
}

function exploration_collection_system(): void {
    GameState.collection_event_count = 0;
    let slot: i32 = 1;
    for (slot = 1; slot < MAX_ENTITIES; slot = slot + 1) {
        if (World.entity_alive[slot] != 0 && World.collectible_active[slot] != 0) {
            let dx: i32 = World.position_x[slot] - World.position_x[0];
            let dy: i32 = World.position_y[slot] - World.position_y[0];
            if ((dx * dx) +(dy * dy) <= PICKUP_RADIUS * PICKUP_RADIUS) {
                World.collectible_active[slot] = 0;
                exploration_emit_collection(slot);
            }
        }
    }
}
