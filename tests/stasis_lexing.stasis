import "../src/stdlib/stdlib.stasis";
import "../src/stasis/imports.stasis";
import "../src/stasis/lexing.stasis";

global t_argv0: ascii[260];
global t_exe_dir: ascii[260];

global t_path_sample: ascii[260];
global t_path_unknown: ascii[260];

global t_tmp: ascii[2048];
global t_kinds: Tok[128];

function t_init_exe_dir(): bool {
    let n: i32 = sys_argv(0, t_argv0, 260);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_argv0, n);
    path_dirname(t_exe_dir, t_argv0);
    return !ascii_is_empty(t_exe_dir);
}

function t_append_line(buf: ascii[], text: ascii[]): void {
    ascii_append(buf, text);
    ascii_append_byte(buf, 10);
}

function t_write_ascii(path: ascii[], text: ascii[]): bool {
    return sys_write_file(path, text, ascii_len(text));
}

function t_lex_file(path: ascii[]): i32 {
    let rc: i32 = load_graph(path);
    if (rc != 0) {
        return -1;
    }

    let idx: i32 = find_file(path);
    if (idx < 0) {
        return -1;
    }
    if (!lex_begin(idx)) {
        return -1;
    }

    let n: i32 = 0;
    for (n = 0; n < 128; n = n + 1) {
        t_kinds[n] = lex_next_kind();
        if (t_kinds[n] == Tok.Eof) {
            return n + 1;
        }
    }
    return -1;
}

test `stasis lexer basic tokens`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path_sample, t_exe_dir, "stasis_lex_sample.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "global x: i32;");
    t_append_line(t_tmp, "function f(): i32 {");
    t_append_line(t_tmp, "  let y: i32 = 1 + 2*3;");
    t_append_line(t_tmp, "  // line comment");
    t_append_line(t_tmp, "  /* block comment");
    t_append_line(t_tmp, "     continues */");
    t_append_line(t_tmp, "  let z: f32 = 1.25;");
    t_append_line(t_tmp, "  return y;");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path_sample, t_tmp)) {
        return false;
    }

    let n: i32 = t_lex_file(t_path_sample);
    if (n != 35) {
        return false;
    }
    if (stasis.lex_error_count != 0) {
        return false;
    }

    if (t_kinds[0] != Tok.GlobalKeyword) { return false; }
    if (t_kinds[1] != Tok.Identifier) { return false; }
    if (t_kinds[2] != Tok.Colon) { return false; }
    if (t_kinds[3] != Tok.Identifier) { return false; }
    if (t_kinds[4] != Tok.Semicolon) { return false; }

    if (t_kinds[5] != Tok.FunctionKeyword) { return false; }
    if (t_kinds[6] != Tok.Identifier) { return false; }
    if (t_kinds[7] != Tok.LParen) { return false; }
    if (t_kinds[8] != Tok.RParen) { return false; }
    if (t_kinds[9] != Tok.Colon) { return false; }
    if (t_kinds[10] != Tok.Identifier) { return false; }
    if (t_kinds[11] != Tok.LBrace) { return false; }

    if (t_kinds[12] != Tok.LetKeyword) { return false; }
    if (t_kinds[13] != Tok.Identifier) { return false; }
    if (t_kinds[14] != Tok.Colon) { return false; }
    if (t_kinds[15] != Tok.Identifier) { return false; }
    if (t_kinds[16] != Tok.Equal) { return false; }
    if (t_kinds[17] != Tok.IntegerLiteral) { return false; }
    if (t_kinds[18] != Tok.Plus) { return false; }
    if (t_kinds[19] != Tok.IntegerLiteral) { return false; }
    if (t_kinds[20] != Tok.Star) { return false; }
    if (t_kinds[21] != Tok.IntegerLiteral) { return false; }
    if (t_kinds[22] != Tok.Semicolon) { return false; }

    if (t_kinds[23] != Tok.LetKeyword) { return false; }
    if (t_kinds[24] != Tok.Identifier) { return false; }
    if (t_kinds[25] != Tok.Colon) { return false; }
    if (t_kinds[26] != Tok.Identifier) { return false; }
    if (t_kinds[27] != Tok.Equal) { return false; }
    if (t_kinds[28] != Tok.FloatLiteral) { return false; }
    if (t_kinds[29] != Tok.Semicolon) { return false; }

    if (t_kinds[30] != Tok.ReturnKeyword) { return false; }
    if (t_kinds[31] != Tok.Identifier) { return false; }
    if (t_kinds[32] != Tok.Semicolon) { return false; }

    if (t_kinds[33] != Tok.RBrace) { return false; }
    if (t_kinds[34] != Tok.Eof) { return false; }

    return true;
}

test `stasis lexer unknown char`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path_unknown, t_exe_dir, "stasis_lex_unknown.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "global x: i32 = 1 & 2;");
    if (!t_write_ascii(t_path_unknown, t_tmp)) {
        return false;
    }

    let n: i32 = t_lex_file(t_path_unknown);
    if (n <= 0) {
        return false;
    }
    if (stasis.lex_error_count != 1) {
        return false;
    }

    if (t_kinds[0] != Tok.GlobalKeyword) { return false; }
    if (t_kinds[1] != Tok.Identifier) { return false; }
    if (t_kinds[2] != Tok.Colon) { return false; }
    if (t_kinds[3] != Tok.Identifier) { return false; }
    if (t_kinds[4] != Tok.Equal) { return false; }
    if (t_kinds[5] != Tok.IntegerLiteral) { return false; }
    if (t_kinds[6] != Tok.Unknown) { return false; }
    if (t_kinds[7] != Tok.IntegerLiteral) { return false; }
    if (t_kinds[8] != Tok.Semicolon) { return false; }
    if (t_kinds[9] != Tok.Eof) { return false; }

    return true;
}
