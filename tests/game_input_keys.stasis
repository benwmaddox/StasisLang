import "../src/host_frame.stasis";
import "../src/stdlib/game_input.stasis";

global prev_keys: i32[512];

const KEY_A: i32 = 4; // SDL scancode A

test `key went_down then commit`(): bool {
    // ensure clean state
    prev_keys.clear();
    host_i32[HOST_I_KEY_BASE + KEY_A] = 0;

    // press A
    host_i32[HOST_I_KEY_BASE + KEY_A] = 1;
    if (!input_key_went_down(prev_keys, KEY_A)) { return false; }
    if (input_key_went_up(prev_keys, KEY_A)) { return false; }

    input_keys_commit(prev_keys, 512);

    // still down, so no longer "went down"
    if (input_key_went_down(prev_keys, KEY_A)) { return false; }
    if (!input_key_down_prev(prev_keys, KEY_A)) { return false; }
    return true;
}

test `key went_up after commit`(): bool {
    prev_keys.clear();
    host_i32[HOST_I_KEY_BASE + KEY_A] = 1;
    input_keys_commit(prev_keys, 512);

    // release A
    host_i32[HOST_I_KEY_BASE + KEY_A] = 0;
    if (!input_key_went_up(prev_keys, KEY_A)) { return false; }
    if (input_key_went_down(prev_keys, KEY_A)) { return false; }
    return true;
}

