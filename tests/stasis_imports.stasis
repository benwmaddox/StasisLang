import "../src/stdlib/stdlib.stasis";
import "../src/stasis/imports.stasis";

global t_path_common: ascii[260];
global t_path_a: ascii[260];
global t_path_entry: ascii[260];

global t_path_big: ascii[260];
global t_path_big_entry: ascii[260];

global t_argv0: ascii[260];
global t_exe_dir: ascii[260];

global t_tmp: ascii[2048];
global t_big_data: u8[51201];

function t_init_cache_dir(): bool {
    let n: i32 = sys_argv(0, t_argv0, 260);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_argv0, n);
    path_dirname(t_exe_dir, t_argv0);
    return !ascii_is_empty(t_exe_dir);
}

function t_append_line(buf: ascii[], text: ascii[]): void {
    ascii_append(buf, text);
    ascii_append_byte(buf, 10);
}

function t_append_import(buf: ascii[], rel_path: ascii[]): void {
    ascii_append(buf, "import ");
    ascii_append_byte(buf, 34);
    ascii_append(buf, rel_path);
    ascii_append_byte(buf, 34);
    ascii_append_byte(buf, 59);
    ascii_append_byte(buf, 10);
}

function t_write_ascii(path: ascii[], text: ascii[]): bool {
    return sys_write_file(path, text, ascii_len(text));
}

test `stasis import graph loads files`() {
    if (!t_init_cache_dir()) {
        return false;
    }

    path_join(t_path_common, t_exe_dir, "sh_common.stasis");
    path_join(t_path_a, t_exe_dir, "sh_a.stasis");
    path_join(t_path_entry, t_exe_dir, "sh_entry.stasis");

    // common
    ascii_clear(t_tmp);
    t_append_line(t_tmp, "// common-marker");
    t_append_line(t_tmp, "global common_value: i32;");
    if (!t_write_ascii(t_path_common, t_tmp)) {
        return false;
    }

    // a imports common
    ascii_clear(t_tmp);
    t_append_import(t_tmp, "sh_common.stasis");
    t_append_line(t_tmp, "// a-marker");
    t_append_line(t_tmp, "global a_value: i32;");
    if (!t_write_ascii(t_path_a, t_tmp)) {
        return false;
    }

    // entry imports a, then duplicates common
    ascii_clear(t_tmp);
    t_append_import(t_tmp, "sh_a.stasis");
    t_append_import(t_tmp, "sh_common.stasis");
    t_append_line(t_tmp, "// entry-marker");
    t_append_line(t_tmp, "global entry_value: i32;");
    if (!t_write_ascii(t_path_entry, t_tmp)) {
        return false;
    }

    let rc: i32 = load_graph(t_path_entry);
    if (rc != 0) {
        return false;
    }

    if (st.file_count != 3) {
        return false;
    }

    let idx_common: i32 = find_file(t_path_common);
    let idx_a: i32 = find_file(t_path_a);
    let idx_entry: i32 = find_file(t_path_entry);
    if (idx_common < 0 || idx_a < 0 || idx_entry < 0) {
        return false;
    }

    if (st.files[idx_common].imports_len != 0) { return false; }
    if (st.files[idx_a].imports_len != 1) { return false; }
    if (st.files[idx_entry].imports_len != 2) { return false; }

    let off_a: i32 = st.files[idx_a].imports_off;
    if (st.imports[off_a] != idx_common) { return false; }

    let off_entry: i32 = st.files[idx_entry].imports_off;
    if (st.imports[off_entry] != idx_a) { return false; }
    if (st.imports[off_entry + 1] != idx_common) { return false; }

    return find_file(t_path_common) >= 0
        && find_file(t_path_a) >= 0
        && find_file(t_path_entry) >= 0
        && find_module("sh_common") >= 0
        && find_module("sh_a") >= 0
        && find_module("sh_entry") >= 0;
}

test `stasis import graph enforces 50KiB`() {
    if (!t_init_cache_dir()) {
        return false;
    }

    st.quiet = 1;

    path_join(t_path_big, t_exe_dir, "sh_big.stasis");
    path_join(t_path_big_entry, t_exe_dir, "sh_big_entry.stasis");

    let i: i32 = 0;
    for (i = 0; i < 51201; i = i + 1) {
        t_big_data[i] = 97; // 'a'
    }
    if (!sys_write_file(t_path_big, t_big_data, 51201)) {
        return false;
    }

    ascii_clear(t_tmp);
    t_append_import(t_tmp, "sh_big.stasis");
    t_append_line(t_tmp, "// big-entry-marker");
    if (!t_write_ascii(t_path_big_entry, t_tmp)) {
        return false;
    }

    let rc: i32 = load_graph(t_path_big_entry);
    return rc != 0;
}
