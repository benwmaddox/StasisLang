import "../src/stdlib/stdlib.stasis";
import "../src/stasis/imports.stasis";
import "../src/stasis/signatures.stasis";
import "../src/stasis/stmt_parse.stasis";

global t_argv0: ascii[260];
global t_exe_dir: ascii[260];
global t_path: ascii[260];
global t_tmp: ascii[8192];

function t_init_exe_dir(): bool {
    let n: i32 = sys_argv(0, t_argv0, 260);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_argv0, n);
    path_dirname(t_exe_dir, t_argv0);
    return !ascii_is_empty(t_exe_dir);
}

function t_append_line(buf: ascii[], text: ascii[]): void {
    ascii_append(buf, text);
    ascii_append_byte(buf, 10);
}

function t_write_ascii(path: ascii[], text: ascii[]): bool {
    return sys_write_file(path, text, ascii_len(text));
}

test `stasis statement parser accepts basic constructs`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "sh_stmt_ok.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 {");
    t_append_line(t_tmp, "  let x: i32 = 1 + 2 * 3;");
    t_append_line(t_tmp, "  if (x == 7) { x = x + 1; } else { x = x - 1; }");
    t_append_line(t_tmp, "  for (x = 0; x < 3; x = x + 1) { x = x + 1; }");
    t_append_line(t_tmp, "  foreach (i in x) { x = x + 1; }");
    t_append_line(t_tmp, "  return x;");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    let stmt_errors: i32 = stmt_parse_loaded_files();
    return stmt_errors == 0;
}

test `stasis statement parser rejects missing semicolons`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "sh_stmt_bad.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 {");
    t_append_line(t_tmp, "  let x: i32 = 1");
    t_append_line(t_tmp, "  return x;");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    let stmt_errors: i32 = stmt_parse_loaded_files();
    return stmt_errors != 0;
}

test `stasis statement parser accepts slice types`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "sh_stmt_slice.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 {");
    t_append_line(t_tmp, "  let a: ascii[];");
    t_append_line(t_tmp, "  let b: u8[];");
    t_append_line(t_tmp, "  return 0;");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    let stmt_errors: i32 = stmt_parse_loaded_files();
    return stmt_errors == 0;
}
