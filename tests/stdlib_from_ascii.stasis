import "../src/stdlib/stdlib.stasis";

global ascii_src: ascii[8];
global utf8_dst: utf8[8];

test `utf8_from_ascii copies ascii`(): bool {
    ascii_src[0] = 72;
    ascii_src[1] = 105;
    ascii_src[2] = 0;

    utf8_from_ascii(utf8_dst, ascii_src, utf8_dst.length);

    return length_chars(utf8_dst) == 2
        && utf8_dst[0] == 72
        && utf8_dst[1] == 105;
}
