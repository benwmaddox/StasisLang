import "../src/stdlib/game_camera.stasis";

global cam: f32[5];
global sx: f32[1];
global sy: f32[1];
global wx: f32[1];
global wy: f32[1];

test `camera world_to_screen centered`(): bool {
    game_camera2d_init(cam, 100.0, 50.0);
    game_camera2d_set_center(cam, 10.0, -5.0);
    game_camera2d_set_zoom(cam, 2.0);

    game_camera2d_world_to_screen(cam, 10.0, -5.0, sx, sy);

    // Center maps to viewport center.
    return sx[0] == 50.0 && sy[0] == 25.0;
}

test `camera screen_to_world inverse`(): bool {
    game_camera2d_init(cam, 100.0, 50.0);
    game_camera2d_set_center(cam, 10.0, -5.0);
    game_camera2d_set_zoom(cam, 2.0);

    game_camera2d_screen_to_world(cam, 50.0, 25.0, wx, wy);

    return wx[0] == 10.0 && wy[0] == -5.0;
}

test `camera world_to_screen offset`(): bool {
    game_camera2d_init(cam, 100.0, 50.0);
    game_camera2d_set_center(cam, 10.0, -5.0);
    game_camera2d_set_zoom(cam, 2.0);

    // world offset (+3,+4) => screen offset (+6,+8)
    game_camera2d_world_to_screen(cam, 13.0, -1.0, sx, sy);
    return sx[0] == 56.0 && sy[0] == 33.0;
}
