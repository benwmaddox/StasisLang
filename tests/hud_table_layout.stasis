import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/hud_table.stasis";

global widths: f32[2];
global parent: f32[4];
global table: f32[4];
global c0: f32[4];
global c1: f32[4];

test `hud_table_width sums widths and gaps`(): bool {
    widths[0] = 100.0;
    widths[1] = 60.0;
    let w: f32 = hud_table_width(widths, 2, 10.0);
    return f32_to_i32(w) == 170;
}

test `hud_table_cell_rect computes x offsets`(): bool {
    widths[0] = 100.0;
    widths[1] = 60.0;

    let tw: f32 = hud_table_width(widths, 2, 10.0);
    let th: f32 = hud_table_height(2, 20.0, 4.0);

    hud_rect_set(parent, 0.0, 0.0, 300.0, 200.0);
    hud_table_place(table, parent, tw, th, 0, 0.0, 0.0);

    hud_table_cell_rect(c0, table, widths, 2, 10.0, 20.0, 4.0, 0, 0);
    hud_table_cell_rect(c1, table, widths, 2, 10.0, 20.0, 4.0, 1, 0);
    return f32_to_i32(c0[0]) == 0
        && f32_to_i32(c1[0]) == 110
        && f32_to_i32(c1[2]) == 60;
}

