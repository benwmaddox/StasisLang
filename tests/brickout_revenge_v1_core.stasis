import "../src/stdlib/stdlib.stasis";
import "../samples/brickout_revenge/brickout_revenge_v1_core.stasis";

global t_out_presets: BrickoutBallPreset[4];
global t_out_line: utf8[96];
global t_tmp_ascii: ascii[96];

test `level script consumes spawns by tick`(): bool {
    brickout_level_event_offset[0] = 0;
    brickout_level_event_count[0] = 3;
    brickout_level_event_tick[0] = 0;
    brickout_level_event_preset[0] = BrickoutBallPreset.Normal;
    brickout_level_event_tick[1] = 0;
    brickout_level_event_preset[1] = BrickoutBallPreset.Heavy;
    brickout_level_event_tick[2] = 2;
    brickout_level_event_preset[2] = BrickoutBallPreset.Splitter;

    brickout_level_reset();

    let n0: i32 = brickout_level_consume_spawns(0, t_out_presets, 4);
    if (!(n0 == 2)) { return false; }
    if (!(t_out_presets[0] == BrickoutBallPreset.Normal)) { return false; }
    if (!(t_out_presets[1] == BrickoutBallPreset.Heavy)) { return false; }

    let n1: i32 = brickout_level_consume_spawns(0, t_out_presets, 4);
    if (!(n1 == 0)) { return false; }

    let n2: i32 = brickout_level_consume_spawns(0, t_out_presets, 4);
    if (!(n2 == 1)) { return false; }
    if (!(t_out_presets[0] == BrickoutBallPreset.Splitter)) { return false; }
    if (!(brickout_level_done == 1)) { return false; }
    return true;
}

test `economy buy respects scraps and power`(): bool {
    let scraps: i32 = 20;
    let power_used: i32 = 0;
    let power_cap: i32 = 3;
    let cost_scraps: i32 = 10;
    let cost_power: i32 = 2;

    if (!brickout_can_buy(scraps, power_used, power_cap, cost_scraps, cost_power)) { return false; }
    scraps = scraps - cost_scraps;
    power_used = power_used + cost_power;
    if (!(scraps == 10)) { return false; }
    if (!(power_used == 2)) { return false; }

    // Insufficient power for a second purchase.
    if (brickout_can_buy(scraps, power_used, power_cap, cost_scraps, cost_power)) { return false; }
    return true;
}

test `hud line formats scraps and power`(): bool {
    brickout_ascii_write_scraps_power_line(t_out_line, t_out_line.length, t_tmp_ascii, 5, 2, 10);
    // "Scraps: 5"
    return t_out_line[0] == 83   // S
        && t_out_line[1] == 99   // c
        && t_out_line[2] == 114  // r
        && t_out_line[3] == 97   // a
        && t_out_line[4] == 112  // p
        && t_out_line[5] == 115  // s
        && t_out_line[6] == 58   // :
        && t_out_line[7] == 32   // space
        && t_out_line[8] == 53;  // '5'
}
