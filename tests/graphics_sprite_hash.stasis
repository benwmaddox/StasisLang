import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/gfx_cmd.stasis";

test `drawing a sprite emits a sprite command`(): bool {
    begin_frame();
    clear(0.0, 0.0, 0.0, 1.0);
    let s0: i32 = gfx_cmd_i32[GFX_I_SPRITE_COUNT];
    end_frame();

    begin_frame();
    clear(0.0, 0.0, 0.0, 1.0);
    gfx_draw_sprite(1, 8, 8, 32, 32, 0, 255);
    let s1: i32 = gfx_cmd_i32[GFX_I_SPRITE_COUNT];
    end_frame();

    return s0 == 0 && s1 == 1;
}

