        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_call_args_llvm.stasis");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function add(a: i32, b: i32): i32 { return a + b; }");
    t_append_line(t_tmp, "function main(): i32 { return add(40, 2); }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
