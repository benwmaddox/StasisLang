test `stasis build emits llvm for slice params and u8 conversions`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_slice_params_llvm.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function trunc_test(x: i32): i32 { return i32_to_u8_trunc(x); }");
    t_append_line(t_tmp, "function sum(buf: u8[], n: i32): i32 {");
    t_append_line(t_tmp, "  let i: i32 = 0;");
    t_append_line(t_tmp, "  let s: i32 = 0;");
    t_append_line(t_tmp, "  for (i = 0; i < n; i = i + 1) { s = s + u8_to_i32(buf[i]); }");
    t_append_line(t_tmp, "  return s;");
    t_append_line(t_tmp, "}");
    t_append_line(t_tmp, "global g: u8[4];");
    t_append_line(t_tmp, "function main(): i32 {");
    t_append_line(t_tmp, "  g[0] = 1;");
    t_append_line(t_tmp, "  g[1] = 2;");
    t_append_line(t_tmp, "  g[2] = 3;");
    t_append_line(t_tmp, "  g[3] = 4;");
    t_append_line(t_tmp, "  return sum(g, 4) + trunc_test(257);");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "define i32 @module__sum(ptr %a0, i32 %a1)")) { return false; }
    if (!ascii_contains(stasis.ir_out, "call i32 @module__sum(ptr")) { return false; }
    if (!ascii_contains(stasis.ir_out, "alloca ptr")) { return false; }
    if (!ascii_contains(stasis.ir_out, "load ptr, ptr %l0")) { return false; }
    if (!ascii_contains(stasis.ir_out, "getelementptr inbounds i8")) { return false; }
    if (!ascii_contains(stasis.ir_out, "zext i8")) { return false; }
    if (!ascii_contains(stasis.ir_out, " = and i32")) { return false; }
    return ascii_contains(stasis.ir_out, ", 255");
}

test `stasis build emits llvm for string literals`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_string_lit_llvm.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 {");
    ascii_append(t_tmp, "  print_string(");
    ascii_append_byte(t_tmp, 34); // '\"'
    ascii_append(t_tmp, "hi");
    ascii_append_byte(t_tmp, 34); // '\"'
    ascii_append(t_tmp, ");");
    ascii_append_byte(t_tmp, 10);
    t_append_line(t_tmp, "  return 0;");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "declare i32 @printf(ptr, ...)")) { return false; }
    if (!ascii_contains(stasis.ir_out, "call i32 (ptr, ...) @printf")) { return false; }
    if (!ascii_contains(stasis.ir_out, "@.str0 = private unnamed_addr constant [11 x i8]")) { return false; }
    return ascii_contains(stasis.ir_out, "getelementptr inbounds [11 x i8], ptr @.str0, i32 0, i32 8");
}

test `stasis build emits llvm for sys_argc`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_sys_argc_llvm.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 { return sys_argc(); }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "declare i32 @stasis_sys_argc()")) { return false; }
    return ascii_contains(stasis.ir_out, "call i32 @stasis_sys_argc()");
}
