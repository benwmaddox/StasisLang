test `stasis build emits llvm for nested calls`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_nested_calls_llvm.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function inner(x: i32): i32 { return x + 1; }");
    t_append_line(t_tmp, "function outer(x: i32): i32 { return x + 2; }");
    t_append_line(t_tmp, "function main(): i32 { return outer(inner(40)); }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "define i32 @module__inner(i32 %a0)")) { return false; }
    if (!ascii_contains(stasis.ir_out, "define i32 @module__outer(i32 %a0)")) { return false; }
    if (!ascii_contains(stasis.ir_out, "call i32 @module__inner(i32")) { return false; }
    if (!ascii_contains(stasis.ir_out, "call i32 @module__outer(i32")) { return false; }
    return true;
}

test `stasis build emits llvm for module-qualified calls`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "math.stasis");
    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function add(a: i32, b: i32): i32 { return a + b; }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    path_join(t_path2, t_exe_dir, "app.stasis");
    ascii_clear(t_tmp);
    ascii_append(t_tmp, "import ");
    ascii_append_byte(t_tmp, 34); // '\"'
    ascii_append(t_tmp, "math.stasis");
    ascii_append_byte(t_tmp, 34); // '\"'
    ascii_append_byte(t_tmp, 59); // ';'
    ascii_append_byte(t_tmp, 10);
    t_append_line(t_tmp, "function main(): i32 { return math.add(40, 2); }");
    if (!t_write_ascii(t_path2, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path2);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "define i32 @math__add(i32 %a0, i32 %a1)")) { return false; }
    if (!ascii_contains(stasis.ir_out, "call i32 @math__add(i32")) { return false; }
    return true;
}

test `stasis build emits llvm for struct member access`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_member_llvm.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "struct Pair { a: i32; b: i32; }");
    t_append_line(t_tmp, "global g: Pair;");
    t_append_line(t_tmp, "function main(): i32 {");
    t_append_line(t_tmp, "  g.a = 40;");
    t_append_line(t_tmp, "  g.b = 2;");
    t_append_line(t_tmp, "  return g.a + g.b;");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "%module__Pair = type { i32, i32 }")) { return false; }
    if (!ascii_contains(stasis.ir_out, "@module__g = global %module__Pair zeroinitializer")) { return false; }
    if (!ascii_contains(stasis.ir_out, "getelementptr inbounds %module__Pair")) { return false; }
    return true;
}

