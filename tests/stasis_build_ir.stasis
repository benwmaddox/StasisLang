import "../src/stdlib/stdlib.stasis";
import "../src/stasis/imports.stasis";
import "../src/stasis/signatures.stasis";
import "../src/stasis/build_ir.stasis";

global t_argv0: ascii[260];
global t_exe_dir: ascii[260];

global t_path: ascii[260];
global t_path2: ascii[260];
global t_tmp: ascii[4096];

function t_init_exe_dir(): bool {
    let n: i32 = sys_argv(0, t_argv0, 260);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_argv0, n);
    path_dirname(t_exe_dir, t_argv0);
    return !ascii_is_empty(t_exe_dir);
}

function t_append_line(buf: ascii[], text: ascii[]): void {
    ascii_append(buf, text);
    ascii_append_byte(buf, 10);
}

function t_write_ascii(path: ascii[], text: ascii[]): bool {
    return sys_write_file(path, text, ascii_len(text));
}

test `stasis build emits clif for main return i32`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_ret.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 { return 42; }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "cranelift");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "function %module__main()")) { return false; }
    if (!ascii_contains(stasis.ir_out, "iconst.i32 42")) { return false; }
    return true;
}

test `stasis build emits llvm ir for main return i32`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_ret_llvm.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 { return 42; }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }

    if (!ascii_contains(stasis.ir_out, "define i32 @main()")) { return false; }
    if (!ascii_contains(stasis.ir_out, "%ret_slot = alloca i32")) { return false; }
    if (!ascii_contains(stasis.ir_out, "store i32 42, ptr %ret_slot")) { return false; }
    if (!ascii_contains(stasis.ir_out, "ret i32 %t")) { return false; }
    return true;
}

test `stasis build evaluates constant expressions`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    path_join(t_path, t_exe_dir, "stasis_build_ir_expr.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function main(): i32 { return (1 + 2) * 3 + 4; }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    stasis.quiet = 1;
    let rc: i32 = load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    rc = emit_main_return_i32_ir("module", "cranelift");
    if (rc != 0) {
        return false;
    }
    if (!ascii_contains(stasis.ir_out, "iconst.i32 13")) { return false; }

    rc = emit_main_return_i32_ir("module", "llvm");
    if (rc != 0) {
        return false;
    }
    if (!ascii_contains(stasis.ir_out, "store i32 13, ptr %ret_slot")) { return false; }

    return true;
}

