import "../../compiler/simple_pass_compiler.stasis";

function main(): i32 {
    compiler_reset_state();
    compiler_set_source("function main(): i32 { let x: i32 = 1; x += 2; if (x > 0 && x != 3) { x = x + 1; } else if (x < 0) { x = 0; } else { x = x - 1; } return x; }");

    return run_incremental_compiler();
}

