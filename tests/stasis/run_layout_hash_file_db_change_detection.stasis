import "../../compiler/incremental_compiler.stasis";

function main(): i32 {
    compiler_reset_state();

    if (!compiler_upsert_file("layout_file.stasis", "global DebugUI { marker: u8[4]; } function main(): i32 { return 0; }")) { return 100; }
    if (run_incremental_compiler() != 0) { return 101; }
    if (Compiler.incremental_layout_changed_files != 1) { return 102; }

    let first_layout_hash: i32 = Compiler.layout_hash;

    if (run_incremental_compiler() != 0) { return 103; }
    if (Compiler.incremental_layout_changed_files != 0) { return 104; }

    if (!compiler_upsert_file("layout_file.stasis", "global DebugUI { marker: u8[8]; } function main(): i32 { return 0; }")) { return 105; }
    if (run_incremental_compiler() != 0) { return 106; }
    if (Compiler.incremental_layout_changed_files != 1) { return 107; }
    if (Compiler.layout_hash == first_layout_hash) { return 108; }

    return 0;
}
