import "../../compiler/incremental_compiler.stasis";

function main(): i32 {
    compiler_reset_state();
    compiler_set_source("function main(): i32 { let sum: i32 = 0; for (let i: i32 = 0; i < 3; i += 1) { sum += i; } foreach (value in values) { sum += value; } foreach (index, value in values) { if (index >= 0) { sum += value; } } return sum; }");

    if (run_incremental_compiler() != 0) { return 30; }
    if (Compiler.parsed_for_count != 1) { return 31; }
    if (Compiler.parsed_foreach_count != 2) { return 32; }

    return 0;
}
