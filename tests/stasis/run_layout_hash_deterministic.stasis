import "../../compiler/incremental_compiler.stasis";

function main(): i32 {
    compiler_reset_state();
    compiler_set_source("global DebugUI { swapFlashTicks: u32; marker: u8[4]; } function main(): i32 { return 0; }");
    if (run_incremental_compiler() != 0) { return 90; }

    let first_hash: i32 = Compiler.layout_hash;
    if (Compiler.parsed_global_count != 1) { return 91; }

    if (run_incremental_compiler() != 0) { return 92; }
    if (Compiler.layout_hash != first_hash) { return 93; }
    if (Compiler.parsed_global_count != 1) { return 94; }

    return 0;
}
