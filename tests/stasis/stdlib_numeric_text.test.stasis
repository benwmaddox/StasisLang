import "../../src/stdlib/stdlib.stasis";

global numeric_text_value: ascii[64];
global numeric_text_exact_i32: ascii[12];
global numeric_text_short_i32: ascii[11];
global numeric_text_exact_f32: ascii[48];

function numeric_text_is(ascii_value: ascii[], expected_length: i32, first: u8, last: u8): bool {
    return length(ascii_value) == expected_length && ascii_value[0] == first && ascii_value[expected_length - 1] == last && ascii_value[expected_length] == 0;
}

test `numeric text replaces appends and pads caller storage`(): bool {
    if (ascii_from_i32(numeric_text_value, 42) != 2 || !numeric_text_is(numeric_text_value, 2, 52, 50)) {
        return false;
    }
    if (ascii_append_i32(numeric_text_value, -7) != 4 || !numeric_text_is(numeric_text_value, 4, 52, 55) || numeric_text_value[2] != 45) {
        return false;
    }
    numeric_text_value[4] = to_u8_trunc(86);
    if (ascii_pad_left(numeric_text_value, 7, to_u8_trunc(48)) != 7 || !numeric_text_is(numeric_text_value, 7, 48, 55)) {
        return false;
    }
    return ascii_from_f32_fixed(numeric_text_value, -1.25, 1) == 4 && numeric_text_is(numeric_text_value, 4, 45, 51) && numeric_text_value[1] == 49 && numeric_text_value[2] == 46;
}

test `numeric text covers minimums exact capacity and signed rounded zero`(): bool {
    let minimum: i32 = 0 - 2147483647 - 1;
    if (ascii_from_i32(numeric_text_exact_i32, minimum) != 11 || !numeric_text_is(numeric_text_exact_i32, 11, 45, 56)) {
        return false;
    }
    let maximum: f32 = i32_to_f32(16777215);
    let i: i32 = 0;
    for (i = 0; i < 104; i = i + 1) {
        maximum = maximum * 2.0;
    }
    if (ascii_from_f32_fixed(numeric_text_exact_f32, 0.0 - maximum, 6) != 47 || !numeric_text_is(numeric_text_exact_f32, 47, 45, 48)) {
        return false;
    }
    return ascii_from_f32_fixed(numeric_text_value, -0.004, 2) == 4 && numeric_text_value[0] == 48 && numeric_text_value[1] == 46 && numeric_text_value[2] == 48 && numeric_text_value[3] == 48;
}

test `numeric text rejection leaves length and payload unchanged`(): bool {
    ascii_copy(numeric_text_short_i32, "keep");
    numeric_text_short_i32[10] = to_u8_trunc(83);
    let minimum: i32 = 0 - 2147483647 - 1;
    if (
        ascii_from_i32(numeric_text_short_i32, minimum) != -1
        || length(numeric_text_short_i32) != 4
        || numeric_text_short_i32[0] != 107
        || numeric_text_short_i32[3] != 112
        || numeric_text_short_i32[4] != 0
        || numeric_text_short_i32[10] != 83
    ) {
        return false;
    }
    ascii_copy(numeric_text_value, "keep");
    return ascii_from_f32_fixed(numeric_text_value, 1.0 / 0.0, 2) == -1 && length(numeric_text_value) == 4 && numeric_text_value[0] == 107 && numeric_text_value[3] == 112 && numeric_text_value[4] == 0;
}
