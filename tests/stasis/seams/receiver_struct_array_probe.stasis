const RECEIVER_BONE_CAPACITY: i32 = 24;

struct ReceiverBone {
    parent: i32;
    local_x: f32;
    world_angle: f32;
    precise: f64;
    byte_lane: u8;
    short_lane: u16;
    wide_lane: u32;
    active: bool;
}

struct ReceiverRig {
    bones: ReceiverBone[RECEIVER_BONE_CAPACITY];
}

global receiver_left: ReceiverRig;
global receiver_right: ReceiverRig;

function receiver_set_bone(self: ReceiverRig, index: i32, parent: i32, local_x: f32, world_angle: f32): void {
    self.bones[index].parent = parent;
    self.bones[index].local_x = local_x;
    self.bones[index].world_angle = world_angle;
    self.bones[index].precise = 12.5;
    self.bones[index].byte_lane = 201;
    self.bones[index].short_lane = 40001;
    self.bones[index].wide_lane = 70001;
    self.bones[index].active = true;
}

function receiver_configure(self: ReceiverRig, index: i32, parent: i32, local_x: f32, world_angle: f32): void {
    self.receiver_set_bone(index, parent, local_x, world_angle);
}

function receiver_parent(self: ReceiverRig, index: i32): i32 {
    return self.bones[index].parent;
}

function receiver_check(self: ReceiverRig, index: i32, parent: i32, local_x: f32, world_angle: f32): bool {
    if (self.bones[index].parent != parent || self.bones[index].local_x != local_x) {
        return false;
    }
    if (self.bones[index].world_angle != world_angle || self.bones[index].precise != 12.5) {
        return false;
    }
    if (self.bones[index].byte_lane != 201 || self.bones[index].short_lane != 40001) {
        return false;
    }
    return self.bones[index].wide_lane == 70001 && self.bones[index].active;
}

function receiver_dynamic_parent(index: i32): i32 {
    return receiver_left.receiver_parent(index);
}

function receiver_dynamic_set(index: i32): i32 {
    receiver_left.receiver_set_bone(index, 3, 4.5, 6.5);
    return 0;
}

function receiver_struct_array_probe(): i32 {
    receiver_left.receiver_configure(0, -1, 1.25, 10.5);
    receiver_left.receiver_configure(23, 22, 23.25, 123.5);
    receiver_right.receiver_configure(0, 7, 91.5, 271.25);
    receiver_right.receiver_configure(23, 8, 92.5, 272.25);

    if (!receiver_left.receiver_check(0, -1, 1.25, 10.5) || !receiver_left.receiver_check(23, 22, 23.25, 123.5)) {
        return 1;
    }
    if (!receiver_right.receiver_check(0, 7, 91.5, 271.25) || !receiver_right.receiver_check(23, 8, 92.5, 272.25)) {
        return 2;
    }
    if (receiver_right.bones[0].parent != 7 || receiver_right.bones[23].parent != 8) {
        return 4;
    }
    if (receiver_right.bones[0].local_x != 91.5 || receiver_right.bones[23].world_angle != 272.25) {
        return 5;
    }
    if (receiver_left.bones[0].parent == receiver_right.bones[0].parent) {
        return 6;
    }
    if (receiver_left.bones[23].local_x == receiver_right.bones[23].local_x) {
        return 7;
    }
    if (receiver_left.bones[0].precise != 12.5 || receiver_left.bones[0].byte_lane != 201) {
        return 8;
    }
    if (receiver_left.bones[23].short_lane != 40001 || receiver_left.bones[23].wide_lane != 70001) {
        return 9;
    }
    if (!receiver_left.bones[0].active || !receiver_right.bones[23].active) {
        return 10;
    }
    return 0;
}
