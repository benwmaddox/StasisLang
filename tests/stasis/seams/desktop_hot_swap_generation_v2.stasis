import "/.stasis_cache/toolchain/src/stdlib/graphics.stasis";

global tick_generation: i32;

function main(): i32 {
    tick_generation = 0;
    return 0;
}

function tick(): i32 {
    tick_generation = 202;
    return 0;
}

function render(): i32 {
    begin_frame();
    if (tick_generation == 202) {
        clear(0.22, 0.42, 0.62, 1.0);
    } else {
        clear(0.92, 0.02, 0.62, 1.0);
    }
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
