import "../../../src/stdlib/host_frame.stasis";
import "../../../src/stdlib/internal/gfx_cmd.stasis";

global seam_phase: i32;
global seam_transition_count: i32;
global seam_state_checksum: i32;
global seam_pointer_x: f32;
global seam_pointer_y: f32;
global seam_host_frame: HostFrame;

function main(): i32 {
    seam_phase = 0;
    seam_transition_count = 0;
    seam_state_checksum = 0;
    seam_pointer_x = 0.0;
    seam_pointer_y = 0.0;
    return 0;
}

function tick(): i32 {
    seam_host_frame.refresh();
    if (seam_phase == 0 && seam_host_frame.keys[44] != 0 && seam_host_frame.pointer_count == 2 && seam_host_frame.pointers[1].went_down) {
        seam_phase = 1;
        seam_transition_count += 1;
        seam_state_checksum = 108045;
        seam_pointer_x = seam_host_frame.pointers[1].x_logical;
        seam_pointer_y = seam_host_frame.pointers[1].y_logical;
        return 0;
    }
    if (
        seam_phase == 1
        && seam_host_frame.keys[44] != 0
        && seam_host_frame.pointers[1].is_down
        && seam_host_frame.pointers[1].dx_logical > 0.0
    ) {
        seam_phase = 2;
        seam_transition_count += 1;
        seam_state_checksum = 212070;
        seam_pointer_x = seam_host_frame.pointers[1].x_logical;
        seam_pointer_y = seam_host_frame.pointers[1].y_logical;
        return 0;
    }
    if (seam_phase == 2 && seam_host_frame.keys[44] == 0 && seam_host_frame.pointers[1].went_up) {
        seam_phase = 3;
        seam_transition_count += 1;
        seam_state_checksum = 312070;
        seam_pointer_x = seam_host_frame.pointers[1].x_logical;
        seam_pointer_y = seam_host_frame.pointers[1].y_logical;
    }
    return 0;
}

function render(): i32 {
    gfx_cmd_begin();
    if (seam_phase == 1) {
        gfx_cmd_clear(0.8, 0.1, 0.1, 1.0);
    } else if (seam_phase == 2) {
        gfx_cmd_clear(0.1, 0.8, 0.1, 1.0);
    } else if (seam_phase == 3) {
        gfx_cmd_clear(0.1, 0.1, 0.8, 1.0);
    } else {
        gfx_cmd_clear(0.0, 0.0, 0.0, 1.0);
    }
    gfx_cmd_rect(seam_pointer_x, seam_pointer_y, 8.0, 6.0, 1.0, 1.0, 1.0, 1.0);
    gfx_cmd_mark_present();
    return 0;
}
