import "../../../src/stdlib/rig2d.stasis";

global rig2d_probe_left: Rig2D<24>;
global rig2d_probe_right: Rig2D<64>;
global rig2d_probe_ik: Rig2D<8>;

function rig2d_probe_near(actual: f32, expected: f32): bool {
    let difference: f32 = actual - expected;
    return difference > -0.001 && difference < 0.001;
}

function rig2d_probe(): i32 {
    rig2d_probe_left.clear();
    rig2d_probe_right.clear();
    if (rig2d_probe_left.add_bone(-1, 10.0, 0.0, 0.0) != 0) {
        return 1;
    }
    if (rig2d_probe_left.add_bone(0, 5.0, 0.0, 45.0) != 1) {
        return 2;
    }
    if (rig2d_probe_right.add_bone(-1, 3.0, 4.0, 0.0) != 0) {
        return 3;
    }
    if (!rig2d_probe_left.solve(2.0, 3.0, 90.0) || !rig2d_probe_right.solve(0.0, 0.0, 0.0)) {
        return 4;
    }
    if (!rig2d_probe_near(rig2d_probe_left.world_x(1), 2.0)) {
        return 5;
    }
    if (!rig2d_probe_near(rig2d_probe_left.world_y(1), 18.0)) {
        return 6;
    }
    if (!rig2d_probe_near(rig2d_probe_left.world_angle(1), 135.0)) {
        return 7;
    }
    if (!rig2d_probe_near(rig2d_probe_right.world_x(0), 3.0) || !rig2d_probe_near(rig2d_probe_right.world_y(0), 4.0)) {
        return 8;
    }
    return rig2d_probe_ik_sweep();
}

function rig2d_probe_ik_case(direction: f32, radius: f32, bend: i32): i32 {
    rig2d_probe_ik.clear();
    if (rig2d_probe_ik.add_bone(-1, 2.0, -1.0, 0.0) != 0) {
        return 20;
    }
    if (rig2d_probe_ik.add_bone(0, 3.0, 4.0, 0.0) != 1) {
        return 21;
    }
    if (rig2d_probe_ik.add_bone(1, 4.0, 0.0, 0.0) != 2) {
        return 22;
    }
    if (!rig2d_probe_ik.solve(100.0, -50.0, 37.0)) {
        return 23;
    }

    let pivot_x: f32 = rig2d_probe_ik.world_x(0);
    let pivot_y: f32 = rig2d_probe_ik.world_y(0);
    let target_x: f32 = pivot_x + radius * rig2d_cos(direction);
    let target_y: f32 = pivot_y + radius * rig2d_sin(direction);
    let expected_radius: f32 = radius;
    if (expected_radius < 1.0) {
        expected_radius = 1.0;
    }
    if (expected_radius > 9.0) {
        expected_radius = 9.0;
    }
    let cached_elbow_x: f32 = rig2d_probe_ik.world_x(1);
    let cached_elbow_y: f32 = rig2d_probe_ik.world_y(1);
    let expected_x: f32 = pivot_x + expected_radius * rig2d_cos(direction);
    let expected_y: f32 = pivot_y + expected_radius * rig2d_sin(direction);
    if (radius == 0.0) {
        expected_x = pivot_x + expected_radius *(cached_elbow_x - pivot_x) / 5.0;
        expected_y = pivot_y + expected_radius *(cached_elbow_y - pivot_y) / 5.0;
    }
    if (!rig2d_probe_ik.solve_two_bone(0, 1, target_x, target_y, 5.0, 4.0, bend, -180.0, 180.0, -180.0, 180.0)) {
        return 24;
    }
    if (
        !rig2d_probe_near(rig2d_probe_ik.world_x(1), cached_elbow_x)
        || !rig2d_probe_near(rig2d_probe_ik.world_y(1), cached_elbow_y)
        || !rig2d_probe_near(rig2d_probe_ik.bones[0].local_x, 2.0)
        || !rig2d_probe_near(rig2d_probe_ik.bones[0].local_y, -1.0)
        || !rig2d_probe_near(rig2d_probe_ik.bones[1].local_x, 3.0)
        || !rig2d_probe_near(rig2d_probe_ik.bones[1].local_y, 4.0)
        || !rig2d_probe_near(rig2d_probe_ik.bones[2].local_x, 4.0)
    ) {
        return 25;
    }
    if (!rig2d_probe_ik.solve(100.0, -50.0, 37.0)) {
        return 26;
    }
    if (
        !rig2d_probe_near(rig2d_probe_ik.world_x(2), expected_x)
        || !rig2d_probe_near(rig2d_probe_ik.world_y(2), expected_y)
        || rig2d_probe_ik.bones[0].local_angle < -180.0
        || rig2d_probe_ik.bones[0].local_angle >= 180.0
        || rig2d_probe_ik.bones[1].local_angle < -180.0
        || rig2d_probe_ik.bones[1].local_angle >= 180.0
    ) {
        return 27;
    }
    if (direction == 0.0 && radius == 4.0) {
        if (bend < 0 && rig2d_probe_ik.world_y(1) >= pivot_y) {
            return 34;
        }
        if (bend > 0 && rig2d_probe_ik.world_y(1) <= pivot_y) {
            return 35;
        }
    }
    return 0;
}

function rig2d_probe_ik_sweep(): i32 {
    let direction: f32 = -180.0;
    let radius_case: i32 = 0;
    let radius: f32 = 0.0;
    let bend: i32 = -1;
    let result: i32 = 0;
    let negative_elbow_x: f32 = 0.0;
    let negative_elbow_y: f32 = 0.0;
    for (direction = -180.0; direction < 180.0; direction = direction + 30.0) {
        for (radius_case = 0; radius_case < 7; radius_case = radius_case + 1) {
            radius = 0.0;
            if (radius_case == 0) {
                radius = 0.0;
            }
            if (radius_case == 1) {
                radius = 0.5;
            }
            if (radius_case == 2) {
                radius = 1.25;
            }
            if (radius_case == 3) {
                radius = 4.0;
            }
            if (radius_case == 4) {
                radius = 8.75;
            }
            if (radius_case == 5) {
                radius = 9.0;
            }
            if (radius_case == 6) {
                radius = 10.0;
            }
            for (bend = -1; bend <= 1; bend = bend + 2) {
                result = rig2d_probe_ik_case(direction, radius, bend);
                if (result != 0) {
                    return result;
                }
                if (bend < 0) {
                    negative_elbow_x = rig2d_probe_ik.world_x(1);
                    negative_elbow_y = rig2d_probe_ik.world_y(1);
                } else if (radius > 1.25 && radius < 8.75) {
                    if (
                        rig2d_probe_near(rig2d_probe_ik.world_x(1), negative_elbow_x)
                        && rig2d_probe_near(rig2d_probe_ik.world_y(1), negative_elbow_y)
                    ) {
                        return 28;
                    }
                }
            }
        }
    }

    rig2d_probe_ik.clear();
    if (
        rig2d_probe_ik.add_bone(-1, 2.0, -1.0, 0.0) != 0
        || rig2d_probe_ik.add_bone(0, 3.0, 4.0, 0.0) != 1
        || rig2d_probe_ik.add_bone(1, 5.0, 0.0, 0.0) != 2
        || !rig2d_probe_ik.solve(-20.0, 30.0, -41.0)
    ) {
        return 29;
    }
    let root_target_x: f32 = rig2d_probe_ik.world_x(0);
    let root_target_y: f32 = rig2d_probe_ik.world_y(0);
    if (!rig2d_probe_ik.solve_two_bone(0, 1, root_target_x, root_target_y, 5.0, 5.0, -1, -180.0, 180.0, -180.0, 180.0)) {
        return 30;
    }
    let first_upper_angle: f32 = rig2d_probe_ik.bones[0].local_angle;
    let first_lower_angle: f32 = rig2d_probe_ik.bones[1].local_angle;
    if (!rig2d_probe_ik.solve(-20.0, 30.0, -41.0)) {
        return 31;
    }
    if (!rig2d_probe_near(rig2d_probe_ik.world_x(2), root_target_x) || !rig2d_probe_near(rig2d_probe_ik.world_y(2), root_target_y)) {
        return 32;
    }
    if (
        !rig2d_probe_ik.solve_two_bone(0, 1, root_target_x, root_target_y, 5.0, 5.0, 1, -180.0, 180.0, -180.0, 180.0)
        || !rig2d_probe_near(rig2d_probe_ik.bones[0].local_angle, first_upper_angle)
        || !rig2d_probe_near(rig2d_probe_ik.bones[1].local_angle, first_lower_angle)
    ) {
        return 33;
    }
    return rig2d_probe_ik_limit_sweep();
}

function rig2d_probe_ik_limit_sweep(): i32 {
    let direction: f32 = -180.0;
    let radius_case: i32 = 0;
    let radius: f32 = 1.0;
    let bend: i32 = -1;
    let pivot_x: f32 = 0.0;
    let pivot_y: f32 = 0.0;
    for (direction = -180.0; direction < 180.0; direction = direction + 30.0) {
        for (radius_case = 0; radius_case < 3; radius_case = radius_case + 1) {
            radius = 1.0;
            if (radius_case == 1) {
                radius = 4.0;
            }
            if (radius_case == 2) {
                radius = 10.0;
            }
            for (bend = -1; bend <= 1; bend = bend + 2) {
                rig2d_probe_ik.clear();
                if (
                    rig2d_probe_ik.add_bone(-1, 2.0, -1.0, 0.0) != 0
                    || rig2d_probe_ik.add_bone(0, 3.0, 4.0, 0.0) != 1
                    || rig2d_probe_ik.add_bone(1, 4.0, 0.0, 0.0) != 2
                    || !rig2d_probe_ik.solve(60.0, -35.0, 37.0)
                ) {
                    return 36;
                }
                pivot_x = rig2d_probe_ik.world_x(0);
                pivot_y = rig2d_probe_ik.world_y(0);
                let target_x: f32 = pivot_x + radius * rig2d_cos(direction);
                let target_y: f32 = pivot_y + radius * rig2d_sin(direction);
                if (!rig2d_probe_ik.solve_two_bone(0, 1, target_x, target_y, 5.0, 4.0, bend, -70.0, 40.0, -100.0, 55.0)) {
                    return 37;
                }
                if (
                    rig2d_probe_ik.bones[0].local_angle < -70.0
                    || rig2d_probe_ik.bones[0].local_angle > 40.0
                    || rig2d_probe_ik.bones[1].local_angle < -100.0
                    || rig2d_probe_ik.bones[1].local_angle > 55.0
                ) {
                    return 38;
                }
            }
        }
    }
    return 0;
}

function main(): i32 {
    return rig2d_probe();
}
