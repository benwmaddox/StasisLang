import "/.stasis_cache/toolchain/src/stdlib/graphics.stasis";
import "/.stasis_cache/toolchain/src/stdlib/ad_tasks.stasis";
import "/.stasis_cache/toolchain/src/stdlib/portal_lifecycle.stasis";

struct WallRun { x: i32; length: i32; }
struct WallCache<N: i32> { runs: WallRun[N]; }

global score: i32;
global lifecycle_mode: i32;
global entry_trace: i32;
global tick_host_marker: i32;
global render_score: i32;
global forwarded_byte_length: i32;
global forwarded_char_length: i32;
global fixed_walls: WallRun[2];
global generic_walls: WallCache<2>;
global lifecycle_writer: SpriteRunWriter;
global mobile_ad_task: AdTask;

function probe_mobile_ad_shims(): i32 {
    if (mobile_ad_task.begin(AdKind.Midgame) != AdBeginResult.Unavailable) {
        return 1;
    }
    if (ad_tasks.status(mobile_ad_task) != AdState.Unavailable) {
        return 2;
    }
    if (mobile_ad_task.should_block_gameplay()) {
        return 3;
    }
    mobile_ad_task.handle = 1;
    mobile_ad_task.state = AdState.Playing;
    if (mobile_ad_task.take_reward()) {
        return 4;
    }
    if (ad_tasks.status(mobile_ad_task) != AdState.Failed) {
        return 5;
    }
    ad_tasks.release(mobile_ad_task);
    if (mobile_ad_task.handle != 0 || mobile_ad_task.state != AdState.Idle) {
        return 6;
    }
    mobile_ad_task.state = AdState.Finished;
    ad_tasks.reset(mobile_ad_task);
    if (mobile_ad_task.handle != 0 || mobile_ad_task.state != AdState.Idle) {
        return 7;
    }
    mobile_ad_task.state = AdState.Loading;
    if (ad_tasks.status(mobile_ad_task) != AdState.Loading) {
        return 8;
    }
    if (!ad_tasks.should_block_gameplay(mobile_ad_task)) {
        return 9;
    }
    ad_tasks.reset(mobile_ad_task);
    notify_portal_lifecycle(PortalLifecycleEvent.LoadingStarted);
    notify_portal_lifecycle(PortalLifecycleEvent.LoadingFinished);
    notify_portal_lifecycle(PortalLifecycleEvent.GameplayStarted);
    notify_portal_lifecycle(PortalLifecycleEvent.GameplayStopped);
    return 0;
}

function emit_text_leaf(text: utf8[]): void {
    forwarded_byte_length = length_bytes(text);
    forwarded_char_length = length_chars(text);
    draw_text(7, text, 12.0, 14.0, 0.8, 0.2, 0.1, 1.0);
}

function emit_text_middle(text: utf8[]): void {
    emit_text_leaf(text);
}

function emit_text_outer(text: utf8[]): void {
    emit_text_middle(text);
}

function probe_ascii_literal_byte(value: ascii[], index: i32): i32 {
    return to_i32(value[index]);
}

function main(): i32 {
    entry_trace = 1;
    if (probe_ascii_literal_byte("A", 0) != 65) {
        return 41;
    }
    if (probe_ascii_literal_byte("é", 0) != 195) {
        return 42;
    }
    if (probe_ascii_literal_byte("é", 1) != 169) {
        return 43;
    }
    score = 10;
    let mobile_ad_result: i32 = probe_mobile_ad_shims();
    if (mobile_ad_result != 0) {
        return 60 + mobile_ad_result;
    }
    fixed_walls[0].length = 3;
    generic_walls.runs[0].length = 4;
    if (lifecycle_mode == 1) {
        return 11;
    }
    return 0;
}

function tick(): i32 {
    entry_trace = entry_trace * 10 + 2;
    tick_host_marker = host_i32[100]
        + fixed_walls.max_length
        + generic_walls.runs.max_length
        + fixed_walls[0].length
        + generic_walls.runs[0].length
        - 11;
    score += 5;
    if (lifecycle_mode == 2) {
        return 22;
    }
    return 0;
}

function render(): i32 {
    entry_trace = entry_trace * 10 + 3;
    render_score = score;
    clear(0.05, 0.10, 0.15, 1.0);
    if (lifecycle_mode == 4) {
        // Leave a public writer unfinished to verify host aborts publication.
        lifecycle_writer.reserve(2, -1, 0, 0, 0, 0, 0);
    }
    fill_rect(12.0, 14.0, 30.0, 18.0, 0.8, 0.2, 0.1, 1.0);
    emit_text_outer("Café");
    if (lifecycle_mode == 3) {
        return 33;
    }
    return 0;
}

function on_code_swap(): void {
    return;
}

function @host_export(set_access) set_access(first: i32, second: i32, enabled: bool): void {
    if (enabled) { score = first + second; }
}
