import "/.stasis_cache/toolchain/src/stdlib/graphics.stasis";

global tick_generation: i32;

function main(): i32 {
    tick_generation = 0;
    return 0;
}

function tick(): i32 {
    tick_generation = 101;
    return 0;
}

function render(): i32 {
    begin_frame();
    if (tick_generation == 101) {
        clear(0.11, 0.21, 0.31, 1.0);
    } else {
        clear(0.91, 0.01, 0.31, 1.0);
    }
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
