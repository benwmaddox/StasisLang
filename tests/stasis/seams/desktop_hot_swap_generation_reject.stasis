import "/.stasis_cache/toolchain/src/stdlib/graphics.stasis";

global tick_generation: i32;

function main(): i32 {
    tick_generation = 0;
    return 0;
}

function tick(): i32 {
    tick_generation = 303;
    return 0;
}

function render(): i32 {
    begin_frame();
    if (tick_generation == 303) {
        clear(0.33, 0.63, 0.83, 1.0);
    } else {
        clear(0.93, 0.03, 0.83, 1.0);
    }
    end_frame();
    return 0;
}

function on_code_swap(): void {
    tick_generation = 999;
    reject_code_swap();
    return;
}
