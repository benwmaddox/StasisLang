import "../../compiler/incremental_compiler.stasis";

function main(): i32 {
    compiler_reset_state();
    compiler_set_source("function main(): i32 { let x: i32 = 0; let y: i32 = 0; x = 1 + 2 * 3; y = (x + 4) * 2; if ((y > 0 && x != 0) || y == 0) { x = y; } return x; }");

    if (run_incremental_compiler() != 0) { return 20; }
    if (Compiler.parsed_let_count != 2) { return 21; }
    if (Compiler.parsed_if_count != 1) { return 22; }
    if (Compiler.parsed_assignment_count != 5) { return 23; }

    return 0;
}
