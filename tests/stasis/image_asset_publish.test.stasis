import "../../src/stdlib/graphics.stasis";

enum SpriteRef {
    Prior = 11,
    Published = 22,
}

global asset: ImageAsset;
global target: Sprite;

test `publishing an image transfers its host handle and replaces the target`(): bool {
    asset.sprite_ref = SpriteRef.Published;
    asset.state = AssetState.Loaded;
    asset.width = 64;
    asset.height = 48;

    target.sprite_ref = SpriteRef.Prior;
    target.width = 8;
    target.height = 8;

    if (!asset.publish(target)) {
        return false;
    }
    return target.sprite_ref == SpriteRef.Published && target.width == 64 && target.height == 48 && asset.sprite_ref == SpriteRef.Invalid && asset.state == AssetState.None;
}
