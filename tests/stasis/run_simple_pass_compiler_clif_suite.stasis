import "../../compiler/simple_pass_compiler.stasis";

global TestClifBuffer: ascii[8192];
global TestExpectedBuffer: ascii[128];

function test_find_function_index_by_name(name: ascii[]): i32 {
    let target_hash: i32 = compiler_hash_ascii(name);
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        if (Compiler.function_id_hashes[i] == target_hash) {
            return i;
        }
    }
    return -1;
}

function test_emit_function_clif_for_source(src: ascii[], function_name: ascii[]): i32 {
    compiler_reset_state();
    compiler_set_source(src);
    if (run_incremental_compiler_with_main_entry() != 0) {
        return 1;
    }

    let function_index: i32 = test_find_function_index_by_name(function_name);
    if (function_index < 0) {
        return 2;
    }

    ascii_clear(TestClifBuffer);
    compiler_emit_function_clif_for_index(function_index, TestClifBuffer);
    if (!ascii_contains(TestClifBuffer, "function %fn_")) {
        return 3;
    }
    if (!ascii_contains(TestClifBuffer, "return v")) {
        return 4;
    }
    return 0;
}

function test_emit_main_clif_for_source(src: ascii[]): i32 {
    return test_emit_function_clif_for_source(src, "main");
}

function test_clif_contains_iconst(value: i32): bool {
    ascii_clear(TestExpectedBuffer);
    ascii_append(TestExpectedBuffer, "iconst.i32 ");
    ascii_push_i32(TestExpectedBuffer, value);
    return ascii_contains(TestClifBuffer, TestExpectedBuffer);
}

test `simple pass literal main emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { return 7; }\n"
    );
    return status == 0 && test_clif_contains_iconst(7);
}

test `simple pass conditional addition main emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function add_pair(left: i32, right: i32): i32 { return left + right; }\nfunction main(): i32 { let total: i32 = add_pair(2, 3); if (total > 4) { return total + 2; } return 0; }\n"
    );
    return status == 0 && test_clif_contains_iconst(7);
}

test `simple pass assignment if main emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { let value: i32 = 2; value += 5; if (value == 7) { value = value + 1; } return value; }\n"
    );
    return status == 0 && test_clif_contains_iconst(8);
}

test `simple pass nested call main emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function add_pair(left: i32, right: i32): i32 { return left + right; }\nfunction bump(value: i32): i32 { return value + 4; }\nfunction main(): i32 { return bump(add_pair(2, 3)); }\n"
    );
    return status == 0 && test_clif_contains_iconst(9);
}

test `simple pass add pair emits param iadd`(): bool {
    let status: i32 = test_emit_function_clif_for_source(
        "function add_pair(left: i32, right: i32): i32 { return left + right; }\nfunction main(): i32 { return add_pair(2, 3); }\n",
        "add_pair"
    );
    return (
        status == 0 &&
        ascii_contains(TestClifBuffer, "(i32, i32) -> i32") &&
        ascii_contains(TestClifBuffer, "iadd v0, v1") &&
        ascii_contains(TestClifBuffer, "return v2")
    );
}

test `simple pass add pair parenthesized emits param iadd`(): bool {
    let status: i32 = test_emit_function_clif_for_source(
        "function add_pair(left: i32, right: i32): i32 { return (left + right); }\nfunction main(): i32 { return add_pair(2, 3); }\n",
        "add_pair"
    );
    return (
        status == 0 &&
        ascii_contains(TestClifBuffer, "(i32, i32) -> i32") &&
        ascii_contains(TestClifBuffer, "iadd v0, v1") &&
        ascii_contains(TestClifBuffer, "return v2")
    );
}

test `simple pass struct and global declarations keep main lowering`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "struct Enemy { hp: i32; }\nglobal State { score: i32; enemy: Enemy; }\nfunction main(): i32 { return 7; }\n"
    );
    return status == 0 && test_clif_contains_iconst(7);
}

test `simple pass bool literal condition emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { if (true && !false) { return 5; } return 0; }\n"
    );
    return status == 0 && test_clif_contains_iconst(5);
}

test `simple pass short circuit and skips rhs call`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function explode(): i32 { return 1 / 0; }\nfunction main(): i32 { if (0 != 0 && explode() == 1) { return 1; } return 7; }\n"
    );
    return status == 0 && test_clif_contains_iconst(7);
}

test `simple pass short circuit or skips rhs call`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function explode(): i32 { return 1 / 0; }\nfunction main(): i32 { if (1 == 1 || explode() == 1) { return 9; } return 0; }\n"
    );
    return status == 0 && test_clif_contains_iconst(9);
}

test `simple pass else if chain emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { let x: i32 = 2; if (x == 0) { return 1; } else if (x == 2) { return 6; } else { return 9; } }\n"
    );
    return status == 0 && test_clif_contains_iconst(6);
}

test `simple pass compound assignment chain emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { let x: i32 = 12; x /= 3; x *= 2; x %= 5; if (x == 3) { return 11; } return 0; }\n"
    );
    return status == 0 && test_clif_contains_iconst(11);
}

test `simple pass for let accumulation emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { let sum: i32 = 0; for (let i: i32 = 0; i < 4; i += 1) { sum += i; } return sum; }\n"
    );
    return status == 0 && test_clif_contains_iconst(6);
}

test `simple pass for assignment init emits iconst`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { let i: i32 = 0; let sum: i32 = 0; for (i = 1; i <= 3; i += 1) { sum += i; } return sum; }\n"
    );
    return status == 0 && test_clif_contains_iconst(6);
}

test `simple pass for false condition skips body`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { let value: i32 = 5; for (let i: i32 = 0; 0 != 0; i += 1) { value = 1; } return value; }\n"
    );
    return status == 0 && test_clif_contains_iconst(5);
}

test `simple pass for body return exits loop`(): bool {
    let status: i32 = test_emit_main_clif_for_source(
        "function main(): i32 { for (let i: i32 = 0; i < 5; i += 1) { if (i == 3) { return 9; } } return 0; }\n"
    );
    return status == 0 && test_clif_contains_iconst(9);
}
