import "../../src/stdlib/world_camera.stasis";

global camera: WorldCamera;
global peer_camera: WorldCamera;
global history: WorldCameraHistory;
global tiles: WorldTileRange;

function configure_large(): void {
    camera.world_camera_configure(0.0, 0.0, 1000.0, 800.0, 10.0, 20.0, 200.0, 100.0, 2.0);
}

test `camera clamps exact and adjacent boundaries`(): bool {
    configure_large();
    camera.world_camera_follow(25.0, 25.0);
    if (camera.origin_x != 0.0 || camera.origin_y != 0.0) {
        return false;
    }
    camera.world_camera_follow(50.0, 25.0);
    if (camera.origin_x != 0.0) {
        return false;
    }
    camera.world_camera_follow(50.5, 25.0);
    if (camera.origin_x != 0.5) {
        return false;
    }
    camera.world_camera_follow(949.5, 774.5);
    if (camera.origin_x != 899.5 || camera.origin_y != 749.5) {
        return false;
    }
    camera.world_camera_follow(950.0, 775.0);
    if (camera.origin_x != 900.0 || camera.origin_y != 750.0) {
        return false;
    }
    camera.world_camera_follow(950.5, 775.5);
    return camera.origin_x == 900.0 && camera.origin_y == 750.0;
}

test `small worlds center inside the viewport`(): bool {
    camera.world_camera_configure(100.0, 50.0, 180.0, 90.0, 0.0, 0.0, 200.0, 100.0, 1.0);
    camera.world_camera_follow(-1000.0, 5000.0);
    return camera.origin_x == 40.0 && camera.origin_y == 20.0;
}

test `world and view conversions are inverse`(): bool {
    configure_large();
    camera.world_camera_follow(450.0, 325.0);
    let view_x: f32 = camera.world_to_view_x(425.0);
    let view_y: f32 = camera.world_to_view_y(310.0);
    return view_x == 60.0 && view_y == 40.0 && camera.view_to_world_x(view_x) == 425.0 && camera.view_to_world_y(view_y) == 310.0;
}

test `render history clamps alpha and collapses teleports`(): bool {
    history.world_camera_history_reset(10.0, 20.0);
    history.world_camera_history_advance(20.0, 40.0);
    if (history.interpolated_x(-1.0) != 10.0 || history.interpolated_y(0.0) != 20.0) {
        return false;
    }
    if (history.interpolated_x(0.5) != 15.0 || history.interpolated_y(0.5) != 30.0) {
        return false;
    }
    if (history.interpolated_x(1.0) != 20.0 || history.interpolated_y(2.0) != 40.0) {
        return false;
    }
    history.world_camera_history_advance_or_teleport(100.0, 200.0, 30.0);
    return history.interpolated_x(0.5) == 100.0 && history.interpolated_y(0.5) == 200.0;
}

test `supplied host and guest state project identically`(): bool {
    configure_large();
    peer_camera.world_camera_configure(0.0, 0.0, 1000.0, 800.0, 10.0, 20.0, 200.0, 100.0, 2.0);
    camera.world_camera_follow(333.0, 444.0);
    peer_camera.world_camera_follow(333.0, 444.0);
    return camera.origin_x == peer_camera.origin_x && camera.origin_y == peer_camera.origin_y && camera.world_to_view_x(350.0) == peer_camera.world_to_view_x(
        350.0
    ) && camera.world_to_view_y(460.0) == peer_camera.world_to_view_y(460.0);
}

test `viewport clipping emits ordered geometry`(): bool {
    configure_large();
    gfx_cmd_begin();
    camera.world_camera_clip_begin();
    camera.world_camera_clip_end();
    return gfx_cmd_clip_count() == 1 && gfx_cmd_order_count() == 2;
}

test `tile coverage and high density residency stay bounded`(): bool {
    camera.world_camera_configure(0.0, 0.0, 100000.0, 100000.0, 0.0, 0.0, 640.0, 360.0, 1.0);
    camera.world_camera_follow(50000.0, 50000.0);
    tiles.world_camera_tile_range_calculate(camera, 64.0, 1);
    if (tiles.first_x != 775 || tiles.first_y != 777 || tiles.end_x != 788 || tiles.end_y != 786 || tiles.count != 117) {
        return false;
    }
    if (tiles.status != 0 || tiles.effective_tile_world_size != 64.0 || tiles.coarsening_steps != 0) {
        return false;
    }
    let side: i32 = world_camera_raster_side(256, 4, 256);
    return side == 256 && world_camera_residency_bytes(side, 256) == WORLD_CAMERA_RESIDENCY_BUDGET_BYTES;
}

test `oversized spans coarsen without losing visible coverage`(): bool {
    camera.world_camera_configure(0.0, 0.0, 100000.0, 100000.0, 0.0, 0.0, 4096.0, 2048.0, 1.0);
    camera.world_camera_follow(50000.0, 50000.0);
    tiles.world_camera_tile_range_calculate(camera, 64.0, 1);
    if (tiles.status != 0 || tiles.effective_tile_world_size != 512.0 || tiles.coarsening_steps != 3) {
        return false;
    }
    let count_x: i32 = tiles.end_x - tiles.first_x;
    let count_y: i32 = tiles.end_y - tiles.first_y;
    if (count_x != 11 || count_y != 7 || tiles.count != 77) {
        return false;
    }
    let covered_min_x: f32 = i32_to_f32(tiles.first_x) * tiles.effective_tile_world_size;
    let covered_min_y: f32 = i32_to_f32(tiles.first_y) * tiles.effective_tile_world_size;
    let covered_max_x: f32 = i32_to_f32(tiles.end_x) * tiles.effective_tile_world_size;
    let covered_max_y: f32 = i32_to_f32(tiles.end_y) * tiles.effective_tile_world_size;
    if (count_x > WORLD_CAMERA_MAX_TILES_AXIS || count_y > WORLD_CAMERA_MAX_TILES_AXIS || tiles.count > WORLD_CAMERA_MAX_RESIDENT_TILES) {
        return false;
    }
    if (covered_min_x > camera.visible_world_min_x() || covered_min_y > camera.visible_world_min_y()) {
        return false;
    }
    return covered_max_x >= camera.visible_world_max_x() && covered_max_y >= camera.visible_world_max_y();
}
