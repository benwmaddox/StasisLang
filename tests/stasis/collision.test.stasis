import "../../src/stdlib/collision.stasis";

test `collision predicates accept scalar shape components`(): bool {
    if (!aabb_intersects(0.0, 0.0, 10.0, 10.0, 8.0, 8.0, 12.0, 12.0)) {
        return false;
    }
    if (!aabb_contains_point(0.0, 0.0, 10.0, 10.0, 5.0, 5.0)) {
        return false;
    }
    if (!circle_intersects(0.0, 0.0, 5.0, 8.0, 0.0, 4.0)) {
        return false;
    }
    if (!circle_contains_point(0.0, 0.0, 5.0, 3.0, 4.0)) {
        return false;
    }
    return true;
}

test `collision predicates reject separated shapes and outside points`(): bool {
    if (aabb_intersects(0.0, 0.0, 2.0, 2.0, 3.0, 0.0, 4.0, 1.0)) {
        return false;
    }
    if (aabb_contains_point(0.0, 0.0, 2.0, 2.0, 3.0, 1.0)) {
        return false;
    }
    if (circle_intersects(0.0, 0.0, 1.0, 3.0, 0.0, 1.0)) {
        return false;
    }
    if (circle_contains_point(0.0, 0.0, 1.0, 1.0, 1.0)) {
        return false;
    }
    return true;
}
