import "../src/stdlib/stdlib.stasis";
import "../src/stasisc_self/imports.stasis";

global t_path_common: ascii[260];
global t_path_a: ascii[260];
global t_path_entry: ascii[260];
global t_path_out: ascii[260];

global t_path_big: ascii[260];
global t_path_big_entry: ascii[260];
global t_path_big_out: ascii[260];

global t_argv0: ascii[260];
global t_exe_dir: ascii[260];

global t_tmp: ascii[2048];
global t_out: ascii[20000];
global t_big_data: u8[51201];

function t_init_cache_dir(): bool {
    let n: i32 = sys_argv(0, t_argv0, 260);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_argv0, n);
    sh_path_dirname(t_exe_dir, t_argv0);
    return !ascii_is_empty(t_exe_dir);
}

function t_append_line(buf: ascii[], text: ascii[]): void {
    ascii_append(buf, text);
    ascii_append_byte(buf, 10);
}

function t_append_import(buf: ascii[], rel_path: ascii[]): void {
    ascii_append(buf, "import ");
    ascii_append_byte(buf, 34);
    ascii_append(buf, rel_path);
    ascii_append_byte(buf, 34);
    ascii_append_byte(buf, 59);
    ascii_append_byte(buf, 10);
}

function t_write_ascii(path: ascii[], text: ascii[]): bool {
    return sys_write_file(path, text, ascii_len(text));
}

function t_count_substr(hay: ascii[], needle: ascii[]): i32 {
    let hlen: i32 = ascii_len(hay);
    let nlen: i32 = ascii_len(needle);
    if (nlen <= 0 || hlen < nlen) {
        return 0;
    }

    let count: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i <= hlen - nlen; i = i + 1) {
        let ok: bool = true;
        let j: i32 = 0;
        for (j = 0; j < nlen; j = j + 1) {
            if (hay[i + j] != needle[j]) {
                ok = false;
            }
        }
        if (ok) {
            count = count + 1;
        }
    }
    return count;
}

test `stasisc-self import expansion removes imports`() {
    if (!t_init_cache_dir()) {
        return false;
    }

    sh_path_join(t_path_common, t_exe_dir, "sh_common.stasis.inc");
    sh_path_join(t_path_a, t_exe_dir, "sh_a.stasis.inc");
    sh_path_join(t_path_entry, t_exe_dir, "sh_entry.stasis.inc");
    sh_path_join(t_path_out, t_exe_dir, "sh_entry_expanded.stasis");

    // common
    ascii_clear(t_tmp);
    t_append_line(t_tmp, "// common-marker");
    t_append_line(t_tmp, "global common_value: i32;");
    if (!t_write_ascii(t_path_common, t_tmp)) {
        return false;
    }

    // a imports common
    ascii_clear(t_tmp);
    t_append_import(t_tmp, "sh_common.stasis.inc");
    t_append_line(t_tmp, "// a-marker");
    t_append_line(t_tmp, "global a_value: i32;");
    if (!t_write_ascii(t_path_a, t_tmp)) {
        return false;
    }

    // entry imports a, then duplicates common
    ascii_clear(t_tmp);
    t_append_import(t_tmp, "sh_a.stasis.inc");
    t_append_import(t_tmp, "sh_common.stasis.inc");
    t_append_line(t_tmp, "// entry-marker");
    t_append_line(t_tmp, "global entry_value: i32;");
    if (!t_write_ascii(t_path_entry, t_tmp)) {
        return false;
    }

    let rc: i32 = sh_expand_entry(t_path_entry, t_path_out);
    if (rc != 0) {
        return false;
    }

    let n: i32 = sys_read_file(t_path_out, t_out, 20000);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_out, n);

    let i_common: i32 = ascii_find(t_out, "common-marker");
    let i_a: i32 = ascii_find(t_out, "a-marker");
    let i_entry: i32 = ascii_find(t_out, "entry-marker");

    if (i_common < 0 || i_a < 0 || i_entry < 0) {
        return false;
    }

    if (!(i_common < i_a && i_a < i_entry)) {
        return false;
    }

    if (ascii_find(t_out, "import ") >= 0) {
        return false;
    }

    return t_count_substr(t_out, "common-marker") == 1;
}

test `stasisc-self import expansion enforces 50KiB`() {
    if (!t_init_cache_dir()) {
        return false;
    }

    sh_quiet = 1;

    sh_path_join(t_path_big, t_exe_dir, "sh_big.stasis.inc");
    sh_path_join(t_path_big_entry, t_exe_dir, "sh_big_entry.stasis.inc");
    sh_path_join(t_path_big_out, t_exe_dir, "sh_big_entry_expanded.stasis");

    let i: i32 = 0;
    for (i = 0; i < 51201; i = i + 1) {
        t_big_data[i] = 97; // 'a'
    }
    if (!sys_write_file(t_path_big, t_big_data, 51201)) {
        return false;
    }

    ascii_clear(t_tmp);
    t_append_import(t_tmp, "sh_big.stasis.inc");
    t_append_line(t_tmp, "// big-entry-marker");
    if (!t_write_ascii(t_path_big_entry, t_tmp)) {
        return false;
    }

    let rc: i32 = sh_expand_entry(t_path_big_entry, t_path_big_out);
    return rc != 0;
}
