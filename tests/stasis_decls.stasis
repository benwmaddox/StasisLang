import "../src/stdlib/stdlib.stasis";
import "../src/stasis/imports.stasis";
import "../src/stasis/signatures.stasis";

global t_argv0: ascii[260];
global t_exe_dir: ascii[260];

global t_path: ascii[260];
global t_tmp: ascii[4096];

function t_init_exe_dir(): bool {
    let n: i32 = sys_argv(0, t_argv0, 260);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(t_argv0, n);
    sh_path_dirname(t_exe_dir, t_argv0);
    return !ascii_is_empty(t_exe_dir);
}

function t_append_line(buf: ascii[], text: ascii[]): void {
    ascii_append(buf, text);
    ascii_append_byte(buf, 10);
}

function t_write_ascii(path: ascii[], text: ascii[]): bool {
    return sys_write_file(path, text, ascii_len(text));
}

function t_span_eq(file_idx: i32, start: i32, len: i32, lit: ascii[]): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }
    if (len != ascii_len(lit)) {
        return false;
    }

    let base: i32 = sh.files[file_idx].offset + start;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (sh.pool[base + i] != lit[i]) {
            return false;
        }
    }
    return true;
}

test `stasis decl parsing records struct fields`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    sh_path_join(t_path, t_exe_dir, "sh_decls_struct.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "struct S {");
    t_append_line(t_tmp, "  a: i32;");
    t_append_line(t_tmp, "  b: i32[4];");
    t_append_line(t_tmp, "}");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    sh.quiet = 1;
    let rc: i32 = sh_load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sh_sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    if (sh.struct_count != 1) { return false; }
    if (sh.field_count != 2) { return false; }

    let fields_off: i32 = sh.structs[0].fields_off;
    let fields_len: i32 = sh.structs[0].fields_len;
    if (fields_len != 2) { return false; }

    let f0: i32 = fields_off + 0;
    let f1: i32 = fields_off + 1;

    if (!t_span_eq(sh.fields[f0].file_idx, sh.fields[f0].name_start, sh.fields[f0].name_len, "a")) { return false; }
    if (!t_span_eq(sh.fields[f1].file_idx, sh.fields[f1].name_start, sh.fields[f1].name_len, "b")) { return false; }

    // a: i32
    let t0: i32 = sh.fields[f0].type_idx;
    let k0: ShTypeKind = sh.types[t0].kind;
    if (k0 != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[t0].file_idx, sh.types[t0].start, sh.types[t0].len, "i32")) { return false; }

    // b: i32[4]
    let t1: i32 = sh.fields[f1].type_idx;
    let k1: ShTypeKind = sh.types[t1].kind;
    if (k1 != ShTypeKind.Array) { return false; }
    if (sh.types[t1].size != 4) { return false; }
    let t1e: i32 = sh.types[t1].elem;
    let k1e: ShTypeKind = sh.types[t1e].kind;
    if (k1e != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[t1e].file_idx, sh.types[t1e].start, sh.types[t1e].len, "i32")) { return false; }

    return true;
}

test `stasis decl parsing records enum members`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    sh_path_join(t_path, t_exe_dir, "sh_decls_enum.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "enum E { A = 3, B }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    sh.quiet = 1;
    let rc: i32 = sh_load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sh_sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    if (sh.enum_count != 1) { return false; }
    if (sh.enum_member_count != 2) { return false; }

    let members_off: i32 = sh.enums[0].members_off;
    let members_len: i32 = sh.enums[0].members_len;
    if (members_len != 2) { return false; }

    let m0: i32 = members_off + 0;
    let m1: i32 = members_off + 1;

    if (!t_span_eq(sh.enum_members[m0].file_idx, sh.enum_members[m0].name_start, sh.enum_members[m0].name_len, "A")) { return false; }
    if (sh.enum_members[m0].has_value == 0) { return false; }
    if (sh.enum_members[m0].value != 3) { return false; }

    if (!t_span_eq(sh.enum_members[m1].file_idx, sh.enum_members[m1].name_start, sh.enum_members[m1].name_len, "B")) { return false; }
    if (sh.enum_members[m1].has_value != 0) { return false; }

    return true;
}

test `stasis decl parsing records function decls and params`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    sh_path_join(t_path, t_exe_dir, "sh_decls_func.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "function f(a: i32, b: i32[4]): i32 { return a; }");
    t_append_line(t_tmp, "test `t`(): bool { return true; }");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    sh.quiet = 1;
    let rc: i32 = sh_load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sh_sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    if (sh.func_count != 2) { return false; }
    if (sh.param_count != 2) { return false; }

    // function f(a: i32, b: i32[4]): i32 { ... }
    if (!t_span_eq(sh.funcs[0].file_idx, sh.funcs[0].name_start, sh.funcs[0].name_len, "f")) { return false; }
    if (sh.funcs[0].is_test != 0) { return false; }
    if (sh.funcs[0].params_len != 2) { return false; }
    if (sh.funcs[0].body_start < 0) { return false; }
    if (sh.pool[sh.files[0].offset + sh.funcs[0].body_start] != 123) { return false; } // '{'

    let ret_kind: ShTypeKind = sh.types[sh.funcs[0].ret_type_idx].kind;
    if (ret_kind != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[sh.funcs[0].ret_type_idx].file_idx, sh.types[sh.funcs[0].ret_type_idx].start, sh.types[sh.funcs[0].ret_type_idx].len, "i32")) { return false; }

    let p0: i32 = sh.funcs[0].params_off + 0;
    let p1: i32 = sh.funcs[0].params_off + 1;
    if (!t_span_eq(sh.params[p0].file_idx, sh.params[p0].name_start, sh.params[p0].name_len, "a")) { return false; }
    if (!t_span_eq(sh.params[p1].file_idx, sh.params[p1].name_start, sh.params[p1].name_len, "b")) { return false; }

    let p0_kind: ShTypeKind = sh.types[sh.params[p0].type_idx].kind;
    if (p0_kind != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[sh.params[p0].type_idx].file_idx, sh.types[sh.params[p0].type_idx].start, sh.types[sh.params[p0].type_idx].len, "i32")) { return false; }

    let p1_kind: ShTypeKind = sh.types[sh.params[p1].type_idx].kind;
    if (p1_kind != ShTypeKind.Array) { return false; }
    if (sh.types[sh.params[p1].type_idx].size != 4) { return false; }

    // test `t`(): bool { ... }
    if (sh.funcs[1].is_test == 0) { return false; }
    if (sh.funcs[1].params_len != 0) { return false; }
    if (sh.funcs[1].body_start < 0) { return false; }
    if (sh.pool[sh.files[0].offset + sh.funcs[1].body_start] != 123) { return false; } // '{'

    let test_ret_kind: ShTypeKind = sh.types[sh.funcs[1].ret_type_idx].kind;
    if (test_ret_kind != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[sh.funcs[1].ret_type_idx].file_idx, sh.types[sh.funcs[1].ret_type_idx].start, sh.types[sh.funcs[1].ret_type_idx].len, "bool")) { return false; }

    return true;
}

test `stasis decl parsing records global and const decls`() {
    if (!t_init_exe_dir()) {
        return false;
    }

    sh_path_join(t_path, t_exe_dir, "sh_decls_values.stasis.inc");

    ascii_clear(t_tmp);
    t_append_line(t_tmp, "global g: i32 = 1;");
    t_append_line(t_tmp, "const c: i32 = 2;");
    if (!t_write_ascii(t_path, t_tmp)) {
        return false;
    }

    sh.quiet = 1;
    let rc: i32 = sh_load_graph(t_path);
    if (rc != 0) {
        return false;
    }
    let errors: i32 = sh_sig_scan_loaded_files();
    if (errors != 0) {
        return false;
    }

    if (sh.global_count != 1) { return false; }
    if (sh.const_count != 1) { return false; }

    if (!t_span_eq(sh.globals[0].file_idx, sh.globals[0].name_start, sh.globals[0].name_len, "g")) { return false; }
    if (sh.globals[0].has_init == 0) { return false; }
    if (sh.pool[sh.files[0].offset + sh.globals[0].init_start] != 49) { return false; } // '1'
    let g_kind: ShTypeKind = sh.types[sh.globals[0].type_idx].kind;
    if (g_kind != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[sh.globals[0].type_idx].file_idx, sh.types[sh.globals[0].type_idx].start, sh.types[sh.globals[0].type_idx].len, "i32")) { return false; }

    if (!t_span_eq(sh.consts[0].file_idx, sh.consts[0].name_start, sh.consts[0].name_len, "c")) { return false; }
    if (sh.consts[0].init_start < 0) { return false; }
    if (sh.pool[sh.files[0].offset + sh.consts[0].init_start] != 50) { return false; } // '2'
    let c_kind: ShTypeKind = sh.types[sh.consts[0].type_idx].kind;
    if (c_kind != ShTypeKind.Named) { return false; }
    if (!t_span_eq(sh.types[sh.consts[0].type_idx].file_idx, sh.types[sh.consts[0].type_idx].start, sh.types[sh.consts[0].type_idx].len, "i32")) { return false; }

    return true;
}
