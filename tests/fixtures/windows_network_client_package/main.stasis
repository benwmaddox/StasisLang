import "/vendor/stasis/stdlib/network_client.stasis";

global network_inbox: u8[4];
global network_outbox: u8[4];
global network_phase: i32;

function network_bytes_match(a: i32, b: i32, c: i32, d: i32): bool {
    return network_inbox[0] == a && network_inbox[1] == b && network_inbox[2] == c && network_inbox[3] == d;
}

function network_send_bytes(a: i32, b: i32, c: i32, d: i32): i32 {
    network_outbox[0] = a;
    network_outbox[1] = b;
    network_outbox[2] = c;
    network_outbox[3] = d;
    return network_client_send(network_outbox, 4);
}

function main(): i32 {
    if (network_client_supported() != 1) {
        return 71;
    }
    if (network_client_status() != 0) {
        return 72;
    }
    if (network_client_connect() != 0) {
        return 73;
    }
    network_phase = 0;
    return 0;
}

function tick(): i32 {
    if (network_phase == 0) {
        if (network_client_status() == 1) {
            if (network_send_bytes(80, 73, 78, 71) != 0) {
                return 74;
            }
            network_phase = 1;
        }
        return 0;
    }
    let received: i32 = network_client_poll(network_inbox);
    if (received < 0) {
        return 75;
    }
    if (received == 0) {
        return 0;
    }
    if (received != 4) {
        return 76;
    }
    if (network_phase == 1) {
        if (!network_bytes_match(80, 79, 78, 71)) {
            return 77;
        }
        if (network_client_checkpoint(2, 41) != 0) {
            return 78;
        }
        if (network_client_resume_seat() != 2) {
            return 79;
        }
        if (network_client_last_sequence() != 41) {
            return 80;
        }
        if (network_send_bytes(68, 79, 78, 69) != 0) {
            return 81;
        }
        network_phase = 2;
        return 0;
    }
    if (!network_bytes_match(66, 89, 69, 33)) {
        return 82;
    }
    return 83;
}

function render(): i32 {
    return 0;
}
