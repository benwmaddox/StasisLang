import "../src/feature_reference.stasis";

test `nested settings defaults initialize every owner and collection lane`(): bool {
    if (player.settings.health != 100 || player.settings.speed != 0.1 || !player.settings.enabled || player.settings.retries != 0) {
        return false;
    }

    for (let index: i32 = 0; index < 8; index += 1) {
        if (
            agents[index].settings.health != 100
            || agents[index].settings.speed != 0.1
            || !agents[index].settings.enabled
            || agents[index].settings.retries != 0
        ) {
            return false;
        }
    }

    agents[3].settings.health = 75;

    let explicit_override: bool = agents[3].settings.health == 75;
    let other_state_unchanged: bool = agents[2].settings.health == 100 && agents[3].settings.enabled && player.settings.health == 100 && player.settings.enabled;

    agents[3].settings.health = 100;

    return explicit_override && other_state_unchanged;
}

test `generic capacity and queue stop at their bounds`(): bool {
    scores.count = 0;
    recent_scores.clear();
    if (scores.capacity() != 4) {
        return false;
    }
    for (let index: i32 = 0; index < 4; index += 1) {
        if (!enqueue_score(index)) {
            return false;
        }
    }
    return recent_scores.count() == 4 && !enqueue_score(4);
}
