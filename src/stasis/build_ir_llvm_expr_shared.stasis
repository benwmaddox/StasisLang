import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function sh_llvm_emit_member_value_or_place(file_idx: i32, expr_idx: i32, mode: i32, base_id: i32, base_kind: ShLlvmValueKind, base_si: i32): i32 {
    sh.llvm_place_kind = ShLlvmValueKind.I32;
    sh.llvm_place_struct_idx = -1;

    if (base_kind != ShLlvmValueKind.PtrStruct || base_si < 0) {
        sh_build_err_at(file_idx, "member access on non-struct (llvm bring-up)", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    let field_rel: i32 = sh_build_find_struct_field(base_si, file_idx, sh.expr_nodes[expr_idx].name_start, sh.expr_nodes[expr_idx].name_len);
    if (field_rel < 0) {
        sh_build_err_at(file_idx, "unknown struct field", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    let field_ptr: i32 = sh_llvm_emit_gep_struct_field(base_id, base_si, field_rel);

    let field_abs: i32 = sh.structs[base_si].fields_off + field_rel;
    if (field_abs < 0 || field_abs >= sh.field_count) {
        sh_build_err_at(file_idx, "invalid struct field", sh.expr_nodes[expr_idx].at);
        return -1;
    }
    let field_ty: i32 = sh.fields[field_abs].type_idx;
    if (field_ty < 0 || field_ty >= sh.type_count) {
        sh_build_err_at(file_idx, "invalid struct field type", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    let fk: ShTypeKind = sh.types[field_ty].kind;
    if (fk == ShTypeKind.Named) {
        if (sh_build_type_is_byte_named(field_ty)) {
            if (mode == 0) {
                sh.llvm_place_kind = ShLlvmValueKind.I32;
                sh.llvm_place_struct_idx = -1;
                return sh_llvm_emit_load_i8_zext_from_ptr(field_ptr);
            }
            sh.llvm_place_kind = ShLlvmValueKind.I8;
            sh.llvm_place_struct_idx = -1;
            return field_ptr;
        }

        if (sh_build_type_is_i32ish(field_ty)) {
            sh.llvm_place_kind = ShLlvmValueKind.I32;
            sh.llvm_place_struct_idx = -1;
            if (mode == 0) {
                return sh_llvm_emit_load_i32_from_ptr(field_ptr);
            }
            return field_ptr;
        }

        let si2: i32 = sh_build_find_struct_decl_for_type(field_ty);
        if (si2 < 0) {
            sh_build_err_at(file_idx, "unsupported struct field type (llvm bring-up)", sh.expr_nodes[expr_idx].at);
            return -1;
        }
        sh.llvm_place_kind = ShLlvmValueKind.PtrStruct;
        sh.llvm_place_struct_idx = si2;
        return field_ptr;
    }

    if (fk == ShTypeKind.Array) {
        if (sh.types[field_ty].size == 0) {
            sh_build_err_at(file_idx, "slice fields not yet supported (llvm bring-up)", sh.expr_nodes[expr_idx].at);
            return -1;
        }
        return sh_llvm_decay_fixed_array_ptr(file_idx, sh.expr_nodes[expr_idx].at, field_ptr, field_ty);
    }

    sh_build_err_at(file_idx, "unsupported struct field type (llvm bring-up)", sh.expr_nodes[expr_idx].at);
    return -1;
}

function sh_llvm_emit_index_value_or_place(file_idx: i32, expr_idx: i32, mode: i32, base_id: i32, base_kind: ShLlvmValueKind, base_si: i32, index_id: i32, index_kind: ShLlvmValueKind): i32 {
    sh.llvm_place_kind = ShLlvmValueKind.I32;
    sh.llvm_place_struct_idx = -1;

    if (index_kind != ShLlvmValueKind.I32) {
        sh_build_err_at(file_idx, "invalid index (expected i32)", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    if (base_kind == ShLlvmValueKind.PtrI8) {
        let elem_ptr: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(elem_ptr);
        ascii_append(sh.ir_out, " = getelementptr inbounds i8, ptr ");
        sh_llvm_append_tmp(base_id);
        ascii_append(sh.ir_out, ", i32 ");
        sh_llvm_append_tmp(index_id);
        ascii_append(sh.ir_out, "\n");

        if (mode == 0) {
            sh.llvm_place_kind = ShLlvmValueKind.I32;
            sh.llvm_place_struct_idx = -1;
            return sh_llvm_emit_load_i8_zext_from_ptr(elem_ptr);
        }
        sh.llvm_place_kind = ShLlvmValueKind.I8;
        sh.llvm_place_struct_idx = -1;
        return elem_ptr;
    }

    if (base_kind == ShLlvmValueKind.PtrI32) {
        let elem_ptr2: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(elem_ptr2);
        ascii_append(sh.ir_out, " = getelementptr inbounds i32, ptr ");
        sh_llvm_append_tmp(base_id);
        ascii_append(sh.ir_out, ", i32 ");
        sh_llvm_append_tmp(index_id);
        ascii_append(sh.ir_out, "\n");

        sh.llvm_place_kind = ShLlvmValueKind.I32;
        sh.llvm_place_struct_idx = -1;
        if (mode == 0) {
            return sh_llvm_emit_load_i32_from_ptr(elem_ptr2);
        }
        return elem_ptr2;
    }

    if (base_kind == ShLlvmValueKind.PtrStruct && base_si >= 0) {
        let elem_ptr3: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(elem_ptr3);
        ascii_append(sh.ir_out, " = getelementptr inbounds %");
        sh_llvm_append_struct_ir_name(base_si);
        ascii_append(sh.ir_out, ", ptr ");
        sh_llvm_append_tmp(base_id);
        ascii_append(sh.ir_out, ", i32 ");
        sh_llvm_append_tmp(index_id);
        ascii_append(sh.ir_out, "\n");

        sh.llvm_place_kind = ShLlvmValueKind.PtrStruct;
        sh.llvm_place_struct_idx = base_si;
        return elem_ptr3;
    }

    sh_build_err_at(file_idx, "indexing non-array pointer (llvm bring-up)", sh.expr_nodes[expr_idx].at);
    return -1;
}

function sh_llvm_emit_icmp_to_i32(pred: ascii[], a_id: i32, b_id: i32): i32 {
    let id_cmp: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id_cmp);
    ascii_append(sh.ir_out, " = icmp ");
    ascii_append(sh.ir_out, pred);
    ascii_append(sh.ir_out, " i32 ");
    sh_llvm_append_tmp(a_id);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(b_id);
    ascii_append(sh.ir_out, "\n");

    let id_z: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id_z);
    ascii_append(sh.ir_out, " = zext i1 ");
    sh_llvm_append_tmp(id_cmp);
    ascii_append(sh.ir_out, " to i32\n");
    return id_z;
}

function sh_llvm_emit_logic_to_i32(op: ascii[], a_id: i32, b_id: i32): i32 {
    let zero_a: i32 = sh_llvm_emit_const_i32(0);
    let zero_b: i32 = zero_a;

    let a_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(a_i1);
    ascii_append(sh.ir_out, " = icmp ne i32 ");
    sh_llvm_append_tmp(a_id);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(zero_a);
    ascii_append(sh.ir_out, "\n");

    let b_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(b_i1);
    ascii_append(sh.ir_out, " = icmp ne i32 ");
    sh_llvm_append_tmp(b_id);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(zero_b);
    ascii_append(sh.ir_out, "\n");

    let out_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(out_i1);
    ascii_append(sh.ir_out, " = ");
    ascii_append(sh.ir_out, op);
    ascii_append(sh.ir_out, " i1 ");
    sh_llvm_append_tmp(a_i1);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(b_i1);
    ascii_append(sh.ir_out, "\n");

    let out_i32: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(out_i32);
    ascii_append(sh.ir_out, " = zext i1 ");
    sh_llvm_append_tmp(out_i1);
    ascii_append(sh.ir_out, " to i32\n");
    return out_i32;
}

function sh_llvm_emit_expr_i1(file_idx: i32, root: i32): i32 {
    let v_i32: i32 = sh_llvm_emit_expr_i32(file_idx, root);
    if (v_i32 < 0) {
        return -1;
    }

    let out_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(out_i1);
    ascii_append(sh.ir_out, " = icmp ne i32 ");
    sh_llvm_append_tmp(v_i32);
    ascii_append(sh.ir_out, ", 0\n");
    return out_i1;
}

function sh_llvm_emit_expr_i32_v1(file_idx: i32, root: i32): i32 {
    if (root < 0) {
        return -1;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;
    sh.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = sh.parse_stack_start[sp - 1];
        if (top >= 0) {
            sh.parse_stack_start[sp - 1] = -top - 1;

            let kind: ShExprKind = sh.expr_nodes[top].kind;
            if (kind == ShExprKind.Unary) {
                if (sp >= 4096) {
                    sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                    return -1;
                }
                sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ShExprKind.Call) {
                    let argc0: i32 = sh.expr_nodes[top].value;
                    let off0: i32 = sh.expr_nodes[top].right;
                    if (argc0 < 0) {
                        sh_build_err_at(file_idx, "invalid call argument count", sh.expr_nodes[top].at);
                        return -1;
                    }
                    if (sp + argc0 >= 4096) {
                        sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                        return -1;
                    }

                    let ai: i32 = 0;
                    for (ai = argc0 - 1; ai >= 0; ai = ai - 1) {
                        sh.parse_stack_start[sp] = sh.expr_call_args[off0 + ai];
                        sp = sp + 1;
                    }
                } else {
                if (kind == ShExprKind.Binary) {
                    if (sp + 1 >= 4096) {
                        sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                        return -1;
                    }
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].right;
                    sp = sp + 1;
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                    sp = sp + 1;
                } else {
                    if (kind == ShExprKind.Assign) {
                        if (sp >= 4096) {
                            sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                            return -1;
                        }
                        sh.parse_stack_start[sp] = sh.expr_nodes[top].right;
                        sp = sp + 1;
                    }
                }
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= 4096) {
                sh_build_err_at(file_idx, "expression too complex (value stack)", sh.expr_nodes[idx].at);
                return -1;
            }

            let kind2: ShExprKind = sh.expr_nodes[idx].kind;
            if (kind2 == ShExprKind.IntLiteral || kind2 == ShExprKind.BoolLiteral) {
                sh.expr_op_at[val_len] = sh_llvm_emit_const_i32(sh.expr_nodes[idx].value);
                val_len = val_len + 1;
            } else {
                if (kind2 == ShExprKind.Call) {
                    let argc: i32 = sh.expr_nodes[idx].value;
                    let callee_expr: i32 = sh.expr_nodes[idx].left;

                    if (argc < 0 || val_len < argc) {
                        sh_build_err_at(file_idx, "invalid call expression", sh.expr_nodes[idx].at);
                        return -1;
                    }

                    let fn_idx0: i32 = sh_llvm_resolve_callee_func(file_idx, callee_expr, sh.expr_nodes[idx].at);
                    if (fn_idx0 < 0) {
                        return -1;
                    }
                    if (sh.funcs[fn_idx0].body_start < 0) {
                        sh_build_err_at(file_idx, "function has no body (call)", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (!sh_build_type_is_i32ish(sh.funcs[fn_idx0].ret_type_idx)) {
                        sh_build_err_at(file_idx, "unsupported call return type (expected i32)", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (sh.funcs[fn_idx0].params_len != argc) {
                        sh_build_err_at(file_idx, "call arg count mismatch", sh.expr_nodes[idx].at);
                        return -1;
                    }

                    let pi: i32 = 0;
                    for (pi = 0; pi < argc; pi = pi + 1) {
                        let p_decl: i32 = sh.funcs[fn_idx0].params_off + pi;
                        if (p_decl < 0 || p_decl >= sh.param_count) {
                            sh_build_err_at(file_idx, "invalid function parameters", sh.expr_nodes[idx].at);
                            return -1;
                        }
                        if (!sh_build_type_is_i32ish(sh.params[p_decl].type_idx)) {
                            sh_build_err_at(file_idx, "unsupported call arg type (expected i32)", sh.expr_nodes[idx].at);
                            return -1;
                        }
                    }

                    let arg_base: i32 = val_len - argc;
                    let out_id0: i32 = sh_llvm_new_tmp();
                    ascii_append(sh.ir_out, "  ");
                    sh_llvm_append_tmp(out_id0);
                    ascii_append(sh.ir_out, " = call i32 @");
                    sh_llvm_append_func_ir_name(fn_idx0);
                    ascii_append(sh.ir_out, "(");

                    let ai2: i32 = 0;
                    for (ai2 = 0; ai2 < argc; ai2 = ai2 + 1) {
                        if (ai2 != 0) {
                            ascii_append(sh.ir_out, ", ");
                        }
                        ascii_append(sh.ir_out, "i32 ");
                        sh_llvm_append_tmp(sh.expr_op_at[arg_base + ai2]);
                    }

                    ascii_append(sh.ir_out, ")\n");

                    val_len = arg_base;
                    sh.expr_op_at[val_len] = out_id0;
                    val_len = val_len + 1;
                } else {
                if (kind2 == ShExprKind.Name) {
                    let local_id: i32 = sh_llvm_find_local(file_idx, sh.expr_nodes[idx].name_start, sh.expr_nodes[idx].name_len);
                    if (local_id < 0) {
                        sh_build_err_at(file_idx, "unknown local", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (sh.llvm_local_declared[local_id] == 0) {
                        sh_build_err_at(file_idx, "local used before declaration", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    sh.expr_op_at[val_len] = sh_llvm_emit_load_local(local_id);
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ShExprKind.Unary) {
                        if (val_len < 1) {
                            sh_build_err_at(file_idx, "invalid expression", sh.expr_nodes[idx].at);
                            return -1;
                        }
                        let v_id: i32 = sh.expr_op_at[val_len - 1];
                        val_len = val_len - 1;

                        let op: ShTok = sh.expr_nodes[idx].op;
                        let out_id: i32 = -1;
                        if (op == ShTok.UnaryMinus) {
                            let zero_id: i32 = sh_llvm_emit_const_i32(0);
                            out_id = sh_llvm_new_tmp();
                            ascii_append(sh.ir_out, "  ");
                            sh_llvm_append_tmp(out_id);
                            ascii_append(sh.ir_out, " = sub i32 ");
                            sh_llvm_append_tmp(zero_id);
                            ascii_append(sh.ir_out, ", ");
                            sh_llvm_append_tmp(v_id);
                            ascii_append(sh.ir_out, "\n");
                        } else {
                            if (op == ShTok.Bang) {
                                let zero_id2: i32 = sh_llvm_emit_const_i32(0);
                                out_id = sh_llvm_emit_icmp_to_i32("eq", v_id, zero_id2);
                            } else {
                                sh_build_err_at(file_idx, "unsupported unary operator", sh.expr_nodes[idx].at);
                                return -1;
                            }
                        }

                        sh.expr_op_at[val_len] = out_id;
                        val_len = val_len + 1;
                    } else {
                        if (kind2 == ShExprKind.Binary) {
                            if (val_len < 2) {
                                sh_build_err_at(file_idx, "invalid expression", sh.expr_nodes[idx].at);
                                return -1;
                            }
                            let b_id: i32 = sh.expr_op_at[val_len - 1];
                            let a_id: i32 = sh.expr_op_at[val_len - 2];
                            val_len = val_len - 2;

                            let op2: ShTok = sh.expr_nodes[idx].op;
                            let out2: i32 = -1;

                            if (op2 == ShTok.Plus || op2 == ShTok.Minus || op2 == ShTok.Star || op2 == ShTok.Slash || op2 == ShTok.Percent) {
                                out2 = sh_llvm_new_tmp();
                                ascii_append(sh.ir_out, "  ");
                                sh_llvm_append_tmp(out2);
                                ascii_append(sh.ir_out, " = ");
                                if (op2 == ShTok.Plus) { ascii_append(sh.ir_out, "add"); }
                                if (op2 == ShTok.Minus) { ascii_append(sh.ir_out, "sub"); }
                                if (op2 == ShTok.Star) { ascii_append(sh.ir_out, "mul"); }
                                if (op2 == ShTok.Slash) { ascii_append(sh.ir_out, "sdiv"); }
                                if (op2 == ShTok.Percent) { ascii_append(sh.ir_out, "srem"); }
                                ascii_append(sh.ir_out, " i32 ");
                                sh_llvm_append_tmp(a_id);
                                ascii_append(sh.ir_out, ", ");
                                sh_llvm_append_tmp(b_id);
                                ascii_append(sh.ir_out, "\n");
                            } else {
                                // Comparisons + logical.
                                let handled_cmp: i32 = 0;
                                if (op2 == ShTok.EqualEqual) { out2 = sh_llvm_emit_icmp_to_i32("eq", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.BangEqual) { out2 = sh_llvm_emit_icmp_to_i32("ne", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.Less) { out2 = sh_llvm_emit_icmp_to_i32("slt", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.LessEqual) { out2 = sh_llvm_emit_icmp_to_i32("sle", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.Greater) { out2 = sh_llvm_emit_icmp_to_i32("sgt", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.GreaterEqual) { out2 = sh_llvm_emit_icmp_to_i32("sge", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.AmpAmp) { out2 = sh_llvm_emit_logic_to_i32("and", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.PipePipe) { out2 = sh_llvm_emit_logic_to_i32("or", a_id, b_id); handled_cmp = 1; }

                                if (handled_cmp == 0) {
                                    sh_build_err_at(file_idx, "unsupported operator", sh.expr_nodes[idx].at);
                                    return -1;
                                }
                            }

                            sh.expr_op_at[val_len] = out2;
                            val_len = val_len + 1;
                        } else {
                            if (kind2 == ShExprKind.Assign) {
                                if (val_len < 1) {
                                    sh_build_err_at(file_idx, "invalid assignment expression", sh.expr_nodes[idx].at);
                                    return -1;
                                }

                                let rhs_id: i32 = sh.expr_op_at[val_len - 1];
                                val_len = val_len - 1;

                                let lhs_idx: i32 = sh.expr_nodes[idx].left;
                                if (lhs_idx < 0) {
                                    sh_build_err_at(file_idx, "unsupported assignment target", sh.expr_nodes[idx].at);
                                    return -1;
                                }
                                let lhs_kind: ShExprKind = sh.expr_nodes[lhs_idx].kind;
                                if (lhs_kind != ShExprKind.Name) {
                                    sh_build_err_at(file_idx, "unsupported assignment target", sh.expr_nodes[idx].at);
                                    return -1;
                                }

                                let local_id2: i32 = sh_llvm_find_local(file_idx, sh.expr_nodes[lhs_idx].name_start, sh.expr_nodes[lhs_idx].name_len);
                                if (local_id2 < 0) {
                                    sh_build_err_at(file_idx, "unknown local", sh.expr_nodes[lhs_idx].at);
                                    return -1;
                                }
                                if (sh.llvm_local_declared[local_id2] == 0) {
                                    sh_build_err_at(file_idx, "local used before declaration", sh.expr_nodes[lhs_idx].at);
                                    return -1;
                                }

                                let aop: ShTok = sh.expr_nodes[idx].op;
                                if (aop == ShTok.Equal) {
                                    sh_llvm_emit_store_local(local_id2, rhs_id);
                                    sh.expr_op_at[val_len] = rhs_id;
                                    val_len = val_len + 1;
                                } else {
                                    // Compound assignment: load, apply op, store.
                                    let old_id: i32 = sh_llvm_emit_load_local(local_id2);
                                    let new_id: i32 = sh_llvm_new_tmp();

                                    ascii_append(sh.ir_out, "  ");
                                    sh_llvm_append_tmp(new_id);
                                    ascii_append(sh.ir_out, " = ");
                                    if (aop == ShTok.PlusEqual) { ascii_append(sh.ir_out, "add"); }
                                    if (aop == ShTok.MinusEqual) { ascii_append(sh.ir_out, "sub"); }
                                    if (aop == ShTok.StarEqual) { ascii_append(sh.ir_out, "mul"); }
                                    if (aop == ShTok.SlashEqual) { ascii_append(sh.ir_out, "sdiv"); }
                                    if (aop == ShTok.PercentEqual) { ascii_append(sh.ir_out, "srem"); }
                                    ascii_append(sh.ir_out, " i32 ");
                                    sh_llvm_append_tmp(old_id);
                                    ascii_append(sh.ir_out, ", ");
                                    sh_llvm_append_tmp(rhs_id);
                                    ascii_append(sh.ir_out, "\n");

                                    sh_llvm_emit_store_local(local_id2, new_id);
                                    sh.expr_op_at[val_len] = new_id;
                                    val_len = val_len + 1;
                                }
                            } else {
                                sh_build_err_at(file_idx, "unsupported expression", sh.expr_nodes[idx].at);
                                return -1;
                            }
                        }
                    }
                }
                }
            }
        }
    }

    if (val_len != 1) {
        sh_build_err_at(file_idx, "invalid expression", sh.expr_nodes[root].at);
        return -1;
    }
    return sh.expr_op_at[0];
}

