import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function sh_llvm_find_func_noargs_i32(file_idx: i32, name_start: i32, name_len: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.func_count; i = i + 1) {
        if (sh.funcs[i].is_test == 0) {
            if (sh.funcs[i].file_idx == file_idx) {
                if (sh.funcs[i].params_len == 0) {
                    if (sh_build_type_is_i32(sh.funcs[i].ret_type_idx)) {
                        if (sh_span_eq_span(file_idx, name_start, name_len, sh.funcs[i].name_start, sh.funcs[i].name_len)) {
                            return i;
                        }
                    }
                }
            }
        }
    }
    return -1;
}

function sh_span_eq_span(file_idx: i32, a_start: i32, a_len: i32, b_start: i32, b_len: i32): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }
    if (a_len != b_len) {
        return false;
    }

    let base: i32 = sh.files[file_idx].offset;
    let i: i32 = 0;
    for (i = 0; i < a_len; i = i + 1) {
        if (sh.pool[base + a_start + i] != sh.pool[base + b_start + i]) {
            return false;
        }
    }
    return true;
}

function sh_span_eq_span_cross(a_file_idx: i32, a_start: i32, a_len: i32, b_file_idx: i32, b_start: i32, b_len: i32): bool {
    if (a_file_idx < 0 || a_file_idx >= sh.file_count) { return false; }
    if (b_file_idx < 0 || b_file_idx >= sh.file_count) { return false; }
    if (a_len != b_len) { return false; }

    let a_base: i32 = sh.files[a_file_idx].offset + a_start;
    let b_base: i32 = sh.files[b_file_idx].offset + b_start;
    let i: i32 = 0;
    for (i = 0; i < a_len; i = i + 1) {
        if (sh.pool[a_base + i] != sh.pool[b_base + i]) {
            return false;
        }
    }
    return true;
}

function sh_span_eq_module_name(caller_file_idx: i32, mod_start: i32, mod_len: i32, module_file_idx: i32): bool {
    if (caller_file_idx < 0 || caller_file_idx >= sh.file_count) { return false; }
    if (module_file_idx < 0 || module_file_idx >= sh.file_count) { return false; }

    let want_len: i32 = sh.files[module_file_idx].mod_len;
    if (mod_len != want_len) {
        return false;
    }

    let a_base: i32 = sh.files[caller_file_idx].offset + mod_start;
    let b_base: i32 = sh.files[module_file_idx].mod_off;
    let i: i32 = 0;
    for (i = 0; i < mod_len; i = i + 1) {
        if (sh.pool[a_base + i] != sh.mod_pool[b_base + i]) {
            return false;
        }
    }
    return true;
}

function sh_llvm_find_imported_module(caller_file_idx: i32, mod_start: i32, mod_len: i32): i32 {
    // Allow `ThisModule.symbol` for clarity.
    if (sh_span_eq_module_name(caller_file_idx, mod_start, mod_len, caller_file_idx)) {
        return caller_file_idx;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        if (sh_span_eq_module_name(caller_file_idx, mod_start, mod_len, mod_file)) {
            return mod_file;
        }
    }
    return -1;
}

function sh_llvm_find_func_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.func_count; i = i + 1) {
        if (sh.funcs[i].is_test == 0) {
            if (sh.funcs[i].file_idx == target_file_idx) {
                if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, sh.funcs[i].name_start, sh.funcs[i].name_len)) {
                    return i;
                }
            }
        }
    }
    return -1;
}

function sh_llvm_find_global_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.global_count; i = i + 1) {
        if (sh.globals[i].file_idx == target_file_idx) {
            if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, sh.globals[i].name_start, sh.globals[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function sh_llvm_find_const_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.const_count; i = i + 1) {
        if (sh.consts[i].file_idx == target_file_idx) {
            if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, sh.consts[i].name_start, sh.consts[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function sh_llvm_try_resolve_unqualified_const(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = sh_llvm_find_const_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let found: i32 = -1;

    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        let hit: i32 = sh_llvm_find_const_in_file(caller_file_idx, name_start, name_len, mod_file);
        if (hit >= 0) {
            if (found < 0) {
                found = hit;
            } else {
                sh_build_err_at(caller_file_idx, "ambiguous const name (use Module.symbol)", at);
                return -2;
            }
        }
    }
    return found;
}

function sh_llvm_eval_const_i32(caller_file_idx: i32, const_idx: i32, at: i32): i32 {
    sh.expr_eval_failed = 0;
    if (const_idx < 0 || const_idx >= sh.const_count) {
        sh_build_err_at(caller_file_idx, "invalid const reference", at);
        sh.expr_eval_failed = 1;
        return 0;
    }

    let file_idx: i32 = sh.consts[const_idx].file_idx;
    let start: i32 = sh.consts[const_idx].init_start;
    if (file_idx < 0 || file_idx >= sh.file_count || start < 0) {
        sh_build_err_at(caller_file_idx, "const has no initializer", at);
        sh.expr_eval_failed = 1;
        return 0;
    }

    let base: i32 = sh.files[file_idx].offset + start;
    let sign: i32 = 1;
    if (sh.pool[base] == 45) {
        sign = -1;
        base = base + 1;
    }

    let v: i32 = 0;
    let i: i32 = 0;
    let done: i32 = 0;
    for (; done == 0; ) {
        let b: u8 = sh.pool[base + i];
        if (!ascii_is_digit(b)) {
            done = 1;
        } else {
            v = v * 10 + ascii_to_digit(b);
            i = i + 1;
        }
    }
    if (i == 0) {
        sh_build_err_at(caller_file_idx, "unsupported const initializer (expected integer literal)", at);
        sh.expr_eval_failed = 1;
        return 0;
    }
    return v * sign;
}

function sh_llvm_emit_const_f32_from_const(caller_file_idx: i32, const_idx: i32, at: i32): i32 {
    if (const_idx < 0 || const_idx >= sh.const_count) {
        sh_build_err_at(caller_file_idx, "invalid const reference", at);
        return -1;
    }

    let file_idx: i32 = sh.consts[const_idx].file_idx;
    let start: i32 = sh.consts[const_idx].init_start;
    if (file_idx < 0 || file_idx >= sh.file_count || start < 0) {
        sh_build_err_at(caller_file_idx, "const has no initializer", at);
        return -1;
    }

    let base: i32 = sh.files[file_idx].offset + start;
    let i: i32 = 0;
    let saw_digit: i32 = 0;
    let saw_dot: i32 = 0;

    if (sh.pool[base] == 45) {
        i = 1;
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        let b: u8 = sh.pool[base + i];
        if (ascii_is_digit(b)) {
            saw_digit = 1;
            i = i + 1;
        } else {
            if (b == 46 && saw_dot == 0) {
                saw_dot = 1;
                i = i + 1;
            } else {
                done = 1;
            }
        }
    }

    if (saw_digit == 0 || saw_dot == 0) {
        sh_build_err_at(caller_file_idx, "unsupported const initializer (expected float literal)", at);
        return -1;
    }

    return sh_llvm_emit_const_f32_from_span(file_idx, start, i);
}

function sh_llvm_find_enum_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.enum_count; i = i + 1) {
        if (sh.enums[i].file_idx == target_file_idx) {
            if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, sh.enums[i].name_start, sh.enums[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function sh_llvm_try_resolve_unqualified_enum(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = sh_llvm_find_enum_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let found: i32 = -1;

    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        let hit: i32 = sh_llvm_find_enum_in_file(caller_file_idx, name_start, name_len, mod_file);
        if (hit >= 0) {
            if (found < 0) {
                found = hit;
            } else {
                sh_build_err_at(caller_file_idx, "ambiguous enum name (use Module.symbol)", at);
                return -2;
            }
        }
    }
    return found;
}

function sh_llvm_find_enum_member(named_file_idx: i32, name_start: i32, name_len: i32, enum_idx: i32): i32 {
    if (enum_idx < 0 || enum_idx >= sh.enum_count) {
        return -1;
    }
    let off: i32 = sh.enums[enum_idx].members_off;
    let len: i32 = sh.enums[enum_idx].members_len;

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        let mi: i32 = off + i;
        if (mi >= 0 && mi < sh.enum_member_count) {
            if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, sh.enum_members[mi].file_idx, sh.enum_members[mi].name_start, sh.enum_members[mi].name_len)) {
                return mi;
            }
        }
    }
    return -1;
}

function sh_llvm_resolve_unqualified_global(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = sh_llvm_find_global_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let found: i32 = -1;

    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        let hit: i32 = sh_llvm_find_global_in_file(caller_file_idx, name_start, name_len, mod_file);
        if (hit >= 0) {
            if (found < 0) {
                found = hit;
            } else {
                sh_build_err_at(caller_file_idx, "ambiguous global name (use Module.symbol)", at);
                return -1;
            }
        }
    }

    if (found < 0) {
        sh_build_err_at(caller_file_idx, "unknown global", at);
        return -1;
    }
    return found;
}

function sh_llvm_resolve_unqualified_func(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = sh_llvm_find_func_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let found: i32 = -1;

    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        let hit: i32 = sh_llvm_find_func_in_file(caller_file_idx, name_start, name_len, mod_file);
        if (hit >= 0) {
            if (found < 0) {
                found = hit;
            } else {
                sh_build_err_at(caller_file_idx, "ambiguous function name (use Module.symbol)", at);
                return -1;
            }
        }
    }

    if (found < 0) {
        sh_build_err_at(caller_file_idx, "unknown function", at);
        return -1;
    }
    return found;
}

function sh_llvm_resolve_qualified_func(caller_file_idx: i32, mod_start: i32, mod_len: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let mod_file: i32 = sh_llvm_find_imported_module(caller_file_idx, mod_start, mod_len);
    if (mod_file < 0) {
        sh_build_err_at(caller_file_idx, "unknown module", at);
        return -1;
    }

    let fn: i32 = sh_llvm_find_func_in_file(caller_file_idx, name_start, name_len, mod_file);
    if (fn < 0) {
        sh_build_err_at(caller_file_idx, "unknown function", at);
        return -1;
    }
    return fn;
}

function sh_llvm_resolve_callee_func(caller_file_idx: i32, callee_expr: i32, at: i32): i32 {
    if (callee_expr < 0 || callee_expr >= sh.expr_count) {
        sh_build_err_at(caller_file_idx, "invalid call target", at);
        return -1;
    }

    let kind: ShExprKind = sh.expr_nodes[callee_expr].kind;
    if (kind == ShExprKind.Name) {
        return sh_llvm_resolve_unqualified_func(caller_file_idx, sh.expr_nodes[callee_expr].name_start, sh.expr_nodes[callee_expr].name_len, at);
    }

    if (kind == ShExprKind.Member) {
        let base: i32 = sh.expr_nodes[callee_expr].left;
        if (base < 0 || base >= sh.expr_count) {
            sh_build_err_at(caller_file_idx, "invalid member call target", at);
            return -1;
        }
        let base_kind: ShExprKind = sh.expr_nodes[base].kind;
        if (base_kind != ShExprKind.Name) {
            sh_build_err_at(caller_file_idx, "unsupported call target (member)", at);
            return -1;
        }
        return sh_llvm_resolve_qualified_func(
            caller_file_idx,
            sh.expr_nodes[base].name_start,
            sh.expr_nodes[base].name_len,
            sh.expr_nodes[callee_expr].name_start,
            sh.expr_nodes[callee_expr].name_len,
            at
        );
    }

    sh_build_err_at(caller_file_idx, "unsupported call target", at);
    return -1;
}

