import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_find_func_noargs_i32(file_idx: i32, name_start: i32, name_len: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.func_count; i = i + 1) {
        if (stasis.funcs[i].is_test == 0) {
            if (stasis.funcs[i].file_idx == file_idx) {
                if (stasis.funcs[i].params_len == 0) {
                    if (build_type_is_i32(stasis.funcs[i].ret_type_idx)) {
                        if (span_eq_span(file_idx, name_start, name_len, stasis.funcs[i].name_start, stasis.funcs[i].name_len)) {
                            return i;
                        }
                    }
                }
            }
        }
    }
    return -1;
}

function span_eq_span(file_idx: i32, a_start: i32, a_len: i32, b_start: i32, b_len: i32): bool {
    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return false;
    }
    if (a_len != b_len) {
        return false;
    }

    let base: i32 = stasis.files[file_idx].offset;
    let i: i32 = 0;
    for (i = 0; i < a_len; i = i + 1) {
        if (stasis.pool[base + a_start + i] != stasis.pool[base + b_start + i]) {
            return false;
        }
    }
    return true;
}

function span_eq_span_cross(a_file_idx: i32, a_start: i32, a_len: i32, b_file_idx: i32, b_start: i32, b_len: i32): bool {
    if (a_file_idx < 0 || a_file_idx >= stasis.file_count) { return false; }
    if (b_file_idx < 0 || b_file_idx >= stasis.file_count) { return false; }
    if (a_len != b_len) { return false; }

    let a_base: i32 = stasis.files[a_file_idx].offset + a_start;
    let b_base: i32 = stasis.files[b_file_idx].offset + b_start;
    let i: i32 = 0;
    for (i = 0; i < a_len; i = i + 1) {
        if (stasis.pool[a_base + i] != stasis.pool[b_base + i]) {
            return false;
        }
    }
    return true;
}

function span_eq_module_name(caller_file_idx: i32, mod_start: i32, mod_len: i32, module_file_idx: i32): bool {
    if (caller_file_idx < 0 || caller_file_idx >= stasis.file_count) { return false; }
    if (module_file_idx < 0 || module_file_idx >= stasis.file_count) { return false; }

    let want_len: i32 = stasis.files[module_file_idx].mod_len;
    if (mod_len != want_len) {
        return false;
    }

    let a_base: i32 = stasis.files[caller_file_idx].offset + mod_start;
    let b_base: i32 = stasis.files[module_file_idx].mod_off;
    let i: i32 = 0;
    for (i = 0; i < mod_len; i = i + 1) {
        if (stasis.pool[a_base + i] != stasis.mod_pool[b_base + i]) {
            return false;
        }
    }
    return true;
}

function llvm_find_imported_module(caller_file_idx: i32, mod_start: i32, mod_len: i32): i32 {
    // Allow `ThisModule.symbol` for clarity.
    if (span_eq_module_name(caller_file_idx, mod_start, mod_len, caller_file_idx)) {
        return caller_file_idx;
    }

    let imp_off: i32 = stasis.files[caller_file_idx].imports_off;
    let imp_len: i32 = stasis.files[caller_file_idx].imports_len;
    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = stasis.imports[imp_off + i];
        if (span_eq_module_name(caller_file_idx, mod_start, mod_len, mod_file)) {
            return mod_file;
        }
    }
    return -1;
}

function llvm_import_walk_init(caller_file_idx: i32, at: i32): i32 {
    stasis.resolve_sp = 0;
    stasis.resolve_epoch = stasis.resolve_epoch + 1;
    if (stasis.resolve_epoch <= 0) {
        // Epoch wrapped; clear the seen array (bounded by our fixed cap).
        stasis.resolve_epoch = 1;
        let clear_i: i32 = 0;
        for (clear_i = 0; clear_i < 4096; clear_i = clear_i + 1) {
            stasis.resolve_seen_epoch[clear_i] = 0;
        }
    }

    if (caller_file_idx >= 0 && caller_file_idx < 4096) {
        stasis.resolve_seen_epoch[caller_file_idx] = stasis.resolve_epoch;
    }

    if (caller_file_idx < 0 || caller_file_idx >= stasis.file_count) {
        build_err_at(caller_file_idx, "invalid file for import walk", at);
        return 1;
    }

    let imp_off: i32 = stasis.files[caller_file_idx].imports_off;
    let imp_len: i32 = stasis.files[caller_file_idx].imports_len;
    let imp_i: i32 = 0;
    for (imp_i = 0; imp_i < imp_len; imp_i = imp_i + 1) {
        let mod_file: i32 = stasis.imports[imp_off + imp_i];
        if (mod_file >= 0 && mod_file < stasis.file_count && mod_file < 4096) {
            if (stasis.resolve_seen_epoch[mod_file] != stasis.resolve_epoch) {
                stasis.resolve_seen_epoch[mod_file] = stasis.resolve_epoch;
                if (stasis.resolve_sp >= 4096) {
                    build_err_at(caller_file_idx, "import graph too deep (resolver)", at);
                    return 1;
                }
                stasis.resolve_stack[stasis.resolve_sp] = mod_file;
                stasis.resolve_sp = stasis.resolve_sp + 1;
            }
        }
    }
    return 0;
}

function llvm_import_walk_next(caller_file_idx: i32, at: i32): i32 {
    for (; stasis.resolve_sp > 0; ) {
        stasis.resolve_sp = stasis.resolve_sp - 1;
        let file_idx: i32 = stasis.resolve_stack[stasis.resolve_sp];
        if (file_idx < 0 || file_idx >= stasis.file_count) {
            // Skip invalids (shouldn't happen).
        } else {
            let imp_off: i32 = stasis.files[file_idx].imports_off;
            let imp_len: i32 = stasis.files[file_idx].imports_len;
            let i: i32 = 0;
            for (i = 0; i < imp_len; i = i + 1) {
                let mod_file: i32 = stasis.imports[imp_off + i];
                if (mod_file >= 0 && mod_file < stasis.file_count && mod_file < 4096) {
                    if (stasis.resolve_seen_epoch[mod_file] != stasis.resolve_epoch) {
                        stasis.resolve_seen_epoch[mod_file] = stasis.resolve_epoch;
                        if (stasis.resolve_sp >= 4096) {
                            build_err_at(caller_file_idx, "import graph too deep (resolver)", at);
                            return -2;
                        }
                        stasis.resolve_stack[stasis.resolve_sp] = mod_file;
                        stasis.resolve_sp = stasis.resolve_sp + 1;
                    }
                }
            }

            return file_idx;
        }
    }
    return -1;
}

function llvm_find_func_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.func_count; i = i + 1) {
        if (stasis.funcs[i].is_test == 0) {
            if (stasis.funcs[i].file_idx == target_file_idx) {
                if (span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, stasis.funcs[i].name_start, stasis.funcs[i].name_len)) {
                    return i;
                }
            }
        }
    }
    return -1;
}

function llvm_find_global_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.global_count; i = i + 1) {
        if (stasis.globals[i].file_idx == target_file_idx) {
            if (span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, stasis.globals[i].name_start, stasis.globals[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function llvm_find_const_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.const_count; i = i + 1) {
        if (stasis.consts[i].file_idx == target_file_idx) {
            if (span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, stasis.consts[i].name_start, stasis.consts[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function llvm_try_resolve_unqualified_const(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = llvm_find_const_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let found: i32 = -1;

    if (llvm_import_walk_init(caller_file_idx, at) != 0) {
        return -2;
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        let mod_file: i32 = llvm_import_walk_next(caller_file_idx, at);
        if (mod_file == -2) {
            return -2;
        }
        if (mod_file < 0) {
            done = 1;
        } else {
            let hit: i32 = llvm_find_const_in_file(caller_file_idx, name_start, name_len, mod_file);
            if (hit >= 0) {
                if (found < 0) {
                    found = hit;
                } else {
                    build_err_at(caller_file_idx, "ambiguous const name (use Module.symbol)", at);
                    return -2;
                }
            }
        }
    }
    return found;
}

function llvm_eval_const_i32(caller_file_idx: i32, const_idx: i32, at: i32): i32 {
    stasis.expr_eval_failed = 0;
    if (const_idx < 0 || const_idx >= stasis.const_count) {
        build_err_at(caller_file_idx, "invalid const reference", at);
        stasis.expr_eval_failed = 1;
        return 0;
    }

    let file_idx: i32 = stasis.consts[const_idx].file_idx;
    let start: i32 = stasis.consts[const_idx].init_start;
    if (file_idx < 0 || file_idx >= stasis.file_count || start < 0) {
        build_err_at(caller_file_idx, "const has no initializer", at);
        stasis.expr_eval_failed = 1;
        return 0;
    }

    let base: i32 = stasis.files[file_idx].offset + start;
    let sign: i32 = 1;
    if (stasis.pool[base] == 45) {
        sign = -1;
        base = base + 1;
    }

    let v: i32 = 0;
    let i: i32 = 0;
    let done: i32 = 0;
    for (; done == 0; ) {
        let b: u8 = stasis.pool[base + i];
        if (!ascii_is_digit(b)) {
            done = 1;
        } else {
            v = v * 10 + ascii_to_digit(b);
            i = i + 1;
        }
    }
    if (i == 0) {
        build_err_at(caller_file_idx, "unsupported const initializer (expected integer literal)", at);
        stasis.expr_eval_failed = 1;
        return 0;
    }
    return v * sign;
}

function llvm_emit_const_f32_from_const(caller_file_idx: i32, const_idx: i32, at: i32): i32 {
    if (const_idx < 0 || const_idx >= stasis.const_count) {
        build_err_at(caller_file_idx, "invalid const reference", at);
        return -1;
    }

    let file_idx: i32 = stasis.consts[const_idx].file_idx;
    let start: i32 = stasis.consts[const_idx].init_start;
    if (file_idx < 0 || file_idx >= stasis.file_count || start < 0) {
        build_err_at(caller_file_idx, "const has no initializer", at);
        return -1;
    }

    let base: i32 = stasis.files[file_idx].offset + start;
    let i: i32 = 0;
    let saw_digit: i32 = 0;
    let saw_dot: i32 = 0;

    if (stasis.pool[base] == 45) {
        i = 1;
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        let b: u8 = stasis.pool[base + i];
        if (ascii_is_digit(b)) {
            saw_digit = 1;
            i = i + 1;
        } else {
            if (b == 46 && saw_dot == 0) {
                saw_dot = 1;
                i = i + 1;
            } else {
                done = 1;
            }
        }
    }

    if (saw_digit == 0 || saw_dot == 0) {
        build_err_at(caller_file_idx, "unsupported const initializer (expected float literal)", at);
        return -1;
    }

    return llvm_emit_const_f32_from_span(file_idx, start, i);
}

function llvm_find_enum_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.enum_count; i = i + 1) {
        if (stasis.enums[i].file_idx == target_file_idx) {
            if (span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, stasis.enums[i].name_start, stasis.enums[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function llvm_try_resolve_unqualified_enum(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = llvm_find_enum_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let found: i32 = -1;

    if (llvm_import_walk_init(caller_file_idx, at) != 0) {
        return -2;
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        let mod_file: i32 = llvm_import_walk_next(caller_file_idx, at);
        if (mod_file == -2) {
            return -2;
        }
        if (mod_file < 0) {
            done = 1;
        } else {
            let hit: i32 = llvm_find_enum_in_file(caller_file_idx, name_start, name_len, mod_file);
            if (hit >= 0) {
                if (found < 0) {
                    found = hit;
                } else {
                    build_err_at(caller_file_idx, "ambiguous enum name (use Module.symbol)", at);
                    return -2;
                }
            }
        }
    }
    return found;
}

function llvm_find_enum_member(named_file_idx: i32, name_start: i32, name_len: i32, enum_idx: i32): i32 {
    if (enum_idx < 0 || enum_idx >= stasis.enum_count) {
        return -1;
    }
    let off: i32 = stasis.enums[enum_idx].members_off;
    let len: i32 = stasis.enums[enum_idx].members_len;

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        let mi: i32 = off + i;
        if (mi >= 0 && mi < stasis.enum_member_count) {
            if (span_eq_span_cross(named_file_idx, name_start, name_len, stasis.enum_members[mi].file_idx, stasis.enum_members[mi].name_start, stasis.enum_members[mi].name_len)) {
                return mi;
            }
        }
    }
    return -1;
}

function llvm_resolve_unqualified_global(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = llvm_find_global_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let found: i32 = -1;

    if (llvm_import_walk_init(caller_file_idx, at) != 0) {
        return -1;
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        let mod_file: i32 = llvm_import_walk_next(caller_file_idx, at);
        if (mod_file == -2) {
            return -1;
        }
        if (mod_file < 0) {
            done = 1;
        } else {
            let hit: i32 = llvm_find_global_in_file(caller_file_idx, name_start, name_len, mod_file);
            if (hit >= 0) {
                if (found < 0) {
                    found = hit;
                } else {
                    build_err_at(caller_file_idx, "ambiguous global name (use Module.symbol)", at);
                    return -1;
                }
            }
        }
    }

    if (found < 0) {
        build_err_at(caller_file_idx, "unknown global", at);
        return -1;
    }
    return found;
}

function llvm_resolve_unqualified_func(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = llvm_find_func_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let found: i32 = -1;

    if (llvm_import_walk_init(caller_file_idx, at) != 0) {
        return -1;
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        let mod_file: i32 = llvm_import_walk_next(caller_file_idx, at);
        if (mod_file == -2) {
            return -1;
        }
        if (mod_file < 0) {
            done = 1;
        } else {
            let hit: i32 = llvm_find_func_in_file(caller_file_idx, name_start, name_len, mod_file);
            if (hit >= 0) {
                if (found < 0) {
                    found = hit;
                } else {
                    build_err_at(caller_file_idx, "ambiguous function name (use Module.symbol)", at);
                    return -1;
                }
            }
        }
    }

    if (found < 0) {
        // Bring-up: if nothing is found through direct/transitive imports, fall back to
        // searching the whole loaded graph (matches earlier stage0 behavior more closely).
        let global_found: i32 = -1;
        let gi: i32 = 0;
        for (gi = 0; gi < stasis.func_count; gi = gi + 1) {
            if (stasis.funcs[gi].is_test == 0) {
                let target_file_idx: i32 = stasis.funcs[gi].file_idx;
                if (target_file_idx >= 0 && target_file_idx < stasis.file_count) {
                    if (span_eq_span_cross(caller_file_idx, name_start, name_len, target_file_idx, stasis.funcs[gi].name_start, stasis.funcs[gi].name_len)) {
                        if (global_found < 0) {
                            global_found = gi;
                        } else {
                            build_err_at(caller_file_idx, "ambiguous function name (use Module.symbol)", at);
                            return -1;
                        }
                    }
                }
            }
        }
        if (global_found >= 0) {
            return global_found;
        }

        build_err_at(caller_file_idx, "unknown function", at);
        return -1;
    }
    return found;
}

function llvm_resolve_qualified_func(caller_file_idx: i32, mod_start: i32, mod_len: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let mod_file: i32 = llvm_find_imported_module(caller_file_idx, mod_start, mod_len);
    if (mod_file < 0) {
        build_err_at(caller_file_idx, "unknown module", at);
        return -1;
    }

    let fn: i32 = llvm_find_func_in_file(caller_file_idx, name_start, name_len, mod_file);
    if (fn < 0) {
        build_err_at(caller_file_idx, "unknown function", at);
        return -1;
    }
    return fn;
}

function llvm_resolve_callee_func(caller_file_idx: i32, callee_expr: i32, at: i32): i32 {
    if (callee_expr < 0 || callee_expr >= stasis.expr_count) {
        build_err_at(caller_file_idx, "invalid call target", at);
        return -1;
    }

    let kind: ExprKind = stasis.expr_nodes[callee_expr].kind;
    if (kind == ExprKind.Name) {
        return llvm_resolve_unqualified_func(caller_file_idx, stasis.expr_nodes[callee_expr].name_start, stasis.expr_nodes[callee_expr].name_len, at);
    }

    if (kind == ExprKind.Member) {
        let base: i32 = stasis.expr_nodes[callee_expr].left;
        if (base < 0 || base >= stasis.expr_count) {
            build_err_at(caller_file_idx, "invalid member call target", at);
            return -1;
        }
        let base_kind: ExprKind = stasis.expr_nodes[base].kind;
        if (base_kind != ExprKind.Name) {
            build_err_at(caller_file_idx, "unsupported call target (member)", at);
            return -1;
        }
        return llvm_resolve_qualified_func(
            caller_file_idx,
            stasis.expr_nodes[base].name_start,
            stasis.expr_nodes[base].name_len,
            stasis.expr_nodes[callee_expr].name_start,
            stasis.expr_nodes[callee_expr].name_len,
            at
        );
    }

    build_err_at(caller_file_idx, "unsupported call target", at);
    return -1;
}
