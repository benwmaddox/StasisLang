import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";

function sh_print_file_loc(file_idx: i32, at: i32): void {
    if (!sh_copy_file_path(sh.sig_path, file_idx)) {
        ascii_copy(sh.sig_path, "<unknown>");
    }

    let base: i32 = 0;
    let len: i32 = 0;
    if (file_idx >= 0 && file_idx < sh.file_count) {
        base = sh.files[file_idx].offset;
        len = sh.files[file_idx].len;
    }

    let limit: i32 = at;
    if (limit < 0) {
        limit = 0;
    }
    if (limit > len) {
        limit = len;
    }

    let line: i32 = 1;
    let col: i32 = 1;

    let i: i32 = 0;
    for (i = 0; i < limit; i = i + 1) {
        let b: u8 = sh.pool[base + i];
        if (b == 10) {
            line = line + 1;
            col = 1;
        } else {
            if (b != 13) {
                col = col + 1;
            }
        }
    }

    print_string(sh.sig_path);
    print_char(58); // ':'
    print_int(line);
    print_char(58); // ':'
    print_int(col);
}

