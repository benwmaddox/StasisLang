import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "expr_eval.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";

function emit_llvm_func_i32ish(func_idx: i32): i32 {
    let file_idx: i32 = stasis.funcs[func_idx].file_idx;
    let body_start: i32 = stasis.funcs[func_idx].body_start;
    if (body_start < 0) {
        // Extern (no-body) functions are only declared, not defined.
        return 0;
    }

    let ret_ty: i32 = stasis.funcs[func_idx].ret_type_idx;
    let implicit_test_ret: i32 = 0;
    if (stasis.funcs[func_idx].is_test != 0 && ret_ty < 0) {
        // Bring-up: tests default to i32 and "pass" when falling off the end.
        implicit_test_ret = 1;
    }
    let is_void: i32 = 0;
    let is_f32_ret: i32 = 0;
    if (ret_ty < 0) {
        if (implicit_test_ret == 0) {
            is_void = 1;
        }
    } else {
    if (build_type_is_void(ret_ty)) {
        is_void = 1;
    } else {
        if (build_type_is_f32(ret_ty)) {
            is_f32_ret = 1;
        } else {
            if (!build_type_is_i32ish(ret_ty) && !build_type_is_byte_named(ret_ty)) {
                build_err_at(file_idx, "unsupported function return type (llvm bring-up)", stasis.funcs[func_idx].name_start);
                return 1;
            }
        }
    }
    }

    if (!lex_begin(file_idx)) {
        build_err_at(file_idx, "failed to start lexer", 0);
        return 1;
    }
    stasis.lex_pos = body_start;

    llvm_reset();

    // Parameters are modeled as locals for name resolution simplicity.
    let params_off: i32 = stasis.funcs[func_idx].params_off;
    let params_len: i32 = stasis.funcs[func_idx].params_len;
    let p: i32 = 0;
    for (p = 0; p < params_len; p = p + 1) {
        let p_decl: i32 = params_off + p;
        if (p_decl < 0 || p_decl >= stasis.param_count) {
            build_err_at(file_idx, "invalid function parameters", stasis.funcs[func_idx].name_start);
            return 1;
        }
        let p_ty: i32 = stasis.params[p_decl].type_idx;
        if (p_ty < 0 || p_ty >= stasis.type_count) {
            build_err_at(file_idx, "invalid parameter type (llvm bring-up)", stasis.params[p_decl].name_start);
            return 1;
        }

        // Bring-up: scalar params are i32; array/slice params are ptr.
        let param_kind: LlvmValueKind = LlvmValueKind.I32;
        if (build_type_is_f32(p_ty)) {
            param_kind = LlvmValueKind.F32;
        } else {
        if (build_type_is_string_named(p_ty)) {
            param_kind = LlvmValueKind.PtrI8;
        } else {
        if (!build_type_is_i32ish(p_ty) && !build_type_is_byte_named(p_ty)) {
            let p_tkind: TypeKind = stasis.types[p_ty].kind;
            if (p_tkind != TypeKind.Array) {
                build_err_at(file_idx, "unsupported parameter type (llvm bring-up)", stasis.params[p_decl].name_start);
                return 1;
            }

            let elem: i32 = stasis.types[p_ty].elem;
            if (build_type_is_byte_named(elem)) {
                param_kind = LlvmValueKind.PtrI8;
            } else {
                if (build_type_is_i32ish(elem)) {
                    param_kind = LlvmValueKind.PtrI32;
                } else {
                    if (build_type_is_f32(elem)) {
                        param_kind = LlvmValueKind.PtrF32;
                    } else {
                        build_err_at(file_idx, "unsupported parameter element type (llvm bring-up)", stasis.params[p_decl].name_start);
                        return 1;
                    }
                }
            }
        }
        }
        }

        if (llvm_find_local_any(file_idx, stasis.params[p_decl].name_start, stasis.params[p_decl].name_len) >= 0) {
            build_err_at(file_idx, "duplicate parameter name", stasis.params[p_decl].name_start);
            return 1;
        }
        let local_id: i32 = llvm_add_local(file_idx, stasis.params[p_decl].name_start, stasis.params[p_decl].name_len);
        if (local_id < 0) {
            return 1;
        }
        stasis.llvm_local_kind[local_id] = param_kind;
        stasis.llvm_local_declared[local_id] = 1;
        stasis.llvm_local_declared_at[local_id] = stasis.params[p_decl].name_start;
    }

    // Pre-scan locals so we can emit all allocas in entry (LLVM friendliness).
    if (llvm_scan_locals_in_body(file_idx, body_start) != 0) {
        return 1;
    }

    // Reset lexer to body start for the real codegen pass.
    stasis.lex_pos = body_start;
    stasis.sig_kind = Tok.Unknown; // reuse as a 1-token pushback for statement parsing

    ascii_append(stasis.ir_out, "define ");
    if (is_void != 0) {
        ascii_append(stasis.ir_out, "void @");
    } else {
        if (is_f32_ret != 0) {
            ascii_append(stasis.ir_out, "float @");
        } else {
            ascii_append(stasis.ir_out, "i32 @");
        }
    }
    llvm_append_func_ir_name(func_idx);
    ascii_append(stasis.ir_out, "(");
    for (p = 0; p < params_len; p = p + 1) {
        if (p != 0) {
            ascii_append(stasis.ir_out, ", ");
        }
        let p_kind_sig: LlvmValueKind = stasis.llvm_local_kind[p];
        if (p_kind_sig == LlvmValueKind.I32) {
            ascii_append(stasis.ir_out, "i32 %a");
        } else {
            if (p_kind_sig == LlvmValueKind.F32) {
                ascii_append(stasis.ir_out, "float %a");
        } else {
            if (p_kind_sig == LlvmValueKind.PtrI8 || p_kind_sig == LlvmValueKind.PtrI32 || p_kind_sig == LlvmValueKind.PtrF32 || p_kind_sig == LlvmValueKind.PtrStruct) {
                ascii_append(stasis.ir_out, "ptr %a");
            } else {
                build_err_at(file_idx, "unsupported parameter kind (llvm bring-up)", stasis.funcs[func_idx].name_start);
                return 1;
            }
        }
        }
        ir_append_i32(stasis.ir_out, p);
    }
    ascii_append(stasis.ir_out, ") {\n");
    ascii_append(stasis.ir_out, "entry:\n");

    let exit_label: i32 = llvm_new_label();

    // Return slot (allows return to appear anywhere).
    if (is_void != 0) {
        ascii_append(stasis.ir_out, "  %ret_slot = alloca i32, align 4\n");
        ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
    } else {
        if (is_f32_ret != 0) {
            ascii_append(stasis.ir_out, "  %ret_slot = alloca float, align 4\n");
            ascii_append(stasis.ir_out, "  store float 0.0, ptr %ret_slot, align 4\n");
        } else {
            ascii_append(stasis.ir_out, "  %ret_slot = alloca i32, align 4\n");
            if (implicit_test_ret != 0) {
                ascii_append(stasis.ir_out, "  store i32 1, ptr %ret_slot, align 4\n");
            } else {
                ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
            }
        }
    }

    // Locals are modeled as wasm-like locals: 0-initialized and available for the whole function.
    let i: i32 = 0;
    for (i = 0; i < stasis.llvm_local_count; i = i + 1) {
        let lkind: LlvmValueKind = stasis.llvm_local_kind[i];
        if (lkind == LlvmValueKind.I32) {
            ascii_append(stasis.ir_out, "  ");
            llvm_append_local_ptr(i);
            ascii_append(stasis.ir_out, " = alloca i32, align 4\n");
            ascii_append(stasis.ir_out, "  store i32 0, ptr ");
            llvm_append_local_ptr(i);
            ascii_append(stasis.ir_out, ", align 4\n");
        } else {
            if (lkind == LlvmValueKind.F32) {
                ascii_append(stasis.ir_out, "  ");
                llvm_append_local_ptr(i);
                ascii_append(stasis.ir_out, " = alloca float, align 4\n");
                ascii_append(stasis.ir_out, "  store float 0.0, ptr ");
                llvm_append_local_ptr(i);
                ascii_append(stasis.ir_out, ", align 4\n");
            } else {
                if (lkind == LlvmValueKind.PtrI8 || lkind == LlvmValueKind.PtrI32 || lkind == LlvmValueKind.PtrF32 || lkind == LlvmValueKind.PtrStruct) {
                    ascii_append(stasis.ir_out, "  ");
                    llvm_append_local_ptr(i);
                    ascii_append(stasis.ir_out, " = alloca ptr, align 8\n");
                    ascii_append(stasis.ir_out, "  store ptr null, ptr ");
                    llvm_append_local_ptr(i);
                    ascii_append(stasis.ir_out, ", align 8\n");
                } else {
                    build_err_at(file_idx, "unsupported local kind (llvm bring-up)", body_start);
                    return 1;
                }
            }
        }
    }

    // Initialize parameter locals from SSA arguments.
    for (p = 0; p < params_len; p = p + 1) {
        let p_kind_init: LlvmValueKind = stasis.llvm_local_kind[p];
        if (p_kind_init == LlvmValueKind.I32) {
            ascii_append(stasis.ir_out, "  store i32 %a");
            ir_append_i32(stasis.ir_out, p);
            ascii_append(stasis.ir_out, ", ptr ");
            llvm_append_local_ptr(p);
            ascii_append(stasis.ir_out, ", align 4\n");
        } else {
            if (p_kind_init == LlvmValueKind.F32) {
                ascii_append(stasis.ir_out, "  store float %a");
                ir_append_i32(stasis.ir_out, p);
                ascii_append(stasis.ir_out, ", ptr ");
                llvm_append_local_ptr(p);
                ascii_append(stasis.ir_out, ", align 4\n");
            } else {
            if (p_kind_init == LlvmValueKind.PtrI8 || p_kind_init == LlvmValueKind.PtrI32 || p_kind_init == LlvmValueKind.PtrF32 || p_kind_init == LlvmValueKind.PtrStruct) {
                ascii_append(stasis.ir_out, "  store ptr %a");
                ir_append_i32(stasis.ir_out, p);
                ascii_append(stasis.ir_out, ", ptr ");
                llvm_append_local_ptr(p);
                ascii_append(stasis.ir_out, ", align 8\n");
            } else {
                build_err_at(file_idx, "unsupported parameter kind (llvm bring-up)", stasis.funcs[func_idx].name_start);
                return 1;
            }
            }
        }
    }

    let k: Tok = lex_next_kind();
    if (k != Tok.LBrace) {
        build_err_at(file_idx, "expected '{' at start of function body", stasis.tok_start);
        return 1;
    }

    // Push a synthetic function block; it ends at the final '}'.
    stasis.llvm_block_kind[0] = LlvmBlockKind.Function;
    stasis.llvm_block_end_label[0] = exit_label;
    stasis.llvm_block_len = 1;

    if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
        return 1;
    }
    for (p = 0; p < params_len; p = p + 1) {
        let p_decl2: i32 = params_off + p;
        if (llvm_scope_declare_local(file_idx, stasis.params[p_decl2].name_start, p) != 0) {
            return 1;
        }
    }

    let did_return: i32 = 0;
    let done: i32 = 0;
    for (; done == 0; ) {
        if (stasis.sig_kind != Tok.Unknown) {
            k = stasis.sig_kind;
            stasis.sig_kind = Tok.Unknown;
        } else {
            k = lex_next_kind();
        }

        if (k == Tok.Eof) {
            build_err_at(file_idx, "unexpected eof in function body", stasis.tok_start);
            return 1;
        }

        if (k == Tok.RBrace) {
            if (stasis.llvm_block_len <= 0) {
                build_err_at(file_idx, "unmatched '}' in function body", stasis.tok_start);
                return 1;
            }

            if (llvm_scope_pop(file_idx, stasis.tok_start) != 0) {
                return 1;
            }

            let top: i32 = stasis.llvm_block_len - 1;
            let kind: LlvmBlockKind = stasis.llvm_block_kind[top];
            if (kind == LlvmBlockKind.Plain) {
                stasis.llvm_block_len = top;
            } else {
                if (kind == LlvmBlockKind.IfThen) {
                    let end_id: i32 = stasis.llvm_block_end_label[top];
                    let else_id: i32 = stasis.llvm_block_else_label[top];
                    stasis.llvm_block_len = top;

                    if (stasis.llvm_bb_terminated == 0) {
                        llvm_emit_br("if.end", end_id);
                    }

                    llvm_emit_label_def("if.else", else_id);

                    let next: Tok = lex_next_kind();
                    if (next == Tok.ElseKeyword) {
                        let brace2: Tok = lex_next_kind();
                        if (brace2 != Tok.LBrace) {
                            build_err_at(file_idx, "expected '{' after 'else'", stasis.tok_start);
                            return 1;
                        }
                        if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
                            return 1;
                        }

                        if (stasis.llvm_block_len >= 256) {
                            build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                            return 1;
                        }
                        stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.IfElse;
                        stasis.llvm_block_end_label[stasis.llvm_block_len] = end_id;
                        stasis.llvm_block_len = stasis.llvm_block_len + 1;
                    } else {
                        // No else: emit an empty else block.
                        llvm_emit_br("if.end", end_id);
                        llvm_emit_label_def("if.end", end_id);
                        stasis.sig_kind = next;
                    }
                } else {
                    if (kind == LlvmBlockKind.IfElse) {
                        let end_id2: i32 = stasis.llvm_block_end_label[top];
                        stasis.llvm_block_len = top;

                        if (stasis.llvm_bb_terminated == 0) {
                            llvm_emit_br("if.end", end_id2);
                        }
                        llvm_emit_label_def("if.end", end_id2);
                    } else {
                        if (kind == LlvmBlockKind.ForBody) {
                            let end_id3: i32 = stasis.llvm_block_end_label[top];
                            let cond_id: i32 = stasis.llvm_block_cond_label[top];
                            let step_id: i32 = stasis.llvm_block_step_label[top];
                            let has_step: i32 = stasis.llvm_block_has_step[top];
                            let step_start: i32 = stasis.llvm_block_step_start[top];
                            let step_file_idx: i32 = stasis.llvm_block_step_file_idx[top];
                            stasis.llvm_block_len = top;

                            if (stasis.llvm_bb_terminated == 0) {
                                if (has_step != 0) {
                                    llvm_emit_br("for.step", step_id);
                                } else {
                                    llvm_emit_br("for.cond", cond_id);
                                }
                            }

                            if (has_step != 0) {
                                llvm_emit_label_def("for.step", step_id);

                                // Re-parse and emit the step expression from the header span.
                                let resume_pos: i32 = stasis.lex_pos;
                                stasis.lex_pos = step_start;
                                let root_step: i32 = expr_parse_until(step_file_idx, Tok.RParen);
                                if (root_step < 0) { return 1; }
                                let tmp_step: i32 = llvm_emit_expr_i32(step_file_idx, root_step);
                                if (tmp_step < 0) { return 1; }
                                stasis.lex_pos = resume_pos;

                                if (stasis.llvm_bb_terminated == 0) {
                                    llvm_emit_br("for.cond", cond_id);
                                }
                            }

                            llvm_emit_label_def("for.end", end_id3);
                        } else {
                            if (kind == LlvmBlockKind.ForeachBody) {
                                let end_id4: i32 = stasis.llvm_block_end_label[top];
                                let cond_id2: i32 = stasis.llvm_block_cond_label[top];
                                let step_id2: i32 = stasis.llvm_block_step_label[top];
                                let foreach_i_phi: i32 = stasis.llvm_block_foreach_idx_phi_tmp[top];
                                let foreach_i_next_phi: i32 = stasis.llvm_block_foreach_idx_next_tmp[top];
                                stasis.llvm_block_len = top;

                                if (stasis.llvm_bb_terminated == 0) {
                                    llvm_emit_br("foreach.step", step_id2);
                                }

                                llvm_emit_label_def("foreach.step", step_id2);
                                ascii_append(stasis.ir_out, "  ");
                                llvm_append_tmp(foreach_i_next_phi);
                                ascii_append(stasis.ir_out, " = add i32 ");
                                llvm_append_tmp(foreach_i_phi);
                                ascii_append(stasis.ir_out, ", 1");
                                ascii_append(stasis.ir_out, "\n");

                                if (stasis.llvm_bb_terminated == 0) {
                                    llvm_emit_br("foreach.cond", cond_id2);
                                }

                                llvm_emit_label_def("foreach.end", end_id4);
                            } else {
                            if (kind == LlvmBlockKind.Function) {
                                stasis.llvm_block_len = top;

                                if (stasis.llvm_bb_terminated == 0) {
                                    llvm_emit_br("exit", exit_label);
                                }
                                done = 1;
                            } else {
                                build_err_at(file_idx, "internal error: unknown block kind", stasis.tok_start);
                                return 1;
                            }
                            }
                        }
                    }
                }
            }
        } else {
            if (k == Tok.LBrace) {
                if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
                    return 1;
                }
                if (stasis.llvm_block_len >= 256) {
                    build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                    return 1;
                }
                stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.Plain;
                stasis.llvm_block_len = stasis.llvm_block_len + 1;
            } else {
                if (k == Tok.LetKeyword) {
                    // let name (: type)? (= expr)? ;
                    let name_k: Tok = lex_next_kind();
                    if (name_k != Tok.Identifier) {
                        build_err_at(file_idx, "expected variable name", stasis.tok_start);
                        return 1;
                    }
                    let decl_at: i32 = stasis.tok_start;
                    let local_id2: i32 = llvm_find_local_by_decl_at(file_idx, stasis.tok_start, stasis.tok_len, decl_at);
                    if (local_id2 < 0) {
                        build_err_at(file_idx, "unknown local", stasis.tok_start);
                        return 1;
                    }

                    let next_k: Tok = lex_next_kind();
                    if (next_k == Tok.Colon) {
                        let ty_k: Tok = lex_next_kind();
                        if (ty_k != Tok.Identifier) {
                            build_err_at(file_idx, "expected type name", stasis.tok_start);
                            return 1;
                        }
                        if (span_eq(file_idx, stasis.tok_start, stasis.tok_len, "f32")) {
                            stasis.llvm_local_kind[local_id2] = LlvmValueKind.F32;
                        } else {
                        if (!span_eq(file_idx, stasis.tok_start, stasis.tok_len, "i32") && !span_eq(file_idx, stasis.tok_start, stasis.tok_len, "bool") && !span_eq(file_idx, stasis.tok_start, stasis.tok_len, "u8")) {
                            let enum_hit: i32 = llvm_try_resolve_unqualified_enum(file_idx, stasis.tok_start, stasis.tok_len, stasis.tok_start);
                            if (enum_hit < 0) {
                                if (enum_hit == -2) {
                                    return 1;
                                }
                                build_err_at(file_idx, "unsupported local type (llvm bring-up)", stasis.tok_start);
                                return 1;
                            }
                        }
                        }
                        next_k = lex_next_kind();
                    }

                    if (next_k == Tok.Equal) {
                        llvm_ensure_bb_open();
                        let root: i32 = expr_parse_until(file_idx, Tok.Semicolon);
                        if (root < 0) { return 1; }
                        if (stasis.llvm_local_kind[local_id2] == LlvmValueKind.F32) {
                            let rhs_f32_id2: i32 = llvm_emit_expr_f32(file_idx, root);
                            if (rhs_f32_id2 < 0) { return 1; }
                            ascii_append(stasis.ir_out, "  store float ");
                            llvm_append_tmp(rhs_f32_id2);
                            ascii_append(stasis.ir_out, ", ptr ");
                            llvm_append_local_ptr(local_id2);
                            ascii_append(stasis.ir_out, ", align 4\n");
                        } else {
                            let folded: i32 = expr_try_eval_i32_const(root);
                            if (stasis.expr_eval_failed == 0) {
                                ascii_append(stasis.ir_out, "  store i32 ");
                                ir_append_i32(stasis.ir_out, folded);
                                ascii_append(stasis.ir_out, ", ptr ");
                                llvm_append_local_ptr(local_id2);
                                ascii_append(stasis.ir_out, ", align 4\n");
                            } else {
                                let rhs_id: i32 = llvm_emit_expr_i32(file_idx, root);
                                if (rhs_id < 0) { return 1; }
                                llvm_emit_store_local(local_id2, rhs_id);
                            }
                        }
                        stasis.llvm_local_declared[local_id2] = 1;
                        if (llvm_scope_declare_local(file_idx, decl_at, local_id2) != 0) {
                            return 1;
                        }
                    } else {
                        if (next_k != Tok.Semicolon) {
                            build_err_at(file_idx, "expected '=' or ';' after let", stasis.tok_start);
                            return 1;
                        }
                        // No initializer: locals are already 0-initialized in entry.
                        stasis.llvm_local_declared[local_id2] = 1;
                        if (llvm_scope_declare_local(file_idx, decl_at, local_id2) != 0) {
                            return 1;
                        }
                    }
                } else {
                    if (k == Tok.ReturnKeyword) {
                        did_return = 1;
                        llvm_ensure_bb_open();

                        let next2: Tok = lex_next_kind();
                        if (is_void != 0) {
                            if (next2 != Tok.Semicolon) {
                                build_err_at(file_idx, "void function cannot return a value (llvm bring-up)", stasis.tok_start);
                                return 1;
                            }
                            llvm_emit_br("exit", exit_label);
                        } else {
                            if (next2 == Tok.Semicolon) {
                                if (is_f32_ret != 0) {
                                    ascii_append(stasis.ir_out, "  store float 0.0, ptr %ret_slot, align 4\n");
                                    llvm_emit_br("exit", exit_label);
                                } else {
                                    if (implicit_test_ret != 0) {
                                        ascii_append(stasis.ir_out, "  store i32 1, ptr %ret_slot, align 4\n");
                                    } else {
                                        ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
                                    }
                                    llvm_emit_br("exit", exit_label);
                                }
                            } else {
                                let root2: i32 = expr_parse_after_first(file_idx, next2, Tok.Semicolon);
                                if (root2 < 0) { return 1; }
                                if (is_f32_ret != 0) {
                                    let ret_f32_id: i32 = llvm_emit_expr_f32(file_idx, root2);
                                    if (ret_f32_id < 0) { return 1; }
                                    ascii_append(stasis.ir_out, "  store float ");
                                    llvm_append_tmp(ret_f32_id);
                                    ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
                                } else {
                                    let folded2: i32 = expr_try_eval_i32_const(root2);
                                    if (stasis.expr_eval_failed == 0) {
                                        ascii_append(stasis.ir_out, "  store i32 ");
                                        ir_append_i32(stasis.ir_out, folded2);
                                        ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
                                    } else {
                                        let ret_id: i32 = llvm_emit_expr_i32(file_idx, root2);
                                        if (ret_id < 0) { return 1; }
                                        ascii_append(stasis.ir_out, "  store i32 ");
                                        llvm_append_tmp(ret_id);
                                        ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
                                    }
                                }
                                llvm_emit_br("exit", exit_label);
                            }
                        }
                    } else {
                        if (k == Tok.IfKeyword) {
                            llvm_ensure_bb_open();

                            let lp: Tok = lex_next_kind();
                            if (lp != Tok.LParen) {
                                build_err_at(file_idx, "expected '(' after 'if'", stasis.tok_start);
                                return 1;
                            }

                            let cond_root: i32 = expr_parse_until(file_idx, Tok.RParen);
                            if (cond_root < 0) { return 1; }
                            let cond_i1: i32 = llvm_emit_expr_i1(file_idx, cond_root);
                            if (cond_i1 < 0) { return 1; }

                            let then_id: i32 = llvm_new_label();
                            let else_id2: i32 = llvm_new_label();
                            let if_end_id: i32 = llvm_new_label();

                            llvm_emit_br_i1(cond_i1, "if.then", then_id, "if.else", else_id2);
                            llvm_emit_label_def("if.then", then_id);

                            let brace: Tok = lex_next_kind();
                            if (brace != Tok.LBrace) {
                                build_err_at(file_idx, "expected '{' after if condition", stasis.tok_start);
                                return 1;
                            }
                            if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
                                return 1;
                            }

                            if (stasis.llvm_block_len >= 256) {
                                build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                                return 1;
                            }
                            stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.IfThen;
                            stasis.llvm_block_end_label[stasis.llvm_block_len] = if_end_id;
                            stasis.llvm_block_else_label[stasis.llvm_block_len] = else_id2;
                            stasis.llvm_block_len = stasis.llvm_block_len + 1;
                        } else {
                            if (k == Tok.ForeachKeyword) {
                                llvm_ensure_bb_open();

                                let lp_fe: Tok = lex_next_kind();
                                if (lp_fe != Tok.LParen) {
                                    build_err_at(file_idx, "expected '(' after 'foreach'", stasis.tok_start);
                                    return 1;
                                }

                                let has_let: i32 = 0;
                                let it_k: Tok = lex_next_kind();
                                if (it_k == Tok.LetKeyword) {
                                    has_let = 1;
                                    it_k = lex_next_kind();
                                }

                                if (it_k != Tok.Identifier) {
                                    build_err_at(file_idx, "expected iterator name", stasis.tok_start);
                                    return 1;
                                }

                                let it_start: i32 = stasis.tok_start;
                                let it_len: i32 = stasis.tok_len;
                                let it_local: i32 = -1;
                                if (has_let != 0) {
                                    it_local = llvm_find_local_by_decl_at(file_idx, it_start, it_len, it_start);
                                } else {
                                    it_local = llvm_find_local(file_idx, it_start, it_len);
                                }
                                if (it_local < 0) {
                                    build_err_at(file_idx, "unknown local", it_start);
                                    return 1;
                                }

                                let idx_local: i32 = -1;
                                let idx_start: i32 = -1;
                                let next_fe: Tok = lex_next_kind();
                                if (next_fe == Tok.Comma) {
                                    let idx_k: Tok = lex_next_kind();
                                    if (idx_k != Tok.Identifier) {
                                        build_err_at(file_idx, "expected index variable name", stasis.tok_start);
                                        return 1;
                                    }
                                    idx_start = stasis.tok_start;
                                    if (has_let != 0) {
                                        idx_local = llvm_find_local_by_decl_at(file_idx, stasis.tok_start, stasis.tok_len, idx_start);
                                    } else {
                                        idx_local = llvm_find_local(file_idx, stasis.tok_start, stasis.tok_len);
                                    }
                                    if (idx_local < 0) {
                                        build_err_at(file_idx, "unknown local", stasis.tok_start);
                                        return 1;
                                    }
                                    next_fe = lex_next_kind();
                                }

                                if (next_fe != Tok.InKeyword) {
                                    build_err_at(file_idx, "expected 'in' in foreach", stasis.tok_start);
                                    return 1;
                                }

                                let collection_root: i32 = expr_parse_until(file_idx, Tok.RParen);
                                if (collection_root < 0) { return 1; }

                                let foreach_len: i32 = llvm_try_resolve_fixed_array_len_from_expr(file_idx, collection_root);
                                if (foreach_len <= 0) {
                                    build_err_at(file_idx, "foreach requires a fixed array with known length (llvm bring-up)", stasis.expr_nodes[collection_root].at);
                                    return 1;
                                }

                                let base_ptr: i32 = llvm_emit_expr_value(file_idx, collection_root);
                                if (base_ptr < 0) { return 1; }
                                let base_kind: LlvmValueKind = stasis.llvm_val_kind[0];
                                let base_si: i32 = stasis.llvm_val_struct_idx[0];

                                if (base_kind != LlvmValueKind.PtrStruct || base_si < 0) {
                                    build_err_at(file_idx, "foreach requires an array of structs (llvm bring-up)", stasis.expr_nodes[collection_root].at);
                                    return 1;
                                }

                                if (stasis.llvm_local_kind[it_local] != LlvmValueKind.PtrStruct) {
                                    build_err_at(file_idx, "foreach iterator must be a struct pointer local (llvm bring-up)", it_start);
                                    return 1;
                                }
                                stasis.llvm_local_struct_idx[it_local] = base_si;

                                if (idx_local >= 0) {
                                    if (stasis.llvm_local_kind[idx_local] != LlvmValueKind.I32) {
                                        build_err_at(file_idx, "foreach index must be an i32 local (llvm bring-up)", stasis.tok_start);
                                        return 1;
                                    }
                                }

                                if (has_let == 0) {
                                    if (stasis.llvm_local_declared[it_local] == 0) {
                                        build_err_at(file_idx, "foreach iterator used before declaration", it_start);
                                        return 1;
                                    }
                                    if (idx_local >= 0 && stasis.llvm_local_declared[idx_local] == 0) {
                                        build_err_at(file_idx, "foreach index used before declaration", it_start);
                                        return 1;
                                    }
                                }

                                let fe_pre_id: i32 = llvm_new_label();
                                let fe_cond_id: i32 = llvm_new_label();
                                let fe_body_id: i32 = llvm_new_label();
                                let fe_step_id: i32 = llvm_new_label();
                                let fe_end_id: i32 = llvm_new_label();

                                llvm_emit_br("foreach.pre", fe_pre_id);
                                llvm_emit_label_def("foreach.pre", fe_pre_id);
                                llvm_emit_br("foreach.cond", fe_cond_id);
                                llvm_emit_label_def("foreach.cond", fe_cond_id);

                                // i = phi [0, foreach.pre], [i_next, foreach.step]
                                let foreach_i: i32 = llvm_new_tmp();
                                let foreach_i_next: i32 = llvm_new_tmp();
                                ascii_append(stasis.ir_out, "  ");
                                llvm_append_tmp(foreach_i);
                                ascii_append(stasis.ir_out, " = phi i32 [0, %");
                                llvm_append_label("foreach.pre", fe_pre_id);
                                ascii_append(stasis.ir_out, "], [");
                                llvm_append_tmp(foreach_i_next);
                                ascii_append(stasis.ir_out, ", %");
                                llvm_append_label("foreach.step", fe_step_id);
                                ascii_append(stasis.ir_out, "]\n");

                                let foreach_cond_i1: i32 = llvm_emit_icmp_i1("slt", foreach_i, foreach_len);
                                llvm_emit_br_i1(foreach_cond_i1, "foreach.body", fe_body_id, "foreach.end", fe_end_id);

                                let brace_fe: Tok = lex_next_kind();
                                if (brace_fe != Tok.LBrace) {
                                    build_err_at(file_idx, "expected '{' after foreach header", stasis.tok_start);
                                    return 1;
                                }

                                if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
                                    return 1;
                                }
                                if (has_let != 0) {
                                    stasis.llvm_local_declared[it_local] = 1;
                                    if (llvm_scope_declare_local(file_idx, it_start, it_local) != 0) {
                                        return 1;
                                    }
                                    if (idx_local >= 0) {
                                        stasis.llvm_local_declared[idx_local] = 1;
                                        if (llvm_scope_declare_local(file_idx, idx_start, idx_local) != 0) {
                                            return 1;
                                        }
                                    }
                                }

                                llvm_emit_label_def("foreach.body", fe_body_id);

                                // it = &base[i]
                                if (idx_local >= 0) {
                                    llvm_emit_store_local(idx_local, foreach_i);
                                }
                                let it_ptr: i32 = llvm_emit_index_value_or_place(file_idx, collection_root, 1, base_ptr, base_kind, base_si, foreach_i, LlvmValueKind.I32);
                                if (it_ptr < 0) { return 1; }
                                llvm_emit_store_ptr_local(it_local, it_ptr);

                                if (stasis.llvm_block_len >= 256) {
                                    build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                                    return 1;
                                }
                                stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.ForeachBody;
                                stasis.llvm_block_end_label[stasis.llvm_block_len] = fe_end_id;
                                stasis.llvm_block_cond_label[stasis.llvm_block_len] = fe_cond_id;
                                stasis.llvm_block_step_label[stasis.llvm_block_len] = fe_step_id;
                                stasis.llvm_block_foreach_index_local[stasis.llvm_block_len] = idx_local;
                                stasis.llvm_block_foreach_idx_phi_tmp[stasis.llvm_block_len] = foreach_i;
                                stasis.llvm_block_foreach_idx_next_tmp[stasis.llvm_block_len] = foreach_i_next;
                                stasis.llvm_block_len = stasis.llvm_block_len + 1;
                            } else {
                            if (k == Tok.ForKeyword) {
                                llvm_ensure_bb_open();

                                let lp2: Tok = lex_next_kind();
                                if (lp2 != Tok.LParen) {
                                    build_err_at(file_idx, "expected '(' after 'for'", stasis.tok_start);
                                    return 1;
                                }

                                // init? ;
                                let init_k: Tok = lex_next_kind();
                                if (init_k != Tok.Semicolon) {
                                    let init_root: i32 = expr_parse_after_first(file_idx, init_k, Tok.Semicolon);
                                    if (init_root < 0) { return 1; }
                                    let init_tmp: i32 = llvm_emit_expr_i32(file_idx, init_root);
                                    if (init_tmp < 0) { return 1; }
                                }

                                let for_cond_id: i32 = llvm_new_label();
                                let body_id: i32 = llvm_new_label();
                                let for_step_id: i32 = llvm_new_label();
                                let for_end_id: i32 = llvm_new_label();

                                llvm_emit_br("for.cond", for_cond_id);
                                llvm_emit_label_def("for.cond", for_cond_id);

                                // cond? ;
                                let cond_k: Tok = lex_next_kind();
                                let has_cond: i32 = 1;
                                let for_cond_i1: i32 = 0;
                                if (cond_k == Tok.Semicolon) {
                                    has_cond = 0;
                                } else {
                                    let cond_root2: i32 = expr_parse_after_first(file_idx, cond_k, Tok.Semicolon);
                                    if (cond_root2 < 0) { return 1; }
                                    for_cond_i1 = llvm_emit_expr_i1(file_idx, cond_root2);
                                    if (for_cond_i1 < 0) { return 1; }
                                }

                                if (has_cond == 0) {
                                    llvm_emit_br("for.body", body_id);
                                } else {
                                    llvm_emit_br_i1(for_cond_i1, "for.body", body_id, "for.end", for_end_id);
                                }

                                // step? )
                                let step_k: Tok = lex_next_kind();
                                let for_has_step: i32 = 0;
                                let for_step_start: i32 = 0;
                                if (step_k != Tok.RParen) {
                                    for_has_step = 1;
                                    for_step_start = stasis.tok_start;
                                    let step_root: i32 = expr_parse_after_first(file_idx, step_k, Tok.RParen);
                                    if (step_root < 0) { return 1; }
                                }

                                let brace3: Tok = lex_next_kind();
                                if (brace3 != Tok.LBrace) {
                                    build_err_at(file_idx, "expected '{' after for header", stasis.tok_start);
                                    return 1;
                                }

                                if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
                                    return 1;
                                }

                                llvm_emit_label_def("for.body", body_id);

                                if (stasis.llvm_block_len >= 256) {
                                    build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                                    return 1;
                                }
                                stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.ForBody;
                                stasis.llvm_block_end_label[stasis.llvm_block_len] = for_end_id;
                                stasis.llvm_block_cond_label[stasis.llvm_block_len] = for_cond_id;
                                stasis.llvm_block_step_label[stasis.llvm_block_len] = for_step_id;
                                stasis.llvm_block_has_step[stasis.llvm_block_len] = for_has_step;
                                stasis.llvm_block_step_start[stasis.llvm_block_len] = for_step_start;
                                stasis.llvm_block_step_file_idx[stasis.llvm_block_len] = file_idx;
                                stasis.llvm_block_len = stasis.llvm_block_len + 1;
                            } else {
                                // Expression statement.
                                llvm_ensure_bb_open();
                                let root3: i32 = expr_parse_after_first(file_idx, k, Tok.Semicolon);
                                if (root3 < 0) { return 1; }
                                let tmp: i32 = llvm_emit_expr_value(file_idx, root3);
                                if (tmp < 0) { return 1; }
                            }
                            }
                        }
                    }
                }
            }
        }
    }

    if (did_return == 0 && is_void == 0 && implicit_test_ret == 0) {
        build_err_at(file_idx, "missing return (llvm bring-up)", body_start);
        return 1;
    }

    if (is_void != 0 && stasis.llvm_bb_terminated == 0) {
        llvm_emit_br("exit", exit_label);
    }

    ascii_append(stasis.ir_out, "\n");
    llvm_emit_label_def("exit", exit_label);
    if (is_void != 0) {
        ascii_append(stasis.ir_out, "  ret void\n");
    } else {
        let ret_tmp: i32 = llvm_new_tmp();
        ascii_append(stasis.ir_out, "  ");
        llvm_append_tmp(ret_tmp);
        if (is_f32_ret != 0) {
            ascii_append(stasis.ir_out, " = load float, ptr %ret_slot, align 4\n");
            ascii_append(stasis.ir_out, "  ret float ");
            llvm_append_tmp(ret_tmp);
            ascii_append(stasis.ir_out, "\n");
        } else {
            ascii_append(stasis.ir_out, " = load i32, ptr %ret_slot, align 4\n");
            ascii_append(stasis.ir_out, "  ret i32 ");
            llvm_append_tmp(ret_tmp);
            ascii_append(stasis.ir_out, "\n");
        }
    }

    ascii_append(stasis.ir_out, "}\n\n");
    return 0;
}

function emit_llvm_func_return_i32_noargs(func_idx: i32): i32 {
    let file_idx: i32 = stasis.funcs[func_idx].file_idx;
    let body_start: i32 = stasis.funcs[func_idx].body_start;
    if (body_start < 0) {
        build_err_at(file_idx, "missing function body", stasis.funcs[func_idx].name_start);
        return 1;
    }

    if (!lex_begin(file_idx)) {
        build_err_at(file_idx, "failed to start lexer", 0);
        return 1;
    }
    stasis.lex_pos = body_start;

    llvm_reset();
    stasis.sig_kind = Tok.Unknown;

    ascii_append(stasis.ir_out, "define i32 @");
    llvm_append_func_ir_name(func_idx);
    ascii_append(stasis.ir_out, "() {\n");
    ascii_append(stasis.ir_out, "entry:\n");

    let exit_label: i32 = llvm_new_label();

    ascii_append(stasis.ir_out, "  %ret_slot = alloca i32, align 4\n");
    ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");

    let k: Tok = lex_next_kind();
    if (k != Tok.LBrace) {
        build_err_at(file_idx, "expected '{' at start of function body", stasis.tok_start);
        return 1;
    }

    k = lex_next_kind();
    if (k != Tok.ReturnKeyword) {
        build_err_at(file_idx, "expected 'return' in function body (minimal function bring-up)", stasis.tok_start);
        return 1;
    }

    let next: Tok = lex_next_kind();
    if (next == Tok.Semicolon) {
        ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
    } else {
        let root: i32 = expr_parse_after_first(file_idx, next, Tok.Semicolon);
        if (root < 0) { return 1; }
        let folded: i32 = expr_try_eval_i32_const(root);
        if (stasis.expr_eval_failed == 0) {
            ascii_append(stasis.ir_out, "  store i32 ");
            ir_append_i32(stasis.ir_out, folded);
            ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
        } else {
            let ret_id: i32 = llvm_emit_expr_i32(file_idx, root);
            if (ret_id < 0) { return 1; }
            ascii_append(stasis.ir_out, "  store i32 ");
            llvm_append_tmp(ret_id);
            ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
        }
    }
    llvm_emit_br("exit", exit_label);

    k = lex_next_kind();
    if (k != Tok.RBrace) {
        build_err_at(file_idx, "expected '}' after return statement (minimal function bring-up)", stasis.tok_start);
        return 1;
    }

    ascii_append(stasis.ir_out, "\n");
    llvm_emit_label_def("exit", exit_label);
    let ret_tmp: i32 = llvm_new_tmp();
    ascii_append(stasis.ir_out, "  ");
    llvm_append_tmp(ret_tmp);
    ascii_append(stasis.ir_out, " = load i32, ptr %ret_slot, align 4\n");
    ascii_append(stasis.ir_out, "  ret i32 ");
    llvm_append_tmp(ret_tmp);
    ascii_append(stasis.ir_out, "\n");

    ascii_append(stasis.ir_out, "}\n\n");
    return 0;
}
