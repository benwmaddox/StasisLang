import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";

function sh_emit_llvm_func_i32ish(func_idx: i32): i32 {
    let file_idx: i32 = sh.funcs[func_idx].file_idx;
    let body_start: i32 = sh.funcs[func_idx].body_start;
    if (body_start < 0) {
        sh_build_err_at(file_idx, "missing function body", sh.funcs[func_idx].name_start);
        return 1;
    }

    let ret_ty: i32 = sh.funcs[func_idx].ret_type_idx;
    let is_void: i32 = 0;
    let is_f32_ret: i32 = 0;
    if (ret_ty < 0 || sh_build_type_is_void(ret_ty)) {
        is_void = 1;
    } else {
        if (sh_build_type_is_f32(ret_ty)) {
            is_f32_ret = 1;
        } else {
            if (!sh_build_type_is_i32ish(ret_ty) && !sh_build_type_is_byte_named(ret_ty)) {
                sh_build_err_at(file_idx, "unsupported function return type (llvm bring-up)", sh.funcs[func_idx].name_start);
                return 1;
            }
        }
    }

    if (!sh_lex_begin(file_idx)) {
        sh_build_err_at(file_idx, "failed to start lexer", 0);
        return 1;
    }
    sh.lex_pos = body_start;

    sh_llvm_reset();

    // Parameters are modeled as locals for name resolution simplicity.
    let params_off: i32 = sh.funcs[func_idx].params_off;
    let params_len: i32 = sh.funcs[func_idx].params_len;
    let p: i32 = 0;
    for (p = 0; p < params_len; p = p + 1) {
        let p_decl: i32 = params_off + p;
        if (p_decl < 0 || p_decl >= sh.param_count) {
            sh_build_err_at(file_idx, "invalid function parameters", sh.funcs[func_idx].name_start);
            return 1;
        }
        let p_ty: i32 = sh.params[p_decl].type_idx;
        if (p_ty < 0 || p_ty >= sh.type_count) {
            sh_build_err_at(file_idx, "invalid parameter type (llvm bring-up)", sh.params[p_decl].name_start);
            return 1;
        }

        // Bring-up: scalar params are i32; array/slice params are ptr.
        let param_kind: ShLlvmValueKind = ShLlvmValueKind.I32;
        if (sh_build_type_is_f32(p_ty)) {
            param_kind = ShLlvmValueKind.F32;
        } else {
        if (!sh_build_type_is_i32ish(p_ty) && !sh_build_type_is_byte_named(p_ty)) {
            let p_tkind: ShTypeKind = sh.types[p_ty].kind;
            if (p_tkind != ShTypeKind.Array) {
                sh_build_err_at(file_idx, "unsupported parameter type (llvm bring-up)", sh.params[p_decl].name_start);
                return 1;
            }

            let elem: i32 = sh.types[p_ty].elem;
            if (sh_build_type_is_byte_named(elem)) {
                param_kind = ShLlvmValueKind.PtrI8;
            } else {
                if (sh_build_type_is_i32ish(elem)) {
                    param_kind = ShLlvmValueKind.PtrI32;
                } else {
                    if (sh_build_type_is_f32(elem)) {
                        param_kind = ShLlvmValueKind.PtrF32;
                    } else {
                        sh_build_err_at(file_idx, "unsupported parameter element type (llvm bring-up)", sh.params[p_decl].name_start);
                        return 1;
                    }
                }
            }
        }
        }

        let local_id: i32 = sh_llvm_add_local(file_idx, sh.params[p_decl].name_start, sh.params[p_decl].name_len);
        if (local_id < 0) {
            return 1;
        }
        sh.llvm_local_kind[local_id] = param_kind;
        sh.llvm_local_declared[local_id] = 1;
        sh.llvm_local_declared_at[local_id] = sh.params[p_decl].name_start;
    }

    // Pre-scan locals so we can emit all allocas in entry (LLVM friendliness).
    if (sh_llvm_scan_locals_in_body(file_idx, body_start) != 0) {
        return 1;
    }

    // Reset lexer to body start for the real codegen pass.
    sh.lex_pos = body_start;
    sh.sig_kind = ShTok.Unknown; // reuse as a 1-token pushback for statement parsing

    ascii_append(sh.ir_out, "define ");
    if (is_void != 0) {
        ascii_append(sh.ir_out, "void @");
    } else {
        if (is_f32_ret != 0) {
            ascii_append(sh.ir_out, "float @");
        } else {
            ascii_append(sh.ir_out, "i32 @");
        }
    }
    sh_llvm_append_func_ir_name(func_idx);
    ascii_append(sh.ir_out, "(");
    for (p = 0; p < params_len; p = p + 1) {
        if (p != 0) {
            ascii_append(sh.ir_out, ", ");
        }
        let p_kind_sig: ShLlvmValueKind = sh.llvm_local_kind[p];
        if (p_kind_sig == ShLlvmValueKind.I32) {
            ascii_append(sh.ir_out, "i32 %a");
        } else {
            if (p_kind_sig == ShLlvmValueKind.F32) {
                ascii_append(sh.ir_out, "float %a");
        } else {
            if (p_kind_sig == ShLlvmValueKind.PtrI8 || p_kind_sig == ShLlvmValueKind.PtrI32 || p_kind_sig == ShLlvmValueKind.PtrF32 || p_kind_sig == ShLlvmValueKind.PtrStruct) {
                ascii_append(sh.ir_out, "ptr %a");
            } else {
                sh_build_err_at(file_idx, "unsupported parameter kind (llvm bring-up)", sh.funcs[func_idx].name_start);
                return 1;
            }
        }
        }
        sh_ir_append_i32(sh.ir_out, p);
    }
    ascii_append(sh.ir_out, ") {\n");
    ascii_append(sh.ir_out, "entry:\n");

    let exit_label: i32 = sh_llvm_new_label();

    // Return slot (allows return to appear anywhere).
    if (is_void != 0) {
        ascii_append(sh.ir_out, "  %ret_slot = alloca i32, align 4\n");
        ascii_append(sh.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
    } else {
        if (is_f32_ret != 0) {
            ascii_append(sh.ir_out, "  %ret_slot = alloca float, align 4\n");
            ascii_append(sh.ir_out, "  store float 0.0, ptr %ret_slot, align 4\n");
        } else {
            ascii_append(sh.ir_out, "  %ret_slot = alloca i32, align 4\n");
            ascii_append(sh.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
        }
    }

    // Locals are modeled as wasm-like locals: 0-initialized and available for the whole function.
    let i: i32 = 0;
    for (i = 0; i < sh.llvm_local_count; i = i + 1) {
        let lkind: ShLlvmValueKind = sh.llvm_local_kind[i];
        if (lkind == ShLlvmValueKind.I32) {
            ascii_append(sh.ir_out, "  ");
            sh_llvm_append_local_ptr(i);
            ascii_append(sh.ir_out, " = alloca i32, align 4\n");
            ascii_append(sh.ir_out, "  store i32 0, ptr ");
            sh_llvm_append_local_ptr(i);
            ascii_append(sh.ir_out, ", align 4\n");
        } else {
            if (lkind == ShLlvmValueKind.F32) {
                ascii_append(sh.ir_out, "  ");
                sh_llvm_append_local_ptr(i);
                ascii_append(sh.ir_out, " = alloca float, align 4\n");
                ascii_append(sh.ir_out, "  store float 0.0, ptr ");
                sh_llvm_append_local_ptr(i);
                ascii_append(sh.ir_out, ", align 4\n");
            } else {
                if (lkind == ShLlvmValueKind.PtrI8 || lkind == ShLlvmValueKind.PtrI32 || lkind == ShLlvmValueKind.PtrF32 || lkind == ShLlvmValueKind.PtrStruct) {
                    ascii_append(sh.ir_out, "  ");
                    sh_llvm_append_local_ptr(i);
                    ascii_append(sh.ir_out, " = alloca ptr, align 8\n");
                    ascii_append(sh.ir_out, "  store ptr null, ptr ");
                    sh_llvm_append_local_ptr(i);
                    ascii_append(sh.ir_out, ", align 8\n");
                } else {
                    sh_build_err_at(file_idx, "unsupported local kind (llvm bring-up)", body_start);
                    return 1;
                }
            }
        }
    }

    // Initialize parameter locals from SSA arguments.
    for (p = 0; p < params_len; p = p + 1) {
        let p_kind_init: ShLlvmValueKind = sh.llvm_local_kind[p];
        if (p_kind_init == ShLlvmValueKind.I32) {
            ascii_append(sh.ir_out, "  store i32 %a");
            sh_ir_append_i32(sh.ir_out, p);
            ascii_append(sh.ir_out, ", ptr ");
            sh_llvm_append_local_ptr(p);
            ascii_append(sh.ir_out, ", align 4\n");
        } else {
            if (p_kind_init == ShLlvmValueKind.F32) {
                ascii_append(sh.ir_out, "  store float %a");
                sh_ir_append_i32(sh.ir_out, p);
                ascii_append(sh.ir_out, ", ptr ");
                sh_llvm_append_local_ptr(p);
                ascii_append(sh.ir_out, ", align 4\n");
            } else {
            if (p_kind_init == ShLlvmValueKind.PtrI8 || p_kind_init == ShLlvmValueKind.PtrI32 || p_kind_init == ShLlvmValueKind.PtrF32 || p_kind_init == ShLlvmValueKind.PtrStruct) {
                ascii_append(sh.ir_out, "  store ptr %a");
                sh_ir_append_i32(sh.ir_out, p);
                ascii_append(sh.ir_out, ", ptr ");
                sh_llvm_append_local_ptr(p);
                ascii_append(sh.ir_out, ", align 8\n");
            } else {
                sh_build_err_at(file_idx, "unsupported parameter kind (llvm bring-up)", sh.funcs[func_idx].name_start);
                return 1;
            }
            }
        }
    }

    let k: ShTok = sh_lex_next_kind();
    if (k != ShTok.LBrace) {
        sh_build_err_at(file_idx, "expected '{' at start of function body", sh.tok_start);
        return 1;
    }

    // Push a synthetic function block; it ends at the final '}'.
    sh.llvm_block_kind[0] = ShLlvmBlockKind.Function;
    sh.llvm_block_end_label[0] = exit_label;
    sh.llvm_block_len = 1;

    let did_return: i32 = 0;
    let done: i32 = 0;
    for (; done == 0; ) {
        if (sh.sig_kind != ShTok.Unknown) {
            k = sh.sig_kind;
            sh.sig_kind = ShTok.Unknown;
        } else {
            k = sh_lex_next_kind();
        }

        if (k == ShTok.Eof) {
            sh_build_err_at(file_idx, "unexpected eof in function body", sh.tok_start);
            return 1;
        }

        if (k == ShTok.RBrace) {
            if (sh.llvm_block_len <= 0) {
                sh_build_err_at(file_idx, "unmatched '}' in function body", sh.tok_start);
                return 1;
            }

            let top: i32 = sh.llvm_block_len - 1;
            let kind: ShLlvmBlockKind = sh.llvm_block_kind[top];
            if (kind == ShLlvmBlockKind.Plain) {
                sh.llvm_block_len = top;
            } else {
                if (kind == ShLlvmBlockKind.IfThen) {
                    let end_id: i32 = sh.llvm_block_end_label[top];
                    let else_id: i32 = sh.llvm_block_else_label[top];
                    sh.llvm_block_len = top;

                    if (sh.llvm_bb_terminated == 0) {
                        sh_llvm_emit_br("if.end", end_id);
                    }

                    sh_llvm_emit_label_def("if.else", else_id);

                    let next: ShTok = sh_lex_next_kind();
                    if (next == ShTok.ElseKeyword) {
                        let brace2: ShTok = sh_lex_next_kind();
                        if (brace2 != ShTok.LBrace) {
                            sh_build_err_at(file_idx, "expected '{' after 'else'", sh.tok_start);
                            return 1;
                        }

                        if (sh.llvm_block_len >= 256) {
                            sh_build_err_at(file_idx, "block nesting too deep (llvm)", sh.tok_start);
                            return 1;
                        }
                        sh.llvm_block_kind[sh.llvm_block_len] = ShLlvmBlockKind.IfElse;
                        sh.llvm_block_end_label[sh.llvm_block_len] = end_id;
                        sh.llvm_block_len = sh.llvm_block_len + 1;
                    } else {
                        // No else: emit an empty else block.
                        sh_llvm_emit_br("if.end", end_id);
                        sh_llvm_emit_label_def("if.end", end_id);
                        sh.sig_kind = next;
                    }
                } else {
                    if (kind == ShLlvmBlockKind.IfElse) {
                        let end_id2: i32 = sh.llvm_block_end_label[top];
                        sh.llvm_block_len = top;

                        if (sh.llvm_bb_terminated == 0) {
                            sh_llvm_emit_br("if.end", end_id2);
                        }
                        sh_llvm_emit_label_def("if.end", end_id2);
                    } else {
                        if (kind == ShLlvmBlockKind.ForBody) {
                            let end_id3: i32 = sh.llvm_block_end_label[top];
                            let cond_id: i32 = sh.llvm_block_cond_label[top];
                            let step_id: i32 = sh.llvm_block_step_label[top];
                            let has_step: i32 = sh.llvm_block_has_step[top];
                            let step_start: i32 = sh.llvm_block_step_start[top];
                            let step_file_idx: i32 = sh.llvm_block_step_file_idx[top];
                            sh.llvm_block_len = top;

                            if (sh.llvm_bb_terminated == 0) {
                                if (has_step != 0) {
                                    sh_llvm_emit_br("for.step", step_id);
                                } else {
                                    sh_llvm_emit_br("for.cond", cond_id);
                                }
                            }

                            if (has_step != 0) {
                                sh_llvm_emit_label_def("for.step", step_id);

                                // Re-parse and emit the step expression from the header span.
                                let resume_pos: i32 = sh.lex_pos;
                                sh.lex_pos = step_start;
                                let root_step: i32 = sh_expr_parse_until(step_file_idx, ShTok.RParen);
                                if (root_step < 0) { return 1; }
                                let tmp_step: i32 = sh_llvm_emit_expr_i32(step_file_idx, root_step);
                                if (tmp_step < 0) { return 1; }
                                sh.lex_pos = resume_pos;

                                if (sh.llvm_bb_terminated == 0) {
                                    sh_llvm_emit_br("for.cond", cond_id);
                                }
                            }

                            sh_llvm_emit_label_def("for.end", end_id3);
                        } else {
                            if (kind == ShLlvmBlockKind.Function) {
                                sh.llvm_block_len = top;

                                if (sh.llvm_bb_terminated == 0) {
                                    sh_llvm_emit_br("exit", exit_label);
                                }
                                done = 1;
                            } else {
                                sh_build_err_at(file_idx, "internal error: unknown block kind", sh.tok_start);
                                return 1;
                            }
                        }
                    }
                }
            }
        } else {
            if (k == ShTok.LBrace) {
                if (sh.llvm_block_len >= 256) {
                    sh_build_err_at(file_idx, "block nesting too deep (llvm)", sh.tok_start);
                    return 1;
                }
                sh.llvm_block_kind[sh.llvm_block_len] = ShLlvmBlockKind.Plain;
                sh.llvm_block_len = sh.llvm_block_len + 1;
            } else {
                if (k == ShTok.LetKeyword) {
                    // let name (: type)? (= expr)? ;
                    let name_k: ShTok = sh_lex_next_kind();
                    if (name_k != ShTok.Identifier) {
                        sh_build_err_at(file_idx, "expected variable name", sh.tok_start);
                        return 1;
                    }
                    let local_id2: i32 = sh_llvm_find_local(file_idx, sh.tok_start, sh.tok_len);
                    if (local_id2 < 0) {
                        sh_build_err_at(file_idx, "unknown local", sh.tok_start);
                        return 1;
                    }
                    sh.llvm_local_declared[local_id2] = 1;

                    let next_k: ShTok = sh_lex_next_kind();
                    if (next_k == ShTok.Colon) {
                        let ty_k: ShTok = sh_lex_next_kind();
                        if (ty_k != ShTok.Identifier) {
                            sh_build_err_at(file_idx, "expected type name", sh.tok_start);
                            return 1;
                        }
                        if (sh_span_eq(file_idx, sh.tok_start, sh.tok_len, "f32")) {
                            sh.llvm_local_kind[local_id2] = ShLlvmValueKind.F32;
                        } else {
                        if (!sh_span_eq(file_idx, sh.tok_start, sh.tok_len, "i32") && !sh_span_eq(file_idx, sh.tok_start, sh.tok_len, "bool") && !sh_span_eq(file_idx, sh.tok_start, sh.tok_len, "u8")) {
                            let enum_hit: i32 = sh_llvm_try_resolve_unqualified_enum(file_idx, sh.tok_start, sh.tok_len, sh.tok_start);
                            if (enum_hit < 0) {
                                if (enum_hit == -2) {
                                    return 1;
                                }
                                sh_build_err_at(file_idx, "unsupported local type (llvm bring-up)", sh.tok_start);
                                return 1;
                            }
                        }
                        }
                        next_k = sh_lex_next_kind();
                    }

                    if (next_k == ShTok.Equal) {
                        sh_llvm_ensure_bb_open();
                        let root: i32 = sh_expr_parse_until(file_idx, ShTok.Semicolon);
                        if (root < 0) { return 1; }
                        if (sh.llvm_local_kind[local_id2] == ShLlvmValueKind.F32) {
                            let rhs_f32_id2: i32 = sh_llvm_emit_expr_f32(file_idx, root);
                            if (rhs_f32_id2 < 0) { return 1; }
                            ascii_append(sh.ir_out, "  store float ");
                            sh_llvm_append_tmp(rhs_f32_id2);
                            ascii_append(sh.ir_out, ", ptr ");
                            sh_llvm_append_local_ptr(local_id2);
                            ascii_append(sh.ir_out, ", align 4\n");
                        } else {
                            let folded: i32 = sh_expr_try_eval_i32_const(root);
                            if (sh.expr_eval_failed == 0) {
                                ascii_append(sh.ir_out, "  store i32 ");
                                sh_ir_append_i32(sh.ir_out, folded);
                                ascii_append(sh.ir_out, ", ptr ");
                                sh_llvm_append_local_ptr(local_id2);
                                ascii_append(sh.ir_out, ", align 4\n");
                            } else {
                                let rhs_id: i32 = sh_llvm_emit_expr_i32(file_idx, root);
                                if (rhs_id < 0) { return 1; }
                                sh_llvm_emit_store_local(local_id2, rhs_id);
                            }
                        }
                    } else {
                        if (next_k != ShTok.Semicolon) {
                            sh_build_err_at(file_idx, "expected '=' or ';' after let", sh.tok_start);
                            return 1;
                        }
                        // No initializer: locals are already 0-initialized in entry.
                    }
                } else {
                    if (k == ShTok.ReturnKeyword) {
                        did_return = 1;
                        sh_llvm_ensure_bb_open();

                        let next2: ShTok = sh_lex_next_kind();
                        if (is_void != 0) {
                            if (next2 != ShTok.Semicolon) {
                                sh_build_err_at(file_idx, "void function cannot return a value (llvm bring-up)", sh.tok_start);
                                return 1;
                            }
                            sh_llvm_emit_br("exit", exit_label);
                        } else {
                            if (next2 == ShTok.Semicolon) {
                                if (is_f32_ret != 0) {
                                    ascii_append(sh.ir_out, "  store float 0.0, ptr %ret_slot, align 4\n");
                                    sh_llvm_emit_br("exit", exit_label);
                                } else {
                                    ascii_append(sh.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
                                    sh_llvm_emit_br("exit", exit_label);
                                }
                            } else {
                                let root2: i32 = sh_expr_parse_after_first(file_idx, next2, ShTok.Semicolon);
                                if (root2 < 0) { return 1; }
                                if (is_f32_ret != 0) {
                                    let ret_f32_id: i32 = sh_llvm_emit_expr_f32(file_idx, root2);
                                    if (ret_f32_id < 0) { return 1; }
                                    ascii_append(sh.ir_out, "  store float ");
                                    sh_llvm_append_tmp(ret_f32_id);
                                    ascii_append(sh.ir_out, ", ptr %ret_slot, align 4\n");
                                } else {
                                    let folded2: i32 = sh_expr_try_eval_i32_const(root2);
                                    if (sh.expr_eval_failed == 0) {
                                        ascii_append(sh.ir_out, "  store i32 ");
                                        sh_ir_append_i32(sh.ir_out, folded2);
                                        ascii_append(sh.ir_out, ", ptr %ret_slot, align 4\n");
                                    } else {
                                        let ret_id: i32 = sh_llvm_emit_expr_i32(file_idx, root2);
                                        if (ret_id < 0) { return 1; }
                                        ascii_append(sh.ir_out, "  store i32 ");
                                        sh_llvm_append_tmp(ret_id);
                                        ascii_append(sh.ir_out, ", ptr %ret_slot, align 4\n");
                                    }
                                }
                                sh_llvm_emit_br("exit", exit_label);
                            }
                        }
                    } else {
                        if (k == ShTok.IfKeyword) {
                            sh_llvm_ensure_bb_open();

                            let lp: ShTok = sh_lex_next_kind();
                            if (lp != ShTok.LParen) {
                                sh_build_err_at(file_idx, "expected '(' after 'if'", sh.tok_start);
                                return 1;
                            }

                            let cond_root: i32 = sh_expr_parse_until(file_idx, ShTok.RParen);
                            if (cond_root < 0) { return 1; }
                            let cond_i1: i32 = sh_llvm_emit_expr_i1(file_idx, cond_root);
                            if (cond_i1 < 0) { return 1; }

                            let then_id: i32 = sh_llvm_new_label();
                            let else_id2: i32 = sh_llvm_new_label();
                            let if_end_id: i32 = sh_llvm_new_label();

                            sh_llvm_emit_br_i1(cond_i1, "if.then", then_id, "if.else", else_id2);
                            sh_llvm_emit_label_def("if.then", then_id);

                            let brace: ShTok = sh_lex_next_kind();
                            if (brace != ShTok.LBrace) {
                                sh_build_err_at(file_idx, "expected '{' after if condition", sh.tok_start);
                                return 1;
                            }

                            if (sh.llvm_block_len >= 256) {
                                sh_build_err_at(file_idx, "block nesting too deep (llvm)", sh.tok_start);
                                return 1;
                            }
                            sh.llvm_block_kind[sh.llvm_block_len] = ShLlvmBlockKind.IfThen;
                            sh.llvm_block_end_label[sh.llvm_block_len] = if_end_id;
                            sh.llvm_block_else_label[sh.llvm_block_len] = else_id2;
                            sh.llvm_block_len = sh.llvm_block_len + 1;
                        } else {
                            if (k == ShTok.ForKeyword) {
                                sh_llvm_ensure_bb_open();

                                let lp2: ShTok = sh_lex_next_kind();
                                if (lp2 != ShTok.LParen) {
                                    sh_build_err_at(file_idx, "expected '(' after 'for'", sh.tok_start);
                                    return 1;
                                }

                                // init? ;
                                let init_k: ShTok = sh_lex_next_kind();
                                if (init_k != ShTok.Semicolon) {
                                    let init_root: i32 = sh_expr_parse_after_first(file_idx, init_k, ShTok.Semicolon);
                                    if (init_root < 0) { return 1; }
                                    let init_tmp: i32 = sh_llvm_emit_expr_i32(file_idx, init_root);
                                    if (init_tmp < 0) { return 1; }
                                }

                                let for_cond_id: i32 = sh_llvm_new_label();
                                let body_id: i32 = sh_llvm_new_label();
                                let for_step_id: i32 = sh_llvm_new_label();
                                let for_end_id: i32 = sh_llvm_new_label();

                                sh_llvm_emit_br("for.cond", for_cond_id);
                                sh_llvm_emit_label_def("for.cond", for_cond_id);

                                // cond? ;
                                let cond_k: ShTok = sh_lex_next_kind();
                                let has_cond: i32 = 1;
                                let for_cond_i1: i32 = 0;
                                if (cond_k == ShTok.Semicolon) {
                                    has_cond = 0;
                                } else {
                                    let cond_root2: i32 = sh_expr_parse_after_first(file_idx, cond_k, ShTok.Semicolon);
                                    if (cond_root2 < 0) { return 1; }
                                    for_cond_i1 = sh_llvm_emit_expr_i1(file_idx, cond_root2);
                                    if (for_cond_i1 < 0) { return 1; }
                                }

                                if (has_cond == 0) {
                                    sh_llvm_emit_br("for.body", body_id);
                                } else {
                                    sh_llvm_emit_br_i1(for_cond_i1, "for.body", body_id, "for.end", for_end_id);
                                }

                                // step? )
                                let step_k: ShTok = sh_lex_next_kind();
                                let for_has_step: i32 = 0;
                                let for_step_start: i32 = 0;
                                if (step_k != ShTok.RParen) {
                                    for_has_step = 1;
                                    for_step_start = sh.tok_start;
                                    let step_root: i32 = sh_expr_parse_after_first(file_idx, step_k, ShTok.RParen);
                                    if (step_root < 0) { return 1; }
                                }

                                let brace3: ShTok = sh_lex_next_kind();
                                if (brace3 != ShTok.LBrace) {
                                    sh_build_err_at(file_idx, "expected '{' after for header", sh.tok_start);
                                    return 1;
                                }

                                sh_llvm_emit_label_def("for.body", body_id);

                                if (sh.llvm_block_len >= 256) {
                                    sh_build_err_at(file_idx, "block nesting too deep (llvm)", sh.tok_start);
                                    return 1;
                                }
                                sh.llvm_block_kind[sh.llvm_block_len] = ShLlvmBlockKind.ForBody;
                                sh.llvm_block_end_label[sh.llvm_block_len] = for_end_id;
                                sh.llvm_block_cond_label[sh.llvm_block_len] = for_cond_id;
                                sh.llvm_block_step_label[sh.llvm_block_len] = for_step_id;
                                sh.llvm_block_has_step[sh.llvm_block_len] = for_has_step;
                                sh.llvm_block_step_start[sh.llvm_block_len] = for_step_start;
                                sh.llvm_block_step_file_idx[sh.llvm_block_len] = file_idx;
                                sh.llvm_block_len = sh.llvm_block_len + 1;
                            } else {
                                // Expression statement.
                                sh_llvm_ensure_bb_open();
                                let root3: i32 = sh_expr_parse_after_first(file_idx, k, ShTok.Semicolon);
                                if (root3 < 0) { return 1; }
                                let tmp: i32 = sh_llvm_emit_expr_value(file_idx, root3);
                                if (tmp < 0) { return 1; }
                            }
                        }
                    }
                }
            }
        }
    }

    if (did_return == 0 && is_void == 0) {
        sh_build_err_at(file_idx, "missing return (llvm bring-up)", body_start);
        return 1;
    }

    if (is_void != 0 && sh.llvm_bb_terminated == 0) {
        sh_llvm_emit_br("exit", exit_label);
    }

    ascii_append(sh.ir_out, "\n");
    sh_llvm_emit_label_def("exit", exit_label);
    if (is_void != 0) {
        ascii_append(sh.ir_out, "  ret void\n");
    } else {
        let ret_tmp: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(ret_tmp);
        if (is_f32_ret != 0) {
            ascii_append(sh.ir_out, " = load float, ptr %ret_slot, align 4\n");
            ascii_append(sh.ir_out, "  ret float ");
            sh_llvm_append_tmp(ret_tmp);
            ascii_append(sh.ir_out, "\n");
        } else {
            ascii_append(sh.ir_out, " = load i32, ptr %ret_slot, align 4\n");
            ascii_append(sh.ir_out, "  ret i32 ");
            sh_llvm_append_tmp(ret_tmp);
            ascii_append(sh.ir_out, "\n");
        }
    }

    ascii_append(sh.ir_out, "}\n\n");
    return 0;
}

function sh_emit_llvm_func_return_i32_noargs(func_idx: i32): i32 {
    let file_idx: i32 = sh.funcs[func_idx].file_idx;
    let body_start: i32 = sh.funcs[func_idx].body_start;
    if (body_start < 0) {
        sh_build_err_at(file_idx, "missing function body", sh.funcs[func_idx].name_start);
        return 1;
    }

    if (!sh_lex_begin(file_idx)) {
        sh_build_err_at(file_idx, "failed to start lexer", 0);
        return 1;
    }
    sh.lex_pos = body_start;

    sh_llvm_reset();
    sh.sig_kind = ShTok.Unknown;

    ascii_append(sh.ir_out, "define i32 @");
    sh_llvm_append_func_ir_name(func_idx);
    ascii_append(sh.ir_out, "() {\n");
    ascii_append(sh.ir_out, "entry:\n");

    let exit_label: i32 = sh_llvm_new_label();

    ascii_append(sh.ir_out, "  %ret_slot = alloca i32, align 4\n");
    ascii_append(sh.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");

    let k: ShTok = sh_lex_next_kind();
    if (k != ShTok.LBrace) {
        sh_build_err_at(file_idx, "expected '{' at start of function body", sh.tok_start);
        return 1;
    }

    k = sh_lex_next_kind();
    if (k != ShTok.ReturnKeyword) {
        sh_build_err_at(file_idx, "expected 'return' in function body (minimal function bring-up)", sh.tok_start);
        return 1;
    }

    let next: ShTok = sh_lex_next_kind();
    if (next == ShTok.Semicolon) {
        ascii_append(sh.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
    } else {
        let root: i32 = sh_expr_parse_after_first(file_idx, next, ShTok.Semicolon);
        if (root < 0) { return 1; }
        let folded: i32 = sh_expr_try_eval_i32_const(root);
        if (sh.expr_eval_failed == 0) {
            ascii_append(sh.ir_out, "  store i32 ");
            sh_ir_append_i32(sh.ir_out, folded);
            ascii_append(sh.ir_out, ", ptr %ret_slot, align 4\n");
        } else {
            let ret_id: i32 = sh_llvm_emit_expr_i32(file_idx, root);
            if (ret_id < 0) { return 1; }
            ascii_append(sh.ir_out, "  store i32 ");
            sh_llvm_append_tmp(ret_id);
            ascii_append(sh.ir_out, ", ptr %ret_slot, align 4\n");
        }
    }
    sh_llvm_emit_br("exit", exit_label);

    k = sh_lex_next_kind();
    if (k != ShTok.RBrace) {
        sh_build_err_at(file_idx, "expected '}' after return statement (minimal function bring-up)", sh.tok_start);
        return 1;
    }

    ascii_append(sh.ir_out, "\n");
    sh_llvm_emit_label_def("exit", exit_label);
    let ret_tmp: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(ret_tmp);
    ascii_append(sh.ir_out, " = load i32, ptr %ret_slot, align 4\n");
    ascii_append(sh.ir_out, "  ret i32 ");
    sh_llvm_append_tmp(ret_tmp);
    ascii_append(sh.ir_out, "\n");

    ascii_append(sh.ir_out, "}\n\n");
    return 0;
}

