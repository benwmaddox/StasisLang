import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "check_loaded_files.stasis";
import "cli_linking.stasis";
import "cli_args.stasis";
import "build_ir.stasis";
import "emit_ir.stasis";

function ascii_ends_with_lit(s: ascii[], suffix: ascii[]): bool {
    let slen: i32 = ascii_len(s);
    let n: i32 = ascii_len(suffix);
    if (n < 0) { return false; }
    if (slen < n) { return false; }

    let i: i32 = 0;
    for (i = 0; i < n; i = i + 1) {
        if (s[slen - n + i] != suffix[i]) {
            return false;
        }
    }
    return true;
}

function test_pool_add(path: ascii[]): i32 {
    let n: i32 = ascii_len(path);
    if (n < 0) { return -1; }
    if (n > 259) { return -1; }

    if (stasis.test_pool_len + n + 1 > 2097152) {
        return -1;
    }

    let off: i32 = stasis.test_pool_len;
    let i: i32 = 0;
    for (i = 0; i < n; i = i + 1) {
        stasis.test_pool[off + i] = path[i];
    }
    stasis.test_pool[off + n] = 0;
    stasis.test_pool_len = stasis.test_pool_len + n + 1;
    return off;
}

function test_pool_copy_to(dst: ascii[], off: i32, len: i32): bool {
    ascii_clear(dst);
    if (len < 0 || len > 259) { return false; }
    if (off < 0 || off + len >= 2097152) { return false; }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        dst[i] = stasis.test_pool[off + i];
    }
    dst[len] = 0;
    ascii_set_len(dst, len);
    return true;
}

function test_dirs_reset(root: ascii[]): bool {
    stasis.test_pool_len = 0;
    stasis.test_dirs_sp = 0;
    stasis.test_files_count = 0;
    stasis.test_run_seq = 0;

    let off: i32 = test_pool_add(root);
    if (off < 0) { return false; }

    let n: i32 = ascii_len(root);
    if (n < 0) { return false; }

    stasis.test_dirs_off[0] = off;
    stasis.test_dirs_len[0] = n;
    stasis.test_dirs_sp = 1;
    return true;
}

function test_dirs_push(path: ascii[]): bool {
    if (stasis.test_dirs_sp >= 2048) { return false; }
    let off: i32 = test_pool_add(path);
    if (off < 0) { return false; }
    let n: i32 = ascii_len(path);
    if (n < 0) { return false; }
    stasis.test_dirs_off[stasis.test_dirs_sp] = off;
    stasis.test_dirs_len[stasis.test_dirs_sp] = n;
    stasis.test_dirs_sp = stasis.test_dirs_sp + 1;
    return true;
}

function test_dirs_pop(dst: ascii[]): bool {
    if (stasis.test_dirs_sp <= 0) { return false; }
    stasis.test_dirs_sp = stasis.test_dirs_sp - 1;
    return test_pool_copy_to(dst, stasis.test_dirs_off[stasis.test_dirs_sp], stasis.test_dirs_len[stasis.test_dirs_sp]);
}

function test_add_file(path: ascii[]): bool {
    if (stasis.test_files_count >= 4096) { return false; }
    let off: i32 = test_pool_add(path);
    if (off < 0) { return false; }
    let n: i32 = ascii_len(path);
    if (n < 0) { return false; }
    stasis.test_files_off[stasis.test_files_count] = off;
    stasis.test_files_len[stasis.test_files_count] = n;
    stasis.test_files_count = stasis.test_files_count + 1;
    return true;
}

function test_collect_stasis_files(root_dir: ascii[]): i32 {
    if (!test_dirs_reset(root_dir)) {
        print_string("error: test runner out of memory (init)\n");
        return 1;
    }

    for (; stasis.test_dirs_sp > 0; ) {
        if (!test_dirs_pop(stasis.scratch_watch_path)) {
            print_string("error: test runner stack underflow\n");
            return 1;
        }

        let n: i32 = sys_list_dir(stasis.scratch_watch_path, stasis.test_dir_out, 1048577);
        if (n < 0) {
            print_string("error: failed to list dir: ");
            print_string(stasis.scratch_watch_path);
            print_char(10);
            return 1;
        }

        let i: i32 = 0;
        for (i = 0; i < n; ) {
            let kind: u8 = stasis.test_dir_out[i];
            let handled: i32 = 0;
            if (kind != 68 && kind != 70) { // 'D' or 'F'
                // Skip line.
                for (; i < n && stasis.test_dir_out[i] != 10; ) { i = i + 1; }
                if (i < n && stasis.test_dir_out[i] == 10) { i = i + 1; }
                handled = 1;
            }

            if (handled == 0) {
                if (i + 2 >= n) {
                    i = n;
                    handled = 1;
                } else {
                    if (stasis.test_dir_out[i + 1] != 32) { // space
                        i = i + 1;
                        handled = 1;
                    }
                }
            }

            if (handled == 0) {
                ascii_clear(stasis.scratch_import);
                let j: i32 = i + 2;
                let can_append: i32 = 1;
                for (; j < n && stasis.test_dir_out[j] != 10 && stasis.test_dir_out[j] != 0; j = j + 1) {
                    if (can_append != 0) {
                        if (ascii_len(stasis.scratch_import) + 1 >= 260) {
                            can_append = 0;
                        } else {
                            ascii_append_byte(stasis.scratch_import, stasis.test_dir_out[j]);
                        }
                    }
                }

                // Advance to next line.
                for (; j < n && stasis.test_dir_out[j] != 10; ) { j = j + 1; }
                if (j < n && stasis.test_dir_out[j] == 10) { j = j + 1; }
                i = j;

                if (!ascii_is_empty(stasis.scratch_import)) {
                    path_join(stasis.scratch_resolved, stasis.scratch_watch_path, stasis.scratch_import);

                    if (kind == 68) { // 'D'
                        if (!test_dirs_push(stasis.scratch_resolved)) {
                            print_string("error: test runner out of memory (dirs)\n");
                            return 1;
                        }
                    } else {
                        if (ascii_ends_with_lit(stasis.scratch_import, ".stasis")) {
                            if (!test_add_file(stasis.scratch_resolved)) {
                                print_string("error: test runner out of memory (files)\n");
                                return 1;
                            }
                        }
                    }
                }
            }
        }
    }

    return 0;
}

function test_run_file(entry_path: ascii[], test_index: i32): i32 {
    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: test currently supports --backend llvm only\n");
        return 1;
    }

    let rc: i32 = load_graph(entry_path);
    if (rc != 0) { return rc; }

    rc = check_loaded_files();
    if (rc != 0) { return rc; }

    rc = emit_tests_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) { return rc; }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);

    // Use per-test outputs to avoid transient Windows file-lock collisions when re-linking.
    let uniq: i32 = stasis.test_run_seq;
    stasis.test_run_seq = stasis.test_run_seq + 1;

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "stasis_test_");
    ir_append_i32(stasis.scratch_import, uniq);
    ascii_append(stasis.scratch_import, ".ll");
    path_join(stasis.scratch_resolved, stasis.scratch_dir, stasis.scratch_import);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "stasis_test_");
    ir_append_i32(stasis.scratch_import, uniq);
    ascii_append(stasis.scratch_import, ".exe");
    path_join(stasis.scratch_exe, stasis.scratch_dir, stasis.scratch_import);

    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    // Fast path: if we don't need native linking, try `lli` (matches stage0 behavior and avoids clang/link cost).
    if (!needs_graphics && !needs_sys) {
        ascii_clear(stasis.exec_cmd);
        ascii_append(stasis.exec_cmd, "lli ");
        ascii_append_byte(stasis.exec_cmd, 34); // '"'
        ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
        ascii_append_byte(stasis.exec_cmd, 34); // '"'
        let lli_exit: i32 = sys_exec(stasis.exec_cmd);
        // `sys_exec` returns 127 when the command is missing; fall back to clang in that case.
        if (lli_exit != 127) {
            return lli_exit;
        }
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    return sys_exec(stasis.exec_cmd);
}

function test_run_dir(root_dir: ascii[]): i32 {
    let rc: i32 = test_collect_stasis_files(root_dir);
    if (rc != 0) { return rc; }

    let failed_files: i32 = 0;
    let total_failures: i32 = 0;

    let i: i32 = 0;
    for (i = 0; i < stasis.test_files_count; i = i + 1) {
        if (!test_pool_copy_to(stasis.arg_entry, stasis.test_files_off[i], stasis.test_files_len[i])) {
            print_string("error: failed to copy test file path\n");
            return 1;
        }

        if (stasis.quiet == 0) {
            print_string("test: ");
            print_string(stasis.arg_entry);
            print_char(10);
        }

        let exit_code: i32 = test_run_file(stasis.arg_entry, i);
        if (exit_code != 0) {
            failed_files = failed_files + 1;
            total_failures = total_failures + exit_code;
        }
    }

    if (stasis.quiet == 0) {
        print_string("test summary: files=");
        print_int(stasis.test_files_count);
        print_string(" failed_files=");
        print_int(failed_files);
        print_string(" failures=");
        print_int(total_failures);
        print_char(10);
    }

    if (failed_files != 0) { return 1; }
    return 0;
}

function test_run_path(path: ascii[]): i32 {
    if (ascii_ends_with_lit(path, ".stasis")) {
        if (stasis.quiet == 0) {
            print_string("test: ");
            print_string(path);
            print_char(10);
        }
        return test_run_file(path, 0);
    }
    return test_run_dir(path);
}
