import "../stdlib/stdlib.stasis";
import "state.stasis";

function sh_ir_append_i32(dst: ascii[], v: i32): void {
    if (v == 0) {
        ascii_append_byte(dst, 48);
        return;
    }
    if (v == -2147483648) {
        ascii_append(dst, "-2147483648");
        return;
    }

    let n: i32 = v;
    if (n < 0) {
        ascii_append_byte(dst, 45); // '-'
        n = 0 - n;
    }

    let div: i32 = 1;
    for (; n / div >= 10; ) {
        div = div * 10;
    }

    for (; div > 0; ) {
        let d: i32 = n / div;
        ascii_append_byte(dst, ascii_from_digit(d));
        n = n - d * div;
        div = div / 10;
    }
}

function sh_emit_clif_main_return_i32(module_name: ascii[], value: i32): void {
    ascii_clear(sh.ir_out);

    ascii_append(sh.ir_out, "; Cranelift module: ");
    ascii_append(sh.ir_out, module_name);
    ascii_append_byte(sh.ir_out, 10);
    ascii_append(sh.ir_out, "; Generated by Stasis compiler\n\n");
    ascii_append(sh.ir_out, "; === Functions ===\n");

    ascii_append(sh.ir_out, "function %");
    ascii_append(sh.ir_out, module_name);
    ascii_append(sh.ir_out, "__main() -> i32 windows_fastcall {\n");
    ascii_append(sh.ir_out, "block0():\n");
    ascii_append(sh.ir_out, "    v0 = iconst.i32 ");
    sh_ir_append_i32(sh.ir_out, value);
    ascii_append_byte(sh.ir_out, 10);
    ascii_append(sh.ir_out, "    return v0\n");
    ascii_append(sh.ir_out, "}\n\n");
}

function sh_emit_llvm_main_return_i32(module_name: ascii[], value: i32): void {
    ascii_clear(sh.ir_out);

    ascii_append(sh.ir_out, "; ModuleID = '");
    ascii_append(sh.ir_out, module_name);
    ascii_append(sh.ir_out, "'\n");

    ascii_append(sh.ir_out, "source_filename = ");
    ascii_append_byte(sh.ir_out, 34); // '"'
    ascii_append(sh.ir_out, module_name);
    ascii_append_byte(sh.ir_out, 34); // '"'
    ascii_append_byte(sh.ir_out, 10);

    ascii_append(sh.ir_out, "target triple = ");
    ascii_append_byte(sh.ir_out, 34); // '"'
    ascii_append(sh.ir_out, "x86_64-pc-windows-msvc");
    ascii_append_byte(sh.ir_out, 34); // '"'
    ascii_append(sh.ir_out, "\n\n");

    ascii_append(sh.ir_out, "define i32 @main() {\n");
    ascii_append(sh.ir_out, "entry:\n");
    ascii_append(sh.ir_out, "  ret i32 ");
    sh_ir_append_i32(sh.ir_out, value);
    ascii_append(sh.ir_out, "\n}\n");
}

