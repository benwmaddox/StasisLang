import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "parsing.stasis";
import "signatures.stasis";
import "modules.stasis";
import "stmt_parse.stasis";
import "build_ir.stasis";

function usage(): void {
    print_string("stasis (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasis check [--quiet] <entry.stasis>\n");
    print_string("  stasis build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("  stasis release [--quiet] [--module <name>] --out <path> <entry.stasis>\n");
    print_string("  stasis watch check [--quiet] <entry.stasis>\n");
    print_string("  stasis watch build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis watch run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage: import graph + lexer + minimal parsing (balance check) + decl scan + minimal build/run/release.\n");
}

function read_arg(idx: i32, out: ascii[], cap: i32): bool {
    let n: i32 = sys_argv(idx, out, cap);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(out, n);
    return true;
}

function ir_needs_graphics_runtime(): bool {
    // Only link graphics when it is actually called (declares alone should not trigger linking).
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_init_window")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_begin_frame")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_end_frame")) { return true; }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_should_quit")) { return true; }

    if (ascii_contains(stasis.ir_out, "call i32 @stasis_get_time_ms")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_sleep_ms")) { return true; }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_is_key_down")) { return true; }

    if (ascii_contains(stasis.ir_out, "call void @stasis_clear")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_draw_line")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_draw_lines_f32")) { return true; }

    if (ascii_contains(stasis.ir_out, "call i32 @stasis_gfx_load_sprite")) { return true; }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_gfx_poll_reload")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_gfx_draw_sprite")) { return true; }
    if (ascii_contains(stasis.ir_out, "call void @stasis_gfx_draw_sprites_i32")) { return true; }

    return false;
}

function append_graphics_static_link_inputs(): bool {
    // Static graphics bundle from `runtime/build.bat` (includes dependency libs in the same folder).
    path_join(stasis.scratch_graphics, stasis.scratch_dir, "../runtime/build/Release");

    path_join(stasis.scratch_graphics_dll, stasis.scratch_graphics, "stasis_graphics_static.lib");
    if (!sys_file_exists(stasis.scratch_graphics_dll)) {
        print_string("error: missing graphics runtime: ");
        print_string(stasis.scratch_graphics_dll);
        print_char(10);
        print_string("hint: build the graphics runtime (e.g. run `runtime/build.bat`) to produce runtime/build/Release/stasis_graphics_static.lib\n");
        return false;
    }

    // Main static graphics lib
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_graphics_dll);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    // Dependency libs (copied by runtime/build.bat).
    path_join(stasis.scratch_graphics_dll, stasis.scratch_graphics, "SDL2main.lib");
    if (!sys_file_exists(stasis.scratch_graphics_dll)) {
        print_string("error: missing graphics dependency: ");
        print_string(stasis.scratch_graphics_dll);
        print_char(10);
        return false;
    }
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.scratch_graphics_dll);
    ascii_append_byte(stasis.exec_cmd, 34);

    path_join(stasis.scratch_graphics_dll, stasis.scratch_graphics, "SDL2-static.lib");
    if (!sys_file_exists(stasis.scratch_graphics_dll)) {
        print_string("error: missing graphics dependency: ");
        print_string(stasis.scratch_graphics_dll);
        print_char(10);
        return false;
    }
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.scratch_graphics_dll);
    ascii_append_byte(stasis.exec_cmd, 34);

    path_join(stasis.scratch_graphics_dll, stasis.scratch_graphics, "libglew32.lib");
    if (!sys_file_exists(stasis.scratch_graphics_dll)) {
        print_string("error: missing graphics dependency: ");
        print_string(stasis.scratch_graphics_dll);
        print_char(10);
        return false;
    }
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.scratch_graphics_dll);
    ascii_append_byte(stasis.exec_cmd, 34);

    path_join(stasis.scratch_graphics_dll, stasis.scratch_graphics, "OpenGL32.Lib");
    if (!sys_file_exists(stasis.scratch_graphics_dll)) {
        print_string("error: missing graphics dependency: ");
        print_string(stasis.scratch_graphics_dll);
        print_char(10);
        return false;
    }
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.scratch_graphics_dll);
    ascii_append_byte(stasis.exec_cmd, 34);

    path_join(stasis.scratch_graphics_dll, stasis.scratch_graphics, "GlU32.Lib");
    if (!sys_file_exists(stasis.scratch_graphics_dll)) {
        print_string("error: missing graphics dependency: ");
        print_string(stasis.scratch_graphics_dll);
        print_char(10);
        return false;
    }
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.scratch_graphics_dll);
    ascii_append_byte(stasis.exec_cmd, 34);

    // Windows SDK / system libs needed by SDL2 + OpenGL + input.
    ascii_append(stasis.exec_cmd, " -luser32 -lgdi32 -limm32 -lshell32 -lsetupapi -lwinmm -lversion -lole32 -loleaut32 -ladvapi32 -lcfgmgr32 -lbcrypt");

    return true;
}

function watch_check(entry_path: ascii[]): i32 {
    print_string("watch: check (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = load_graph(entry_path);
    if (rc == 0) {
        rc = check_loaded_files();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = load_graph(entry_path);
            if (rc == 0) {
                rc = check_loaded_files();
            }
        }
    }

    return rc;
}

function check_loaded_files(): i32 {
    stasis.parse_quiet = stasis.quiet;
    let lex_errors: i32 = 0;
    let parse_errors: i32 = 0;
    let sig_errors: i32 = 0;
    let stmt_errors: i32 = 0;
    let import_collisions: i32 = 0;

    let i: i32 = 0;
    for (i = 0; i < stasis.file_count; i = i + 1) {
        parse_errors = parse_errors + parse_balance_file(i);
        lex_errors = lex_errors + stasis.lex_error_count;
    }

    sig_errors = sig_scan_loaded_files();
    stmt_errors = stmt_parse_loaded_files();
    import_collisions = check_import_member_collisions();

    print_string("check: files=");
    print_int(stasis.file_count);
    print_string(" lex_errors=");
    print_int(lex_errors);
    print_string(" parse_errors=");
    print_int(parse_errors);
    print_string(" sig_errors=");
    print_int(sig_errors);
    print_string(" stmt_errors=");
    print_int(stmt_errors);
    print_string(" import_collisions=");
    print_int(import_collisions);
    print_char(10);

    if (lex_errors != 0) { return 1; }
    if (parse_errors != 0) { return 1; }
    if (sig_errors != 0) { return 1; }
    if (stmt_errors != 0) { return 1; }
    return 0;
}

function cmd_build(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) {
        return rc;
    }

    if (stasis.emit_ir != 0) {
        if (!sys_write_file(stasis.arg_out, stasis.ir_out, ascii_len(stasis.ir_out))) {
            print_string("error: failed to write output: ");
            print_string(stasis.arg_out);
            print_char(10);
            return 1;
        }

        if (stasis.quiet == 0) {
            print_string("built ir: ");
            print_string(stasis.arg_out);
            print_char(10);
        }
        return 0;
    }

    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: build to exe currently supports --backend llvm only (use --emit-ir for cranelift)\n");
        return 1;
    }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_build.ll");
    path_join(stasis.scratch_runtime, stasis.scratch_dir, "../runtime/stasis_sys.c");

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_runtime);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (ir_needs_graphics_runtime()) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.arg_out);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = sys_exec(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (stasis.quiet == 0) {
        print_string("built: ");
        print_string(stasis.arg_out);
        print_char(10);
    }
    return exit_code;
}

function cmd_run(): i32 {
    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: run currently supports --backend llvm only\n");
        return 1;
    }

    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) {
        return rc;
    }

    // Write temp IR next to the stasis executable (no cwd syscall yet).
    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_run.ll");
    path_join(stasis.scratch_exe, stasis.scratch_dir, "stasis_run.exe");
    path_join(stasis.scratch_runtime, stasis.scratch_dir, "../runtime/stasis_sys.c");

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_runtime);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (ir_needs_graphics_runtime()) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = sys_exec(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    return sys_exec(stasis.exec_cmd);
}

function cmd_release(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(stasis.arg_module, "llvm");
    if (rc != 0) {
        return rc;
    }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_release.ll");
    path_join(stasis.scratch_runtime, stasis.scratch_dir, "../runtime/stasis_sys.c");

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wno-override-module -O3 ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, " ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_runtime);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (ir_needs_graphics_runtime()) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.arg_out);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = sys_exec(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
