import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "parsing.stasis";
import "signatures.stasis";
import "modules.stasis";
import "stmt_parse.stasis";
import "build_ir.stasis";

function usage(): void {
    print_string("stasis (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasis check [--quiet] <entry.stasis>\n");
    print_string("  stasis build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("  stasis release [--quiet] [--module <name>] --out <path> <entry.stasis>\n");
    print_string("  stasis watch check [--quiet] <entry.stasis>\n");
    print_string("  stasis watch build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis watch run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage: import graph + lexer + minimal parsing (balance check) + decl scan + minimal build/run/release.\n");
}

function read_arg(idx: i32, out: ascii[], cap: i32): bool {
    let n: i32 = sys_argv(idx, out, cap);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(out, n);
    return true;
}

function watch_check(entry_path: ascii[]): i32 {
    print_string("watch: check (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = load_graph(entry_path);
    if (rc == 0) {
        rc = check_loaded_files();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = load_graph(entry_path);
            if (rc == 0) {
                rc = check_loaded_files();
            }
        }
    }

    return rc;
}

function check_loaded_files(): i32 {
    st.parse_quiet = st.quiet;
    let lex_errors: i32 = 0;
    let parse_errors: i32 = 0;
    let sig_errors: i32 = 0;
    let stmt_errors: i32 = 0;
    let import_collisions: i32 = 0;

    let i: i32 = 0;
    for (i = 0; i < st.file_count; i = i + 1) {
        parse_errors = parse_errors + parse_balance_file(i);
        lex_errors = lex_errors + st.lex_error_count;
    }

    sig_errors = sig_scan_loaded_files();
    stmt_errors = stmt_parse_loaded_files();
    import_collisions = check_import_member_collisions();

    print_string("check: files=");
    print_int(st.file_count);
    print_string(" lex_errors=");
    print_int(lex_errors);
    print_string(" parse_errors=");
    print_int(parse_errors);
    print_string(" sig_errors=");
    print_int(sig_errors);
    print_string(" stmt_errors=");
    print_int(stmt_errors);
    print_string(" import_collisions=");
    print_int(import_collisions);
    print_char(10);

    if (lex_errors != 0) { return 1; }
    if (parse_errors != 0) { return 1; }
    if (sig_errors != 0) { return 1; }
    if (stmt_errors != 0) { return 1; }
    return 0;
}

function cmd_build(): i32 {
    let rc: i32 = load_graph(st.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(st.arg_module, st.arg_backend);
    if (rc != 0) {
        return rc;
    }

    if (st.emit_ir != 0) {
        if (!sys_write_file(st.arg_out, st.ir_out, ascii_len(st.ir_out))) {
            print_string("error: failed to write output: ");
            print_string(st.arg_out);
            print_char(10);
            return 1;
        }

        if (st.quiet == 0) {
            print_string("built ir: ");
            print_string(st.arg_out);
            print_char(10);
        }
        return 0;
    }

    if (!ascii_eq(st.arg_backend, "llvm")) {
        print_string("error: build to exe currently supports --backend llvm only (use --emit-ir for cranelift)\n");
        return 1;
    }

    if (!read_arg(0, st.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(st.scratch_dir, st.scratch_import);
    path_join(st.scratch_resolved, st.scratch_dir, "stasis_build.ll");
    path_join(st.scratch_runtime, st.scratch_dir, "../runtime/stasis_sys.c");

    if (!sys_write_file(st.scratch_resolved, st.ir_out, ascii_len(st.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(st.scratch_resolved);
        print_char(10);
        return 1;
    }

    ascii_clear(st.exec_cmd);
    ascii_append(st.exec_cmd, "clang -Wno-override-module ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_resolved);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, " ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_runtime);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, " -o ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.arg_out);
    ascii_append_byte(st.exec_cmd, 34); // '"'

    let exit_code: i32 = sys_exec(st.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (st.quiet == 0) {
        print_string("built: ");
        print_string(st.arg_out);
        print_char(10);
    }
    return exit_code;
}

function cmd_run(): i32 {
    if (!ascii_eq(st.arg_backend, "llvm")) {
        print_string("error: run currently supports --backend llvm only\n");
        return 1;
    }

    let rc: i32 = load_graph(st.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(st.arg_module, st.arg_backend);
    if (rc != 0) {
        return rc;
    }

    // Write temp IR next to the stasis executable (no cwd syscall yet).
    if (!read_arg(0, st.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(st.scratch_dir, st.scratch_import);
    path_join(st.scratch_resolved, st.scratch_dir, "stasis_run.ll");
    path_join(st.scratch_exe, st.scratch_dir, "stasis_run.exe");
    path_join(st.scratch_runtime, st.scratch_dir, "../runtime/stasis_sys.c");

    if (!sys_write_file(st.scratch_resolved, st.ir_out, ascii_len(st.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(st.scratch_resolved);
        print_char(10);
        return 1;
    }

    ascii_clear(st.exec_cmd);
    ascii_append(st.exec_cmd, "clang -Wno-override-module ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_resolved);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, " ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_runtime);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, " -o ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_exe);
    ascii_append_byte(st.exec_cmd, 34); // '"'

    let exit_code: i32 = sys_exec(st.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    ascii_clear(st.exec_cmd);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_exe);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    return sys_exec(st.exec_cmd);
}

function cmd_release(): i32 {
    let rc: i32 = load_graph(st.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(st.arg_module, "llvm");
    if (rc != 0) {
        return rc;
    }

    if (!read_arg(0, st.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(st.scratch_dir, st.scratch_import);
    path_join(st.scratch_resolved, st.scratch_dir, "stasis_release.ll");
    path_join(st.scratch_runtime, st.scratch_dir, "../runtime/stasis_sys.c");

    if (!sys_write_file(st.scratch_resolved, st.ir_out, ascii_len(st.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(st.scratch_resolved);
        print_char(10);
        return 1;
    }

    ascii_clear(st.exec_cmd);
    ascii_append(st.exec_cmd, "clang -Wno-override-module -O3 ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_resolved);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, " ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.scratch_runtime);
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, " -o ");
    ascii_append_byte(st.exec_cmd, 34); // '"'
    ascii_append(st.exec_cmd, st.arg_out);
    ascii_append_byte(st.exec_cmd, 34); // '"'

    let exit_code: i32 = sys_exec(st.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (st.quiet == 0) {
        print_string("released: ");
        print_string(st.arg_out);
        print_char(10);
    }
    return exit_code;
}

function watch_build(): i32 {
    print_string("watch: build (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = cmd_build();

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = cmd_build();
        }
    }

    return rc;
}

function watch_run(): i32 {
    print_string("watch: run (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = cmd_run();

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = cmd_run();
        }
    }

    return rc;
}

function main(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        usage();
        return 1;
    }

    st.quiet = 0;
    let have_entry: i32 = 0;
    let have_out: i32 = 0;
    let expect_backend: i32 = 0;
    let expect_module: i32 = 0;
    let expect_out: i32 = 0;
    let i: i32 = 0;

    if (!read_arg(1, st.cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(st.cmd, "help") || ascii_eq(st.cmd, "-h") || ascii_eq(st.cmd, "--help")) {
        usage();
        return 0;
    }

    if (ascii_eq(st.cmd, "check")) {
        ascii_clear(st.arg_entry);
        have_entry = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, st.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                usage();
                return 0;
            }

            if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                st.quiet = 1;
            } else {
                if (ascii_starts_with(st.scratch_import, "-")) {
                    print_string("error: unknown option: ");
                    print_string(st.scratch_import);
                    print_char(10);
                    return 1;
                }
                if (have_entry != 0) {
                    print_string("error: check expects 1 <entry.stasis>\n");
                    usage();
                    return 1;
                }
                ascii_copy(st.arg_entry, st.scratch_import);
                have_entry = 1;
            }
        }

        if (have_entry == 0) {
            print_string("error: check expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        let rc: i32 = load_graph(st.arg_entry);
        if (rc != 0) {
            return rc;
        }
        return check_loaded_files();
    }

    if (ascii_eq(st.cmd, "build")) {
        ascii_clear(st.arg_entry);
        ascii_clear(st.arg_out);
        ascii_copy(st.arg_backend, "cranelift");
        ascii_copy(st.arg_module, "module");
        st.emit_ir = 0;
        have_entry = 0;
        have_out = 0;
        expect_backend = 0;
        expect_module = 0;
        expect_out = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, st.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(st.arg_backend, st.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(st.arg_module, st.scratch_import);
                    expect_module = 0;
                } else {
                    if (expect_out != 0) {
                        ascii_copy(st.arg_out, st.scratch_import);
                        have_out = 1;
                        expect_out = 0;
                    } else {
                        if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                            usage();
                            return 0;
                        }

                        if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                            st.quiet = 1;
                        } else {
                            if (ascii_eq(st.scratch_import, "--emit-ir")) {
                                st.emit_ir = 1;
                            } else {
                                if (ascii_eq(st.scratch_import, "--backend")) {
                                    expect_backend = 1;
                                } else {
                                    if (ascii_eq(st.scratch_import, "--module")) {
                                        expect_module = 1;
                                    } else {
                                        if (ascii_eq(st.scratch_import, "--out") || ascii_eq(st.scratch_import, "-o")) {
                                            expect_out = 1;
                                        } else {
                                            if (ascii_starts_with(st.scratch_import, "-")) {
                                                print_string("error: unknown option: ");
                                                print_string(st.scratch_import);
                                                print_char(10);
                                                return 1;
                                            }
                                            if (have_entry != 0) {
                                                print_string("error: build expects 1 <entry.stasis>\n");
                                                usage();
                                                return 1;
                                            }
                                            ascii_copy(st.arg_entry, st.scratch_import);
                                            have_entry = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0 || expect_out != 0) {
            print_string("error: build missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: build expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: build requires --out <path>\n");
            usage();
            return 1;
        }

        return cmd_build();
    }

    if (ascii_eq(st.cmd, "run")) {
        ascii_clear(st.arg_entry);
        ascii_copy(st.arg_backend, "llvm");
        ascii_copy(st.arg_module, "module");
        have_entry = 0;
        expect_backend = 0;
        expect_module = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, st.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(st.arg_backend, st.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(st.arg_module, st.scratch_import);
                    expect_module = 0;
                } else {
                    if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                        st.quiet = 1;
                    } else {
                        if (ascii_eq(st.scratch_import, "--backend")) {
                            expect_backend = 1;
                        } else {
                            if (ascii_eq(st.scratch_import, "--module")) {
                                expect_module = 1;
                            } else {
                                if (ascii_starts_with(st.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(st.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: run expects 1 <entry.stasis>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(st.arg_entry, st.scratch_import);
                                have_entry = 1;
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0) {
            print_string("error: run missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: run expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        return cmd_run();
    }

    if (ascii_eq(st.cmd, "release")) {
        ascii_clear(st.arg_entry);
        ascii_clear(st.arg_out);
        ascii_copy(st.arg_module, "module");
        have_entry = 0;
        have_out = 0;
        expect_module = 0;
        expect_out = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, st.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_module != 0) {
                ascii_copy(st.arg_module, st.scratch_import);
                expect_module = 0;
            } else {
                if (expect_out != 0) {
                    ascii_copy(st.arg_out, st.scratch_import);
                    have_out = 1;
                    expect_out = 0;
                } else {
                    if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                        st.quiet = 1;
                    } else {
                        if (ascii_eq(st.scratch_import, "--module")) {
                            expect_module = 1;
                        } else {
                            if (ascii_eq(st.scratch_import, "--out") || ascii_eq(st.scratch_import, "-o")) {
                                expect_out = 1;
                            } else {
                                if (ascii_starts_with(st.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(st.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: release expects 1 <entry.stasis>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(st.arg_entry, st.scratch_import);
                                have_entry = 1;
                            }
                        }
                    }
                }
            }
        }

        if (expect_module != 0 || expect_out != 0) {
            print_string("error: release missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: release expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: release requires --out <path>\n");
            usage();
            return 1;
        }

        return cmd_release();
    }

    if (ascii_eq(st.cmd, "watch")) {
        if (argc < 4) {
            print_string("error: watch expects a subcommand and <entry.stasis>\n");
            usage();
            return 1;
        }
        if (!read_arg(2, st.subcmd, 64)) {
            print_string("error: failed to read watch subcommand\n");
            return 1;
        }
        if (ascii_eq(st.subcmd, "check")) {
            ascii_clear(st.arg_entry);
            have_entry = 0;

            i = 0;
            for (i = 3; i < argc; i = i + 1) {
                if (!read_arg(i, st.scratch_import, 260)) {
                    print_string("error: failed to read argv[3+]\n");
                    return 1;
                }

                if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                    usage();
                    return 0;
                }

                if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                    st.quiet = 1;
                } else {
                    if (ascii_starts_with(st.scratch_import, "-")) {
                        print_string("error: unknown option: ");
                        print_string(st.scratch_import);
                        print_char(10);
                        return 1;
                    }
                    if (have_entry != 0) {
                        print_string("error: watch check expects 1 <entry.stasis>\n");
                        usage();
                        return 1;
                    }
                    ascii_copy(st.arg_entry, st.scratch_import);
                    have_entry = 1;
                }
            }

            if (have_entry == 0) {
                print_string("error: watch check expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }

            return watch_check(st.arg_entry);
        }

        if (ascii_eq(st.subcmd, "build")) {
            ascii_clear(st.arg_entry);
            ascii_clear(st.arg_out);
            ascii_copy(st.arg_backend, "cranelift");
            ascii_copy(st.arg_module, "module");
            st.emit_ir = 0;
            have_entry = 0;
            have_out = 0;
            expect_backend = 0;
            expect_module = 0;
            expect_out = 0;

            i = 0;
            for (i = 3; i < argc; i = i + 1) {
                if (!read_arg(i, st.scratch_import, 260)) {
                    print_string("error: failed to read argv[3+]\n");
                    return 1;
                }

                if (expect_backend != 0) {
                    ascii_copy(st.arg_backend, st.scratch_import);
                    expect_backend = 0;
                } else {
                    if (expect_module != 0) {
                        ascii_copy(st.arg_module, st.scratch_import);
                        expect_module = 0;
                    } else {
                        if (expect_out != 0) {
                            ascii_copy(st.arg_out, st.scratch_import);
                            have_out = 1;
                            expect_out = 0;
                        } else {
                            if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                                usage();
                                return 0;
                            }

                            if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                                st.quiet = 1;
                            } else {
                                if (ascii_eq(st.scratch_import, "--emit-ir")) {
                                    st.emit_ir = 1;
                                } else {
                                    if (ascii_eq(st.scratch_import, "--backend")) {
                                        expect_backend = 1;
                                    } else {
                                        if (ascii_eq(st.scratch_import, "--module")) {
                                            expect_module = 1;
                                        } else {
                                            if (ascii_eq(st.scratch_import, "--out") || ascii_eq(st.scratch_import, "-o")) {
                                                expect_out = 1;
                                            } else {
                                                if (ascii_starts_with(st.scratch_import, "-")) {
                                                    print_string("error: unknown option: ");
                                                    print_string(st.scratch_import);
                                                    print_char(10);
                                                    return 1;
                                                }
                                                if (have_entry != 0) {
                                                    print_string("error: watch build expects 1 <entry.stasis>\n");
                                                    usage();
                                                    return 1;
                                                }
                                                ascii_copy(st.arg_entry, st.scratch_import);
                                                have_entry = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if (expect_backend != 0 || expect_module != 0 || expect_out != 0) {
                print_string("error: watch build missing option value\n");
                return 1;
            }
            if (have_entry == 0) {
                print_string("error: watch build expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }
            if (have_out == 0) {
                print_string("error: watch build requires --out <path>\n");
                usage();
                return 1;
            }

            return watch_build();
        }

        if (ascii_eq(st.subcmd, "run")) {
            ascii_clear(st.arg_entry);
            ascii_copy(st.arg_backend, "llvm");
            ascii_copy(st.arg_module, "module");
            have_entry = 0;
            expect_backend = 0;
            expect_module = 0;

            i = 0;
            for (i = 3; i < argc; i = i + 1) {
                if (!read_arg(i, st.scratch_import, 260)) {
                    print_string("error: failed to read argv[3+]\n");
                    return 1;
                }

                if (expect_backend != 0) {
                    ascii_copy(st.arg_backend, st.scratch_import);
                    expect_backend = 0;
                } else {
                    if (expect_module != 0) {
                        ascii_copy(st.arg_module, st.scratch_import);
                        expect_module = 0;
                    } else {
                        if (ascii_eq(st.scratch_import, "-h") || ascii_eq(st.scratch_import, "--help")) {
                            usage();
                            return 0;
                        }

                        if (ascii_eq(st.scratch_import, "-q") || ascii_eq(st.scratch_import, "--quiet")) {
                            st.quiet = 1;
                        } else {
                            if (ascii_eq(st.scratch_import, "--backend")) {
                                expect_backend = 1;
                            } else {
                                if (ascii_eq(st.scratch_import, "--module")) {
                                    expect_module = 1;
                                } else {
                                    if (ascii_starts_with(st.scratch_import, "-")) {
                                        print_string("error: unknown option: ");
                                        print_string(st.scratch_import);
                                        print_char(10);
                                        return 1;
                                    }

                                    if (have_entry != 0) {
                                        print_string("error: watch run expects 1 <entry.stasis>\n");
                                        usage();
                                        return 1;
                                    }
                                    ascii_copy(st.arg_entry, st.scratch_import);
                                    have_entry = 1;
                                }
                            }
                        }
                    }
                }
            }

            if (expect_backend != 0 || expect_module != 0) {
                print_string("error: watch run missing option value\n");
                return 1;
            }
            if (have_entry == 0) {
                print_string("error: watch run expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }

            return watch_run();
        }

        print_string("error: unsupported watch subcommand: ");
        print_string(st.subcmd);
        print_char(10);
        return 1;
    }

    print_string("error: unknown command: ");
    print_string(st.cmd);
    print_char(10);
    usage();
    return 1;
}
