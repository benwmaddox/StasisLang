import "../stdlib/stdlib.stasis";
import "imports.stasis";
import "parsing.stasis";

global sh_cmd: ascii[64];
global sh_subcmd: ascii[64];
global sh_arg_entry: ascii[260];

function sh_usage(): void {
    print_string("stasis (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasis check <entry.stasis>\n");
    print_string("  stasis watch check <entry.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage: import graph + lexer + minimal parsing (balance check).\n");
}

function sh_read_arg(idx: i32, out: ascii[], cap: i32): bool {
    let n: i32 = sys_argv(idx, out, cap);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(out, n);
    return true;
}

function sh_watch_check(entry_path: ascii[]): i32 {
    print_string("watch: check (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = sh_load_graph(entry_path);
    if (rc == 0) {
        rc = sh_check_loaded_files();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (sh_any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = sh_load_graph(entry_path);
            if (rc == 0) {
                rc = sh_check_loaded_files();
            }
        }
    }

    return rc;
}

function sh_check_loaded_files(): i32 {
    let lex_errors: i32 = 0;
    let parse_errors: i32 = 0;

    let i: i32 = 0;
    for (i = 0; i < sh_file_count; i = i + 1) {
        parse_errors = parse_errors + sh_parse_balance_file(i);
        lex_errors = lex_errors + sh_lex_error_count;
    }

    print_string("check: files=");
    print_int(sh_file_count);
    print_string(" lex_errors=");
    print_int(lex_errors);
    print_string(" parse_errors=");
    print_int(parse_errors);
    print_char(10);

    if (lex_errors != 0) { return 1; }
    if (parse_errors != 0) { return 1; }
    return 0;
}

function main(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        sh_usage();
        return 1;
    }

    if (!sh_read_arg(1, sh_cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(sh_cmd, "help") || ascii_eq(sh_cmd, "-h") || ascii_eq(sh_cmd, "--help")) {
        sh_usage();
        return 0;
    }

    if (ascii_eq(sh_cmd, "check")) {
        if (argc != 3) {
            print_string("error: check expects 1 argument\n");
            sh_usage();
            return 1;
        }
        if (!sh_read_arg(2, sh_arg_entry, 260)) {
            print_string("error: failed to read <entry.stasis>\n");
            return 1;
        }

        let rc: i32 = sh_load_graph(sh_arg_entry);
        if (rc != 0) {
            return rc;
        }
        return sh_check_loaded_files();
    }

    if (ascii_eq(sh_cmd, "watch")) {
        if (argc != 4) {
            print_string("error: watch expects a subcommand and 1 argument\n");
            sh_usage();
            return 1;
        }
        if (!sh_read_arg(2, sh_subcmd, 64)) {
            print_string("error: failed to read watch subcommand\n");
            return 1;
        }
        if (!ascii_eq(sh_subcmd, "check")) {
            print_string("error: unsupported watch subcommand: ");
            print_string(sh_subcmd);
            print_char(10);
            return 1;
        }
        if (!sh_read_arg(3, sh_arg_entry, 260)) {
            print_string("error: failed to read <entry.stasis>\n");
            return 1;
        }
        return sh_watch_check(sh_arg_entry);
    }

    print_string("error: unknown command: ");
    print_string(sh_cmd);
    print_char(10);
    sh_usage();
    return 1;
}
