                                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                                    print_string("error: unknown option: ");
                                                    print_string(stasis.scratch_import);
                                                    print_char(10);
                                                    return 1;
                                                }
                                                if (have_entry2 != 0) {
                                                    print_string("error: watch build expects 1 <entry.stasis>\n");
                                                    usage();
                                                    return 1;
                                                }
                                                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                                have_entry2 = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend2 != 0 || expect_module2 != 0 || expect_out2 != 0) {
            print_string("error: watch build missing option value\n");
            return 1;
        }
        if (have_entry2 == 0) {
            print_string("error: watch build expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out2 == 0) {
            print_string("error: watch build requires --out <path>\n");
            usage();
            return 1;
        }

        return watch_build();
    }

    if (ascii_eq(stasis.subcmd, "run")) {
        ascii_clear(stasis.arg_entry);
        ascii_copy(stasis.arg_backend, "llvm");
        ascii_copy(stasis.arg_module, "module");
        stasis.use_mir = 0;

        let have_entry3: i32 = 0;
        let expect_backend3: i32 = 0;
        let expect_module3: i32 = 0;

        let i3: i32 = 0;
        for (i3 = 3; i3 < argc; i3 = i3 + 1) {
            if (!read_arg(i3, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[3+]\n");
                return 1;
            }

            if (expect_backend3 != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend3 = 0;
            } else {
                if (expect_module3 != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module3 = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--backend")) {
                                expect_backend3 = 1;
                            } else {
                                if (ascii_eq(stasis.scratch_import, "--module")) {
                                    expect_module3 = 1;
                                } else {
                                    if (ascii_starts_with(stasis.scratch_import, "-")) {
                                        print_string("error: unknown option: ");
                                        print_string(stasis.scratch_import);
                                        print_char(10);
                                        return 1;
                                    }

                                    if (have_entry3 != 0) {
                                        print_string("error: watch run expects 1 <entry.stasis>\n");
                                        usage();
                                        return 1;
                                    }
                                    ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                    have_entry3 = 1;
                                }
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend3 != 0 || expect_module3 != 0) {
            print_string("error: watch run missing option value\n");
            return 1;
        }
        if (have_entry3 == 0) {
            print_string("error: watch run expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        return watch_run();
    }

    print_string("error: unsupported watch subcommand: ");
    print_string(stasis.subcmd);
    print_char(10);
    return 1;
}

function main(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        usage();
        return 1;
    }

    stasis.quiet = 0;

    if (!read_arg(1, stasis.cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(stasis.cmd, "help") || ascii_eq(stasis.cmd, "-h") || ascii_eq(stasis.cmd, "--help")) {
        usage();
        return 0;
    }

    if (ascii_eq(stasis.cmd, "check")) { return cli_cmd_check(argc); }
    if (ascii_eq(stasis.cmd, "build")) { return cli_cmd_build(argc); }
    if (ascii_eq(stasis.cmd, "run")) { return cli_cmd_run(argc); }
    if (ascii_eq(stasis.cmd, "release")) { return cli_cmd_release(argc); }
    if (ascii_eq(stasis.cmd, "test")) { return cli_cmd_test(argc); }
    if (ascii_eq(stasis.cmd, "watch")) { return cli_cmd_watch(argc); }

    print_string("error: unknown command: ");
    print_string(stasis.cmd);
    print_char(10);
    usage();
    return 1;
}
