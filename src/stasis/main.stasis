import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "parsing.stasis";
import "signatures.stasis";
import "modules.stasis";
import "build_ir.stasis";

function sh_usage(): void {
    print_string("stasis (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasis check [--quiet] <entry.stasis>\n");
    print_string("  stasis build [--quiet] [--backend cranelift|llvm] [--module <name>] --emit-ir --out <path> <entry.stasis>\n");
    print_string("  stasis run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("  stasis watch check [--quiet] <entry.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage: import graph + lexer + minimal parsing (balance check) + decl scan + minimal IR build/run.\n");
}

function sh_read_arg(idx: i32, out: ascii[], cap: i32): bool {
    let n: i32 = sys_argv(idx, out, cap);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(out, n);
    return true;
}

function sh_watch_check(entry_path: ascii[]): i32 {
    print_string("watch: check (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = sh_load_graph(entry_path);
    if (rc == 0) {
        rc = sh_check_loaded_files();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (sh_any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = sh_load_graph(entry_path);
            if (rc == 0) {
                rc = sh_check_loaded_files();
            }
        }
    }

    return rc;
}

function sh_check_loaded_files(): i32 {
    sh.parse_quiet = sh.quiet;
    let lex_errors: i32 = 0;
    let parse_errors: i32 = 0;
    let sig_errors: i32 = 0;
    let import_collisions: i32 = 0;

    let i: i32 = 0;
    for (i = 0; i < sh.file_count; i = i + 1) {
        parse_errors = parse_errors + sh_parse_balance_file(i);
        lex_errors = lex_errors + sh.lex_error_count;
    }

    sig_errors = sh_sig_scan_loaded_files();
    import_collisions = sh_check_import_member_collisions();

    print_string("check: files=");
    print_int(sh.file_count);
    print_string(" lex_errors=");
    print_int(lex_errors);
    print_string(" parse_errors=");
    print_int(parse_errors);
    print_string(" sig_errors=");
    print_int(sig_errors);
    print_string(" import_collisions=");
    print_int(import_collisions);
    print_char(10);

    if (lex_errors != 0) { return 1; }
    if (parse_errors != 0) { return 1; }
    if (sig_errors != 0) { return 1; }
    return 0;
}

function main(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        sh_usage();
        return 1;
    }

    sh.quiet = 0;

    if (!sh_read_arg(1, sh.cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(sh.cmd, "help") || ascii_eq(sh.cmd, "-h") || ascii_eq(sh.cmd, "--help")) {
        sh_usage();
        return 0;
    }

    if (ascii_eq(sh.cmd, "check")) {
        ascii_clear(sh.arg_entry);
        let have_entry: i32 = 0;

        let i: i32 = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!sh_read_arg(i, sh.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (ascii_eq(sh.scratch_import, "-h") || ascii_eq(sh.scratch_import, "--help")) {
                sh_usage();
                return 0;
            }

            if (ascii_eq(sh.scratch_import, "-q") || ascii_eq(sh.scratch_import, "--quiet")) {
                sh.quiet = 1;
            } else {
                if (ascii_starts_with(sh.scratch_import, "-")) {
                    print_string("error: unknown option: ");
                    print_string(sh.scratch_import);
                    print_char(10);
                    return 1;
                }
                if (have_entry != 0) {
                    print_string("error: check expects 1 <entry.stasis>\n");
                    sh_usage();
                    return 1;
                }
                ascii_copy(sh.arg_entry, sh.scratch_import);
                have_entry = 1;
            }
        }

        if (have_entry == 0) {
            print_string("error: check expects 1 <entry.stasis>\n");
            sh_usage();
            return 1;
        }

        let rc: i32 = sh_load_graph(sh.arg_entry);
        if (rc != 0) {
            return rc;
        }
        return sh_check_loaded_files();
    }

    if (ascii_eq(sh.cmd, "build")) {
        ascii_clear(sh.arg_entry);
        ascii_clear(sh.arg_out);
        ascii_copy(sh.arg_backend, "cranelift");
        ascii_copy(sh.arg_module, "module");
        sh.emit_ir = 0;
        let have_entry: i32 = 0;
        let have_out: i32 = 0;
        let expect_backend: i32 = 0;
        let expect_module: i32 = 0;
        let expect_out: i32 = 0;

        let i: i32 = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!sh_read_arg(i, sh.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(sh.arg_backend, sh.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(sh.arg_module, sh.scratch_import);
                    expect_module = 0;
                } else {
                    if (expect_out != 0) {
                        ascii_copy(sh.arg_out, sh.scratch_import);
                        have_out = 1;
                        expect_out = 0;
                    } else {
                        if (ascii_eq(sh.scratch_import, "-h") || ascii_eq(sh.scratch_import, "--help")) {
                            sh_usage();
                            return 0;
                        }

                        if (ascii_eq(sh.scratch_import, "-q") || ascii_eq(sh.scratch_import, "--quiet")) {
                            sh.quiet = 1;
                        } else {
                            if (ascii_eq(sh.scratch_import, "--emit-ir")) {
                                sh.emit_ir = 1;
                            } else {
                                if (ascii_eq(sh.scratch_import, "--backend")) {
                                    expect_backend = 1;
                                } else {
                                    if (ascii_eq(sh.scratch_import, "--module")) {
                                        expect_module = 1;
                                    } else {
                                        if (ascii_eq(sh.scratch_import, "--out") || ascii_eq(sh.scratch_import, "-o")) {
                                            expect_out = 1;
                                        } else {
                                            if (ascii_starts_with(sh.scratch_import, "-")) {
                                                print_string("error: unknown option: ");
                                                print_string(sh.scratch_import);
                                                print_char(10);
                                                return 1;
                                            }
                                            if (have_entry != 0) {
                                                print_string("error: build expects 1 <entry.stasis>\n");
                                                sh_usage();
                                                return 1;
                                            }
                                            ascii_copy(sh.arg_entry, sh.scratch_import);
                                            have_entry = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0 || expect_out != 0) {
            print_string("error: build missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: build expects 1 <entry.stasis>\n");
            sh_usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: build requires --out <path>\n");
            sh_usage();
            return 1;
        }
        if (sh.emit_ir == 0) {
            print_string("error: build is currently IR-only; pass --emit-ir\n");
            return 1;
        }

        let rc: i32 = sh_load_graph(sh.arg_entry);
        if (rc != 0) {
            return rc;
        }
        rc = sh_check_loaded_files();
        if (rc != 0) {
            return rc;
        }

        rc = sh_emit_main_return_i32_ir(sh.arg_module, sh.arg_backend);
        if (rc != 0) {
            return rc;
        }

        if (!sys_write_file(sh.arg_out, sh.ir_out, ascii_len(sh.ir_out))) {
            print_string("error: failed to write output: ");
            print_string(sh.arg_out);
            print_char(10);
            return 1;
        }

        if (sh.quiet == 0) {
            print_string("built ir: ");
            print_string(sh.arg_out);
            print_char(10);
        }
        return 0;
    }

    if (ascii_eq(sh.cmd, "run")) {
        ascii_clear(sh.arg_entry);
        ascii_copy(sh.arg_backend, "llvm");
        ascii_copy(sh.arg_module, "module");
        let have_entry: i32 = 0;
        let expect_backend: i32 = 0;
        let expect_module: i32 = 0;

        let i: i32 = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!sh_read_arg(i, sh.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(sh.arg_backend, sh.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(sh.arg_module, sh.scratch_import);
                    expect_module = 0;
                } else {
                    if (ascii_eq(sh.scratch_import, "-h") || ascii_eq(sh.scratch_import, "--help")) {
                        sh_usage();
                        return 0;
                    }

                    if (ascii_eq(sh.scratch_import, "-q") || ascii_eq(sh.scratch_import, "--quiet")) {
                        sh.quiet = 1;
                    } else {
                        if (ascii_eq(sh.scratch_import, "--backend")) {
                            expect_backend = 1;
                        } else {
                            if (ascii_eq(sh.scratch_import, "--module")) {
                                expect_module = 1;
                            } else {
                                if (ascii_starts_with(sh.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(sh.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: run expects 1 <entry.stasis>\n");
                                    sh_usage();
                                    return 1;
                                }
                                ascii_copy(sh.arg_entry, sh.scratch_import);
                                have_entry = 1;
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0) {
            print_string("error: run missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: run expects 1 <entry.stasis>\n");
            sh_usage();
            return 1;
        }
        if (!ascii_eq(sh.arg_backend, "llvm")) {
            print_string("error: run currently supports --backend llvm only\n");
            return 1;
        }

        let rc: i32 = sh_load_graph(sh.arg_entry);
        if (rc != 0) {
            return rc;
        }
        rc = sh_check_loaded_files();
        if (rc != 0) {
            return rc;
        }

        rc = sh_emit_main_return_i32_ir(sh.arg_module, sh.arg_backend);
        if (rc != 0) {
            return rc;
        }

        // Write temp IR next to the stasis executable (no cwd syscall yet).
        if (!sh_read_arg(0, sh.scratch_import, 260)) {
            print_string("error: failed to read argv[0]\n");
            return 1;
        }
        sh_path_dirname(sh.scratch_dir, sh.scratch_import);
        sh_path_join(sh.scratch_resolved, sh.scratch_dir, "stasis_run.ll");

        if (!sys_write_file(sh.scratch_resolved, sh.ir_out, ascii_len(sh.ir_out))) {
            print_string("error: failed to write temp ir: ");
            print_string(sh.scratch_resolved);
            print_char(10);
            return 1;
        }

        ascii_clear(sh.exec_cmd);
        ascii_append(sh.exec_cmd, "lli ");
        ascii_append_byte(sh.exec_cmd, 34); // '"'
        ascii_append(sh.exec_cmd, sh.scratch_resolved);
        ascii_append_byte(sh.exec_cmd, 34); // '"'
        return sys_exec(sh.exec_cmd);
    }

    if (ascii_eq(sh.cmd, "watch")) {
        if (argc < 4) {
            print_string("error: watch expects a subcommand and <entry.stasis>\n");
            sh_usage();
            return 1;
        }
        if (!sh_read_arg(2, sh.subcmd, 64)) {
            print_string("error: failed to read watch subcommand\n");
            return 1;
        }
        if (!ascii_eq(sh.subcmd, "check")) {
            print_string("error: unsupported watch subcommand: ");
            print_string(sh.subcmd);
            print_char(10);
            return 1;
        }
        ascii_clear(sh.arg_entry);
        let have_entry: i32 = 0;

        let i: i32 = 0;
        for (i = 3; i < argc; i = i + 1) {
            if (!sh_read_arg(i, sh.scratch_import, 260)) {
                print_string("error: failed to read argv[3+]\n");
                return 1;
            }

            if (ascii_eq(sh.scratch_import, "-h") || ascii_eq(sh.scratch_import, "--help")) {
                sh_usage();
                return 0;
            }

            if (ascii_eq(sh.scratch_import, "-q") || ascii_eq(sh.scratch_import, "--quiet")) {
                sh.quiet = 1;
            } else {
                if (ascii_starts_with(sh.scratch_import, "-")) {
                    print_string("error: unknown option: ");
                    print_string(sh.scratch_import);
                    print_char(10);
                    return 1;
                }
                if (have_entry != 0) {
                    print_string("error: watch check expects 1 <entry.stasis>\n");
                    sh_usage();
                    return 1;
                }
                ascii_copy(sh.arg_entry, sh.scratch_import);
                have_entry = 1;
            }
        }

        if (have_entry == 0) {
            print_string("error: watch check expects 1 <entry.stasis>\n");
            sh_usage();
            return 1;
        }

        return sh_watch_check(sh.arg_entry);
    }

    print_string("error: unknown command: ");
    print_string(sh.cmd);
    print_char(10);
    sh_usage();
    return 1;
}
