function usage(): void {
    print_string("stasis (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasis check [--quiet] <entry.stasis>\n");
    print_string("  stasis build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("  stasis release [--quiet] [--module <name>] --out <path> <entry.stasis>\n");
    print_string("  stasis test [--quiet] [--backend llvm] [--module <name>] <dir-or-file.stasis>\n");
    print_string("  stasis watch check [--quiet] <entry.stasis>\n");
    print_string("  stasis watch build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis watch run [--quiet] [--backend llvm] [--module <name>] [--fps <n>] <entry.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage: import graph + lexer + minimal parsing (balance check) + decl scan + minimal build/run/release.\n");
}

function cli_parse_i32(src: ascii[]): i32 {
    let len: i32 = ascii_len(src);
    if (len <= 0) { return 0; }

    let i: i32 = 0;
    let neg: bool = false;
    if (src[0] == 45) { // '-'
        neg = true;
        i = 1;
    }

    let v: i32 = 0;
    let done: bool = false;
    for (i = i; i < len && !done; i = i + 1) {
        let b: u8 = src[i];
        if (!ascii_is_digit(b)) {
            done = true;
        } else {
            v = v * 10 + ascii_to_digit(b);
        }
    }

    if (neg) { return 0 - v; }
    return v;
}

function hotswap_try_find_runner_path(dst: ascii[]): bool {
    ascii_clear(dst);

    if (!read_arg(0, stasis.scratch_import, 260)) {
        return false;
    }

    // Prefer repo-root relative lookups, otherwise fall back to exe-dir relative.
    path_dirname(stasis.scratch_dir, stasis.scratch_import);

    let root_ok: bool = false;
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "src/stasis/state.stasis");
    if (sys_file_exists(stasis.scratch_resolved)) {
        ascii_copy(stasis.scratch_resolved, stasis.scratch_dir);
        root_ok = true;
    } else {
        path_dirname(stasis.scratch_resolved, stasis.scratch_dir);
        if (!ascii_is_empty(stasis.scratch_resolved)) {
            path_join(stasis.scratch_import, stasis.scratch_resolved, "src/stasis/state.stasis");
            if (sys_file_exists(stasis.scratch_import)) {
                root_ok = true;
            }
        }
    }

    if (root_ok) {
        // stasis.scratch_resolved holds repo root
        path_join(dst, stasis.scratch_resolved, "runtime/build/bin/Release/stasis_runner.exe");
        if (sys_file_exists(dst)) {
            return true;
        }
    }

    path_join(dst, stasis.scratch_dir, "../runtime/build/bin/Release/stasis_runner.exe");
    return sys_file_exists(dst);
}

function hotswap_prepare_paths(entry_path: ascii[]): bool {
    if (!module_name_from_path(stasis.scratch_mod, entry_path)) {
        return false;
    }

    // Resolve repo root to ensure absolute paths (runner changes cwd to the DLL directory).
    if (!read_arg(0, stasis.scratch_import, 260)) {
        return false;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    ascii_copy(stasis.scratch_resolved, stasis.scratch_dir);

    path_join(stasis.scratch_import, stasis.scratch_resolved, "src/stasis/state.stasis");
    if (!sys_file_exists(stasis.scratch_import)) {
        path_dirname(stasis.scratch_resolved, stasis.scratch_dir);
        path_join(stasis.scratch_import, stasis.scratch_resolved, "src/stasis/state.stasis");
        if (!sys_file_exists(stasis.scratch_import)) {
            // Best-effort fallback: use exe dir as base.
            ascii_copy(stasis.scratch_resolved, stasis.scratch_dir);
        }
    }

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "build/hotstate/");
    ascii_append(stasis.scratch_import, stasis.scratch_mod);
    ascii_append_byte(stasis.scratch_import, 46);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, ".swap");
    path_join(stasis.watch_hot_swap_file, stasis.scratch_resolved, stasis.scratch_import);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "build/hotstate/");
    ascii_append(stasis.scratch_import, stasis.scratch_mod);
    ascii_append_byte(stasis.scratch_import, 46);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, ".hotswap.ll");
    path_join(stasis.watch_hot_ir_path, stasis.scratch_resolved, stasis.scratch_import);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "build/hotstate/");
    ascii_append(stasis.scratch_import, stasis.scratch_mod);
    ascii_append_byte(stasis.scratch_import, 46);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, ".swapA.dll");
    path_join(stasis.watch_hot_dll_a, stasis.scratch_resolved, stasis.scratch_import);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "build/hotstate/");
    ascii_append(stasis.scratch_import, stasis.scratch_mod);
    ascii_append_byte(stasis.scratch_import, 46);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, ".swapB.dll");
    path_join(stasis.watch_hot_dll_b, stasis.scratch_resolved, stasis.scratch_import);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "build/hotstate/");
    ascii_append(stasis.scratch_import, stasis.scratch_mod);
    ascii_append_byte(stasis.scratch_import, 46);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, ".runner.out.log");
    path_join(stasis.watch_hot_log_out, stasis.scratch_resolved, stasis.scratch_import);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, "build/hotstate/");
    ascii_append(stasis.scratch_import, stasis.scratch_mod);
    ascii_append_byte(stasis.scratch_import, 46);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, ".runner.err.log");
    path_join(stasis.watch_hot_log_err, stasis.scratch_resolved, stasis.scratch_import);

    return true;
}

function hotswap_write_swap_file(dll_path: ascii[]): bool {
    let t0: i32 = sys_time_ms();

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, dll_path);
    ascii_append_byte(stasis.exec_cmd, 10);

    let ok: bool = sys_write_file(stasis.watch_hot_swap_file, stasis.exec_cmd, ascii_len(stasis.exec_cmd));
    stasis.watch_hot_ms_swap_write = sys_time_ms() - t0;
    return ok;
}

function hot_bytes_contains_ok_from(buf: u8[], len: i32, start: i32): bool {
    // Search for ASCII "HOTSWAP ok:" in an arbitrary byte buffer.
    let i: i32 = 0;
    if (start < 0) { start = 0; }
    if (start > len) { start = len; }

    for (i = start; i + 10 < len; i = i + 1) {
        if (buf[i] == 72 && buf[i + 1] == 79 && buf[i + 2] == 84 && buf[i + 3] == 83 && buf[i + 4] == 87 && buf[i + 5] == 65 && buf[i + 6] == 80 && buf[i + 7] == 32 && buf[i + 8] == 111 && buf[i + 9] == 107 && buf[i + 10] == 58) {
            return true;
        }
    }
    return false;
}

function hotswap_wait_for_runner_ok(start_ms: i32, prev_err_size: i32): i32 {
    // Returns end-to-end swap latency in ms, or <0 on timeout.
    let deadline: i32 = start_ms + 5000;
    let saw_growth: bool = false;

    for (; sys_time_ms() < deadline; ) {
        let sz: i32 = sys_file_size(stasis.watch_hot_log_err);
        if (sz > prev_err_size) {
            saw_growth = true;
            let n: i32 = sys_read_file(stasis.watch_hot_log_err, stasis.read, 1048577);
            if (n > 0) {
                // Only scan bytes appended since `prev_err_size` so older "ok" lines don't short-circuit.
                if (hot_bytes_contains_ok_from(stasis.read, n, prev_err_size)) {
                    return sys_time_ms() - start_ms;
                }
            }
            // Advance to the new size so we keep scanning forward until the runner prints "ok".
            prev_err_size = sz;
        }
        sys_sleep_ms(5);
    }

    if (saw_growth) { return -2; }
    return -1;
}

function hotswap_build_dll_after_check(dll_out: ascii[]): i32 {
    let tick_idx: i32 = build_find_entry_tick();
    if (tick_idx < 0) {
        print_string("error: watch run hot swap requires entry function 'tick' in entry file\n");
        return 1;
    }
    if (stasis.funcs[tick_idx].body_start < 0) {
        print_string("error: watch run hot swap requires a body for entry function 'tick'\n");
        return 1;
    }

    let t_total0: i32 = sys_time_ms();

    stasis.llvm_emit_native_main = 0;
    let t_emit0: i32 = sys_time_ms();
    let rc: i32 = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    stasis.watch_hot_ms_emit = sys_time_ms() - t_emit0;
    if (rc != 0) {
        stasis.watch_hot_ms_total = sys_time_ms() - t_total0;
        return rc;
    }

    if (!sys_write_file(stasis.watch_hot_ir_path, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write hot IR: ");
        print_string(stasis.watch_hot_ir_path);
        print_char(10);
        stasis.watch_hot_ms_total = sys_time_ms() - t_total0;
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    let t_link0: i32 = sys_time_ms();

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -shared -Wl,/NOLOGO -Wno-override-module -O3 ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.watch_hot_ir_path);
    ascii_append_byte(stasis.exec_cmd, 34);

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            stasis.watch_hot_ms_total = sys_time_ms() - t_total0;
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_link_inputs()) {
            stasis.watch_hot_ms_total = sys_time_ms() - t_total0;
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, dll_out);
    ascii_append_byte(stasis.exec_cmd, 34);

    ascii_append(stasis.exec_cmd, " -Wl,/EXPORT:");
    ascii_append(stasis.exec_cmd, stasis.arg_module);
    ascii_append(stasis.exec_cmd, "__main");
    ascii_append(stasis.exec_cmd, " -Wl,/EXPORT:");
    ascii_append(stasis.exec_cmd, stasis.arg_module);
    ascii_append(stasis.exec_cmd, "__tick");

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    stasis.watch_hot_ms_link = sys_time_ms() - t_link0;
    stasis.watch_hot_ms_total = sys_time_ms() - t_total0;
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    return 0;
}

function hotswap_start_runner(dll_path: ascii[]): bool {
    if (!hotswap_try_find_runner_path(stasis.watch_hot_runner_path)) {
        print_string("error: stasis_runner not found. Build it in runtime/ (expects runtime/build/bin/Release/stasis_runner.exe)\n");
        return false;
    }

    // Best-effort cleanup: prevent an old swap file from triggering an immediate swap on launch.
    sys_delete_file(stasis.watch_hot_swap_file);
    sys_delete_file(stasis.watch_hot_log_out);
    sys_delete_file(stasis.watch_hot_log_err);

    ascii_clear(stasis.scratch_import);
    ascii_append(stasis.scratch_import, stasis.arg_module);
    ascii_append(stasis.scratch_import, "__main");

    ascii_clear(stasis.exec_cmd);
    // Use cmd.exe so we can redirect runner output to log files for timings.
    ascii_append(stasis.exec_cmd, "cmd /c ");
    ascii_append_byte(stasis.exec_cmd, 34); // "

    ascii_append_byte(stasis.exec_cmd, 34); // "
    ascii_append(stasis.exec_cmd, stasis.watch_hot_runner_path);
    ascii_append_byte(stasis.exec_cmd, 34); // "
    ascii_append_byte(stasis.exec_cmd, 32);
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, dll_path);
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append_byte(stasis.exec_cmd, 32);
    ascii_append(stasis.exec_cmd, stasis.scratch_import);
    ascii_append(stasis.exec_cmd, " --swap-file ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.watch_hot_swap_file);
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, " --fps ");
    ir_append_i32(stasis.exec_cmd, stasis.watch_hot_fps);

    ascii_append(stasis.exec_cmd, " 1> ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.watch_hot_log_out);
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, " 2> ");
    ascii_append_byte(stasis.exec_cmd, 34);
    ascii_append(stasis.exec_cmd, stasis.watch_hot_log_err);
    ascii_append_byte(stasis.exec_cmd, 34);

    ascii_append_byte(stasis.exec_cmd, 34); // "

    stasis.watch_hot_runner_pid = sys_spawn_async(stasis.exec_cmd);
    if (stasis.watch_hot_runner_pid <= 0) {
        print_string("error: failed to start runner\n");
        return false;
    }

    if (stasis.quiet == 0) {
        print_string("watch: hot runner pid=");
        print_int(stasis.watch_hot_runner_pid);
        print_char(10);
        sys_flush();
    }

    return true;
}

function watch_run_hotswap(): i32 {
    print_string("watch: run (hot swap + hot reload)\n");
    print_string("watch: ctrl+c to stop\n");

    if (stasis.watch_hot_fps < 1) { stasis.watch_hot_fps = 1; }
    if (stasis.watch_hot_fps > 240) { stasis.watch_hot_fps = 240; }

    if (!hotswap_prepare_paths(stasis.arg_entry)) {
        print_string("error: failed to prepare hot-swap paths\n");
        return 1;
    }

    stasis.watch_hot_flip = 0;

    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc == 0) {
        rc = check_loaded_files();
    }

    if (rc == 0) {
        rc = hotswap_build_dll_after_check(stasis.watch_hot_dll_a);
        if (rc == 0) {
            if (!hotswap_start_runner(stasis.watch_hot_dll_a)) {
                return 1;
            }
            if (stasis.quiet == 0) {
                print_string("HOTRELOAD phases(ms): emit=");
                print_int(stasis.watch_hot_ms_emit);
                print_string(" link=");
                print_int(stasis.watch_hot_ms_link);
                print_string(" total=");
                print_int(stasis.watch_hot_ms_total);
                print_char(10);
                sys_flush();
            }
        }
    } else {
        print_string("warning: initial build failed; waiting for changes.\n");
        sys_flush();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(50);

        let reload_rc: i32 = watch_reload_changed_files();
        if (reload_rc != 0) {
            if (stasis.quiet == 0) {
                print_string("watch: rebuilding\n");
                sys_flush();
            }

            let t_total0: i32 = sys_time_ms();
            let check_rc: i32 = 0;

            if (reload_rc == 2) {
                check_rc = load_graph(stasis.arg_entry);
                if (check_rc == 0) { check_rc = check_loaded_files(); }
            } else {
                if (reload_rc < 0) { return 1; }
                check_rc = check_loaded_files();
            }

            if (check_rc == 0) {
                if (stasis.watch_hot_flip == 0) {
                    stasis.watch_hot_flip = 1;
                    rc = hotswap_build_dll_after_check(stasis.watch_hot_dll_b);
                    if (rc == 0) {
                        let prev_sz: i32 = sys_file_size(stasis.watch_hot_log_err);
                        let start_ms: i32 = sys_time_ms();
                        if (!hotswap_write_swap_file(stasis.watch_hot_dll_b)) {
                            print_string("error: failed to write swap file\n");
                            return 1;
                        }
                        let swap_ms: i32 = hotswap_wait_for_runner_ok(start_ms, prev_sz);
                        if (stasis.quiet == 0) {
                            print_string("HOTSWAP latency(ms): ");
                            print_int(swap_ms);
                            print_char(10);
                            sys_flush();
                        }
                    }
                } else {
                    stasis.watch_hot_flip = 0;
                    rc = hotswap_build_dll_after_check(stasis.watch_hot_dll_a);
                    if (rc == 0) {
                        let prev_sz2: i32 = sys_file_size(stasis.watch_hot_log_err);
                        let start_ms2: i32 = sys_time_ms();
                        if (!hotswap_write_swap_file(stasis.watch_hot_dll_a)) {
                            print_string("error: failed to write swap file\n");
                            return 1;
                        }
                        let swap_ms2: i32 = hotswap_wait_for_runner_ok(start_ms2, prev_sz2);
                        if (stasis.quiet == 0) {
                            print_string("HOTSWAP latency(ms): ");
                            print_int(swap_ms2);
                            print_char(10);
                            sys_flush();
                        }
                    }
                }

                if (rc == 0 && stasis.quiet == 0) {
                    let total_ms: i32 = sys_time_ms() - t_total0;
                    print_string("HOTRELOAD phases(ms): emit=");
                    print_int(stasis.watch_hot_ms_emit);
                    print_string(" link=");
                    print_int(stasis.watch_hot_ms_link);
                    print_string(" swapWrite=");
                    print_int(stasis.watch_hot_ms_swap_write);
                    print_string(" total=");
                    print_int(total_ms);
                    print_char(10);
                    sys_flush();
                }
            }
        }
    }

    return rc;
}

function watch_check(entry_path: ascii[]): i32 {
    print_string("watch: check (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = load_graph(entry_path);
    if (rc == 0) {
        rc = check_loaded_files();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        let reload_rc: i32 = watch_reload_changed_files();
        if (reload_rc != 0) {
            if (stasis.quiet == 0) {
                print_string("watch: rebuilding\n");
            }

            if (reload_rc == 2) {
                rc = load_graph(entry_path);
                if (rc == 0) {
                    rc = check_loaded_files();
                }
            } else {
                if (reload_rc < 0) {
                    return 1;
                }
                rc = check_loaded_files();
            }
        }
    }

    return rc;
}

function cmd_build_after_check(): i32 {
    stasis.llvm_emit_native_main = 1;
    let rc: i32 = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) {
        return rc;
    }

    if (stasis.emit_ir != 0) {
        if (!sys_write_file(stasis.arg_out, stasis.ir_out, ascii_len(stasis.ir_out))) {
            print_string("error: failed to write output: ");
            print_string(stasis.arg_out);
            print_char(10);
            return 1;
        }

        if (stasis.quiet == 0) {
            print_string("built ir: ");
            print_string(stasis.arg_out);
            print_char(10);
        }
        return 0;
    }

    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: build to exe currently supports --backend llvm only (use --emit-ir for cranelift)\n");
        return 1;
    }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_build.ll");
    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.arg_out);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (stasis.quiet == 0) {
        print_string("built: ");
        print_string(stasis.arg_out);
        print_char(10);
    }
    return exit_code;
}

function cmd_build(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    return cmd_build_after_check();
}

function cmd_run_after_check(): i32 {
    stasis.llvm_emit_native_main = 1;
    let rc: i32 = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) {
        return rc;
    }

    // Write temp IR next to the stasis executable (no cwd syscall yet).
    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_run.ll");
    path_join(stasis.scratch_exe, stasis.scratch_dir, "stasis_run.exe");
    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    // Fast path: if we don't need native linking, try `lli`.
    if (!needs_graphics && !needs_sys) {
        ascii_clear(stasis.exec_cmd);
        ascii_append(stasis.exec_cmd, "lli ");
        ascii_append_byte(stasis.exec_cmd, 34); // '"'
        ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
        ascii_append_byte(stasis.exec_cmd, 34); // '"'
        let lli_exit: i32 = sys_exec(stasis.exec_cmd);
        if (lli_exit != 127) {
            return lli_exit;
        }
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    return sys_exec(stasis.exec_cmd);
}

function cmd_run(): i32 {
    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: run currently supports --backend llvm only\n");
        return 1;
    }

    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    return cmd_run_after_check();
}

function cmd_release(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    stasis.llvm_emit_native_main = 1;
    rc = emit_main_return_i32_ir(stasis.arg_module, "llvm");
    if (rc != 0) {
        return rc;
    }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_release.ll");
    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module -O3 ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.arg_out);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (stasis.quiet == 0) {
        print_string("released: ");
        print_string(stasis.arg_out);
        print_char(10);
    }
    return exit_code;
}

function watch_build(): i32 {
    print_string("watch: build (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc == 0) {
        rc = check_loaded_files();
    }
    if (rc == 0) {
        rc = cmd_build_after_check();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        let reload_rc: i32 = watch_reload_changed_files();
        if (reload_rc != 0) {
            if (stasis.quiet == 0) {
                print_string("watch: rebuilding\n");
            }
            if (reload_rc == 2) {
                rc = load_graph(stasis.arg_entry);
                if (rc == 0) { rc = check_loaded_files(); }
            } else {
                if (reload_rc < 0) { return 1; }
                rc = check_loaded_files();
            }
            if (rc == 0) {
                rc = cmd_build_after_check();
            }
        }
    }

    return rc;
}

function watch_run(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc == 0) {
        rc = check_loaded_files();
    }
    if (rc == 0) {
        // Default: hot swap + hot reload when `tick` exists in the entry module.
        if (build_find_entry_tick() >= 0) {
            return watch_run_hotswap();
        }

        print_string("watch: run (polling)\n");
        print_string("watch: ctrl+c to stop\n");
        rc = cmd_run_after_check();
    } else {
        print_string("watch: run (polling)\n");
        print_string("watch: ctrl+c to stop\n");
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        let reload_rc: i32 = watch_reload_changed_files();
        if (reload_rc != 0) {
            if (stasis.quiet == 0) {
                print_string("watch: rebuilding\n");
            }
            if (reload_rc == 2) {
                rc = load_graph(stasis.arg_entry);
                if (rc == 0) { rc = check_loaded_files(); }
            } else {
                if (reload_rc < 0) { return 1; }
                rc = check_loaded_files();
            }
            if (rc == 0) {
                rc = cmd_run_after_check();
            }
        }
    }

    return rc;
}

function main_legacy(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        usage();
        return 1;
    }

    stasis.quiet = 0;
    let have_entry: i32 = 0;
    let have_out: i32 = 0;
    let expect_backend: i32 = 0;
    let expect_module: i32 = 0;
    let expect_out: i32 = 0;
    let i: i32 = 0;

    if (!read_arg(1, stasis.cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(stasis.cmd, "help") || ascii_eq(stasis.cmd, "-h") || ascii_eq(stasis.cmd, "--help")) {
        usage();
        return 0;
    }

    if (ascii_eq(stasis.cmd, "check")) {
        ascii_clear(stasis.arg_entry);
        have_entry = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                usage();
                return 0;
            }

            if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                stasis.quiet = 1;
            } else {
                if (ascii_starts_with(stasis.scratch_import, "-")) {
                    print_string("error: unknown option: ");
                    print_string(stasis.scratch_import);
                    print_char(10);
                    return 1;
                }
                if (have_entry != 0) {
                    print_string("error: check expects 1 <entry.stasis>\n");
                    usage();
                    return 1;
                }
                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                have_entry = 1;
            }
        }

        if (have_entry == 0) {
            print_string("error: check expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        let rc: i32 = load_graph(stasis.arg_entry);
        if (rc != 0) {
            return rc;
        }
        return check_loaded_files();
    }

    if (ascii_eq(stasis.cmd, "build")) {
        ascii_clear(stasis.arg_entry);
        ascii_clear(stasis.arg_out);
        ascii_copy(stasis.arg_backend, "cranelift");
        ascii_copy(stasis.arg_module, "module");
        stasis.emit_ir = 0;
        stasis.use_mir = 0;
        have_entry = 0;
        have_out = 0;
        expect_backend = 0;
        expect_module = 0;
        expect_out = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module = 0;
                } else {
                    if (expect_out != 0) {
                        ascii_copy(stasis.arg_out, stasis.scratch_import);
                        have_out = 1;
                        expect_out = 0;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                            usage();
                            return 0;
                        }

                        if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                            stasis.quiet = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--mir")) {
                                stasis.use_mir = 1;
                            } else {
                            if (ascii_eq(stasis.scratch_import, "--emit-ir")) {
                                stasis.emit_ir = 1;
                            } else {
                                if (ascii_eq(stasis.scratch_import, "--backend")) {
                                    expect_backend = 1;
                                } else {
                                    if (ascii_eq(stasis.scratch_import, "--module")) {
                                        expect_module = 1;
                                    } else {
                                        if (ascii_eq(stasis.scratch_import, "--out") || ascii_eq(stasis.scratch_import, "-o")) {
                                            expect_out = 1;
                                        } else {
                                            if (ascii_starts_with(stasis.scratch_import, "-")) {
                                                print_string("error: unknown option: ");
                                                print_string(stasis.scratch_import);
                                                print_char(10);
                                                return 1;
                                            }
                                            if (have_entry != 0) {
                                                print_string("error: build expects 1 <entry.stasis>\n");
                                                usage();
                                                return 1;
                                            }
                                            ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                            have_entry = 1;
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0 || expect_out != 0) {
            print_string("error: build missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: build expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: build requires --out <path>\n");
            usage();
            return 1;
        }

        return cmd_build();
    }

    if (ascii_eq(stasis.cmd, "run")) {
        ascii_clear(stasis.arg_entry);
        ascii_copy(stasis.arg_backend, "llvm");
        ascii_copy(stasis.arg_module, "module");
        stasis.use_mir = 0;
        have_entry = 0;
        expect_backend = 0;
        expect_module = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                        if (ascii_eq(stasis.scratch_import, "--backend")) {
                            expect_backend = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--module")) {
                                expect_module = 1;
                            } else {
                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(stasis.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: run expects 1 <entry.stasis>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                have_entry = 1;
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0) {
            print_string("error: run missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: run expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        return cmd_run();
    }

    if (ascii_eq(stasis.cmd, "release")) {
        ascii_clear(stasis.arg_entry);
        ascii_clear(stasis.arg_out);
        ascii_copy(stasis.arg_module, "module");
        stasis.use_mir = 0;
        have_entry = 0;
        have_out = 0;
        expect_module = 0;
        expect_out = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_module != 0) {
                ascii_copy(stasis.arg_module, stasis.scratch_import);
                expect_module = 0;
            } else {
                if (expect_out != 0) {
                    ascii_copy(stasis.arg_out, stasis.scratch_import);
                    have_out = 1;
                    expect_out = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                        if (ascii_eq(stasis.scratch_import, "--module")) {
                            expect_module = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--out") || ascii_eq(stasis.scratch_import, "-o")) {
                                expect_out = 1;
                            } else {
                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(stasis.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: release expects 1 <entry.stasis>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                have_entry = 1;
                            }
                        }
                        }
                    }
                }
            }
        }

        if (expect_module != 0 || expect_out != 0) {
            print_string("error: release missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: release expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: release requires --out <path>\n");
            usage();
            return 1;
        }

        return cmd_release();
    }

    if (ascii_eq(stasis.cmd, "test")) {
        ascii_copy(stasis.arg_backend, "llvm");
        ascii_copy(stasis.arg_module, "module");
        ascii_clear(stasis.scratch_out_dir);
        stasis.use_mir = 0;

        have_entry = 0;
        expect_backend = 0;
        expect_module = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                        if (ascii_eq(stasis.scratch_import, "--backend")) {
                            expect_backend = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--module")) {
                                expect_module = 1;
                            } else {
                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(stasis.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: test expects 1 <dir>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(stasis.scratch_out_dir, stasis.scratch_import);
                                have_entry = 1;
                            }
                        }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0) {
            print_string("error: test missing option value\n");
            return 1;
        }

        if (have_entry == 0) {
            ascii_copy(stasis.scratch_out_dir, ".");
        }

        return test_run_path(stasis.scratch_out_dir);
    }

    if (ascii_eq(stasis.cmd, "watch")) {
        if (argc < 4) {
            print_string("error: watch expects a subcommand and <entry.stasis>\n");
            usage();
            return 1;
        }
        if (!read_arg(2, stasis.subcmd, 64)) {
            print_string("error: failed to read watch subcommand\n");
            return 1;
        }
        if (ascii_eq(stasis.subcmd, "check")) {
            ascii_clear(stasis.arg_entry);
            have_entry = 0;

            i = 0;
            for (i = 3; i < argc; i = i + 1) {
                if (!read_arg(i, stasis.scratch_import, 260)) {
                    print_string("error: failed to read argv[3+]\n");
                    return 1;
                }

                if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                    usage();
                    return 0;
                }

                if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                    stasis.quiet = 1;
                } else {
                    if (ascii_starts_with(stasis.scratch_import, "-")) {
                        print_string("error: unknown option: ");
                        print_string(stasis.scratch_import);
                        print_char(10);
                        return 1;
                    }
                    if (have_entry != 0) {
                        print_string("error: watch check expects 1 <entry.stasis>\n");
                        usage();
                        return 1;
                    }
                    ascii_copy(stasis.arg_entry, stasis.scratch_import);
                    have_entry = 1;
                }
            }

            if (have_entry == 0) {
                print_string("error: watch check expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }

            return watch_check(stasis.arg_entry);
        }

        if (ascii_eq(stasis.subcmd, "build")) {
            ascii_clear(stasis.arg_entry);
            ascii_clear(stasis.arg_out);
            ascii_copy(stasis.arg_backend, "cranelift");
            ascii_copy(stasis.arg_module, "module");
            stasis.emit_ir = 0;
            stasis.use_mir = 0;
            have_entry = 0;
            have_out = 0;
            expect_backend = 0;
            expect_module = 0;
            expect_out = 0;

            i = 0;
            for (i = 3; i < argc; i = i + 1) {
                if (!read_arg(i, stasis.scratch_import, 260)) {
                    print_string("error: failed to read argv[3+]\n");
                    return 1;
                }

                if (expect_backend != 0) {
                    ascii_copy(stasis.arg_backend, stasis.scratch_import);
                    expect_backend = 0;
                } else {
                    if (expect_module != 0) {
                        ascii_copy(stasis.arg_module, stasis.scratch_import);
                        expect_module = 0;
                    } else {
                        if (expect_out != 0) {
                            ascii_copy(stasis.arg_out, stasis.scratch_import);
                            have_out = 1;
                            expect_out = 0;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                                usage();
                                return 0;
                            }

                            if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                                stasis.quiet = 1;
                            } else {
                                if (ascii_eq(stasis.scratch_import, "--mir")) {
                                    stasis.use_mir = 1;
                                } else {
                                if (ascii_eq(stasis.scratch_import, "--emit-ir")) {
                                    stasis.emit_ir = 1;
                                } else {
                                    if (ascii_eq(stasis.scratch_import, "--backend")) {
                                        expect_backend = 1;
                                    } else {
                                        if (ascii_eq(stasis.scratch_import, "--module")) {
                                            expect_module = 1;
                                        } else {
                                            if (ascii_eq(stasis.scratch_import, "--out") || ascii_eq(stasis.scratch_import, "-o")) {
                                                expect_out = 1;
                                            } else {
                                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                                    print_string("error: unknown option: ");
                                                    print_string(stasis.scratch_import);
                                                    print_char(10);
                                                    return 1;
                                                }
                                                if (have_entry != 0) {
                                                    print_string("error: watch build expects 1 <entry.stasis>\n");
                                                    usage();
                                                    return 1;
                                                }
                                    ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                    have_entry = 1;
                                }
                            }
                                }
                        }
                        }
                    }
                }
            }
        }
                }
            }

            if (expect_backend != 0 || expect_module != 0 || expect_out != 0) {
                print_string("error: watch build missing option value\n");
                return 1;
            }
            if (have_entry == 0) {
                print_string("error: watch build expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }
            if (have_out == 0) {
                print_string("error: watch build requires --out <path>\n");
                usage();
                return 1;
            }

            return watch_build();
        }

        if (ascii_eq(stasis.subcmd, "run")) {
            ascii_clear(stasis.arg_entry);
            ascii_copy(stasis.arg_backend, "llvm");
            ascii_copy(stasis.arg_module, "module");
            stasis.use_mir = 0;
            have_entry = 0;
            expect_backend = 0;
            expect_module = 0;

            i = 0;
            for (i = 3; i < argc; i = i + 1) {
                if (!read_arg(i, stasis.scratch_import, 260)) {
                    print_string("error: failed to read argv[3+]\n");
                    return 1;
                }

                if (expect_backend != 0) {
                    ascii_copy(stasis.arg_backend, stasis.scratch_import);
                    expect_backend = 0;
                } else {
                    if (expect_module != 0) {
                        ascii_copy(stasis.arg_module, stasis.scratch_import);
                        expect_module = 0;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                            usage();
                            return 0;
                        }

                        if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                            stasis.quiet = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--mir")) {
                                stasis.use_mir = 1;
                            } else {
                            if (ascii_eq(stasis.scratch_import, "--backend")) {
                                expect_backend = 1;
                            } else {
                                if (ascii_eq(stasis.scratch_import, "--module")) {
                                    expect_module = 1;
                                } else {
                                    if (ascii_starts_with(stasis.scratch_import, "-")) {
                                        print_string("error: unknown option: ");
                                        print_string(stasis.scratch_import);
                                        print_char(10);
                                        return 1;
                                    }

                                    if (have_entry != 0) {
                                        print_string("error: watch run expects 1 <entry.stasis>\n");
                                        usage();
                                        return 1;
                                    }
                                    ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                    have_entry = 1;
                                }
                            }
                            }
                        }
                    }
                }
            }

            if (expect_backend != 0 || expect_module != 0) {
                print_string("error: watch run missing option value\n");
                return 1;
            }
            if (have_entry == 0) {
                print_string("error: watch run expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }

            return watch_run();
        }

        print_string("error: unsupported watch subcommand: ");
        print_string(stasis.subcmd);
        print_char(10);
        return 1;
    }

    print_string("error: unknown command: ");
    print_string(stasis.cmd);
    print_char(10);
    usage();
    return 1;
}

function cli_cmd_check(argc: i32): i32 {
    ascii_clear(stasis.arg_entry);
    let have_entry: i32 = 0;

    let i: i32 = 0;
    for (i = 2; i < argc; i = i + 1) {
        if (!read_arg(i, stasis.scratch_import, 260)) {
            print_string("error: failed to read argv[2+]\n");
            return 1;
        }

        if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
            usage();
            return 0;
        }

        if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
            stasis.quiet = 1;
        } else {
            if (ascii_starts_with(stasis.scratch_import, "-")) {
                print_string("error: unknown option: ");
                print_string(stasis.scratch_import);
                print_char(10);
                return 1;
            }
            if (have_entry != 0) {
                print_string("error: check expects 1 <entry.stasis>\n");
                usage();
                return 1;
            }
            ascii_copy(stasis.arg_entry, stasis.scratch_import);
            have_entry = 1;
        }
    }

    if (have_entry == 0) {
        print_string("error: check expects 1 <entry.stasis>\n");
        usage();
        return 1;
    }

    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    return check_loaded_files();
}

