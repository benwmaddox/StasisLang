import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "parsing.stasis";
import "signatures.stasis";
import "modules.stasis";
import "stmt_parse.stasis";
import "check_loaded_files.stasis";
import "cli_linking.stasis";
import "cli_args.stasis";
import "build_ir.stasis";
import "test_runner.stasis";

function usage(): void {
    print_string("stasis (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasis check [--quiet] <entry.stasis>\n");
    print_string("  stasis build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("  stasis release [--quiet] [--module <name>] --out <path> <entry.stasis>\n");
    print_string("  stasis test [--quiet] [--backend llvm] [--module <name>] <dir-or-file.stasis>\n");
    print_string("  stasis watch check [--quiet] <entry.stasis>\n");
    print_string("  stasis watch build [--quiet] [--backend cranelift|llvm] [--module <name>] --out <path> [--emit-ir] <entry.stasis>\n");
    print_string("  stasis watch run [--quiet] [--backend llvm] [--module <name>] <entry.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage: import graph + lexer + minimal parsing (balance check) + decl scan + minimal build/run/release.\n");
}

function watch_check(entry_path: ascii[]): i32 {
    print_string("watch: check (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = load_graph(entry_path);
    if (rc == 0) {
        rc = check_loaded_files();
    }

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = load_graph(entry_path);
            if (rc == 0) {
                rc = check_loaded_files();
            }
        }
    }

    return rc;
}

function cmd_build(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) {
        return rc;
    }

    if (stasis.emit_ir != 0) {
        if (!sys_write_file(stasis.arg_out, stasis.ir_out, ascii_len(stasis.ir_out))) {
            print_string("error: failed to write output: ");
            print_string(stasis.arg_out);
            print_char(10);
            return 1;
        }

        if (stasis.quiet == 0) {
            print_string("built ir: ");
            print_string(stasis.arg_out);
            print_char(10);
        }
        return 0;
    }

    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: build to exe currently supports --backend llvm only (use --emit-ir for cranelift)\n");
        return 1;
    }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_build.ll");
    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.arg_out);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (stasis.quiet == 0) {
        print_string("built: ");
        print_string(stasis.arg_out);
        print_char(10);
    }
    return exit_code;
}

function cmd_run(): i32 {
    if (!ascii_eq(stasis.arg_backend, "llvm")) {
        print_string("error: run currently supports --backend llvm only\n");
        return 1;
    }

    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(stasis.arg_module, stasis.arg_backend);
    if (rc != 0) {
        return rc;
    }

    // Write temp IR next to the stasis executable (no cwd syscall yet).
    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_run.ll");
    path_join(stasis.scratch_exe, stasis.scratch_dir, "stasis_run.exe");
    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    // Fast path: if we don't need native linking, try `lli`.
    if (!needs_graphics && !needs_sys) {
        ascii_clear(stasis.exec_cmd);
        ascii_append(stasis.exec_cmd, "lli ");
        ascii_append_byte(stasis.exec_cmd, 34); // '"'
        ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
        ascii_append_byte(stasis.exec_cmd, 34); // '"'
        let lli_exit: i32 = sys_exec(stasis.exec_cmd);
        if (lli_exit != 127) {
            return lli_exit;
        }
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    ascii_clear(stasis.exec_cmd);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_exe);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    return sys_exec(stasis.exec_cmd);
}

function cmd_release(): i32 {
    let rc: i32 = load_graph(stasis.arg_entry);
    if (rc != 0) {
        return rc;
    }
    rc = check_loaded_files();
    if (rc != 0) {
        return rc;
    }

    rc = emit_main_return_i32_ir(stasis.arg_module, "llvm");
    if (rc != 0) {
        return rc;
    }

    if (!read_arg(0, stasis.scratch_import, 260)) {
        print_string("error: failed to read argv[0]\n");
        return 1;
    }
    path_dirname(stasis.scratch_dir, stasis.scratch_import);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, "stasis_release.ll");
    // `stasis.scratch_runtime` is filled by `append_sys_runtime_link_input()` if needed.

    if (!sys_write_file(stasis.scratch_resolved, stasis.ir_out, ascii_len(stasis.ir_out))) {
        print_string("error: failed to write temp ir: ");
        print_string(stasis.scratch_resolved);
        print_char(10);
        return 1;
    }

    let needs_graphics: bool = ir_needs_graphics_runtime();
    let needs_sys: bool = ir_needs_sys_runtime();

    ascii_clear(stasis.exec_cmd);
    ascii_append(stasis.exec_cmd, "clang -Wl,/NOLOGO -Wno-override-module -O3 ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.scratch_resolved);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    if (needs_sys) {
        if (!append_sys_runtime_link_input()) {
            return 1;
        }
    }

    if (needs_graphics) {
        if (!append_graphics_static_link_inputs()) {
            return 1;
        }
    }

    ascii_append(stasis.exec_cmd, " -o ");
    ascii_append_byte(stasis.exec_cmd, 34); // '"'
    ascii_append(stasis.exec_cmd, stasis.arg_out);
    ascii_append_byte(stasis.exec_cmd, 34); // '"'

    let exit_code: i32 = cli_spawn_retry(stasis.exec_cmd);
    if (exit_code != 0) {
        print_string("error: clang failed (exit=");
        print_int(exit_code);
        print_string(")\n");
        return exit_code;
    }

    if (stasis.quiet == 0) {
        print_string("released: ");
        print_string(stasis.arg_out);
        print_char(10);
    }
    return exit_code;
}

function watch_build(): i32 {
    print_string("watch: build (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = cmd_build();

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = cmd_build();
        }
    }

    return rc;
}

function watch_run(): i32 {
    print_string("watch: run (polling)\n");
    print_string("watch: ctrl+c to stop\n");

    let rc: i32 = cmd_run();

    let tick: i32 = 0;
    for (tick = 0; 1; tick = tick + 1) {
        sys_sleep_ms(200);

        if (any_file_mtime_changed()) {
            print_string("watch: rebuilding\n");
            rc = cmd_run();
        }
    }

    return rc;
}

function main_legacy(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        usage();
        return 1;
    }

    stasis.quiet = 0;
    let have_entry: i32 = 0;
    let have_out: i32 = 0;
    let expect_backend: i32 = 0;
    let expect_module: i32 = 0;
    let expect_out: i32 = 0;
    let i: i32 = 0;

    if (!read_arg(1, stasis.cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(stasis.cmd, "help") || ascii_eq(stasis.cmd, "-h") || ascii_eq(stasis.cmd, "--help")) {
        usage();
        return 0;
    }

    if (ascii_eq(stasis.cmd, "check")) {
        ascii_clear(stasis.arg_entry);
        have_entry = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                usage();
                return 0;
            }

            if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                stasis.quiet = 1;
            } else {
                if (ascii_starts_with(stasis.scratch_import, "-")) {
                    print_string("error: unknown option: ");
                    print_string(stasis.scratch_import);
                    print_char(10);
                    return 1;
                }
                if (have_entry != 0) {
                    print_string("error: check expects 1 <entry.stasis>\n");
                    usage();
                    return 1;
                }
                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                have_entry = 1;
            }
        }

        if (have_entry == 0) {
            print_string("error: check expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        let rc: i32 = load_graph(stasis.arg_entry);
        if (rc != 0) {
            return rc;
        }
        return check_loaded_files();
    }

    if (ascii_eq(stasis.cmd, "build")) {
        ascii_clear(stasis.arg_entry);
        ascii_clear(stasis.arg_out);
        ascii_copy(stasis.arg_backend, "cranelift");
        ascii_copy(stasis.arg_module, "module");
        stasis.emit_ir = 0;
        stasis.use_mir = 0;
        have_entry = 0;
        have_out = 0;
        expect_backend = 0;
        expect_module = 0;
        expect_out = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module = 0;
                } else {
                    if (expect_out != 0) {
                        ascii_copy(stasis.arg_out, stasis.scratch_import);
                        have_out = 1;
                        expect_out = 0;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                            usage();
                            return 0;
                        }

                        if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                            stasis.quiet = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--mir")) {
                                stasis.use_mir = 1;
                            } else {
                            if (ascii_eq(stasis.scratch_import, "--emit-ir")) {
                                stasis.emit_ir = 1;
                            } else {
                                if (ascii_eq(stasis.scratch_import, "--backend")) {
                                    expect_backend = 1;
                                } else {
                                    if (ascii_eq(stasis.scratch_import, "--module")) {
                                        expect_module = 1;
                                    } else {
                                        if (ascii_eq(stasis.scratch_import, "--out") || ascii_eq(stasis.scratch_import, "-o")) {
                                            expect_out = 1;
                                        } else {
                                            if (ascii_starts_with(stasis.scratch_import, "-")) {
                                                print_string("error: unknown option: ");
                                                print_string(stasis.scratch_import);
                                                print_char(10);
                                                return 1;
                                            }
                                            if (have_entry != 0) {
                                                print_string("error: build expects 1 <entry.stasis>\n");
                                                usage();
                                                return 1;
                                            }
                                            ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                            have_entry = 1;
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0 || expect_out != 0) {
            print_string("error: build missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: build expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: build requires --out <path>\n");
            usage();
            return 1;
        }

        return cmd_build();
    }

    if (ascii_eq(stasis.cmd, "run")) {
        ascii_clear(stasis.arg_entry);
        ascii_copy(stasis.arg_backend, "llvm");
        ascii_copy(stasis.arg_module, "module");
        stasis.use_mir = 0;
        have_entry = 0;
        expect_backend = 0;
        expect_module = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                        if (ascii_eq(stasis.scratch_import, "--backend")) {
                            expect_backend = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--module")) {
                                expect_module = 1;
                            } else {
                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(stasis.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: run expects 1 <entry.stasis>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                have_entry = 1;
                            }
                        }
                    }
                }
            }
        }

        if (expect_backend != 0 || expect_module != 0) {
            print_string("error: run missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: run expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }

        return cmd_run();
    }

    if (ascii_eq(stasis.cmd, "release")) {
        ascii_clear(stasis.arg_entry);
        ascii_clear(stasis.arg_out);
        ascii_copy(stasis.arg_module, "module");
        stasis.use_mir = 0;
        have_entry = 0;
        have_out = 0;
        expect_module = 0;
        expect_out = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_module != 0) {
                ascii_copy(stasis.arg_module, stasis.scratch_import);
                expect_module = 0;
            } else {
                if (expect_out != 0) {
                    ascii_copy(stasis.arg_out, stasis.scratch_import);
                    have_out = 1;
                    expect_out = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                        if (ascii_eq(stasis.scratch_import, "--module")) {
                            expect_module = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--out") || ascii_eq(stasis.scratch_import, "-o")) {
                                expect_out = 1;
                            } else {
                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(stasis.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: release expects 1 <entry.stasis>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(stasis.arg_entry, stasis.scratch_import);
                                have_entry = 1;
                            }
                        }
                        }
                    }
                }
            }
        }

        if (expect_module != 0 || expect_out != 0) {
            print_string("error: release missing option value\n");
            return 1;
        }
        if (have_entry == 0) {
            print_string("error: release expects 1 <entry.stasis>\n");
            usage();
            return 1;
        }
        if (have_out == 0) {
            print_string("error: release requires --out <path>\n");
            usage();
            return 1;
        }

        return cmd_release();
    }

    if (ascii_eq(stasis.cmd, "test")) {
        ascii_copy(stasis.arg_backend, "llvm");
        ascii_copy(stasis.arg_module, "module");
        ascii_clear(stasis.scratch_out_dir);
        stasis.use_mir = 0;

        have_entry = 0;
        expect_backend = 0;
        expect_module = 0;

        i = 0;
        for (i = 2; i < argc; i = i + 1) {
            if (!read_arg(i, stasis.scratch_import, 260)) {
                print_string("error: failed to read argv[2+]\n");
                return 1;
            }

            if (expect_backend != 0) {
                ascii_copy(stasis.arg_backend, stasis.scratch_import);
                expect_backend = 0;
            } else {
                if (expect_module != 0) {
                    ascii_copy(stasis.arg_module, stasis.scratch_import);
                    expect_module = 0;
                } else {
                    if (ascii_eq(stasis.scratch_import, "-h") || ascii_eq(stasis.scratch_import, "--help")) {
                        usage();
                        return 0;
                    }

                    if (ascii_eq(stasis.scratch_import, "-q") || ascii_eq(stasis.scratch_import, "--quiet")) {
                        stasis.quiet = 1;
                    } else {
                        if (ascii_eq(stasis.scratch_import, "--mir")) {
                            stasis.use_mir = 1;
                        } else {
                        if (ascii_eq(stasis.scratch_import, "--backend")) {
                            expect_backend = 1;
                        } else {
                            if (ascii_eq(stasis.scratch_import, "--module")) {
                                expect_module = 1;
                            } else {
                                if (ascii_starts_with(stasis.scratch_import, "-")) {
                                    print_string("error: unknown option: ");
                                    print_string(stasis.scratch_import);
                                    print_char(10);
                                    return 1;
                                }

                                if (have_entry != 0) {
                                    print_string("error: test expects 1 <dir>\n");
                                    usage();
                                    return 1;
                                }
                                ascii_copy(stasis.scratch_out_dir, stasis.scratch_import);
                                have_entry = 1;
                            }
                        }
