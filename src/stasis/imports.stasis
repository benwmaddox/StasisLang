import "../stdlib/stdlib.stasis";
import "state.stasis";

const SH_MAX_FILES: i32 = 300;
const SH_MAX_FILE_BYTES: i32 = 51200;
const SH_MAX_PATH_BYTES: i32 = 260;
const SH_MAX_MOD_BYTES: i32 = 96;
const SH_POOL_CAP: i32 = 16000000;
const SH_PATH_POOL_CAP: i32 = 90000;
const SH_MOD_POOL_CAP: i32 = 20000;
const SH_IMPORTS_CAP: i32 = 90000;

function sh_reset() {
    sh.file_count = 0;
    sh.pool_len = 0;
    sh.path_pool_len = 0;
    sh.mod_pool_len = 0;
    sh.imports_len = 0;
    sh.sym_pool_len = 0;
    sh.sym_count = 0;
    ascii_clear(sh.scratch_import);
    ascii_clear(sh.scratch_dir);
    ascii_clear(sh.scratch_resolved);
    ascii_clear(sh.scratch_watch_path);
    ascii_clear(sh.scratch_mod);
    ascii_clear(sh.sig_path);
}

function sh_is_space(b: u8): bool {
    return b == 32 || b == 9;
}

function sh_path_is_abs(path: ascii[]): bool {
    let b0: u8 = path[0];
    if (b0 == 47 || b0 == 92) {
        return true;
    }
    let b1: u8 = path[1];
    return b0 != 0 && b1 == 58;
}

function sh_path_dirname(dst: ascii[], path: ascii[]): i32 {
    ascii_clear(dst);

    let i_slash: i32 = ascii_find_last_byte(path, 47);
    let i_bslash: i32 = ascii_find_last_byte(path, 92);
    let cut: i32 = i_slash;
    if (i_bslash > cut) {
        cut = i_bslash;
    }
    if (cut < 0) {
        return 0;
    }

    let i: i32 = 0;
    let limit: i32 = cut;
    if (limit > SH_MAX_PATH_BYTES - 1) {
        limit = SH_MAX_PATH_BYTES - 1;
    }
    for (i = 0; i < limit; i = i + 1) {
        dst[i] = path[i];
    }
    dst[i] = 0;
    ascii_set_len(dst, i);
    return i;
}

function sh_path_join(dst: ascii[], dir: ascii[], rel: ascii[]): i32 {
    ascii_clear(dst);
    if (ascii_is_empty(dir)) {
        ascii_copy(dst, rel);
        return ascii_len(dst);
    }

    ascii_copy(dst, dir);
    let dlen: i32 = ascii_len(dst);
    if (dlen > 0) {
        let last: u8 = dst[dlen - 1];
        if (last != 47 && last != 92) {
            ascii_append_byte(dst, 47);
        }
    }

    ascii_append(dst, rel);
    return ascii_len(dst);
}

function sh_path_pool_eq(path_off: i32, path_len: i32, path: ascii[]): bool {
    if (path_len != ascii_len(path)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < path_len; i = i + 1) {
        if (sh.path_pool[path_off + i] != path[i]) {
            return false;
        }
    }

    return sh.path_pool[path_off + path_len] == 0 && path[path_len] == 0;
}

function sh_find_file(path: ascii[]): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.file_count; i = i + 1) {
        if (sh_path_pool_eq(sh.files[i].path_off, sh.files[i].path_len, path)) {
            return i;
        }
    }
    return -1;
}

function sh_mod_pool_eq(mod_off: i32, mod_len: i32, mod: ascii[]): bool {
    if (mod_len != ascii_len(mod)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < mod_len; i = i + 1) {
        if (sh.mod_pool[mod_off + i] != mod[i]) {
            return false;
        }
    }

    return sh.mod_pool[mod_off + mod_len] == 0 && mod[mod_len] == 0;
}

function sh_find_module(mod: ascii[]): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.file_count; i = i + 1) {
        if (sh_mod_pool_eq(sh.files[i].mod_off, sh.files[i].mod_len, mod)) {
            return i;
        }
    }
    return -1;
}

function sh_copy_file_module(dst: ascii[], file_idx: i32): bool {
    ascii_clear(dst);

    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }

    let off: i32 = sh.files[file_idx].mod_off;
    let len: i32 = sh.files[file_idx].mod_len;
    if (len <= 0 || len >= SH_MAX_MOD_BYTES) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        dst[i] = sh.mod_pool[off + i];
    }
    dst[len] = 0;
    ascii_set_len(dst, len);
    return true;
}

function sh_module_name_from_path(dst: ascii[], path: ascii[]): bool {
    ascii_clear(dst);

    let i_slash: i32 = ascii_find_last_byte(path, 47);
    let i_bslash: i32 = ascii_find_last_byte(path, 92);
    let start: i32 = i_slash;
    if (i_bslash > start) {
        start = i_bslash;
    }
    start = start + 1;
    if (start < 0) {
        start = 0;
    }

    let path_len: i32 = ascii_len(path);
    let end: i32 = path_len;

    let dot: i32 = ascii_find_last_byte(path, 46);
    if (dot > start) {
        end = dot;
    }

    if (end <= start) {
        dst[0] = 109; // m
        dst[1] = 111; // o
        dst[2] = 100; // d
        dst[3] = 117; // u
        dst[4] = 108; // l
        dst[5] = 101; // e
        dst[6] = 0;
        ascii_set_len(dst, 6);
        return true;
    }

    let out_i: i32 = 0;
    if (start < path_len && !ascii_is_alpha(path[start])) {
        if (out_i + 2 < SH_MAX_MOD_BYTES) {
            dst[out_i] = 109; // m
            dst[out_i + 1] = 95; // _
            out_i = out_i + 2;
        }
    }

    let i: i32 = 0;
    for (i = start; i < end && out_i + 1 < SH_MAX_MOD_BYTES; i = i + 1) {
        let b: u8 = path[i];
        if (ascii_is_alpha(b) || ascii_is_digit(b) || b == 95) {
            dst[out_i] = b;
        } else {
            if (b == 45) { // '-'
                dst[out_i] = 95;
            } else {
                dst[out_i] = 95;
            }
        }
        out_i = out_i + 1;
    }

    dst[out_i] = 0;
    ascii_set_len(dst, out_i);
    return out_i > 0;
}

function sh_file_imports_contains(file_idx: i32, imported: i32): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }

    let off: i32 = sh.files[file_idx].imports_off;
    let count: i32 = sh.files[file_idx].imports_len;
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        if (sh.imports[off + i] == imported) {
            return true;
        }
    }
    return false;
}

function sh_load_file(path: ascii[]): i32 {
    let existing: i32 = sh_find_file(path);
    if (existing >= 0) {
        return existing;
    }

    if (sh.file_count >= SH_MAX_FILES) {
        if (sh.quiet == 0) {
            print_string("error: exceeded max import files (300)\n");
        }
        return -1;
    }

    let size: i32 = sys_file_size(path);
    if (size < 0) {
        if (sh.quiet == 0) {
            print_string("error: unable to stat file: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }
    if (size > SH_MAX_FILE_BYTES) {
        if (sh.quiet == 0) {
            print_string("error: file exceeds 50KiB limit: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }

    if (sh.pool_len + size + 1 > SH_POOL_CAP) {
        if (sh.quiet == 0) {
            print_string("error: exceeded total source pool capacity\n");
        }
        return -1;
    }

    let path_len: i32 = ascii_len(path);
    if (path_len <= 0) {
        if (sh.quiet == 0) {
            print_string("error: empty path\n");
        }
        return -1;
    }
    if (path_len >= SH_MAX_PATH_BYTES) {
        if (sh.quiet == 0) {
            print_string("error: path too long (max 260 bytes): ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }
    if (sh.path_pool_len + path_len + 1 > SH_PATH_POOL_CAP) {
        if (sh.quiet == 0) {
            print_string("error: exceeded path pool capacity\n");
        }
        return -1;
    }

    if (!sh_module_name_from_path(sh.scratch_mod, path)) {
        if (sh.quiet == 0) {
            print_string("error: unable to derive module name: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }

    let mod_len: i32 = ascii_len(sh.scratch_mod);
    if (mod_len <= 0 || mod_len >= SH_MAX_MOD_BYTES) {
        if (sh.quiet == 0) {
            print_string("error: module name too long (max 96 bytes)\n");
        }
        return -1;
    }

    let mod_dup: i32 = sh_find_module(sh.scratch_mod);
    if (mod_dup >= 0) {
        if (sh.quiet == 0) {
            print_string("error: duplicate module name: ");
            print_string(sh.scratch_mod);
            print_char(10);
            if (sh_copy_file_path(sh.scratch_dir, mod_dup)) {
                print_string("note: module already used by: ");
                print_string(sh.scratch_dir);
                print_char(10);
            }
        }
        return -1;
    }

    if (sh.mod_pool_len + mod_len + 1 > SH_MOD_POOL_CAP) {
        if (sh.quiet == 0) {
            print_string("error: exceeded module name pool capacity\n");
        }
        return -1;
    }

    let read_n: i32 = sys_read_file(path, sh.read, SH_MAX_FILE_BYTES + 1);
    if (read_n < 0) {
        if (sh.quiet == 0) {
            print_string("error: unable to read file: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }

    // Copy into the global pool (stable across full graph load).
    let off: i32 = sh.pool_len;
    let i: i32 = 0;
    for (i = 0; i < read_n; i = i + 1) {
        sh.pool[off + i] = sh.read[i];
    }
    sh.pool[off + read_n] = 0;
    sh.pool_len = sh.pool_len + read_n + 1;

    let idx: i32 = sh.file_count;
    sh.file_count = sh.file_count + 1;

    let path_off: i32 = sh.path_pool_len;
    for (i = 0; i < path_len; i = i + 1) {
        sh.path_pool[path_off + i] = path[i];
    }
    sh.path_pool[path_off + path_len] = 0;
    sh.path_pool_len = sh.path_pool_len + path_len + 1;

    let mod_off: i32 = sh.mod_pool_len;
    for (i = 0; i < mod_len; i = i + 1) {
        sh.mod_pool[mod_off + i] = sh.scratch_mod[i];
    }
    sh.mod_pool[mod_off + mod_len] = 0;
    sh.mod_pool_len = sh.mod_pool_len + mod_len + 1;

    sh.files[idx].path_off = path_off;
    sh.files[idx].path_len = path_len;
    sh.files[idx].mod_off = mod_off;
    sh.files[idx].mod_len = mod_len;
    sh.files[idx].imports_off = 0;
    sh.files[idx].imports_len = 0;
    sh.files[idx].syms_off = 0;
    sh.files[idx].syms_len = 0;
    sh.files[idx].offset = off;
    sh.files[idx].len = read_n;
    sh.files[idx].mtime_ms = sys_file_mtime_ms(path);

    return idx;
}

function sh_copy_file_path(dst: ascii[], file_idx: i32): bool {
    ascii_clear(dst);

    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }

    let off: i32 = sh.files[file_idx].path_off;
    let len: i32 = sh.files[file_idx].path_len;
    if (len <= 0 || len >= SH_MAX_PATH_BYTES) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        dst[i] = sh.path_pool[off + i];
    }
    dst[len] = 0;
    ascii_set_len(dst, len);
    return true;
}

function sh_any_file_mtime_changed(): bool {
    let i: i32 = 0;
    for (i = 0; i < sh.file_count; i = i + 1) {
        if (!sh_copy_file_path(sh.scratch_watch_path, i)) {
            return true;
        }
        let now: i32 = sys_file_mtime_ms(sh.scratch_watch_path);
        if (now != sh.files[i].mtime_ms) {
            return true;
        }
    }
    return false;
}

function sh_try_parse_import(file_idx: i32, line_start: i32, line_end: i32): bool {
    ascii_clear(sh.scratch_import);

    let base: i32 = sh.files[file_idx].offset;
    let i: i32 = line_start;
    for (i = i; i < line_end && sh_is_space(sh.pool[base + i]); i = i + 1) {
    }

    if (i + 6 > line_end) {
        return false;
    }

    if (sh.pool[base + i + 0] != 105) { return false; } // i
    if (sh.pool[base + i + 1] != 109) { return false; } // m
    if (sh.pool[base + i + 2] != 112) { return false; } // p
    if (sh.pool[base + i + 3] != 111) { return false; } // o
    if (sh.pool[base + i + 4] != 114) { return false; } // r
    if (sh.pool[base + i + 5] != 116) { return false; } // t

    i = i + 6;
    for (i = i; i < line_end && sh_is_space(sh.pool[base + i]); i = i + 1) {
    }

    if (i >= line_end || sh.pool[base + i] != 34) {
        return false;
    }
    i = i + 1;

    let out_i: i32 = 0;
    for (i = i; i < line_end && sh.pool[base + i] != 34; i = i + 1) {
        if (out_i + 1 >= SH_MAX_PATH_BYTES) {
            return false;
        }
        sh.scratch_import[out_i] = sh.pool[base + i];
        out_i = out_i + 1;
    }

    if (i >= line_end || sh.pool[base + i] != 34) {
        return false;
    }

    sh.scratch_import[out_i] = 0;
    ascii_set_len(sh.scratch_import, out_i);

    i = i + 1;
    for (i = i; i < line_end && sh_is_space(sh.pool[base + i]); i = i + 1) {
    }

    if (i < line_end && sh.pool[base + i] == 59) {
        i = i + 1;
        for (i = i; i < line_end && sh_is_space(sh.pool[base + i]); i = i + 1) {
        }
    }

    return i == line_end;
}

function sh_path_dirname_from_pool(dst: ascii[], path_off: i32, path_len: i32): i32 {
    ascii_clear(dst);

    let cut: i32 = -1;
    let i: i32 = 0;
    for (i = 0; i < path_len; i = i + 1) {
        let b: u8 = sh.path_pool[path_off + i];
        if (b == 47 || b == 92) {
            cut = i;
        }
    }

    if (cut < 0) {
        return 0;
    }

    let limit: i32 = cut;
    if (limit > SH_MAX_PATH_BYTES - 1) {
        limit = SH_MAX_PATH_BYTES - 1;
    }
    for (i = 0; i < limit; i = i + 1) {
        dst[i] = sh.path_pool[path_off + i];
    }
    dst[i] = 0;
    ascii_set_len(dst, i);
    return i;
}

function sh_resolve_import(file_idx: i32): bool {
    ascii_clear(sh.scratch_resolved);
    if (sh_path_is_abs(sh.scratch_import)) {
        ascii_copy(sh.scratch_resolved, sh.scratch_import);
        return true;
    }

    sh_path_dirname_from_pool(sh.scratch_dir, sh.files[file_idx].path_off, sh.files[file_idx].path_len);
    sh_path_join(sh.scratch_resolved, sh.scratch_dir, sh.scratch_import);
    return true;
}

function sh_scan_file_imports(file_idx: i32): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }

    sh.files[file_idx].imports_off = sh.imports_len;
    sh.files[file_idx].imports_len = 0;

    let base: i32 = sh.files[file_idx].offset;
    let len: i32 = sh.files[file_idx].len;

    let line_start: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i <= len; i = i + 1) {
        let is_end: bool = i == len;
        let b: u8 = 10;
        if (!is_end) {
            b = sh.pool[base + i];
        }

        if (b == 10 || is_end) {
            let line_end: i32 = i;
            if (line_end > line_start && sh.pool[base + line_end - 1] == 13) {
                line_end = line_end - 1;
            }

            if (sh_try_parse_import(file_idx, line_start, line_end)) {
                if (!sh_resolve_import(file_idx)) {
                    return false;
                }
                let imported: i32 = sh_load_file(sh.scratch_resolved);
                if (imported < 0) {
                    return false;
                }

                if (!sh_file_imports_contains(file_idx, imported)) {
                    if (sh.imports_len >= SH_IMPORTS_CAP) {
                        if (sh.quiet == 0) {
                            print_string("error: exceeded import edge capacity\n");
                        }
                        return false;
                    }
                    sh.imports[sh.imports_len] = imported;
                    sh.imports_len = sh.imports_len + 1;
                    sh.files[file_idx].imports_len = sh.files[file_idx].imports_len + 1;
                }
            }

            line_start = i + 1;
        }
    }

    return true;
}

function sh_load_graph(entry_path: ascii[]): i32 {
    sh_reset();

    let entry: i32 = sh_load_file(entry_path);
    if (entry < 0) {
        return 1;
    }

    let i: i32 = 0;
    for (i = 0; i < sh.file_count; i = i + 1) {
        if (!sh_scan_file_imports(i)) {
            return 1;
        }
    }

    return 0;
}
