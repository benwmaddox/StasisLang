import "../stdlib/stdlib.stasis";
import "state.stasis";

const MAX_FILES: i32 = 300;
const MAX_FILE_BYTES: i32 = 1048576;
const MAX_PATH_BYTES: i32 = 260;
const MAX_MOD_BYTES: i32 = 96;
const POOL_CAP: i32 = 134217728;
const PATH_POOL_CAP: i32 = 90000;
const MOD_POOL_CAP: i32 = 20000;
const IMPORTS_CAP: i32 = 90000;

function reset() {
    stasis.file_count = 0;
    stasis.pool_len = 0;
    stasis.path_pool_len = 0;
    stasis.mod_pool_len = 0;
    stasis.imports_len = 0;
    stasis.sym_pool_len = 0;
    stasis.sym_count = 0;
    stasis.type_count = 0;
    stasis.struct_count = 0;
    stasis.field_count = 0;
    stasis.enum_count = 0;
    stasis.enum_member_count = 0;
    stasis.global_count = 0;
    stasis.const_count = 0;
    stasis.func_count = 0;
    stasis.param_count = 0;
    ascii_clear(stasis.scratch_import);
    ascii_clear(stasis.scratch_dir);
    ascii_clear(stasis.scratch_resolved);
    ascii_clear(stasis.scratch_watch_path);
    ascii_clear(stasis.scratch_mod);
    ascii_clear(stasis.sig_path);
}

function is_space(b: u8): bool {
    return b == 32 || b == 9;
}

function path_is_abs(path: ascii[]): bool {
    let b0: u8 = path[0];
    if (b0 == 47 || b0 == 92) {
        return true;
    }
    let b1: u8 = path[1];
    return b0 != 0 && b1 == 58;
}

function path_dirname(dst: ascii[], path: ascii[]): i32 {
    ascii_clear(dst);

    let i_slash: i32 = ascii_find_last_byte(path, 47);
    let i_bslash: i32 = ascii_find_last_byte(path, 92);
    let cut: i32 = i_slash;
    if (i_bslash > cut) {
        cut = i_bslash;
    }
    if (cut < 0) {
        return 0;
    }

    let i: i32 = 0;
    let limit: i32 = cut;
    if (limit > MAX_PATH_BYTES - 1) {
        limit = MAX_PATH_BYTES - 1;
    }
    for (i = 0; i < limit; i = i + 1) {
        dst[i] = path[i];
    }
    dst[i] = 0;
    ascii_set_len(dst, i);
    return i;
}

function path_join(dst: ascii[], dir: ascii[], rel: ascii[]): i32 {
    ascii_clear(dst);
    if (ascii_is_empty(dir)) {
        ascii_copy(dst, rel);
        return ascii_len(dst);
    }

    ascii_copy(dst, dir);
    let dlen: i32 = ascii_len(dst);
    if (dlen > 0) {
        let last: u8 = dst[dlen - 1];
        if (last != 47 && last != 92) {
            ascii_append_byte(dst, 47);
        }
    }

    ascii_append(dst, rel);
    return ascii_len(dst);
}

function path_normalize_to(dst: ascii[], src: ascii[]): bool {
    ascii_clear(dst);

    let seg_len: i32 = 0;

    let i: i32 = 0;
    let out_len: i32 = 0;

    // Prefix: drive letter ("C:") or leading slash.
    if (src[0] != 0 && src[1] == 58) {
        dst[0] = src[0];
        dst[1] = 58;
        out_len = 2;
        i = 2;

        for (; src[i] == 47 || src[i] == 92; ) {
            i = i + 1;
        }
        if (src[i] != 0) {
            dst[out_len] = 47;
            out_len = out_len + 1;
        }
    } else {
        if (src[0] == 47 || src[0] == 92) {
            dst[0] = 47;
            out_len = 1;
            i = 0;
            for (; src[i] == 47 || src[i] == 92; ) {
                i = i + 1;
            }
        }
    }

    let done: i32 = 0;
    for (; done == 0; ) {
        for (; src[i] == 47 || src[i] == 92; ) {
            i = i + 1;
        }
        if (src[i] == 0) {
            done = 1;
        } else {

            let seg_i: i32 = i;
            for (; src[i] != 0 && src[i] != 47 && src[i] != 92; ) {
                i = i + 1;
            }
            let seg_n: i32 = i - seg_i;
            if (seg_n <= 0) {
                // skip
            } else {

                let is_dot: i32 = 0;
                let is_dotdot: i32 = 0;
                if (seg_n == 1 && src[seg_i] == 46) { is_dot = 1; }
                if (seg_n == 2 && src[seg_i] == 46 && src[seg_i + 1] == 46) { is_dotdot = 1; }

                if (is_dot != 0) {
                    // skip
                } else {

                    if (is_dotdot != 0) {
                        if (seg_len > 0) {
                            seg_len = seg_len - 1;
                            out_len = stasis.path_norm_seg_starts[seg_len];
                            dst[out_len] = 0;
                            ascii_set_len(dst, out_len);
                        } else {

                            // Preserve leading ".." for relative paths.
                            if (dst[0] != 47 && !(dst[0] != 0 && dst[1] == 58)) {
                                if (out_len > 0 && dst[out_len - 1] != 47) {
                                    if (out_len + 1 >= MAX_PATH_BYTES) { return false; }
                                    dst[out_len] = 47;
                                    out_len = out_len + 1;
                                }
                                if (out_len + 2 >= MAX_PATH_BYTES) { return false; }
                                dst[out_len] = 46;
                                dst[out_len + 1] = 46;
                                out_len = out_len + 2;
                                dst[out_len] = 0;
                                ascii_set_len(dst, out_len);
                                stasis.path_norm_seg_starts[seg_len] = out_len;
                                seg_len = seg_len + 1;
                            }
                        }
                    } else {

                        if (out_len > 0 && dst[out_len - 1] != 47 && dst[out_len - 1] != 58) {
                            if (out_len + 1 >= MAX_PATH_BYTES) { return false; }
                            dst[out_len] = 47;
                            out_len = out_len + 1;
                        }

                        if (out_len + seg_n >= MAX_PATH_BYTES) { return false; }
                        stasis.path_norm_seg_starts[seg_len] = out_len;
                        seg_len = seg_len + 1;

                        let j: i32 = 0;
                        for (j = 0; j < seg_n; j = j + 1) {
                            dst[out_len + j] = src[seg_i + j];
                        }
                        out_len = out_len + seg_n;
                        dst[out_len] = 0;
                        ascii_set_len(dst, out_len);
                    }
                }
            }
        }
    }

    // Drop trailing "/" (but keep "C:/" and "/").
    if (out_len > 1 && dst[out_len - 1] == 47 && dst[out_len - 2] != 58) {
        dst[out_len - 1] = 0;
        out_len = out_len - 1;
        ascii_set_len(dst, out_len);
    }

    return true;
}

function path_normalize_inplace(path: ascii[]): bool {
    ascii_clear(stasis.scratch_dir);
    if (!path_normalize_to(stasis.scratch_dir, path)) {
        return false;
    }
    ascii_copy(path, stasis.scratch_dir);
    return true;
}

function path_pool_eq(path_off: i32, path_len: i32, path: ascii[]): bool {
    if (path_len != ascii_len(path)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < path_len; i = i + 1) {
        if (stasis.path_pool[path_off + i] != path[i]) {
            return false;
        }
    }

    return stasis.path_pool[path_off + path_len] == 0 && path[path_len] == 0;
}

function find_file(path: ascii[]): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.file_count; i = i + 1) {
        if (path_pool_eq(stasis.files[i].path_off, stasis.files[i].path_len, path)) {
            return i;
        }
    }
    return -1;
}

function mod_pool_eq(mod_off: i32, mod_len: i32, mod: ascii[]): bool {
    if (mod_len != ascii_len(mod)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < mod_len; i = i + 1) {
        if (stasis.mod_pool[mod_off + i] != mod[i]) {
            return false;
        }
    }

    return stasis.mod_pool[mod_off + mod_len] == 0 && mod[mod_len] == 0;
}

function find_module(mod: ascii[]): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.file_count; i = i + 1) {
        if (mod_pool_eq(stasis.files[i].mod_off, stasis.files[i].mod_len, mod)) {
            return i;
        }
    }
    return -1;
}

function copy_file_module(dst: ascii[], file_idx: i32): bool {
    ascii_clear(dst);

    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return false;
    }

    let off: i32 = stasis.files[file_idx].mod_off;
    let len: i32 = stasis.files[file_idx].mod_len;
    if (len <= 0 || len >= MAX_MOD_BYTES) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        dst[i] = stasis.mod_pool[off + i];
    }
    dst[len] = 0;
    ascii_set_len(dst, len);
    return true;
}

function module_name_from_path(dst: ascii[], path: ascii[]): bool {
    ascii_clear(dst);

    let i_slash: i32 = ascii_find_last_byte(path, 47);
    let i_bslash: i32 = ascii_find_last_byte(path, 92);
    let start: i32 = i_slash;
    if (i_bslash > start) {
        start = i_bslash;
    }
    start = start + 1;
    if (start < 0) {
        start = 0;
    }

    let path_len: i32 = ascii_len(path);
    let end: i32 = path_len;

    let dot: i32 = ascii_find_last_byte(path, 46);
    if (dot > start) {
        end = dot;
    }

    if (end <= start) {
        dst[0] = 109; // m
        dst[1] = 111; // o
        dst[2] = 100; // d
        dst[3] = 117; // u
        dst[4] = 108; // l
        dst[5] = 101; // e
        dst[6] = 0;
        ascii_set_len(dst, 6);
        return true;
    }

    let out_i: i32 = 0;
    if (start < path_len && !ascii_is_alpha(path[start])) {
        if (out_i + 2 < MAX_MOD_BYTES) {
            dst[out_i] = 109; // m
            dst[out_i + 1] = 95; // _
            out_i = out_i + 2;
        }
    }

    let i: i32 = 0;
    for (i = start; i < end && out_i + 1 < MAX_MOD_BYTES; i = i + 1) {
        let b: u8 = path[i];
        if (ascii_is_alpha(b) || ascii_is_digit(b) || b == 95) {
            dst[out_i] = b;
        } else {
            if (b == 45) { // '-'
                dst[out_i] = 95;
            } else {
                dst[out_i] = 95;
            }
        }
        out_i = out_i + 1;
    }

    dst[out_i] = 0;
    ascii_set_len(dst, out_i);
    return out_i > 0;
}

function file_imports_contains(file_idx: i32, imported: i32): bool {
    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return false;
    }

    let off: i32 = stasis.files[file_idx].imports_off;
    let count: i32 = stasis.files[file_idx].imports_len;
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        if (stasis.imports[off + i] == imported) {
            return true;
        }
    }
    return false;
}

function load_file(path: ascii[]): i32 {
    let existing: i32 = find_file(path);
    if (existing >= 0) {
        return existing;
    }

    if (stasis.file_count >= MAX_FILES) {
        if (stasis.quiet == 0) {
            print_string("error: exceeded max import files (300)\n");
        }
        return -1;
    }

    let size: i32 = sys_file_size(path);
    if (size < 0) {
        if (stasis.quiet == 0) {
            print_string("error: unable to stat file: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }
    if (size > MAX_FILE_BYTES) {
        if (stasis.quiet == 0) {
            print_string("error: file exceeds 1MiB limit: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }

    if (stasis.pool_len + size + 1 > POOL_CAP) {
        if (stasis.quiet == 0) {
            print_string("error: exceeded total source pool capacity\n");
        }
        return -1;
    }

    let path_len: i32 = ascii_len(path);
    if (path_len <= 0) {
        if (stasis.quiet == 0) {
            print_string("error: empty path\n");
        }
        return -1;
    }
    if (path_len >= MAX_PATH_BYTES) {
        if (stasis.quiet == 0) {
            print_string("error: path too long (max 260 bytes): ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }
    if (stasis.path_pool_len + path_len + 1 > PATH_POOL_CAP) {
        if (stasis.quiet == 0) {
            print_string("error: exceeded path pool capacity\n");
        }
        return -1;
    }

    if (!module_name_from_path(stasis.scratch_mod, path)) {
        if (stasis.quiet == 0) {
            print_string("error: unable to derive module name: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }

    let mod_len: i32 = ascii_len(stasis.scratch_mod);
    if (mod_len <= 0 || mod_len >= MAX_MOD_BYTES) {
        if (stasis.quiet == 0) {
            print_string("error: module name too long (max 96 bytes)\n");
        }
        return -1;
    }

    if (stasis.mod_pool_len + mod_len + 1 > MOD_POOL_CAP) {
        if (stasis.quiet == 0) {
            print_string("error: exceeded module name pool capacity\n");
        }
        return -1;
    }

    let read_n: i32 = sys_read_file(path, stasis.read, MAX_FILE_BYTES + 1);
    if (read_n < 0) {
        if (stasis.quiet == 0) {
            print_string("error: unable to read file: ");
            print_string(path);
            print_char(10);
        }
        return -1;
    }

    // Copy into the global pool (stable across full graph load).
    let off: i32 = stasis.pool_len;
    let i: i32 = 0;
    for (i = 0; i < read_n; i = i + 1) {
        stasis.pool[off + i] = stasis.read[i];
    }
    stasis.pool[off + read_n] = 0;
    stasis.pool_len = stasis.pool_len + read_n + 1;

    let idx: i32 = stasis.file_count;
    stasis.file_count = stasis.file_count + 1;

    let path_off: i32 = stasis.path_pool_len;
    for (i = 0; i < path_len; i = i + 1) {
        stasis.path_pool[path_off + i] = path[i];
    }
    stasis.path_pool[path_off + path_len] = 0;
    stasis.path_pool_len = stasis.path_pool_len + path_len + 1;

    let mod_off: i32 = stasis.mod_pool_len;
    for (i = 0; i < mod_len; i = i + 1) {
        stasis.mod_pool[mod_off + i] = stasis.scratch_mod[i];
    }
    stasis.mod_pool[mod_off + mod_len] = 0;
    stasis.mod_pool_len = stasis.mod_pool_len + mod_len + 1;

    stasis.files[idx].path_off = path_off;
    stasis.files[idx].path_len = path_len;
    stasis.files[idx].mod_off = mod_off;
    stasis.files[idx].mod_len = mod_len;
    stasis.files[idx].imports_off = 0;
    stasis.files[idx].imports_len = 0;
    stasis.files[idx].syms_off = 0;
    stasis.files[idx].syms_len = 0;
    stasis.files[idx].offset = off;
    stasis.files[idx].len = read_n;
    stasis.files[idx].mtime_ms = sys_file_mtime_ms(path);

    return idx;
}

function copy_file_path(dst: ascii[], file_idx: i32): bool {
    ascii_clear(dst);

    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return false;
    }

    let off: i32 = stasis.files[file_idx].path_off;
    let len: i32 = stasis.files[file_idx].path_len;
    if (len <= 0 || len >= MAX_PATH_BYTES) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        dst[i] = stasis.path_pool[off + i];
    }
    dst[len] = 0;
    ascii_set_len(dst, len);
    return true;
}

function any_file_mtime_changed(): bool {
    let i: i32 = 0;
    for (i = 0; i < stasis.file_count; i = i + 1) {
        if (!copy_file_path(stasis.scratch_watch_path, i)) {
            return true;
        }
        let now: i32 = sys_file_mtime_ms(stasis.scratch_watch_path);
        if (now != stasis.files[i].mtime_ms) {
            return true;
        }
    }
    return false;
}

function try_parse_import(file_idx: i32, line_start: i32, line_end: i32): bool {
    ascii_clear(stasis.scratch_import);

    let base: i32 = stasis.files[file_idx].offset;
    let i: i32 = line_start;
    for (i = i; i < line_end && is_space(stasis.pool[base + i]); i = i + 1) {
    }

    if (i + 6 > line_end) {
        return false;
    }

    if (stasis.pool[base + i + 0] != 105) { return false; } // i
    if (stasis.pool[base + i + 1] != 109) { return false; } // m
    if (stasis.pool[base + i + 2] != 112) { return false; } // p
    if (stasis.pool[base + i + 3] != 111) { return false; } // o
    if (stasis.pool[base + i + 4] != 114) { return false; } // r
    if (stasis.pool[base + i + 5] != 116) { return false; } // t

    i = i + 6;
    for (i = i; i < line_end && is_space(stasis.pool[base + i]); i = i + 1) {
    }

    if (i >= line_end || stasis.pool[base + i] != 34) {
        return false;
    }
    i = i + 1;

    let out_i: i32 = 0;
    for (i = i; i < line_end && stasis.pool[base + i] != 34; i = i + 1) {
        if (out_i + 1 >= MAX_PATH_BYTES) {
            return false;
        }
        stasis.scratch_import[out_i] = stasis.pool[base + i];
        out_i = out_i + 1;
    }

    if (i >= line_end || stasis.pool[base + i] != 34) {
        return false;
    }

    stasis.scratch_import[out_i] = 0;
    ascii_set_len(stasis.scratch_import, out_i);

    i = i + 1;
    for (i = i; i < line_end && is_space(stasis.pool[base + i]); i = i + 1) {
    }

    if (i < line_end && stasis.pool[base + i] == 59) {
        i = i + 1;
        for (i = i; i < line_end && is_space(stasis.pool[base + i]); i = i + 1) {
        }
    }

    return i == line_end;
}

function path_dirname_from_pool(dst: ascii[], path_off: i32, path_len: i32): i32 {
    ascii_clear(dst);

    let cut: i32 = -1;
    let i: i32 = 0;
    for (i = 0; i < path_len; i = i + 1) {
        let b: u8 = stasis.path_pool[path_off + i];
        if (b == 47 || b == 92) {
            cut = i;
        }
    }

    if (cut < 0) {
        return 0;
    }

    let limit: i32 = cut;
    if (limit > MAX_PATH_BYTES - 1) {
        limit = MAX_PATH_BYTES - 1;
    }
    for (i = 0; i < limit; i = i + 1) {
        dst[i] = stasis.path_pool[path_off + i];
    }
    dst[i] = 0;
    ascii_set_len(dst, i);
    return i;
}

function resolve_import(file_idx: i32): bool {
    ascii_clear(stasis.scratch_resolved);
    if (path_is_abs(stasis.scratch_import)) {
        ascii_copy(stasis.scratch_resolved, stasis.scratch_import);
        return path_normalize_inplace(stasis.scratch_resolved);
    }

    path_dirname_from_pool(stasis.scratch_dir, stasis.files[file_idx].path_off, stasis.files[file_idx].path_len);
    path_join(stasis.scratch_resolved, stasis.scratch_dir, stasis.scratch_import);
    return path_normalize_inplace(stasis.scratch_resolved);
}

function scan_file_imports(file_idx: i32): bool {
    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return false;
    }

    stasis.files[file_idx].imports_off = stasis.imports_len;
    stasis.files[file_idx].imports_len = 0;

    let base: i32 = stasis.files[file_idx].offset;
    let len: i32 = stasis.files[file_idx].len;

    let line_start: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i <= len; i = i + 1) {
        let is_end: bool = i == len;
        let b: u8 = 10;
        if (!is_end) {
            b = stasis.pool[base + i];
        }

        if (b == 10 || is_end) {
            let line_end: i32 = i;
            if (line_end > line_start && stasis.pool[base + line_end - 1] == 13) {
                line_end = line_end - 1;
            }

            if (try_parse_import(file_idx, line_start, line_end)) {
                if (!resolve_import(file_idx)) {
                    return false;
                }
                let imported: i32 = load_file(stasis.scratch_resolved);
                if (imported < 0) {
                    return false;
                }

                if (!file_imports_contains(file_idx, imported)) {
                    if (stasis.imports_len >= IMPORTS_CAP) {
                        if (stasis.quiet == 0) {
                            print_string("error: exceeded import edge capacity\n");
                        }
                        return false;
                    }
                    stasis.imports[stasis.imports_len] = imported;
                    stasis.imports_len = stasis.imports_len + 1;
                    stasis.files[file_idx].imports_len = stasis.files[file_idx].imports_len + 1;
                }
            }

            line_start = i + 1;
        }
    }

    return true;
}

function load_graph(entry_path: ascii[]): i32 {
    reset();

    ascii_copy(stasis.scratch_resolved, entry_path);
    if (!path_normalize_inplace(stasis.scratch_resolved)) {
        if (stasis.quiet == 0) {
            print_string("error: unable to normalize entry path\n");
        }
        return 1;
    }

    let entry: i32 = load_file(stasis.scratch_resolved);
    if (entry < 0) {
        return 1;
    }

    let i: i32 = 0;
    for (i = 0; i < stasis.file_count; i = i + 1) {
        if (!scan_file_imports(i)) {
            return 1;
        }
    }

    return 0;
}
