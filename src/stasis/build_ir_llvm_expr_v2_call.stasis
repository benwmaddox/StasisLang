                                                        ascii_append(sh.ir_out, " = getelementptr inbounds [3 x i8], ptr @.stasis_fmt_c, i32 0, i32 0\n");
    
                                                        let out_id11: i32 = sh_llvm_new_tmp();
                                                        ascii_append(sh.ir_out, "  ");
                                                        sh_llvm_append_tmp(out_id11);
                                                        ascii_append(sh.ir_out, " = call i32 (ptr, ...) @printf(ptr ");
