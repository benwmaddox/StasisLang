        }

        // Standard library: char_* (character/byte utilities).
        if (handled_intr == 0 && sh_span_eq(file_idx, cname_start2, cname_len2, "char_is_digit")) {
            handled_intr = 1;
            if (argc != 1) {
                sh_build_err_at(file_idx, "char_is_digit expects 1 argument", sh.expr_nodes[idx2].at);
                return -1;
            }
            if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.I32) {
                sh_build_err_at(file_idx, "char_is_digit expects i32 argument (u8 value)", sh.expr_nodes[idx2].at);
                return -1;
            }

            c_id = sh.expr_op_at[arg_base];
            is_digit_i1 = sh_llvm_emit_range_i1(c_id, 48, 57);
            out_id = sh_llvm_emit_zext_i1_to_i32(is_digit_i1);

            val_len = arg_base;
            sh.expr_op_at[val_len] = out_id;
            sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
            sh.llvm_val_struct_idx[val_len] = -1;
