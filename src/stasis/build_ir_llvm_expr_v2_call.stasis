import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call_user.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_emit_expr_i32_v2_post_call(file_idx: i32, idx2: i32, mode2: i32, val_len: i32): i32 {
    // Large call lowering extracted from llvm_emit_expr_i32_v2 to keep files <50KiB.
    // Assumes the argument values are already on st.expr_op_at / st.llvm_val_kind stacks.
    let kind2: ExprKind = stasis.expr_nodes[idx2].kind;
    if (kind2 != ExprKind.Call) {
        build_err_at(file_idx, "internal error: expected call expression", stasis.expr_nodes[idx2].at);
        return -1;
    }

    if (mode2 != 0) {
        build_err_at(file_idx, "invalid assignment target", stasis.expr_nodes[idx2].at);
        return -1;
    }
    
    let argc: i32 = stasis.expr_nodes[idx2].value;
    let callee_expr: i32 = stasis.expr_nodes[idx2].left;
    if (argc < 0 || val_len < argc) {
        build_err_at(file_idx, "invalid call expression", stasis.expr_nodes[idx2].at);
        return -1;
    }
    
    let arg_base: i32 = val_len - argc;

    // Scratch locals (stage1 disallows duplicate local names in a function).
    let out_id: i32 = 0;
    let out_id0: i32 = 0;
    let out_id2: i32 = 0;
    let c_id: i32 = 0;
    let d_id: i32 = 0;
    let digit_id: i32 = 0;
    let lower_id: i32 = 0;
    let upper_id: i32 = 0;
    let minus1: i32 = 0;
    let q: i32 = 0;
    let is_digit: i32 = 0;
    let is_digit_i1: i32 = 0;
    let lower_i1: i32 = 0;
    let upper_i1: i32 = 0;
    let is_alpha_i1: i32 = 0;
    let is_lower: i32 = 0;
    let is_lower_i1: i32 = 0;
    let is_upper: i32 = 0;
    let is_upper_i1: i32 = 0;
    
    // Intrinsics (llvm bring-up).
    let handled_intr: i32 = 0;
    let callee_kind2: ExprKind = stasis.expr_nodes[callee_expr].kind;
    if (callee_kind2 == ExprKind.Name) {
        let cname_start: i32 = stasis.expr_nodes[callee_expr].name_start;
        let cname_len: i32 = stasis.expr_nodes[callee_expr].name_len;
    
        if (span_eq(file_idx, cname_start, cname_len, "u8_to_i32")) {
            handled_intr = 1;
            if (argc != 1) {
                build_err_at(file_idx, "u8_to_i32 expects 1 argument", stasis.expr_nodes[idx2].at);
                return -1;
            }
            if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32) {
                build_err_at(file_idx, "u8_to_i32 expects i32 value (llvm bring-up)", stasis.expr_nodes[idx2].at);
                return -1;
            }
            out_id = stasis.expr_op_at[arg_base];
            val_len = arg_base;
            stasis.expr_op_at[val_len] = out_id;
            stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
            stasis.llvm_val_struct_idx[val_len] = -1;
            val_len = val_len + 1;
        } else {
            if (span_eq(file_idx, cname_start, cname_len, "i32_to_u8_trunc")) {
                handled_intr = 1;
                if (argc != 1) {
                    build_err_at(file_idx, "i32_to_u8_trunc expects 1 argument", stasis.expr_nodes[idx2].at);
                    return -1;
                }
                if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32) {
                    build_err_at(file_idx, "i32_to_u8_trunc expects i32 value", stasis.expr_nodes[idx2].at);
                    return -1;
                }
    
                let in_id: i32 = stasis.expr_op_at[arg_base];
                out_id2 = llvm_new_tmp();
                ascii_append(stasis.ir_out, "  ");
                llvm_append_tmp(out_id2);
                ascii_append(stasis.ir_out, " = and i32 ");
                llvm_append_tmp(in_id);
                ascii_append(stasis.ir_out, ", 255\n");
    
                val_len = arg_base;
                stasis.expr_op_at[val_len] = out_id2;
                stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                stasis.llvm_val_struct_idx[val_len] = -1;
                val_len = val_len + 1;
            } else {
                if (span_eq(file_idx, cname_start, cname_len, "i32_to_f32")) {
                    handled_intr = 1;
                    if (argc != 1) {
                        build_err_at(file_idx, "i32_to_f32 expects 1 argument", stasis.expr_nodes[idx2].at);
                        return -1;
                    }
                    if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32) {
                        build_err_at(file_idx, "i32_to_f32 expects i32 argument", stasis.expr_nodes[idx2].at);
                        return -1;
                    }

                    out_id2 = llvm_new_tmp();
                    ascii_append(stasis.ir_out, "  ");
                    llvm_append_tmp(out_id2);
                    ascii_append(stasis.ir_out, " = sitofp i32 ");
                    llvm_append_tmp(stasis.expr_op_at[arg_base]);
                    ascii_append(stasis.ir_out, " to float\n");

                    val_len = arg_base;
                    stasis.expr_op_at[val_len] = out_id2;
                    stasis.llvm_val_kind[val_len] = LlvmValueKind.F32;
                    stasis.llvm_val_struct_idx[val_len] = -1;
                    val_len = val_len + 1;
                } else {
                    if (span_eq(file_idx, cname_start, cname_len, "f32_to_i32")) {
                        handled_intr = 1;
                        if (argc != 1) {
                            build_err_at(file_idx, "f32_to_i32 expects 1 argument", stasis.expr_nodes[idx2].at);
                            return -1;
                        }
                        if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.F32) {
                            build_err_at(file_idx, "f32_to_i32 expects f32 argument", stasis.expr_nodes[idx2].at);
                            return -1;
                        }

                        out_id2 = llvm_new_tmp();
                        ascii_append(stasis.ir_out, "  ");
                        llvm_append_tmp(out_id2);
                        ascii_append(stasis.ir_out, " = fptosi float ");
                        llvm_append_tmp(stasis.expr_op_at[arg_base]);
                        ascii_append(stasis.ir_out, " to i32\n");

                        val_len = arg_base;
                        stasis.expr_op_at[val_len] = out_id2;
                        stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                        stasis.llvm_val_struct_idx[val_len] = -1;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }
    
    // Builtins (llvm bring-up).
    if (handled_intr == 0 && callee_kind2 == ExprKind.Name) {
        let cname_start2: i32 = stasis.expr_nodes[callee_expr].name_start;
        let cname_len2: i32 = stasis.expr_nodes[callee_expr].name_len;
    
        if (span_eq(file_idx, cname_start2, cname_len2, "sys_argc")) {
            handled_intr = 1;
            if (argc != 0) {
                build_err_at(file_idx, "sys_argc expects 0 arguments", stasis.expr_nodes[idx2].at);
                return -1;
            }
    
            out_id0 = llvm_new_tmp();
            ascii_append(stasis.ir_out, "  ");
            llvm_append_tmp(out_id0);
            ascii_append(stasis.ir_out, " = call i32 @stasis_sys_argc()\n");
    
            val_len = arg_base;
            stasis.expr_op_at[val_len] = out_id0;
            stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
            stasis.llvm_val_struct_idx[val_len] = -1;
            val_len = val_len + 1;
        } else {
            if (span_eq(file_idx, cname_start2, cname_len2, "sys_argv")) {
                handled_intr = 1;
                if (argc != 3) {
                    build_err_at(file_idx, "sys_argv expects 3 arguments", stasis.expr_nodes[idx2].at);
                    return -1;
                }
                if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32 || stasis.llvm_val_kind[arg_base + 2] != LlvmValueKind.I32) {
                    build_err_at(file_idx, "sys_argv expects i32 arguments (idx, out_cap)", stasis.expr_nodes[idx2].at);
                    return -1;
                }
                if (stasis.llvm_val_kind[arg_base + 1] != LlvmValueKind.PtrI8) {
                    build_err_at(file_idx, "sys_argv expects pointer argument (out)", stasis.expr_nodes[idx2].at);
                    return -1;
                }
    
                let out_id1: i32 = llvm_new_tmp();
                ascii_append(stasis.ir_out, "  ");
                llvm_append_tmp(out_id1);
                ascii_append(stasis.ir_out, " = call i32 @stasis_sys_argv(i32 ");
                llvm_append_tmp(stasis.expr_op_at[arg_base]);
                ascii_append(stasis.ir_out, ", ptr ");
                llvm_append_tmp(stasis.expr_op_at[arg_base + 1]);
                ascii_append(stasis.ir_out, ", i32 ");
                llvm_append_tmp(stasis.expr_op_at[arg_base + 2]);
                ascii_append(stasis.ir_out, ")\n");
    
                val_len = arg_base;
                stasis.expr_op_at[val_len] = out_id1;
                stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                stasis.llvm_val_struct_idx[val_len] = -1;
                val_len = val_len + 1;
            } else {
                if (span_eq(file_idx, cname_start2, cname_len2, "sys_read_file")) {
                    handled_intr = 1;
                    if (argc != 3) {
                        build_err_at(file_idx, "sys_read_file expects 3 arguments", stasis.expr_nodes[idx2].at);
                        return -1;
                    }
                    if (stasis.llvm_val_kind[arg_base + 2] != LlvmValueKind.I32) {
                        build_err_at(file_idx, "sys_read_file expects i32 argument (out_cap)", stasis.expr_nodes[idx2].at);
                        return -1;
                    }
                    if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8 || stasis.llvm_val_kind[arg_base + 1] != LlvmValueKind.PtrI8) {
                        build_err_at(file_idx, "sys_read_file expects pointer arguments (path, out)", stasis.expr_nodes[idx2].at);
                        return -1;
                    }
    
                    out_id2 = llvm_new_tmp();
                    ascii_append(stasis.ir_out, "  ");
                    llvm_append_tmp(out_id2);
                    ascii_append(stasis.ir_out, " = call i32 @stasis_sys_read_file(ptr ");
                    llvm_append_tmp(stasis.expr_op_at[arg_base]);
                    ascii_append(stasis.ir_out, ", ptr ");
                    llvm_append_tmp(stasis.expr_op_at[arg_base + 1]);
                    ascii_append(stasis.ir_out, ", i32 ");
                    llvm_append_tmp(stasis.expr_op_at[arg_base + 2]);
                    ascii_append(stasis.ir_out, ")\n");
    
                    val_len = arg_base;
                    stasis.expr_op_at[val_len] = out_id2;
                    stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                    stasis.llvm_val_struct_idx[val_len] = -1;
                    val_len = val_len + 1;
                } else {
                    if (span_eq(file_idx, cname_start2, cname_len2, "sys_write_file")) {
                        handled_intr = 1;
                        if (argc != 3) {
                            build_err_at(file_idx, "sys_write_file expects 3 arguments", stasis.expr_nodes[idx2].at);
                            return -1;
                        }
                        if (stasis.llvm_val_kind[arg_base + 2] != LlvmValueKind.I32) {
                            build_err_at(file_idx, "sys_write_file expects i32 argument (len)", stasis.expr_nodes[idx2].at);
                            return -1;
                        }
                        if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8 || stasis.llvm_val_kind[arg_base + 1] != LlvmValueKind.PtrI8) {
                            build_err_at(file_idx, "sys_write_file expects pointer arguments (path, data)", stasis.expr_nodes[idx2].at);
                            return -1;
                        }
    
                        let out_id3: i32 = llvm_new_tmp();
                        ascii_append(stasis.ir_out, "  ");
                        llvm_append_tmp(out_id3);
                        ascii_append(stasis.ir_out, " = call i32 @stasis_sys_write_file(ptr ");
                        llvm_append_tmp(stasis.expr_op_at[arg_base]);
                        ascii_append(stasis.ir_out, ", ptr ");
                        llvm_append_tmp(stasis.expr_op_at[arg_base + 1]);
                        ascii_append(stasis.ir_out, ", i32 ");
                        llvm_append_tmp(stasis.expr_op_at[arg_base + 2]);
                        ascii_append(stasis.ir_out, ")\n");
    
                        val_len = arg_base;
                        stasis.expr_op_at[val_len] = out_id3;
                        stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                        stasis.llvm_val_struct_idx[val_len] = -1;
                        val_len = val_len + 1;
                    } else {
                        if (span_eq(file_idx, cname_start2, cname_len2, "sys_file_exists")) {
                            handled_intr = 1;
                            if (argc != 1) {
                                build_err_at(file_idx, "sys_file_exists expects 1 argument", stasis.expr_nodes[idx2].at);
                                return -1;
                            }
                            if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8) {
                                build_err_at(file_idx, "sys_file_exists expects pointer argument (path)", stasis.expr_nodes[idx2].at);
                                return -1;
                            }
    
                            let out_id4: i32 = llvm_new_tmp();
                            ascii_append(stasis.ir_out, "  ");
                            llvm_append_tmp(out_id4);
                            ascii_append(stasis.ir_out, " = call i32 @stasis_sys_file_exists(ptr ");
                            llvm_append_tmp(stasis.expr_op_at[arg_base]);
                            ascii_append(stasis.ir_out, ")\n");
    
                            val_len = arg_base;
                            stasis.expr_op_at[val_len] = out_id4;
                            stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                            stasis.llvm_val_struct_idx[val_len] = -1;
                            val_len = val_len + 1;
                        } else {
                            if (span_eq(file_idx, cname_start2, cname_len2, "sys_file_size")) {
                                handled_intr = 1;
                                if (argc != 1) {
                                    build_err_at(file_idx, "sys_file_size expects 1 argument", stasis.expr_nodes[idx2].at);
                                    return -1;
                                }
                                if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8) {
                                    build_err_at(file_idx, "sys_file_size expects pointer argument (path)", stasis.expr_nodes[idx2].at);
                                    return -1;
                                }
    
                                let out_id5: i32 = llvm_new_tmp();
                                ascii_append(stasis.ir_out, "  ");
                                llvm_append_tmp(out_id5);
                                ascii_append(stasis.ir_out, " = call i32 @stasis_sys_file_size(ptr ");
                                llvm_append_tmp(stasis.expr_op_at[arg_base]);
                                ascii_append(stasis.ir_out, ")\n");
    
                                val_len = arg_base;
                                stasis.expr_op_at[val_len] = out_id5;
                                stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                                stasis.llvm_val_struct_idx[val_len] = -1;
                                val_len = val_len + 1;
                            } else {
                                if (span_eq(file_idx, cname_start2, cname_len2, "sys_file_mtime_ms")) {
                                    handled_intr = 1;
                                    if (argc != 1) {
                                        build_err_at(file_idx, "sys_file_mtime_ms expects 1 argument", stasis.expr_nodes[idx2].at);
                                        return -1;
                                    }
                                    if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8) {
                                        build_err_at(file_idx, "sys_file_mtime_ms expects pointer argument (path)", stasis.expr_nodes[idx2].at);
                                        return -1;
                                    }
    
                                    let out_id6: i32 = llvm_new_tmp();
                                    ascii_append(stasis.ir_out, "  ");
                                    llvm_append_tmp(out_id6);
                                    ascii_append(stasis.ir_out, " = call i32 @stasis_sys_file_mtime_ms(ptr ");
                                    llvm_append_tmp(stasis.expr_op_at[arg_base]);
                                    ascii_append(stasis.ir_out, ")\n");
    
                                    val_len = arg_base;
                                    stasis.expr_op_at[val_len] = out_id6;
                                    stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                                    stasis.llvm_val_struct_idx[val_len] = -1;
                                    val_len = val_len + 1;
                                } else {
                                    if (span_eq(file_idx, cname_start2, cname_len2, "sys_exec")) {
                                        handled_intr = 1;
                                        if (argc != 1) {
                                            build_err_at(file_idx, "sys_exec expects 1 argument", stasis.expr_nodes[idx2].at);
                                            return -1;
                                        }
                                        if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8) {
                                            build_err_at(file_idx, "sys_exec expects pointer argument (command)", stasis.expr_nodes[idx2].at);
                                            return -1;
                                        }
    
                                        let out_id7: i32 = llvm_new_tmp();
                                        ascii_append(stasis.ir_out, "  ");
                                        llvm_append_tmp(out_id7);
                                        ascii_append(stasis.ir_out, " = call i32 @stasis_sys_exec(ptr ");
                                        llvm_append_tmp(stasis.expr_op_at[arg_base]);
                                        ascii_append(stasis.ir_out, ")\n");
    
                                        val_len = arg_base;
                                        stasis.expr_op_at[val_len] = out_id7;
                                        stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                                        stasis.llvm_val_struct_idx[val_len] = -1;
                                        val_len = val_len + 1;
                                    } else {
                                        if (span_eq(file_idx, cname_start2, cname_len2, "sys_sleep_ms")) {
                                            handled_intr = 1;
                                            if (argc != 1) {
                                                build_err_at(file_idx, "sys_sleep_ms expects 1 argument", stasis.expr_nodes[idx2].at);
                                                return -1;
                                            }
                                            if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32) {
                                                build_err_at(file_idx, "sys_sleep_ms expects i32 argument (ms)", stasis.expr_nodes[idx2].at);
                                                return -1;
                                            }
    
                                            let out_id8: i32 = llvm_new_tmp();
                                            ascii_append(stasis.ir_out, "  ");
                                            llvm_append_tmp(out_id8);
                                            ascii_append(stasis.ir_out, " = call i32 @stasis_sys_sleep_ms(i32 ");
                                            llvm_append_tmp(stasis.expr_op_at[arg_base]);
                                            ascii_append(stasis.ir_out, ")\n");
    
                                            val_len = arg_base;
                                            stasis.expr_op_at[val_len] = out_id8;
                                            stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                                            stasis.llvm_val_struct_idx[val_len] = -1;
                                            val_len = val_len + 1;
                                        } else {
                                            if (span_eq(file_idx, cname_start2, cname_len2, "print_string") || span_eq(file_idx, cname_start2, cname_len2, "print")) {
                                                handled_intr = 1;
                                                if (argc != 1) {
                                                    build_err_at(file_idx, "print_string expects 1 argument", stasis.expr_nodes[idx2].at);
                                                    return -1;
                                                }
                                                if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.PtrI8) {
                                                    build_err_at(file_idx, "print_string expects pointer argument (utf8/ascii)", stasis.expr_nodes[idx2].at);
                                                    return -1;
                                                }
    
                                                let fmt_ptr: i32 = llvm_new_tmp();
                                                ascii_append(stasis.ir_out, "  ");
                                                llvm_append_tmp(fmt_ptr);
                                                ascii_append(stasis.ir_out, " = getelementptr inbounds [3 x i8], ptr @.stasis_fmt_s, i32 0, i32 0\n");
    
                                                let out_id9: i32 = llvm_new_tmp();
                                                ascii_append(stasis.ir_out, "  ");
                                                llvm_append_tmp(out_id9);
                                                ascii_append(stasis.ir_out, " = call i32 (ptr, ...) @printf(ptr ");
                                                llvm_append_tmp(fmt_ptr);
                                                ascii_append(stasis.ir_out, ", ptr ");
                                                llvm_append_tmp(stasis.expr_op_at[arg_base]);
                                                ascii_append(stasis.ir_out, ")\n");
    
                                                val_len = arg_base;
                                                stasis.expr_op_at[val_len] = out_id9;
                                                stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                                                stasis.llvm_val_struct_idx[val_len] = -1;
                                                val_len = val_len + 1;
                                            } else {
                                                if (span_eq(file_idx, cname_start2, cname_len2, "print_int")) {
                                                    handled_intr = 1;
                                                    if (argc != 1) {
                                                        build_err_at(file_idx, "print_int expects 1 argument", stasis.expr_nodes[idx2].at);
                                                        return -1;
                                                    }
                                                    if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32) {
                                                        build_err_at(file_idx, "print_int expects i32 argument", stasis.expr_nodes[idx2].at);
                                                        return -1;
                                                    }
    
                                                    let fmt_ptr2: i32 = llvm_new_tmp();
                                                    ascii_append(stasis.ir_out, "  ");
                                                    llvm_append_tmp(fmt_ptr2);
                                                    ascii_append(stasis.ir_out, " = getelementptr inbounds [4 x i8], ptr @.stasis_fmt_d, i32 0, i32 0\n");
    
                                                    let out_id10: i32 = llvm_new_tmp();
                                                    ascii_append(stasis.ir_out, "  ");
                                                    llvm_append_tmp(out_id10);
                                                    ascii_append(stasis.ir_out, " = call i32 (ptr, ...) @printf(ptr ");
                                                    llvm_append_tmp(fmt_ptr2);
                                                    ascii_append(stasis.ir_out, ", i32 ");
                                                    llvm_append_tmp(stasis.expr_op_at[arg_base]);
                                                    ascii_append(stasis.ir_out, ")\n");
    
                                                    val_len = arg_base;
                                                    stasis.expr_op_at[val_len] = out_id10;
                                                    stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
                                                    stasis.llvm_val_struct_idx[val_len] = -1;
                                                    val_len = val_len + 1;
                                                } else {
                                                    if (span_eq(file_idx, cname_start2, cname_len2, "print_char")) {
                                                        handled_intr = 1;
                                                        if (argc != 1) {
                                                            build_err_at(file_idx, "print_char expects 1 argument", stasis.expr_nodes[idx2].at);
                                                            return -1;
                                                        }
                                                        if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.I32) {
                                                            build_err_at(file_idx, "print_char expects i32 argument", stasis.expr_nodes[idx2].at);
                                                            return -1;
                                                        }
    
                                                        let fmt_ptr3: i32 = llvm_new_tmp();
