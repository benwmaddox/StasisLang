import "../stdlib/stdlib.stasis";
import "state.stasis";
import "expr_parse.stasis";

// Iterative (stack-based) evaluator for i32/bool constant expressions.
// Sets stasis.expr_eval_failed for non-constant nodes.
function expr_eval_i32_const(root: i32): i32 {
    stasis.expr_eval_failed = 0;
    if (root < 0) {
        stasis.expr_eval_failed = 1;
        return 0;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;

    // Node stack uses stasis.parse_stack_start; visited flag is encoded by negating the index.
    stasis.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = stasis.parse_stack_start[sp - 1];
        if (top >= 0) {
            stasis.parse_stack_start[sp - 1] = -top - 1;

            let kind: ExprKind = stasis.expr_nodes[top].kind;
            if (kind == ExprKind.Unary) {
                if (sp >= EXPR_STACK_CAP) { stasis.expr_eval_failed = 1; return 0; }
                stasis.parse_stack_start[sp] = stasis.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ExprKind.Binary || kind == ExprKind.Assign) {
                    if (sp + 1 >= EXPR_STACK_CAP) { stasis.expr_eval_failed = 1; return 0; }
                    stasis.parse_stack_start[sp] = stasis.expr_nodes[top].right;
                    sp = sp + 1;
                    stasis.parse_stack_start[sp] = stasis.expr_nodes[top].left;
                    sp = sp + 1;
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= EXPR_STACK_CAP) { stasis.expr_eval_failed = 1; return 0; }

            let kind2: ExprKind = stasis.expr_nodes[idx].kind;
            if (kind2 == ExprKind.IntLiteral || kind2 == ExprKind.BoolLiteral) {
                stasis.expr_op_at[val_len] = stasis.expr_nodes[idx].value;
                val_len = val_len + 1;
            } else {
                if (kind2 == ExprKind.Unary) {
                    if (val_len < 1) { stasis.expr_eval_failed = 1; return 0; }
                    let v: i32 = stasis.expr_op_at[val_len - 1];
                    val_len = val_len - 1;

                    let r: i32 = 0;
                    let op: Tok = stasis.expr_nodes[idx].op;
                    if (op == Tok.UnaryMinus) {
                        r = -v;
                    } else {
                        if (op == Tok.Bang) {
                            r = 0;
                            if (v == 0) { r = 1; }
                        } else {
                            if (stasis.expr_eval_failed == 0) {
                                expr_err_at(stasis.expr_nodes[idx].file_idx, "unsupported unary operator in const expression", stasis.expr_nodes[idx].at);
                            }
                            stasis.expr_eval_failed = 1;
                        }
                    }

                    stasis.expr_op_at[val_len] = r;
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ExprKind.Binary) {
                        if (val_len < 2) { stasis.expr_eval_failed = 1; return 0; }
                        let b: i32 = stasis.expr_op_at[val_len - 1];
                        let a: i32 = stasis.expr_op_at[val_len - 2];
                        val_len = val_len - 2;

                        let r2: i32 = 0;
                        let handled: i32 = 0;
                        let op2: Tok = stasis.expr_nodes[idx].op;
                        let at: i32 = stasis.expr_nodes[idx].at;
                        let src_file: i32 = stasis.expr_nodes[idx].file_idx;

                        if (op2 == Tok.Plus) { r2 = a + b; handled = 1; }
                        if (op2 == Tok.Minus) { r2 = a - b; handled = 1; }
                        if (op2 == Tok.Star) { r2 = a * b; handled = 1; }
                        if (op2 == Tok.Slash) {
                            handled = 1;
                            if (b == 0) {
                                expr_err_at(src_file, "division by zero", at);
                                stasis.expr_eval_failed = 1;
                                r2 = 0;
                            } else {
                                r2 = a / b;
                            }
                        }
                        if (op2 == Tok.Percent) {
                            handled = 1;
                            if (b == 0) {
                                expr_err_at(src_file, "modulo by zero", at);
                                stasis.expr_eval_failed = 1;
                                r2 = 0;
                            } else {
                                r2 = a % b;
                            }
                        }

                        if (op2 == Tok.EqualEqual) { r2 = 0; if (a == b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.BangEqual) { r2 = 0; if (a != b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Less) { r2 = 0; if (a < b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.LessEqual) { r2 = 0; if (a <= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Greater) { r2 = 0; if (a > b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.GreaterEqual) { r2 = 0; if (a >= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.AmpAmp) { r2 = 0; if (a != 0 && b != 0) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.PipePipe) { r2 = 0; if (a != 0 || b != 0) { r2 = 1; } handled = 1; }

                        if (handled == 0) {
                            if (stasis.expr_eval_failed == 0) {
                                expr_err_at(src_file, "unsupported operator in const expression", at);
                            }
                            stasis.expr_eval_failed = 1;
                            r2 = 0;
                        }

                        stasis.expr_op_at[val_len] = r2;
                        val_len = val_len + 1;
                    } else {
                        if (stasis.expr_eval_failed == 0) {
                            if (kind2 == ExprKind.Name) {
                                expr_err_at(stasis.expr_nodes[idx].file_idx, "non-constant identifier in expression (minimal build only)", stasis.expr_nodes[idx].at);
                            } else {
                                if (kind2 == ExprKind.Assign) {
                                    expr_err_at(stasis.expr_nodes[idx].file_idx, "assignment in constant expression (minimal build only)", stasis.expr_nodes[idx].at);
                                } else {
                                    expr_err_at(stasis.expr_nodes[idx].file_idx, "non-constant expression (minimal build only)", stasis.expr_nodes[idx].at);
                                }
                            }
                        }
                        stasis.expr_eval_failed = 1;
                        stasis.expr_op_at[val_len] = 0;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }

    if (val_len != 1) {
        stasis.expr_eval_failed = 1;
        return 0;
    }
    return stasis.expr_op_at[0];
}

// Silent i32/bool constant evaluator:
// - Never prints diagnostics.
// - Sets stasis.expr_eval_failed != 0 when the expression is not a pure constant expression.
function expr_try_eval_i32_const(root: i32): i32 {
    stasis.expr_eval_failed = 0;
    if (root < 0) {
        stasis.expr_eval_failed = 1;
        return 0;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;

    stasis.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = stasis.parse_stack_start[sp - 1];
        if (top >= 0) {
            stasis.parse_stack_start[sp - 1] = -top - 1;

            let kind: ExprKind = stasis.expr_nodes[top].kind;
            if (kind == ExprKind.Unary) {
                if (sp >= EXPR_STACK_CAP) { stasis.expr_eval_failed = 1; return 0; }
                stasis.parse_stack_start[sp] = stasis.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ExprKind.Binary || kind == ExprKind.Assign) {
                    if (sp + 1 >= EXPR_STACK_CAP) { stasis.expr_eval_failed = 1; return 0; }
                    stasis.parse_stack_start[sp] = stasis.expr_nodes[top].right;
                    sp = sp + 1;
                    stasis.parse_stack_start[sp] = stasis.expr_nodes[top].left;
                    sp = sp + 1;
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= EXPR_STACK_CAP) { stasis.expr_eval_failed = 1; return 0; }

            let kind2: ExprKind = stasis.expr_nodes[idx].kind;
            if (kind2 == ExprKind.IntLiteral || kind2 == ExprKind.BoolLiteral) {
                stasis.expr_op_at[val_len] = stasis.expr_nodes[idx].value;
                val_len = val_len + 1;
            } else {
                if (kind2 == ExprKind.Unary) {
                    if (val_len < 1) { stasis.expr_eval_failed = 1; return 0; }
                    let v: i32 = stasis.expr_op_at[val_len - 1];
                    val_len = val_len - 1;

                    let r: i32 = 0;
                    let op: Tok = stasis.expr_nodes[idx].op;
                    if (op == Tok.UnaryMinus) { r = -v; }
                    else { if (op == Tok.Bang) { r = 0; if (v == 0) { r = 1; } }
                    else { stasis.expr_eval_failed = 1; r = 0; } }

                    stasis.expr_op_at[val_len] = r;
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ExprKind.Binary) {
                        if (val_len < 2) { stasis.expr_eval_failed = 1; return 0; }
                        let b: i32 = stasis.expr_op_at[val_len - 1];
                        let a: i32 = stasis.expr_op_at[val_len - 2];
                        val_len = val_len - 2;

                        let r2: i32 = 0;
                        let handled: i32 = 0;
                        let op2: Tok = stasis.expr_nodes[idx].op;

                        if (op2 == Tok.Plus) { r2 = a + b; handled = 1; }
                        if (op2 == Tok.Minus) { r2 = a - b; handled = 1; }
                        if (op2 == Tok.Star) { r2 = a * b; handled = 1; }
                        if (op2 == Tok.Slash) { handled = 1; if (b == 0) { stasis.expr_eval_failed = 1; r2 = 0; } else { r2 = a / b; } }
                        if (op2 == Tok.Percent) { handled = 1; if (b == 0) { stasis.expr_eval_failed = 1; r2 = 0; } else { r2 = a % b; } }

                        if (op2 == Tok.EqualEqual) { r2 = 0; if (a == b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.BangEqual) { r2 = 0; if (a != b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Less) { r2 = 0; if (a < b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.LessEqual) { r2 = 0; if (a <= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Greater) { r2 = 0; if (a > b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.GreaterEqual) { r2 = 0; if (a >= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.AmpAmp) { r2 = 0; if (a != 0 && b != 0) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.PipePipe) { r2 = 0; if (a != 0 || b != 0) { r2 = 1; } handled = 1; }

                        if (handled == 0) {
                            stasis.expr_eval_failed = 1;
                            r2 = 0;
                        }

                        stasis.expr_op_at[val_len] = r2;
                        val_len = val_len + 1;
                    } else {
                        stasis.expr_eval_failed = 1;
                        stasis.expr_op_at[val_len] = 0;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }

    if (val_len != 1) {
        stasis.expr_eval_failed = 1;
        return 0;
    }
    return stasis.expr_op_at[0];
}

