import "../stdlib/stdlib.stasis";
import "state.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_types.stasis";

function mir_emit_llvm_tmp_for_value(value_id: i32): void {
    // In this initial MIR bring-up, every value-producing MIR instruction maps 1:1 to an LLVM %tN.
    // Some instructions expand to multiple LLVM instructions (e.g. icmp -> zext), so keep a mapping.
    llvm_append_tmp(stasis.mir_value_llvm_tmp[value_id]);
}

function mir_emit_llvm_from_mir_i32(file_idx: i32, exit_label: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.mir_inst_count; i = i + 1) {
        let k: MirInstKind = stasis.mir_insts[i].kind;
        let at: i32 = stasis.mir_insts[i].at;

        // Default mapping for value-producing insts: MIR id -> same-numbered LLVM tmp.
        stasis.mir_value_llvm_tmp[i] = i;

        if (k == MirInstKind.ConstI32) {
            ascii_append(stasis.ir_out, "  ");
            llvm_append_tmp(i);
            ascii_append(stasis.ir_out, " = add i32 0, ");
            ir_append_i32(stasis.ir_out, stasis.mir_insts[i].imm_i32);
            ascii_append(stasis.ir_out, "\n");
        } else {
            if (k == MirInstKind.LoadLocalI32) {
                let local_id: i32 = stasis.mir_insts[i].a;
                ascii_append(stasis.ir_out, "  ");
                llvm_append_tmp(i);
                ascii_append(stasis.ir_out, " = load i32, ptr ");
                llvm_append_local_ptr(local_id);
                ascii_append(stasis.ir_out, ", align 4\n");
            } else {
                if (k == MirInstKind.StoreLocalI32) {
                    let local_id2: i32 = stasis.mir_insts[i].a;
                    let v_id: i32 = stasis.mir_insts[i].b;
                    ascii_append(stasis.ir_out, "  store i32 ");
                    mir_emit_llvm_tmp_for_value(v_id);
                    ascii_append(stasis.ir_out, ", ptr ");
                    llvm_append_local_ptr(local_id2);
                    ascii_append(stasis.ir_out, ", align 4\n");
                } else {
                    if (k == MirInstKind.NegI32) {
                        let v0: i32 = stasis.mir_insts[i].a;
                        ascii_append(stasis.ir_out, "  ");
                        llvm_append_tmp(i);
                        ascii_append(stasis.ir_out, " = sub i32 0, ");
                        mir_emit_llvm_tmp_for_value(v0);
                        ascii_append(stasis.ir_out, "\n");
                    } else {
                        if (k == MirInstKind.NotI32) {
                            let v1: i32 = stasis.mir_insts[i].a;
                            ascii_append(stasis.ir_out, "  ");
                            llvm_append_tmp(i);
                            ascii_append(stasis.ir_out, " = icmp eq i32 ");
                            mir_emit_llvm_tmp_for_value(v1);
                            ascii_append(stasis.ir_out, ", 0\n");

                            let z: i32 = llvm_new_tmp();
                            ascii_append(stasis.ir_out, "  ");
                            llvm_append_tmp(z);
                            ascii_append(stasis.ir_out, " = zext i1 ");
                            llvm_append_tmp(i);
                            ascii_append(stasis.ir_out, " to i32\n");
                            stasis.mir_value_llvm_tmp[i] = z;
                        } else {
                            if (k == MirInstKind.AddI32 || k == MirInstKind.SubI32 || k == MirInstKind.MulI32 || k == MirInstKind.DivI32 || k == MirInstKind.RemI32) {
                                let lhs: i32 = stasis.mir_insts[i].a;
                                let rhs: i32 = stasis.mir_insts[i].b;
                                ascii_append(stasis.ir_out, "  ");
                                llvm_append_tmp(i);
                                ascii_append(stasis.ir_out, " = ");
                                if (k == MirInstKind.AddI32) { ascii_append(stasis.ir_out, "add"); }
                                if (k == MirInstKind.SubI32) { ascii_append(stasis.ir_out, "sub"); }
                                if (k == MirInstKind.MulI32) { ascii_append(stasis.ir_out, "mul"); }
                                if (k == MirInstKind.DivI32) { ascii_append(stasis.ir_out, "sdiv"); }
                                if (k == MirInstKind.RemI32) { ascii_append(stasis.ir_out, "srem"); }
                                ascii_append(stasis.ir_out, " i32 ");
                                mir_emit_llvm_tmp_for_value(lhs);
                                ascii_append(stasis.ir_out, ", ");
                                mir_emit_llvm_tmp_for_value(rhs);
                                ascii_append(stasis.ir_out, "\n");
                            } else {
                                if (k == MirInstKind.IcmpI32) {
                                    let lhs2: i32 = stasis.mir_insts[i].a;
                                    let rhs2: i32 = stasis.mir_insts[i].b;
                                    let pred_tok: Tok = stasis.mir_insts[i].imm_tok;

                                    ascii_append(stasis.ir_out, "  ");
                                    llvm_append_tmp(i);
                                    ascii_append(stasis.ir_out, " = icmp ");
                                    if (pred_tok == Tok.EqualEqual) { ascii_append(stasis.ir_out, "eq"); }
                                    if (pred_tok == Tok.BangEqual) { ascii_append(stasis.ir_out, "ne"); }
                                    if (pred_tok == Tok.Less) { ascii_append(stasis.ir_out, "slt"); }
                                    if (pred_tok == Tok.LessEqual) { ascii_append(stasis.ir_out, "sle"); }
                                    if (pred_tok == Tok.Greater) { ascii_append(stasis.ir_out, "sgt"); }
                                    if (pred_tok == Tok.GreaterEqual) { ascii_append(stasis.ir_out, "sge"); }
                                    ascii_append(stasis.ir_out, " i32 ");
                                    mir_emit_llvm_tmp_for_value(lhs2);
                                    ascii_append(stasis.ir_out, ", ");
                                    mir_emit_llvm_tmp_for_value(rhs2);
                                    ascii_append(stasis.ir_out, "\n");

                                    let z2: i32 = llvm_new_tmp();
                                    ascii_append(stasis.ir_out, "  ");
                                    llvm_append_tmp(z2);
                                    ascii_append(stasis.ir_out, " = zext i1 ");
                                    llvm_append_tmp(i);
                                    ascii_append(stasis.ir_out, " to i32\n");
                                    stasis.mir_value_llvm_tmp[i] = z2;
                                } else {
                                    if (k == MirInstKind.RetI32) {
                                        let ret_val: i32 = stasis.mir_insts[i].a;
                                        ascii_append(stasis.ir_out, "  store i32 ");
                                        mir_emit_llvm_tmp_for_value(ret_val);
                                        ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
                                        llvm_emit_br("exit", exit_label);
                                    } else {
                                        build_err_at(file_idx, "unsupported MIR instruction (llvm)", at);
                                        return 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return 0;
}
