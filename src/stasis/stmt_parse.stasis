import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

function stmt_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (stasis.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_file_loc(file_idx, at);
    print_char(10);
}

function stmt_skip_expr_after_first(file_idx: i32, first: Tok, terminator: Tok): i32 {
    let paren_depth: i32 = 0;
    let bracket_depth: i32 = 0;

    if (first == Tok.LParen) { paren_depth = 1; }
    if (first == Tok.LBracket) { bracket_depth = 1; }

    if (first == terminator) {
        stmt_err_at(file_idx, "expected expression", stasis.tok_start);
        return 1;
    }

    let k: Tok = lex_next_kind();
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == Tok.Eof) {
            stmt_err_at(file_idx, "unexpected eof in expression", stasis.tok_start);
            return 1;
        }

        if (k == Tok.LParen) { paren_depth = paren_depth + 1; }
        else { if (k == Tok.RParen) {
            if (paren_depth > 0) {
                paren_depth = paren_depth - 1;
            } else {
                if (terminator == Tok.RParen && bracket_depth == 0) {
                    done = 1;
                } else {
                    stmt_err_at(file_idx, "unmatched ')'", stasis.tok_start);
                    return 1;
                }
            }
        } }

        if (done == 0) {
            if (k == Tok.LBracket) { bracket_depth = bracket_depth + 1; }
            else { if (k == Tok.RBracket) {
                if (bracket_depth > 0) {
                    bracket_depth = bracket_depth - 1;
                } else {
                    if (terminator == Tok.RBracket && paren_depth == 0) {
                        done = 1;
                    } else {
                        stmt_err_at(file_idx, "unmatched ']'", stasis.tok_start);
                        return 1;
                    }
                }
            } }
        }

        if (done == 0) {
            if (k == terminator && paren_depth == 0 && bracket_depth == 0) {
                done = 1;
            }
        }

        if (done == 0 && terminator == Tok.Semicolon && paren_depth == 0 && bracket_depth == 0) {
            // Heuristic recovery: if we hit a statement boundary token before ';',
            // assume the semicolon was missing and push back the boundary token.
            if (k == Tok.LetKeyword
                || k == Tok.IfKeyword
                || k == Tok.ForKeyword
                || k == Tok.ForeachKeyword
                || k == Tok.ReturnKeyword
                || k == Tok.RBrace) {
                stasis.sig_kind = k;
                stmt_err_at(file_idx, "expected ';' after expression", stasis.tok_start);
                return 1;
            }
        }

        if (done == 0) {
            k = lex_next_kind();
        }
    }

    return 0;
}

function stmt_skip_expr_until(file_idx: i32, terminator: Tok, allow_empty: i32): i32 {
    let first: Tok = lex_next_kind();
    if (first == terminator) {
        if (allow_empty != 0) {
            return 0;
        }
        stmt_err_at(file_idx, "expected expression", stasis.tok_start);
        return 1;
    }
    return stmt_skip_expr_after_first(file_idx, first, terminator);
}

// Skips an expression that must end at the matching ')' of an already-consumed '('.
// This differs from stmt_skip_expr_after_first(..., terminator=RParen) because the
// expression itself may contain nested parentheses (e.g. function calls).
function stmt_skip_expr_after_first_in_parens(file_idx: i32, first: Tok): i32 {
    let paren_depth: i32 = 1;   // account for the already-consumed '('
    let bracket_depth: i32 = 0;

    if (first == Tok.LParen) { paren_depth = paren_depth + 1; }
    if (first == Tok.LBracket) { bracket_depth = bracket_depth + 1; }
    if (first == Tok.RBracket) {
        stmt_err_at(file_idx, "unmatched ']'", stasis.tok_start);
        return 1;
    }

    let k: Tok = lex_next_kind();
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == Tok.Eof) {
            stmt_err_at(file_idx, "unexpected eof in expression", stasis.tok_start);
            return 1;
        }

        if (k == Tok.LParen) { paren_depth = paren_depth + 1; }
        else { if (k == Tok.RParen) {
            if (paren_depth > 0) {
                paren_depth = paren_depth - 1;
            } else {
                stmt_err_at(file_idx, "unmatched ')'", stasis.tok_start);
                return 1;
            }
        } }

        if (done == 0) {
            if (k == Tok.LBracket) { bracket_depth = bracket_depth + 1; }
            else { if (k == Tok.RBracket) {
                if (bracket_depth > 0) {
                    bracket_depth = bracket_depth - 1;
                } else {
                    stmt_err_at(file_idx, "unmatched ']'", stasis.tok_start);
                    return 1;
                }
            } }
        }

        if (done == 0) {
            if (k == Tok.RParen && paren_depth == 0 && bracket_depth == 0) {
                done = 1;
            }
        }

        if (done == 0) {
            k = lex_next_kind();
        }
    }

    return 0;
}

function stmt_skip_expr_in_parens(file_idx: i32, allow_empty: i32): i32 {
    let first: Tok = lex_next_kind();
    if (first == Tok.RParen) {
        if (allow_empty != 0) {
            return 0;
        }
        stmt_err_at(file_idx, "expected expression", stasis.tok_start);
        return 1;
    }
    return stmt_skip_expr_after_first_in_parens(file_idx, first);
}

function stmt_skip_type(file_idx: i32): i32 {
    let errors: i32 = 0;

    let k: Tok = lex_next_kind();
    if (k != Tok.Identifier) {
        stmt_err_at(file_idx, "expected type name", stasis.tok_start);
        return 1;
    }

    k = lex_next_kind();
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == Tok.LBracket) {
            k = lex_next_kind();

            // Slice: `Type[]` (no explicit size).
            if (k == Tok.RBracket) {
                k = lex_next_kind();
            } else {
                if (k != Tok.IntegerLiteral && k != Tok.U8Literal) {
                    errors = errors + 1;
                    stmt_err_at(file_idx, "expected array size or ']'", stasis.tok_start);
                } else {
                    k = lex_next_kind();
                }

                if (k != Tok.RBracket) {
                    errors = errors + 1;
                    stmt_err_at(file_idx, "expected ']'", stasis.tok_start);
                } else {
                    k = lex_next_kind();
                }
            }
        } else {
            done = 1;
        }
    }

    // The caller expects we have read one token beyond the type. We cannot rewind, so type
    // parsing is "consume-through": the caller must continue from `k`. We encode that by
    // storing the last kind in st.sig_kind (reusing this field as scratch).
    stasis.sig_kind = k;
    return errors;
}

function stmt_parse_statement(file_idx: i32, first: Tok): i32 {
    let errors: i32 = 0;
    let k: Tok = Tok.Unknown;
    let next: Tok = Tok.Unknown;

    if (first == Tok.LBrace) {
        return stmt_parse_block_after_lbrace(file_idx);
    }

    if (first == Tok.LetKeyword) {
        errors = 0;
        k = lex_next_kind();
        if (k != Tok.Identifier) {
            stmt_err_at(file_idx, "expected variable name", stasis.tok_start);
            return 1;
        }

        k = lex_next_kind();
        if (k == Tok.Colon) {
            errors = errors + stmt_skip_type(file_idx);
            k = stasis.sig_kind; // token after type parsing
            stasis.sig_kind = Tok.Unknown;
        }

        if (k == Tok.Equal) {
            errors = errors + stmt_skip_expr_until(file_idx, Tok.Semicolon, 0);
            return errors;
        }

        if (k != Tok.Semicolon) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected ';' after variable declaration", stasis.tok_start);
            return errors;
        }
        return errors;
    }

    if (first == Tok.ReturnKeyword) {
        // return <expr>? ;
        k = lex_next_kind();
        if (k == Tok.Semicolon) {
            return 0;
        }
        return stmt_skip_expr_after_first(file_idx, k, Tok.Semicolon);
    }

    if (first == Tok.IfKeyword) {
        errors = 0;
        k = lex_next_kind();
        if (k != Tok.LParen) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected '(' after 'if'", stasis.tok_start);
            return errors;
        }
        errors = errors + stmt_skip_expr_in_parens(file_idx, 0);

        k = lex_next_kind();
        if (k != Tok.LBrace) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected '{' after if condition", stasis.tok_start);
            return errors;
        }
        errors = errors + stmt_parse_block_after_lbrace(file_idx);

        // Optional else block.
        next = lex_next_kind();
        if (next == Tok.ElseKeyword) {
            next = lex_next_kind();
            if (next != Tok.LBrace) {
                errors = errors + 1;
                stmt_err_at(file_idx, "expected '{' after 'else'", stasis.tok_start);
                return errors;
            }
            errors = errors + stmt_parse_block_after_lbrace(file_idx);
            return errors;
        }

        // Not else: caller expects we've consumed one token too far.
        // We cannot rewind, so store it in st.sig_kind as a "pushback" kind.
        stasis.sig_kind = next;
        return errors;
    }

    if (first == Tok.ForKeyword) {
        errors = 0;
        k = lex_next_kind();
        if (k != Tok.LParen) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected '(' after 'for'", stasis.tok_start);
            return errors;
        }

        // initializer? ;
        k = lex_next_kind();
        if (k != Tok.Semicolon) {
            errors = errors + stmt_skip_expr_after_first(file_idx, k, Tok.Semicolon);
        }

        // condition? ;
        k = lex_next_kind();
        if (k != Tok.Semicolon) {
            errors = errors + stmt_skip_expr_after_first(file_idx, k, Tok.Semicolon);
        }

        // step? )
        k = lex_next_kind();
        if (k != Tok.RParen) {
            errors = errors + stmt_skip_expr_after_first_in_parens(file_idx, k);
        }

        k = lex_next_kind();
        if (k != Tok.LBrace) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected '{' after for header", stasis.tok_start);
            return errors;
        }
        errors = errors + stmt_parse_block_after_lbrace(file_idx);
        return errors;
    }

    if (first == Tok.ForeachKeyword) {
        errors = 0;
        k = lex_next_kind();
        if (k != Tok.LParen) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected '(' after 'foreach'", stasis.tok_start);
            return errors;
        }

        // Optional `let`.
        k = lex_next_kind();
        if (k == Tok.LetKeyword) {
            k = lex_next_kind();
        }

        if (k != Tok.Identifier) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected iterator name", stasis.tok_start);
            return errors;
        }

        // Optional ", index".
        k = lex_next_kind();
        if (k == Tok.Comma) {
            k = lex_next_kind();
            if (k != Tok.Identifier) {
                errors = errors + 1;
                stmt_err_at(file_idx, "expected index variable name", stasis.tok_start);
                return errors;
            }
            k = lex_next_kind();
        }

        if (k != Tok.InKeyword) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected 'in' in foreach", stasis.tok_start);
            return errors;
        }

        errors = errors + stmt_skip_expr_in_parens(file_idx, 0);

        k = lex_next_kind();
        if (k != Tok.LBrace) {
            errors = errors + 1;
            stmt_err_at(file_idx, "expected '{' after foreach header", stasis.tok_start);
            return errors;
        }
        errors = errors + stmt_parse_block_after_lbrace(file_idx);
        return errors;
    }

    // Expression statement: <expr> ;
    return stmt_skip_expr_after_first(file_idx, first, Tok.Semicolon);
}

function stmt_parse_block_after_lbrace(file_idx: i32): i32 {
    let errors: i32 = 0;

    let done: i32 = 0;
    for (; done == 0; ) {
        let k: Tok = Tok.Unknown;
        if (stasis.sig_kind != Tok.Unknown) {
            k = stasis.sig_kind;
            stasis.sig_kind = Tok.Unknown;
        } else {
            k = lex_next_kind();
        }

        if (k == Tok.RBrace) {
            done = 1;
        } else {
            if (k == Tok.Eof) {
                errors = errors + 1;
                stmt_err_at(file_idx, "unexpected eof in block", stasis.tok_start);
                return errors;
            }

            errors = errors + stmt_parse_statement(file_idx, k);
        }
    }

    return errors;
}

function stmt_parse_loaded_files(): i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < stasis.func_count; i = i + 1) {
        let file_idx: i32 = stasis.funcs[i].file_idx;
        let body_start: i32 = stasis.funcs[i].body_start;
        if (body_start >= 0) {
            if (!lex_begin(file_idx)) {
                errors = errors + 1;
            } else {
                stasis.lex_pos = body_start;

                let k: Tok = lex_next_kind();
                if (k != Tok.LBrace) {
                    errors = errors + 1;
                    stmt_err_at(file_idx, "expected '{' at start of function body", stasis.tok_start);
                } else {
                    // Clear pushback scratch.
                    stasis.sig_kind = Tok.Unknown;
                    errors = errors + stmt_parse_block_after_lbrace(file_idx);
                }
            }
        }
    }

    return errors;
}
