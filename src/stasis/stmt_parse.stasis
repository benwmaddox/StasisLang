import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

function sh_stmt_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (sh.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    sh_print_file_loc(file_idx, at);
    print_char(10);
}

function sh_stmt_skip_expr_after_first(file_idx: i32, first: ShTok, terminator: ShTok): i32 {
    let paren_depth: i32 = 0;
    let bracket_depth: i32 = 0;

    if (first == ShTok.LParen) { paren_depth = 1; }
    if (first == ShTok.LBracket) { bracket_depth = 1; }

    if (first == terminator) {
        sh_stmt_err_at(file_idx, "expected expression", sh.tok_start);
        return 1;
    }

    let k: ShTok = sh_lex_next_kind();
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == ShTok.Eof) {
            sh_stmt_err_at(file_idx, "unexpected eof in expression", sh.tok_start);
            return 1;
        }

        if (k == ShTok.LParen) { paren_depth = paren_depth + 1; }
        else { if (k == ShTok.RParen) {
            if (paren_depth > 0) {
                paren_depth = paren_depth - 1;
            } else {
                if (terminator == ShTok.RParen && bracket_depth == 0) {
                    done = 1;
                } else {
                    sh_stmt_err_at(file_idx, "unmatched ')'", sh.tok_start);
                    return 1;
                }
            }
        } }

        if (done == 0) {
            if (k == ShTok.LBracket) { bracket_depth = bracket_depth + 1; }
            else { if (k == ShTok.RBracket) {
                if (bracket_depth > 0) {
                    bracket_depth = bracket_depth - 1;
                } else {
                    if (terminator == ShTok.RBracket && paren_depth == 0) {
                        done = 1;
                    } else {
                        sh_stmt_err_at(file_idx, "unmatched ']'", sh.tok_start);
                        return 1;
                    }
                }
            } }
        }

        if (done == 0) {
            if (k == terminator && paren_depth == 0 && bracket_depth == 0) {
                done = 1;
            }
        }

        if (done == 0 && terminator == ShTok.Semicolon && paren_depth == 0 && bracket_depth == 0) {
            // Heuristic recovery: if we hit a statement boundary token before ';',
            // assume the semicolon was missing and push back the boundary token.
            if (k == ShTok.LetKeyword
                || k == ShTok.IfKeyword
                || k == ShTok.ForKeyword
                || k == ShTok.ForeachKeyword
                || k == ShTok.ReturnKeyword
                || k == ShTok.RBrace) {
                sh.sig_kind = k;
                sh_stmt_err_at(file_idx, "expected ';' after expression", sh.tok_start);
                return 1;
            }
        }

        if (done == 0) {
            k = sh_lex_next_kind();
        }
    }

    return 0;
}

function sh_stmt_skip_expr_until(file_idx: i32, terminator: ShTok, allow_empty: i32): i32 {
    let first: ShTok = sh_lex_next_kind();
    if (first == terminator) {
        if (allow_empty != 0) {
            return 0;
        }
        sh_stmt_err_at(file_idx, "expected expression", sh.tok_start);
        return 1;
    }
    return sh_stmt_skip_expr_after_first(file_idx, first, terminator);
}

function sh_stmt_skip_type(file_idx: i32): i32 {
    let errors: i32 = 0;

    let k: ShTok = sh_lex_next_kind();
    if (k != ShTok.Identifier) {
        sh_stmt_err_at(file_idx, "expected type name", sh.tok_start);
        return 1;
    }

    k = sh_lex_next_kind();
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == ShTok.LBracket) {
            k = sh_lex_next_kind();
            if (k != ShTok.IntegerLiteral) {
                errors = errors + 1;
                sh_stmt_err_at(file_idx, "expected array size", sh.tok_start);
            } else {
                k = sh_lex_next_kind();
            }

            if (k != ShTok.RBracket) {
                errors = errors + 1;
                sh_stmt_err_at(file_idx, "expected ']'", sh.tok_start);
            } else {
                k = sh_lex_next_kind();
            }
        } else {
            done = 1;
        }
    }

    // The caller expects we have read one token beyond the type. We cannot rewind, so type
    // parsing is "consume-through": the caller must continue from `k`. We encode that by
    // storing the last kind in sh.sig_kind (reusing this field as scratch).
    sh.sig_kind = k;
    return errors;
}

function sh_stmt_parse_statement(file_idx: i32, first: ShTok): i32 {
    if (first == ShTok.LBrace) {
        return sh_stmt_parse_block_after_lbrace(file_idx);
    }

    if (first == ShTok.LetKeyword) {
        let errors: i32 = 0;
        let k: ShTok = sh_lex_next_kind();
        if (k != ShTok.Identifier) {
            sh_stmt_err_at(file_idx, "expected variable name", sh.tok_start);
            return 1;
        }

        k = sh_lex_next_kind();
        if (k == ShTok.Colon) {
            errors = errors + sh_stmt_skip_type(file_idx);
            k = sh.sig_kind; // token after type parsing
            sh.sig_kind = ShTok.Unknown;
        }

        if (k == ShTok.Equal) {
            errors = errors + sh_stmt_skip_expr_until(file_idx, ShTok.Semicolon, 0);
            return errors;
        }

        if (k != ShTok.Semicolon) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected ';' after variable declaration", sh.tok_start);
            return errors;
        }
        return errors;
    }

    if (first == ShTok.ReturnKeyword) {
        // return <expr>? ;
        let k: ShTok = sh_lex_next_kind();
        if (k == ShTok.Semicolon) {
            return 0;
        }
        return sh_stmt_skip_expr_after_first(file_idx, k, ShTok.Semicolon);
    }

    if (first == ShTok.IfKeyword) {
        let errors: i32 = 0;
        let k: ShTok = sh_lex_next_kind();
        if (k != ShTok.LParen) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected '(' after 'if'", sh.tok_start);
            return errors;
        }
        errors = errors + sh_stmt_skip_expr_until(file_idx, ShTok.RParen, 0);

        k = sh_lex_next_kind();
        if (k != ShTok.LBrace) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected '{' after if condition", sh.tok_start);
            return errors;
        }
        errors = errors + sh_stmt_parse_block_after_lbrace(file_idx);

        // Optional else block.
        let next: ShTok = sh_lex_next_kind();
        if (next == ShTok.ElseKeyword) {
            next = sh_lex_next_kind();
            if (next != ShTok.LBrace) {
                errors = errors + 1;
                sh_stmt_err_at(file_idx, "expected '{' after 'else'", sh.tok_start);
                return errors;
            }
            errors = errors + sh_stmt_parse_block_after_lbrace(file_idx);
            return errors;
        }

        // Not else: caller expects we've consumed one token too far.
        // We cannot rewind, so store it in sh.sig_kind as a "pushback" kind.
        sh.sig_kind = next;
        return errors;
    }

    if (first == ShTok.ForKeyword) {
        let errors: i32 = 0;
        let k: ShTok = sh_lex_next_kind();
        if (k != ShTok.LParen) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected '(' after 'for'", sh.tok_start);
            return errors;
        }

        // initializer? ;
        k = sh_lex_next_kind();
        if (k != ShTok.Semicolon) {
            errors = errors + sh_stmt_skip_expr_after_first(file_idx, k, ShTok.Semicolon);
        }

        // condition? ;
        k = sh_lex_next_kind();
        if (k != ShTok.Semicolon) {
            errors = errors + sh_stmt_skip_expr_after_first(file_idx, k, ShTok.Semicolon);
        }

        // step? )
        k = sh_lex_next_kind();
        if (k != ShTok.RParen) {
            errors = errors + sh_stmt_skip_expr_after_first(file_idx, k, ShTok.RParen);
        }

        k = sh_lex_next_kind();
        if (k != ShTok.LBrace) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected '{' after for header", sh.tok_start);
            return errors;
        }
        errors = errors + sh_stmt_parse_block_after_lbrace(file_idx);
        return errors;
    }

    if (first == ShTok.ForeachKeyword) {
        let errors: i32 = 0;
        let k: ShTok = sh_lex_next_kind();
        if (k != ShTok.LParen) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected '(' after 'foreach'", sh.tok_start);
            return errors;
        }

        // Optional `let`.
        k = sh_lex_next_kind();
        if (k == ShTok.LetKeyword) {
            k = sh_lex_next_kind();
        }

        if (k != ShTok.Identifier) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected iterator name", sh.tok_start);
            return errors;
        }

        // Optional ", index".
        k = sh_lex_next_kind();
        if (k == ShTok.Comma) {
            k = sh_lex_next_kind();
            if (k != ShTok.Identifier) {
                errors = errors + 1;
                sh_stmt_err_at(file_idx, "expected index variable name", sh.tok_start);
                return errors;
            }
            k = sh_lex_next_kind();
        }

        if (k != ShTok.InKeyword) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected 'in' in foreach", sh.tok_start);
            return errors;
        }

        errors = errors + sh_stmt_skip_expr_until(file_idx, ShTok.RParen, 0);

        k = sh_lex_next_kind();
        if (k != ShTok.LBrace) {
            errors = errors + 1;
            sh_stmt_err_at(file_idx, "expected '{' after foreach header", sh.tok_start);
            return errors;
        }
        errors = errors + sh_stmt_parse_block_after_lbrace(file_idx);
        return errors;
    }

    // Expression statement: <expr> ;
    return sh_stmt_skip_expr_after_first(file_idx, first, ShTok.Semicolon);
}

function sh_stmt_parse_block_after_lbrace(file_idx: i32): i32 {
    let errors: i32 = 0;

    let done: i32 = 0;
    for (; done == 0; ) {
        let k: ShTok = ShTok.Unknown;
        if (sh.sig_kind != ShTok.Unknown) {
            k = sh.sig_kind;
            sh.sig_kind = ShTok.Unknown;
        } else {
            k = sh_lex_next_kind();
        }

        if (k == ShTok.RBrace) {
            done = 1;
        } else {
            if (k == ShTok.Eof) {
                errors = errors + 1;
                sh_stmt_err_at(file_idx, "unexpected eof in block", sh.tok_start);
                return errors;
            }

            errors = errors + sh_stmt_parse_statement(file_idx, k);
        }
    }

    return errors;
}

function sh_stmt_parse_loaded_files(): i32 {
    let errors: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < sh.func_count; i = i + 1) {
        let file_idx: i32 = sh.funcs[i].file_idx;
        let body_start: i32 = sh.funcs[i].body_start;
        if (body_start >= 0) {
            if (!sh_lex_begin(file_idx)) {
                errors = errors + 1;
            } else {
                sh.lex_pos = body_start;

                let k: ShTok = sh_lex_next_kind();
                if (k != ShTok.LBrace) {
                    errors = errors + 1;
                    sh_stmt_err_at(file_idx, "expected '{' at start of function body", sh.tok_start);
                } else {
                    // Clear pushback scratch.
                    sh.sig_kind = ShTok.Unknown;
                    errors = errors + sh_stmt_parse_block_after_lbrace(file_idx);
                }
            }
        }
    }

    return errors;
}
