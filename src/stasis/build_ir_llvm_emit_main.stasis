import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "expr_eval.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_func.stasis";

function emit_llvm_main_i32(module_name: ascii[]): i32 {
    let func_idx: i32 = build_find_entry_main();
    if (func_idx < 0) {
        build_err_at(0, "missing entry function 'main' in entry file", 0);
        return 1;
    }

    let file_idx: i32 = stasis.funcs[func_idx].file_idx;
    let body_start: i32 = stasis.funcs[func_idx].body_start;
    if (body_start < 0) {
        build_err_at(file_idx, "missing function body for 'main'", stasis.funcs[func_idx].name_start);
        return 1;
    }

    if (!lex_begin(file_idx)) {
        build_err_at(file_idx, "failed to start lexer", 0);
        return 1;
    }
    llvm_reset();
    stasis.llvm_str_count = 0;

    // Pre-scan locals so we can emit all allocas in entry (LLVM friendliness).
    if (llvm_scan_locals_in_body(file_idx, body_start) != 0) {
        return 1;
    }

    // Reset lexer to body start for the real codegen pass.
    stasis.lex_pos = body_start;
    stasis.sig_kind = Tok.Unknown; // reuse as a 1-token pushback for statement parsing

    ascii_clear(stasis.ir_out);
    ascii_append(stasis.ir_out, "; ModuleID = '");
    ascii_append(stasis.ir_out, module_name);
    ascii_append(stasis.ir_out, "'\n");
    ascii_append(stasis.ir_out, "source_filename = ");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, module_name);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append_byte(stasis.ir_out, 10);
    ascii_append(stasis.ir_out, "target triple = ");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, "x86_64-pc-windows-msvc");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, "\n\n");

    llvm_emit_runtime_decls_and_consts();

    if (llvm_emit_struct_type_defs() != 0) {
        build_err_at(file_idx, "failed to emit struct type definitions (llvm bring-up)", stasis.tok_start);
        return 1;
    }
    if (llvm_emit_global_defs() != 0) {
        build_err_at(file_idx, "failed to emit global definitions (llvm bring-up)", stasis.tok_start);
        return 1;
    }

    ascii_append(stasis.ir_out, "define i32 @");
    llvm_append_func_ir_name(func_idx);
    ascii_append(stasis.ir_out, "() {\n");
    ascii_append(stasis.ir_out, "entry:\n");

    let exit_label: i32 = llvm_new_label();

    // Return slot (allows return to appear anywhere).
    ascii_append(stasis.ir_out, "  %ret_slot = alloca i32, align 4\n");
    ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");

    // Locals are modeled as wasm-like locals: 0-initialized and available for the whole function.
    let i: i32 = 0;
    for (i = 0; i < stasis.llvm_local_count; i = i + 1) {
        let lkind: LlvmValueKind = stasis.llvm_local_kind[i];
        if (lkind == LlvmValueKind.I32) {
            ascii_append(stasis.ir_out, "  ");
            llvm_append_local_ptr(i);
            ascii_append(stasis.ir_out, " = alloca i32, align 4\n");
            ascii_append(stasis.ir_out, "  store i32 0, ptr ");
            llvm_append_local_ptr(i);
            ascii_append(stasis.ir_out, ", align 4\n");
        } else {
            if (lkind == LlvmValueKind.F32) {
                ascii_append(stasis.ir_out, "  ");
                llvm_append_local_ptr(i);
                ascii_append(stasis.ir_out, " = alloca float, align 4\n");
                ascii_append(stasis.ir_out, "  store float 0.0, ptr ");
                llvm_append_local_ptr(i);
                ascii_append(stasis.ir_out, ", align 4\n");
            } else {
                if (lkind == LlvmValueKind.PtrI8 || lkind == LlvmValueKind.PtrI32 || lkind == LlvmValueKind.PtrF32 || lkind == LlvmValueKind.PtrStruct) {
                    ascii_append(stasis.ir_out, "  ");
                    llvm_append_local_ptr(i);
                    ascii_append(stasis.ir_out, " = alloca ptr, align 8\n");
                    ascii_append(stasis.ir_out, "  store ptr null, ptr ");
                    llvm_append_local_ptr(i);
                    ascii_append(stasis.ir_out, ", align 8\n");
                } else {
                    build_err_at(file_idx, "unsupported local kind (llvm bring-up)", body_start);
                    return 1;
                }
            }
        }
    }

    let k: Tok = lex_next_kind();
    if (k != Tok.LBrace) {
        build_err_at(file_idx, "expected '{' at start of function body", stasis.tok_start);
        return 1;
    }

    // Push a synthetic function block; it ends at the final '}'.
    stasis.llvm_block_kind[0] = LlvmBlockKind.Function;
    stasis.llvm_block_end_label[0] = exit_label;
    stasis.llvm_block_len = 1;

    let did_return: i32 = 0;
    let done: i32 = 0;
    for (; done == 0; ) {
        if (stasis.sig_kind != Tok.Unknown) {
            k = stasis.sig_kind;
            stasis.sig_kind = Tok.Unknown;
        } else {
            k = lex_next_kind();
        }

        if (k == Tok.Eof) {
            build_err_at(file_idx, "unexpected eof in function body", stasis.tok_start);
            return 1;
        }

        if (k == Tok.RBrace) {
            if (stasis.llvm_block_len <= 0) {
                build_err_at(file_idx, "unmatched '}' in function body", stasis.tok_start);
                return 1;
            }

            let top: i32 = stasis.llvm_block_len - 1;
            let kind: LlvmBlockKind = stasis.llvm_block_kind[top];
            if (kind == LlvmBlockKind.Plain) {
                stasis.llvm_block_len = top;
            } else {
                if (kind == LlvmBlockKind.IfThen) {
                    let end_id: i32 = stasis.llvm_block_end_label[top];
                    let else_id: i32 = stasis.llvm_block_else_label[top];
                    stasis.llvm_block_len = top;

                    if (stasis.llvm_bb_terminated == 0) {
                        llvm_emit_br("if.end", end_id);
                    }

                    llvm_emit_label_def("if.else", else_id);

                    let next: Tok = lex_next_kind();
                    if (next == Tok.ElseKeyword) {
                        let brace2: Tok = lex_next_kind();
                        if (brace2 != Tok.LBrace) {
                            build_err_at(file_idx, "expected '{' after 'else'", stasis.tok_start);
                            return 1;
                        }

                        if (stasis.llvm_block_len >= 256) {
                            build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                            return 1;
                        }
                        stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.IfElse;
                        stasis.llvm_block_end_label[stasis.llvm_block_len] = end_id;
                        stasis.llvm_block_len = stasis.llvm_block_len + 1;
                    } else {
                        // No else: emit an empty else block.
                        llvm_emit_br("if.end", end_id);
                        llvm_emit_label_def("if.end", end_id);
                        stasis.sig_kind = next;
                    }
                    } else {
                        if (kind == LlvmBlockKind.IfElse) {
                        let end_id_ifelse: i32 = stasis.llvm_block_end_label[top];
                        stasis.llvm_block_len = top;

                        if (stasis.llvm_bb_terminated == 0) {
                            llvm_emit_br("if.end", end_id_ifelse);
                        }
                        llvm_emit_label_def("if.end", end_id_ifelse);
                    } else {
                        if (kind == LlvmBlockKind.ForBody) {
                            let end_id3: i32 = stasis.llvm_block_end_label[top];
                            let cond_id: i32 = stasis.llvm_block_cond_label[top];
                            let step_id: i32 = stasis.llvm_block_step_label[top];
                            let has_step: i32 = stasis.llvm_block_has_step[top];
                            let step_start: i32 = stasis.llvm_block_step_start[top];
                            let step_file_idx: i32 = stasis.llvm_block_step_file_idx[top];
                            stasis.llvm_block_len = top;

                            if (stasis.llvm_bb_terminated == 0) {
                                if (has_step != 0) {
                                    llvm_emit_br("for.step", step_id);
                                } else {
                                    llvm_emit_br("for.cond", cond_id);
                                }
                            }

                            if (has_step != 0) {
                                llvm_emit_label_def("for.step", step_id);

                                // Re-parse and emit the step expression from the header span.
                                let resume_pos: i32 = stasis.lex_pos;
                                stasis.lex_pos = step_start;
                                let root_step: i32 = expr_parse_until(step_file_idx, Tok.RParen);
                                if (root_step < 0) { return 1; }
                                let tmp_step: i32 = llvm_emit_expr_i32(step_file_idx, root_step);
                                if (tmp_step < 0) { return 1; }
                                stasis.lex_pos = resume_pos;

                                if (stasis.llvm_bb_terminated == 0) {
                                    llvm_emit_br("for.cond", cond_id);
                                }
                            }

                            llvm_emit_label_def("for.end", end_id3);
                        } else {
                            if (kind == LlvmBlockKind.Function) {
                                stasis.llvm_block_len = top;

                                if (stasis.llvm_bb_terminated == 0) {
                                    llvm_emit_br("exit", exit_label);
                                }
                                done = 1;
                            } else {
                                build_err_at(file_idx, "internal error: unknown block kind", stasis.tok_start);
                                return 1;
                            }
                        }
                    }
                }
            }
        } else {
            if (k == Tok.LBrace) {
                if (stasis.llvm_block_len >= 256) {
                    build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                    return 1;
                }
                stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.Plain;
                stasis.llvm_block_len = stasis.llvm_block_len + 1;
            } else {
                if (k == Tok.LetKeyword) {
                    // let name (: type)? (= expr)? ;
                    let name_k: Tok = lex_next_kind();
                    if (name_k != Tok.Identifier) {
                        build_err_at(file_idx, "expected variable name", stasis.tok_start);
                        return 1;
                    }
                    let local_id: i32 = llvm_find_local(file_idx, stasis.tok_start, stasis.tok_len);
                    if (local_id < 0) {
                        build_err_at(file_idx, "unknown local", stasis.tok_start);
                        return 1;
                    }
                    stasis.llvm_local_declared[local_id] = 1;

                    let next_k: Tok = lex_next_kind();
                    if (next_k == Tok.Colon) {
                        let ty_k: Tok = lex_next_kind();
                        if (ty_k != Tok.Identifier) {
                            build_err_at(file_idx, "expected type name", stasis.tok_start);
                            return 1;
                        }
                        if (span_eq(file_idx, stasis.tok_start, stasis.tok_len, "f32")) {
                            stasis.llvm_local_kind[local_id] = LlvmValueKind.F32;
                        } else {
                        if (!span_eq(file_idx, stasis.tok_start, stasis.tok_len, "i32") && !span_eq(file_idx, stasis.tok_start, stasis.tok_len, "bool") && !span_eq(file_idx, stasis.tok_start, stasis.tok_len, "u8")) {
                            let enum_hit: i32 = llvm_try_resolve_unqualified_enum(file_idx, stasis.tok_start, stasis.tok_len, stasis.tok_start);
                            if (enum_hit < 0) {
                                if (enum_hit == -2) {
                                    return 1;
                                }
                                build_err_at(file_idx, "unsupported local type (llvm bring-up)", stasis.tok_start);
                                return 1;
                            }
                        }
                        }
                        next_k = lex_next_kind();
                    }

                    if (next_k == Tok.Equal) {
                        llvm_ensure_bb_open();
                        let root: i32 = expr_parse_until(file_idx, Tok.Semicolon);
                        if (root < 0) { return 1; }
                        if (stasis.llvm_local_kind[local_id] == LlvmValueKind.F32) {
                            let rhs_f32_id: i32 = llvm_emit_expr_f32(file_idx, root);
                            if (rhs_f32_id < 0) { return 1; }
                            ascii_append(stasis.ir_out, "  store float ");
                            llvm_append_tmp(rhs_f32_id);
                            ascii_append(stasis.ir_out, ", ptr ");
                            llvm_append_local_ptr(local_id);
                            ascii_append(stasis.ir_out, ", align 4\n");
                        } else {
                            let folded: i32 = expr_try_eval_i32_const(root);
                            if (stasis.expr_eval_failed == 0) {
                                ascii_append(stasis.ir_out, "  store i32 ");
                                ir_append_i32(stasis.ir_out, folded);
                                ascii_append(stasis.ir_out, ", ptr ");
                                llvm_append_local_ptr(local_id);
                                ascii_append(stasis.ir_out, ", align 4\n");
                            } else {
                                let rhs_id: i32 = llvm_emit_expr_i32(file_idx, root);
                                if (rhs_id < 0) { return 1; }
                                llvm_emit_store_local(local_id, rhs_id);
                            }
                        }
                    } else {
                        if (next_k != Tok.Semicolon) {
                            build_err_at(file_idx, "expected '=' or ';' after let", stasis.tok_start);
                            return 1;
                        }
                        // No initializer: locals are already 0-initialized in entry.
                    }
                } else {
                    if (k == Tok.ReturnKeyword) {
                        did_return = 1;
                        llvm_ensure_bb_open();

                        let next2: Tok = lex_next_kind();
                        if (next2 == Tok.Semicolon) {
                            ascii_append(stasis.ir_out, "  store i32 0, ptr %ret_slot, align 4\n");
                            llvm_emit_br("exit", exit_label);
                        } else {
                            let root2: i32 = expr_parse_after_first(file_idx, next2, Tok.Semicolon);
                            if (root2 < 0) { return 1; }
                            let folded2: i32 = expr_try_eval_i32_const(root2);
                            if (stasis.expr_eval_failed == 0) {
                                ascii_append(stasis.ir_out, "  store i32 ");
                                ir_append_i32(stasis.ir_out, folded2);
                                ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
                            } else {
                                let ret_id: i32 = llvm_emit_expr_i32(file_idx, root2);
                                if (ret_id < 0) { return 1; }
                                ascii_append(stasis.ir_out, "  store i32 ");
                                llvm_append_tmp(ret_id);
                                ascii_append(stasis.ir_out, ", ptr %ret_slot, align 4\n");
                            }
                            llvm_emit_br("exit", exit_label);
                        }
                    } else {
                        if (k == Tok.IfKeyword) {
                            llvm_ensure_bb_open();

                            let lp: Tok = lex_next_kind();
                            if (lp != Tok.LParen) {
                                build_err_at(file_idx, "expected '(' after 'if'", stasis.tok_start);
                                return 1;
                            }

                            let cond_root: i32 = expr_parse_until(file_idx, Tok.RParen);
                            if (cond_root < 0) { return 1; }
                            let cond_i1: i32 = llvm_emit_expr_i1(file_idx, cond_root);
                            if (cond_i1 < 0) { return 1; }

                            let then_id: i32 = llvm_new_label();
                            let else_id2: i32 = llvm_new_label();
                            let if_end_id: i32 = llvm_new_label();

                            llvm_emit_br_i1(cond_i1, "if.then", then_id, "if.else", else_id2);
                            llvm_emit_label_def("if.then", then_id);

                            let brace: Tok = lex_next_kind();
                            if (brace != Tok.LBrace) {
                                build_err_at(file_idx, "expected '{' after if condition", stasis.tok_start);
                                return 1;
                            }

                            if (stasis.llvm_block_len >= 256) {
                                build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                                return 1;
                            }
                            stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.IfThen;
                            stasis.llvm_block_end_label[stasis.llvm_block_len] = if_end_id;
                            stasis.llvm_block_else_label[stasis.llvm_block_len] = else_id2;
                            stasis.llvm_block_len = stasis.llvm_block_len + 1;
                        } else {
                            if (k == Tok.ForKeyword) {
                                llvm_ensure_bb_open();

                                let lp2: Tok = lex_next_kind();
                                if (lp2 != Tok.LParen) {
                                    build_err_at(file_idx, "expected '(' after 'for'", stasis.tok_start);
                                    return 1;
                                }

                                // init? ;
                                let init_k: Tok = lex_next_kind();
                                if (init_k != Tok.Semicolon) {
                                    let init_root: i32 = expr_parse_after_first(file_idx, init_k, Tok.Semicolon);
                                    if (init_root < 0) { return 1; }
                                    let init_tmp: i32 = llvm_emit_expr_i32(file_idx, init_root);
                                    if (init_tmp < 0) { return 1; }
                                }

                                let for_cond_id: i32 = llvm_new_label();
                                let body_id: i32 = llvm_new_label();
                                let for_step_id: i32 = llvm_new_label();
                                let for_end_id: i32 = llvm_new_label();

                                llvm_emit_br("for.cond", for_cond_id);
                                llvm_emit_label_def("for.cond", for_cond_id);

                                // cond? ;
                                let cond_k: Tok = lex_next_kind();
                                let has_cond: i32 = 1;
                                let for_cond_i1: i32 = 0;
                                if (cond_k == Tok.Semicolon) {
                                    has_cond = 0;
                                } else {
                                    let cond_root2: i32 = expr_parse_after_first(file_idx, cond_k, Tok.Semicolon);
                                    if (cond_root2 < 0) { return 1; }
                                    for_cond_i1 = llvm_emit_expr_i1(file_idx, cond_root2);
                                    if (for_cond_i1 < 0) { return 1; }
                                }

                                if (has_cond == 0) {
                                    llvm_emit_br("for.body", body_id);
                                } else {
                                    llvm_emit_br_i1(for_cond_i1, "for.body", body_id, "for.end", for_end_id);
                                }

                                // step? )
                                let step_k: Tok = lex_next_kind();
                                let for_has_step: i32 = 0;
                                let for_step_start: i32 = 0;
                                if (step_k != Tok.RParen) {
                                    for_has_step = 1;
                                    for_step_start = stasis.tok_start;
                                    let step_root: i32 = expr_parse_after_first(file_idx, step_k, Tok.RParen);
                                    if (step_root < 0) { return 1; }
                                }

                                let brace3: Tok = lex_next_kind();
                                if (brace3 != Tok.LBrace) {
                                    build_err_at(file_idx, "expected '{' after for header", stasis.tok_start);
                                    return 1;
                                }

                                llvm_emit_label_def("for.body", body_id);

                                if (stasis.llvm_block_len >= 256) {
                                    build_err_at(file_idx, "block nesting too deep (llvm)", stasis.tok_start);
                                    return 1;
                                }
                                stasis.llvm_block_kind[stasis.llvm_block_len] = LlvmBlockKind.ForBody;
                                stasis.llvm_block_end_label[stasis.llvm_block_len] = for_end_id;
                                stasis.llvm_block_cond_label[stasis.llvm_block_len] = for_cond_id;
                                stasis.llvm_block_step_label[stasis.llvm_block_len] = for_step_id;
                                stasis.llvm_block_has_step[stasis.llvm_block_len] = for_has_step;
                                stasis.llvm_block_step_start[stasis.llvm_block_len] = for_step_start;
                                stasis.llvm_block_step_file_idx[stasis.llvm_block_len] = file_idx;
                                stasis.llvm_block_len = stasis.llvm_block_len + 1;
                            } else {
                                // Expression statement.
                                llvm_ensure_bb_open();
                                let root3: i32 = expr_parse_after_first(file_idx, k, Tok.Semicolon);
                                if (root3 < 0) { return 1; }
                                let tmp: i32 = llvm_emit_expr_value(file_idx, root3);
                                if (tmp < 0) { return 1; }
                            }
                        }
                    }
                }
            }
        }
    }

    if (did_return == 0) {
        build_err_at(file_idx, "missing return in 'main' (llvm bring-up)", body_start);
        return 1;
    }

    ascii_append(stasis.ir_out, "\n");
    llvm_emit_label_def("exit", exit_label);
    let ret_tmp: i32 = llvm_new_tmp();
    ascii_append(stasis.ir_out, "  ");
    llvm_append_tmp(ret_tmp);
    ascii_append(stasis.ir_out, " = load i32, ptr %ret_slot, align 4\n");
    ascii_append(stasis.ir_out, "  ret i32 ");
    llvm_append_tmp(ret_tmp);
    ascii_append(stasis.ir_out, "\n");

    ascii_append(stasis.ir_out, "}\n\n");

    // Bring-up: emit other supported functions (from all loaded modules).
    let i2: i32 = 0;
    for (i2 = 0; i2 < stasis.func_count; i2 = i2 + 1) {
        if (stasis.funcs[i2].is_test == 0) {
            if (i2 != func_idx) {
                if (stasis.funcs[i2].body_start >= 0) {
                    let ok: i32 = 1;
                    let ret_ty: i32 = stasis.funcs[i2].ret_type_idx;
                    if (ret_ty >= 0 && !build_type_is_i32ish(ret_ty) && !build_type_is_byte_named(ret_ty) && !build_type_is_void(ret_ty) && !build_type_is_f32(ret_ty)) {
                        ok = 0;
                    }
                    if (ok != 0) {
                        let pi: i32 = 0;
                        for (pi = 0; pi < stasis.funcs[i2].params_len; pi = pi + 1) {
                            let p_decl: i32 = stasis.funcs[i2].params_off + pi;
                            if (p_decl < 0 || p_decl >= stasis.param_count) {
                                ok = 0;
                            } else {
                                let p_ty: i32 = stasis.params[p_decl].type_idx;
                                if (p_ty < 0 || p_ty >= stasis.type_count) {
                                    ok = 0;
                                } else {
                                    if (!build_type_is_i32ish(p_ty) && !build_type_is_byte_named(p_ty) && !build_type_is_f32(p_ty)) {
                                        let pk: TypeKind = stasis.types[p_ty].kind;
                                        if (pk != TypeKind.Array) {
                                            ok = 0;
                                        } else {
                                            let elem: i32 = stasis.types[p_ty].elem;
                                            if (!build_type_is_i32ish(elem) && !build_type_is_byte_named(elem) && !build_type_is_f32(elem)) {
                                                ok = 0;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if (ok != 0) {
                            let rc2: i32 = emit_llvm_func_i32ish(i2);
                            if (rc2 != 0) {
                                return rc2;
                            }
                        }
                    }
                }
            }
        }
    }

    if (llvm_emit_string_literal_globals() != 0) {
        return 1;
    }
    llvm_emit_sys_runtime_decls_if_needed();
    return 0;
}
