import "../stdlib/stdlib.stasis";
import "state.stasis";
import "diagnostics.stasis";
import "lexing.stasis";
import "expr_parse.stasis";
import "build_ir_llvm_builder.stasis";

function mir_reset(): void {
    stasis.mir_inst_count = 0;
}

function mir_add_inst(kind: MirInstKind, at: i32, result_kind: MirValKind, a: i32, b: i32, c: i32, imm: i32): i32 {
    if (stasis.mir_inst_count >= 131072) {
        build_err_at(stasis.lex_file_idx, "MIR too large (cap)", at);
        return -1;
    }
    let id: i32 = stasis.mir_inst_count;
    stasis.mir_inst_count = stasis.mir_inst_count + 1;
    stasis.mir_insts[id].kind = kind;
    stasis.mir_insts[id].at = at;
    stasis.mir_insts[id].result_kind = result_kind;
    stasis.mir_insts[id].a = a;
    stasis.mir_insts[id].b = b;
    stasis.mir_insts[id].c = c;
    stasis.mir_insts[id].imm_i32 = imm;
    stasis.mir_insts[id].imm_tok = Tok.Unknown;
    return id;
}

function mir_add_inst_tok(kind: MirInstKind, at: i32, result_kind: MirValKind, a: i32, b: i32, c: i32, imm: Tok): i32 {
    let id: i32 = mir_add_inst(kind, at, result_kind, a, b, c, 0);
    if (id < 0) {
        return -1;
    }
    stasis.mir_insts[id].imm_tok = imm;
    return id;
}

function mir_lower_expr_i32(file_idx: i32, root: i32): i32 {
    // Stack-based postorder lowering into a linear MIR list.
    stasis.lex_file_idx = file_idx;

    if (root < 0 || root >= stasis.expr_count) {
        build_err_at(file_idx, "invalid expression", stasis.tok_start);
        return -1;
    }

    let node_sp: i32 = 0;
    let val_sp: i32 = 0;

    // Use expr_op_at as a temporary value stack of MIR value IDs.
    // (Safe because expr_op_at is per-expression scratch).
    stasis.expr_op_at[0] = 0;

    stasis.parse_stack_start[node_sp] = root * 2;
    node_sp = node_sp + 1;

    for (; node_sp > 0; ) {
        let enc: i32 = stasis.parse_stack_start[node_sp - 1];
        node_sp = node_sp - 1;

        if (enc >= 0) {
            let idx: i32 = enc / 2;
            let stage: i32 = enc % 2;
            if (idx < 0 || idx >= stasis.expr_count) {
                build_err_at(file_idx, "invalid expression node", stasis.tok_start);
                return -1;
            }

            if (stage == 0) {
                stasis.parse_stack_start[node_sp] = idx * 2 + 1;
                node_sp = node_sp + 1;

                let kind: ExprKind = stasis.expr_nodes[idx].kind;
                if (kind == ExprKind.Unary) {
                    stasis.parse_stack_start[node_sp] = stasis.expr_nodes[idx].left * 2;
                    node_sp = node_sp + 1;
                } else {
                    if (kind == ExprKind.Binary || kind == ExprKind.Assign) {
                        stasis.parse_stack_start[node_sp] = stasis.expr_nodes[idx].right * 2;
                        node_sp = node_sp + 1;
                        stasis.parse_stack_start[node_sp] = stasis.expr_nodes[idx].left * 2;
                        node_sp = node_sp + 1;
                    }
                }
            } else {
                // Post-visit: emit MIR for this node using children results on val stack.
                let kind2: ExprKind = stasis.expr_nodes[idx].kind;
                let at: i32 = stasis.expr_nodes[idx].at;

                if (kind2 == ExprKind.IntLiteral) {
                    let folded: i32 = stasis.expr_nodes[idx].value;
                    let v: i32 = mir_add_inst(MirInstKind.ConstI32, at, MirValKind.I32, 0, 0, 0, folded);
                    if (v < 0) { return -1; }
                    stasis.expr_op_at[val_sp] = v;
                    val_sp = val_sp + 1;
                } else {
                    if (kind2 == ExprKind.BoolLiteral) {
                        let v2: i32 = mir_add_inst(MirInstKind.ConstI32, at, MirValKind.I32, 0, 0, 0, stasis.expr_nodes[idx].value);
                        if (v2 < 0) { return -1; }
                        stasis.expr_op_at[val_sp] = v2;
                        val_sp = val_sp + 1;
                    } else {
                        if (kind2 == ExprKind.Name) {
                            let local_id: i32 = llvm_find_local(file_idx, stasis.expr_nodes[idx].name_start, stasis.expr_nodes[idx].name_len);
                            if (local_id < 0) {
                                build_err_at(file_idx, "unknown local", at);
                                return -1;
                            }
                            if (stasis.llvm_local_declared[local_id] == 0) {
                                build_err_at(file_idx, "local used before declaration", at);
                                return -1;
                            }
                            let v3: i32 = mir_add_inst(MirInstKind.LoadLocalI32, at, MirValKind.I32, local_id, 0, 0, 0);
                            if (v3 < 0) { return -1; }
                            stasis.expr_op_at[val_sp] = v3;
                            val_sp = val_sp + 1;
                        } else {
                            if (kind2 == ExprKind.Unary) {
                                if (val_sp < 1) {
                                    build_err_at(file_idx, "invalid expression", at);
                                    return -1;
                                }
                                let v_id: i32 = stasis.expr_op_at[val_sp - 1];
                                val_sp = val_sp - 1;
                                let op: Tok = stasis.expr_nodes[idx].op;
                                if (op == Tok.UnaryMinus) {
                                    let out: i32 = mir_add_inst(MirInstKind.NegI32, at, MirValKind.I32, v_id, 0, 0, 0);
                                    if (out < 0) { return -1; }
                                    stasis.expr_op_at[val_sp] = out;
                                    val_sp = val_sp + 1;
                                } else {
                                    if (op == Tok.Bang) {
                                        let out2: i32 = mir_add_inst(MirInstKind.NotI32, at, MirValKind.I32, v_id, 0, 0, 0);
                                        if (out2 < 0) { return -1; }
                                        stasis.expr_op_at[val_sp] = out2;
                                        val_sp = val_sp + 1;
                                    } else {
                                        build_err_at(file_idx, "unsupported unary operator (MIR)", at);
                                        return -1;
                                    }
                                }
                            } else {
                                if (kind2 == ExprKind.Binary) {
                                    if (val_sp < 2) {
                                        build_err_at(file_idx, "invalid expression", at);
                                        return -1;
                                    }
                                    let rhs: i32 = stasis.expr_op_at[val_sp - 1];
                                    let lhs: i32 = stasis.expr_op_at[val_sp - 2];
                                    val_sp = val_sp - 2;

                                    let op2: Tok = stasis.expr_nodes[idx].op;
                                    let outk: MirInstKind = MirInstKind.AddI32;
                                    let is_cmp: i32 = 0;
                                    if (op2 == Tok.Plus) { outk = MirInstKind.AddI32; }
                                    if (op2 == Tok.Minus) { outk = MirInstKind.SubI32; }
                                    if (op2 == Tok.Star) { outk = MirInstKind.MulI32; }
                                    if (op2 == Tok.Slash) { outk = MirInstKind.DivI32; }
                                    if (op2 == Tok.Percent) { outk = MirInstKind.RemI32; }
                                    if (op2 == Tok.EqualEqual) { outk = MirInstKind.IcmpI32; is_cmp = 1; }
                                    if (op2 == Tok.BangEqual) { outk = MirInstKind.IcmpI32; is_cmp = 1; }
                                    if (op2 == Tok.Less) { outk = MirInstKind.IcmpI32; is_cmp = 1; }
                                    if (op2 == Tok.LessEqual) { outk = MirInstKind.IcmpI32; is_cmp = 1; }
                                    if (op2 == Tok.Greater) { outk = MirInstKind.IcmpI32; is_cmp = 1; }
                                    if (op2 == Tok.GreaterEqual) { outk = MirInstKind.IcmpI32; is_cmp = 1; }

                                    let imm: i32 = 0;
                                    if (is_cmp != 0) {
                                        let out3b: i32 = mir_add_inst_tok(outk, at, MirValKind.I32, lhs, rhs, 0, op2);
                                        if (out3b < 0) { return -1; }
                                        stasis.expr_op_at[val_sp] = out3b;
                                        val_sp = val_sp + 1;
                                    } else {
                                        let out3: i32 = mir_add_inst(outk, at, MirValKind.I32, lhs, rhs, 0, imm);
                                        if (out3 < 0) { return -1; }
                                        stasis.expr_op_at[val_sp] = out3;
                                        val_sp = val_sp + 1;
                                    }
                                } else {
                                    if (kind2 == ExprKind.Assign) {
                                        if (val_sp < 2) {
                                            build_err_at(file_idx, "invalid assignment expression", at);
                                            return -1;
                                        }
                                        let rhs2: i32 = stasis.expr_op_at[val_sp - 1];
                                        // Discard the lowered LHS value; the assignment target is resolved from the AST.
                                        val_sp = val_sp - 2;

                                        let lhs_idx: i32 = stasis.expr_nodes[idx].left;
                                        if (lhs_idx < 0 || lhs_idx >= stasis.expr_count) {
                                            build_err_at(file_idx, "unsupported assignment target", at);
                                            return -1;
                                        }
                                        let lhs_kind: ExprKind = stasis.expr_nodes[lhs_idx].kind;
                                        if (lhs_kind != ExprKind.Name) {
                                            build_err_at(file_idx, "unsupported assignment target", at);
                                            return -1;
                                        }

                                        let local_id2: i32 = llvm_find_local(file_idx, stasis.expr_nodes[lhs_idx].name_start, stasis.expr_nodes[lhs_idx].name_len);
                                        if (local_id2 < 0) {
                                            build_err_at(file_idx, "unknown local", stasis.expr_nodes[lhs_idx].at);
                                            return -1;
                                        }
                                        if (stasis.llvm_local_declared[local_id2] == 0) {
                                            build_err_at(file_idx, "local used before declaration", stasis.expr_nodes[lhs_idx].at);
                                            return -1;
                                        }

                                        let aop: Tok = stasis.expr_nodes[idx].op;
                                        if (aop != Tok.Equal) {
                                            build_err_at(file_idx, "unsupported assignment operator (MIR)", at);
                                            return -1;
                                        }

                                        let store_id: i32 = mir_add_inst(MirInstKind.StoreLocalI32, at, MirValKind.Void, local_id2, rhs2, 0, 0);
                                        if (store_id < 0) { return -1; }
                                        // Assignment expression value is rhs.
                                        stasis.expr_op_at[val_sp] = rhs2;
                                        val_sp = val_sp + 1;
                                    } else {
                                        build_err_at(file_idx, "unsupported expression (MIR)", at);
                                        return -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (val_sp != 1) {
        build_err_at(file_idx, "invalid expression", stasis.expr_nodes[root].at);
        return -1;
    }
    return stasis.expr_op_at[0];
}

function mir_lower_func_body_i32_simple(file_idx: i32, body_start: i32): i32 {
    stasis.lex_file_idx = file_idx;
    stasis.lex_pos = body_start;
    stasis.sig_kind = Tok.Unknown;

    let k: Tok = lex_next_kind();
    if (k != Tok.LBrace) {
        build_err_at(file_idx, "expected '{' at start of function body", stasis.tok_start);
        return 1;
    }

    if (llvm_scope_push(file_idx, stasis.tok_start) != 0) {
        return 1;
    }

    let done: i32 = 0;
    let saw_return: i32 = 0;
    for (; done == 0; ) {
        if (stasis.sig_kind != Tok.Unknown) {
            k = stasis.sig_kind;
            stasis.sig_kind = Tok.Unknown;
        } else {
            k = lex_next_kind();
        }

        if (k == Tok.Eof) {
            build_err_at(file_idx, "unexpected eof in function body", stasis.tok_start);
            return 1;
        }

        if (k == Tok.RBrace) {
            if (llvm_scope_pop(file_idx, stasis.tok_start) != 0) {
                return 1;
            }
            done = 1;
        } else {
            if (saw_return != 0) {
                build_err_at(file_idx, "unreachable statement after return (MIR bring-up)", stasis.tok_start);
                return 1;
            }

            if (k == Tok.LBrace) {
                build_err_at(file_idx, "nested blocks not yet supported in MIR bring-up", stasis.tok_start);
                return 1;
            }

            if (k == Tok.LetKeyword) {
                // let name (: type)? (= expr)? ;
                let name_k: Tok = lex_next_kind();
                if (name_k != Tok.Identifier) {
                    build_err_at(file_idx, "expected variable name", stasis.tok_start);
                    return 1;
                }
                let decl_at: i32 = stasis.tok_start;
                let local_id: i32 = llvm_find_local_by_decl_at(file_idx, stasis.tok_start, stasis.tok_len, decl_at);
                if (local_id < 0) {
                    build_err_at(file_idx, "unknown local", decl_at);
                    return 1;
                }

                let next_k: Tok = lex_next_kind();
                if (next_k == Tok.Colon) {
                    // Skip type name (bring-up; local kind already inferred by prescan).
                    let ty_k: Tok = lex_next_kind();
                    if (ty_k != Tok.Identifier) {
                        build_err_at(file_idx, "expected type name", stasis.tok_start);
                        return 1;
                    }
                    next_k = lex_next_kind();
                }

                if (next_k == Tok.Equal) {
                    let root: i32 = expr_parse_until(file_idx, Tok.Semicolon);
                    if (root < 0) { return 1; }
                    let rhs_id: i32 = mir_lower_expr_i32(file_idx, root);
                    if (rhs_id < 0) { return 1; }
                    if (mir_add_inst(MirInstKind.StoreLocalI32, decl_at, MirValKind.Void, local_id, rhs_id, 0, 0) < 0) {
                        return 1;
                    }
                } else {
                    if (next_k != Tok.Semicolon) {
                        build_err_at(file_idx, "expected '=' or ';' after let", stasis.tok_start);
                        return 1;
                    }
                }

                stasis.llvm_local_declared[local_id] = 1;
                if (llvm_scope_declare_local(file_idx, decl_at, local_id) != 0) {
                    return 1;
                }
            } else {
                if (k == Tok.ReturnKeyword) {
                    let root2: i32 = expr_parse_until(file_idx, Tok.Semicolon);
                    if (root2 < 0) { return 1; }
                    let ret_id: i32 = mir_lower_expr_i32(file_idx, root2);
                    if (ret_id < 0) { return 1; }
                    if (mir_add_inst(MirInstKind.RetI32, stasis.expr_nodes[root2].at, MirValKind.Void, ret_id, 0, 0, 0) < 0) {
                        return 1;
                    }
                    saw_return = 1;
                } else {
                    // Expression statement.
                    let root3: i32 = expr_parse_after_first(file_idx, k, Tok.Semicolon);
                    if (root3 < 0) { return 1; }
                    let tmp: i32 = mir_lower_expr_i32(file_idx, root3);
                    if (tmp < 0) { return 1; }
                }
            }
        }
    }

    return 0;
}
