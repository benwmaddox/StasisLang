import "build_ir_llvm_emit_func.stasis";

function span_eq(file_idx: i32, start: i32, len: i32, lit: ascii[]): bool {
    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return false;
    }
    if (len != ascii_len(lit)) {
        return false;
    }

    let base: i32 = stasis.files[file_idx].offset + start;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (stasis.pool[base + i] != lit[i]) {
            return false;
        }
    }
    return true;
}

function ir_append_span(dst: ascii[], file_idx: i32, start: i32, len: i32): void {
    if (file_idx < 0 || file_idx >= stasis.file_count) {
        return;
    }
    let base: i32 = stasis.files[file_idx].offset + start;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        ascii_append_byte(dst, stasis.pool[base + i]);
    }
}

function build_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (stasis.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_file_loc(file_idx, at);
    print_char(10);
}

function build_parse_i32_from_tok(file_idx: i32): i32 {
    let v: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < stasis.tok_len; i = i + 1) {
        let b: u8 = stasis.pool[stasis.lex_base + stasis.tok_start + i];
        if (!ascii_is_digit(b)) {
            build_err_at(file_idx, "expected integer literal", stasis.tok_start);
            return 0;
        }
        v = v * 10 + ascii_to_digit(b);
    }
    return v;
}

function build_find_entry_main(): i32 {
    let i: i32 = 0;
    for (i = 0; i < stasis.func_count; i = i + 1) {
        if (stasis.funcs[i].is_test == 0) {
            if (stasis.funcs[i].file_idx == 0) {
                if (span_eq(stasis.funcs[i].file_idx, stasis.funcs[i].name_start, stasis.funcs[i].name_len, "main")) {
                    return i;
                }
            }
        }
    }
    return -1;
}

function build_type_is_i32(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return false;
    }
    return span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "i32");
}

function build_type_is_i32ish(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return false;
    }
    if (span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "i32")) { return true; }
    if (span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "bool")) { return true; }
    return build_find_enum_decl_for_type(type_idx) >= 0;
}

function build_type_is_f32(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return false;
    }
    return span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "f32");
}

function build_type_is_byte_named(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return false;
    }
    if (span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "u8")) { return true; }
    if (span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "ascii")) { return true; }
    if (span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "utf8")) { return true; }
    return span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "string");
}

function build_type_is_u8(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return false;
