function build_type_is_void(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return false;
    }
    return span_eq(stasis.types[type_idx].file_idx, stasis.types[type_idx].start, stasis.types[type_idx].len, "void");
}

function build_header_bytes_for_elem(elem_type_idx: i32): i32 {
    if (elem_type_idx < 0 || elem_type_idx >= stasis.type_count) {
        return 0;
    }
    let kind: TypeKind = stasis.types[elem_type_idx].kind;
    if (kind != TypeKind.Named) {
        return 0;
    }
    if (span_eq(stasis.types[elem_type_idx].file_idx, stasis.types[elem_type_idx].start, stasis.types[elem_type_idx].len, "ascii")) { return 4; }
    if (span_eq(stasis.types[elem_type_idx].file_idx, stasis.types[elem_type_idx].start, stasis.types[elem_type_idx].len, "utf8")) { return 8; }
    if (span_eq(stasis.types[elem_type_idx].file_idx, stasis.types[elem_type_idx].start, stasis.types[elem_type_idx].len, "string")) { return 8; }
    return 0;
}

function build_type_is_slice_of_bytes(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Array) {
        return false;
    }
    if (stasis.types[type_idx].size != 0) {
        return false;
    }
    return build_type_is_byte_named(stasis.types[type_idx].elem);
}

function build_type_is_slice_of_i32ish(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return false;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Array) {
        return false;
    }
    if (stasis.types[type_idx].size != 0) {
        return false;
    }
    return build_type_is_i32ish(stasis.types[type_idx].elem);
}

function build_find_struct_decl_for_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return -1;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return -1;
    }

    let want_file: i32 = stasis.types[type_idx].file_idx;
    let want_start: i32 = stasis.types[type_idx].start;
    let want_len: i32 = stasis.types[type_idx].len;

    let si: i32 = 0;
    for (si = 0; si < stasis.struct_count; si = si + 1) {
        if (span_eq_span_cross(want_file, want_start, want_len, stasis.structs[si].file_idx, stasis.structs[si].name_start, stasis.structs[si].name_len)) {
            return si;
        }
    }
    return -1;
}

function build_find_enum_decl_for_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return -1;
    }
    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind != TypeKind.Named) {
        return -1;
    }

    let want_file: i32 = stasis.types[type_idx].file_idx;
    let want_start: i32 = stasis.types[type_idx].start;
    let want_len: i32 = stasis.types[type_idx].len;

    let ei: i32 = 0;
    for (ei = 0; ei < stasis.enum_count; ei = ei + 1) {
        if (span_eq_span_cross(want_file, want_start, want_len, stasis.enums[ei].file_idx, stasis.enums[ei].name_start, stasis.enums[ei].name_len)) {
            return ei;
        }
    }
    return -1;
}

function build_find_struct_field(struct_idx: i32, name_file_idx: i32, name_start: i32, name_len: i32): i32 {
    if (struct_idx < 0 || struct_idx >= stasis.struct_count) {
        return -1;
    }

    let off: i32 = stasis.structs[struct_idx].fields_off;
    let len: i32 = stasis.structs[struct_idx].fields_len;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        let field_idx: i32 = off + i;
        if (field_idx >= 0 && field_idx < stasis.field_count) {
            if (span_eq_span_cross(name_file_idx, name_start, name_len, stasis.fields[field_idx].file_idx, stasis.fields[field_idx].name_start, stasis.fields[field_idx].name_len)) {
                return i;
            }
        }
    }
    return -1;
}
