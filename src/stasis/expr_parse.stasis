function expr_make_call(file_idx: i32, at: i32, callee: i32, args_off: i32, args_len: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    stasis.expr_nodes[idx].kind = ExprKind.Call;
    stasis.expr_nodes[idx].file_idx = file_idx;
    stasis.expr_nodes[idx].at = at;
    stasis.expr_nodes[idx].op = Tok.Unknown;
    stasis.expr_nodes[idx].left = callee;
    stasis.expr_nodes[idx].right = args_off;
    stasis.expr_nodes[idx].value = args_len;
    stasis.expr_nodes[idx].name_start = 0;
    stasis.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_member(file_idx: i32, at: i32, base: i32, member_tok: Tok, member_start: i32, member_len: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    stasis.expr_nodes[idx].kind = ExprKind.Member;
    stasis.expr_nodes[idx].file_idx = file_idx;
    stasis.expr_nodes[idx].at = at;
    stasis.expr_nodes[idx].op = member_tok;
    stasis.expr_nodes[idx].left = base;
    stasis.expr_nodes[idx].right = -1;
    stasis.expr_nodes[idx].value = 0;
    stasis.expr_nodes[idx].name_start = member_start;
    stasis.expr_nodes[idx].name_len = member_len;
    return idx;
}

function expr_make_index(file_idx: i32, at: i32, base: i32, index_expr: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    stasis.expr_nodes[idx].kind = ExprKind.Index;
    stasis.expr_nodes[idx].file_idx = file_idx;
    stasis.expr_nodes[idx].at = at;
    stasis.expr_nodes[idx].op = Tok.LBracket;
    stasis.expr_nodes[idx].left = base;
    stasis.expr_nodes[idx].right = index_expr;
    stasis.expr_nodes[idx].value = 0;
    stasis.expr_nodes[idx].name_start = 0;
    stasis.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_unary(file_idx: i32, at: i32, op: Tok, operand: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    stasis.expr_nodes[idx].kind = ExprKind.Unary;
    stasis.expr_nodes[idx].file_idx = file_idx;
    stasis.expr_nodes[idx].at = at;
    stasis.expr_nodes[idx].op = op;
    stasis.expr_nodes[idx].left = operand;
    stasis.expr_nodes[idx].right = -1;
    stasis.expr_nodes[idx].value = 0;
    stasis.expr_nodes[idx].name_start = 0;
    stasis.expr_nodes[idx].name_len = 0;
    return idx;
}

