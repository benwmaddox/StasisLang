function expr_make_call(file_idx: i32, at: i32, callee: i32, args_off: i32, args_len: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.Call;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = Tok.Unknown;
    st.expr_nodes[idx].left = callee;
    st.expr_nodes[idx].right = args_off;
    st.expr_nodes[idx].value = args_len;
    st.expr_nodes[idx].name_start = 0;
    st.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_member(file_idx: i32, at: i32, base: i32, member_tok: Tok, member_start: i32, member_len: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.Member;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = member_tok;
    st.expr_nodes[idx].left = base;
    st.expr_nodes[idx].right = -1;
    st.expr_nodes[idx].value = 0;
    st.expr_nodes[idx].name_start = member_start;
    st.expr_nodes[idx].name_len = member_len;
    return idx;
}

function expr_make_index(file_idx: i32, at: i32, base: i32, index_expr: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.Index;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = Tok.LBracket;
    st.expr_nodes[idx].left = base;
    st.expr_nodes[idx].right = index_expr;
    st.expr_nodes[idx].value = 0;
    st.expr_nodes[idx].name_start = 0;
    st.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_unary(file_idx: i32, at: i32, op: Tok, operand: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.Unary;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = op;
    st.expr_nodes[idx].left = operand;
    st.expr_nodes[idx].right = -1;
    st.expr_nodes[idx].value = 0;
    st.expr_nodes[idx].name_start = 0;
    st.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_binary(file_idx: i32, at: i32, op: Tok, left: i32, right: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.Binary;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = op;
    st.expr_nodes[idx].left = left;
    st.expr_nodes[idx].right = right;
    st.expr_nodes[idx].value = 0;
    st.expr_nodes[idx].name_start = 0;
    st.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_assign(file_idx: i32, at: i32, op: Tok, left: i32, right: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.Assign;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = op;
    st.expr_nodes[idx].left = left;
    st.expr_nodes[idx].right = right;
    st.expr_nodes[idx].value = 0;
    st.expr_nodes[idx].name_start = 0;
    st.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_is_assign(k: Tok): bool {
    return k == Tok.Equal
        || k == Tok.PlusEqual
        || k == Tok.MinusEqual
        || k == Tok.StarEqual
        || k == Tok.SlashEqual
        || k == Tok.PercentEqual;
}

function expr_is_infix(k: Tok): bool {
    if (expr_is_assign(k)) { return true; }
    return k == Tok.PipePipe
        || k == Tok.AmpAmp
        || k == Tok.EqualEqual
        || k == Tok.BangEqual
        || k == Tok.Less
        || k == Tok.LessEqual
        || k == Tok.Greater
        || k == Tok.GreaterEqual
        || k == Tok.Plus
        || k == Tok.Minus
        || k == Tok.Star
        || k == Tok.Slash
        || k == Tok.Percent;
}

function expr_prec(k: Tok): i32 {
    if (expr_is_assign(k)) { return 1; }
    if (k == Tok.PipePipe) { return 2; }
    if (k == Tok.AmpAmp) { return 3; }
    if (k == Tok.EqualEqual || k == Tok.BangEqual) { return 4; }
    if (k == Tok.Less || k == Tok.LessEqual || k == Tok.Greater || k == Tok.GreaterEqual) { return 5; }
    if (k == Tok.Plus || k == Tok.Minus) { return 6; }
    if (k == Tok.Star || k == Tok.Slash || k == Tok.Percent) { return 7; }
    if (k == Tok.UnaryMinus || k == Tok.Bang) { return 8; }
    return 0;
}

function expr_is_right_assoc(k: Tok): bool {
    return expr_is_assign(k) || k == Tok.UnaryMinus || k == Tok.Bang;
}

function expr_is_member_name(k: Tok): bool {
    if (k == Tok.Identifier) { return true; }
    return k == Tok.Plus
        || k == Tok.Minus
        || k == Tok.Star
        || k == Tok.Slash
        || k == Tok.Percent
        || k == Tok.AmpAmp
        || k == Tok.PipePipe
        || k == Tok.Less
        || k == Tok.LessEqual
        || k == Tok.Greater
        || k == Tok.GreaterEqual
        || k == Tok.EqualEqual
        || k == Tok.BangEqual;
}

function expr_reduce_top(file_idx: i32, op_len: i32, val_len: i32): i32 {
    if (op_len <= 0) {
        return -1;
    }
    let op: Tok = st.parse_stack_kind[op_len - 1];
    let at: i32 = st.expr_op_at[op_len - 1];

    if (op == Tok.LParen || op == Tok.CallStart) {
        expr_err_at(file_idx, "unmatched '('", at);
        return -1;
    }
    if (op == Tok.IndexStart) {
        expr_err_at(file_idx, "unmatched '['", at);
        return -1;
    }

    if (op == Tok.UnaryMinus || op == Tok.Bang) {
        if (val_len < 1) {
            expr_err_at(file_idx, "invalid expression", at);
            return -1;
        }
        let operand: i32 = st.parse_stack_start[val_len - 1];
        let idx: i32 = expr_make_unary(file_idx, at, op, operand);
        if (idx < 0) { return -1; }
        st.parse_stack_start[val_len - 1] = idx;
        return 0;
    }

    if (val_len < 2) {
        expr_err_at(file_idx, "invalid expression", at);
        return -1;
    }

    let right: i32 = st.parse_stack_start[val_len - 1];
    let left: i32 = st.parse_stack_start[val_len - 2];
    let idx2: i32 = -1;
    if (expr_is_assign(op)) {
        idx2 = expr_make_assign(file_idx, at, op, left, right);
    } else {
        idx2 = expr_make_binary(file_idx, at, op, left, right);
    }
    if (idx2 < 0) { return -1; }
    st.parse_stack_start[val_len - 2] = idx2;
    return 0;
}

// Parses an expression after the first token has already been consumed.
// Consumes the terminator and returns the expression root node index, or -1 on error.
function expr_parse_after_first(file_idx: i32, first: Tok, terminator: Tok): i32 {
    st.expr_count = 0;
    st.expr_call_args_len = 0;
    st.expr_call_tmp_args_len = 0;
    st.expr_call_len = 0;
    st.expr_index_len = 0;

    let op_len: i32 = 0;
    let val_len: i32 = 0;
    let expect_value: i32 = 1;
    let paren_depth: i32 = 0;
    let base_node: i32 = 0;
    let base2: i32 = 0;

    let k: Tok = first;
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == Tok.Eof) {
            expr_err_at(file_idx, "unexpected eof in expression", st.tok_start);
            return -1;
        }

        if (expect_value == 0 && st.expr_call_len == 0 && st.expr_index_len == 0 && paren_depth == 0 && k == terminator) {
            done = 1;
        }

            if (done == 0) {
                if (expect_value != 0) {
                    // Allow empty-arg calls: `callee()`.
                    if (k == Tok.RParen && st.expr_call_len > 0 && op_len > 0 && st.parse_stack_kind[op_len - 1] == Tok.CallStart) {
                        let top_call: i32 = st.expr_call_len - 1;
                        if (st.expr_call_arg_len[top_call] != 0 || val_len != st.expr_call_val_base[top_call]) {
                            expr_err_at(file_idx, "expected expression after ','", st.tok_start);
                            return -1;
                        }

                        let callee0: i32 = st.expr_call_callee[top_call];
                        let tmp_args_off0: i32 = st.expr_call_arg_off[top_call];

                        st.expr_call_len = top_call;
                        op_len = op_len - 1; // pop CallStart
                        st.expr_call_tmp_args_len = tmp_args_off0;

                        let call_node0: i32 = expr_make_call(file_idx, st.expr_nodes[callee0].at, callee0, st.expr_call_args_len, 0);
                        if (call_node0 < 0) { return -1; }
                        if (val_len >= EXPR_STACK_CAP) {
                            expr_err_at(file_idx, "expression too complex (value stack)", st.tok_start);
                            return -1;
                        }
                        st.parse_stack_start[val_len] = call_node0;
                        val_len = val_len + 1;
                        expect_value = 0;
                        k = lex_next_kind();
                    } else {
                        if (k == Tok.LParen) {
                            if (op_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (op stack)", st.tok_start);
                                return -1;
                        }
                        st.parse_stack_kind[op_len] = k;
                        st.expr_op_at[op_len] = st.tok_start;
                        op_len = op_len + 1;
                        paren_depth = paren_depth + 1;
                        k = lex_next_kind();
                    } else {
                        if (k == Tok.Minus) {
                            if (op_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (op stack)", st.tok_start);
                                return -1;
                            }
                            st.parse_stack_kind[op_len] = Tok.UnaryMinus;
                            st.expr_op_at[op_len] = st.tok_start;
                            op_len = op_len + 1;
                            k = lex_next_kind();
                        } else {
                            if (k == Tok.Bang) {
                                if (op_len >= EXPR_STACK_CAP) {
                                    expr_err_at(file_idx, "expression too complex (op stack)", st.tok_start);
                                    return -1;
                                }
                                st.parse_stack_kind[op_len] = Tok.Bang;
                                st.expr_op_at[op_len] = st.tok_start;
                                op_len = op_len + 1;
                                k = lex_next_kind();
                            } else {
                                let node: i32 = -1;
                                if (k == Tok.IntegerLiteral) {
                                    node = expr_make_int_lit(file_idx, st.tok_start, expr_parse_i32_from_tok(file_idx));
                                } else {
                                    if (k == Tok.FloatLiteral) {
                                        node = expr_make_float_lit(file_idx, st.tok_start, st.tok_len);
                                    } else {
                                    if (k == Tok.TrueKeyword) {
                                        node = expr_make_bool_lit(file_idx, st.tok_start, 1);
                                    } else {
                                        if (k == Tok.FalseKeyword) {
                                            node = expr_make_bool_lit(file_idx, st.tok_start, 0);
                                        } else {
                                            if (k == Tok.Identifier) {
                                                node = expr_make_name(file_idx, st.tok_start, st.tok_len);
                                            } else {
                                                if (k == Tok.StringLiteral) {
                                                    node = expr_make_string_lit(file_idx, st.tok_start, st.tok_len);
                                                } else {
                                                    expr_err_at(file_idx, "expected value in expression", st.tok_start);
                                                    return -1;
                                                }
                                            }
                                        }
                                    }
                                    }
                                }

                                if (node < 0) { return -1; }
                                if (val_len >= EXPR_STACK_CAP) {
                                    expr_err_at(file_idx, "expression too complex (value stack)", st.tok_start);
                                    return -1;
                                }
                                st.parse_stack_start[val_len] = node;
                                val_len = val_len + 1;
                                expect_value = 0;
                                k = lex_next_kind();
                            }
                        }
                    }
                }
            } else {
                if (k == Tok.Dot) {
                    if (val_len < 1) {
                        expr_err_at(file_idx, "expected expression before '.'", st.tok_start);
                        return -1;
                    }

                    base_node = st.parse_stack_start[val_len - 1];
                    let member_k: Tok = lex_next_kind();
                    if (!expr_is_member_name(member_k)) {
                        expr_err_at(file_idx, "expected member name after '.'", st.tok_start);
                        return -1;
                    }

                    let member_node: i32 = expr_make_member(file_idx, st.expr_nodes[base_node].at, base_node, member_k, st.tok_start, st.tok_len);
                    if (member_node < 0) { return -1; }
                    st.parse_stack_start[val_len - 1] = member_node;
                    k = lex_next_kind();
                } else {
                    if (k == Tok.LParen) {
                        // Postfix call: `callee(args...)`.
                        if (val_len < 1) {
                            expr_err_at(file_idx, "expected call target before '('", st.tok_start);
                            return -1;
                        }

                        let callee: i32 = st.parse_stack_start[val_len - 1];
                        if (callee < 0 || callee >= st.expr_count) {
                            expr_err_at(file_idx, "invalid call target", st.tok_start);
                            return -1;
                        }
                        let callee_kind: ExprKind = st.expr_nodes[callee].kind;
                        if (callee_kind != ExprKind.Name && callee_kind != ExprKind.Member) {
                            expr_err_at(file_idx, "unsupported call target", st.tok_start);
                            return -1;
                        }

                        if (st.expr_call_len >= EXPR_STACK_CAP) {
                            expr_err_at(file_idx, "expression too complex (call stack)", st.tok_start);
                            return -1;
                        }
                        if (op_len >= EXPR_STACK_CAP) {
                            expr_err_at(file_idx, "expression too complex (op stack)", st.tok_start);
                            return -1;
                        }

                        // Pop callee from the value stack, then parse call args as a sub-context.
                        val_len = val_len - 1;
                         let call_idx: i32 = st.expr_call_len;
                         st.expr_call_len = st.expr_call_len + 1;
                         st.expr_call_callee[call_idx] = callee;
                         st.expr_call_arg_off[call_idx] = st.expr_call_tmp_args_len;
                         st.expr_call_arg_len[call_idx] = 0;
                         st.expr_call_val_base[call_idx] = val_len;

                        st.parse_stack_kind[op_len] = Tok.CallStart;
                        st.expr_op_at[op_len] = st.tok_start;
                        op_len = op_len + 1;

                        expect_value = 1;
                        k = lex_next_kind();
                    } else {
                        if (k == Tok.LBracket) {
                            // Postfix index: `base[expr]`.
                            if (val_len < 1) {
                                expr_err_at(file_idx, "expected expression before '['", st.tok_start);
                                return -1;
                            }
                            if (st.expr_index_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (index stack)", st.tok_start);
                                return -1;
                            }
                            if (op_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (op stack)", st.tok_start);
                                return -1;
                            }

                            base_node = st.parse_stack_start[val_len - 1];
                            val_len = val_len - 1;

                            let index_idx: i32 = st.expr_index_len;
                            st.expr_index_len = st.expr_index_len + 1;
                            st.expr_index_base[index_idx] = base_node;
                            st.expr_index_val_base[index_idx] = val_len;
                            st.expr_index_at[index_idx] = st.tok_start;

                            st.parse_stack_kind[op_len] = Tok.IndexStart;
                            st.expr_op_at[op_len] = st.tok_start;
                            op_len = op_len + 1;

                            expect_value = 1;
                            k = lex_next_kind();
                        } else {
                            if (k == Tok.Comma) {
                            if (st.expr_call_len <= 0 || paren_depth != 0) {
                                expr_err_at(file_idx, "unexpected ',' in expression", st.tok_start);
                                return -1;
                            }

                            let top_call2: i32 = st.expr_call_len - 1;
                            base2 = st.expr_call_val_base[top_call2];

                            // Reduce operators until the call barrier.
                            for (; op_len > 0 && st.parse_stack_kind[op_len - 1] != Tok.CallStart; ) {
                                let top_op2: Tok = st.parse_stack_kind[op_len - 1];
                                if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                    return -1;
                                }
                                op_len = op_len - 1;
                                if (top_op2 == Tok.UnaryMinus || top_op2 == Tok.Bang) {
                                    // val_len unchanged
                                } else {
                                    val_len = val_len - 1;
                                }
                            }

                            if (val_len != base2 + 1) {
                                expr_err_at(file_idx, "expected expression in call argument", st.tok_start);
                                return -1;
                            }
                            if (st.expr_call_tmp_args_len >= 32768) {
                                expr_err_at(file_idx, "too many call arguments (cap)", st.tok_start);
                                return -1;
                            }
                            st.expr_call_tmp_args[st.expr_call_tmp_args_len] = st.parse_stack_start[val_len - 1];
                            st.expr_call_tmp_args_len = st.expr_call_tmp_args_len + 1;
                            st.expr_call_arg_len[top_call2] = st.expr_call_arg_len[top_call2] + 1;

                            // Pop the argument value and continue with the next arg.
                            val_len = base2;
                            expect_value = 1;
                            k = lex_next_kind();
                        } else {
                            if (k == Tok.RParen) {
                                // Reduce operators until we hit a barrier: either a call start or a grouping paren.
                                let found_barrier: i32 = 0;
                                for (; found_barrier == 0; ) {
                                    if (op_len <= 0) {
                                        expr_err_at(file_idx, "unmatched ')'", st.tok_start);
                                        return -1;
                                    }

                                    let top: Tok = st.parse_stack_kind[op_len - 1];
                                    if (top == Tok.CallStart || top == Tok.LParen) {
                                        found_barrier = 1;
                                    } else {
                                        if (top == Tok.IndexStart) {
                                            expr_err_at(file_idx, "unmatched ')'", st.tok_start);
                                            return -1;
                                        }
                                        if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                            return -1;
                                        }
                                        op_len = op_len - 1;
                                        if (top == Tok.UnaryMinus || top == Tok.Bang) {
                                            // val_len unchanged
                                        } else {
                                            val_len = val_len - 1;
                                        }
                                    }
                                }

                                if (st.parse_stack_kind[op_len - 1] == Tok.LParen) {
                                    op_len = op_len - 1;
                                    paren_depth = paren_depth - 1;
                                    k = lex_next_kind();
                                } else {
                                    if (st.expr_call_len <= 0) {
                                        expr_err_at(file_idx, "unmatched ')'", st.tok_start);
                                        return -1;
                                    }

                                    // Close a call: finalize the last argument, then build the Call node.
                                    let top_call3: i32 = st.expr_call_len - 1;
                                    let base3: i32 = st.expr_call_val_base[top_call3];

                                    if (val_len != base3 + 1) {
                                        expr_err_at(file_idx, "expected expression in call argument", st.tok_start);
                                        return -1;
                                    }
                                    if (op_len <= 0 || st.parse_stack_kind[op_len - 1] != Tok.CallStart) {
                                        expr_err_at(file_idx, "internal error: call stack desync", st.tok_start);
                                        return -1;
                                    }

                                    if (st.expr_call_tmp_args_len >= 32768) {
                                        expr_err_at(file_idx, "too many call arguments (cap)", st.tok_start);
                                        return -1;
                                    }
                                    st.expr_call_tmp_args[st.expr_call_tmp_args_len] = st.parse_stack_start[val_len - 1];
                                    st.expr_call_tmp_args_len = st.expr_call_tmp_args_len + 1;
                                    st.expr_call_arg_len[top_call3] = st.expr_call_arg_len[top_call3] + 1;
                                    val_len = base3;

                                    let callee3: i32 = st.expr_call_callee[top_call3];
                                    let args_len3: i32 = st.expr_call_arg_len[top_call3];
                                    let tmp_args_off3: i32 = st.expr_call_arg_off[top_call3];
                                    let args_off3: i32 = st.expr_call_args_len;
                                    if (args_off3 + args_len3 > 32768) {
                                        expr_err_at(file_idx, "too many call arguments (cap)", st.tok_start);
                                        return -1;
                                    }

                                    let arg_i: i32 = 0;
                                    for (; arg_i < args_len3; ) {
                                        st.expr_call_args[args_off3 + arg_i] = st.expr_call_tmp_args[tmp_args_off3 + arg_i];
                                        arg_i = arg_i + 1;
                                    }
                                    st.expr_call_args_len = st.expr_call_args_len + args_len3;
                                    st.expr_call_tmp_args_len = tmp_args_off3;

                                    st.expr_call_len = top_call3;
                                    op_len = op_len - 1; // pop CallStart

                                    let call_node3: i32 = expr_make_call(file_idx, st.expr_nodes[callee3].at, callee3, args_off3, args_len3);
                                    if (call_node3 < 0) { return -1; }
                                    if (val_len >= EXPR_STACK_CAP) {
                                        expr_err_at(file_idx, "expression too complex (value stack)", st.tok_start);
                                        return -1;
                                    }
                                    st.parse_stack_start[val_len] = call_node3;
                                    val_len = val_len + 1;
                                    expect_value = 0;
                                    k = lex_next_kind();
                                }
                            } else {
                                if (k == Tok.RBracket) {
                                    if (st.expr_index_len <= 0) {
                                        expr_err_at(file_idx, "unmatched ']'", st.tok_start);
                                        return -1;
                                    }

                                    let top_index: i32 = st.expr_index_len - 1;
                                    base2 = st.expr_index_val_base[top_index];

                                    // Reduce operators until the index barrier.
                                    for (; op_len > 0 && st.parse_stack_kind[op_len - 1] != Tok.IndexStart && st.parse_stack_kind[op_len - 1] != Tok.CallStart; ) {
                                        let top_op4: Tok = st.parse_stack_kind[op_len - 1];
                                        if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                            return -1;
                                        }
                                        op_len = op_len - 1;
                                        if (top_op4 == Tok.UnaryMinus || top_op4 == Tok.Bang) {
                                            // val_len unchanged
                                        } else {
                                            val_len = val_len - 1;
                                        }
                                    }

                                    if (op_len <= 0) {
                                        expr_err_at(file_idx, "internal error: index stack desync", st.tok_start);
                                        return -1;
                                    }
                                    if (st.parse_stack_kind[op_len - 1] == Tok.CallStart) {
                                        expr_err_at(file_idx, "expected ')' before ']'", st.tok_start);
                                        return -1;
                                    }

                                    if (val_len != base2 + 1) {
                                        expr_err_at(file_idx, "expected expression in index", st.tok_start);
                                        return -1;
                                    }
                                    if (st.parse_stack_kind[op_len - 1] != Tok.IndexStart) {
                                        expr_err_at(file_idx, "internal error: index stack desync", st.tok_start);
                                        return -1;
                                    }

                                    let index_expr: i32 = st.parse_stack_start[val_len - 1];
                                    let base_node2: i32 = st.expr_index_base[top_index];

                                    st.expr_index_len = top_index;
                                    op_len = op_len - 1; // pop IndexStart

                                    let index_node: i32 = expr_make_index(file_idx, st.expr_nodes[base_node2].at, base_node2, index_expr);
                                    if (index_node < 0) { return -1; }
                                    st.parse_stack_start[val_len - 1] = index_node;
                                    expect_value = 0;
                                    k = lex_next_kind();
                                } else {
                                    if (expr_is_infix(k)) {
                                    let prec: i32 = expr_prec(k);
                                    let reduce: i32 = 1;
                                    for (; reduce != 0; ) {
                                        reduce = 0;
                                        if (op_len > 0) {
                                            let top2: Tok = st.parse_stack_kind[op_len - 1];
                                            if (top2 != Tok.LParen && top2 != Tok.CallStart && top2 != Tok.IndexStart) {
                                                let top_prec: i32 = expr_prec(top2);
                                                if (top_prec > prec || (top_prec == prec && !expr_is_right_assoc(k))) {
                                                    if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                                        return -1;
                                                    }
                                                    op_len = op_len - 1;
                                                    if (top2 == Tok.UnaryMinus || top2 == Tok.Bang) {
                                                        // val_len unchanged
                                                    } else {
                                                        val_len = val_len - 1;
                                                    }
                                                    reduce = 1;
                                                }
                                            }
                                        }
                                    }

                                    if (op_len >= EXPR_STACK_CAP) {
                                        expr_err_at(file_idx, "expression too complex (op stack)", st.tok_start);
                                        return -1;
                                    }
                                    st.parse_stack_kind[op_len] = k;
                                    st.expr_op_at[op_len] = st.tok_start;
                                    op_len = op_len + 1;
                                    expect_value = 1;
                                    k = lex_next_kind();
                                } else {
                                    expr_err_at(file_idx, "expected operator in expression", st.tok_start);
                                    return -1;
                                }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    if (expect_value != 0) {
        expr_err_at(file_idx, "expected value in expression", st.tok_start);
        return -1;
    }

    for (; op_len > 0; ) {
        let top3: Tok = st.parse_stack_kind[op_len - 1];
        if (top3 == Tok.LParen || top3 == Tok.CallStart) {
            expr_err_at(file_idx, "unmatched '('", st.expr_op_at[op_len - 1]);
            return -1;
        }
        if (top3 == Tok.IndexStart) {
            expr_err_at(file_idx, "unmatched '['", st.expr_op_at[op_len - 1]);
            return -1;
        }
        if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
            return -1;
        }
        op_len = op_len - 1;
        if (top3 == Tok.UnaryMinus || top3 == Tok.Bang) {
            // val_len unchanged
        } else {
            val_len = val_len - 1;
        }
    }

    if (st.expr_call_len != 0) {
        expr_err_at(file_idx, "unclosed call in expression", st.tok_start);
        return -1;
    }
    if (st.expr_index_len != 0) {
        expr_err_at(file_idx, "unclosed index in expression", st.expr_index_at[st.expr_index_len - 1]);
        return -1;
    }

    if (val_len != 1) {
        expr_err_at(file_idx, "invalid expression", st.tok_start);
        return -1;
    }

    return st.parse_stack_start[0];
}

// Parses an expression starting at the current lexer position and consumes the terminator.
// Returns the expression root node index, or -1 on error.
function expr_parse_until(file_idx: i32, terminator: Tok): i32 {
    let first: Tok = lex_next_kind();
    return expr_parse_after_first(file_idx, first, terminator);
}

// Iterative (stack-based) evaluator for i32/bool constant expressions.
// Sets st.expr_eval_failed for non-constant nodes.
function expr_eval_i32_const(root: i32): i32 {
    st.expr_eval_failed = 0;
    if (root < 0) {
        st.expr_eval_failed = 1;
        return 0;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;

    // Node stack uses st.parse_stack_start; visited flag is encoded by negating the index.
    st.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = st.parse_stack_start[sp - 1];
        if (top >= 0) {
            st.parse_stack_start[sp - 1] = -top - 1;

            let kind: ExprKind = st.expr_nodes[top].kind;
            if (kind == ExprKind.Unary) {
                if (sp >= EXPR_STACK_CAP) { st.expr_eval_failed = 1; return 0; }
                st.parse_stack_start[sp] = st.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ExprKind.Binary || kind == ExprKind.Assign) {
                    if (sp + 1 >= EXPR_STACK_CAP) { st.expr_eval_failed = 1; return 0; }
                    st.parse_stack_start[sp] = st.expr_nodes[top].right;
                    sp = sp + 1;
                    st.parse_stack_start[sp] = st.expr_nodes[top].left;
                    sp = sp + 1;
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= EXPR_STACK_CAP) { st.expr_eval_failed = 1; return 0; }

            let kind2: ExprKind = st.expr_nodes[idx].kind;
            if (kind2 == ExprKind.IntLiteral || kind2 == ExprKind.BoolLiteral) {
                st.expr_op_at[val_len] = st.expr_nodes[idx].value;
                val_len = val_len + 1;
            } else {
                if (kind2 == ExprKind.Unary) {
                    if (val_len < 1) { st.expr_eval_failed = 1; return 0; }
                    let v: i32 = st.expr_op_at[val_len - 1];
                    val_len = val_len - 1;

                    let r: i32 = 0;
                    let op: Tok = st.expr_nodes[idx].op;
                    if (op == Tok.UnaryMinus) {
                        r = -v;
                    } else {
                        if (op == Tok.Bang) {
                            r = 0;
                            if (v == 0) { r = 1; }
                        } else {
                            if (st.expr_eval_failed == 0) {
                                expr_err_at(st.expr_nodes[idx].file_idx, "unsupported unary operator in const expression", st.expr_nodes[idx].at);
                            }
                            st.expr_eval_failed = 1;
                        }
                    }

                    st.expr_op_at[val_len] = r;
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ExprKind.Binary) {
                        if (val_len < 2) { st.expr_eval_failed = 1; return 0; }
                        let b: i32 = st.expr_op_at[val_len - 1];
                        let a: i32 = st.expr_op_at[val_len - 2];
                        val_len = val_len - 2;

                        let r2: i32 = 0;
                        let handled: i32 = 0;
                        let op2: Tok = st.expr_nodes[idx].op;
                        let at: i32 = st.expr_nodes[idx].at;
                        let src_file: i32 = st.expr_nodes[idx].file_idx;

                        if (op2 == Tok.Plus) { r2 = a + b; handled = 1; }
                        if (op2 == Tok.Minus) { r2 = a - b; handled = 1; }
                        if (op2 == Tok.Star) { r2 = a * b; handled = 1; }
                        if (op2 == Tok.Slash) {
                            handled = 1;
                            if (b == 0) {
                                expr_err_at(src_file, "division by zero", at);
                                st.expr_eval_failed = 1;
                                r2 = 0;
                            } else {
                                r2 = a / b;
                            }
                        }
                        if (op2 == Tok.Percent) {
                            handled = 1;
                            if (b == 0) {
                                expr_err_at(src_file, "modulo by zero", at);
                                st.expr_eval_failed = 1;
                                r2 = 0;
                            } else {
                                r2 = a % b;
                            }
                        }

                        if (op2 == Tok.EqualEqual) { r2 = 0; if (a == b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.BangEqual) { r2 = 0; if (a != b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Less) { r2 = 0; if (a < b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.LessEqual) { r2 = 0; if (a <= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Greater) { r2 = 0; if (a > b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.GreaterEqual) { r2 = 0; if (a >= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.AmpAmp) { r2 = 0; if (a != 0 && b != 0) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.PipePipe) { r2 = 0; if (a != 0 || b != 0) { r2 = 1; } handled = 1; }

                        if (handled == 0) {
                            if (st.expr_eval_failed == 0) {
                                expr_err_at(src_file, "unsupported operator in const expression", at);
                            }
                            st.expr_eval_failed = 1;
                            r2 = 0;
                        }

                        st.expr_op_at[val_len] = r2;
                        val_len = val_len + 1;
                    } else {
                        if (st.expr_eval_failed == 0) {
                            if (kind2 == ExprKind.Name) {
                                expr_err_at(st.expr_nodes[idx].file_idx, "non-constant identifier in expression (minimal build only)", st.expr_nodes[idx].at);
                            } else {
                                if (kind2 == ExprKind.Assign) {
                                    expr_err_at(st.expr_nodes[idx].file_idx, "assignment in constant expression (minimal build only)", st.expr_nodes[idx].at);
                                } else {
                                    expr_err_at(st.expr_nodes[idx].file_idx, "non-constant expression (minimal build only)", st.expr_nodes[idx].at);
                                }
                            }
                        }
                        st.expr_eval_failed = 1;
                        st.expr_op_at[val_len] = 0;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }

    if (val_len != 1) {
        st.expr_eval_failed = 1;
        return 0;
    }
    return st.expr_op_at[0];
}

// Silent i32/bool constant evaluator:
// - Never prints diagnostics.
// - Sets st.expr_eval_failed != 0 when the expression is not a pure constant expression.
function expr_try_eval_i32_const(root: i32): i32 {
    st.expr_eval_failed = 0;
    if (root < 0) {
        st.expr_eval_failed = 1;
        return 0;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;

    st.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = st.parse_stack_start[sp - 1];
        if (top >= 0) {
            st.parse_stack_start[sp - 1] = -top - 1;

            let kind: ExprKind = st.expr_nodes[top].kind;
            if (kind == ExprKind.Unary) {
                if (sp >= EXPR_STACK_CAP) { st.expr_eval_failed = 1; return 0; }
                st.parse_stack_start[sp] = st.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ExprKind.Binary || kind == ExprKind.Assign) {
                    if (sp + 1 >= EXPR_STACK_CAP) { st.expr_eval_failed = 1; return 0; }
                    st.parse_stack_start[sp] = st.expr_nodes[top].right;
                    sp = sp + 1;
                    st.parse_stack_start[sp] = st.expr_nodes[top].left;
                    sp = sp + 1;
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= EXPR_STACK_CAP) { st.expr_eval_failed = 1; return 0; }

            let kind2: ExprKind = st.expr_nodes[idx].kind;
            if (kind2 == ExprKind.IntLiteral || kind2 == ExprKind.BoolLiteral) {
                st.expr_op_at[val_len] = st.expr_nodes[idx].value;
                val_len = val_len + 1;
            } else {
                if (kind2 == ExprKind.Unary) {
                    if (val_len < 1) { st.expr_eval_failed = 1; return 0; }
                    let v: i32 = st.expr_op_at[val_len - 1];
                    val_len = val_len - 1;

                    let r: i32 = 0;
                    let op: Tok = st.expr_nodes[idx].op;
                    if (op == Tok.UnaryMinus) { r = -v; }
                    else { if (op == Tok.Bang) { r = 0; if (v == 0) { r = 1; } }
                    else { st.expr_eval_failed = 1; r = 0; } }

                    st.expr_op_at[val_len] = r;
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ExprKind.Binary) {
                        if (val_len < 2) { st.expr_eval_failed = 1; return 0; }
                        let b: i32 = st.expr_op_at[val_len - 1];
                        let a: i32 = st.expr_op_at[val_len - 2];
                        val_len = val_len - 2;

                        let r2: i32 = 0;
                        let handled: i32 = 0;
                        let op2: Tok = st.expr_nodes[idx].op;

                        if (op2 == Tok.Plus) { r2 = a + b; handled = 1; }
                        if (op2 == Tok.Minus) { r2 = a - b; handled = 1; }
                        if (op2 == Tok.Star) { r2 = a * b; handled = 1; }
                        if (op2 == Tok.Slash) { handled = 1; if (b == 0) { st.expr_eval_failed = 1; r2 = 0; } else { r2 = a / b; } }
                        if (op2 == Tok.Percent) { handled = 1; if (b == 0) { st.expr_eval_failed = 1; r2 = 0; } else { r2 = a % b; } }

                        if (op2 == Tok.EqualEqual) { r2 = 0; if (a == b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.BangEqual) { r2 = 0; if (a != b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Less) { r2 = 0; if (a < b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.LessEqual) { r2 = 0; if (a <= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.Greater) { r2 = 0; if (a > b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.GreaterEqual) { r2 = 0; if (a >= b) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.AmpAmp) { r2 = 0; if (a != 0 && b != 0) { r2 = 1; } handled = 1; }
                        if (op2 == Tok.PipePipe) { r2 = 0; if (a != 0 || b != 0) { r2 = 1; } handled = 1; }

                        if (handled == 0) {
                            st.expr_eval_failed = 1;
                            r2 = 0;
                        }

                        st.expr_op_at[val_len] = r2;
                        val_len = val_len + 1;
                    } else {
                        st.expr_eval_failed = 1;
                        st.expr_op_at[val_len] = 0;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }

    if (val_len != 1) {
        st.expr_eval_failed = 1;
        return 0;
    }
    return st.expr_op_at[0];
}
