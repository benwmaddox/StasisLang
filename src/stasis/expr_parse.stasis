import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

const EXPR_STACK_CAP: i32 = 4096;

function expr_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (stasis.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_file_loc(file_idx, at);
    print_char(10);
}

function expr_parse_i32_from_tok(file_idx: i32): i32 {
    let v: i32 = 0;
    let len: i32 = stasis.tok_len;
    let has_u8_suffix: i32 = 0;
    if (len >= 2) {
        let b0: u8 = stasis.pool[stasis.lex_base + stasis.tok_start + len - 2];
        let b1: u8 = stasis.pool[stasis.lex_base + stasis.tok_start + len - 1];
        if (b0 == 117 && b1 == 56) {
            has_u8_suffix = 1;
            len = len - 2;
        }
    }
    if (len <= 0) {
        expr_err_at(file_idx, "expected integer literal", stasis.tok_start);
        return 0;
    }
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        let b: u8 = stasis.pool[stasis.lex_base + stasis.tok_start + i];
        if (!ascii_is_digit(b)) {
            expr_err_at(file_idx, "expected integer literal", stasis.tok_start);
            return 0;
        }
        v = v * 10 + ascii_to_digit(b);
    }
    if (has_u8_suffix != 0 && (v < 0 || v > 255)) {
        expr_err_at(file_idx, "u8 literal out of range (0..255)", stasis.tok_start);
        return 0;
    }
    return v;
}

function expr_node_new(): i32 {
    if (stasis.expr_count >= 16384) {
        return -1;
    }
    let idx: i32 = stasis.expr_count;
    stasis.expr_count = stasis.expr_count + 1;
    return idx;
}

function expr_make_int_lit(file_idx: i32, at: i32, value: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    stasis.expr_nodes[idx].kind = ExprKind.IntLiteral;
    stasis.expr_nodes[idx].file_idx = file_idx;
    stasis.expr_nodes[idx].at = at;
    stasis.expr_nodes[idx].op = Tok.Unknown;
    stasis.expr_nodes[idx].left = -1;
    stasis.expr_nodes[idx].right = -1;
    stasis.expr_nodes[idx].value = value;
    stasis.expr_nodes[idx].name_start = 0;
    stasis.expr_nodes[idx].name_len = 0;
    return idx;
}

