import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

const SH_EXPR_STACK_CAP: i32 = 4096;

function sh_expr_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (sh.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    sh_print_file_loc(file_idx, at);
    print_char(10);
}

function sh_expr_parse_i32_from_tok(file_idx: i32): i32 {
    let v: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < sh.tok_len; i = i + 1) {
        let b: u8 = sh.pool[sh.lex_base + sh.tok_start + i];
        if (!ascii_is_digit(b)) {
            sh_expr_err_at(file_idx, "expected integer literal", sh.tok_start);
            return 0;
        }
        v = v * 10 + ascii_to_digit(b);
    }
    return v;
}

function sh_expr_node_new(): i32 {
    if (sh.expr_count >= 16384) {
        return -1;
    }
    let idx: i32 = sh.expr_count;
    sh.expr_count = sh.expr_count + 1;
    return idx;
}

function sh_expr_make_int_lit(file_idx: i32, at: i32, value: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.IntLiteral;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = ShTok.Unknown;
    sh.expr_nodes[idx].left = -1;
    sh.expr_nodes[idx].right = -1;
    sh.expr_nodes[idx].value = value;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_make_bool_lit(file_idx: i32, at: i32, value: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.BoolLiteral;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = ShTok.Unknown;
    sh.expr_nodes[idx].left = -1;
    sh.expr_nodes[idx].right = -1;
    sh.expr_nodes[idx].value = value;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_make_name(file_idx: i32, at: i32, len: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Name;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = ShTok.Unknown;
    sh.expr_nodes[idx].left = -1;
    sh.expr_nodes[idx].right = -1;
    sh.expr_nodes[idx].value = 0;
    sh.expr_nodes[idx].name_start = at;
    sh.expr_nodes[idx].name_len = len;
    return idx;
}

function sh_expr_make_call(file_idx: i32, at: i32, callee: i32, args_off: i32, args_len: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Call;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = ShTok.Unknown;
    sh.expr_nodes[idx].left = callee;
    sh.expr_nodes[idx].right = args_off;
    sh.expr_nodes[idx].value = args_len;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_make_member(file_idx: i32, at: i32, base: i32, member_tok: ShTok, member_start: i32, member_len: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Member;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = member_tok;
    sh.expr_nodes[idx].left = base;
    sh.expr_nodes[idx].right = -1;
    sh.expr_nodes[idx].value = 0;
    sh.expr_nodes[idx].name_start = member_start;
    sh.expr_nodes[idx].name_len = member_len;
    return idx;
}

function sh_expr_make_index(file_idx: i32, at: i32, base: i32, index_expr: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Index;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = ShTok.LBracket;
    sh.expr_nodes[idx].left = base;
    sh.expr_nodes[idx].right = index_expr;
    sh.expr_nodes[idx].value = 0;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_make_unary(file_idx: i32, at: i32, op: ShTok, operand: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Unary;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = op;
    sh.expr_nodes[idx].left = operand;
    sh.expr_nodes[idx].right = -1;
    sh.expr_nodes[idx].value = 0;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_make_binary(file_idx: i32, at: i32, op: ShTok, left: i32, right: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Binary;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = op;
    sh.expr_nodes[idx].left = left;
    sh.expr_nodes[idx].right = right;
    sh.expr_nodes[idx].value = 0;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_make_assign(file_idx: i32, at: i32, op: ShTok, left: i32, right: i32): i32 {
    let idx: i32 = sh_expr_node_new();
    if (idx < 0) {
        sh_expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    sh.expr_nodes[idx].kind = ShExprKind.Assign;
    sh.expr_nodes[idx].file_idx = file_idx;
    sh.expr_nodes[idx].at = at;
    sh.expr_nodes[idx].op = op;
    sh.expr_nodes[idx].left = left;
    sh.expr_nodes[idx].right = right;
    sh.expr_nodes[idx].value = 0;
    sh.expr_nodes[idx].name_start = 0;
    sh.expr_nodes[idx].name_len = 0;
    return idx;
}

function sh_expr_is_assign(k: ShTok): bool {
    return k == ShTok.Equal
        || k == ShTok.PlusEqual
        || k == ShTok.MinusEqual
        || k == ShTok.StarEqual
        || k == ShTok.SlashEqual
        || k == ShTok.PercentEqual;
}

function sh_expr_is_infix(k: ShTok): bool {
    if (sh_expr_is_assign(k)) { return true; }
    return k == ShTok.PipePipe
        || k == ShTok.AmpAmp
        || k == ShTok.EqualEqual
        || k == ShTok.BangEqual
        || k == ShTok.Less
        || k == ShTok.LessEqual
        || k == ShTok.Greater
        || k == ShTok.GreaterEqual
        || k == ShTok.Plus
        || k == ShTok.Minus
        || k == ShTok.Star
        || k == ShTok.Slash
        || k == ShTok.Percent;
}

function sh_expr_prec(k: ShTok): i32 {
    if (sh_expr_is_assign(k)) { return 1; }
    if (k == ShTok.PipePipe) { return 2; }
    if (k == ShTok.AmpAmp) { return 3; }
    if (k == ShTok.EqualEqual || k == ShTok.BangEqual) { return 4; }
    if (k == ShTok.Less || k == ShTok.LessEqual || k == ShTok.Greater || k == ShTok.GreaterEqual) { return 5; }
    if (k == ShTok.Plus || k == ShTok.Minus) { return 6; }
    if (k == ShTok.Star || k == ShTok.Slash || k == ShTok.Percent) { return 7; }
    if (k == ShTok.UnaryMinus || k == ShTok.Bang) { return 8; }
    return 0;
}

function sh_expr_is_right_assoc(k: ShTok): bool {
    return sh_expr_is_assign(k) || k == ShTok.UnaryMinus || k == ShTok.Bang;
}

function sh_expr_is_member_name(k: ShTok): bool {
    if (k == ShTok.Identifier) { return true; }
    return k == ShTok.Plus
        || k == ShTok.Minus
        || k == ShTok.Star
        || k == ShTok.Slash
        || k == ShTok.Percent
        || k == ShTok.AmpAmp
        || k == ShTok.PipePipe
        || k == ShTok.Less
        || k == ShTok.LessEqual
        || k == ShTok.Greater
        || k == ShTok.GreaterEqual
        || k == ShTok.EqualEqual
        || k == ShTok.BangEqual;
}

function sh_expr_reduce_top(file_idx: i32, op_len: i32, val_len: i32): i32 {
    if (op_len <= 0) {
        return -1;
    }
    let op: ShTok = sh.parse_stack_kind[op_len - 1];
    let at: i32 = sh.expr_op_at[op_len - 1];

    if (op == ShTok.LParen || op == ShTok.CallStart) {
        sh_expr_err_at(file_idx, "unmatched '('", at);
        return -1;
    }
    if (op == ShTok.IndexStart) {
        sh_expr_err_at(file_idx, "unmatched '['", at);
        return -1;
    }

    if (op == ShTok.UnaryMinus || op == ShTok.Bang) {
        if (val_len < 1) {
            sh_expr_err_at(file_idx, "invalid expression", at);
            return -1;
        }
        let operand: i32 = sh.parse_stack_start[val_len - 1];
        let idx: i32 = sh_expr_make_unary(file_idx, at, op, operand);
        if (idx < 0) { return -1; }
        sh.parse_stack_start[val_len - 1] = idx;
        return 0;
    }

    if (val_len < 2) {
        sh_expr_err_at(file_idx, "invalid expression", at);
        return -1;
    }

    let right: i32 = sh.parse_stack_start[val_len - 1];
    let left: i32 = sh.parse_stack_start[val_len - 2];
    let idx2: i32 = -1;
    if (sh_expr_is_assign(op)) {
        idx2 = sh_expr_make_assign(file_idx, at, op, left, right);
    } else {
        idx2 = sh_expr_make_binary(file_idx, at, op, left, right);
    }
    if (idx2 < 0) { return -1; }
    sh.parse_stack_start[val_len - 2] = idx2;
    return 0;
}

// Parses an expression after the first token has already been consumed.
// Consumes the terminator and returns the expression root node index, or -1 on error.
function sh_expr_parse_after_first(file_idx: i32, first: ShTok, terminator: ShTok): i32 {
    sh.expr_count = 0;
    sh.expr_call_args_len = 0;
    sh.expr_call_tmp_args_len = 0;
    sh.expr_call_len = 0;
    sh.expr_index_len = 0;

    let op_len: i32 = 0;
    let val_len: i32 = 0;
    let expect_value: i32 = 1;
    let paren_depth: i32 = 0;

    let k: ShTok = first;
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == ShTok.Eof) {
            sh_expr_err_at(file_idx, "unexpected eof in expression", sh.tok_start);
            return -1;
        }

        if (expect_value == 0 && sh.expr_call_len == 0 && sh.expr_index_len == 0 && paren_depth == 0 && k == terminator) {
            done = 1;
        }

        if (done == 0) {
            if (expect_value != 0) {
                // Allow empty-arg calls: `callee()`.
                if (k == ShTok.RParen && sh.expr_call_len > 0 && paren_depth == 0) {
                    let top_call: i32 = sh.expr_call_len - 1;
                    if (sh.expr_call_arg_len[top_call] != 0 || val_len != sh.expr_call_val_base[top_call]) {
                        sh_expr_err_at(file_idx, "expected expression after ','", sh.tok_start);
                        return -1;
                    }
                    if (op_len <= 0 || sh.parse_stack_kind[op_len - 1] != ShTok.CallStart) {
                        sh_expr_err_at(file_idx, "internal error: call stack desync", sh.tok_start);
                        return -1;
                    }

                    let callee0: i32 = sh.expr_call_callee[top_call];
                    let tmp_args_off0: i32 = sh.expr_call_arg_off[top_call];

                    sh.expr_call_len = top_call;
                    op_len = op_len - 1; // pop CallStart
                    sh.expr_call_tmp_args_len = tmp_args_off0;

                    let call_node0: i32 = sh_expr_make_call(file_idx, sh.expr_nodes[callee0].at, callee0, sh.expr_call_args_len, 0);
                    if (call_node0 < 0) { return -1; }
                    if (val_len >= SH_EXPR_STACK_CAP) {
                        sh_expr_err_at(file_idx, "expression too complex (value stack)", sh.tok_start);
                        return -1;
                    }
                    sh.parse_stack_start[val_len] = call_node0;
                    val_len = val_len + 1;
                    expect_value = 0;
                    k = sh_lex_next_kind();
                } else {
                    if (k == ShTok.LParen) {
                        if (op_len >= SH_EXPR_STACK_CAP) {
                            sh_expr_err_at(file_idx, "expression too complex (op stack)", sh.tok_start);
                            return -1;
                        }
                        sh.parse_stack_kind[op_len] = k;
                        sh.expr_op_at[op_len] = sh.tok_start;
                        op_len = op_len + 1;
                        paren_depth = paren_depth + 1;
                        k = sh_lex_next_kind();
                    } else {
                        if (k == ShTok.Minus) {
                            if (op_len >= SH_EXPR_STACK_CAP) {
                                sh_expr_err_at(file_idx, "expression too complex (op stack)", sh.tok_start);
                                return -1;
                            }
                            sh.parse_stack_kind[op_len] = ShTok.UnaryMinus;
                            sh.expr_op_at[op_len] = sh.tok_start;
                            op_len = op_len + 1;
                            k = sh_lex_next_kind();
                        } else {
                            if (k == ShTok.Bang) {
                                if (op_len >= SH_EXPR_STACK_CAP) {
                                    sh_expr_err_at(file_idx, "expression too complex (op stack)", sh.tok_start);
                                    return -1;
                                }
                                sh.parse_stack_kind[op_len] = ShTok.Bang;
                                sh.expr_op_at[op_len] = sh.tok_start;
                                op_len = op_len + 1;
                                k = sh_lex_next_kind();
                            } else {
                                let node: i32 = -1;
                                if (k == ShTok.IntegerLiteral) {
                                    node = sh_expr_make_int_lit(file_idx, sh.tok_start, sh_expr_parse_i32_from_tok(file_idx));
                                } else {
                                    if (k == ShTok.TrueKeyword) {
                                        node = sh_expr_make_bool_lit(file_idx, sh.tok_start, 1);
                                    } else {
                                        if (k == ShTok.FalseKeyword) {
                                            node = sh_expr_make_bool_lit(file_idx, sh.tok_start, 0);
                                        } else {
                                            if (k == ShTok.Identifier) {
                                                node = sh_expr_make_name(file_idx, sh.tok_start, sh.tok_len);
                                            } else {
                                                sh_expr_err_at(file_idx, "expected value in expression", sh.tok_start);
                                                return -1;
                                            }
                                        }
                                    }
                                }

                                if (node < 0) { return -1; }
                                if (val_len >= SH_EXPR_STACK_CAP) {
                                    sh_expr_err_at(file_idx, "expression too complex (value stack)", sh.tok_start);
                                    return -1;
                                }
                                sh.parse_stack_start[val_len] = node;
                                val_len = val_len + 1;
                                expect_value = 0;
                                k = sh_lex_next_kind();
                            }
                        }
                    }
                }
            } else {
                if (k == ShTok.Dot) {
                    if (val_len < 1) {
                        sh_expr_err_at(file_idx, "expected expression before '.'", sh.tok_start);
                        return -1;
                    }

                    let base_node: i32 = sh.parse_stack_start[val_len - 1];
                    let member_k: ShTok = sh_lex_next_kind();
                    if (!sh_expr_is_member_name(member_k)) {
                        sh_expr_err_at(file_idx, "expected member name after '.'", sh.tok_start);
                        return -1;
                    }

                    let member_node: i32 = sh_expr_make_member(file_idx, sh.expr_nodes[base_node].at, base_node, member_k, sh.tok_start, sh.tok_len);
                    if (member_node < 0) { return -1; }
                    sh.parse_stack_start[val_len - 1] = member_node;
                    k = sh_lex_next_kind();
                } else {
                    if (k == ShTok.LParen) {
                        // Postfix call: `callee(args...)`.
                        if (val_len < 1) {
                            sh_expr_err_at(file_idx, "expected call target before '('", sh.tok_start);
                            return -1;
                        }

                        let callee: i32 = sh.parse_stack_start[val_len - 1];
                        if (callee < 0 || callee >= sh.expr_count) {
                            sh_expr_err_at(file_idx, "invalid call target", sh.tok_start);
                            return -1;
                        }
                        let callee_kind: ShExprKind = sh.expr_nodes[callee].kind;
                        if (callee_kind != ShExprKind.Name && callee_kind != ShExprKind.Member) {
                            sh_expr_err_at(file_idx, "unsupported call target", sh.tok_start);
                            return -1;
                        }

                        if (sh.expr_call_len >= SH_EXPR_STACK_CAP) {
                            sh_expr_err_at(file_idx, "expression too complex (call stack)", sh.tok_start);
                            return -1;
                        }
                        if (op_len >= SH_EXPR_STACK_CAP) {
                            sh_expr_err_at(file_idx, "expression too complex (op stack)", sh.tok_start);
                            return -1;
                        }

                        // Pop callee from the value stack, then parse call args as a sub-context.
                        val_len = val_len - 1;
                         let call_idx: i32 = sh.expr_call_len;
                         sh.expr_call_len = sh.expr_call_len + 1;
                         sh.expr_call_callee[call_idx] = callee;
                         sh.expr_call_arg_off[call_idx] = sh.expr_call_tmp_args_len;
                         sh.expr_call_arg_len[call_idx] = 0;
                         sh.expr_call_val_base[call_idx] = val_len;

                        sh.parse_stack_kind[op_len] = ShTok.CallStart;
                        sh.expr_op_at[op_len] = sh.tok_start;
                        op_len = op_len + 1;

                        expect_value = 1;
                        k = sh_lex_next_kind();
                    } else {
                        if (k == ShTok.LBracket) {
                            // Postfix index: `base[expr]`.
                            if (val_len < 1) {
                                sh_expr_err_at(file_idx, "expected expression before '['", sh.tok_start);
                                return -1;
                            }
                            if (sh.expr_index_len >= SH_EXPR_STACK_CAP) {
                                sh_expr_err_at(file_idx, "expression too complex (index stack)", sh.tok_start);
                                return -1;
                            }
                            if (op_len >= SH_EXPR_STACK_CAP) {
                                sh_expr_err_at(file_idx, "expression too complex (op stack)", sh.tok_start);
                                return -1;
                            }

                            let base_node: i32 = sh.parse_stack_start[val_len - 1];
                            val_len = val_len - 1;

                            let index_idx: i32 = sh.expr_index_len;
                            sh.expr_index_len = sh.expr_index_len + 1;
                            sh.expr_index_base[index_idx] = base_node;
                            sh.expr_index_val_base[index_idx] = val_len;
                            sh.expr_index_at[index_idx] = sh.tok_start;

                            sh.parse_stack_kind[op_len] = ShTok.IndexStart;
                            sh.expr_op_at[op_len] = sh.tok_start;
                            op_len = op_len + 1;

                            expect_value = 1;
                            k = sh_lex_next_kind();
                        } else {
                            if (k == ShTok.Comma) {
                            if (sh.expr_call_len <= 0 || paren_depth != 0) {
                                sh_expr_err_at(file_idx, "unexpected ',' in expression", sh.tok_start);
                                return -1;
                            }

                            let top_call2: i32 = sh.expr_call_len - 1;
                            let base2: i32 = sh.expr_call_val_base[top_call2];

                            // Reduce operators until the call barrier.
                            for (; op_len > 0 && sh.parse_stack_kind[op_len - 1] != ShTok.CallStart; ) {
                                let top_op2: ShTok = sh.parse_stack_kind[op_len - 1];
                                if (sh_expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                    return -1;
                                }
                                op_len = op_len - 1;
                                if (top_op2 == ShTok.UnaryMinus || top_op2 == ShTok.Bang) {
                                    // val_len unchanged
                                } else {
                                    val_len = val_len - 1;
                                }
                            }

                            if (val_len != base2 + 1) {
                                sh_expr_err_at(file_idx, "expected expression in call argument", sh.tok_start);
                                return -1;
                            }
                            if (sh.expr_call_tmp_args_len >= 32768) {
                                sh_expr_err_at(file_idx, "too many call arguments (cap)", sh.tok_start);
                                return -1;
                            }
                            sh.expr_call_tmp_args[sh.expr_call_tmp_args_len] = sh.parse_stack_start[val_len - 1];
                            sh.expr_call_tmp_args_len = sh.expr_call_tmp_args_len + 1;
                            sh.expr_call_arg_len[top_call2] = sh.expr_call_arg_len[top_call2] + 1;

                            // Pop the argument value and continue with the next arg.
                            val_len = base2;
                            expect_value = 1;
                            k = sh_lex_next_kind();
                        } else {
                            if (k == ShTok.RParen) {
                                if (paren_depth > 0) {
                                    let found_lparen: i32 = 0;
                                    for (; found_lparen == 0; ) {
                                        if (op_len <= 0) {
                                            sh_expr_err_at(file_idx, "unmatched ')'", sh.tok_start);
                                            return -1;
                                        }

                                        let top: ShTok = sh.parse_stack_kind[op_len - 1];
                                        if (top == ShTok.LParen) {
                                            op_len = op_len - 1;
                                            found_lparen = 1;
                                        } else {
                                            if (sh_expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                                return -1;
                                            }
                                            op_len = op_len - 1;
                                            if (top == ShTok.UnaryMinus || top == ShTok.Bang) {
                                                // val_len unchanged
                                            } else {
                                                val_len = val_len - 1;
                                            }
                                        }
                                    }

                                    paren_depth = paren_depth - 1;
                                    k = sh_lex_next_kind();
                                } else {
                                    if (sh.expr_call_len <= 0) {
                                        sh_expr_err_at(file_idx, "unmatched ')'", sh.tok_start);
                                        return -1;
                                    }

                                    // Close a call: finalize the last argument, then build the Call node.
                                    let top_call3: i32 = sh.expr_call_len - 1;
                                    let base3: i32 = sh.expr_call_val_base[top_call3];

                                    // Reduce operators until the call barrier.
                                    for (; op_len > 0 && sh.parse_stack_kind[op_len - 1] != ShTok.CallStart; ) {
                                        let top_op3: ShTok = sh.parse_stack_kind[op_len - 1];
                                        if (sh_expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                            return -1;
                                        }
                                        op_len = op_len - 1;
                                        if (top_op3 == ShTok.UnaryMinus || top_op3 == ShTok.Bang) {
                                            // val_len unchanged
                                        } else {
                                            val_len = val_len - 1;
                                        }
                                    }

                                    if (val_len != base3 + 1) {
                                        sh_expr_err_at(file_idx, "expected expression in call argument", sh.tok_start);
                                        return -1;
                                    }
                                    if (op_len <= 0 || sh.parse_stack_kind[op_len - 1] != ShTok.CallStart) {
                                        sh_expr_err_at(file_idx, "internal error: call stack desync", sh.tok_start);
                                        return -1;
                                    }

                                    if (sh.expr_call_tmp_args_len >= 32768) {
                                        sh_expr_err_at(file_idx, "too many call arguments (cap)", sh.tok_start);
                                        return -1;
                                    }
                                    sh.expr_call_tmp_args[sh.expr_call_tmp_args_len] = sh.parse_stack_start[val_len - 1];
                                    sh.expr_call_tmp_args_len = sh.expr_call_tmp_args_len + 1;
                                    sh.expr_call_arg_len[top_call3] = sh.expr_call_arg_len[top_call3] + 1;
                                    val_len = base3;

                                    let callee3: i32 = sh.expr_call_callee[top_call3];
                                    let args_len3: i32 = sh.expr_call_arg_len[top_call3];
                                    let tmp_args_off3: i32 = sh.expr_call_arg_off[top_call3];
                                    let args_off3: i32 = sh.expr_call_args_len;
                                    if (args_off3 + args_len3 > 32768) {
                                        sh_expr_err_at(file_idx, "too many call arguments (cap)", sh.tok_start);
                                        return -1;
                                    }

                                    let arg_i: i32 = 0;
                                    for (; arg_i < args_len3; ) {
                                        sh.expr_call_args[args_off3 + arg_i] = sh.expr_call_tmp_args[tmp_args_off3 + arg_i];
                                        arg_i = arg_i + 1;
                                    }
                                    sh.expr_call_args_len = sh.expr_call_args_len + args_len3;
                                    sh.expr_call_tmp_args_len = tmp_args_off3;

                                    sh.expr_call_len = top_call3;
                                    op_len = op_len - 1; // pop CallStart

                                    let call_node3: i32 = sh_expr_make_call(file_idx, sh.expr_nodes[callee3].at, callee3, args_off3, args_len3);
                                    if (call_node3 < 0) { return -1; }
                                    if (val_len >= SH_EXPR_STACK_CAP) {
                                        sh_expr_err_at(file_idx, "expression too complex (value stack)", sh.tok_start);
                                        return -1;
                                    }
                                    sh.parse_stack_start[val_len] = call_node3;
                                    val_len = val_len + 1;
                                    expect_value = 0;
                                    k = sh_lex_next_kind();
                                }
                            } else {
                                if (k == ShTok.RBracket) {
                                    if (sh.expr_index_len <= 0) {
                                        sh_expr_err_at(file_idx, "unmatched ']'", sh.tok_start);
                                        return -1;
                                    }

                                    let top_index: i32 = sh.expr_index_len - 1;
                                    let base2: i32 = sh.expr_index_val_base[top_index];

                                    // Reduce operators until the index barrier.
                                    for (; op_len > 0 && sh.parse_stack_kind[op_len - 1] != ShTok.IndexStart && sh.parse_stack_kind[op_len - 1] != ShTok.CallStart; ) {
                                        let top_op4: ShTok = sh.parse_stack_kind[op_len - 1];
                                        if (sh_expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                            return -1;
                                        }
                                        op_len = op_len - 1;
                                        if (top_op4 == ShTok.UnaryMinus || top_op4 == ShTok.Bang) {
                                            // val_len unchanged
                                        } else {
                                            val_len = val_len - 1;
                                        }
                                    }

                                    if (op_len <= 0) {
                                        sh_expr_err_at(file_idx, "internal error: index stack desync", sh.tok_start);
                                        return -1;
                                    }
                                    if (sh.parse_stack_kind[op_len - 1] == ShTok.CallStart) {
                                        sh_expr_err_at(file_idx, "expected ')' before ']'", sh.tok_start);
                                        return -1;
                                    }

                                    if (val_len != base2 + 1) {
                                        sh_expr_err_at(file_idx, "expected expression in index", sh.tok_start);
                                        return -1;
                                    }
                                    if (sh.parse_stack_kind[op_len - 1] != ShTok.IndexStart) {
                                        sh_expr_err_at(file_idx, "internal error: index stack desync", sh.tok_start);
                                        return -1;
                                    }

                                    let index_expr: i32 = sh.parse_stack_start[val_len - 1];
                                    let base_node2: i32 = sh.expr_index_base[top_index];

                                    sh.expr_index_len = top_index;
                                    op_len = op_len - 1; // pop IndexStart

                                    let index_node: i32 = sh_expr_make_index(file_idx, sh.expr_nodes[base_node2].at, base_node2, index_expr);
                                    if (index_node < 0) { return -1; }
                                    sh.parse_stack_start[val_len - 1] = index_node;
                                    expect_value = 0;
                                    k = sh_lex_next_kind();
                                } else {
                                    if (sh_expr_is_infix(k)) {
                                    let prec: i32 = sh_expr_prec(k);
                                    let reduce: i32 = 1;
                                    for (; reduce != 0; ) {
                                        reduce = 0;
                                        if (op_len > 0) {
                                            let top2: ShTok = sh.parse_stack_kind[op_len - 1];
                                            if (top2 != ShTok.LParen && top2 != ShTok.CallStart && top2 != ShTok.IndexStart) {
                                                let top_prec: i32 = sh_expr_prec(top2);
                                                if (top_prec > prec || (top_prec == prec && !sh_expr_is_right_assoc(k))) {
                                                    if (sh_expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                                        return -1;
                                                    }
                                                    op_len = op_len - 1;
                                                    if (top2 == ShTok.UnaryMinus || top2 == ShTok.Bang) {
                                                        // val_len unchanged
                                                    } else {
                                                        val_len = val_len - 1;
                                                    }
                                                    reduce = 1;
                                                }
                                            }
                                        }
                                    }

                                    if (op_len >= SH_EXPR_STACK_CAP) {
                                        sh_expr_err_at(file_idx, "expression too complex (op stack)", sh.tok_start);
                                        return -1;
                                    }
                                    sh.parse_stack_kind[op_len] = k;
                                    sh.expr_op_at[op_len] = sh.tok_start;
                                    op_len = op_len + 1;
                                    expect_value = 1;
                                    k = sh_lex_next_kind();
                                } else {
                                    sh_expr_err_at(file_idx, "expected operator in expression", sh.tok_start);
                                    return -1;
                                }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    if (expect_value != 0) {
        sh_expr_err_at(file_idx, "expected value in expression", sh.tok_start);
        return -1;
    }

    for (; op_len > 0; ) {
        let top3: ShTok = sh.parse_stack_kind[op_len - 1];
        if (top3 == ShTok.LParen || top3 == ShTok.CallStart) {
            sh_expr_err_at(file_idx, "unmatched '('", sh.expr_op_at[op_len - 1]);
            return -1;
        }
        if (top3 == ShTok.IndexStart) {
            sh_expr_err_at(file_idx, "unmatched '['", sh.expr_op_at[op_len - 1]);
            return -1;
        }
        if (sh_expr_reduce_top(file_idx, op_len, val_len) != 0) {
            return -1;
        }
        op_len = op_len - 1;
        if (top3 == ShTok.UnaryMinus || top3 == ShTok.Bang) {
            // val_len unchanged
        } else {
            val_len = val_len - 1;
        }
    }

    if (sh.expr_call_len != 0) {
        sh_expr_err_at(file_idx, "unclosed call in expression", sh.tok_start);
        return -1;
    }
    if (sh.expr_index_len != 0) {
        sh_expr_err_at(file_idx, "unclosed index in expression", sh.expr_index_at[sh.expr_index_len - 1]);
        return -1;
    }

    if (val_len != 1) {
        sh_expr_err_at(file_idx, "invalid expression", sh.tok_start);
        return -1;
    }

    return sh.parse_stack_start[0];
}

// Parses an expression starting at the current lexer position and consumes the terminator.
// Returns the expression root node index, or -1 on error.
function sh_expr_parse_until(file_idx: i32, terminator: ShTok): i32 {
    let first: ShTok = sh_lex_next_kind();
    return sh_expr_parse_after_first(file_idx, first, terminator);
}

// Iterative (stack-based) evaluator for i32/bool constant expressions.
// Sets sh.expr_eval_failed for non-constant nodes.
function sh_expr_eval_i32_const(root: i32): i32 {
    sh.expr_eval_failed = 0;
    if (root < 0) {
        sh.expr_eval_failed = 1;
        return 0;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;

    // Node stack uses sh.parse_stack_start; visited flag is encoded by negating the index.
    sh.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = sh.parse_stack_start[sp - 1];
        if (top >= 0) {
            sh.parse_stack_start[sp - 1] = -top - 1;

            let kind: ShExprKind = sh.expr_nodes[top].kind;
            if (kind == ShExprKind.Unary) {
                if (sp >= SH_EXPR_STACK_CAP) { sh.expr_eval_failed = 1; return 0; }
                sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ShExprKind.Binary || kind == ShExprKind.Assign) {
                    if (sp + 1 >= SH_EXPR_STACK_CAP) { sh.expr_eval_failed = 1; return 0; }
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].right;
                    sp = sp + 1;
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                    sp = sp + 1;
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= SH_EXPR_STACK_CAP) { sh.expr_eval_failed = 1; return 0; }

            let kind2: ShExprKind = sh.expr_nodes[idx].kind;
            if (kind2 == ShExprKind.IntLiteral || kind2 == ShExprKind.BoolLiteral) {
                sh.expr_op_at[val_len] = sh.expr_nodes[idx].value;
                val_len = val_len + 1;
            } else {
                if (kind2 == ShExprKind.Unary) {
                    if (val_len < 1) { sh.expr_eval_failed = 1; return 0; }
                    let v: i32 = sh.expr_op_at[val_len - 1];
                    val_len = val_len - 1;

                    let r: i32 = 0;
                    let op: ShTok = sh.expr_nodes[idx].op;
                    if (op == ShTok.UnaryMinus) {
                        r = -v;
                    } else {
                        if (op == ShTok.Bang) {
                            r = 0;
                            if (v == 0) { r = 1; }
                        } else {
                            if (sh.expr_eval_failed == 0) {
                                sh_expr_err_at(sh.expr_nodes[idx].file_idx, "unsupported unary operator in const expression", sh.expr_nodes[idx].at);
                            }
                            sh.expr_eval_failed = 1;
                        }
                    }

                    sh.expr_op_at[val_len] = r;
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ShExprKind.Binary) {
                        if (val_len < 2) { sh.expr_eval_failed = 1; return 0; }
                        let b: i32 = sh.expr_op_at[val_len - 1];
                        let a: i32 = sh.expr_op_at[val_len - 2];
                        val_len = val_len - 2;

                        let r2: i32 = 0;
                        let handled: i32 = 0;
                        let op2: ShTok = sh.expr_nodes[idx].op;
                        let at: i32 = sh.expr_nodes[idx].at;
                        let src_file: i32 = sh.expr_nodes[idx].file_idx;

                        if (op2 == ShTok.Plus) { r2 = a + b; handled = 1; }
                        if (op2 == ShTok.Minus) { r2 = a - b; handled = 1; }
                        if (op2 == ShTok.Star) { r2 = a * b; handled = 1; }
                        if (op2 == ShTok.Slash) {
                            handled = 1;
                            if (b == 0) {
                                sh_expr_err_at(src_file, "division by zero", at);
                                sh.expr_eval_failed = 1;
                                r2 = 0;
                            } else {
                                r2 = a / b;
                            }
                        }
                        if (op2 == ShTok.Percent) {
                            handled = 1;
                            if (b == 0) {
                                sh_expr_err_at(src_file, "modulo by zero", at);
                                sh.expr_eval_failed = 1;
                                r2 = 0;
                            } else {
                                r2 = a % b;
                            }
                        }

                        if (op2 == ShTok.EqualEqual) { r2 = 0; if (a == b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.BangEqual) { r2 = 0; if (a != b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.Less) { r2 = 0; if (a < b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.LessEqual) { r2 = 0; if (a <= b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.Greater) { r2 = 0; if (a > b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.GreaterEqual) { r2 = 0; if (a >= b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.AmpAmp) { r2 = 0; if (a != 0 && b != 0) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.PipePipe) { r2 = 0; if (a != 0 || b != 0) { r2 = 1; } handled = 1; }

                        if (handled == 0) {
                            if (sh.expr_eval_failed == 0) {
                                sh_expr_err_at(src_file, "unsupported operator in const expression", at);
                            }
                            sh.expr_eval_failed = 1;
                            r2 = 0;
                        }

                        sh.expr_op_at[val_len] = r2;
                        val_len = val_len + 1;
                    } else {
                        if (sh.expr_eval_failed == 0) {
                            if (kind2 == ShExprKind.Name) {
                                sh_expr_err_at(sh.expr_nodes[idx].file_idx, "non-constant identifier in expression (minimal build only)", sh.expr_nodes[idx].at);
                            } else {
                                if (kind2 == ShExprKind.Assign) {
                                    sh_expr_err_at(sh.expr_nodes[idx].file_idx, "assignment in constant expression (minimal build only)", sh.expr_nodes[idx].at);
                                } else {
                                    sh_expr_err_at(sh.expr_nodes[idx].file_idx, "non-constant expression (minimal build only)", sh.expr_nodes[idx].at);
                                }
                            }
                        }
                        sh.expr_eval_failed = 1;
                        sh.expr_op_at[val_len] = 0;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }

    if (val_len != 1) {
        sh.expr_eval_failed = 1;
        return 0;
    }
    return sh.expr_op_at[0];
}

// Silent i32/bool constant evaluator:
// - Never prints diagnostics.
// - Sets sh.expr_eval_failed != 0 when the expression is not a pure constant expression.
function sh_expr_try_eval_i32_const(root: i32): i32 {
    sh.expr_eval_failed = 0;
    if (root < 0) {
        sh.expr_eval_failed = 1;
        return 0;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;

    sh.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = sh.parse_stack_start[sp - 1];
        if (top >= 0) {
            sh.parse_stack_start[sp - 1] = -top - 1;

            let kind: ShExprKind = sh.expr_nodes[top].kind;
            if (kind == ShExprKind.Unary) {
                if (sp >= SH_EXPR_STACK_CAP) { sh.expr_eval_failed = 1; return 0; }
                sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ShExprKind.Binary || kind == ShExprKind.Assign) {
                    if (sp + 1 >= SH_EXPR_STACK_CAP) { sh.expr_eval_failed = 1; return 0; }
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].right;
                    sp = sp + 1;
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                    sp = sp + 1;
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= SH_EXPR_STACK_CAP) { sh.expr_eval_failed = 1; return 0; }

            let kind2: ShExprKind = sh.expr_nodes[idx].kind;
            if (kind2 == ShExprKind.IntLiteral || kind2 == ShExprKind.BoolLiteral) {
                sh.expr_op_at[val_len] = sh.expr_nodes[idx].value;
                val_len = val_len + 1;
            } else {
                if (kind2 == ShExprKind.Unary) {
                    if (val_len < 1) { sh.expr_eval_failed = 1; return 0; }
                    let v: i32 = sh.expr_op_at[val_len - 1];
                    val_len = val_len - 1;

                    let r: i32 = 0;
                    let op: ShTok = sh.expr_nodes[idx].op;
                    if (op == ShTok.UnaryMinus) { r = -v; }
                    else { if (op == ShTok.Bang) { r = 0; if (v == 0) { r = 1; } }
                    else { sh.expr_eval_failed = 1; r = 0; } }

                    sh.expr_op_at[val_len] = r;
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ShExprKind.Binary) {
                        if (val_len < 2) { sh.expr_eval_failed = 1; return 0; }
                        let b: i32 = sh.expr_op_at[val_len - 1];
                        let a: i32 = sh.expr_op_at[val_len - 2];
                        val_len = val_len - 2;

                        let r2: i32 = 0;
                        let handled: i32 = 0;
                        let op2: ShTok = sh.expr_nodes[idx].op;

                        if (op2 == ShTok.Plus) { r2 = a + b; handled = 1; }
                        if (op2 == ShTok.Minus) { r2 = a - b; handled = 1; }
                        if (op2 == ShTok.Star) { r2 = a * b; handled = 1; }
                        if (op2 == ShTok.Slash) { handled = 1; if (b == 0) { sh.expr_eval_failed = 1; r2 = 0; } else { r2 = a / b; } }
                        if (op2 == ShTok.Percent) { handled = 1; if (b == 0) { sh.expr_eval_failed = 1; r2 = 0; } else { r2 = a % b; } }

                        if (op2 == ShTok.EqualEqual) { r2 = 0; if (a == b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.BangEqual) { r2 = 0; if (a != b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.Less) { r2 = 0; if (a < b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.LessEqual) { r2 = 0; if (a <= b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.Greater) { r2 = 0; if (a > b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.GreaterEqual) { r2 = 0; if (a >= b) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.AmpAmp) { r2 = 0; if (a != 0 && b != 0) { r2 = 1; } handled = 1; }
                        if (op2 == ShTok.PipePipe) { r2 = 0; if (a != 0 || b != 0) { r2 = 1; } handled = 1; }

                        if (handled == 0) {
                            sh.expr_eval_failed = 1;
                            r2 = 0;
                        }

                        sh.expr_op_at[val_len] = r2;
                        val_len = val_len + 1;
                    } else {
                        sh.expr_eval_failed = 1;
                        sh.expr_op_at[val_len] = 0;
                        val_len = val_len + 1;
                    }
                }
            }
        }
    }

    if (val_len != 1) {
        sh.expr_eval_failed = 1;
        return 0;
    }
    return sh.expr_op_at[0];
}
