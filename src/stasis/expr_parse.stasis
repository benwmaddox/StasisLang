import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

const EXPR_STACK_CAP: i32 = 4096;

function expr_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (st.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_file_loc(file_idx, at);
    print_char(10);
}

function expr_parse_i32_from_tok(file_idx: i32): i32 {
    let v: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < st.tok_len; i = i + 1) {
        let b: u8 = st.pool[st.lex_base + st.tok_start + i];
        if (!ascii_is_digit(b)) {
            expr_err_at(file_idx, "expected integer literal", st.tok_start);
            return 0;
        }
        v = v * 10 + ascii_to_digit(b);
    }
    return v;
}

function expr_node_new(): i32 {
    if (st.expr_count >= 16384) {
        return -1;
    }
    let idx: i32 = st.expr_count;
    st.expr_count = st.expr_count + 1;
    return idx;
}

function expr_make_int_lit(file_idx: i32, at: i32, value: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    st.expr_nodes[idx].kind = ExprKind.IntLiteral;
    st.expr_nodes[idx].file_idx = file_idx;
    st.expr_nodes[idx].at = at;
    st.expr_nodes[idx].op = Tok.Unknown;
    st.expr_nodes[idx].left = -1;
    st.expr_nodes[idx].right = -1;
    st.expr_nodes[idx].value = value;
    st.expr_nodes[idx].name_start = 0;
    st.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_make_bool_lit(file_idx: i32, at: i32, value: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
