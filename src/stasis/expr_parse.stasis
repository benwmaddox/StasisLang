function expr_make_assign(file_idx: i32, at: i32, op: Tok, left: i32, right: i32): i32 {
    let idx: i32 = expr_node_new();
    if (idx < 0) {
        expr_err_at(file_idx, "expression too complex (node cap)", at);
        return -1;
    }
    stasis.expr_nodes[idx].kind = ExprKind.Assign;
    stasis.expr_nodes[idx].file_idx = file_idx;
    stasis.expr_nodes[idx].at = at;
    stasis.expr_nodes[idx].op = op;
    stasis.expr_nodes[idx].left = left;
    stasis.expr_nodes[idx].right = right;
    stasis.expr_nodes[idx].value = 0;
    stasis.expr_nodes[idx].name_start = 0;
    stasis.expr_nodes[idx].name_len = 0;
    return idx;
}

function expr_is_assign(k: Tok): bool {
    return k == Tok.Equal
        || k == Tok.PlusEqual
        || k == Tok.MinusEqual
        || k == Tok.StarEqual
        || k == Tok.SlashEqual
        || k == Tok.PercentEqual;
}

function expr_is_infix(k: Tok): bool {
    if (expr_is_assign(k)) { return true; }
    return k == Tok.PipePipe
        || k == Tok.AmpAmp
        || k == Tok.EqualEqual
        || k == Tok.BangEqual
        || k == Tok.Less
        || k == Tok.LessEqual
        || k == Tok.Greater
        || k == Tok.GreaterEqual
        || k == Tok.Plus
        || k == Tok.Minus
        || k == Tok.Star
        || k == Tok.Slash
        || k == Tok.Percent;
}

function expr_prec(k: Tok): i32 {
    if (expr_is_assign(k)) { return 1; }
    if (k == Tok.PipePipe) { return 2; }
    if (k == Tok.AmpAmp) { return 3; }
    if (k == Tok.EqualEqual || k == Tok.BangEqual) { return 4; }
    if (k == Tok.Less || k == Tok.LessEqual || k == Tok.Greater || k == Tok.GreaterEqual) { return 5; }
    if (k == Tok.Plus || k == Tok.Minus) { return 6; }
    if (k == Tok.Star || k == Tok.Slash || k == Tok.Percent) { return 7; }
    if (k == Tok.UnaryMinus || k == Tok.Bang) { return 8; }
    return 0;
}

function expr_is_right_assoc(k: Tok): bool {
    return expr_is_assign(k) || k == Tok.UnaryMinus || k == Tok.Bang;
}

function expr_is_member_name(k: Tok): bool {
    if (k == Tok.Identifier) { return true; }
    return k == Tok.Plus
        || k == Tok.Minus
        || k == Tok.Star
        || k == Tok.Slash
        || k == Tok.Percent
        || k == Tok.AmpAmp
        || k == Tok.PipePipe
        || k == Tok.Less
        || k == Tok.LessEqual
        || k == Tok.Greater
        || k == Tok.GreaterEqual
        || k == Tok.EqualEqual
        || k == Tok.BangEqual;
}

function expr_reduce_top(file_idx: i32, op_len: i32, val_len: i32): i32 {
    if (op_len <= 0) {
        return -1;
    }
    let op: Tok = stasis.parse_stack_kind[op_len - 1];
    let at: i32 = stasis.expr_op_at[op_len - 1];

    if (op == Tok.LParen || op == Tok.CallStart) {
        expr_err_at(file_idx, "unmatched '('", at);
        return -1;
    }
    if (op == Tok.IndexStart) {
        expr_err_at(file_idx, "unmatched '['", at);
        return -1;
    }

    if (op == Tok.UnaryMinus || op == Tok.Bang) {
        if (val_len < 1) {
            expr_err_at(file_idx, "invalid expression", at);
            return -1;
        }
        let operand: i32 = stasis.parse_stack_start[val_len - 1];
        let idx: i32 = expr_make_unary(file_idx, at, op, operand);
        if (idx < 0) { return -1; }
        stasis.parse_stack_start[val_len - 1] = idx;
        return 0;
    }

    if (val_len < 2) {
        expr_err_at(file_idx, "invalid expression", at);
        return -1;
    }

    let right: i32 = stasis.parse_stack_start[val_len - 1];
    let left: i32 = stasis.parse_stack_start[val_len - 2];
    let idx2: i32 = -1;
    if (expr_is_assign(op)) {
        idx2 = expr_make_assign(file_idx, at, op, left, right);
    } else {
        idx2 = expr_make_binary(file_idx, at, op, left, right);
    }
    if (idx2 < 0) { return -1; }
    stasis.parse_stack_start[val_len - 2] = idx2;
    return 0;
}

// Parses an expression after the first token has already been consumed.
// Consumes the terminator and returns the expression root node index, or -1 on error.
function expr_parse_after_first(file_idx: i32, first: Tok, terminator: Tok): i32 {
    stasis.expr_count = 0;
    stasis.expr_call_args_len = 0;
    stasis.expr_call_tmp_args_len = 0;
    stasis.expr_call_len = 0;
    stasis.expr_index_len = 0;

    let op_len: i32 = 0;
    let val_len: i32 = 0;
    let expect_value: i32 = 1;
    let paren_depth: i32 = 0;
    let base_node: i32 = 0;
    let base2: i32 = 0;

    let k: Tok = first;
    let done: i32 = 0;
    for (; done == 0; ) {
        if (k == Tok.Eof) {
            expr_err_at(file_idx, "unexpected eof in expression", stasis.tok_start);
            return -1;
        }

        if (expect_value == 0 && stasis.expr_call_len == 0 && stasis.expr_index_len == 0 && paren_depth == 0 && k == terminator) {
            done = 1;
        }

            if (done == 0) {
                if (expect_value != 0) {
                    // Allow empty-arg calls: `callee()`.
                    if (k == Tok.RParen && stasis.expr_call_len > 0 && op_len > 0 && stasis.parse_stack_kind[op_len - 1] == Tok.CallStart) {
                        let top_call: i32 = stasis.expr_call_len - 1;
                        if (stasis.expr_call_arg_len[top_call] != 0 || val_len != stasis.expr_call_val_base[top_call]) {
                            expr_err_at(file_idx, "expected expression after ','", stasis.tok_start);
                            return -1;
                        }

                        let callee0: i32 = stasis.expr_call_callee[top_call];
                        let tmp_args_off0: i32 = stasis.expr_call_arg_off[top_call];

                        stasis.expr_call_len = top_call;
                        op_len = op_len - 1; // pop CallStart
                        stasis.expr_call_tmp_args_len = tmp_args_off0;

                        let call_node0: i32 = expr_make_call(file_idx, stasis.expr_nodes[callee0].at, callee0, stasis.expr_call_args_len, 0);
                        if (call_node0 < 0) { return -1; }
                        if (val_len >= EXPR_STACK_CAP) {
                            expr_err_at(file_idx, "expression too complex (value stack)", stasis.tok_start);
                            return -1;
                        }
                        stasis.parse_stack_start[val_len] = call_node0;
                        val_len = val_len + 1;
                        expect_value = 0;
                        k = lex_next_kind();
                    } else {
                        if (k == Tok.LParen) {
                            if (op_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (op stack)", stasis.tok_start);
                                return -1;
                        }
                        stasis.parse_stack_kind[op_len] = k;
                        stasis.expr_op_at[op_len] = stasis.tok_start;
                        op_len = op_len + 1;
                        paren_depth = paren_depth + 1;
                        k = lex_next_kind();
                    } else {
                        if (k == Tok.Minus) {
                            if (op_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (op stack)", stasis.tok_start);
                                return -1;
                            }
                            stasis.parse_stack_kind[op_len] = Tok.UnaryMinus;
                            stasis.expr_op_at[op_len] = stasis.tok_start;
                            op_len = op_len + 1;
                            k = lex_next_kind();
                        } else {
                            if (k == Tok.Bang) {
                                if (op_len >= EXPR_STACK_CAP) {
                                    expr_err_at(file_idx, "expression too complex (op stack)", stasis.tok_start);
                                    return -1;
                                }
                                stasis.parse_stack_kind[op_len] = Tok.Bang;
                                stasis.expr_op_at[op_len] = stasis.tok_start;
                                op_len = op_len + 1;
                                k = lex_next_kind();
                            } else {
                                let node: i32 = -1;
                                if (k == Tok.IntegerLiteral || k == Tok.U8Literal) {
                                    node = expr_make_int_lit(file_idx, stasis.tok_start, expr_parse_i32_from_tok(file_idx));
                                } else {
                                    if (k == Tok.FloatLiteral) {
                                        node = expr_make_float_lit(file_idx, stasis.tok_start, stasis.tok_len);
                                    } else {
                                    if (k == Tok.TrueKeyword) {
                                        node = expr_make_bool_lit(file_idx, stasis.tok_start, 1);
                                    } else {
                                        if (k == Tok.FalseKeyword) {
                                            node = expr_make_bool_lit(file_idx, stasis.tok_start, 0);
                                        } else {
                                            if (k == Tok.Identifier) {
                                                node = expr_make_name(file_idx, stasis.tok_start, stasis.tok_len);
                                            } else {
                                                if (k == Tok.StringLiteral) {
                                                    node = expr_make_string_lit(file_idx, stasis.tok_start, stasis.tok_len);
                                                } else {
                                                    expr_err_at(file_idx, "expected value in expression", stasis.tok_start);
                                                    return -1;
                                                }
                                            }
                                        }
                                    }
                                    }
                                }

                                if (node < 0) { return -1; }
                                if (val_len >= EXPR_STACK_CAP) {
                                    expr_err_at(file_idx, "expression too complex (value stack)", stasis.tok_start);
                                    return -1;
                                }
                                stasis.parse_stack_start[val_len] = node;
                                val_len = val_len + 1;
                                expect_value = 0;
                                k = lex_next_kind();
                            }
                        }
                    }
                }
            } else {
                if (k == Tok.Dot) {
                    if (val_len < 1) {
                        expr_err_at(file_idx, "expected expression before '.'", stasis.tok_start);
                        return -1;
                    }

                    base_node = stasis.parse_stack_start[val_len - 1];
                    let member_k: Tok = lex_next_kind();
                    if (!expr_is_member_name(member_k)) {
                        expr_err_at(file_idx, "expected member name after '.'", stasis.tok_start);
                        return -1;
                    }

                    let member_node: i32 = expr_make_member(file_idx, stasis.expr_nodes[base_node].at, base_node, member_k, stasis.tok_start, stasis.tok_len);
                    if (member_node < 0) { return -1; }
                    stasis.parse_stack_start[val_len - 1] = member_node;
                    k = lex_next_kind();
                } else {
                    if (k == Tok.LParen) {
                        // Postfix call: `callee(args...)`.
                        if (val_len < 1) {
                            expr_err_at(file_idx, "expected call target before '('", stasis.tok_start);
                            return -1;
                        }

                        let callee: i32 = stasis.parse_stack_start[val_len - 1];
                        if (callee < 0 || callee >= stasis.expr_count) {
                            expr_err_at(file_idx, "invalid call target", stasis.tok_start);
                            return -1;
                        }
                        let callee_kind: ExprKind = stasis.expr_nodes[callee].kind;
                        if (callee_kind != ExprKind.Name && callee_kind != ExprKind.Member) {
                            expr_err_at(file_idx, "unsupported call target", stasis.tok_start);
                            return -1;
                        }

                        if (stasis.expr_call_len >= EXPR_STACK_CAP) {
                            expr_err_at(file_idx, "expression too complex (call stack)", stasis.tok_start);
                            return -1;
                        }
                        if (op_len >= EXPR_STACK_CAP) {
                            expr_err_at(file_idx, "expression too complex (op stack)", stasis.tok_start);
                            return -1;
                        }

                        // Pop callee from the value stack, then parse call args as a sub-context.
                        val_len = val_len - 1;
                         let call_idx: i32 = stasis.expr_call_len;
                         stasis.expr_call_len = stasis.expr_call_len + 1;
                         stasis.expr_call_callee[call_idx] = callee;
                         stasis.expr_call_arg_off[call_idx] = stasis.expr_call_tmp_args_len;
                         stasis.expr_call_arg_len[call_idx] = 0;
                         stasis.expr_call_val_base[call_idx] = val_len;

                        stasis.parse_stack_kind[op_len] = Tok.CallStart;
                        stasis.expr_op_at[op_len] = stasis.tok_start;
                        op_len = op_len + 1;

                        expect_value = 1;
                        k = lex_next_kind();
                    } else {
                        if (k == Tok.LBracket) {
                            // Postfix index: `base[expr]`.
                            if (val_len < 1) {
                                expr_err_at(file_idx, "expected expression before '['", stasis.tok_start);
                                return -1;
                            }
                            if (stasis.expr_index_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (index stack)", stasis.tok_start);
                                return -1;
                            }
                            if (op_len >= EXPR_STACK_CAP) {
                                expr_err_at(file_idx, "expression too complex (op stack)", stasis.tok_start);
                                return -1;
                            }

                            base_node = stasis.parse_stack_start[val_len - 1];
                            val_len = val_len - 1;

                            let index_idx: i32 = stasis.expr_index_len;
                            stasis.expr_index_len = stasis.expr_index_len + 1;
                            stasis.expr_index_base[index_idx] = base_node;
                            stasis.expr_index_val_base[index_idx] = val_len;
                            stasis.expr_index_at[index_idx] = stasis.tok_start;

                            stasis.parse_stack_kind[op_len] = Tok.IndexStart;
                            stasis.expr_op_at[op_len] = stasis.tok_start;
                            op_len = op_len + 1;

                            expect_value = 1;
                            k = lex_next_kind();
                        } else {
                            if (k == Tok.Comma) {
                            if (stasis.expr_call_len <= 0 || paren_depth != 0) {
                                expr_err_at(file_idx, "unexpected ',' in expression", stasis.tok_start);
                                return -1;
                            }

                            let top_call2: i32 = stasis.expr_call_len - 1;
                            base2 = stasis.expr_call_val_base[top_call2];

                            // Reduce operators until the call barrier.
                            for (; op_len > 0 && stasis.parse_stack_kind[op_len - 1] != Tok.CallStart; ) {
                                let top_op2: Tok = stasis.parse_stack_kind[op_len - 1];
                                if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                    return -1;
                                }
                                op_len = op_len - 1;
                                if (top_op2 == Tok.UnaryMinus || top_op2 == Tok.Bang) {
                                    // val_len unchanged
                                } else {
                                    val_len = val_len - 1;
                                }
                            }

                            if (val_len != base2 + 1) {
                                expr_err_at(file_idx, "expected expression in call argument", stasis.tok_start);
                                return -1;
                            }
                            if (stasis.expr_call_tmp_args_len >= 32768) {
                                expr_err_at(file_idx, "too many call arguments (cap)", stasis.tok_start);
                                return -1;
                            }
                            stasis.expr_call_tmp_args[stasis.expr_call_tmp_args_len] = stasis.parse_stack_start[val_len - 1];
                            stasis.expr_call_tmp_args_len = stasis.expr_call_tmp_args_len + 1;
                            stasis.expr_call_arg_len[top_call2] = stasis.expr_call_arg_len[top_call2] + 1;

                            // Pop the argument value and continue with the next arg.
                            val_len = base2;
                            expect_value = 1;
                            k = lex_next_kind();
                        } else {
                            if (k == Tok.RParen) {
                                // Reduce operators until we hit a barrier: either a call start or a grouping paren.
                                let found_barrier: i32 = 0;
                                for (; found_barrier == 0; ) {
                                    if (op_len <= 0) {
                                        expr_err_at(file_idx, "unmatched ')'", stasis.tok_start);
                                        return -1;
                                    }

                                    let top: Tok = stasis.parse_stack_kind[op_len - 1];
                                    if (top == Tok.CallStart || top == Tok.LParen) {
                                        found_barrier = 1;
                                    } else {
                                        if (top == Tok.IndexStart) {
                                            expr_err_at(file_idx, "unmatched ')'", stasis.tok_start);
                                            return -1;
                                        }
                                        if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                            return -1;
                                        }
                                        op_len = op_len - 1;
                                        if (top == Tok.UnaryMinus || top == Tok.Bang) {
                                            // val_len unchanged
                                        } else {
                                            val_len = val_len - 1;
                                        }
                                    }
                                }

                                if (stasis.parse_stack_kind[op_len - 1] == Tok.LParen) {
                                    op_len = op_len - 1;
                                    paren_depth = paren_depth - 1;
                                    k = lex_next_kind();
                                } else {
                                    if (stasis.expr_call_len <= 0) {
                                        expr_err_at(file_idx, "unmatched ')'", stasis.tok_start);
                                        return -1;
                                    }

                                    // Close a call: finalize the last argument, then build the Call node.
                                    let top_call3: i32 = stasis.expr_call_len - 1;
                                    let base3: i32 = stasis.expr_call_val_base[top_call3];

                                    if (val_len != base3 + 1) {
                                        expr_err_at(file_idx, "expected expression in call argument", stasis.tok_start);
                                        return -1;
                                    }
                                    if (op_len <= 0 || stasis.parse_stack_kind[op_len - 1] != Tok.CallStart) {
                                        expr_err_at(file_idx, "internal error: call stack desync", stasis.tok_start);
                                        return -1;
                                    }

                                    if (stasis.expr_call_tmp_args_len >= 32768) {
                                        expr_err_at(file_idx, "too many call arguments (cap)", stasis.tok_start);
                                        return -1;
                                    }
                                    stasis.expr_call_tmp_args[stasis.expr_call_tmp_args_len] = stasis.parse_stack_start[val_len - 1];
                                    stasis.expr_call_tmp_args_len = stasis.expr_call_tmp_args_len + 1;
                                    stasis.expr_call_arg_len[top_call3] = stasis.expr_call_arg_len[top_call3] + 1;
                                    val_len = base3;

                                    let callee3: i32 = stasis.expr_call_callee[top_call3];
                                    let args_len3: i32 = stasis.expr_call_arg_len[top_call3];
                                    let tmp_args_off3: i32 = stasis.expr_call_arg_off[top_call3];
                                    let args_off3: i32 = stasis.expr_call_args_len;
                                    if (args_off3 + args_len3 > 32768) {
                                        expr_err_at(file_idx, "too many call arguments (cap)", stasis.tok_start);
                                        return -1;
                                    }

                                    let arg_i: i32 = 0;
                                    for (; arg_i < args_len3; ) {
                                        stasis.expr_call_args[args_off3 + arg_i] = stasis.expr_call_tmp_args[tmp_args_off3 + arg_i];
                                        arg_i = arg_i + 1;
                                    }
                                    stasis.expr_call_args_len = stasis.expr_call_args_len + args_len3;
                                    stasis.expr_call_tmp_args_len = tmp_args_off3;

                                    stasis.expr_call_len = top_call3;
                                    op_len = op_len - 1; // pop CallStart

                                    let call_node3: i32 = expr_make_call(file_idx, stasis.expr_nodes[callee3].at, callee3, args_off3, args_len3);
                                    if (call_node3 < 0) { return -1; }
                                    if (val_len >= EXPR_STACK_CAP) {
                                        expr_err_at(file_idx, "expression too complex (value stack)", stasis.tok_start);
                                        return -1;
                                    }
                                    stasis.parse_stack_start[val_len] = call_node3;
                                    val_len = val_len + 1;
                                    expect_value = 0;
                                    k = lex_next_kind();
                                }
                            } else {
                                if (k == Tok.RBracket) {
                                    if (stasis.expr_index_len <= 0) {
                                        expr_err_at(file_idx, "unmatched ']'", stasis.tok_start);
                                        return -1;
                                    }

                                    let top_index: i32 = stasis.expr_index_len - 1;
                                    base2 = stasis.expr_index_val_base[top_index];

                                    // Reduce operators until the index barrier.
                                    for (; op_len > 0 && stasis.parse_stack_kind[op_len - 1] != Tok.IndexStart && stasis.parse_stack_kind[op_len - 1] != Tok.CallStart; ) {
                                        let top_op4: Tok = stasis.parse_stack_kind[op_len - 1];
                                        if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                            return -1;
                                        }
                                        op_len = op_len - 1;
                                        if (top_op4 == Tok.UnaryMinus || top_op4 == Tok.Bang) {
                                            // val_len unchanged
                                        } else {
                                            val_len = val_len - 1;
                                        }
                                    }

                                    if (op_len <= 0) {
                                        expr_err_at(file_idx, "internal error: index stack desync", stasis.tok_start);
                                        return -1;
                                    }
                                    if (stasis.parse_stack_kind[op_len - 1] == Tok.CallStart) {
                                        expr_err_at(file_idx, "expected ')' before ']'", stasis.tok_start);
                                        return -1;
                                    }

                                    if (val_len != base2 + 1) {
                                        expr_err_at(file_idx, "expected expression in index", stasis.tok_start);
                                        return -1;
                                    }
                                    if (stasis.parse_stack_kind[op_len - 1] != Tok.IndexStart) {
                                        expr_err_at(file_idx, "internal error: index stack desync", stasis.tok_start);
                                        return -1;
                                    }

                                    let index_expr: i32 = stasis.parse_stack_start[val_len - 1];
                                    let base_node2: i32 = stasis.expr_index_base[top_index];

                                    stasis.expr_index_len = top_index;
                                    op_len = op_len - 1; // pop IndexStart

                                    let index_node: i32 = expr_make_index(file_idx, stasis.expr_nodes[base_node2].at, base_node2, index_expr);
                                    if (index_node < 0) { return -1; }
                                    stasis.parse_stack_start[val_len - 1] = index_node;
                                    expect_value = 0;
                                    k = lex_next_kind();
                                } else {
                                    if (expr_is_infix(k)) {
                                    let prec: i32 = expr_prec(k);
                                    let reduce: i32 = 1;
                                    for (; reduce != 0; ) {
                                        reduce = 0;
                                        if (op_len > 0) {
                                            let top2: Tok = stasis.parse_stack_kind[op_len - 1];
                                            if (top2 != Tok.LParen && top2 != Tok.CallStart && top2 != Tok.IndexStart) {
                                                let top_prec: i32 = expr_prec(top2);
                                                if (top_prec > prec || (top_prec == prec && !expr_is_right_assoc(k))) {
                                                    if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
                                                        return -1;
                                                    }
                                                    op_len = op_len - 1;
                                                    if (top2 == Tok.UnaryMinus || top2 == Tok.Bang) {
                                                        // val_len unchanged
                                                    } else {
                                                        val_len = val_len - 1;
                                                    }
                                                    reduce = 1;
                                                }
                                            }
                                        }
                                    }

                                    if (op_len >= EXPR_STACK_CAP) {
                                        expr_err_at(file_idx, "expression too complex (op stack)", stasis.tok_start);
                                        return -1;
                                    }
                                    stasis.parse_stack_kind[op_len] = k;
                                    stasis.expr_op_at[op_len] = stasis.tok_start;
                                    op_len = op_len + 1;
                                    expect_value = 1;
                                    k = lex_next_kind();
                                } else {
                                    expr_err_at(file_idx, "expected operator in expression", stasis.tok_start);
                                    return -1;
                                }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    if (expect_value != 0) {
        expr_err_at(file_idx, "expected value in expression", stasis.tok_start);
        return -1;
    }

    for (; op_len > 0; ) {
        let top3: Tok = stasis.parse_stack_kind[op_len - 1];
        if (top3 == Tok.LParen || top3 == Tok.CallStart) {
            expr_err_at(file_idx, "unmatched '('", stasis.expr_op_at[op_len - 1]);
            return -1;
        }
        if (top3 == Tok.IndexStart) {
            expr_err_at(file_idx, "unmatched '['", stasis.expr_op_at[op_len - 1]);
            return -1;
        }
        if (expr_reduce_top(file_idx, op_len, val_len) != 0) {
            return -1;
        }
        op_len = op_len - 1;
        if (top3 == Tok.UnaryMinus || top3 == Tok.Bang) {
            // val_len unchanged
        } else {
            val_len = val_len - 1;
        }
    }

    if (stasis.expr_call_len != 0) {
        expr_err_at(file_idx, "unclosed call in expression", stasis.tok_start);
        return -1;
    }
    if (stasis.expr_index_len != 0) {
        expr_err_at(file_idx, "unclosed index in expression", stasis.expr_index_at[stasis.expr_index_len - 1]);
        return -1;
    }

    if (val_len != 1) {
        expr_err_at(file_idx, "invalid expression", stasis.tok_start);
        return -1;
    }

    return stasis.parse_stack_start[0];
}

// Parses an expression starting at the current lexer position and consumes the terminator.
// Returns the expression root node index, or -1 on error.
function expr_parse_until(file_idx: i32, terminator: Tok): i32 {
    let first: Tok = lex_next_kind();
    return expr_parse_after_first(file_idx, first, terminator);
}
