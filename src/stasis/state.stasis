// Self-hosted compiler state.
//
// Stasis convention: prefer a single global struct that owns all static memory
// needed by the program. This keeps memory layout deterministic and makes it
// easy to reason about limits.

// Token kinds (mirrors Stage0 TokenKind ordering).
enum ShTok {
    Eof = 0,
    Unknown = 1,

    Identifier = 2,
    IntegerLiteral = 3,
    FloatLiteral = 4,
    StringLiteral = 5,
    BacktickLiteral = 6,
    TrueKeyword = 7,
    FalseKeyword = 8,

    StructKeyword = 9,
    EnumKeyword = 10,
    GlobalKeyword = 11,
    ConstKeyword = 12,
    FunctionKeyword = 13,
    ExportKeyword = 14,
    TestKeyword = 15,
    ReturnKeyword = 16,
    LetKeyword = 17,
    IfKeyword = 18,
    ElseKeyword = 19,
    ForKeyword = 20,
    ForeachKeyword = 21,
    InKeyword = 22,

    Dot = 23,
    Plus = 24,
    Minus = 25,
    Star = 26,
    Slash = 27,
    Percent = 28,
    PlusEqual = 29,
    MinusEqual = 30,
    StarEqual = 31,
    SlashEqual = 32,
    PercentEqual = 33,
    AmpAmp = 34,
    PipePipe = 35,
    Less = 36,
    LessEqual = 37,
    Greater = 38,
    GreaterEqual = 39,
    Equal = 40,
    EqualEqual = 41,
    BangEqual = 42,
    Colon = 43,
    Bang = 44,
    At = 45,

    LParen = 46,
    RParen = 47,
    LBrace = 48,
    RBrace = 49,
    LBracket = 50,
    RBracket = 51,
    Comma = 52,
    Semicolon = 53
}

struct ShFile {
    path_off: i32;
    path_len: i32;
    mod_off: i32;
    mod_len: i32;
    imports_off: i32;
    imports_len: i32;
    offset: i32;
    len: i32;
    mtime_ms: i32;
}

struct ShState {
    // CLI scratch
    cmd: ascii[64];
    subcmd: ascii[64];
    arg_entry: ascii[260];

    // Import/source graph
    files: ShFile[300];
    file_count: i32;

    pool: u8[16000000];
    pool_len: i32;

    path_pool: u8[90000];
    path_pool_len: i32;

    mod_pool: u8[20000];
    mod_pool_len: i32;

    imports: i32[90000];
    imports_len: i32;

    read: u8[51201];

    scratch_import: ascii[260];
    scratch_dir: ascii[260];
    scratch_resolved: ascii[260];
    scratch_watch_path: ascii[260];
    scratch_mod: ascii[96];

    quiet: i32;

    // Lexer (streaming)
    lex_file_idx: i32;
    lex_base: i32;
    lex_len: i32;
    lex_pos: i32;
    lex_error_count: i32;
    tok_start: i32;
    tok_len: i32;

    // Parser (currently: balance check)
    parse_stack_kind: ShTok[4096];
    parse_stack_start: i32[4096];
    parse_stack_len: i32;
    parse_path: ascii[260];
    parse_quiet: i32;
}

global sh: ShState;
