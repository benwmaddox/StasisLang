// Self-hosted compiler state.
//
// Stasis convention: prefer a single global struct that owns all static memory
// needed by the program. This keeps memory layout deterministic and makes it
// easy to reason about limits.

// Token kinds (mirrors Stage0 TokenKind ordering, plus a few Stage1-only tokens).
enum ShTok {
    Eof = 0,
    Unknown = 1,

    Identifier = 2,
    IntegerLiteral = 3,
    FloatLiteral = 4,
    StringLiteral = 5,
    BacktickLiteral = 6,
    TrueKeyword = 7,
    FalseKeyword = 8,

    StructKeyword = 9,
    EnumKeyword = 10,
    GlobalKeyword = 11,
    ConstKeyword = 12,
    FunctionKeyword = 13,
    ExportKeyword = 14,
    TestKeyword = 15,
    ReturnKeyword = 16,
    LetKeyword = 17,
    IfKeyword = 18,
    ElseKeyword = 19,
    ForKeyword = 20,
    ForeachKeyword = 21,
    InKeyword = 22,

    Dot = 23,
    Plus = 24,
    Minus = 25,
    Star = 26,
    Slash = 27,
    Percent = 28,
    PlusEqual = 29,
    MinusEqual = 30,
    StarEqual = 31,
    SlashEqual = 32,
    PercentEqual = 33,
    AmpAmp = 34,
    PipePipe = 35,
    Less = 36,
    LessEqual = 37,
    Greater = 38,
    GreaterEqual = 39,
    Equal = 40,
    EqualEqual = 41,
    BangEqual = 42,
    Colon = 43,
    Bang = 44,
    At = 45,

    LParen = 46,
    RParen = 47,
    LBrace = 48,
    RBrace = 49,
    LBracket = 50,
    RBracket = 51,
    Comma = 52,
    Semicolon = 53,

    ImportKeyword = 54,

    // Internal/pseudo tokens (not emitted by the lexer).
    UnaryMinus = 55,
    CallStart = 56,
    IndexStart = 57
}

enum ShSymKind {
    Struct = 1,
    Enum = 2,
    Global = 3,
    Const = 4,
    Function = 5,
    Test = 6
}

struct ShSym {
    kind: ShSymKind;
    file_idx: i32;
    name_off: i32;
    name_len: i32;
    name_at: i32;
    is_exported: i32;
}

enum ShTypeKind {
    Named = 1,
    Array = 2
}

struct ShType {
    kind: ShTypeKind;
    file_idx: i32;
    start: i32;
    len: i32;
    elem: i32;
    size: i32;
}

struct ShStructDecl {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    fields_off: i32;
    fields_len: i32;
}

struct ShStructField {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    type_idx: i32;
}

struct ShEnumDecl {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    members_off: i32;
    members_len: i32;
}

struct ShEnumMember {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    has_value: i32;
    value: i32;
}

struct ShParamDecl {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    type_idx: i32;
}

struct ShFuncDecl {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    sym_idx: i32;
    params_off: i32;
    params_len: i32;
    ret_type_idx: i32;
    body_start: i32;
    is_test: i32;
}

struct ShGlobalDecl {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    sym_idx: i32;
    type_idx: i32;
    has_init: i32;
    init_start: i32;
}

struct ShConstDecl {
    file_idx: i32;
    name_start: i32;
    name_len: i32;
    sym_idx: i32;
    type_idx: i32;
    init_start: i32;
}

struct ShFile {
    path_off: i32;
    path_len: i32;
    mod_off: i32;
    mod_len: i32;
    imports_off: i32;
    imports_len: i32;
    syms_off: i32;
    syms_len: i32;
    offset: i32;
    len: i32;
    mtime_ms: i32;
}

enum ShExprKind {
    IntLiteral = 1,
    BoolLiteral = 2,
    Name = 3,
    Unary = 4,
    Binary = 5,
    Assign = 6,
    Call = 7,
    Member = 8,
    Index = 9,
    StringLiteral = 10
}

struct ShExprNode {
    kind: ShExprKind;
    file_idx: i32;
    at: i32;
    op: ShTok;
    left: i32;
    right: i32;
    value: i32;
    name_start: i32;
    name_len: i32;
}

enum ShLlvmBlockKind {
    Plain = 1,
    IfThen = 2,
    IfElse = 3,
    ForBody = 4,
    Function = 5
}

enum ShLlvmValueKind {
    I32 = 1,
    I8 = 2,
    PtrI8 = 3,
    PtrI32 = 4,
    PtrStruct = 5
}

struct ShState {
    // CLI scratch
    cmd: ascii[64];
    subcmd: ascii[64];
    arg_entry: ascii[260];
    arg_out: ascii[260];
    arg_backend: ascii[16];
    arg_module: ascii[96];
    emit_ir: i32;
    ir_out: ascii[33554432];
    exec_cmd: ascii[4096];

    // Import/source graph
    files: ShFile[300];
    file_count: i32;

    pool: u8[16000000];
    pool_len: i32;

    path_pool: u8[90000];
    path_pool_len: i32;

    mod_pool: u8[20000];
    mod_pool_len: i32;

    imports: i32[90000];
    imports_len: i32;

    read: u8[51201];

    scratch_import: ascii[260];
    scratch_dir: ascii[260];
    scratch_resolved: ascii[260];
    scratch_watch_path: ascii[260];
    scratch_mod: ascii[96];

    quiet: i32;

    // Lexer (streaming)
    lex_file_idx: i32;
    lex_base: i32;
    lex_len: i32;
    lex_pos: i32;
    lex_error_count: i32;
    lex_error_printed: i32;
    lex_quiet: i32;
    lex_path: ascii[260];
    tok_start: i32;
    tok_len: i32;

    // Parser (currently: balance check)
    parse_stack_kind: ShTok[4096];
    parse_stack_start: i32[4096];
    parse_stack_len: i32;
    parse_path: ascii[260];
    parse_quiet: i32;

    // Expression parsing scratch (per-expression; reused across passes).
    expr_nodes: ShExprNode[16384];
    expr_count: i32;
    expr_call_args: i32[32768];
    expr_call_args_len: i32;
    expr_call_tmp_args: i32[32768];
    expr_call_tmp_args_len: i32;
    expr_call_callee: i32[4096];
    expr_call_arg_off: i32[4096];
    expr_call_arg_len: i32[4096];
    expr_call_val_base: i32[4096];
    expr_call_len: i32;
    expr_index_base: i32[4096];
    expr_index_val_base: i32[4096];
    expr_index_at: i32[4096];
    expr_index_len: i32;
    expr_op_at: i32[4096];
    expr_eval_failed: i32;

    // Signature scan (top-level declarations)
    sym_pool: u8[200000];
    sym_pool_len: i32;
    syms: ShSym[20000];
    sym_count: i32;
    sig_kind: ShTok;
    sig_errors: i32;

    // Types + decls (parsed from source)
    types: ShType[50000];
    type_count: i32;

    structs: ShStructDecl[2000];
    struct_count: i32;
    fields: ShStructField[50000];
    field_count: i32;

    enums: ShEnumDecl[2000];
    enum_count: i32;
    enum_members: ShEnumMember[50000];
    enum_member_count: i32;

    globals: ShGlobalDecl[20000];
    global_count: i32;
    consts: ShConstDecl[20000];
    const_count: i32;

    funcs: ShFuncDecl[20000];
    func_count: i32;
    params: ShParamDecl[50000];
    param_count: i32;
    sig_path: ascii[260];

    // LLVM codegen scratch (minimal bring-up; grows over time).
    llvm_local_name_start: i32[1024];
    llvm_local_name_len: i32[1024];
    llvm_local_declared: i32[1024];
    llvm_local_declared_at: i32[1024];
    llvm_local_kind: ShLlvmValueKind[1024];
    llvm_local_count: i32;
    llvm_tmp_id: i32;
    llvm_label_id: i32;
    llvm_bb_terminated: i32;
    llvm_place_stack: i32[4096];
    llvm_place_len: i32;
    llvm_place_kind: ShLlvmValueKind;
    llvm_place_struct_idx: i32;
    llvm_val_kind: ShLlvmValueKind[4096];
    llvm_val_struct_idx: i32[4096];
    llvm_block_kind: ShLlvmBlockKind[256];
    llvm_block_end_label: i32[256];
    llvm_block_else_label: i32[256];
    llvm_block_cond_label: i32[256];
    llvm_block_step_label: i32[256];
    llvm_block_has_step: i32[256];
    llvm_block_step_start: i32[256];
    llvm_block_step_file_idx: i32[256];
    llvm_block_len: i32;

    // LLVM module-level scratch (string literals).
    llvm_str_file_idx: i32[4096];
    llvm_str_tok_start: i32[4096];
    llvm_str_tok_len: i32[4096];
    llvm_str_total_bytes: i32[4096];
    llvm_str_byte_len: i32[4096];
    llvm_str_char_len: i32[4096];
    llvm_str_count: i32;
}

global sh: ShState;
