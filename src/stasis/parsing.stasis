import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

const PARSE_STACK_CAP: i32 = 4096;

function parse_is_opener(k: Tok): bool {
    return k == Tok.LParen || k == Tok.LBrace || k == Tok.LBracket;
}

function parse_is_closer(k: Tok): bool {
    return k == Tok.RParen || k == Tok.RBrace || k == Tok.RBracket;
}

function parse_open_for_close(k: Tok): Tok {
    if (k == Tok.RParen) { return Tok.LParen; }
    if (k == Tok.RBrace) { return Tok.LBrace; }
    if (k == Tok.RBracket) { return Tok.LBracket; }
    return Tok.Unknown;
}

function parse_print_err(file_idx: i32, msg: ascii[], at: i32): void {
    if (stasis.parse_quiet != 0) {
        return;
    }

    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_file_loc(file_idx, at);
    print_char(10);
}

// Minimal parsing pass: bracket/paren/brace balance check.
// Returns the number of parse errors for this file (lex errors are tracked in st.lex_error_count).
function parse_balance_file(file_idx: i32): i32 {
    stasis.parse_stack_len = 0;

    if (!lex_begin(file_idx)) {
        parse_print_err(file_idx, "failed to start lexer", 0);
        return 1;
    }

    let errors: i32 = 0;

    let tok: i32 = 0;
    let done: i32 = 0;
    for (tok = 0; done == 0; tok = tok + 1) {
        let k: Tok = lex_next_kind();
        if (k == Tok.Eof) {
            done = 1;
        } else {

            if (parse_is_opener(k)) {
                if (stasis.parse_stack_len >= PARSE_STACK_CAP) {
                    errors = errors + 1;
                    parse_print_err(file_idx, "parse stack overflow", stasis.tok_start);
                } else {
                    stasis.parse_stack_kind[stasis.parse_stack_len] = k;
                    stasis.parse_stack_start[stasis.parse_stack_len] = stasis.tok_start;
                    stasis.parse_stack_len = stasis.parse_stack_len + 1;
                }
            } else {
                if (parse_is_closer(k)) {
                    if (stasis.parse_stack_len <= 0) {
                        errors = errors + 1;
                        parse_print_err(file_idx, "unexpected closing token", stasis.tok_start);
                    } else {
                        let expected_open: Tok = parse_open_for_close(k);
                        let open_k: Tok = stasis.parse_stack_kind[stasis.parse_stack_len - 1];
                        if (open_k != expected_open) {
                            errors = errors + 1;
                            parse_print_err(file_idx, "mismatched closing token", stasis.tok_start);
                        } else {
                            stasis.parse_stack_len = stasis.parse_stack_len - 1;
                        }
                    }
                }
            }
        }
    }

    if (stasis.parse_stack_len != 0) {
        errors = errors + 1;
        parse_print_err(file_idx, "unclosed token", stasis.parse_stack_start[stasis.parse_stack_len - 1]);
    }

    return errors;
}
