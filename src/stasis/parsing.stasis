import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "lexing.stasis";
import "diagnostics.stasis";

const SH_PARSE_STACK_CAP: i32 = 4096;

function sh_parse_is_opener(k: ShTok): bool {
    return k == ShTok.LParen || k == ShTok.LBrace || k == ShTok.LBracket;
}

function sh_parse_is_closer(k: ShTok): bool {
    return k == ShTok.RParen || k == ShTok.RBrace || k == ShTok.RBracket;
}

function sh_parse_open_for_close(k: ShTok): ShTok {
    if (k == ShTok.RParen) { return ShTok.LParen; }
    if (k == ShTok.RBrace) { return ShTok.LBrace; }
    if (k == ShTok.RBracket) { return ShTok.LBracket; }
    return ShTok.Unknown;
}

function sh_parse_print_err(file_idx: i32, msg: ascii[], at: i32): void {
    if (sh.parse_quiet != 0) {
        return;
    }

    print_string("error: ");
    print_string(msg);
    print_string(": ");
    sh_print_file_loc(file_idx, at);
    print_char(10);
}

// Minimal parsing pass: bracket/paren/brace balance check.
// Returns the number of parse errors for this file (lex errors are tracked in sh.lex_error_count).
function sh_parse_balance_file(file_idx: i32): i32 {
    sh.parse_stack_len = 0;

    if (!sh_lex_begin(file_idx)) {
        sh_parse_print_err(file_idx, "failed to start lexer", 0);
        return 1;
    }

    let errors: i32 = 0;

    let tok: i32 = 0;
    let done: i32 = 0;
    for (tok = 0; done == 0; tok = tok + 1) {
        let k: ShTok = sh_lex_next_kind();
        if (k == ShTok.Eof) {
            done = 1;
        } else {

            if (sh_parse_is_opener(k)) {
                if (sh.parse_stack_len >= SH_PARSE_STACK_CAP) {
                    errors = errors + 1;
                    sh_parse_print_err(file_idx, "parse stack overflow", sh.tok_start);
                } else {
                    sh.parse_stack_kind[sh.parse_stack_len] = k;
                    sh.parse_stack_start[sh.parse_stack_len] = sh.tok_start;
                    sh.parse_stack_len = sh.parse_stack_len + 1;
                }
            } else {
                if (sh_parse_is_closer(k)) {
                    if (sh.parse_stack_len <= 0) {
                        errors = errors + 1;
                        sh_parse_print_err(file_idx, "unexpected closing token", sh.tok_start);
                    } else {
                        let expected_open: ShTok = sh_parse_open_for_close(k);
                        let open_k: ShTok = sh.parse_stack_kind[sh.parse_stack_len - 1];
                        if (open_k != expected_open) {
                            errors = errors + 1;
                            sh_parse_print_err(file_idx, "mismatched closing token", sh.tok_start);
                        } else {
                            sh.parse_stack_len = sh.parse_stack_len - 1;
                        }
                    }
                }
            }
        }
    }

    if (sh.parse_stack_len != 0) {
        errors = errors + 1;
        sh_parse_print_err(file_idx, "unclosed token", sh.parse_stack_start[sh.parse_stack_len - 1]);
    }

    return errors;
}
