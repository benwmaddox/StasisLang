import "imports.stasis";

// Token kinds (mirrors Stasis.Compiler TokenKind ordering).
const SH_TOK_EOF: i32 = 0;
const SH_TOK_UNKNOWN: i32 = 1;

const SH_TOK_IDENTIFIER: i32 = 2;
const SH_TOK_INTEGER_LITERAL: i32 = 3;
const SH_TOK_FLOAT_LITERAL: i32 = 4;
const SH_TOK_STRING_LITERAL: i32 = 5;
const SH_TOK_BACKTICK_LITERAL: i32 = 6;
const SH_TOK_TRUE_KEYWORD: i32 = 7;
const SH_TOK_FALSE_KEYWORD: i32 = 8;

const SH_TOK_STRUCT_KEYWORD: i32 = 9;
const SH_TOK_ENUM_KEYWORD: i32 = 10;
const SH_TOK_GLOBAL_KEYWORD: i32 = 11;
const SH_TOK_CONST_KEYWORD: i32 = 12;
const SH_TOK_FUNCTION_KEYWORD: i32 = 13;
const SH_TOK_EXPORT_KEYWORD: i32 = 14;
const SH_TOK_TEST_KEYWORD: i32 = 15;
const SH_TOK_RETURN_KEYWORD: i32 = 16;
const SH_TOK_LET_KEYWORD: i32 = 17;
const SH_TOK_IF_KEYWORD: i32 = 18;
const SH_TOK_ELSE_KEYWORD: i32 = 19;
const SH_TOK_FOR_KEYWORD: i32 = 20;
const SH_TOK_FOREACH_KEYWORD: i32 = 21;
const SH_TOK_IN_KEYWORD: i32 = 22;

const SH_TOK_DOT: i32 = 23;
const SH_TOK_PLUS: i32 = 24;
const SH_TOK_MINUS: i32 = 25;
const SH_TOK_STAR: i32 = 26;
const SH_TOK_SLASH: i32 = 27;
const SH_TOK_PERCENT: i32 = 28;
const SH_TOK_PLUS_EQUAL: i32 = 29;
const SH_TOK_MINUS_EQUAL: i32 = 30;
const SH_TOK_STAR_EQUAL: i32 = 31;
const SH_TOK_SLASH_EQUAL: i32 = 32;
const SH_TOK_PERCENT_EQUAL: i32 = 33;
const SH_TOK_AMP_AMP: i32 = 34;
const SH_TOK_PIPE_PIPE: i32 = 35;
const SH_TOK_LESS: i32 = 36;
const SH_TOK_LESS_EQUAL: i32 = 37;
const SH_TOK_GREATER: i32 = 38;
const SH_TOK_GREATER_EQUAL: i32 = 39;
const SH_TOK_EQUAL: i32 = 40;
const SH_TOK_EQUAL_EQUAL: i32 = 41;
const SH_TOK_BANG_EQUAL: i32 = 42;
const SH_TOK_COLON: i32 = 43;
const SH_TOK_BANG: i32 = 44;
const SH_TOK_AT: i32 = 45;

const SH_TOK_LPAREN: i32 = 46;
const SH_TOK_RPAREN: i32 = 47;
const SH_TOK_LBRACE: i32 = 48;
const SH_TOK_RBRACE: i32 = 49;
const SH_TOK_LBRACKET: i32 = 50;
const SH_TOK_RBRACKET: i32 = 51;
const SH_TOK_COMMA: i32 = 52;
const SH_TOK_SEMICOLON: i32 = 53;

global sh_lex_file_idx: i32;
global sh_lex_base: i32;
global sh_lex_len: i32;
global sh_lex_pos: i32;

global sh_lex_error_count: i32;

global sh_tok_start: i32;
global sh_tok_len: i32;

function sh_lex_begin(file_idx: i32): bool {
    if (file_idx < 0 || file_idx >= sh_file_count) {
        return false;
    }

    sh_lex_file_idx = file_idx;
    sh_lex_base = sh_files[file_idx].offset;
    sh_lex_len = sh_files[file_idx].len;
    sh_lex_pos = 0;
    sh_lex_error_count = 0;
    sh_tok_start = 0;
    sh_tok_len = 0;
    return true;
}

function sh_is_alpha(b: u8): bool {
    let v: i32 = u8_to_i32(b);
    if (v >= 65) {
        if (v <= 90) {
            return true;
        }
    }
    if (v >= 97) {
        if (v <= 122) {
            return true;
        }
    }
    return false;
}

function sh_is_digit(b: u8): bool {
    let v: i32 = u8_to_i32(b);
    if (v >= 48) {
        if (v <= 57) {
            return true;
        }
    }
    return false;
}

function sh_is_ident_continue(b: u8): bool {
    if (sh_is_alpha(b)) {
        return true;
    }
    if (sh_is_digit(b)) {
        return true;
    }
    return u8_to_i32(b) == 95;
}

function sh_lex_is_at_end(): bool {
    return sh_lex_pos >= sh_lex_len;
}

function sh_lex_current(): u8 {
    if (sh_lex_pos >= sh_lex_len) {
        return i32_to_u8_trunc(0);
    }
    return sh_pool[sh_lex_base + sh_lex_pos];
}

function sh_lex_peek(): u8 {
    let next: i32 = sh_lex_pos + 1;
    if (next >= sh_lex_len) {
        return i32_to_u8_trunc(0);
    }
    return sh_pool[sh_lex_base + next];
}

function sh_lex_advance(): void {
    sh_lex_pos = sh_lex_pos + 1;
}

function sh_lex_skip_ws_and_comments(): void {
    let progressed: i32 = 1;
    for (; progressed != 0; ) {
        progressed = 0;

        if (sh_lex_is_at_end()) {
            return;
        }

        let b: u8 = sh_lex_current();
        if (b == 32 || b == 9 || b == 10 || b == 13) {
            sh_lex_advance();
            progressed = 1;
        } else {
            if (b == 47) { // '/'
                let p: u8 = sh_lex_peek();
                if (p == 47) { // line comment
                    sh_lex_advance();
                    sh_lex_advance();
                    for (; !sh_lex_is_at_end() && sh_lex_current() != 10 && sh_lex_current() != 13; ) {
                        sh_lex_advance();
                    }
                    progressed = 1;
                } else {
                    if (p == 42) { // block comment
                        sh_lex_advance();
                        sh_lex_advance();
                        for (; !sh_lex_is_at_end() && !(sh_lex_current() == 42 && sh_lex_peek() == 47); ) {
                            sh_lex_advance();
                        }
                        if (!sh_lex_is_at_end()) {
                            sh_lex_advance();
                            sh_lex_advance();
                        }
                        progressed = 1;
                    }
                }
            }
        }
    }
}

function sh_lex_bytes_eq_lit(start: i32, len: i32, lit: ascii[]): bool {
    if (len != ascii_len(lit)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (sh_pool[sh_lex_base + start + i] != lit[i]) {
            return false;
        }
    }
    return true;
}

function sh_lex_keyword_kind(start: i32, len: i32): i32 {
    if (sh_lex_bytes_eq_lit(start, len, "struct")) { return SH_TOK_STRUCT_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "enum")) { return SH_TOK_ENUM_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "global")) { return SH_TOK_GLOBAL_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "const")) { return SH_TOK_CONST_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "function")) { return SH_TOK_FUNCTION_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "export")) { return SH_TOK_EXPORT_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "test")) { return SH_TOK_TEST_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "return")) { return SH_TOK_RETURN_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "let")) { return SH_TOK_LET_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "if")) { return SH_TOK_IF_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "else")) { return SH_TOK_ELSE_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "for")) { return SH_TOK_FOR_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "foreach")) { return SH_TOK_FOREACH_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "in")) { return SH_TOK_IN_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "true")) { return SH_TOK_TRUE_KEYWORD; }
    if (sh_lex_bytes_eq_lit(start, len, "false")) { return SH_TOK_FALSE_KEYWORD; }
    return SH_TOK_IDENTIFIER;
}

function sh_lex_identifier_or_keyword(): i32 {
    let start: i32 = sh_lex_pos;
    for (; !sh_lex_is_at_end() && sh_is_ident_continue(sh_lex_current()); ) {
        sh_lex_advance();
    }
    sh_tok_start = start;
    sh_tok_len = sh_lex_pos - start;
    return sh_lex_keyword_kind(start, sh_tok_len);
}

function sh_lex_number(): i32 {
    let start: i32 = sh_lex_pos;
    let has_dot: i32 = 0;

    let done: i32 = 0;
    for (; !sh_lex_is_at_end() && done == 0; ) {
        let b: u8 = sh_lex_current();
        if (sh_is_digit(b)) {
            sh_lex_advance();
        } else {
            if (b == 46 && has_dot == 0 && sh_is_digit(sh_lex_peek())) { // '.' + digit
                has_dot = 1;
                sh_lex_advance(); // '.'
                sh_lex_advance(); // digit after '.'
            } else {
                done = 1;
            }
        }
    }

    sh_tok_start = start;
    sh_tok_len = sh_lex_pos - start;
    if (has_dot != 0) {
        return SH_TOK_FLOAT_LITERAL;
    }
    return SH_TOK_INTEGER_LITERAL;
}

function sh_lex_string_like(quote: u8, kind: i32): i32 {
    let start: i32 = sh_lex_pos;
    sh_lex_advance(); // opening quote/backtick

    for (; !sh_lex_is_at_end() && sh_lex_current() != quote; ) {
        sh_lex_advance();
    }

    if (sh_lex_is_at_end()) {
        sh_lex_error_count = sh_lex_error_count + 1;
        sh_tok_start = start;
        sh_tok_len = sh_lex_pos - start;
        return kind;
    }

    sh_lex_advance(); // closing quote/backtick
    sh_tok_start = start;
    sh_tok_len = sh_lex_pos - start;
    return kind;
}

function sh_lex_next_kind(): i32 {
    sh_lex_skip_ws_and_comments();

    if (sh_lex_is_at_end()) {
        sh_tok_start = sh_lex_pos;
        sh_tok_len = 0;
        return SH_TOK_EOF;
    }

    let start: i32 = sh_lex_pos;
    let b: u8 = sh_lex_current();

    if (sh_is_alpha(b)) {
        return sh_lex_identifier_or_keyword();
    }

    if (sh_is_digit(b)) {
        return sh_lex_number();
    }

    if (b == 34) { // '"'
        return sh_lex_string_like(34, SH_TOK_STRING_LITERAL);
    }
    if (b == 96) { // '`'
        return sh_lex_string_like(96, SH_TOK_BACKTICK_LITERAL);
    }

    // One and two byte tokens.
    sh_lex_advance();
    sh_tok_start = start;
    sh_tok_len = 1;

    if (b == 46) { return SH_TOK_DOT; } // '.'
    if (b == 64) { return SH_TOK_AT; } // '@'

    if (b == 38) { // '&'
        if (sh_lex_current() == 38) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_AMP_AMP;
        }
        sh_lex_error_count = sh_lex_error_count + 1;
        return SH_TOK_UNKNOWN;
    }

    if (b == 124) { // '|'
        if (sh_lex_current() == 124) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_PIPE_PIPE;
        }
        sh_lex_error_count = sh_lex_error_count + 1;
        return SH_TOK_UNKNOWN;
    }

    if (b == 33) { // '!'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_BANG_EQUAL;
        }
        return SH_TOK_BANG;
    }

    if (b == 43) { // '+'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_PLUS_EQUAL;
        }
        return SH_TOK_PLUS;
    }

    if (b == 45) { // '-'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_MINUS_EQUAL;
        }
        return SH_TOK_MINUS;
    }

    if (b == 42) { // '*'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_STAR_EQUAL;
        }
        return SH_TOK_STAR;
    }

    if (b == 47) { // '/'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_SLASH_EQUAL;
        }
        return SH_TOK_SLASH;
    }

    if (b == 37) { // '%'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_PERCENT_EQUAL;
        }
        return SH_TOK_PERCENT;
    }

    if (b == 60) { // '<'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_LESS_EQUAL;
        }
        return SH_TOK_LESS;
    }

    if (b == 62) { // '>'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_GREATER_EQUAL;
        }
        return SH_TOK_GREATER;
    }

    if (b == 58) { return SH_TOK_COLON; } // ':'

    if (b == 61) { // '='
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh_tok_len = 2;
            return SH_TOK_EQUAL_EQUAL;
        }
        return SH_TOK_EQUAL;
    }

    if (b == 40) { return SH_TOK_LPAREN; } // '('
    if (b == 41) { return SH_TOK_RPAREN; } // ')'
    if (b == 123) { return SH_TOK_LBRACE; } // '{'
    if (b == 125) { return SH_TOK_RBRACE; } // '}'
    if (b == 91) { return SH_TOK_LBRACKET; } // '['
    if (b == 93) { return SH_TOK_RBRACKET; } // ']'
    if (b == 44) { return SH_TOK_COMMA; } // ','
    if (b == 59) { return SH_TOK_SEMICOLON; } // ';'

    sh_lex_error_count = sh_lex_error_count + 1;
    return SH_TOK_UNKNOWN;
}
