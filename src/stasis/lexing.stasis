import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";

// Token kinds: enum ShTok (with explicit numeric values) lives in state.stasis.

const SH_LEX_ERR_PRINT_CAP: i32 = 8;

function sh_lex_begin(file_idx: i32): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }

    sh.lex_file_idx = file_idx;
    sh.lex_base = sh.files[file_idx].offset;
    sh.lex_len = sh.files[file_idx].len;
    sh.lex_pos = 0;
    sh.lex_error_count = 0;
    sh.lex_error_printed = 0;
    sh.lex_quiet = sh.quiet;
    sh.tok_start = 0;
    sh.tok_len = 0;
    return true;
}

function sh_lex_print_err(file_idx: i32, msg: ascii[], at: i32): void {
    if (sh.lex_quiet != 0) {
        return;
    }
    if (sh.lex_error_printed >= SH_LEX_ERR_PRINT_CAP) {
        return;
    }

    if (!sh_copy_file_path(sh.lex_path, file_idx)) {
        ascii_copy(sh.lex_path, "<unknown>");
    }

    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_string(sh.lex_path);
    print_char(58); // ':'
    print_int(at);
    print_char(10);
    sh.lex_error_printed = sh.lex_error_printed + 1;
}

function sh_lex_print_err_byte(file_idx: i32, msg: ascii[], at: i32, b: u8): void {
    if (sh.lex_quiet != 0) {
        return;
    }
    if (sh.lex_error_printed >= SH_LEX_ERR_PRINT_CAP) {
        return;
    }

    if (!sh_copy_file_path(sh.lex_path, file_idx)) {
        ascii_copy(sh.lex_path, "<unknown>");
    }

    print_string("error: ");
    print_string(msg);
    print_string(" (byte=");
    print_int(u8_to_i32(b));
    print_string("): ");
    print_string(sh.lex_path);
    print_char(58); // ':'
    print_int(at);
    print_char(10);
    sh.lex_error_printed = sh.lex_error_printed + 1;
}

function sh_is_alpha(b: u8): bool {
    let v: i32 = u8_to_i32(b);
    if (v >= 65) {
        if (v <= 90) {
            return true;
        }
    }
    if (v >= 97) {
        if (v <= 122) {
            return true;
        }
    }
    return false;
}

function sh_is_digit(b: u8): bool {
    let v: i32 = u8_to_i32(b);
    if (v >= 48) {
        if (v <= 57) {
            return true;
        }
    }
    return false;
}

function sh_is_ident_continue(b: u8): bool {
    if (sh_is_alpha(b)) {
        return true;
    }
    if (sh_is_digit(b)) {
        return true;
    }
    return u8_to_i32(b) == 95;
}

function sh_lex_is_at_end(): bool {
    return sh.lex_pos >= sh.lex_len;
}

function sh_lex_current(): u8 {
    if (sh.lex_pos >= sh.lex_len) {
        return i32_to_u8_trunc(0);
    }
    return sh.pool[sh.lex_base + sh.lex_pos];
}

function sh_lex_peek(): u8 {
    let next: i32 = sh.lex_pos + 1;
    if (next >= sh.lex_len) {
        return i32_to_u8_trunc(0);
    }
    return sh.pool[sh.lex_base + next];
}

function sh_lex_advance(): void {
    sh.lex_pos = sh.lex_pos + 1;
}

function sh_lex_skip_ws_and_comments(): void {
    let progressed: i32 = 1;
    for (; progressed != 0; ) {
        progressed = 0;

        if (sh_lex_is_at_end()) {
            return;
        }

        let b: u8 = sh_lex_current();
        if (b == 32 || b == 9 || b == 10 || b == 13) {
            sh_lex_advance();
            progressed = 1;
        } else {
            if (b == 47) { // '/'
                let p: u8 = sh_lex_peek();
                if (p == 47) { // line comment
                    sh_lex_advance();
                    sh_lex_advance();
                    for (; !sh_lex_is_at_end() && sh_lex_current() != 10 && sh_lex_current() != 13; ) {
                        sh_lex_advance();
                    }
                    progressed = 1;
                } else {
                    if (p == 42) { // block comment
                        sh_lex_advance();
                        sh_lex_advance();
                        for (; !sh_lex_is_at_end() && !(sh_lex_current() == 42 && sh_lex_peek() == 47); ) {
                            sh_lex_advance();
                        }
                        if (!sh_lex_is_at_end()) {
                            sh_lex_advance();
                            sh_lex_advance();
                        }
                        progressed = 1;
                    }
                }
            }
        }
    }
}

function sh_lex_bytes_eq_lit(start: i32, len: i32, lit: ascii[]): bool {
    if (len != ascii_len(lit)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (sh.pool[sh.lex_base + start + i] != lit[i]) {
            return false;
        }
    }
    return true;
}

function sh_lex_keyword_kind(start: i32, len: i32): ShTok {
    if (sh_lex_bytes_eq_lit(start, len, "import")) { return ShTok.ImportKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "struct")) { return ShTok.StructKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "enum")) { return ShTok.EnumKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "global")) { return ShTok.GlobalKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "const")) { return ShTok.ConstKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "function")) { return ShTok.FunctionKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "export")) { return ShTok.ExportKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "test")) { return ShTok.TestKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "return")) { return ShTok.ReturnKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "let")) { return ShTok.LetKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "if")) { return ShTok.IfKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "else")) { return ShTok.ElseKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "for")) { return ShTok.ForKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "foreach")) { return ShTok.ForeachKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "in")) { return ShTok.InKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "true")) { return ShTok.TrueKeyword; }
    if (sh_lex_bytes_eq_lit(start, len, "false")) { return ShTok.FalseKeyword; }
    return ShTok.Identifier;
}

function sh_lex_identifier_or_keyword(): ShTok {
    let start: i32 = sh.lex_pos;
    for (; !sh_lex_is_at_end() && sh_is_ident_continue(sh_lex_current()); ) {
        sh_lex_advance();
    }
    sh.tok_start = start;
    sh.tok_len = sh.lex_pos - start;
    return sh_lex_keyword_kind(start, sh.tok_len);
}

function sh_lex_number(): ShTok {
    let start: i32 = sh.lex_pos;
    let has_dot: i32 = 0;

    let done: i32 = 0;
    for (; !sh_lex_is_at_end() && done == 0; ) {
        let b: u8 = sh_lex_current();
        if (sh_is_digit(b)) {
            sh_lex_advance();
        } else {
            if (b == 46 && has_dot == 0 && sh_is_digit(sh_lex_peek())) { // '.' + digit
                has_dot = 1;
                sh_lex_advance(); // '.'
                sh_lex_advance(); // digit after '.'
            } else {
                done = 1;
            }
        }
    }

    sh.tok_start = start;
    sh.tok_len = sh.lex_pos - start;
    if (has_dot != 0) {
        return ShTok.FloatLiteral;
    }
    return ShTok.IntegerLiteral;
}

function sh_lex_string_like(quote: u8, kind: ShTok): ShTok {
    let start: i32 = sh.lex_pos;
    sh_lex_advance(); // opening quote/backtick

    for (; !sh_lex_is_at_end() && sh_lex_current() != quote; ) {
        sh_lex_advance();
    }

    if (sh_lex_is_at_end()) {
        sh.lex_error_count = sh.lex_error_count + 1;
        if (kind == ShTok.StringLiteral) {
            sh_lex_print_err(sh.lex_file_idx, "unterminated string literal", start);
        } else {
            sh_lex_print_err(sh.lex_file_idx, "unterminated backtick literal", start);
        }
        sh.tok_start = start;
        sh.tok_len = sh.lex_pos - start;
        return kind;
    }

    sh_lex_advance(); // closing quote/backtick
    sh.tok_start = start;
    sh.tok_len = sh.lex_pos - start;
    return kind;
}

function sh_lex_next_kind(): ShTok {
    sh_lex_skip_ws_and_comments();

    if (sh_lex_is_at_end()) {
        sh.tok_start = sh.lex_pos;
        sh.tok_len = 0;
        return ShTok.Eof;
    }

    let start: i32 = sh.lex_pos;
    let b: u8 = sh_lex_current();

    if (sh_is_alpha(b)) {
        return sh_lex_identifier_or_keyword();
    }

    if (sh_is_digit(b)) {
        return sh_lex_number();
    }

    if (b == 34) { // '"'
        return sh_lex_string_like(34, ShTok.StringLiteral);
    }
    if (b == 96) { // '`'
        return sh_lex_string_like(96, ShTok.BacktickLiteral);
    }

    // One and two byte tokens.
    sh_lex_advance();
    sh.tok_start = start;
    sh.tok_len = 1;

    if (b == 46) { return ShTok.Dot; } // '.'
    if (b == 64) { return ShTok.At; } // '@'

    if (b == 38) { // '&'
        if (sh_lex_current() == 38) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.AmpAmp;
        }
        sh.lex_error_count = sh.lex_error_count + 1;
        sh_lex_print_err_byte(sh.lex_file_idx, "unexpected '&' (use &&)", start, b);
        return ShTok.Unknown;
    }

    if (b == 124) { // '|'
        if (sh_lex_current() == 124) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.PipePipe;
        }
        sh.lex_error_count = sh.lex_error_count + 1;
        sh_lex_print_err_byte(sh.lex_file_idx, "unexpected '|' (use ||)", start, b);
        return ShTok.Unknown;
    }

    if (b == 33) { // '!'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.BangEqual;
        }
        return ShTok.Bang;
    }

    if (b == 43) { // '+'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.PlusEqual;
        }
        return ShTok.Plus;
    }

    if (b == 45) { // '-'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.MinusEqual;
        }
        return ShTok.Minus;
    }

    if (b == 42) { // '*'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.StarEqual;
        }
        return ShTok.Star;
    }

    if (b == 47) { // '/'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.SlashEqual;
        }
        return ShTok.Slash;
    }

    if (b == 37) { // '%'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.PercentEqual;
        }
        return ShTok.Percent;
    }

    if (b == 60) { // '<'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.LessEqual;
        }
        return ShTok.Less;
    }

    if (b == 62) { // '>'
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.GreaterEqual;
        }
        return ShTok.Greater;
    }

    if (b == 58) { return ShTok.Colon; } // ':'

    if (b == 61) { // '='
        if (sh_lex_current() == 61) {
            sh_lex_advance();
            sh.tok_len = 2;
            return ShTok.EqualEqual;
        }
        return ShTok.Equal;
    }

    if (b == 40) { return ShTok.LParen; } // '('
    if (b == 41) { return ShTok.RParen; } // ')'
    if (b == 123) { return ShTok.LBrace; } // '{'
    if (b == 125) { return ShTok.RBrace; } // '}'
    if (b == 91) { return ShTok.LBracket; } // '['
    if (b == 93) { return ShTok.RBracket; } // ']'
    if (b == 44) { return ShTok.Comma; } // ','
    if (b == 59) { return ShTok.Semicolon; } // ';'

    sh.lex_error_count = sh.lex_error_count + 1;
    sh_lex_print_err_byte(sh.lex_file_idx, "unexpected byte", start, b);
    return ShTok.Unknown;
}
