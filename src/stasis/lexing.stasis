import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "diagnostics.stasis";

// Token kinds: enum Tok (with explicit numeric values) lives in state.stasis.

const LEX_ERR_PRINT_CAP: i32 = 8;

function lex_begin(file_idx: i32): bool {
    if (file_idx < 0 || file_idx >= st.file_count) {
        return false;
    }

    st.lex_file_idx = file_idx;
    st.lex_base = st.files[file_idx].offset;
    st.lex_len = st.files[file_idx].len;
    st.lex_pos = 0;
    st.lex_error_count = 0;
    st.lex_error_printed = 0;
    st.lex_quiet = st.quiet;
    st.tok_start = 0;
    st.tok_len = 0;
    return true;
}

function lex_print_err(file_idx: i32, msg: ascii[], at: i32): void {
    if (st.lex_quiet != 0) {
        return;
    }
    if (st.lex_error_printed >= LEX_ERR_PRINT_CAP) {
        return;
    }

    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_file_loc(file_idx, at);
    print_char(10);
    st.lex_error_printed = st.lex_error_printed + 1;
}

function lex_print_err_byte(file_idx: i32, msg: ascii[], at: i32, b: u8): void {
    if (st.lex_quiet != 0) {
        return;
    }
    if (st.lex_error_printed >= LEX_ERR_PRINT_CAP) {
        return;
    }

    print_string("error: ");
    print_string(msg);
    print_string(" (byte=");
    print_int(u8_to_i32(b));
    print_string("): ");
    print_file_loc(file_idx, at);
    print_char(10);
    st.lex_error_printed = st.lex_error_printed + 1;
}

function is_alpha(b: u8): bool {
    let v: i32 = u8_to_i32(b);
    if (v >= 65) {
        if (v <= 90) {
            return true;
        }
    }
    if (v >= 97) {
        if (v <= 122) {
            return true;
        }
    }
    return false;
}

function is_digit(b: u8): bool {
    let v: i32 = u8_to_i32(b);
    if (v >= 48) {
        if (v <= 57) {
            return true;
        }
    }
    return false;
}

function is_ident_continue(b: u8): bool {
    if (is_alpha(b)) {
        return true;
    }
    if (is_digit(b)) {
        return true;
    }
    return u8_to_i32(b) == 95;
}

function lex_is_at_end(): bool {
    return st.lex_pos >= st.lex_len;
}

function lex_current(): u8 {
    if (st.lex_pos >= st.lex_len) {
        return i32_to_u8_trunc(0);
    }
    return st.pool[st.lex_base + st.lex_pos];
}

function lex_peek(): u8 {
    let next: i32 = st.lex_pos + 1;
    if (next >= st.lex_len) {
        return i32_to_u8_trunc(0);
    }
    return st.pool[st.lex_base + next];
}

function lex_advance(): void {
    st.lex_pos = st.lex_pos + 1;
}

function lex_skip_ws_and_comments(): void {
    let progressed: i32 = 1;
    for (; progressed != 0; ) {
        progressed = 0;

        if (lex_is_at_end()) {
            return;
        }

        let b: u8 = lex_current();
        if (b == 32 || b == 9 || b == 10 || b == 13) {
            lex_advance();
            progressed = 1;
        } else {
            if (b == 47) { // '/'
                let p: u8 = lex_peek();
                if (p == 47) { // line comment
                    lex_advance();
                    lex_advance();
                    for (; !lex_is_at_end() && lex_current() != 10 && lex_current() != 13; ) {
                        lex_advance();
                    }
                    progressed = 1;
                } else {
                    if (p == 42) { // block comment
                        lex_advance();
                        lex_advance();
                        for (; !lex_is_at_end() && !(lex_current() == 42 && lex_peek() == 47); ) {
                            lex_advance();
                        }
                        if (!lex_is_at_end()) {
                            lex_advance();
                            lex_advance();
                        }
                        progressed = 1;
                    }
                }
            }
        }
    }
}

function lex_bytes_eq_lit(start: i32, len: i32, lit: ascii[]): bool {
    if (len != ascii_len(lit)) {
        return false;
    }

    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (st.pool[st.lex_base + start + i] != lit[i]) {
            return false;
        }
    }
    return true;
}

function lex_keyword_kind(start: i32, len: i32): Tok {
    if (lex_bytes_eq_lit(start, len, "import")) { return Tok.ImportKeyword; }
    if (lex_bytes_eq_lit(start, len, "struct")) { return Tok.StructKeyword; }
    if (lex_bytes_eq_lit(start, len, "enum")) { return Tok.EnumKeyword; }
    if (lex_bytes_eq_lit(start, len, "global")) { return Tok.GlobalKeyword; }
    if (lex_bytes_eq_lit(start, len, "const")) { return Tok.ConstKeyword; }
    if (lex_bytes_eq_lit(start, len, "function")) { return Tok.FunctionKeyword; }
    if (lex_bytes_eq_lit(start, len, "export")) { return Tok.ExportKeyword; }
    if (lex_bytes_eq_lit(start, len, "test")) { return Tok.TestKeyword; }
    if (lex_bytes_eq_lit(start, len, "return")) { return Tok.ReturnKeyword; }
    if (lex_bytes_eq_lit(start, len, "let")) { return Tok.LetKeyword; }
    if (lex_bytes_eq_lit(start, len, "if")) { return Tok.IfKeyword; }
    if (lex_bytes_eq_lit(start, len, "else")) { return Tok.ElseKeyword; }
    if (lex_bytes_eq_lit(start, len, "for")) { return Tok.ForKeyword; }
    if (lex_bytes_eq_lit(start, len, "foreach")) { return Tok.ForeachKeyword; }
    if (lex_bytes_eq_lit(start, len, "in")) { return Tok.InKeyword; }
    if (lex_bytes_eq_lit(start, len, "true")) { return Tok.TrueKeyword; }
    if (lex_bytes_eq_lit(start, len, "false")) { return Tok.FalseKeyword; }
    return Tok.Identifier;
}

function lex_identifier_or_keyword(): Tok {
    let start: i32 = st.lex_pos;
    for (; !lex_is_at_end() && is_ident_continue(lex_current()); ) {
        lex_advance();
    }
    st.tok_start = start;
    st.tok_len = st.lex_pos - start;
    return lex_keyword_kind(start, st.tok_len);
}

function lex_number(): Tok {
    let start: i32 = st.lex_pos;
    let has_dot: i32 = 0;

    let done: i32 = 0;
    for (; !lex_is_at_end() && done == 0; ) {
        let b: u8 = lex_current();
        if (is_digit(b)) {
            lex_advance();
        } else {
            if (b == 46 && has_dot == 0 && is_digit(lex_peek())) { // '.' + digit
                has_dot = 1;
                lex_advance(); // '.'
                lex_advance(); // digit after '.'
            } else {
                done = 1;
            }
        }
    }

    st.tok_start = start;
    st.tok_len = st.lex_pos - start;
    if (has_dot != 0) {
        return Tok.FloatLiteral;
    }
    return Tok.IntegerLiteral;
}

function lex_string_like(quote: u8, kind: Tok): Tok {
    let start: i32 = st.lex_pos;
    lex_advance(); // opening quote/backtick

    for (; !lex_is_at_end() && lex_current() != quote; ) {
        lex_advance();
    }

    if (lex_is_at_end()) {
        st.lex_error_count = st.lex_error_count + 1;
        if (kind == Tok.StringLiteral) {
            lex_print_err(st.lex_file_idx, "unterminated string literal", start);
        } else {
            lex_print_err(st.lex_file_idx, "unterminated backtick literal", start);
        }
        st.tok_start = start;
        st.tok_len = st.lex_pos - start;
        return kind;
    }

    lex_advance(); // closing quote/backtick
    st.tok_start = start;
    st.tok_len = st.lex_pos - start;
    return kind;
}

function lex_next_kind(): Tok {
    lex_skip_ws_and_comments();

    if (lex_is_at_end()) {
        st.tok_start = st.lex_pos;
        st.tok_len = 0;
        return Tok.Eof;
    }

    let start: i32 = st.lex_pos;
    let b: u8 = lex_current();

    if (is_alpha(b)) {
        return lex_identifier_or_keyword();
    }

    if (is_digit(b)) {
        return lex_number();
    }

    if (b == 34) { // '"'
        return lex_string_like(34, Tok.StringLiteral);
    }
    if (b == 96) { // '`'
        return lex_string_like(96, Tok.BacktickLiteral);
    }

    // One and two byte tokens.
    lex_advance();
    st.tok_start = start;
    st.tok_len = 1;

    if (b == 46) { return Tok.Dot; } // '.'
    if (b == 64) { return Tok.At; } // '@'

    if (b == 38) { // '&'
        if (lex_current() == 38) {
            lex_advance();
            st.tok_len = 2;
            return Tok.AmpAmp;
        }
        st.lex_error_count = st.lex_error_count + 1;
        lex_print_err_byte(st.lex_file_idx, "unexpected '&' (use &&)", start, b);
        return Tok.Unknown;
    }

    if (b == 124) { // '|'
        if (lex_current() == 124) {
            lex_advance();
            st.tok_len = 2;
            return Tok.PipePipe;
        }
        st.lex_error_count = st.lex_error_count + 1;
        lex_print_err_byte(st.lex_file_idx, "unexpected '|' (use ||)", start, b);
        return Tok.Unknown;
    }

    if (b == 33) { // '!'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.BangEqual;
        }
        return Tok.Bang;
    }

    if (b == 43) { // '+'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.PlusEqual;
        }
        return Tok.Plus;
    }

    if (b == 45) { // '-'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.MinusEqual;
        }
        return Tok.Minus;
    }

    if (b == 42) { // '*'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.StarEqual;
        }
        return Tok.Star;
    }

    if (b == 47) { // '/'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.SlashEqual;
        }
        return Tok.Slash;
    }

    if (b == 37) { // '%'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.PercentEqual;
        }
        return Tok.Percent;
    }

    if (b == 60) { // '<'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.LessEqual;
        }
        return Tok.Less;
    }

    if (b == 62) { // '>'
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.GreaterEqual;
        }
        return Tok.Greater;
    }

    if (b == 58) { return Tok.Colon; } // ':'

    if (b == 61) { // '='
        if (lex_current() == 61) {
            lex_advance();
            st.tok_len = 2;
            return Tok.EqualEqual;
        }
        return Tok.Equal;
    }

    if (b == 40) { return Tok.LParen; } // '('
    if (b == 41) { return Tok.RParen; } // ')'
    if (b == 123) { return Tok.LBrace; } // '{'
    if (b == 125) { return Tok.RBrace; } // '}'
    if (b == 91) { return Tok.LBracket; } // '['
    if (b == 93) { return Tok.RBracket; } // ']'
    if (b == 44) { return Tok.Comma; } // ','
    if (b == 59) { return Tok.Semicolon; } // ';'

    st.lex_error_count = st.lex_error_count + 1;
    lex_print_err_byte(st.lex_file_idx, "unexpected byte", start, b);
    return Tok.Unknown;
}
