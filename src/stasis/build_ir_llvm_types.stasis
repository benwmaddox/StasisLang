import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_is_ident_start_byte(b: u8): bool {
    return (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8) || b == 95u8;
}

function llvm_is_ident_continue_byte(b: u8): bool {
    if (llvm_is_ident_start_byte(b)) { return true; }
    return b >= 48u8 && b <= 57u8;
}

function llvm_span_is_simple_ident(file_idx: i32, start: i32, len: i32): bool {
    if (file_idx < 0 || file_idx >= stasis.file_count) { return false; }
    if (len <= 0) { return false; }

    let base: i32 = stasis.files[file_idx].offset + start;
    let b0: u8 = stasis.pool[base];
    if (!llvm_is_ident_start_byte(b0)) { return false; }

    let i: i32 = 1;
    for (i = i; i < len; i = i + 1) {
        if (!llvm_is_ident_continue_byte(stasis.pool[base + i])) {
            return false;
        }
    }
    return true;
}

function llvm_ascii_is_simple_ident(s: ascii[]): bool {
    let len: i32 = ascii_len(s);
    if (len <= 0) { return false; }
    let b0: u8 = s[0];
    if (!llvm_is_ident_start_byte(b0)) { return false; }

    let i: i32 = 1;
    for (i = i; i < len; i = i + 1) {
        if (!llvm_is_ident_continue_byte(s[i])) {
            return false;
        }
    }
    return true;
}

function llvm_append_func_ir_name(func_idx: i32): void {
    if (func_idx < 0 || func_idx >= stasis.func_count) {
        return;
    }

    if (stasis.funcs[func_idx].body_start < 0) {
        // Extern (no-body) functions are linked from the runtime as `stasis_<name>`.
        ascii_append(stasis.ir_out, "stasis_");
        ir_append_span(stasis.ir_out, stasis.funcs[func_idx].file_idx, stasis.funcs[func_idx].name_start, stasis.funcs[func_idx].name_len);
        return;
    }

    let file_idx: i32 = stasis.funcs[func_idx].file_idx;
    if (file_idx == 0 && span_eq(file_idx, stasis.funcs[func_idx].name_start, stasis.funcs[func_idx].name_len, "main")) {
        ascii_append(stasis.ir_out, "main");
        return;
    }

    let name_simple: i32 = 0;
    if (llvm_span_is_simple_ident(file_idx, stasis.funcs[func_idx].name_start, stasis.funcs[func_idx].name_len)) {
        name_simple = 1;
    }

    let mod_simple: i32 = 1;
    if (file_idx == 0) {
        if (!llvm_ascii_is_simple_ident(stasis.arg_module)) {
            mod_simple = 0;
        }
    }

    let needs_quotes: i32 = 0;
    if (name_simple == 0 || mod_simple == 0) {
        needs_quotes = 1;
    }

    if (needs_quotes != 0) {
        ascii_append_byte(stasis.ir_out, 34); // '"'
    }
    if (file_idx == 0) {
        ascii_append(stasis.ir_out, stasis.arg_module);
    } else {
        let off: i32 = stasis.files[file_idx].mod_off;
        let len: i32 = stasis.files[file_idx].mod_len;
        let mod_i: i32 = 0;
        for (mod_i = 0; mod_i < len; mod_i = mod_i + 1) {
            ascii_append_byte(stasis.ir_out, stasis.mod_pool[off + mod_i]);
        }
    }

    ascii_append(stasis.ir_out, "__");

    if (needs_quotes == 0) {
        ir_append_span(stasis.ir_out, file_idx, stasis.funcs[func_idx].name_start, stasis.funcs[func_idx].name_len);
    } else {
        let base: i32 = stasis.files[file_idx].offset + stasis.funcs[func_idx].name_start;
        let name_i: i32 = 0;
        for (name_i = 0; name_i < stasis.funcs[func_idx].name_len; name_i = name_i + 1) {
            let b: u8 = stasis.pool[base + name_i];
            if (b == 34 || b == 92) {
                ascii_append_byte(stasis.ir_out, 95); // '_'
            } else {
                ascii_append_byte(stasis.ir_out, b);
            }
        }
    }

    if (needs_quotes != 0) {
        ascii_append_byte(stasis.ir_out, 34); // '"'
    }
}

function llvm_append_struct_ir_name(struct_idx: i32): void {
    if (struct_idx < 0 || struct_idx >= stasis.struct_count) {
        return;
    }

    let file_idx: i32 = stasis.structs[struct_idx].file_idx;
    let name_simple: i32 = 0;
    if (llvm_span_is_simple_ident(file_idx, stasis.structs[struct_idx].name_start, stasis.structs[struct_idx].name_len)) {
        name_simple = 1;
    }

    let mod_simple: i32 = 1;
    if (file_idx == 0) {
        if (!llvm_ascii_is_simple_ident(stasis.arg_module)) {
            mod_simple = 0;
        }
    }

    let needs_quotes: i32 = 0;
    if (name_simple == 0 || mod_simple == 0) {
        needs_quotes = 1;
    }

    if (needs_quotes != 0) {
        ascii_append_byte(stasis.ir_out, 34); // '"'
    }
    if (file_idx == 0) {
        ascii_append(stasis.ir_out, stasis.arg_module);
    } else {
        let off: i32 = stasis.files[file_idx].mod_off;
        let len: i32 = stasis.files[file_idx].mod_len;
        let mod_i: i32 = 0;
        for (mod_i = 0; mod_i < len; mod_i = mod_i + 1) {
            ascii_append_byte(stasis.ir_out, stasis.mod_pool[off + mod_i]);
        }
    }

    ascii_append(stasis.ir_out, "__");

    if (needs_quotes == 0) {
        ir_append_span(stasis.ir_out, file_idx, stasis.structs[struct_idx].name_start, stasis.structs[struct_idx].name_len);
    } else {
        let base: i32 = stasis.files[file_idx].offset + stasis.structs[struct_idx].name_start;
        let name_i: i32 = 0;
        for (name_i = 0; name_i < stasis.structs[struct_idx].name_len; name_i = name_i + 1) {
            let b: u8 = stasis.pool[base + name_i];
            if (b == 34 || b == 92) {
                ascii_append_byte(stasis.ir_out, 95); // '_'
            } else {
                ascii_append_byte(stasis.ir_out, b);
            }
        }
    }

    if (needs_quotes != 0) {
        ascii_append_byte(stasis.ir_out, 34); // '"'
    }
}

function llvm_append_global_ir_name(global_idx: i32): void {
    if (global_idx < 0 || global_idx >= stasis.global_count) {
        return;
    }

    let file_idx: i32 = stasis.globals[global_idx].file_idx;
    let name_simple: i32 = 0;
    if (llvm_span_is_simple_ident(file_idx, stasis.globals[global_idx].name_start, stasis.globals[global_idx].name_len)) {
        name_simple = 1;
    }

    let mod_simple: i32 = 1;
    if (file_idx == 0) {
        if (!llvm_ascii_is_simple_ident(stasis.arg_module)) {
            mod_simple = 0;
        }
    }

    let needs_quotes: i32 = 0;
    if (name_simple == 0 || mod_simple == 0) {
        needs_quotes = 1;
    }

    if (needs_quotes != 0) {
        ascii_append_byte(stasis.ir_out, 34); // '"'
    }
    if (file_idx == 0) {
        ascii_append(stasis.ir_out, stasis.arg_module);
    } else {
        let off: i32 = stasis.files[file_idx].mod_off;
        let len: i32 = stasis.files[file_idx].mod_len;
        let mod_i: i32 = 0;
        for (mod_i = 0; mod_i < len; mod_i = mod_i + 1) {
            ascii_append_byte(stasis.ir_out, stasis.mod_pool[off + mod_i]);
        }
    }

    ascii_append(stasis.ir_out, "__");

    if (needs_quotes == 0) {
        ir_append_span(stasis.ir_out, file_idx, stasis.globals[global_idx].name_start, stasis.globals[global_idx].name_len);
    } else {
        let base: i32 = stasis.files[file_idx].offset + stasis.globals[global_idx].name_start;
        let name_i: i32 = 0;
        for (name_i = 0; name_i < stasis.globals[global_idx].name_len; name_i = name_i + 1) {
            let b: u8 = stasis.pool[base + name_i];
            if (b == 34 || b == 92) {
                ascii_append_byte(stasis.ir_out, 95); // '_'
            } else {
                ascii_append_byte(stasis.ir_out, b);
            }
        }
    }

    if (needs_quotes != 0) {
        ascii_append_byte(stasis.ir_out, 34); // '"'
    }
}

function llvm_emit_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return 1;
    }

    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind == TypeKind.Named) {
        if (build_type_is_string_named(type_idx)) {
            ascii_append(stasis.ir_out, "ptr");
            return 0;
        }
        if (build_type_is_i32ish(type_idx)) {
            ascii_append(stasis.ir_out, "i32");
            return 0;
        }
        if (build_type_is_f32(type_idx)) {
            ascii_append(stasis.ir_out, "float");
            return 0;
        }
        if (build_type_is_byte_named(type_idx)) {
            ascii_append(stasis.ir_out, "i8");
            return 0;
        }

        let si: i32 = build_find_struct_decl_for_type(type_idx);
        if (si >= 0) {
            ascii_append_byte(stasis.ir_out, 37); // '%'
            llvm_append_struct_ir_name(si);
            return 0;
        }

        return 1;
    }

    if (kind == TypeKind.Array) {
        let size: i32 = stasis.types[type_idx].size;
        if (size == 0) {
            // Slice type: `T[]` modeled as Array(size=0).
            ascii_append(stasis.ir_out, "ptr");
            return 0;
        }

        let elem: i32 = stasis.types[type_idx].elem;
        let header_bytes: i32 = build_header_bytes_for_elem(elem);
        let total: i32 = size + header_bytes;

        ascii_append_byte(stasis.ir_out, 91); // '['
        ir_append_i32(stasis.ir_out, total);
        ascii_append(stasis.ir_out, " x ");
        if (header_bytes != 0) {
            ascii_append(stasis.ir_out, "i8");
        } else {
            if (llvm_emit_type(elem) != 0) {
                return 1;
            }
        }
        ascii_append_byte(stasis.ir_out, 93); // ']'
        return 0;
    }

    return 1;
}

function llvm_align_of_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return 4;
    }

    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind == TypeKind.Named) {
        if (build_type_is_string_named(type_idx)) { return 8; }
        if (build_type_is_i32ish(type_idx)) { return 4; }
        if (build_type_is_f32(type_idx)) { return 4; }
        if (build_type_is_byte_named(type_idx)) { return 1; }
        // Struct alignment: conservative.
        return 16;
    }

    if (kind == TypeKind.Array) {
        // Arrays have the same alignment as their element type (conservative).
        let elem: i32 = stasis.types[type_idx].elem;
        let header_bytes: i32 = build_header_bytes_for_elem(elem);
        if (header_bytes != 0) { return 1; }
        return llvm_align_of_type(elem);
    }

    return 4;
}

function llvm_emit_struct_type_defs(): i32 {
    let si: i32 = 0;
    for (si = 0; si < stasis.struct_count; si = si + 1) {
        ascii_append_byte(stasis.ir_out, 37); // '%'
        llvm_append_struct_ir_name(si);
        ascii_append(stasis.ir_out, " = type { ");

        let off: i32 = stasis.structs[si].fields_off;
        let len: i32 = stasis.structs[si].fields_len;
        let fi: i32 = 0;
        for (fi = 0; fi < len; fi = fi + 1) {
            if (fi != 0) {
                ascii_append(stasis.ir_out, ", ");
            }
            let field_idx: i32 = off + fi;
            if (field_idx < 0 || field_idx >= stasis.field_count) {
                return 1;
            }
            if (llvm_emit_type(stasis.fields[field_idx].type_idx) != 0) {
                return 1;
            }
        }

        ascii_append(stasis.ir_out, " }\n");
    }

    if (stasis.struct_count != 0) {
        ascii_append_byte(stasis.ir_out, 10);
    }

    return 0;
}

function llvm_emit_global_defs(): i32 {
    let g: i32 = 0;
    for (g = 0; g < stasis.global_count; g = g + 1) {
        if (stasis.globals[g].has_init != 0) {
            build_err_at(stasis.globals[g].file_idx, "global initializers not yet supported (llvm bring-up)", stasis.globals[g].name_start);
            return 1;
        }

        ascii_append_byte(stasis.ir_out, 64); // '@'
        llvm_append_global_ir_name(g);
        ascii_append(stasis.ir_out, " = global ");
        if (llvm_emit_type(stasis.globals[g].type_idx) != 0) {
            build_err_at(stasis.globals[g].file_idx, "unsupported global type (llvm bring-up)", stasis.globals[g].name_start);
            return 1;
        }
        ascii_append(stasis.ir_out, " zeroinitializer, align ");
        ir_append_i32(stasis.ir_out, llvm_align_of_type(stasis.globals[g].type_idx));
        ascii_append_byte(stasis.ir_out, 10);
    }

    if (stasis.global_count != 0) {
        ascii_append_byte(stasis.ir_out, 10);
    }

    return 0;
}

function llvm_emit_runtime_decls_and_consts(): void {
    // C runtime
    ascii_append(stasis.ir_out, "declare i32 @printf(ptr, ...)\n");
    ascii_append(stasis.ir_out, "declare i64 @time(ptr)\n");

    // LLVM intrinsics
    ascii_append(stasis.ir_out, "declare float @llvm.sin.f32(float)\n");
    ascii_append(stasis.ir_out, "declare float @llvm.cos.f32(float)\n");
    ascii_append(stasis.ir_out, "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n");

    // Extern (no-body) declarations: `function name(...): type;` -> `declare <ty> @stasis_<name>(...)`
    let i: i32 = 0;
    for (i = 0; i < stasis.func_count; i = i + 1) {
        if (stasis.funcs[i].is_test == 0 && stasis.funcs[i].body_start < 0) {
            let ret_ty: i32 = stasis.funcs[i].ret_type_idx;
            if (ret_ty < 0 || build_type_is_void(ret_ty)) {
                ascii_append(stasis.ir_out, "declare void @");
            } else {
                if (build_type_is_f32(ret_ty)) {
                    ascii_append(stasis.ir_out, "declare float @");
                } else {
                    if (build_type_is_i32ish(ret_ty) || build_type_is_byte_named(ret_ty)) {
                        ascii_append(stasis.ir_out, "declare i32 @");
                    } else {
                        build_err_at(stasis.funcs[i].file_idx, "unsupported extern return type (llvm bring-up)", stasis.funcs[i].name_start);
                        return;
                    }
                }
            }

            llvm_append_func_ir_name(i);
            ascii_append(stasis.ir_out, "(");

            let pi: i32 = 0;
            for (pi = 0; pi < stasis.funcs[i].params_len; pi = pi + 1) {
                if (pi != 0) {
                    ascii_append(stasis.ir_out, ", ");
                }

                let p_decl: i32 = stasis.funcs[i].params_off + pi;
                if (p_decl < 0 || p_decl >= stasis.param_count) {
                    build_err_at(stasis.funcs[i].file_idx, "invalid extern parameters", stasis.funcs[i].name_start);
                    return;
                }
                let p_ty: i32 = stasis.params[p_decl].type_idx;
                if (p_ty < 0 || p_ty >= stasis.type_count) {
                    build_err_at(stasis.funcs[i].file_idx, "invalid extern parameter type", stasis.funcs[i].name_start);
                    return;
                }

                if (build_type_is_f32(p_ty)) {
                    ascii_append(stasis.ir_out, "float");
                } else {
                    if (build_type_is_string_named(p_ty)) {
                        ascii_append(stasis.ir_out, "ptr");
                    } else {
                    if (build_type_is_i32ish(p_ty) || build_type_is_byte_named(p_ty)) {
                        ascii_append(stasis.ir_out, "i32");
                    } else {
                        let pk: TypeKind = stasis.types[p_ty].kind;
                        if (pk == TypeKind.Array) {
                            ascii_append(stasis.ir_out, "ptr");
                        } else {
                            build_err_at(stasis.funcs[i].file_idx, "unsupported extern parameter type (llvm bring-up)", stasis.params[p_decl].name_start);
                            return;
                        }
                    }
                    }
                }
            }

            ascii_append(stasis.ir_out, ")\n");
        }
    }
    ascii_append_byte(stasis.ir_out, 10);

    // Format strings for print_* builtins.
    ascii_append(stasis.ir_out, "@.stasis_fmt_s = private unnamed_addr constant [3 x i8] c");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    llvm_append_cstring_byte(stasis.ir_out, 37); // '%'
    llvm_append_cstring_byte(stasis.ir_out, 115); // 's'
    llvm_append_cstring_byte(stasis.ir_out, 0);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, ", align 1\n");

    ascii_append(stasis.ir_out, "@.stasis_fmt_d = private unnamed_addr constant [4 x i8] c");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    llvm_append_cstring_byte(stasis.ir_out, 32); // ' '
    llvm_append_cstring_byte(stasis.ir_out, 37); // '%'
    llvm_append_cstring_byte(stasis.ir_out, 100); // 'd'
    llvm_append_cstring_byte(stasis.ir_out, 0);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, ", align 1\n");

    ascii_append(stasis.ir_out, "@.stasis_fmt_c = private unnamed_addr constant [3 x i8] c");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    llvm_append_cstring_byte(stasis.ir_out, 37); // '%'
    llvm_append_cstring_byte(stasis.ir_out, 99); // 'c'
    llvm_append_cstring_byte(stasis.ir_out, 0);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, ", align 1\n");
    ascii_append_byte(stasis.ir_out, 10);

}

function llvm_emit_sys_runtime_decls_if_needed(): void {
    // Only emit sys runtime declares when there are actual call sites. This keeps pure programs
    // eligible for `lli` (fast path) and matches stage0 behavior.
    if (!ascii_contains(stasis.ir_out, "call i32 @stasis_sys_")) {
        return;
    }

    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_argc")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_argc()\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_argv")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_argv(i32, ptr, i32)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_read_file")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_read_file(ptr, ptr, i32)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_list_dir")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_list_dir(ptr, ptr, i32)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_write_file")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_write_file(ptr, ptr, i32)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_file_exists")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_file_exists(ptr)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_file_size")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_file_size(ptr)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_file_mtime_ms")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_file_mtime_ms(ptr)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_exec")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_exec(ptr)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_spawn")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_spawn(ptr)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_sleep_ms")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_sleep_ms(i32)\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_read_char")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_read_char()\n"); }
    if (ascii_contains(stasis.ir_out, "call i32 @stasis_sys_read_int")) { ascii_append(stasis.ir_out, "declare i32 @stasis_sys_read_int()\n"); }
    ascii_append_byte(stasis.ir_out, 10);
}
