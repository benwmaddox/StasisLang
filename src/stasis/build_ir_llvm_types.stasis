import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_append_func_ir_name(func_idx: i32): void {
    if (func_idx < 0 || func_idx >= stasis.func_count) {
        return;
    }

    let file_idx: i32 = stasis.funcs[func_idx].file_idx;
    if (file_idx == 0 && span_eq(file_idx, stasis.funcs[func_idx].name_start, stasis.funcs[func_idx].name_len, "main")) {
        ascii_append(stasis.ir_out, "main");
        return;
    }

    if (file_idx == 0) {
        ascii_append(stasis.ir_out, stasis.arg_module);
    } else {
        let off: i32 = stasis.files[file_idx].mod_off;
        let len: i32 = stasis.files[file_idx].mod_len;
        let i: i32 = 0;
        for (i = 0; i < len; i = i + 1) {
            ascii_append_byte(stasis.ir_out, stasis.mod_pool[off + i]);
        }
    }

    ascii_append(stasis.ir_out, "__");
    ir_append_span(stasis.ir_out, file_idx, stasis.funcs[func_idx].name_start, stasis.funcs[func_idx].name_len);
}

function llvm_append_struct_ir_name(struct_idx: i32): void {
    if (struct_idx < 0 || struct_idx >= stasis.struct_count) {
        return;
    }

    let file_idx: i32 = stasis.structs[struct_idx].file_idx;
    if (file_idx == 0) {
        ascii_append(stasis.ir_out, stasis.arg_module);
    } else {
        let off: i32 = stasis.files[file_idx].mod_off;
        let len: i32 = stasis.files[file_idx].mod_len;
        let i: i32 = 0;
        for (i = 0; i < len; i = i + 1) {
            ascii_append_byte(stasis.ir_out, stasis.mod_pool[off + i]);
        }
    }

    ascii_append(stasis.ir_out, "__");
    ir_append_span(stasis.ir_out, file_idx, stasis.structs[struct_idx].name_start, stasis.structs[struct_idx].name_len);
}

function llvm_append_global_ir_name(global_idx: i32): void {
    if (global_idx < 0 || global_idx >= stasis.global_count) {
        return;
    }

    let file_idx: i32 = stasis.globals[global_idx].file_idx;
    if (file_idx == 0) {
        ascii_append(stasis.ir_out, stasis.arg_module);
    } else {
        let off: i32 = stasis.files[file_idx].mod_off;
        let len: i32 = stasis.files[file_idx].mod_len;
        let i: i32 = 0;
        for (i = 0; i < len; i = i + 1) {
            ascii_append_byte(stasis.ir_out, stasis.mod_pool[off + i]);
        }
    }

    ascii_append(stasis.ir_out, "__");
    ir_append_span(stasis.ir_out, file_idx, stasis.globals[global_idx].name_start, stasis.globals[global_idx].name_len);
}

function llvm_emit_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return 1;
    }

    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind == TypeKind.Named) {
        if (build_type_is_i32ish(type_idx)) {
            ascii_append(stasis.ir_out, "i32");
            return 0;
        }
        if (build_type_is_f32(type_idx)) {
            ascii_append(stasis.ir_out, "float");
            return 0;
        }
        if (build_type_is_byte_named(type_idx)) {
            ascii_append(stasis.ir_out, "i8");
            return 0;
        }

        let si: i32 = build_find_struct_decl_for_type(type_idx);
        if (si >= 0) {
            ascii_append_byte(stasis.ir_out, 37); // '%'
            llvm_append_struct_ir_name(si);
            return 0;
        }

        return 1;
    }

    if (kind == TypeKind.Array) {
        let size: i32 = stasis.types[type_idx].size;
        if (size == 0) {
            // Slice type: `T[]` modeled as Array(size=0).
            ascii_append(stasis.ir_out, "ptr");
            return 0;
        }

        let elem: i32 = stasis.types[type_idx].elem;
        let header_bytes: i32 = build_header_bytes_for_elem(elem);
        let total: i32 = size + header_bytes;

        ascii_append_byte(stasis.ir_out, 91); // '['
        ir_append_i32(stasis.ir_out, total);
        ascii_append(stasis.ir_out, " x ");
        if (header_bytes != 0) {
            ascii_append(stasis.ir_out, "i8");
        } else {
            if (llvm_emit_type(elem) != 0) {
                return 1;
            }
        }
        ascii_append_byte(stasis.ir_out, 93); // ']'
        return 0;
    }

    return 1;
}

function llvm_align_of_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= stasis.type_count) {
        return 4;
    }

    let kind: TypeKind = stasis.types[type_idx].kind;
    if (kind == TypeKind.Named) {
        if (build_type_is_i32ish(type_idx)) { return 4; }
        if (build_type_is_f32(type_idx)) { return 4; }
        if (build_type_is_byte_named(type_idx)) { return 1; }
        // Struct alignment: conservative.
        return 16;
    }

    if (kind == TypeKind.Array) {
        // Arrays have the same alignment as their element type (conservative).
        let elem: i32 = stasis.types[type_idx].elem;
        let header_bytes: i32 = build_header_bytes_for_elem(elem);
        if (header_bytes != 0) { return 1; }
        return llvm_align_of_type(elem);
    }

    return 4;
}

function llvm_emit_struct_type_defs(): i32 {
    let si: i32 = 0;
    for (si = 0; si < stasis.struct_count; si = si + 1) {
        ascii_append_byte(stasis.ir_out, 37); // '%'
        llvm_append_struct_ir_name(si);
        ascii_append(stasis.ir_out, " = type { ");

        let off: i32 = stasis.structs[si].fields_off;
        let len: i32 = stasis.structs[si].fields_len;
        let fi: i32 = 0;
        for (fi = 0; fi < len; fi = fi + 1) {
            if (fi != 0) {
                ascii_append(stasis.ir_out, ", ");
            }
            let field_idx: i32 = off + fi;
            if (field_idx < 0 || field_idx >= stasis.field_count) {
                return 1;
            }
            if (llvm_emit_type(stasis.fields[field_idx].type_idx) != 0) {
                return 1;
            }
        }

        ascii_append(stasis.ir_out, " }\n");
    }

    if (stasis.struct_count != 0) {
        ascii_append_byte(stasis.ir_out, 10);
    }

    return 0;
}

function llvm_emit_global_defs(): i32 {
    let g: i32 = 0;
    for (g = 0; g < stasis.global_count; g = g + 1) {
        if (stasis.globals[g].has_init != 0) {
            build_err_at(stasis.globals[g].file_idx, "global initializers not yet supported (llvm bring-up)", stasis.globals[g].name_start);
            return 1;
        }

        ascii_append_byte(stasis.ir_out, 64); // '@'
        llvm_append_global_ir_name(g);
        ascii_append(stasis.ir_out, " = global ");
        if (llvm_emit_type(stasis.globals[g].type_idx) != 0) {
            build_err_at(stasis.globals[g].file_idx, "unsupported global type (llvm bring-up)", stasis.globals[g].name_start);
            return 1;
        }
        ascii_append(stasis.ir_out, " zeroinitializer, align ");
        ir_append_i32(stasis.ir_out, llvm_align_of_type(stasis.globals[g].type_idx));
        ascii_append_byte(stasis.ir_out, 10);
    }

    if (stasis.global_count != 0) {
        ascii_append_byte(stasis.ir_out, 10);
    }

    return 0;
}

function llvm_emit_runtime_decls_and_consts(): void {
    // C runtime
    ascii_append(stasis.ir_out, "declare i32 @printf(ptr, ...)\n");

    // System: sys_* builtins
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_argc()\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_argv(i32, ptr, i32)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_read_file(ptr, ptr, i32)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_write_file(ptr, ptr, i32)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_file_exists(ptr)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_file_size(ptr)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_file_mtime_ms(ptr)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_exec(ptr)\n");
    ascii_append(stasis.ir_out, "declare i32 @stasis_sys_sleep_ms(i32)\n");
    ascii_append_byte(stasis.ir_out, 10);

    // Format strings for print_* builtins.
    ascii_append(stasis.ir_out, "@.stasis_fmt_s = private unnamed_addr constant [3 x i8] c");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    llvm_append_cstring_byte(stasis.ir_out, 37); // '%'
    llvm_append_cstring_byte(stasis.ir_out, 115); // 's'
    llvm_append_cstring_byte(stasis.ir_out, 0);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, ", align 1\n");

    ascii_append(stasis.ir_out, "@.stasis_fmt_d = private unnamed_addr constant [4 x i8] c");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    llvm_append_cstring_byte(stasis.ir_out, 32); // ' '
    llvm_append_cstring_byte(stasis.ir_out, 37); // '%'
    llvm_append_cstring_byte(stasis.ir_out, 100); // 'd'
    llvm_append_cstring_byte(stasis.ir_out, 0);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, ", align 1\n");

    ascii_append(stasis.ir_out, "@.stasis_fmt_c = private unnamed_addr constant [3 x i8] c");
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    llvm_append_cstring_byte(stasis.ir_out, 37); // '%'
    llvm_append_cstring_byte(stasis.ir_out, 99); // 'c'
    llvm_append_cstring_byte(stasis.ir_out, 0);
    ascii_append_byte(stasis.ir_out, 34); // '\"'
    ascii_append(stasis.ir_out, ", align 1\n");
    ascii_append_byte(stasis.ir_out, 10);
}

