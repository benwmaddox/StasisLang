import "../stdlib/stdlib.stasis";
import "state.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";

function llvm_emit_sizeof_struct_i64(struct_idx: i32): i32 {
    let gep_id: i32 = llvm_new_tmp();
    ascii_append(stasis.ir_out, "  ");
    llvm_append_tmp(gep_id);
    ascii_append(stasis.ir_out, " = getelementptr inbounds %");
    llvm_append_struct_ir_name(struct_idx);
    ascii_append(stasis.ir_out, ", ptr null, i32 1\n");

    let size_id: i32 = llvm_new_tmp();
    ascii_append(stasis.ir_out, "  ");
    llvm_append_tmp(size_id);
    ascii_append(stasis.ir_out, " = ptrtoint ptr ");
    llvm_append_tmp(gep_id);
    ascii_append(stasis.ir_out, " to i64\n");
    return size_id;
}

function llvm_emit_memset0_i64(dst_ptr_id: i32, byte_count_i64_id: i32): void {
    ascii_append(stasis.ir_out, "  call void @llvm.memset.p0.i64(ptr ");
    llvm_append_tmp(dst_ptr_id);
    ascii_append(stasis.ir_out, ", i8 0, i64 ");
    llvm_append_tmp(byte_count_i64_id);
    ascii_append(stasis.ir_out, ", i1 false)\n");
}

function llvm_emit_memset0_imm(dst_ptr_id: i32, byte_count: i32): void {
    ascii_append(stasis.ir_out, "  call void @llvm.memset.p0.i64(ptr ");
    llvm_append_tmp(dst_ptr_id);
    ascii_append(stasis.ir_out, ", i8 0, i64 ");
    ir_append_i32(stasis.ir_out, byte_count);
    ascii_append(stasis.ir_out, ", i1 false)\n");
}

function llvm_try_emit_mem_clear_intrinsic(file_idx: i32, idx2: i32, callee_expr: i32, argc: i32, arg_base: i32): i32 {
    // Returns:
    //  - new val_len on success
    //  - -2 if not handled
    //  - -1 on error
    let callee_kind: ExprKind = stasis.expr_nodes[callee_expr].kind;
    if (callee_kind != ExprKind.Name) {
        return -2;
    }

    let cname_start: i32 = stasis.expr_nodes[callee_expr].name_start;
    let cname_len: i32 = stasis.expr_nodes[callee_expr].name_len;
    if (!span_eq(file_idx, cname_start, cname_len, "mem_clear")) {
        return -2;
    }

    if (argc != 1) {
        build_err_at(file_idx, "mem_clear expects 1 argument", stasis.expr_nodes[idx2].at);
        return -1;
    }

    let dst_ptr_id: i32 = stasis.expr_op_at[arg_base];
    let dst_kind: LlvmValueKind = stasis.llvm_val_kind[arg_base];
    let dst_si: i32 = stasis.llvm_val_struct_idx[arg_base];

    // Best-effort: if the argument is a fixed array expression, clear the whole array.
    let arg_expr_off: i32 = stasis.expr_nodes[idx2].right;
    let arg_expr: i32 = stasis.expr_call_args[arg_expr_off];
    let fixed_len: i32 = llvm_try_resolve_fixed_array_len_from_expr(file_idx, arg_expr);
    if (fixed_len > 0) {
        if (dst_kind == LlvmValueKind.PtrI8) {
            llvm_emit_memset0_imm(dst_ptr_id, fixed_len);
        } else {
            if (dst_kind == LlvmValueKind.PtrI32) {
                llvm_emit_memset0_imm(dst_ptr_id, fixed_len * 4);
            } else {
                if (dst_kind == LlvmValueKind.PtrF32) {
                    llvm_emit_memset0_imm(dst_ptr_id, fixed_len * 4);
                } else {
                    if (dst_kind == LlvmValueKind.PtrStruct && dst_si >= 0) {
                        let sizeof_i64: i32 = llvm_emit_sizeof_struct_i64(dst_si);
                        let bytes_i64: i32 = llvm_new_tmp();
                        ascii_append(stasis.ir_out, "  ");
                        llvm_append_tmp(bytes_i64);
                        ascii_append(stasis.ir_out, " = mul i64 ");
                        llvm_append_tmp(sizeof_i64);
                        ascii_append(stasis.ir_out, ", ");
                        ir_append_i32(stasis.ir_out, fixed_len);
                        ascii_append(stasis.ir_out, "\n");
                        llvm_emit_memset0_i64(dst_ptr_id, bytes_i64);
                    } else {
                        build_err_at(file_idx, "mem_clear requires a struct or array pointer (llvm bring-up)", stasis.expr_nodes[idx2].at);
                        return -1;
                    }
                }
            }
        }

        let val_len: i32 = arg_base;
        stasis.expr_op_at[val_len] = 0;
        stasis.llvm_val_kind[val_len] = LlvmValueKind.Void;
        stasis.llvm_val_struct_idx[val_len] = -1;
        return val_len + 1;
    }

    // Struct clear: clear exactly one struct instance.
    if (dst_kind == LlvmValueKind.PtrStruct && dst_si >= 0) {
        let sizeof_i64b: i32 = llvm_emit_sizeof_struct_i64(dst_si);
        llvm_emit_memset0_i64(dst_ptr_id, sizeof_i64b);

        let val_len2: i32 = arg_base;
        stasis.expr_op_at[val_len2] = 0;
        stasis.llvm_val_kind[val_len2] = LlvmValueKind.Void;
        stasis.llvm_val_struct_idx[val_len2] = -1;
        return val_len2 + 1;
    }

    build_err_at(file_idx, "mem_clear requires a fixed array expression or struct pointer (llvm bring-up)", stasis.expr_nodes[idx2].at);
    return -1;
}
