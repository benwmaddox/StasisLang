import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_emit_expr_value(file_idx: i32, root: i32): i32 {
    return llvm_emit_expr_i32_v2(file_idx, root);
}

function llvm_emit_expr_i32(file_idx: i32, root: i32): i32 {
    let id: i32 = llvm_emit_expr_value(file_idx, root);
    if (id < 0) {
        return -1;
    }
    if (st.llvm_val_kind[0] != LlvmValueKind.I32) {
        build_err_at(file_idx, "expected i32 expression", st.expr_nodes[root].at);
        return -1;
    }
    return id;
}

function llvm_emit_expr_f32(file_idx: i32, root: i32): i32 {
    let id: i32 = llvm_emit_expr_value(file_idx, root);
    if (id < 0) {
        return -1;
    }
    if (st.llvm_val_kind[0] != LlvmValueKind.F32) {
        build_err_at(file_idx, "expected f32 expression", st.expr_nodes[root].at);
        return -1;
    }
    return id;
}

function llvm_emit_expr_i32_v2(file_idx: i32, root: i32): i32 {
    if (root < 0) {
        return -1;
    }

    // Stack entry: (node_idx * 2 + mode), mode: 0=value, 1=place.
    // Negative entries are "visited" (postorder).
    let sp: i32 = 0;
    let val_len: i32 = 0;
    st.parse_stack_start[sp] = root * 2;
    sp = sp + 1;

    for (; sp > 0; ) {
        let enc: i32 = st.parse_stack_start[sp - 1];
        if (enc >= 0) {
            st.parse_stack_start[sp - 1] = -enc - 1;

            let idx: i32 = enc / 2;
            let mode: i32 = enc % 2;
            let kind: ExprKind = st.expr_nodes[idx].kind;

            if (kind == ExprKind.Unary) {
                if (sp >= 4096) {
                    build_err_at(file_idx, "expression too complex (node stack)", st.expr_nodes[idx].at);
                    return -1;
                }
                st.parse_stack_start[sp] = st.expr_nodes[idx].left * 2;
                sp = sp + 1;
            } else {
                if (kind == ExprKind.Call) {
                    let argc0: i32 = st.expr_nodes[idx].value;
                    let off0: i32 = st.expr_nodes[idx].right;
                    if (argc0 < 0) {
                        build_err_at(file_idx, "invalid call argument count", st.expr_nodes[idx].at);
                        return -1;
                    }
                    if (sp + argc0 >= 4096) {
                        build_err_at(file_idx, "expression too complex (node stack)", st.expr_nodes[idx].at);
                        return -1;
                    }

                    let ai: i32 = 0;
                    for (ai = argc0 - 1; ai >= 0; ai = ai - 1) {
                        st.parse_stack_start[sp] = st.expr_call_args[off0 + ai] * 2;
                        sp = sp + 1;
                    }
                } else {
                    if (kind == ExprKind.Binary) {
                        if (sp + 1 >= 4096) {
                            build_err_at(file_idx, "expression too complex (node stack)", st.expr_nodes[idx].at);
                            return -1;
                        }
                        st.parse_stack_start[sp] = st.expr_nodes[idx].right * 2;
                        sp = sp + 1;
                        st.parse_stack_start[sp] = st.expr_nodes[idx].left * 2;
                        sp = sp + 1;
                    } else {
                        if (kind == ExprKind.Assign) {
                            if (sp + 1 >= 4096) {
                                build_err_at(file_idx, "expression too complex (node stack)", st.expr_nodes[idx].at);
                                return -1;
                            }
                            // Evaluate lhs place first, then rhs value (deterministic).
                            st.parse_stack_start[sp] = st.expr_nodes[idx].right * 2;
                            sp = sp + 1;
                            st.parse_stack_start[sp] = st.expr_nodes[idx].left * 2 + 1;
                            sp = sp + 1;
                        } else {
                            if (kind == ExprKind.Member) {
                                if (sp >= 4096) {
                                    build_err_at(file_idx, "expression too complex (node stack)", st.expr_nodes[idx].at);
                                    return -1;
                                }
                                st.parse_stack_start[sp] = st.expr_nodes[idx].left * 2;
                                sp = sp + 1;
                            } else {
                                if (kind == ExprKind.Index) {
                                    if (sp + 1 >= 4096) {
                                        build_err_at(file_idx, "expression too complex (node stack)", st.expr_nodes[idx].at);
                                        return -1;
                                    }
                                    // Evaluate base first, then index.
                                    st.parse_stack_start[sp] = st.expr_nodes[idx].right * 2;
                                    sp = sp + 1;
                                    st.parse_stack_start[sp] = st.expr_nodes[idx].left * 2;
                                    sp = sp + 1;
                                } else {
                                    if (mode != 0 && kind != ExprKind.Name && kind != ExprKind.Member && kind != ExprKind.Index) {
                                        build_err_at(file_idx, "invalid assignment target", st.expr_nodes[idx].at);
                                        return -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            let enc2: i32 = -enc - 1;
            let idx2: i32 = enc2 / 2;
            let mode2: i32 = enc2 % 2;
            sp = sp - 1;

            val_len = llvm_emit_expr_i32_v2_post(file_idx, idx2, mode2, val_len);
            if (val_len < 0) {
                return -1;
            }
        }
    }

    if (val_len != 1) {
        build_err_at(file_idx, "invalid expression", st.expr_nodes[root].at);
        return -1;
    }
    return st.expr_op_at[0];
}

