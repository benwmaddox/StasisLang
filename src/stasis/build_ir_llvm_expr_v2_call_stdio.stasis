import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call_user.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_try_emit_stdio_intrinsic(file_idx: i32, idx2: i32, argc: i32, arg_base: i32, val_len: i32, cname_start: i32, cname_len: i32): i32 {
    // Returns:
    //  -2: not handled
    //  -1: error
    // >=0: new value stack len

    if (span_eq(file_idx, cname_start, cname_len, "time")) {
        if (argc != 0) {
            build_err_at(file_idx, "time expects no arguments", stasis.expr_nodes[idx2].at);
            return -1;
        }

        let t64: i32 = llvm_new_tmp();
        ascii_append(stasis.ir_out, "  ");
        llvm_append_tmp(t64);
        ascii_append(stasis.ir_out, " = call i64 @time(ptr null)\n");

        let t32: i32 = llvm_new_tmp();
        ascii_append(stasis.ir_out, "  ");
        llvm_append_tmp(t32);
        ascii_append(stasis.ir_out, " = trunc i64 ");
        llvm_append_tmp(t64);
        ascii_append(stasis.ir_out, " to i32\n");

        val_len = arg_base;
        stasis.expr_op_at[val_len] = t32;
        stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
        stasis.llvm_val_struct_idx[val_len] = -1;
        return val_len + 1;
    }

    if (span_eq(file_idx, cname_start, cname_len, "read_int")) {
        if (argc != 0) {
            build_err_at(file_idx, "read_int expects no arguments", stasis.expr_nodes[idx2].at);
            return -1;
        }

        let out_id_read: i32 = llvm_new_tmp();
        ascii_append(stasis.ir_out, "  ");
        llvm_append_tmp(out_id_read);
        ascii_append(stasis.ir_out, " = call i32 @stasis_sys_read_int()\n");

        val_len = arg_base;
        stasis.expr_op_at[val_len] = out_id_read;
        stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
        stasis.llvm_val_struct_idx[val_len] = -1;
        return val_len + 1;
    }

    if (span_eq(file_idx, cname_start, cname_len, "read_char")) {
        if (argc != 0) {
            build_err_at(file_idx, "read_char expects no arguments", stasis.expr_nodes[idx2].at);
            return -1;
        }

        let out_id_read2: i32 = llvm_new_tmp();
        ascii_append(stasis.ir_out, "  ");
        llvm_append_tmp(out_id_read2);
        ascii_append(stasis.ir_out, " = call i32 @stasis_sys_read_char()\n");

        val_len = arg_base;
        stasis.expr_op_at[val_len] = out_id_read2;
        stasis.llvm_val_kind[val_len] = LlvmValueKind.I32;
        stasis.llvm_val_struct_idx[val_len] = -1;
        return val_len + 1;
    }

    return -2;
}
