import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";

function sh_span_eq(file_idx: i32, start: i32, len: i32, lit: ascii[]): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }
    if (len != ascii_len(lit)) {
        return false;
    }

    let base: i32 = sh.files[file_idx].offset + start;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (sh.pool[base + i] != lit[i]) {
            return false;
        }
    }
    return true;
}

function sh_ir_append_span(dst: ascii[], file_idx: i32, start: i32, len: i32): void {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return;
    }
    let base: i32 = sh.files[file_idx].offset + start;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        ascii_append_byte(dst, sh.pool[base + i]);
    }
}

function sh_llvm_append_hex_digit(dst: ascii[], v: i32): void {
    let x: i32 = v;
    if (x < 0) { x = 0; }
    if (x > 15) { x = 15; }
    if (x < 10) {
        ascii_append_byte(dst, 48 + x); // '0'..'9'
    } else {
        ascii_append_byte(dst, 65 + (x - 10)); // 'A'..'F'
    }
}

function sh_llvm_append_hex_byte(dst: ascii[], b: i32): void {
    let x: i32 = b;
    if (x < 0) { x = 0; }
    if (x > 255) { x = 255; }
    ascii_append_byte(dst, 92); // '\'
    sh_llvm_append_hex_digit(dst, x / 16);
    sh_llvm_append_hex_digit(dst, x % 16);
}

function sh_llvm_append_cstring_byte(dst: ascii[], b: i32): void {
    if (b >= 32 && b <= 126 && b != 34 && b != 92) { // printable, not '"' or '\'
        ascii_append_byte(dst, b);
    } else {
        sh_llvm_append_hex_byte(dst, b);
    }
}

function sh_llvm_string_lit_unescaped_len_ascii(file_idx: i32, tok_start: i32, tok_len: i32): i32 {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return -1;
    }
    if (tok_len < 2) {
        sh_build_err_at(file_idx, "invalid string literal", tok_start);
        return -1;
    }

    let base: i32 = sh.files[file_idx].offset;
    let i: i32 = tok_start + 1;
    let end: i32 = tok_start + tok_len - 1; // exclude closing quote
    let out_len: i32 = 0;
    for (; i < end; ) {
        let b: u8 = sh.pool[base + i];
        if (b == 92) { // '\\'
            if (i + 1 >= end) {
                sh_build_err_at(file_idx, "unterminated escape in string literal", tok_start);
                return -1;
            }
            let e: u8 = sh.pool[base + i + 1];
            let out_b: i32 = -1;
            if (e == 110) { out_b = 10; } // 'n'
            if (e == 114) { out_b = 13; } // 'r'
            if (e == 116) { out_b = 9; }  // 't'
            if (e == 48) { out_b = 0; }   // '0'
            if (e == 34) { out_b = 34; }  // '\"'
            if (e == 92) { out_b = 92; }  // '\\'
            if (out_b < 0) {
                sh_build_err_at(file_idx, "unsupported escape in string literal (bring-up)", tok_start);
                return -1;
            }
            out_len = out_len + 1;
            i = i + 2;
        } else {
            out_len = out_len + 1;
            i = i + 1;
        }
    }
    return out_len;
}

function sh_llvm_string_lit_append_unescaped_bytes_ascii(dst: ascii[], file_idx: i32, tok_start: i32, tok_len: i32): i32 {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return 1;
    }
    if (tok_len < 2) {
        return 1;
    }

    let base: i32 = sh.files[file_idx].offset;
    let i: i32 = tok_start + 1;
    let end: i32 = tok_start + tok_len - 1; // exclude closing quote
    for (; i < end; ) {
        let b: u8 = sh.pool[base + i];
        if (b == 92) { // '\\'
            if (i + 1 >= end) {
                return 1;
            }
            let e: u8 = sh.pool[base + i + 1];
            let out_b: i32 = -1;
            if (e == 110) { out_b = 10; } // 'n'
            if (e == 114) { out_b = 13; } // 'r'
            if (e == 116) { out_b = 9; }  // 't'
            if (e == 48) { out_b = 0; }   // '0'
            if (e == 34) { out_b = 34; }  // '\"'
            if (e == 92) { out_b = 92; }  // '\\'
            if (out_b < 0) {
                return 1;
            }
            sh_llvm_append_cstring_byte(dst, out_b);
            i = i + 2;
        } else {
            sh_llvm_append_cstring_byte(dst, u8_to_i32(b));
            i = i + 1;
        }
    }
    return 0;
}

function sh_build_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (sh.quiet != 0) {
        return;
    }
    print_string("error: ");
    print_string(msg);
    print_string(": ");
    sh_print_file_loc(file_idx, at);
    print_char(10);
}

function sh_build_parse_i32_from_tok(file_idx: i32): i32 {
    let v: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < sh.tok_len; i = i + 1) {
        let b: u8 = sh.pool[sh.lex_base + sh.tok_start + i];
        if (!ascii_is_digit(b)) {
            sh_build_err_at(file_idx, "expected integer literal", sh.tok_start);
            return 0;
        }
        v = v * 10 + ascii_to_digit(b);
    }
    return v;
}

function sh_build_find_entry_main(): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.func_count; i = i + 1) {
        if (sh.funcs[i].is_test == 0) {
            if (sh.funcs[i].file_idx == 0) {
                if (sh_span_eq(sh.funcs[i].file_idx, sh.funcs[i].name_start, sh.funcs[i].name_len, "main")) {
                    return i;
                }
            }
        }
    }
    return -1;
}

function sh_build_type_is_i32(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return false;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Named) {
        return false;
    }
    return sh_span_eq(sh.types[type_idx].file_idx, sh.types[type_idx].start, sh.types[type_idx].len, "i32");
}

function sh_build_type_is_i32ish(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return false;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Named) {
        return false;
    }
    if (sh_span_eq(sh.types[type_idx].file_idx, sh.types[type_idx].start, sh.types[type_idx].len, "i32")) { return true; }
    if (sh_span_eq(sh.types[type_idx].file_idx, sh.types[type_idx].start, sh.types[type_idx].len, "bool")) { return true; }
    return sh_build_find_enum_decl_for_type(type_idx) >= 0;
}

function sh_build_type_is_byte_named(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return false;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Named) {
        return false;
    }
    if (sh_span_eq(sh.types[type_idx].file_idx, sh.types[type_idx].start, sh.types[type_idx].len, "u8")) { return true; }
    if (sh_span_eq(sh.types[type_idx].file_idx, sh.types[type_idx].start, sh.types[type_idx].len, "ascii")) { return true; }
    return sh_span_eq(sh.types[type_idx].file_idx, sh.types[type_idx].start, sh.types[type_idx].len, "utf8");
}

function sh_build_header_bytes_for_elem(elem_type_idx: i32): i32 {
    if (elem_type_idx < 0 || elem_type_idx >= sh.type_count) {
        return 0;
    }
    let kind: ShTypeKind = sh.types[elem_type_idx].kind;
    if (kind != ShTypeKind.Named) {
        return 0;
    }
    if (sh_span_eq(sh.types[elem_type_idx].file_idx, sh.types[elem_type_idx].start, sh.types[elem_type_idx].len, "ascii")) { return 4; }
    if (sh_span_eq(sh.types[elem_type_idx].file_idx, sh.types[elem_type_idx].start, sh.types[elem_type_idx].len, "utf8")) { return 8; }
    return 0;
}

function sh_build_type_is_slice_of_bytes(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return false;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Array) {
        return false;
    }
    if (sh.types[type_idx].size != 0) {
        return false;
    }
    return sh_build_type_is_byte_named(sh.types[type_idx].elem);
}

function sh_build_type_is_slice_of_i32ish(type_idx: i32): bool {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return false;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Array) {
        return false;
    }
    if (sh.types[type_idx].size != 0) {
        return false;
    }
    return sh_build_type_is_i32ish(sh.types[type_idx].elem);
}

function sh_build_find_struct_decl_for_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return -1;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Named) {
        return -1;
    }

    let want_file: i32 = sh.types[type_idx].file_idx;
    let want_start: i32 = sh.types[type_idx].start;
    let want_len: i32 = sh.types[type_idx].len;

    let si: i32 = 0;
    for (si = 0; si < sh.struct_count; si = si + 1) {
        if (sh_span_eq_span_cross(want_file, want_start, want_len, sh.structs[si].file_idx, sh.structs[si].name_start, sh.structs[si].name_len)) {
            return si;
        }
    }
    return -1;
}

function sh_build_find_enum_decl_for_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return -1;
    }
    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind != ShTypeKind.Named) {
        return -1;
    }

    let want_file: i32 = sh.types[type_idx].file_idx;
    let want_start: i32 = sh.types[type_idx].start;
    let want_len: i32 = sh.types[type_idx].len;

    let ei: i32 = 0;
    for (ei = 0; ei < sh.enum_count; ei = ei + 1) {
        if (sh_span_eq_span_cross(want_file, want_start, want_len, sh.enums[ei].file_idx, sh.enums[ei].name_start, sh.enums[ei].name_len)) {
            return ei;
        }
    }
    return -1;
}

function sh_build_find_struct_field(struct_idx: i32, name_file_idx: i32, name_start: i32, name_len: i32): i32 {
    if (struct_idx < 0 || struct_idx >= sh.struct_count) {
        return -1;
    }

    let off: i32 = sh.structs[struct_idx].fields_off;
    let len: i32 = sh.structs[struct_idx].fields_len;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        let field_idx: i32 = off + i;
        if (field_idx >= 0 && field_idx < sh.field_count) {
            if (sh_span_eq_span_cross(name_file_idx, name_start, name_len, sh.fields[field_idx].file_idx, sh.fields[field_idx].name_start, sh.fields[field_idx].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function sh_llvm_find_func_noargs_i32(file_idx: i32, name_start: i32, name_len: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.func_count; i = i + 1) {
        if (sh.funcs[i].is_test == 0) {
            if (sh.funcs[i].file_idx == file_idx) {
                if (sh.funcs[i].params_len == 0) {
                    if (sh_build_type_is_i32(sh.funcs[i].ret_type_idx)) {
                        if (sh_span_eq_span(file_idx, name_start, name_len, sh.funcs[i].name_start, sh.funcs[i].name_len)) {
                            return i;
                        }
                    }
                }
            }
        }
    }
    return -1;
}

function sh_span_eq_span(file_idx: i32, a_start: i32, a_len: i32, b_start: i32, b_len: i32): bool {
    if (file_idx < 0 || file_idx >= sh.file_count) {
        return false;
    }
    if (a_len != b_len) {
        return false;
    }

    let base: i32 = sh.files[file_idx].offset;
    let i: i32 = 0;
    for (i = 0; i < a_len; i = i + 1) {
        if (sh.pool[base + a_start + i] != sh.pool[base + b_start + i]) {
            return false;
        }
    }
    return true;
}

function sh_span_eq_span_cross(a_file_idx: i32, a_start: i32, a_len: i32, b_file_idx: i32, b_start: i32, b_len: i32): bool {
    if (a_file_idx < 0 || a_file_idx >= sh.file_count) { return false; }
    if (b_file_idx < 0 || b_file_idx >= sh.file_count) { return false; }
    if (a_len != b_len) { return false; }

    let a_base: i32 = sh.files[a_file_idx].offset + a_start;
    let b_base: i32 = sh.files[b_file_idx].offset + b_start;
    let i: i32 = 0;
    for (i = 0; i < a_len; i = i + 1) {
        if (sh.pool[a_base + i] != sh.pool[b_base + i]) {
            return false;
        }
    }
    return true;
}

function sh_span_eq_module_name(caller_file_idx: i32, mod_start: i32, mod_len: i32, module_file_idx: i32): bool {
    if (caller_file_idx < 0 || caller_file_idx >= sh.file_count) { return false; }
    if (module_file_idx < 0 || module_file_idx >= sh.file_count) { return false; }

    let want_len: i32 = sh.files[module_file_idx].mod_len;
    if (mod_len != want_len) {
        return false;
    }

    let a_base: i32 = sh.files[caller_file_idx].offset + mod_start;
    let b_base: i32 = sh.files[module_file_idx].mod_off;
    let i: i32 = 0;
    for (i = 0; i < mod_len; i = i + 1) {
        if (sh.pool[a_base + i] != sh.mod_pool[b_base + i]) {
            return false;
        }
    }
    return true;
}

function sh_llvm_find_imported_module(caller_file_idx: i32, mod_start: i32, mod_len: i32): i32 {
    // Allow `ThisModule.symbol` for clarity.
    if (sh_span_eq_module_name(caller_file_idx, mod_start, mod_len, caller_file_idx)) {
        return caller_file_idx;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        if (sh_span_eq_module_name(caller_file_idx, mod_start, mod_len, mod_file)) {
            return mod_file;
        }
    }
    return -1;
}

function sh_llvm_find_func_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.func_count; i = i + 1) {
        if (sh.funcs[i].is_test == 0) {
            if (sh.funcs[i].file_idx == target_file_idx) {
                if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, sh.funcs[i].name_start, sh.funcs[i].name_len)) {
                    return i;
                }
            }
        }
    }
    return -1;
}

function sh_llvm_find_global_in_file(named_file_idx: i32, name_start: i32, name_len: i32, target_file_idx: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.global_count; i = i + 1) {
        if (sh.globals[i].file_idx == target_file_idx) {
            if (sh_span_eq_span_cross(named_file_idx, name_start, name_len, target_file_idx, sh.globals[i].name_start, sh.globals[i].name_len)) {
                return i;
            }
        }
    }
    return -1;
}

function sh_llvm_resolve_unqualified_global(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = sh_llvm_find_global_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let found: i32 = -1;

    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        let hit: i32 = sh_llvm_find_global_in_file(caller_file_idx, name_start, name_len, mod_file);
        if (hit >= 0) {
            if (found < 0) {
                found = hit;
            } else {
                sh_build_err_at(caller_file_idx, "ambiguous global name (use Module.symbol)", at);
                return -1;
            }
        }
    }

    if (found < 0) {
        sh_build_err_at(caller_file_idx, "unknown global", at);
        return -1;
    }
    return found;
}

function sh_llvm_resolve_unqualified_func(caller_file_idx: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let local: i32 = sh_llvm_find_func_in_file(caller_file_idx, name_start, name_len, caller_file_idx);
    if (local >= 0) {
        return local;
    }

    let imp_off: i32 = sh.files[caller_file_idx].imports_off;
    let imp_len: i32 = sh.files[caller_file_idx].imports_len;
    let found: i32 = -1;

    let i: i32 = 0;
    for (i = 0; i < imp_len; i = i + 1) {
        let mod_file: i32 = sh.imports[imp_off + i];
        let hit: i32 = sh_llvm_find_func_in_file(caller_file_idx, name_start, name_len, mod_file);
        if (hit >= 0) {
            if (found < 0) {
                found = hit;
            } else {
                sh_build_err_at(caller_file_idx, "ambiguous function name (use Module.symbol)", at);
                return -1;
            }
        }
    }

    if (found < 0) {
        sh_build_err_at(caller_file_idx, "unknown function", at);
        return -1;
    }
    return found;
}

function sh_llvm_resolve_qualified_func(caller_file_idx: i32, mod_start: i32, mod_len: i32, name_start: i32, name_len: i32, at: i32): i32 {
    let mod_file: i32 = sh_llvm_find_imported_module(caller_file_idx, mod_start, mod_len);
    if (mod_file < 0) {
        sh_build_err_at(caller_file_idx, "unknown module", at);
        return -1;
    }

    let fn: i32 = sh_llvm_find_func_in_file(caller_file_idx, name_start, name_len, mod_file);
    if (fn < 0) {
        sh_build_err_at(caller_file_idx, "unknown function", at);
        return -1;
    }
    return fn;
}

function sh_llvm_resolve_callee_func(caller_file_idx: i32, callee_expr: i32, at: i32): i32 {
    if (callee_expr < 0 || callee_expr >= sh.expr_count) {
        sh_build_err_at(caller_file_idx, "invalid call target", at);
        return -1;
    }

    let kind: ShExprKind = sh.expr_nodes[callee_expr].kind;
    if (kind == ShExprKind.Name) {
        return sh_llvm_resolve_unqualified_func(caller_file_idx, sh.expr_nodes[callee_expr].name_start, sh.expr_nodes[callee_expr].name_len, at);
    }

    if (kind == ShExprKind.Member) {
        let base: i32 = sh.expr_nodes[callee_expr].left;
        if (base < 0 || base >= sh.expr_count) {
            sh_build_err_at(caller_file_idx, "invalid member call target", at);
            return -1;
        }
        let base_kind: ShExprKind = sh.expr_nodes[base].kind;
        if (base_kind != ShExprKind.Name) {
            sh_build_err_at(caller_file_idx, "unsupported call target (member)", at);
            return -1;
        }
        return sh_llvm_resolve_qualified_func(
            caller_file_idx,
            sh.expr_nodes[base].name_start,
            sh.expr_nodes[base].name_len,
            sh.expr_nodes[callee_expr].name_start,
            sh.expr_nodes[callee_expr].name_len,
            at
        );
    }

    sh_build_err_at(caller_file_idx, "unsupported call target", at);
    return -1;
}

function sh_llvm_append_func_ir_name(func_idx: i32): void {
    if (func_idx < 0 || func_idx >= sh.func_count) {
        return;
    }

    let file_idx: i32 = sh.funcs[func_idx].file_idx;
    if (file_idx == 0 && sh_span_eq(file_idx, sh.funcs[func_idx].name_start, sh.funcs[func_idx].name_len, "main")) {
        ascii_append(sh.ir_out, "main");
        return;
    }

    if (file_idx == 0) {
        ascii_append(sh.ir_out, sh.arg_module);
    } else {
        let off: i32 = sh.files[file_idx].mod_off;
        let len: i32 = sh.files[file_idx].mod_len;
        let i: i32 = 0;
        for (i = 0; i < len; i = i + 1) {
            ascii_append_byte(sh.ir_out, sh.mod_pool[off + i]);
        }
    }

    ascii_append(sh.ir_out, "__");
    sh_ir_append_span(sh.ir_out, file_idx, sh.funcs[func_idx].name_start, sh.funcs[func_idx].name_len);
}

function sh_llvm_append_struct_ir_name(struct_idx: i32): void {
    if (struct_idx < 0 || struct_idx >= sh.struct_count) {
        return;
    }

    let file_idx: i32 = sh.structs[struct_idx].file_idx;
    if (file_idx == 0) {
        ascii_append(sh.ir_out, sh.arg_module);
    } else {
        let off: i32 = sh.files[file_idx].mod_off;
        let len: i32 = sh.files[file_idx].mod_len;
        let i: i32 = 0;
        for (i = 0; i < len; i = i + 1) {
            ascii_append_byte(sh.ir_out, sh.mod_pool[off + i]);
        }
    }

    ascii_append(sh.ir_out, "__");
    sh_ir_append_span(sh.ir_out, file_idx, sh.structs[struct_idx].name_start, sh.structs[struct_idx].name_len);
}

function sh_llvm_append_global_ir_name(global_idx: i32): void {
    if (global_idx < 0 || global_idx >= sh.global_count) {
        return;
    }

    let file_idx: i32 = sh.globals[global_idx].file_idx;
    if (file_idx == 0) {
        ascii_append(sh.ir_out, sh.arg_module);
    } else {
        let off: i32 = sh.files[file_idx].mod_off;
        let len: i32 = sh.files[file_idx].mod_len;
        let i: i32 = 0;
        for (i = 0; i < len; i = i + 1) {
            ascii_append_byte(sh.ir_out, sh.mod_pool[off + i]);
        }
    }

    ascii_append(sh.ir_out, "__");
    sh_ir_append_span(sh.ir_out, file_idx, sh.globals[global_idx].name_start, sh.globals[global_idx].name_len);
}

function sh_llvm_emit_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return 1;
    }

    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind == ShTypeKind.Named) {
        if (sh_build_type_is_i32ish(type_idx)) {
            ascii_append(sh.ir_out, "i32");
            return 0;
        }
        if (sh_build_type_is_byte_named(type_idx)) {
            ascii_append(sh.ir_out, "i8");
            return 0;
        }

        let si: i32 = sh_build_find_struct_decl_for_type(type_idx);
        if (si >= 0) {
            ascii_append_byte(sh.ir_out, 37); // '%'
            sh_llvm_append_struct_ir_name(si);
            return 0;
        }

        return 1;
    }

    if (kind == ShTypeKind.Array) {
        let size: i32 = sh.types[type_idx].size;
        if (size == 0) {
            // Slice type: `T[]` modeled as Array(size=0).
            ascii_append(sh.ir_out, "ptr");
            return 0;
        }

        let elem: i32 = sh.types[type_idx].elem;
        let header_bytes: i32 = sh_build_header_bytes_for_elem(elem);
        let total: i32 = size + header_bytes;

        ascii_append_byte(sh.ir_out, 91); // '['
        sh_ir_append_i32(sh.ir_out, total);
        ascii_append(sh.ir_out, " x ");
        if (header_bytes != 0) {
            ascii_append(sh.ir_out, "i8");
        } else {
            if (sh_llvm_emit_type(elem) != 0) {
                return 1;
            }
        }
        ascii_append_byte(sh.ir_out, 93); // ']'
        return 0;
    }

    return 1;
}

function sh_llvm_align_of_type(type_idx: i32): i32 {
    if (type_idx < 0 || type_idx >= sh.type_count) {
        return 4;
    }

    let kind: ShTypeKind = sh.types[type_idx].kind;
    if (kind == ShTypeKind.Named) {
        if (sh_build_type_is_i32ish(type_idx)) { return 4; }
        if (sh_build_type_is_byte_named(type_idx)) { return 1; }
        // Struct alignment: conservative.
        return 16;
    }

    if (kind == ShTypeKind.Array) {
        // Arrays have the same alignment as their element type (conservative).
        let elem: i32 = sh.types[type_idx].elem;
        let header_bytes: i32 = sh_build_header_bytes_for_elem(elem);
        if (header_bytes != 0) { return 1; }
        return sh_llvm_align_of_type(elem);
    }

    return 4;
}

function sh_llvm_emit_struct_type_defs(): i32 {
    let si: i32 = 0;
    for (si = 0; si < sh.struct_count; si = si + 1) {
        ascii_append_byte(sh.ir_out, 37); // '%'
        sh_llvm_append_struct_ir_name(si);
        ascii_append(sh.ir_out, " = type { ");

        let off: i32 = sh.structs[si].fields_off;
        let len: i32 = sh.structs[si].fields_len;
        let fi: i32 = 0;
        for (fi = 0; fi < len; fi = fi + 1) {
            if (fi != 0) {
                ascii_append(sh.ir_out, ", ");
            }
            let field_idx: i32 = off + fi;
            if (field_idx < 0 || field_idx >= sh.field_count) {
                return 1;
            }
            if (sh_llvm_emit_type(sh.fields[field_idx].type_idx) != 0) {
                return 1;
            }
        }

        ascii_append(sh.ir_out, " }\n");
    }

    if (sh.struct_count != 0) {
        ascii_append_byte(sh.ir_out, 10);
    }

    return 0;
}

function sh_llvm_emit_global_defs(): i32 {
    let g: i32 = 0;
    for (g = 0; g < sh.global_count; g = g + 1) {
        if (sh.globals[g].has_init != 0) {
            sh_build_err_at(sh.globals[g].file_idx, "global initializers not yet supported (llvm bring-up)", sh.globals[g].name_start);
            return 1;
        }

        ascii_append_byte(sh.ir_out, 64); // '@'
        sh_llvm_append_global_ir_name(g);
        ascii_append(sh.ir_out, " = global ");
        if (sh_llvm_emit_type(sh.globals[g].type_idx) != 0) {
            sh_build_err_at(sh.globals[g].file_idx, "unsupported global type (llvm bring-up)", sh.globals[g].name_start);
            return 1;
        }
        ascii_append(sh.ir_out, " zeroinitializer, align ");
        sh_ir_append_i32(sh.ir_out, sh_llvm_align_of_type(sh.globals[g].type_idx));
        ascii_append_byte(sh.ir_out, 10);
    }

    if (sh.global_count != 0) {
        ascii_append_byte(sh.ir_out, 10);
    }

    return 0;
}

function sh_llvm_emit_runtime_decls_and_consts(): void {
    // C runtime
    ascii_append(sh.ir_out, "declare i32 @printf(ptr, ...)\n");

    // System: sys_* builtins
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_argc()\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_argv(i32, ptr, i32)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_read_file(ptr, ptr, i32)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_write_file(ptr, ptr, i32)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_file_exists(ptr)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_file_size(ptr)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_file_mtime_ms(ptr)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_exec(ptr)\n");
    ascii_append(sh.ir_out, "declare i32 @stasis_sys_sleep_ms(i32)\n");
    ascii_append_byte(sh.ir_out, 10);

    // Format strings for print_* builtins.
    ascii_append(sh.ir_out, "@.stasis_fmt_s = private unnamed_addr constant [3 x i8] c");
    ascii_append_byte(sh.ir_out, 34); // '\"'
    sh_llvm_append_cstring_byte(sh.ir_out, 37); // '%'
    sh_llvm_append_cstring_byte(sh.ir_out, 115); // 's'
    sh_llvm_append_cstring_byte(sh.ir_out, 0);
    ascii_append_byte(sh.ir_out, 34); // '\"'
    ascii_append(sh.ir_out, ", align 1\n");

    ascii_append(sh.ir_out, "@.stasis_fmt_d = private unnamed_addr constant [4 x i8] c");
    ascii_append_byte(sh.ir_out, 34); // '\"'
    sh_llvm_append_cstring_byte(sh.ir_out, 32); // ' '
    sh_llvm_append_cstring_byte(sh.ir_out, 37); // '%'
    sh_llvm_append_cstring_byte(sh.ir_out, 100); // 'd'
    sh_llvm_append_cstring_byte(sh.ir_out, 0);
    ascii_append_byte(sh.ir_out, 34); // '\"'
    ascii_append(sh.ir_out, ", align 1\n");

    ascii_append(sh.ir_out, "@.stasis_fmt_c = private unnamed_addr constant [3 x i8] c");
    ascii_append_byte(sh.ir_out, 34); // '\"'
    sh_llvm_append_cstring_byte(sh.ir_out, 37); // '%'
    sh_llvm_append_cstring_byte(sh.ir_out, 99); // 'c'
    sh_llvm_append_cstring_byte(sh.ir_out, 0);
    ascii_append_byte(sh.ir_out, 34); // '\"'
    ascii_append(sh.ir_out, ", align 1\n");
    ascii_append_byte(sh.ir_out, 10);
}

function sh_llvm_get_utf8_string_lit_id(file_idx: i32, tok_start: i32, tok_len: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.llvm_str_count; i = i + 1) {
        if (sh.llvm_str_file_idx[i] == file_idx && sh.llvm_str_tok_start[i] == tok_start && sh.llvm_str_tok_len[i] == tok_len) {
            return i;
        }
    }

    if (sh.llvm_str_count >= 4096) {
        sh_build_err_at(file_idx, "too many string literals (cap)", tok_start);
        return -1;
    }

    let byte_len: i32 = sh_llvm_string_lit_unescaped_len_ascii(file_idx, tok_start, tok_len);
    if (byte_len < 0) {
        return -1;
    }

    // Bring-up: char_len == byte_len (no UTF-8 decode yet).
    let char_len: i32 = byte_len;
    let total_bytes: i32 = 8 + byte_len + 1;

    let id: i32 = sh.llvm_str_count;
    sh.llvm_str_file_idx[id] = file_idx;
    sh.llvm_str_tok_start[id] = tok_start;
    sh.llvm_str_tok_len[id] = tok_len;
    sh.llvm_str_total_bytes[id] = total_bytes;
    sh.llvm_str_byte_len[id] = byte_len;
    sh.llvm_str_char_len[id] = char_len;
    sh.llvm_str_count = sh.llvm_str_count + 1;
    return id;
}

function sh_llvm_emit_utf8_string_lit_ptr(file_idx: i32, tok_start: i32, tok_len: i32): i32 {
    let id: i32 = sh_llvm_get_utf8_string_lit_id(file_idx, tok_start, tok_len);
    if (id < 0) {
        return -1;
    }

    let total_bytes: i32 = sh.llvm_str_total_bytes[id];
    let ptr_id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(ptr_id);
    ascii_append(sh.ir_out, " = getelementptr inbounds [");
    sh_ir_append_i32(sh.ir_out, total_bytes);
    ascii_append(sh.ir_out, " x i8], ptr @.sh_str");
    sh_ir_append_i32(sh.ir_out, id);
    ascii_append(sh.ir_out, ", i32 0, i32 8\n");
    return ptr_id;
}

function sh_llvm_emit_string_literal_globals(): i32 {
    if (sh.llvm_str_count <= 0) {
        return 0;
    }

    ascii_append_byte(sh.ir_out, 10);
    let i: i32 = 0;
    for (i = 0; i < sh.llvm_str_count; i = i + 1) {
        let file_idx: i32 = sh.llvm_str_file_idx[i];
        let tok_start: i32 = sh.llvm_str_tok_start[i];
        let tok_len: i32 = sh.llvm_str_tok_len[i];

        let total_bytes: i32 = sh.llvm_str_total_bytes[i];
        let byte_len: i32 = sh.llvm_str_byte_len[i];
        let char_len: i32 = sh.llvm_str_char_len[i];

        ascii_append_byte(sh.ir_out, 64); // '@'
        ascii_append(sh.ir_out, ".sh_str");
        sh_ir_append_i32(sh.ir_out, i);
        ascii_append(sh.ir_out, " = private unnamed_addr constant [");
        sh_ir_append_i32(sh.ir_out, total_bytes);
        ascii_append(sh.ir_out, " x i8] c");
        ascii_append_byte(sh.ir_out, 34); // '\"'

        // Header: [byte_len: i32][char_len: i32] (little endian).
        let bl: i32 = byte_len;
        sh_llvm_append_cstring_byte(sh.ir_out, bl % 256);
        sh_llvm_append_cstring_byte(sh.ir_out, (bl / 256) % 256);
        sh_llvm_append_cstring_byte(sh.ir_out, (bl / 65536) % 256);
        sh_llvm_append_cstring_byte(sh.ir_out, (bl / 16777216) % 256);

        let cl: i32 = char_len;
        sh_llvm_append_cstring_byte(sh.ir_out, cl % 256);
        sh_llvm_append_cstring_byte(sh.ir_out, (cl / 256) % 256);
        sh_llvm_append_cstring_byte(sh.ir_out, (cl / 65536) % 256);
        sh_llvm_append_cstring_byte(sh.ir_out, (cl / 16777216) % 256);

        if (sh_llvm_string_lit_append_unescaped_bytes_ascii(sh.ir_out, file_idx, tok_start, tok_len) != 0) {
            sh_build_err_at(file_idx, "failed to emit string literal (llvm)", tok_start);
            return 1;
        }

        // Null sentinel.
        sh_llvm_append_cstring_byte(sh.ir_out, 0);

        ascii_append_byte(sh.ir_out, 34); // '\"'
        ascii_append(sh.ir_out, ", align 1\n");
    }
    ascii_append_byte(sh.ir_out, 10);
    return 0;
}

function sh_llvm_reset(): void {
    sh.llvm_local_count = 0;
    sh.llvm_tmp_id = 0;
    sh.llvm_label_id = 0;
    sh.llvm_bb_terminated = 0;
    sh.llvm_place_len = 0;
    sh.llvm_place_kind = ShLlvmValueKind.I32;
    sh.llvm_place_struct_idx = -1;
    sh.llvm_block_len = 0;
}

function sh_llvm_find_local(file_idx: i32, name_start: i32, name_len: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < sh.llvm_local_count; i = i + 1) {
        if (sh_span_eq_span(file_idx, name_start, name_len, sh.llvm_local_name_start[i], sh.llvm_local_name_len[i])) {
            return i;
        }
    }
    return -1;
}

function sh_llvm_add_local(file_idx: i32, name_start: i32, name_len: i32): i32 {
    if (sh.llvm_local_count >= 1024) {
        sh_build_err_at(file_idx, "too many locals (llvm)", name_start);
        return -1;
    }
    if (sh_llvm_find_local(file_idx, name_start, name_len) >= 0) {
        sh_build_err_at(file_idx, "duplicate local name", name_start);
        return -1;
    }

    let id: i32 = sh.llvm_local_count;
    sh.llvm_local_name_start[id] = name_start;
    sh.llvm_local_name_len[id] = name_len;
    sh.llvm_local_kind[id] = ShLlvmValueKind.I32;
    sh.llvm_local_count = sh.llvm_local_count + 1;
    return id;
}

function sh_llvm_append_local_ptr(local_id: i32): void {
    ascii_append(sh.ir_out, "%l");
    sh_ir_append_i32(sh.ir_out, local_id);
}

function sh_llvm_append_tmp(tmp_id: i32): void {
    ascii_append(sh.ir_out, "%t");
    sh_ir_append_i32(sh.ir_out, tmp_id);
}

function sh_llvm_new_tmp(): i32 {
    let id: i32 = sh.llvm_tmp_id;
    sh.llvm_tmp_id = sh.llvm_tmp_id + 1;
    return id;
}

function sh_llvm_new_label(): i32 {
    let id: i32 = sh.llvm_label_id;
    sh.llvm_label_id = sh.llvm_label_id + 1;
    return id;
}

function sh_llvm_append_label(prefix: ascii[], id: i32): void {
    ascii_append(sh.ir_out, prefix);
    sh_ir_append_i32(sh.ir_out, id);
}

function sh_llvm_emit_label_def(prefix: ascii[], id: i32): void {
    sh_llvm_append_label(prefix, id);
    ascii_append(sh.ir_out, ":\n");
    sh.llvm_bb_terminated = 0;
}

function sh_llvm_emit_br(prefix: ascii[], id: i32): void {
    ascii_append(sh.ir_out, "  br label %");
    sh_llvm_append_label(prefix, id);
    ascii_append(sh.ir_out, "\n");
    sh.llvm_bb_terminated = 1;
}

function sh_llvm_emit_br_i1(cond_i1_id: i32, then_prefix: ascii[], then_id: i32, else_prefix: ascii[], else_id: i32): void {
    ascii_append(sh.ir_out, "  br i1 ");
    sh_llvm_append_tmp(cond_i1_id);
    ascii_append(sh.ir_out, ", label %");
    sh_llvm_append_label(then_prefix, then_id);
    ascii_append(sh.ir_out, ", label %");
    sh_llvm_append_label(else_prefix, else_id);
    ascii_append(sh.ir_out, "\n");
    sh.llvm_bb_terminated = 1;
}

function sh_llvm_emit_const_i32(v: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = add i32 0, ");
    sh_ir_append_i32(sh.ir_out, v);
    ascii_append(sh.ir_out, "\n");
    return id;
}

function sh_llvm_emit_load_local(local_id: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = load i32, ptr ");
    sh_llvm_append_local_ptr(local_id);
    ascii_append(sh.ir_out, ", align 4\n");
    return id;
}

function sh_llvm_emit_store_local(local_id: i32, value_id: i32): void {
    ascii_append(sh.ir_out, "  store i32 ");
    sh_llvm_append_tmp(value_id);
    ascii_append(sh.ir_out, ", ptr ");
    sh_llvm_append_local_ptr(local_id);
    ascii_append(sh.ir_out, ", align 4\n");
}

function sh_llvm_emit_load_ptr_from_local(local_id: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = load ptr, ptr ");
    sh_llvm_append_local_ptr(local_id);
    ascii_append(sh.ir_out, ", align 8\n");
    return id;
}

function sh_llvm_emit_gep0_local_i32(local_id: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = getelementptr inbounds i32, ptr ");
    sh_llvm_append_local_ptr(local_id);
    ascii_append(sh.ir_out, ", i32 0\n");
    return id;
}

function sh_llvm_emit_gep0_global(global_idx: i32, type_idx: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = getelementptr inbounds ");
    if (sh_llvm_emit_type(type_idx) != 0) {
        return -1;
    }
    ascii_append(sh.ir_out, ", ptr @");
    sh_llvm_append_global_ir_name(global_idx);
    ascii_append(sh.ir_out, ", i32 0\n");
    return id;
}

function sh_llvm_emit_load_i32_from_ptr(ptr_id: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = load i32, ptr ");
    sh_llvm_append_tmp(ptr_id);
    ascii_append(sh.ir_out, ", align 4\n");
    return id;
}

function sh_llvm_emit_load_i8_zext_from_ptr(ptr_id: i32): i32 {
    let id8: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id8);
    ascii_append(sh.ir_out, " = load i8, ptr ");
    sh_llvm_append_tmp(ptr_id);
    ascii_append(sh.ir_out, ", align 1\n");

    let id32: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id32);
    ascii_append(sh.ir_out, " = zext i8 ");
    sh_llvm_append_tmp(id8);
    ascii_append(sh.ir_out, " to i32\n");
    return id32;
}

function sh_llvm_emit_store_i32_to_ptr(ptr_id: i32, value_id: i32): void {
    ascii_append(sh.ir_out, "  store i32 ");
    sh_llvm_append_tmp(value_id);
    ascii_append(sh.ir_out, ", ptr ");
    sh_llvm_append_tmp(ptr_id);
    ascii_append(sh.ir_out, ", align 4\n");
}

function sh_llvm_emit_store_i8_trunc_to_ptr(ptr_id: i32, value_id: i32): void {
    let id8: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id8);
    ascii_append(sh.ir_out, " = trunc i32 ");
    sh_llvm_append_tmp(value_id);
    ascii_append(sh.ir_out, " to i8\n");

    ascii_append(sh.ir_out, "  store i8 ");
    sh_llvm_append_tmp(id8);
    ascii_append(sh.ir_out, ", ptr ");
    sh_llvm_append_tmp(ptr_id);
    ascii_append(sh.ir_out, ", align 1\n");
}

function sh_llvm_emit_gep_struct_field(base_ptr_id: i32, struct_idx: i32, field_rel: i32): i32 {
    let id: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id);
    ascii_append(sh.ir_out, " = getelementptr inbounds %");
    sh_llvm_append_struct_ir_name(struct_idx);
    ascii_append(sh.ir_out, ", ptr ");
    sh_llvm_append_tmp(base_ptr_id);
    ascii_append(sh.ir_out, ", i32 0, i32 ");
    sh_ir_append_i32(sh.ir_out, field_rel);
    ascii_append(sh.ir_out, "\n");
    return id;
}

function sh_llvm_ptr_kind_for_elem_type(file_idx: i32, at: i32, elem_type_idx: i32): i32 {
    if (sh_build_type_is_byte_named(elem_type_idx)) {
        sh.llvm_place_kind = ShLlvmValueKind.PtrI8;
        sh.llvm_place_struct_idx = -1;
        return 0;
    }
    if (sh_build_type_is_i32ish(elem_type_idx)) {
        sh.llvm_place_kind = ShLlvmValueKind.PtrI32;
        sh.llvm_place_struct_idx = -1;
        return 0;
    }

    let si: i32 = sh_build_find_struct_decl_for_type(elem_type_idx);
    if (si >= 0) {
        sh.llvm_place_kind = ShLlvmValueKind.PtrStruct;
        sh.llvm_place_struct_idx = si;
        return 0;
    }

    sh_build_err_at(file_idx, "unsupported array element type (llvm bring-up)", at);
    return 1;
}

function sh_llvm_decay_fixed_array_ptr(file_idx: i32, at: i32, array_ptr_id: i32, array_type_idx: i32): i32 {
    if (array_type_idx < 0 || array_type_idx >= sh.type_count) {
        return -1;
    }
    let kind: ShTypeKind = sh.types[array_type_idx].kind;
    if (kind != ShTypeKind.Array) {
        return -1;
    }
    if (sh.types[array_type_idx].size <= 0) {
        return -1;
    }

    let elem: i32 = sh.types[array_type_idx].elem;
    let header_bytes: i32 = sh_build_header_bytes_for_elem(elem);

    if (sh_llvm_ptr_kind_for_elem_type(file_idx, at, elem) != 0) {
        return -1;
    }

    // For ascii/utf8 arrays, we model the whole allocation as [N+header x i8] and decay to ptr i8 after the header.
    if (header_bytes != 0) {
        sh.llvm_place_kind = ShLlvmValueKind.PtrI8;
        sh.llvm_place_struct_idx = -1;
    }

    let elem0_ptr: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(elem0_ptr);
    ascii_append(sh.ir_out, " = getelementptr inbounds ");
    if (sh_llvm_emit_type(array_type_idx) != 0) {
        return -1;
    }
    ascii_append(sh.ir_out, ", ptr ");
    sh_llvm_append_tmp(array_ptr_id);
    ascii_append(sh.ir_out, ", i32 0, i32 0\n");

    let data_ptr: i32 = elem0_ptr;
    if (header_bytes != 0) {
        let data_ptr2: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(data_ptr2);
        ascii_append(sh.ir_out, " = getelementptr inbounds i8, ptr ");
        sh_llvm_append_tmp(elem0_ptr);
        ascii_append(sh.ir_out, ", i32 ");
        sh_ir_append_i32(sh.ir_out, header_bytes);
        ascii_append(sh.ir_out, "\n");
        data_ptr = data_ptr2;
    }

    return data_ptr;
}

function sh_llvm_emit_member_value_or_place(file_idx: i32, expr_idx: i32, mode: i32, base_id: i32, base_kind: ShLlvmValueKind, base_si: i32): i32 {
    sh.llvm_place_kind = ShLlvmValueKind.I32;
    sh.llvm_place_struct_idx = -1;

    if (base_kind != ShLlvmValueKind.PtrStruct || base_si < 0) {
        sh_build_err_at(file_idx, "member access on non-struct (llvm bring-up)", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    let field_rel: i32 = sh_build_find_struct_field(base_si, file_idx, sh.expr_nodes[expr_idx].name_start, sh.expr_nodes[expr_idx].name_len);
    if (field_rel < 0) {
        sh_build_err_at(file_idx, "unknown struct field", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    let field_ptr: i32 = sh_llvm_emit_gep_struct_field(base_id, base_si, field_rel);

    let field_abs: i32 = sh.structs[base_si].fields_off + field_rel;
    if (field_abs < 0 || field_abs >= sh.field_count) {
        sh_build_err_at(file_idx, "invalid struct field", sh.expr_nodes[expr_idx].at);
        return -1;
    }
    let field_ty: i32 = sh.fields[field_abs].type_idx;
    if (field_ty < 0 || field_ty >= sh.type_count) {
        sh_build_err_at(file_idx, "invalid struct field type", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    let fk: ShTypeKind = sh.types[field_ty].kind;
    if (fk == ShTypeKind.Named) {
        if (sh_build_type_is_byte_named(field_ty)) {
            if (mode == 0) {
                sh.llvm_place_kind = ShLlvmValueKind.I32;
                sh.llvm_place_struct_idx = -1;
                return sh_llvm_emit_load_i8_zext_from_ptr(field_ptr);
            }
            sh.llvm_place_kind = ShLlvmValueKind.I8;
            sh.llvm_place_struct_idx = -1;
            return field_ptr;
        }

        if (sh_build_type_is_i32ish(field_ty)) {
            sh.llvm_place_kind = ShLlvmValueKind.I32;
            sh.llvm_place_struct_idx = -1;
            if (mode == 0) {
                return sh_llvm_emit_load_i32_from_ptr(field_ptr);
            }
            return field_ptr;
        }

        let si2: i32 = sh_build_find_struct_decl_for_type(field_ty);
        if (si2 < 0) {
            sh_build_err_at(file_idx, "unsupported struct field type (llvm bring-up)", sh.expr_nodes[expr_idx].at);
            return -1;
        }
        sh.llvm_place_kind = ShLlvmValueKind.PtrStruct;
        sh.llvm_place_struct_idx = si2;
        return field_ptr;
    }

    if (fk == ShTypeKind.Array) {
        if (sh.types[field_ty].size == 0) {
            sh_build_err_at(file_idx, "slice fields not yet supported (llvm bring-up)", sh.expr_nodes[expr_idx].at);
            return -1;
        }
        return sh_llvm_decay_fixed_array_ptr(file_idx, sh.expr_nodes[expr_idx].at, field_ptr, field_ty);
    }

    sh_build_err_at(file_idx, "unsupported struct field type (llvm bring-up)", sh.expr_nodes[expr_idx].at);
    return -1;
}

function sh_llvm_emit_index_value_or_place(file_idx: i32, expr_idx: i32, mode: i32, base_id: i32, base_kind: ShLlvmValueKind, base_si: i32, index_id: i32, index_kind: ShLlvmValueKind): i32 {
    sh.llvm_place_kind = ShLlvmValueKind.I32;
    sh.llvm_place_struct_idx = -1;

    if (index_kind != ShLlvmValueKind.I32) {
        sh_build_err_at(file_idx, "invalid index (expected i32)", sh.expr_nodes[expr_idx].at);
        return -1;
    }

    if (base_kind == ShLlvmValueKind.PtrI8) {
        let elem_ptr: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(elem_ptr);
        ascii_append(sh.ir_out, " = getelementptr inbounds i8, ptr ");
        sh_llvm_append_tmp(base_id);
        ascii_append(sh.ir_out, ", i32 ");
        sh_llvm_append_tmp(index_id);
        ascii_append(sh.ir_out, "\n");

        if (mode == 0) {
            sh.llvm_place_kind = ShLlvmValueKind.I32;
            sh.llvm_place_struct_idx = -1;
            return sh_llvm_emit_load_i8_zext_from_ptr(elem_ptr);
        }
        sh.llvm_place_kind = ShLlvmValueKind.I8;
        sh.llvm_place_struct_idx = -1;
        return elem_ptr;
    }

    if (base_kind == ShLlvmValueKind.PtrI32) {
        let elem_ptr2: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(elem_ptr2);
        ascii_append(sh.ir_out, " = getelementptr inbounds i32, ptr ");
        sh_llvm_append_tmp(base_id);
        ascii_append(sh.ir_out, ", i32 ");
        sh_llvm_append_tmp(index_id);
        ascii_append(sh.ir_out, "\n");

        sh.llvm_place_kind = ShLlvmValueKind.I32;
        sh.llvm_place_struct_idx = -1;
        if (mode == 0) {
            return sh_llvm_emit_load_i32_from_ptr(elem_ptr2);
        }
        return elem_ptr2;
    }

    if (base_kind == ShLlvmValueKind.PtrStruct && base_si >= 0) {
        let elem_ptr3: i32 = sh_llvm_new_tmp();
        ascii_append(sh.ir_out, "  ");
        sh_llvm_append_tmp(elem_ptr3);
        ascii_append(sh.ir_out, " = getelementptr inbounds %");
        sh_llvm_append_struct_ir_name(base_si);
        ascii_append(sh.ir_out, ", ptr ");
        sh_llvm_append_tmp(base_id);
        ascii_append(sh.ir_out, ", i32 ");
        sh_llvm_append_tmp(index_id);
        ascii_append(sh.ir_out, "\n");

        sh.llvm_place_kind = ShLlvmValueKind.PtrStruct;
        sh.llvm_place_struct_idx = base_si;
        return elem_ptr3;
    }

    sh_build_err_at(file_idx, "indexing non-array pointer (llvm bring-up)", sh.expr_nodes[expr_idx].at);
    return -1;
}

function sh_llvm_emit_icmp_to_i32(pred: ascii[], a_id: i32, b_id: i32): i32 {
    let id_cmp: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id_cmp);
    ascii_append(sh.ir_out, " = icmp ");
    ascii_append(sh.ir_out, pred);
    ascii_append(sh.ir_out, " i32 ");
    sh_llvm_append_tmp(a_id);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(b_id);
    ascii_append(sh.ir_out, "\n");

    let id_z: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(id_z);
    ascii_append(sh.ir_out, " = zext i1 ");
    sh_llvm_append_tmp(id_cmp);
    ascii_append(sh.ir_out, " to i32\n");
    return id_z;
}

function sh_llvm_emit_logic_to_i32(op: ascii[], a_id: i32, b_id: i32): i32 {
    let zero_a: i32 = sh_llvm_emit_const_i32(0);
    let zero_b: i32 = zero_a;

    let a_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(a_i1);
    ascii_append(sh.ir_out, " = icmp ne i32 ");
    sh_llvm_append_tmp(a_id);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(zero_a);
    ascii_append(sh.ir_out, "\n");

    let b_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(b_i1);
    ascii_append(sh.ir_out, " = icmp ne i32 ");
    sh_llvm_append_tmp(b_id);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(zero_b);
    ascii_append(sh.ir_out, "\n");

    let out_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(out_i1);
    ascii_append(sh.ir_out, " = ");
    ascii_append(sh.ir_out, op);
    ascii_append(sh.ir_out, " i1 ");
    sh_llvm_append_tmp(a_i1);
    ascii_append(sh.ir_out, ", ");
    sh_llvm_append_tmp(b_i1);
    ascii_append(sh.ir_out, "\n");

    let out_i32: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(out_i32);
    ascii_append(sh.ir_out, " = zext i1 ");
    sh_llvm_append_tmp(out_i1);
    ascii_append(sh.ir_out, " to i32\n");
    return out_i32;
}

function sh_llvm_emit_expr_i1(file_idx: i32, root: i32): i32 {
    let v_i32: i32 = sh_llvm_emit_expr_i32(file_idx, root);
    if (v_i32 < 0) {
        return -1;
    }

    let out_i1: i32 = sh_llvm_new_tmp();
    ascii_append(sh.ir_out, "  ");
    sh_llvm_append_tmp(out_i1);
    ascii_append(sh.ir_out, " = icmp ne i32 ");
    sh_llvm_append_tmp(v_i32);
    ascii_append(sh.ir_out, ", 0\n");
    return out_i1;
}

function sh_llvm_emit_expr_i32_v1(file_idx: i32, root: i32): i32 {
    if (root < 0) {
        return -1;
    }

    let sp: i32 = 0;
    let val_len: i32 = 0;
    sh.parse_stack_start[sp] = root;
    sp = sp + 1;

    for (; sp > 0; ) {
        let top: i32 = sh.parse_stack_start[sp - 1];
        if (top >= 0) {
            sh.parse_stack_start[sp - 1] = -top - 1;

            let kind: ShExprKind = sh.expr_nodes[top].kind;
            if (kind == ShExprKind.Unary) {
                if (sp >= 4096) {
                    sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                    return -1;
                }
                sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                sp = sp + 1;
            } else {
                if (kind == ShExprKind.Call) {
                    let argc0: i32 = sh.expr_nodes[top].value;
                    let off0: i32 = sh.expr_nodes[top].right;
                    if (argc0 < 0) {
                        sh_build_err_at(file_idx, "invalid call argument count", sh.expr_nodes[top].at);
                        return -1;
                    }
                    if (sp + argc0 >= 4096) {
                        sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                        return -1;
                    }

                    let ai: i32 = 0;
                    for (ai = argc0 - 1; ai >= 0; ai = ai - 1) {
                        sh.parse_stack_start[sp] = sh.expr_call_args[off0 + ai];
                        sp = sp + 1;
                    }
                } else {
                if (kind == ShExprKind.Binary) {
                    if (sp + 1 >= 4096) {
                        sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                        return -1;
                    }
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].right;
                    sp = sp + 1;
                    sh.parse_stack_start[sp] = sh.expr_nodes[top].left;
                    sp = sp + 1;
                } else {
                    if (kind == ShExprKind.Assign) {
                        if (sp >= 4096) {
                            sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[top].at);
                            return -1;
                        }
                        sh.parse_stack_start[sp] = sh.expr_nodes[top].right;
                        sp = sp + 1;
                    }
                }
                }
            }
        } else {
            let idx: i32 = -top - 1;
            sp = sp - 1;

            if (val_len >= 4096) {
                sh_build_err_at(file_idx, "expression too complex (value stack)", sh.expr_nodes[idx].at);
                return -1;
            }

            let kind2: ShExprKind = sh.expr_nodes[idx].kind;
            if (kind2 == ShExprKind.IntLiteral || kind2 == ShExprKind.BoolLiteral) {
                sh.expr_op_at[val_len] = sh_llvm_emit_const_i32(sh.expr_nodes[idx].value);
                val_len = val_len + 1;
            } else {
                if (kind2 == ShExprKind.Call) {
                    let argc: i32 = sh.expr_nodes[idx].value;
                    let callee_expr: i32 = sh.expr_nodes[idx].left;

                    if (argc < 0 || val_len < argc) {
                        sh_build_err_at(file_idx, "invalid call expression", sh.expr_nodes[idx].at);
                        return -1;
                    }

                    let fn_idx0: i32 = sh_llvm_resolve_callee_func(file_idx, callee_expr, sh.expr_nodes[idx].at);
                    if (fn_idx0 < 0) {
                        return -1;
                    }
                    if (sh.funcs[fn_idx0].body_start < 0) {
                        sh_build_err_at(file_idx, "function has no body (call)", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (!sh_build_type_is_i32ish(sh.funcs[fn_idx0].ret_type_idx)) {
                        sh_build_err_at(file_idx, "unsupported call return type (expected i32)", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (sh.funcs[fn_idx0].params_len != argc) {
                        sh_build_err_at(file_idx, "call arg count mismatch", sh.expr_nodes[idx].at);
                        return -1;
                    }

                    let pi: i32 = 0;
                    for (pi = 0; pi < argc; pi = pi + 1) {
                        let p_decl: i32 = sh.funcs[fn_idx0].params_off + pi;
                        if (p_decl < 0 || p_decl >= sh.param_count) {
                            sh_build_err_at(file_idx, "invalid function parameters", sh.expr_nodes[idx].at);
                            return -1;
                        }
                        if (!sh_build_type_is_i32ish(sh.params[p_decl].type_idx)) {
                            sh_build_err_at(file_idx, "unsupported call arg type (expected i32)", sh.expr_nodes[idx].at);
                            return -1;
                        }
                    }

                    let arg_base: i32 = val_len - argc;
                    let out_id0: i32 = sh_llvm_new_tmp();
                    ascii_append(sh.ir_out, "  ");
                    sh_llvm_append_tmp(out_id0);
                    ascii_append(sh.ir_out, " = call i32 @");
                    sh_llvm_append_func_ir_name(fn_idx0);
                    ascii_append(sh.ir_out, "(");

                    let ai2: i32 = 0;
                    for (ai2 = 0; ai2 < argc; ai2 = ai2 + 1) {
                        if (ai2 != 0) {
                            ascii_append(sh.ir_out, ", ");
                        }
                        ascii_append(sh.ir_out, "i32 ");
                        sh_llvm_append_tmp(sh.expr_op_at[arg_base + ai2]);
                    }

                    ascii_append(sh.ir_out, ")\n");

                    val_len = arg_base;
                    sh.expr_op_at[val_len] = out_id0;
                    val_len = val_len + 1;
                } else {
                if (kind2 == ShExprKind.Name) {
                    let local_id: i32 = sh_llvm_find_local(file_idx, sh.expr_nodes[idx].name_start, sh.expr_nodes[idx].name_len);
                    if (local_id < 0) {
                        sh_build_err_at(file_idx, "unknown local", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (sh.llvm_local_declared[local_id] == 0) {
                        sh_build_err_at(file_idx, "local used before declaration", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    sh.expr_op_at[val_len] = sh_llvm_emit_load_local(local_id);
                    val_len = val_len + 1;
                } else {
                    if (kind2 == ShExprKind.Unary) {
                        if (val_len < 1) {
                            sh_build_err_at(file_idx, "invalid expression", sh.expr_nodes[idx].at);
                            return -1;
                        }
                        let v_id: i32 = sh.expr_op_at[val_len - 1];
                        val_len = val_len - 1;

                        let op: ShTok = sh.expr_nodes[idx].op;
                        let out_id: i32 = -1;
                        if (op == ShTok.UnaryMinus) {
                            let zero_id: i32 = sh_llvm_emit_const_i32(0);
                            out_id = sh_llvm_new_tmp();
                            ascii_append(sh.ir_out, "  ");
                            sh_llvm_append_tmp(out_id);
                            ascii_append(sh.ir_out, " = sub i32 ");
                            sh_llvm_append_tmp(zero_id);
                            ascii_append(sh.ir_out, ", ");
                            sh_llvm_append_tmp(v_id);
                            ascii_append(sh.ir_out, "\n");
                        } else {
                            if (op == ShTok.Bang) {
                                let zero_id2: i32 = sh_llvm_emit_const_i32(0);
                                out_id = sh_llvm_emit_icmp_to_i32("eq", v_id, zero_id2);
                            } else {
                                sh_build_err_at(file_idx, "unsupported unary operator", sh.expr_nodes[idx].at);
                                return -1;
                            }
                        }

                        sh.expr_op_at[val_len] = out_id;
                        val_len = val_len + 1;
                    } else {
                        if (kind2 == ShExprKind.Binary) {
                            if (val_len < 2) {
                                sh_build_err_at(file_idx, "invalid expression", sh.expr_nodes[idx].at);
                                return -1;
                            }
                            let b_id: i32 = sh.expr_op_at[val_len - 1];
                            let a_id: i32 = sh.expr_op_at[val_len - 2];
                            val_len = val_len - 2;

                            let op2: ShTok = sh.expr_nodes[idx].op;
                            let out2: i32 = -1;

                            if (op2 == ShTok.Plus || op2 == ShTok.Minus || op2 == ShTok.Star || op2 == ShTok.Slash || op2 == ShTok.Percent) {
                                out2 = sh_llvm_new_tmp();
                                ascii_append(sh.ir_out, "  ");
                                sh_llvm_append_tmp(out2);
                                ascii_append(sh.ir_out, " = ");
                                if (op2 == ShTok.Plus) { ascii_append(sh.ir_out, "add"); }
                                if (op2 == ShTok.Minus) { ascii_append(sh.ir_out, "sub"); }
                                if (op2 == ShTok.Star) { ascii_append(sh.ir_out, "mul"); }
                                if (op2 == ShTok.Slash) { ascii_append(sh.ir_out, "sdiv"); }
                                if (op2 == ShTok.Percent) { ascii_append(sh.ir_out, "srem"); }
                                ascii_append(sh.ir_out, " i32 ");
                                sh_llvm_append_tmp(a_id);
                                ascii_append(sh.ir_out, ", ");
                                sh_llvm_append_tmp(b_id);
                                ascii_append(sh.ir_out, "\n");
                            } else {
                                // Comparisons + logical.
                                let handled_cmp: i32 = 0;
                                if (op2 == ShTok.EqualEqual) { out2 = sh_llvm_emit_icmp_to_i32("eq", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.BangEqual) { out2 = sh_llvm_emit_icmp_to_i32("ne", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.Less) { out2 = sh_llvm_emit_icmp_to_i32("slt", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.LessEqual) { out2 = sh_llvm_emit_icmp_to_i32("sle", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.Greater) { out2 = sh_llvm_emit_icmp_to_i32("sgt", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.GreaterEqual) { out2 = sh_llvm_emit_icmp_to_i32("sge", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.AmpAmp) { out2 = sh_llvm_emit_logic_to_i32("and", a_id, b_id); handled_cmp = 1; }
                                if (op2 == ShTok.PipePipe) { out2 = sh_llvm_emit_logic_to_i32("or", a_id, b_id); handled_cmp = 1; }

                                if (handled_cmp == 0) {
                                    sh_build_err_at(file_idx, "unsupported operator", sh.expr_nodes[idx].at);
                                    return -1;
                                }
                            }

                            sh.expr_op_at[val_len] = out2;
                            val_len = val_len + 1;
                        } else {
                            if (kind2 == ShExprKind.Assign) {
                                if (val_len < 1) {
                                    sh_build_err_at(file_idx, "invalid assignment expression", sh.expr_nodes[idx].at);
                                    return -1;
                                }

                                let rhs_id: i32 = sh.expr_op_at[val_len - 1];
                                val_len = val_len - 1;

                                let lhs_idx: i32 = sh.expr_nodes[idx].left;
                                if (lhs_idx < 0) {
                                    sh_build_err_at(file_idx, "unsupported assignment target", sh.expr_nodes[idx].at);
                                    return -1;
                                }
                                let lhs_kind: ShExprKind = sh.expr_nodes[lhs_idx].kind;
                                if (lhs_kind != ShExprKind.Name) {
                                    sh_build_err_at(file_idx, "unsupported assignment target", sh.expr_nodes[idx].at);
                                    return -1;
                                }

                                let local_id2: i32 = sh_llvm_find_local(file_idx, sh.expr_nodes[lhs_idx].name_start, sh.expr_nodes[lhs_idx].name_len);
                                if (local_id2 < 0) {
                                    sh_build_err_at(file_idx, "unknown local", sh.expr_nodes[lhs_idx].at);
                                    return -1;
                                }
                                if (sh.llvm_local_declared[local_id2] == 0) {
                                    sh_build_err_at(file_idx, "local used before declaration", sh.expr_nodes[lhs_idx].at);
                                    return -1;
                                }

                                let aop: ShTok = sh.expr_nodes[idx].op;
                                if (aop == ShTok.Equal) {
                                    sh_llvm_emit_store_local(local_id2, rhs_id);
                                    sh.expr_op_at[val_len] = rhs_id;
                                    val_len = val_len + 1;
                                } else {
                                    // Compound assignment: load, apply op, store.
                                    let old_id: i32 = sh_llvm_emit_load_local(local_id2);
                                    let new_id: i32 = sh_llvm_new_tmp();

                                    ascii_append(sh.ir_out, "  ");
                                    sh_llvm_append_tmp(new_id);
                                    ascii_append(sh.ir_out, " = ");
                                    if (aop == ShTok.PlusEqual) { ascii_append(sh.ir_out, "add"); }
                                    if (aop == ShTok.MinusEqual) { ascii_append(sh.ir_out, "sub"); }
                                    if (aop == ShTok.StarEqual) { ascii_append(sh.ir_out, "mul"); }
                                    if (aop == ShTok.SlashEqual) { ascii_append(sh.ir_out, "sdiv"); }
                                    if (aop == ShTok.PercentEqual) { ascii_append(sh.ir_out, "srem"); }
                                    ascii_append(sh.ir_out, " i32 ");
                                    sh_llvm_append_tmp(old_id);
                                    ascii_append(sh.ir_out, ", ");
                                    sh_llvm_append_tmp(rhs_id);
                                    ascii_append(sh.ir_out, "\n");

                                    sh_llvm_emit_store_local(local_id2, new_id);
                                    sh.expr_op_at[val_len] = new_id;
                                    val_len = val_len + 1;
                                }
                            } else {
                                sh_build_err_at(file_idx, "unsupported expression", sh.expr_nodes[idx].at);
                                return -1;
                            }
                        }
                    }
                }
                }
            }
        }
    }

    if (val_len != 1) {
        sh_build_err_at(file_idx, "invalid expression", sh.expr_nodes[root].at);
        return -1;
    }
    return sh.expr_op_at[0];
}

function sh_llvm_emit_expr_i32(file_idx: i32, root: i32): i32 {
    return sh_llvm_emit_expr_i32_v2(file_idx, root);
}

function sh_llvm_emit_expr_i32_v2(file_idx: i32, root: i32): i32 {
    if (root < 0) {
        return -1;
    }

    // Stack entry: (node_idx * 2 + mode), mode: 0=value, 1=place.
    // Negative entries are "visited" (postorder).
    let sp: i32 = 0;
    let val_len: i32 = 0;
    sh.parse_stack_start[sp] = root * 2;
    sp = sp + 1;

    for (; sp > 0; ) {
        let enc: i32 = sh.parse_stack_start[sp - 1];
        if (enc >= 0) {
            sh.parse_stack_start[sp - 1] = -enc - 1;

            let idx: i32 = enc / 2;
            let mode: i32 = enc % 2;
            let kind: ShExprKind = sh.expr_nodes[idx].kind;

            if (kind == ShExprKind.Unary) {
                if (sp >= 4096) {
                    sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[idx].at);
                    return -1;
                }
                sh.parse_stack_start[sp] = sh.expr_nodes[idx].left * 2;
                sp = sp + 1;
            } else {
                if (kind == ShExprKind.Call) {
                    let argc0: i32 = sh.expr_nodes[idx].value;
                    let off0: i32 = sh.expr_nodes[idx].right;
                    if (argc0 < 0) {
                        sh_build_err_at(file_idx, "invalid call argument count", sh.expr_nodes[idx].at);
                        return -1;
                    }
                    if (sp + argc0 >= 4096) {
                        sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[idx].at);
                        return -1;
                    }

                    let ai: i32 = 0;
                    for (ai = argc0 - 1; ai >= 0; ai = ai - 1) {
                        sh.parse_stack_start[sp] = sh.expr_call_args[off0 + ai] * 2;
                        sp = sp + 1;
                    }
                } else {
                    if (kind == ShExprKind.Binary) {
                        if (sp + 1 >= 4096) {
                            sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[idx].at);
                            return -1;
                        }
                        sh.parse_stack_start[sp] = sh.expr_nodes[idx].right * 2;
                        sp = sp + 1;
                        sh.parse_stack_start[sp] = sh.expr_nodes[idx].left * 2;
                        sp = sp + 1;
                    } else {
                        if (kind == ShExprKind.Assign) {
                            if (sp + 1 >= 4096) {
                                sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[idx].at);
                                return -1;
                            }
                            // Evaluate lhs place first, then rhs value (deterministic).
                            sh.parse_stack_start[sp] = sh.expr_nodes[idx].right * 2;
                            sp = sp + 1;
                            sh.parse_stack_start[sp] = sh.expr_nodes[idx].left * 2 + 1;
                            sp = sp + 1;
                        } else {
                            if (kind == ShExprKind.Member) {
                                if (sp >= 4096) {
                                    sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[idx].at);
                                    return -1;
                                }
                                sh.parse_stack_start[sp] = sh.expr_nodes[idx].left * 2;
                                sp = sp + 1;
                            } else {
                                if (kind == ShExprKind.Index) {
                                    if (sp + 1 >= 4096) {
                                        sh_build_err_at(file_idx, "expression too complex (node stack)", sh.expr_nodes[idx].at);
                                        return -1;
                                    }
                                    // Evaluate base first, then index.
                                    sh.parse_stack_start[sp] = sh.expr_nodes[idx].right * 2;
                                    sp = sp + 1;
                                    sh.parse_stack_start[sp] = sh.expr_nodes[idx].left * 2;
                                    sp = sp + 1;
                                } else {
                                    if (mode != 0 && kind != ShExprKind.Name && kind != ShExprKind.Member && kind != ShExprKind.Index) {
                                        sh_build_err_at(file_idx, "invalid assignment target", sh.expr_nodes[idx].at);
                                        return -1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            let enc2: i32 = -enc - 1;
            let idx2: i32 = enc2 / 2;
            let mode2: i32 = enc2 % 2;
            sp = sp - 1;

            if (val_len >= 4096) {
                sh_build_err_at(file_idx, "expression too complex (value stack)", sh.expr_nodes[idx2].at);
                return -1;
            }

            let kind2: ShExprKind = sh.expr_nodes[idx2].kind;
            if (kind2 == ShExprKind.IntLiteral || kind2 == ShExprKind.BoolLiteral) {
                if (mode2 != 0) {
                    sh_build_err_at(file_idx, "invalid assignment target", sh.expr_nodes[idx2].at);
                    return -1;
                }
                sh.expr_op_at[val_len] = sh_llvm_emit_const_i32(sh.expr_nodes[idx2].value);
                sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                sh.llvm_val_struct_idx[val_len] = -1;
                val_len = val_len + 1;
            } else {
                if (kind2 == ShExprKind.StringLiteral) {
                    if (mode2 != 0) {
                        sh_build_err_at(file_idx, "invalid assignment target", sh.expr_nodes[idx2].at);
                        return -1;
                    }
                    let ptr_id: i32 = sh_llvm_emit_utf8_string_lit_ptr(file_idx, sh.expr_nodes[idx2].name_start, sh.expr_nodes[idx2].name_len);
                    if (ptr_id < 0) {
                        return -1;
                    }
                    sh.expr_op_at[val_len] = ptr_id;
                    sh.llvm_val_kind[val_len] = ShLlvmValueKind.PtrI8;
                    sh.llvm_val_struct_idx[val_len] = -1;
                    val_len = val_len + 1;
                } else {
                if (kind2 == ShExprKind.Call) {
                    if (mode2 != 0) {
                        sh_build_err_at(file_idx, "invalid assignment target", sh.expr_nodes[idx2].at);
                        return -1;
                    }

                    let argc: i32 = sh.expr_nodes[idx2].value;
                    let callee_expr: i32 = sh.expr_nodes[idx2].left;
                    if (argc < 0 || val_len < argc) {
                        sh_build_err_at(file_idx, "invalid call expression", sh.expr_nodes[idx2].at);
                        return -1;
                    }

                    let arg_base: i32 = val_len - argc;

                    // Intrinsics (llvm bring-up).
                    let handled_intr: i32 = 0;
                    let callee_kind2: ShExprKind = sh.expr_nodes[callee_expr].kind;
                    if (callee_kind2 == ShExprKind.Name) {
                        let cname_start: i32 = sh.expr_nodes[callee_expr].name_start;
                        let cname_len: i32 = sh.expr_nodes[callee_expr].name_len;

                        if (sh_span_eq(file_idx, cname_start, cname_len, "u8_to_i32")) {
                            handled_intr = 1;
                            if (argc != 1) {
                                sh_build_err_at(file_idx, "u8_to_i32 expects 1 argument", sh.expr_nodes[idx2].at);
                                return -1;
                            }
                            if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.I32) {
                                sh_build_err_at(file_idx, "u8_to_i32 expects i32 value (llvm bring-up)", sh.expr_nodes[idx2].at);
                                return -1;
                            }
                            let out_id: i32 = sh.expr_op_at[arg_base];
                            val_len = arg_base;
                            sh.expr_op_at[val_len] = out_id;
                            sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                            sh.llvm_val_struct_idx[val_len] = -1;
                            val_len = val_len + 1;
                        } else {
                            if (sh_span_eq(file_idx, cname_start, cname_len, "i32_to_u8_trunc")) {
                                handled_intr = 1;
                                if (argc != 1) {
                                    sh_build_err_at(file_idx, "i32_to_u8_trunc expects 1 argument", sh.expr_nodes[idx2].at);
                                    return -1;
                                }
                                if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.I32) {
                                    sh_build_err_at(file_idx, "i32_to_u8_trunc expects i32 value", sh.expr_nodes[idx2].at);
                                    return -1;
                                }

                                let in_id: i32 = sh.expr_op_at[arg_base];
                                let out_id2: i32 = sh_llvm_new_tmp();
                                ascii_append(sh.ir_out, "  ");
                                sh_llvm_append_tmp(out_id2);
                                ascii_append(sh.ir_out, " = and i32 ");
                                sh_llvm_append_tmp(in_id);
                                ascii_append(sh.ir_out, ", 255\n");

                                val_len = arg_base;
                                sh.expr_op_at[val_len] = out_id2;
                                sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                sh.llvm_val_struct_idx[val_len] = -1;
                                val_len = val_len + 1;
                            }
                        }
                    }

                    // Builtins (llvm bring-up).
                    if (handled_intr == 0 && callee_kind2 == ShExprKind.Name) {
                        let cname_start2: i32 = sh.expr_nodes[callee_expr].name_start;
                        let cname_len2: i32 = sh.expr_nodes[callee_expr].name_len;

                        if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_argc")) {
                            handled_intr = 1;
                            if (argc != 0) {
                                sh_build_err_at(file_idx, "sys_argc expects 0 arguments", sh.expr_nodes[idx2].at);
                                return -1;
                            }

                            let out_id0: i32 = sh_llvm_new_tmp();
                            ascii_append(sh.ir_out, "  ");
                            sh_llvm_append_tmp(out_id0);
                            ascii_append(sh.ir_out, " = call i32 @stasis_sys_argc()\n");

                            val_len = arg_base;
                            sh.expr_op_at[val_len] = out_id0;
                            sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                            sh.llvm_val_struct_idx[val_len] = -1;
                            val_len = val_len + 1;
                        } else {
                            if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_argv")) {
                                handled_intr = 1;
                                if (argc != 3) {
                                    sh_build_err_at(file_idx, "sys_argv expects 3 arguments", sh.expr_nodes[idx2].at);
                                    return -1;
                                }
                                if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.I32 || sh.llvm_val_kind[arg_base + 2] != ShLlvmValueKind.I32) {
                                    sh_build_err_at(file_idx, "sys_argv expects i32 arguments (idx, out_cap)", sh.expr_nodes[idx2].at);
                                    return -1;
                                }
                                if (sh.llvm_val_kind[arg_base + 1] != ShLlvmValueKind.PtrI8) {
                                    sh_build_err_at(file_idx, "sys_argv expects pointer argument (out)", sh.expr_nodes[idx2].at);
                                    return -1;
                                }

                                let out_id1: i32 = sh_llvm_new_tmp();
                                ascii_append(sh.ir_out, "  ");
                                sh_llvm_append_tmp(out_id1);
                                ascii_append(sh.ir_out, " = call i32 @stasis_sys_argv(i32 ");
                                sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                ascii_append(sh.ir_out, ", ptr ");
                                sh_llvm_append_tmp(sh.expr_op_at[arg_base + 1]);
                                ascii_append(sh.ir_out, ", i32 ");
                                sh_llvm_append_tmp(sh.expr_op_at[arg_base + 2]);
                                ascii_append(sh.ir_out, ")\n");

                                val_len = arg_base;
                                sh.expr_op_at[val_len] = out_id1;
                                sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                sh.llvm_val_struct_idx[val_len] = -1;
                                val_len = val_len + 1;
                            } else {
                                if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_read_file")) {
                                    handled_intr = 1;
                                    if (argc != 3) {
                                        sh_build_err_at(file_idx, "sys_read_file expects 3 arguments", sh.expr_nodes[idx2].at);
                                        return -1;
                                    }
                                    if (sh.llvm_val_kind[arg_base + 2] != ShLlvmValueKind.I32) {
                                        sh_build_err_at(file_idx, "sys_read_file expects i32 argument (out_cap)", sh.expr_nodes[idx2].at);
                                        return -1;
                                    }
                                    if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8 || sh.llvm_val_kind[arg_base + 1] != ShLlvmValueKind.PtrI8) {
                                        sh_build_err_at(file_idx, "sys_read_file expects pointer arguments (path, out)", sh.expr_nodes[idx2].at);
                                        return -1;
                                    }

                                    let out_id2: i32 = sh_llvm_new_tmp();
                                    ascii_append(sh.ir_out, "  ");
                                    sh_llvm_append_tmp(out_id2);
                                    ascii_append(sh.ir_out, " = call i32 @stasis_sys_read_file(ptr ");
                                    sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                    ascii_append(sh.ir_out, ", ptr ");
                                    sh_llvm_append_tmp(sh.expr_op_at[arg_base + 1]);
                                    ascii_append(sh.ir_out, ", i32 ");
                                    sh_llvm_append_tmp(sh.expr_op_at[arg_base + 2]);
                                    ascii_append(sh.ir_out, ")\n");

                                    val_len = arg_base;
                                    sh.expr_op_at[val_len] = out_id2;
                                    sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                    sh.llvm_val_struct_idx[val_len] = -1;
                                    val_len = val_len + 1;
                                } else {
                                    if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_write_file")) {
                                        handled_intr = 1;
                                        if (argc != 3) {
                                            sh_build_err_at(file_idx, "sys_write_file expects 3 arguments", sh.expr_nodes[idx2].at);
                                            return -1;
                                        }
                                        if (sh.llvm_val_kind[arg_base + 2] != ShLlvmValueKind.I32) {
                                            sh_build_err_at(file_idx, "sys_write_file expects i32 argument (len)", sh.expr_nodes[idx2].at);
                                            return -1;
                                        }
                                        if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8 || sh.llvm_val_kind[arg_base + 1] != ShLlvmValueKind.PtrI8) {
                                            sh_build_err_at(file_idx, "sys_write_file expects pointer arguments (path, data)", sh.expr_nodes[idx2].at);
                                            return -1;
                                        }

                                        let out_id3: i32 = sh_llvm_new_tmp();
                                        ascii_append(sh.ir_out, "  ");
                                        sh_llvm_append_tmp(out_id3);
                                        ascii_append(sh.ir_out, " = call i32 @stasis_sys_write_file(ptr ");
                                        sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                        ascii_append(sh.ir_out, ", ptr ");
                                        sh_llvm_append_tmp(sh.expr_op_at[arg_base + 1]);
                                        ascii_append(sh.ir_out, ", i32 ");
                                        sh_llvm_append_tmp(sh.expr_op_at[arg_base + 2]);
                                        ascii_append(sh.ir_out, ")\n");

                                        val_len = arg_base;
                                        sh.expr_op_at[val_len] = out_id3;
                                        sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                        sh.llvm_val_struct_idx[val_len] = -1;
                                        val_len = val_len + 1;
                                    } else {
                                        if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_file_exists")) {
                                            handled_intr = 1;
                                            if (argc != 1) {
                                                sh_build_err_at(file_idx, "sys_file_exists expects 1 argument", sh.expr_nodes[idx2].at);
                                                return -1;
                                            }
                                            if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8) {
                                                sh_build_err_at(file_idx, "sys_file_exists expects pointer argument (path)", sh.expr_nodes[idx2].at);
                                                return -1;
                                            }

                                            let out_id4: i32 = sh_llvm_new_tmp();
                                            ascii_append(sh.ir_out, "  ");
                                            sh_llvm_append_tmp(out_id4);
                                            ascii_append(sh.ir_out, " = call i32 @stasis_sys_file_exists(ptr ");
                                            sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                            ascii_append(sh.ir_out, ")\n");

                                            val_len = arg_base;
                                            sh.expr_op_at[val_len] = out_id4;
                                            sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                            sh.llvm_val_struct_idx[val_len] = -1;
                                            val_len = val_len + 1;
                                        } else {
                                            if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_file_size")) {
                                                handled_intr = 1;
                                                if (argc != 1) {
                                                    sh_build_err_at(file_idx, "sys_file_size expects 1 argument", sh.expr_nodes[idx2].at);
                                                    return -1;
                                                }
                                                if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8) {
                                                    sh_build_err_at(file_idx, "sys_file_size expects pointer argument (path)", sh.expr_nodes[idx2].at);
                                                    return -1;
                                                }

                                                let out_id5: i32 = sh_llvm_new_tmp();
                                                ascii_append(sh.ir_out, "  ");
                                                sh_llvm_append_tmp(out_id5);
                                                ascii_append(sh.ir_out, " = call i32 @stasis_sys_file_size(ptr ");
                                                sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                                ascii_append(sh.ir_out, ")\n");

                                                val_len = arg_base;
                                                sh.expr_op_at[val_len] = out_id5;
                                                sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                                sh.llvm_val_struct_idx[val_len] = -1;
                                                val_len = val_len + 1;
                                            } else {
                                                if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_file_mtime_ms")) {
                                                    handled_intr = 1;
                                                    if (argc != 1) {
                                                        sh_build_err_at(file_idx, "sys_file_mtime_ms expects 1 argument", sh.expr_nodes[idx2].at);
                                                        return -1;
                                                    }
                                                    if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8) {
                                                        sh_build_err_at(file_idx, "sys_file_mtime_ms expects pointer argument (path)", sh.expr_nodes[idx2].at);
                                                        return -1;
                                                    }

                                                    let out_id6: i32 = sh_llvm_new_tmp();
                                                    ascii_append(sh.ir_out, "  ");
                                                    sh_llvm_append_tmp(out_id6);
                                                    ascii_append(sh.ir_out, " = call i32 @stasis_sys_file_mtime_ms(ptr ");
                                                    sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                                    ascii_append(sh.ir_out, ")\n");

                                                    val_len = arg_base;
                                                    sh.expr_op_at[val_len] = out_id6;
                                                    sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                                    sh.llvm_val_struct_idx[val_len] = -1;
                                                    val_len = val_len + 1;
                                                } else {
                                                    if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_exec")) {
                                                        handled_intr = 1;
                                                        if (argc != 1) {
                                                            sh_build_err_at(file_idx, "sys_exec expects 1 argument", sh.expr_nodes[idx2].at);
                                                            return -1;
                                                        }
                                                        if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8) {
                                                            sh_build_err_at(file_idx, "sys_exec expects pointer argument (command)", sh.expr_nodes[idx2].at);
                                                            return -1;
                                                        }

                                                        let out_id7: i32 = sh_llvm_new_tmp();
                                                        ascii_append(sh.ir_out, "  ");
                                                        sh_llvm_append_tmp(out_id7);
                                                        ascii_append(sh.ir_out, " = call i32 @stasis_sys_exec(ptr ");
                                                        sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                                        ascii_append(sh.ir_out, ")\n");

                                                        val_len = arg_base;
                                                        sh.expr_op_at[val_len] = out_id7;
                                                        sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                                        sh.llvm_val_struct_idx[val_len] = -1;
                                                        val_len = val_len + 1;
                                                    } else {
                                                        if (sh_span_eq(file_idx, cname_start2, cname_len2, "sys_sleep_ms")) {
                                                            handled_intr = 1;
                                                            if (argc != 1) {
                                                                sh_build_err_at(file_idx, "sys_sleep_ms expects 1 argument", sh.expr_nodes[idx2].at);
                                                                return -1;
                                                            }
                                                            if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.I32) {
                                                                sh_build_err_at(file_idx, "sys_sleep_ms expects i32 argument (ms)", sh.expr_nodes[idx2].at);
                                                                return -1;
                                                            }

                                                            let out_id8: i32 = sh_llvm_new_tmp();
                                                            ascii_append(sh.ir_out, "  ");
                                                            sh_llvm_append_tmp(out_id8);
                                                            ascii_append(sh.ir_out, " = call i32 @stasis_sys_sleep_ms(i32 ");
                                                            sh_llvm_append_tmp(sh.expr_op_at[arg_base]);
                                                            ascii_append(sh.ir_out, ")\n");

                                                            val_len = arg_base;
                                                            sh.expr_op_at[val_len] = out_id8;
                                                            sh.llvm_val_kind[val_len] = ShLlvmValueKind.I32;
                                                            sh.llvm_val_struct_idx[val_len] = -1;
                                                            val_len = val_len + 1;
                                                        } else {
                                                            if (sh_span_eq(file_idx, cname_start2, cname_len2, "print_string") || sh_span_eq(file_idx, cname_start2, cname_len2, "print")) {
                                                                handled_intr = 1;
                                                                if (argc != 1) {
                                                                    sh_build_err_at(file_idx, "print_string expects 1 argument", sh.expr_nodes[idx2].at);
                                                                    return -1;
                                                                }
                                                                if (sh.llvm_val_kind[arg_base] != ShLlvmValueKind.PtrI8) {
                                                                    sh_build_err_at(file_idx, "print_string expects pointer argument (utf8/ascii)", sh.expr_nodes[idx2].at);
                                                                    return -1;
                                                                }

                                                                let fmt_ptr: i32 = sh_llvm_new_tmp();
                                                                ascii_append(sh.ir_out, "  ");
                                                                sh_llvm_append_tmp(fmt_ptr);
