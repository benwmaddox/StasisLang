import "../stdlib/stdlib.stasis";
import "state.stasis";
import "lexing.stasis";
import "diagnostics.stasis";
import "expr_parse.stasis";
import "emit_ir.stasis";
import "build_ir_common.stasis";
import "build_ir_llvm_strings.stasis";
import "build_ir_llvm_resolve.stasis";
import "build_ir_llvm_types.stasis";
import "build_ir_llvm_builder.stasis";
import "build_ir_llvm_expr_shared.stasis";
import "build_ir_llvm_expr_v2_call_user.stasis";
import "build_ir_llvm_expr_v2_post.stasis";
import "build_ir_llvm_expr_v2.stasis";
import "build_ir_llvm_emit_main.stasis";
import "build_ir_llvm_emit_func.stasis";

function llvm_try_emit_math_intrinsic(file_idx: i32, idx2: i32, argc: i32, arg_base: i32, val_len: i32, cname_start: i32, cname_len: i32): i32 {
    // Returns:
    //  -2: not handled
    //  -1: error
    // >=0: new value stack len

    let want_sin: i32 = 0;
    let want_cos: i32 = 0;

    if (span_eq(file_idx, cname_start, cname_len, "sin_fast") || span_eq(file_idx, cname_start, cname_len, "sin")) {
        want_sin = 1;
    } else {
        if (span_eq(file_idx, cname_start, cname_len, "cos_fast") || span_eq(file_idx, cname_start, cname_len, "cos")) {
            want_cos = 1;
        } else {
            return -2;
        }
    }

    if (argc != 1) {
        build_err_at(file_idx, "trig builtin expects 1 argument", stasis.expr_nodes[idx2].at);
        return -1;
    }
    if (stasis.llvm_val_kind[arg_base] != LlvmValueKind.F32) {
        build_err_at(file_idx, "trig builtin expects f32 argument", stasis.expr_nodes[idx2].at);
        return -1;
    }

    let out_id: i32 = llvm_new_tmp();
    ascii_append(stasis.ir_out, "  ");
    llvm_append_tmp(out_id);
    if (want_sin != 0) {
        ascii_append(stasis.ir_out, " = call float @llvm.sin.f32(float ");
    } else {
        ascii_append(stasis.ir_out, " = call float @llvm.cos.f32(float ");
    }
    llvm_append_tmp(stasis.expr_op_at[arg_base]);
    ascii_append(stasis.ir_out, ")\n");

    val_len = arg_base;
    stasis.expr_op_at[val_len] = out_id;
    stasis.llvm_val_kind[val_len] = LlvmValueKind.F32;
    stasis.llvm_val_struct_idx[val_len] = -1;
    return val_len + 1;
}
