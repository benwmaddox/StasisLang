import "../stdlib/stdlib.stasis";
import "state.stasis";
import "imports.stasis";
import "lexing.stasis";

const SH_SYM_CAP: i32 = 20000;
const SH_SYM_POOL_CAP: i32 = 200000;
const SH_SIG_ERR_PRINT_CAP: i32 = 16;

function sh_sig_print_tok_text(): void {
    let i: i32 = 0;
    for (i = 0; i < sh.tok_len; i = i + 1) {
        let b: u8 = sh.pool[sh.lex_base + sh.tok_start + i];
        print_char(u8_to_i32(b));
    }
}

function sh_sig_print_err_at(file_idx: i32, msg: ascii[], at: i32): void {
    if (sh.quiet != 0) {
        return;
    }
    if (SH_SIG_ERR_PRINT_CAP > 0 && sh.lex_error_printed >= SH_SIG_ERR_PRINT_CAP) {
        return;
    }

    if (!sh_copy_file_path(sh.sig_path, file_idx)) {
        ascii_copy(sh.sig_path, "<unknown>");
    }

    print_string("error: ");
    print_string(msg);
    print_string(": ");
    print_string(sh.sig_path);
    print_char(58); // ':'
    print_int(at);
    print_char(10);
    sh.lex_error_printed = sh.lex_error_printed + 1;
}

function sh_sig_print_dup_err(file_idx: i32): void {
    if (sh.quiet != 0) {
        return;
    }
    if (SH_SIG_ERR_PRINT_CAP > 0 && sh.lex_error_printed >= SH_SIG_ERR_PRINT_CAP) {
        return;
    }

    if (!sh_copy_file_path(sh.sig_path, file_idx)) {
        ascii_copy(sh.sig_path, "<unknown>");
    }

    print_string("error: duplicate top-level symbol '");
    sh_sig_print_tok_text();
    print_string("': ");
    print_string(sh.sig_path);
    print_char(58); // ':'
    print_int(sh.tok_start);
    print_char(10);
    sh.lex_error_printed = sh.lex_error_printed + 1;
}

function sh_sig_sym_eq_tok(sym_idx: i32): bool {
    if (sym_idx < 0 || sym_idx >= sh.sym_count) {
        return false;
    }
    let len: i32 = sh.syms[sym_idx].name_len;
    if (len != sh.tok_len) {
        return false;
    }

    let off: i32 = sh.syms[sym_idx].name_off;
    let i: i32 = 0;
    for (i = 0; i < len; i = i + 1) {
        if (sh.sym_pool[off + i] != sh.pool[sh.lex_base + sh.tok_start + i]) {
            return false;
        }
    }
    return true;
}

function sh_sig_add_sym(file_idx: i32, kind: ShSymKind, is_exported: i32): bool {
    if (sh.sym_count >= SH_SYM_CAP) {
        sh_sig_print_err_at(file_idx, "exceeded symbol capacity", sh.tok_start);
        return false;
    }
    if (sh.sym_pool_len + sh.tok_len + 1 > SH_SYM_POOL_CAP) {
        sh_sig_print_err_at(file_idx, "exceeded symbol name pool capacity", sh.tok_start);
        return false;
    }

    let start: i32 = sh.files[file_idx].syms_off;
    let n: i32 = sh.files[file_idx].syms_len;
    let i: i32 = 0;
    for (i = 0; i < n; i = i + 1) {
        if (sh_sig_sym_eq_tok(start + i)) {
            sh_sig_print_dup_err(file_idx);
            return false;
        }
    }

    let name_off: i32 = sh.sym_pool_len;
    for (i = 0; i < sh.tok_len; i = i + 1) {
        sh.sym_pool[name_off + i] = sh.pool[sh.lex_base + sh.tok_start + i];
    }
    sh.sym_pool[name_off + sh.tok_len] = 0;
    sh.sym_pool_len = sh.sym_pool_len + sh.tok_len + 1;

    let idx: i32 = sh.sym_count;
    sh.sym_count = sh.sym_count + 1;
    sh.files[file_idx].syms_len = sh.files[file_idx].syms_len + 1;

    sh.syms[idx].kind = kind;
    sh.syms[idx].file_idx = file_idx;
    sh.syms[idx].name_off = name_off;
    sh.syms[idx].name_len = sh.tok_len;
    sh.syms[idx].name_at = sh.tok_start;
    sh.syms[idx].is_exported = is_exported;
    return true;
}

function sh_sig_scan_file(file_idx: i32): i32 {
    sh.files[file_idx].syms_off = sh.sym_count;
    sh.files[file_idx].syms_len = 0;

    if (!sh_lex_begin(file_idx)) {
        sh_sig_print_err_at(file_idx, "failed to start lexer", 0);
        return 1;
    }

    // Avoid duplicate lexer diagnostics when `check` has already lexed these files.
    sh.lex_quiet = 1;
    sh.lex_error_printed = 0;

    let errors: i32 = 0;
    let brace_depth: i32 = 0;
    let export_pending: i32 = 0;

    let done: i32 = 0;
    for (; done == 0; ) {
        let k: ShTok = sh_lex_next_kind();
        if (k == ShTok.Eof) {
            done = 1;
        } else {
            if (k == ShTok.LBrace) {
                brace_depth = brace_depth + 1;
            } else {
                if (k == ShTok.RBrace) {
                    brace_depth = brace_depth - 1;
                } else {
                    if (brace_depth == 0) {
                        if (k == ShTok.ImportKeyword) {
                            // The import graph was already loaded by `sh_load_graph`. Ignore the decl here.
                            export_pending = 0;
                        } else {
                            if (k == ShTok.ExportKeyword) {
                                export_pending = 1;
                            } else {
                                if (k == ShTok.StructKeyword) {
                                    let nk: ShTok = sh_lex_next_kind();
                                    if (nk != ShTok.Identifier) {
                                        errors = errors + 1;
                                        sh_sig_print_err_at(file_idx, "expected struct name", sh.tok_start);
                                    } else {
                                        if (!sh_sig_add_sym(file_idx, ShSymKind.Struct, 0)) {
                                            errors = errors + 1;
                                        }
                                    }
                                    export_pending = 0;
                                } else {
                                    if (k == ShTok.EnumKeyword) {
                                        let nk: ShTok = sh_lex_next_kind();
                                        if (nk != ShTok.Identifier) {
                                            errors = errors + 1;
                                            sh_sig_print_err_at(file_idx, "expected enum name", sh.tok_start);
                                        } else {
                                            if (!sh_sig_add_sym(file_idx, ShSymKind.Enum, 0)) {
                                                errors = errors + 1;
                                            }
                                        }
                                        export_pending = 0;
                                    } else {
                                        if (k == ShTok.GlobalKeyword) {
                                            let nk: ShTok = sh_lex_next_kind();
                                            if (nk != ShTok.Identifier) {
                                                errors = errors + 1;
                                                sh_sig_print_err_at(file_idx, "expected global name", sh.tok_start);
                                            } else {
                                                if (!sh_sig_add_sym(file_idx, ShSymKind.Global, 0)) {
                                                    errors = errors + 1;
                                                }
                                            }
                                            export_pending = 0;
                                        } else {
                                            if (k == ShTok.ConstKeyword) {
                                                let nk: ShTok = sh_lex_next_kind();
                                                if (nk != ShTok.Identifier) {
                                                    errors = errors + 1;
                                                    sh_sig_print_err_at(file_idx, "expected const name", sh.tok_start);
                                                } else {
                                                    if (!sh_sig_add_sym(file_idx, ShSymKind.Const, 0)) {
                                                        errors = errors + 1;
                                                    }
                                                }
                                                export_pending = 0;
                                            } else {
                                                if (k == ShTok.FunctionKeyword) {
                                                    let nk: ShTok = sh_lex_next_kind();
                                                    let attr_ok: i32 = 1;
                                                    for (; nk == ShTok.At && attr_ok != 0; ) {
                                                        nk = sh_lex_next_kind();
                                                        if (nk != ShTok.Identifier) {
                                                            errors = errors + 1;
                                                            sh_sig_print_err_at(file_idx, "expected attribute name after '@'", sh.tok_start);
                                                            attr_ok = 0;
                                                        } else {
                                                            nk = sh_lex_next_kind();
                                                        }
                                                    }

                                                    if (attr_ok != 0) {
                                                        if (nk != ShTok.Identifier) {
                                                            errors = errors + 1;
                                                            sh_sig_print_err_at(file_idx, "expected function name", sh.tok_start);
                                                        } else {
                                                            if (!sh_sig_add_sym(file_idx, ShSymKind.Function, export_pending)) {
                                                                errors = errors + 1;
                                                            }
                                                        }
                                                    }
                                                    export_pending = 0;
                                                } else {
                                                    if (k == ShTok.TestKeyword) {
                                                        let nk: ShTok = sh_lex_next_kind();
                                                        if (nk != ShTok.Identifier && nk != ShTok.BacktickLiteral) {
                                                            errors = errors + 1;
                                                            sh_sig_print_err_at(file_idx, "expected test name", sh.tok_start);
                                                        } else {
                                                            if (!sh_sig_add_sym(file_idx, ShSymKind.Test, 0)) {
                                                                errors = errors + 1;
                                                            }
                                                        }
                                                        export_pending = 0;
                                                    } else {
                                                        // Any other top-level token is ignored here (full parser will handle errors later).
                                                        export_pending = 0;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return errors;
}

function sh_sig_scan_loaded_files(): i32 {
    sh.sym_pool_len = 0;
    sh.sym_count = 0;

    let errors: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < sh.file_count; i = i + 1) {
        errors = errors + sh_sig_scan_file(i);
    }
    return errors;
}
