import "../stdlib/stdlib.stasis";
import "imports.stasis";

global sh_cmd: ascii[64];
global sh_arg_entry: ascii[260];
global sh_arg_out: ascii[260];

function sh_usage(): void {
    print_string("stasisc-self (WIP self-hosted compiler)\n");
    print_string("\n");
    print_string("usage:\n");
    print_string("  stasisc-self expand <entry.stasis> <out.stasis>\n");
    print_string("\n");
    print_string("notes:\n");
    print_string("  - This CLI is under active development on branch self-host.\n");
    print_string("  - Current stage focuses on import expansion + frontend bring-up.\n");
}

function sh_read_arg(idx: i32, out: ascii[], cap: i32): bool {
    let n: i32 = sys_argv(idx, out, cap);
    if (n <= 0) {
        return false;
    }
    ascii_set_len(out, n);
    return true;
}

function main(): i32 {
    let argc: i32 = sys_argc();
    if (argc < 2) {
        sh_usage();
        return 1;
    }

    if (!sh_read_arg(1, sh_cmd, 64)) {
        print_string("error: failed to read argv[1]\n");
        return 1;
    }

    if (ascii_eq(sh_cmd, "help") || ascii_eq(sh_cmd, "-h") || ascii_eq(sh_cmd, "--help")) {
        sh_usage();
        return 0;
    }

    if (ascii_eq(sh_cmd, "expand")) {
        if (argc != 4) {
            print_string("error: expand expects 2 arguments\n");
            sh_usage();
            return 1;
        }
        if (!sh_read_arg(2, sh_arg_entry, 260)) {
            print_string("error: failed to read <entry.stasis>\n");
            return 1;
        }
        if (!sh_read_arg(3, sh_arg_out, 260)) {
            print_string("error: failed to read <out.stasis>\n");
            return 1;
        }
        return sh_expand_entry(sh_arg_entry, sh_arg_out);
    }

    print_string("error: unknown command: ");
    print_string(sh_cmd);
    print_char(10);
    sh_usage();
    return 1;
}
