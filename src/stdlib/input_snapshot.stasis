// Standardized input snapshot for tests and simple samples.
// Keep this struct in stdlib so multiple fixtures can share it.

const INPUT_MAX_KEYS: i32 = 512;
const INPUT_MAX_POINTERS: i32 = 8;

struct InputSnapshot {
    key_down: bool[512];
    key_went_down: bool[512];
    key_went_up: bool[512];

    pointer_count: i32;
    pointer_id: i32[8];
    pointer_x_px: i32[8];
    pointer_y_px: i32[8];
    pointer_is_down: bool[8];
    pointer_went_down: bool[8];
    pointer_went_up: bool[8];

    mouse_x_px: i32;
    mouse_y_px: i32;
    mouse_down: bool;
    mouse_clicked: bool;
}
