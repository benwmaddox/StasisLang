// Game math helpers (not loaded by default).

function game_abs_i32(x: i32): i32 {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

function game_abs_f32(x: f32): f32 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

function game_min_i32(a: i32, b: i32): i32 {
    if (a < b) { return a; }
    return b;
}

function game_max_i32(a: i32, b: i32): i32 {
    if (a > b) { return a; }
    return b;
}

function game_min_f32(a: f32, b: f32): f32 {
    if (a < b) { return a; }
    return b;
}

function game_max_f32(a: f32, b: f32): f32 {
    if (a > b) { return a; }
    return b;
}

function game_clamp_i32(x: i32, lo: i32, hi: i32): i32 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

function game_clamp_f32(x: f32, lo: f32, hi: f32): f32 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

function game_lerp_f32(a: f32, b: f32, t: f32): f32 {
    return a + (b - a) * t;
}

// Deterministic RNG (LCG).
//
// Pass `state` as `i32[1]` so games can keep RNG state in global memory.
function game_rng_seed(state: i32[], seed: i32): void {
    state[0] = seed;
}

function game_rng_next(state: i32[]): i32 {
    state[0] = state[0] * 1103515245 + 12345;
    return state[0];
}

function game_rng_range_i32(state: i32[], min_incl: i32, max_incl: i32): i32 {
    let r: i32 = game_rng_next(state);
    if (r < 0) {
        r = 0 - r;
    }

    let span: i32 = (max_incl - min_incl) + 1;
    if (span <= 1) {
        return min_incl;
    }
    return min_incl + (r % span);
}

function game_rng_f32_01(state: i32[]): f32 {
    let v: i32 = game_rng_range_i32(state, 0, 255);
    return i32_to_f32(v) / 255.0;
}

function game_rng_range_f32(state: i32[], min_incl: f32, max_incl: f32): f32 {
    return min_incl + game_rng_f32_01(state) * (max_incl - min_incl);
}

