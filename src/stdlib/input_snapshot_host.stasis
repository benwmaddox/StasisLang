// HostFrame -> InputSnapshot helpers for graphics runtime.
// Keeps snapshot data in guest memory for deterministic usage.

import "../host_frame.stasis";
import "memory.stasis";
import "input_snapshot.stasis";

function input_snapshot_read_keys_from_snapshot(prev_keys: i32[512], snapshot_i32: i32[768], key_down: i32[512], key_went_down: i32[512], key_went_up: i32[512]): void {
    let i: i32 = 0;
    for (i = 0; i < INPUT_MAX_KEYS; i = i + 1) {
        let down: i32 = snapshot_i32[HOST_I_KEY_BASE + i];
        key_down[i] = down;
        key_went_down[i] = 0;
        if (down != 0 && prev_keys[i] == 0) { key_went_down[i] = 1; }
        key_went_up[i] = 0;
        if (down == 0 && prev_keys[i] != 0) { key_went_up[i] = 1; }
    }
}

function input_snapshot_read_pointers_from_snapshot(snapshot_i32: i32[768], snapshot_f32: f32[64], pointer_id: i32[8], pointer_x_px: f32[8], pointer_y_px: f32[8], pointer_is_down: i32[8], pointer_went_down: i32[8], pointer_went_up: i32[8]): i32 {
    let count: i32 = snapshot_i32[HOST_I_POINTER_COUNT];
    if (count < 0) { count = 0; }
    if (count > INPUT_MAX_POINTERS) { count = INPUT_MAX_POINTERS; }

    let i: i32 = 0;
    let i_base: i32 = 0;
    let f_base: i32 = 0;
    for (i = 0; i < INPUT_MAX_POINTERS; i = i + 1) {
        if (i < count) {
            i_base = HOST_I_POINTER_BASE + i * HOST_I_POINTER_STRIDE;
            f_base = HOST_F_POINTER_BASE + i * HOST_F_POINTER_STRIDE;
            pointer_id[i] = snapshot_i32[i_base + 0];
            pointer_is_down[i] = snapshot_i32[i_base + 1];
            pointer_went_down[i] = snapshot_i32[i_base + 2];
            pointer_went_up[i] = snapshot_i32[i_base + 3];
            pointer_x_px[i] = snapshot_f32[f_base + 0];
            pointer_y_px[i] = snapshot_f32[f_base + 1];
        } else {
            pointer_id[i] = -1;
            pointer_x_px[i] = 0.0;
            pointer_y_px[i] = 0.0;
            pointer_is_down[i] = 0;
            pointer_went_down[i] = 0;
            pointer_went_up[i] = 0;
        }
    }
    return count;
}

function input_snapshot_commit_prev_keys_from_snapshot(prev_keys: i32[512], snapshot_i32: i32[768]): void {
    mem_copy_i32(prev_keys, INPUT_MAX_KEYS, 0, snapshot_i32, HOST_I32_COUNT, HOST_I_KEY_BASE, INPUT_MAX_KEYS);
}
