enum AdState {
    Idle,
    Requesting,
    Playing,
    Finished,
    Failed,
    Unavailable,
    Loading,
}

enum AdKind {
    Midgame,
    Rewarded,
}

enum AdBeginResult {
    Accepted,
    Unavailable,
    Busy,
    Capacity,
    HandleOpen,
}

struct AdTask {
    handle: i32;
    state: AdState;
}

function @internal @effects(platform)@extern("stasis_jit_ad_request") ad_task_request_raw(kind: i32): i32;
function @internal @effects(platform)@extern("stasis_jit_ad_poll") ad_task_poll_raw(handle: i32): i32;
function @internal @effects(platform)@extern("stasis_jit_ad_gameplay_blocked") ad_task_gameplay_blocked_raw(): i32;
function @internal @effects(platform)@extern("stasis_jit_ad_take_reward") ad_task_take_reward_raw(handle: i32): i32;
function @internal @effects(platform)@extern("stasis_jit_ad_release") ad_task_release_raw(handle: i32): void;

function begin(self: AdTask, kind: AdKind): AdBeginResult {
    if (self.handle > 0) {
        return AdBeginResult.HandleOpen;
    }

    let kind_code: i32 = 0;
    if (kind == AdKind.Rewarded) {
        kind_code = 1;
    }
    let request: i32 = ad_task_request_raw(kind_code);
    if (request > 0) {
        self.handle = request;
        self.state = AdState.Requesting;
        return AdBeginResult.Accepted;
    }
    if (request == 0) {
        self.state = AdState.Unavailable;
        return AdBeginResult.Unavailable;
    }

    self.state = AdState.Failed;
    if (request == -2) {
        return AdBeginResult.Capacity;
    }
    return AdBeginResult.Busy;
}

function @internal ad_task_poll_status(self: AdTask): AdState {
    if (self.handle <= 0) {
        return self.state;
    }

    let state_code: i32 = ad_task_poll_raw(self.handle);
    if (state_code == 0) {
        self.state = AdState.Idle;
    } else if (state_code == 1) {
        self.state = AdState.Requesting;
    } else if (state_code == 2) {
        self.state = AdState.Playing;
    } else if (state_code == 3) {
        self.state = AdState.Finished;
    } else if (state_code == 5) {
        self.state = AdState.Unavailable;
    } else if (state_code == 6) {
        self.state = AdState.Loading;
    } else {
        self.state = AdState.Failed;
    }
    return self.state;
}

function status(self: AdTask): AdState {
    return ad_task_poll_status(self);
}

function should_block_gameplay(self: AdTask): bool {
    let state: AdState = ad_task_poll_status(self);
    if (state == AdState.Requesting || state == AdState.Loading || state == AdState.Playing) {
        return true;
    }
    return ad_task_gameplay_blocked_raw() != 0;
}

function take_reward(self: AdTask): bool {
    if (self.handle <= 0) {
        return false;
    }
    return ad_task_take_reward_raw(self.handle) == 1;
}

function @internal ad_task_release_owned_handle(self: AdTask): void {
    if (self.handle > 0) {
        ad_task_release_raw(self.handle);
    }
    self.handle = 0;
    self.state = AdState.Idle;
}

function release(self: AdTask): void {
    ad_task_release_owned_handle(self);
}

function reset(self: AdTask): void {
    ad_task_release_owned_handle(self);
}
