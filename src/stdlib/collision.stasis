// Typed collision predicates.

struct Aabb {
    minimum_x: f32;
    minimum_y: f32;
    maximum_x: f32;
    maximum_y: f32;
}

struct Circle {
    x: f32;
    y: f32;
    radius: f32;
}

function @inline intersects(self: Aabb, other: Aabb): bool {
    if (self.maximum_x < other.minimum_x) {
        return false;
    }
    if (self.minimum_x > other.maximum_x) {
        return false;
    }
    if (self.maximum_y < other.minimum_y) {
        return false;
    }
    if (self.minimum_y > other.maximum_y) {
        return false;
    }
    return true;
}

function @inline contains_point(self: Aabb, x: f32, y: f32): bool {
    if (x < self.minimum_x) {
        return false;
    }
    if (x > self.maximum_x) {
        return false;
    }
    if (y < self.minimum_y) {
        return false;
    }
    if (y > self.maximum_y) {
        return false;
    }
    return true;
}

function @inline intersects(self: Circle, other: Circle): bool {
    let dx: f32 = self.x - other.x;
    let dy: f32 = self.y - other.y;
    let radius_sum: f32 = self.radius + other.radius;
    return dx * dx + dy * dy <= radius_sum * radius_sum;
}

function @inline contains_point(self: Circle, x: f32, y: f32): bool {
    let dx: f32 = x - self.x;
    let dy: f32 = y - self.y;
    return dx * dx + dy * dy <= self.radius * self.radius;
}
