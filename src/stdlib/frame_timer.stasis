// Frame timing utilities (not loaded by default).
//
// Intended usage:
// - Store a FrameTimer inside your game state.
// - Call frame_timer_init(...) once (or on restart).
// - Each frame, push measured work time via frame_timer_push(...).

const FRAME_TIMER_SAMPLES: i32 = 120;

struct FrameTimer {
    samples_ms: i32[120];
    sample_index: i32;
}

function frame_timer_init(samples_ms: i32[]): void {
    let i: i32 = 0;
    for (i = 0; i < FRAME_TIMER_SAMPLES; i = i + 1) {
        samples_ms[i] = 1;
    }
}

function frame_timer_reset_index(): i32 {
    return 0;
}

function frame_timer_push(samples_ms: i32[], sample_index: i32, value_ms: i32): i32 {
    let idx: i32 = sample_index;
    if (idx < 0) { idx = 0; }
    if (idx > (FRAME_TIMER_SAMPLES - 1)) { idx = 0; }

    samples_ms[idx] = value_ms;
    idx = idx + 1;
    if (idx > (FRAME_TIMER_SAMPLES - 1)) { idx = 0; }
    return idx;
}

function frame_timer_avg_tenths(samples_ms: i32[]): i32 {
    // Fixed-point average in 0.1ms units to avoid f32->i32 cast issues in some backends.
    let sum: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < FRAME_TIMER_SAMPLES; i = i + 1) {
        sum = sum + samples_ms[i];
    }
    return (sum * 10) / FRAME_TIMER_SAMPLES;
}

function frame_timer_max_recent(samples_ms: i32[], sample_index: i32, last_n: i32): i32 {
    // Returns the max sample value across the last N pushed frames.
    // - sample_index is the *next write index* returned by frame_timer_push.
    // - last_n is clamped to [1, FRAME_TIMER_SAMPLES].
    let idx: i32 = sample_index;
    if (idx < 0) { idx = 0; }
    if (idx > (FRAME_TIMER_SAMPLES - 1)) { idx = 0; }

    let n: i32 = last_n;
    if (n < 1) { n = 1; }
    if (n > FRAME_TIMER_SAMPLES) { n = FRAME_TIMER_SAMPLES; }

    // Start at the most recently written sample (idx - 1, wrapped).
    let i: i32 = 0;
    let max_v: i32 = 0;
    for (i = 0; i < n; i = i + 1) {
        let j: i32 = idx - 1 - i;
        while (j < 0) { j = j + FRAME_TIMER_SAMPLES; }
        let v: i32 = samples_ms[j];
        if (v > max_v) { max_v = v; }
    }
    return max_v;
}
