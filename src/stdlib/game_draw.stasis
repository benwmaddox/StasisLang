import "graphics.stasis";
// Game drawing helpers (not loaded by default).

const GAME_PI2: f32 = 6.2831853;

function game_draw_rect(cx: f32, cy: f32, half: f32, r: f32, g: f32, b: f32, a: f32): void {
    let x0: f32 = cx - half;
    let y0: f32 = cy - half;
    let x1: f32 = cx + half;
    let y1: f32 = cy + half;
    draw_line(x0, y0, x1, y0, r, g, b, a);
    draw_line(x1, y0, x1, y1, r, g, b, a);
    draw_line(x1, y1, x0, y1, r, g, b, a);
    draw_line(x0, y1, x0, y0, r, g, b, a);
}

function game_draw_tri(cx: f32, cy: f32, half: f32, r: f32, g: f32, b: f32, a: f32): void {
    let x0: f32 = cx;
    let y0: f32 = cy - half;
    let x1: f32 = cx - half;
    let y1: f32 = cy + half;
    let x2: f32 = cx + half;
    let y2: f32 = cy + half;
    draw_line(x0, y0, x1, y1, r, g, b, a);
    draw_line(x1, y1, x2, y2, r, g, b, a);
    draw_line(x2, y2, x0, y0, r, g, b, a);
}

function game_draw_circle(cx: f32, cy: f32, radius: f32, r: f32, g: f32, b: f32, a: f32): void {
    let segments: i32 = 24;
    let i: i32 = 0;
    let step: f32 = GAME_PI2 / i32_to_f32(segments);
    let a0: f32 = 0.0;
    for (i = 0; i < segments; i = i + 1) {
        let a1: f32 = a0 + step;
        let x0: f32 = cx + cos_fast(a0) * radius;
        let y0: f32 = cy + sin_fast(a0) * radius;
        let x1: f32 = cx + cos_fast(a1) * radius;
        let y1: f32 = cy + sin_fast(a1) * radius;
        draw_line(x0, y0, x1, y1, r, g, b, a);
        a0 = a1;
    }
}

