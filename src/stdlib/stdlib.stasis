// Stasis standard library (stub)
// Loaded by default by the CLI. Functions will be added incrementally.

function to_utf8(dst: utf8[], src: ascii[], dst_max: i32): i32 {
    str_clear(dst);
    let i: i32 = 0;
    for (i = 0; i < dst_max; i = i + 1) {
        let b: i32 = src[i];
        if (b == 0) {
            return str_len(dst);
        }
        str_append_char(dst, b);
    }
    return str_len(dst);
}
