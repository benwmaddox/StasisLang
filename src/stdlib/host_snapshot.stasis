// HostFrame snapshot helpers (bulk copy into guest memory).

import "../host_frame.stasis";
import "memory.stasis";

const HOST_SNAPSHOT_I32_COUNT: i32 = 768;
const HOST_SNAPSHOT_F32_COUNT: i32 = 64;

struct HostFrameSnapshot {
    i32: i32[768];
    f32: f32[64];
}

function host_snapshot_copy(out_i32: i32[768], out_f32: f32[64]): void {
    mem_copy_i32(out_i32, HOST_SNAPSHOT_I32_COUNT, 0, host_i32, HOST_I32_COUNT, 0, HOST_SNAPSHOT_I32_COUNT);
    mem_copy_f32(out_f32, HOST_SNAPSHOT_F32_COUNT, 0, host_f32, HOST_F32_COUNT, 0, HOST_SNAPSHOT_F32_COUNT);
}
