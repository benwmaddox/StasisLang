import "../../src/stdlib/stdlib.stasis";
import "../../src/stdlib/graphics.stasis";

const VIRTUAL_W: f32 = 360.0;
const VIRTUAL_H: f32 = 720.0;

struct ProbeState {
    dummy: i32;
}

global state: ProbeState;
global desktop_w: i32[1];
global desktop_h: i32[1];
global window_probe_host_frame: HostFrame;

function maximize_window_for_desktop(): void {
    desktop_w[0] = 0;
    desktop_h[0] = 0;
    desktop_w[0] = window_probe_host_frame.display.screen_width_px;
    desktop_h[0] = window_probe_host_frame.display.screen_height_px;

    let desktop_width: i32 = desktop_w[0];
    let desktop_height: i32 = desktop_h[0];
    if (desktop_width < 1 || desktop_height < 1) {
        return;
    }

    let margin_w: i32 = 80;
    let margin_h: i32 = 120;
    let usable_w: i32 = desktop_width - margin_w;
    let usable_h: i32 = desktop_height - margin_h;
    let min_w: i32;
    min_w.from_f32(VIRTUAL_W);
    let min_h: i32;
    min_h.from_f32(VIRTUAL_H);
    if (usable_w < min_w) {
        usable_w = min_w;
    }
    if (usable_h < min_h) {
        usable_h = min_h;
    }

    // Candidate A: fit height.
    let fit_h_h: i32 = usable_h;
    let fit_h_h_f: f32;
    fit_h_h_f.from_i32(fit_h_h);
    let fit_h_w: i32;
    fit_h_w.from_f32(fit_h_h_f *(VIRTUAL_W / VIRTUAL_H));
    // Candidate B: fit width.
    let fit_w_w: i32 = usable_w;
    let fit_w_w_f: f32;
    fit_w_w_f.from_i32(fit_w_w);
    let fit_w_h: i32;
    fit_w_h.from_f32(fit_w_w_f *(VIRTUAL_H / VIRTUAL_W));
    let a_ok: bool = fit_h_w <= usable_w && fit_h_h <= usable_h;
    let b_ok: bool = fit_w_w <= usable_w && fit_w_h <= usable_h;

    let choose_w: i32;
    choose_w.from_f32(VIRTUAL_W);
    let choose_h: i32;
    choose_h.from_f32(VIRTUAL_H);
    if (a_ok && b_ok) {
        let a_area: i32 = fit_h_w * fit_h_h;
        let b_area: i32 = fit_w_w * fit_w_h;
        if (a_area >= b_area) {
            choose_w = fit_h_w;
            choose_h = fit_h_h;
        } else {
            choose_w = fit_w_w;
            choose_h = fit_w_h;
        }
    } else {
        if (a_ok) {
            choose_w = fit_h_w;
            choose_h = fit_h_h;
        } else {
            if (b_ok) {
                choose_w = fit_w_w;
                choose_h = fit_w_h;
            }
        }
    }

    if (choose_w < min_w) {
        choose_w = min_w;
    }
    if (choose_h < min_h) {
        choose_h = min_h;
    }

    set_window_size(choose_w, choose_h);
}

function main(): i32 {
    let init_w: i32;
    init_w.from_f32(VIRTUAL_W);
    let init_h: i32;
    init_h.from_f32(VIRTUAL_H);
    let ok: bool = init_window(init_w, init_h, "Stasis Window Size Probe");
    if (!ok) {
        return 1;
    }

    window_probe_host_frame.refresh();
    maximize_window_for_desktop();

    print_string("WINDOW_SIZE ");
    let logical_w: i32;
    logical_w.from_f32(window_probe_host_frame.display.logical_width);
    print_int(logical_w);
    print_string(" ");
    let logical_h: i32;
    logical_h.from_f32(window_probe_host_frame.display.logical_height);
    print_int(logical_h);
    print_string("\n");
    return 0;
}

function tick(): i32 {
    // Exit immediately after main(). This is a probe, not an interactive sample.
    return 1;
}
