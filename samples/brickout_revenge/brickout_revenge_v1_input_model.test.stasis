import "../../src/runtime/input_testkit.stasis";
import "brickout_revenge_v1.stasis";

test `vector labels are initialized without runtime font forwarding`(): bool {
    original_init_text();
    if (original_text_lengths[TXT_BRICKOUT_DEFENSE] != 16) { return false; }
    if (original_text_codes[original_text_offsets[TXT_BRICKOUT_DEFENSE]] != 66) { return false; }
    return true;
}

function original_testkit_set_viewport(width: i32, height: i32): void {
    host_i32[HOST_I_WINDOW_W_PX] = width;
    host_i32[HOST_I_WINDOW_H_PX] = height;
    host_i32[HOST_I_VIEWPORT_X_PX] = 0;
    host_i32[HOST_I_VIEWPORT_Y_PX] = 0;
    host_i32[HOST_I_VIEWPORT_W_PX] = width;
    host_i32[HOST_I_VIEWPORT_H_PX] = height;
}

test `android touch can start the recovered challenge`(): bool {
    input_testkit_reset();
    original_testkit_set_viewport(660, 550);
    original_state.screen = OriginalScreen.MainMenu;
    input_testkit_set_pointer_count(1);
    input_testkit_set_pointer(0, 4, true, true, false, 200.0, 240.0);
    original_update_layout();
    original_handle_pointer();
    if (original_state.screen != OriginalScreen.Game) { return false; }
    if (original_state.level_index != 2) { return false; }
    if (original_state.gold != 115) { return false; }
    if (original_spawn_total != 47) { return false; }
    return true;
}

test `touch placement uses original grid and economy`(): bool {
    original_start_level(0);
    original_state.selected_shop = OriginalTowerKind.Standard;
    let before: i32 = original_state.gold;
    let placed: bool = original_try_place_tower(120.0, 180.0);
    if (!placed) { return false; }
    if (original_state.gold != before - 5) { return false; }
    if (original_state.selected_tower_index < 0) { return false; }
    let index: i32 = original_state.selected_tower_index;
    if (original_state.towers[index].kind != OriginalTowerKind.Standard) { return false; }
    if (original_state.towers[index].hp != 10) { return false; }
    return true;
}

test `desktop shortcuts select upgrade and sell original towers`(): bool {
    input_testkit_reset();
    original_start_level(0);
    original_handle_number_press(2);
    if (original_state.selected_shop != OriginalTowerKind.Standard) { return false; }
    if (!original_try_place_tower(120.0, 180.0)) { return false; }
    let index: i32 = original_state.selected_tower_index;
    let gold_after_place: i32 = original_state.gold;
    original_upgrade_selected();
    if (original_state.towers[index].level != 1) { return false; }
    if (original_state.gold != gold_after_place - 6) { return false; }
    original_sell_selected();
    if (original_state.towers[index].active) { return false; }
    if (original_state.selected_tower_index != -1) { return false; }
    return true;
}

test `splitter produces two weakened recovered children`(): bool {
    original_clear_entities();
    original_state.rng = 1234;
    let parent: i32 = original_spawn_ball(OriginalBallKind.Splitter, 1, 200.0, 100.0, 3);
    if (parent < 0) { return false; }
    original_state.balls[parent].hp = 40;
    original_state.balls[parent].split_timer = 1;
    original_update_ball_behavior(parent);
    if (original_count_balls() != 3) { return false; }
    return true;
}
