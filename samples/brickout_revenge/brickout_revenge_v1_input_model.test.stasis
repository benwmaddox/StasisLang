import "../../src/stdlib/testing/input_testkit.stasis";
import "brickout_revenge_v1.stasis";

test `brickout refresh input model maps testkit snapshot`(): bool {
    input_testkit_reset();
    input_testkit_set_quit_requested(false);
    input_testkit_set_key_down(41, true);
    input_testkit_set_pointer_count(1);
    input_testkit_set_pointer(0, 17, true, true, false, 33.5, 44.5);

    refresh_input_model();

    if (input_model.quit_requested) {
        return false;
    }
    if (!input_model.escape_down) {
        return false;
    }
    if (input_model.pointer_count != 1) {
        return false;
    }
    if (input_model.pointers[0].id != 17) {
        return false;
    }
    if (!input_model.pointers[0].is_down) {
        return false;
    }
    if (!input_model.pointers[0].went_down) {
        return false;
    }
    if (input_model.pointers[0].went_up) {
        return false;
    }
    if (input_model.pointers[0].x_px < 33.4 || input_model.pointers[0].x_px > 33.6) {
        return false;
    }
    if (input_model.pointers[0].y_px < 44.4 || input_model.pointers[0].y_px > 44.6) {
        return false;
    }
    return true;
}

test `brickout record tap pulse uses refreshed input model`(): bool {
    input_testkit_reset();
    input_testkit_set_pointer_count(1);
    input_testkit_set_pointer(0, 21, true, true, false, 40.0, 50.0);

    state.layout.viewport_x = 10.0;
    state.layout.viewport_y = 20.0;
    state.tap_pulses[0].active = 0;
    state.tap_pulses[1].active = 0;

    refresh_input_model();
    record_tap_pulses();

    if (state.tap_pulses[0].active != 1) {
        return false;
    }
    if (state.tap_pulses[0].age_ms != 0) {
        return false;
    }
    if (state.tap_pulses[0].x < 49.9 || state.tap_pulses[0].x > 50.1) {
        return false;
    }
    if (state.tap_pulses[0].y < 69.9 || state.tap_pulses[0].y > 70.1) {
        return false;
    }
    return true;
}

test `brickout refresh input model clears inactive pointer slots`(): bool {
    input_testkit_reset();
    input_testkit_set_pointer_count(1);
    input_testkit_set_pointer(0, 7, true, false, false, 11.0, 12.0);

    input_model.pointers[1].id = 999;
    input_model.pointers[1].is_down = true;
    input_model.pointers[1].went_down = true;
    input_model.pointers[1].went_up = true;
    input_model.pointers[1].x_px = 123.0;
    input_model.pointers[1].y_px = 456.0;

    refresh_input_model();

    if (input_model.pointers[1].id != -1) {
        return false;
    }
    if (input_model.pointers[1].is_down) {
        return false;
    }
    if (input_model.pointers[1].went_down) {
        return false;
    }
    if (input_model.pointers[1].went_up) {
        return false;
    }
    if (input_model.pointers[1].x_px != 0.0) {
        return false;
    }
    if (input_model.pointers[1].y_px != 0.0) {
        return false;
    }
    return true;
}

test `brickout record tap pulse skips occupied slot`(): bool {
    input_testkit_reset();
    input_testkit_set_pointer_count(1);
    input_testkit_set_pointer(0, 33, true, true, false, 5.0, 6.0);

    state.layout.viewport_x = 0.0;
    state.layout.viewport_y = 0.0;
    state.tap_pulses[0].active = 1;
    state.tap_pulses[0].x = 1000.0;
    state.tap_pulses[0].y = 1000.0;
    state.tap_pulses[1].active = 0;

    refresh_input_model();
    record_tap_pulses();

    if (state.tap_pulses[0].x != 1000.0) {
        return false;
    }
    if (state.tap_pulses[0].y != 1000.0) {
        return false;
    }
    if (state.tap_pulses[1].active != 1) {
        return false;
    }
    if (state.tap_pulses[1].x < 4.9 || state.tap_pulses[1].x > 5.1) {
        return false;
    }
    if (state.tap_pulses[1].y < 5.9 || state.tap_pulses[1].y > 6.1) {
        return false;
    }
    return true;
}

test `brickout refresh input model clamps negative pointer count`(): bool {
    input_testkit_reset();
    input_testkit_set_pointer_count_raw(-5);
    refresh_input_model();
    if (input_model.pointer_count != 0) {
        return false;
    }
    return true;
}

test `brickout refresh input model clamps oversized pointer count`(): bool {
    input_testkit_reset();
    input_testkit_set_pointer_count_raw(999);
    input_testkit_set_pointer(7, 77, true, true, false, 1.0, 2.0);
    refresh_input_model();
    if (input_model.pointer_count != MAX_INPUT_POINTERS) {
        return false;
    }
    if (input_model.pointers[7].id != 77) {
        return false;
    }
    if (!input_model.pointers[7].is_down) {
        return false;
    }
    return true;
}
