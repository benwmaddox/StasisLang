// Faithful Stasis port of the published 2016 Flash build.
// Gameplay is fixed at the original 60 Hz and rendered in its 660 x 550 space.

const ORIGINAL_W: f32 = 660.0;
const ORIGINAL_H: f32 = 550.0;
const WORLD_LEFT: f32 = 9.0;
const WORLD_RIGHT: f32 = 441.0;
const WORLD_TOP: f32 = 15.0;
const WORLD_BOTTOM: f32 = 463.0;
const TOWER_SIZE: f32 = 32.0;
const BALL_SIZE: f32 = 16.0;
const PLACEMENT_STEP: f32 = 16.0;
const MAX_ORIGINAL_TOWERS: i32 = 80;
const MAX_ORIGINAL_BALLS: i32 = 256;
const MAX_ORIGINAL_PROJECTILES: i32 = 192;
const FIXED_DT: f32 = 0.0166667;
const PI: f32 = 3.1415926;

// SDL scancodes not yet present in the small shared enum.
const KEY_1: i32 = 30;
const KEY_2: i32 = 31;
const KEY_3: i32 = 32;
const KEY_4: i32 = 33;
const KEY_5: i32 = 34;
const KEY_6: i32 = 35;
const KEY_N: i32 = 17;
const KEY_P: i32 = 19;
const KEY_S: i32 = 22;
const KEY_U: i32 = 24;

struct OriginalTower {
    x: f32;
    y: f32;
    hp: i32;
    max_hp: i32;
    level: i32;
    invested_gold: i32;
    reload_ticks: i32;
    kind: OriginalTowerKind;
    fire_ball_serial: i32;
    fire_hit_tick: i32;
    animation_tick: i32;
    animation_active: bool;
    active: bool;
}

struct OriginalBall {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    hp: i32;
    damage: i32;
    level: i32;
    split_generations: i32;
    split_timer: i32;
    behavior_timer: i32;
    serial: i32;
    last_explosion_serial: i32;
    kind: OriginalBallKind;
    active: bool;
}

struct OriginalProjectile {
    x: f32;
    y: f32;
    speed: f32;
    damage: i32;
    target_index: i32;
    ttl_ticks: i32;
    serial: i32;
    kind: OriginalProjectileKind;
    active: bool;
}

struct OriginalAssets {
    background: i32;
    paddle: i32;
    store_wall: i32;
    store_standard: i32;
    store_rapid: i32;
    store_healer: i32;
    store_sniper: i32;
    store_rocket: i32;
    store_gold: i32;
    store_info: i32;
    button_upgrade: i32;
    button_sell: i32;
    button_cancel: i32;
    button_next: i32;
    button_pause: i32;
    tower_wall: i32;
    tower_standard: i32;
    tower_rapid: i32;
    tower_healer: i32;
    tower_sniper: i32;
    tower_rocket: i32;
    tower_gold: i32;
    tower_selector: i32;
    range_ring: i32;
    outline: i32;
    tower_ready: i32;
    ball_standard: i32;
    ball_fast: i32;
    ball_slow: i32;
    ball_curve: i32;
    ball_swarm: i32;
    ball_splitter: i32;
    ball_fire: i32;
    ball_mover: i32;
    projectile_standard: i32;
    projectile_rapid: i32;
    projectile_sniper: i32;
    projectile_rocket: i32;
    font_small: i32;
    font_title: i32;
}

struct OriginalLayout {
    viewport_x: f32;
    viewport_y: f32;
    viewport_w: f32;
    viewport_h: f32;
    offset_x: f32;
    offset_y: f32;
    scale: f32;
}

struct OriginalInputEdges {
    escape: bool;
    pause: bool;
    next: bool;
    sell: bool;
    upgrade: bool;
    one: bool;
    two: bool;
    three: bool;
    four: bool;
    five: bool;
    six: bool;
}

struct OriginalGameState {
    towers: OriginalTower[80];
    balls: OriginalBall[256];
    projectiles: OriginalProjectile[192];
    assets: OriginalAssets;
    layout: OriginalLayout;
    keys: OriginalInputEdges;
    screen: OriginalScreen;
    selected_shop: OriginalTowerKind;
    selected_tower_index: i32;
    level_index: i32;
    spawn_index: i32;
    spawn_timer: i32;
    lives: i32;
    gold: i32;
    score: i32;
    paddle_x: f32;
    paddle_y: f32;
    tick_index: i32;
    rng: i32;
    next_ball_serial: i32;
    next_projectile_serial: i32;
    paused: bool;
    initialized: bool;
    running: bool;
    swap_flash_ticks: i32;
}

