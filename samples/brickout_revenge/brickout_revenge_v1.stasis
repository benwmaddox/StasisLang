function original_tower_asset(kind: OriginalTowerKind): i32 {
    if (kind == OriginalTowerKind.Wall) { return original_tower_wall_frame(0); }
    if (kind == OriginalTowerKind.Standard) { return original_tower_standard_frame(0); }
    if (kind == OriginalTowerKind.Rapid) { return original_tower_rapid_frame(0); }
    if (kind == OriginalTowerKind.Healer) { return original_tower_healer_frame(0); }
    if (kind == OriginalTowerKind.Sniper) { return original_tower_sniper_frame(0); }
    if (kind == OriginalTowerKind.Rocket) { return original_tower_rocket_frame(0); }
    return original_tower_gold_frame(0);
}

function original_tower_frame_count(kind: OriginalTowerKind): i32 {
    if (kind == OriginalTowerKind.Healer) { return 53; }
    if (kind == OriginalTowerKind.Standard || kind == OriginalTowerKind.Wall) { return 61; }
    return 60;
}

function original_tower_animation_asset(kind: OriginalTowerKind, frame: i32): i32 {
    if (kind == OriginalTowerKind.Wall) { return original_tower_wall_frame(frame); }
    if (kind == OriginalTowerKind.Standard) { return original_tower_standard_frame(frame); }
    if (kind == OriginalTowerKind.Rapid) { return original_tower_rapid_frame(frame); }
    if (kind == OriginalTowerKind.Healer) { return original_tower_healer_frame(frame); }
    if (kind == OriginalTowerKind.Sniper) { return original_tower_sniper_frame(frame); }
    if (kind == OriginalTowerKind.Rocket) { return original_tower_rocket_frame(frame); }
    return original_tower_gold_frame(frame);
}

function original_store_asset(kind: OriginalTowerKind): i32 {
    if (kind == OriginalTowerKind.Wall) { return original_state.assets.store_wall; }
    if (kind == OriginalTowerKind.Standard) { return original_state.assets.store_standard; }
    if (kind == OriginalTowerKind.Rapid) { return original_state.assets.store_rapid; }
    if (kind == OriginalTowerKind.Healer) { return original_state.assets.store_healer; }
    if (kind == OriginalTowerKind.Sniper) { return original_state.assets.store_sniper; }
    if (kind == OriginalTowerKind.Rocket) { return original_state.assets.store_rocket; }
    return original_state.assets.store_gold;
}

function original_load_label(path: string, source_width: i32): i32 {
    return gfx_load_sprite(path, source_width * 4, 20);
}

function original_load_assets(): void {
    original_state.assets.background = gfx_load_sprite("assets/original/generated_4x/background_4x.png", 1320, 1100);
    original_state.assets.paddle = gfx_load_sprite("assets/original/paddle.png", 133, 19);
    original_state.assets.store_wall = gfx_load_sprite("assets/original/store_wall.png", 65, 65);
    original_state.assets.store_standard = gfx_load_sprite("assets/original/store_standard.png", 65, 65);
    original_state.assets.store_rapid = gfx_load_sprite("assets/original/store_rapid.png", 65, 65);
