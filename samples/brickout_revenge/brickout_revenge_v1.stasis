        original_draw_label(original_state.assets.font_small, TXT_SELECT_OPTION, 248.0, 105.0, 0.75, 0.85, 1.0, 1.0);
        original_draw_menu_box(150.0); original_draw_label(original_state.assets.font_small, TXT_CAMPAIGN_TUTORIAL, 100.0, 166.0, 0.90, 0.95, 1.0, 1.0);
        original_draw_menu_box(215.0); original_draw_label(original_state.assets.font_small, TXT_CHALLENGE_LEVEL, 100.0, 231.0, 0.90, 0.95, 1.0, 1.0);
        original_draw_menu_box(280.0); original_draw_label(original_state.assets.font_small, TXT_FORMER_CHALLENGES, 100.0, 296.0, 0.90, 0.95, 1.0, 1.0);
        original_draw_menu_box(345.0); original_draw_label(original_state.assets.font_small, TXT_UPGRADES, 100.0, 361.0, 0.90, 0.95, 1.0, 1.0);
    }
    if (original_state.screen == OriginalScreen.CampaignMenu) {
        original_draw_label(original_state.assets.font_small, TXT_SELECT_CAMPAIGN, 220.0, 115.0, 0.75, 0.85, 1.0, 1.0);
        original_draw_rect(60.0, 175.0, 540.0, 62.0, 0.40, 0.65, 0.95, 1.0);
        original_draw_label(original_state.assets.font_small, TXT_MARATHON, 82.0, 193.0, 0.9, 0.95, 1.0, 1.0);
        original_draw_rect(60.0, 255.0, 540.0, 62.0, 0.40, 0.65, 0.95, 1.0);
        original_draw_label(original_state.assets.font_small, TXT_SPLIT_SWARM, 82.0, 273.0, 0.9, 0.95, 1.0, 1.0);
    }
    if (original_state.screen == OriginalScreen.FormerChallenges) {
        original_draw_label(original_state.assets.font_small, TXT_FORMER_RECOVERED, 155.0, 135.0, 0.75, 0.85, 1.0, 1.0);
        original_draw_rect(60.0, 205.0, 540.0, 62.0, 0.40, 0.65, 0.95, 1.0);
        original_draw_label(original_state.assets.font_small, TXT_EARTHQUAKE, 80.0, 223.0, 0.9, 0.95, 1.0, 1.0);
    }
    if (original_state.screen == OriginalScreen.UpgradePlaceholder) {
        original_draw_label(original_state.assets.font_small, TXT_UPGRADE_PLACEHOLDER, 135.0, 225.0, 0.9, 0.95, 1.0, 1.0);
        original_draw_label(original_state.assets.font_small, TXT_TAP_ESC, 205.0, 270.0, 0.7, 0.85, 1.0, 1.0);
    }
}

function original_draw_end_overlay(): void {
    original_draw_sprite(original_state.assets.outline, 145.0, 190.0, 370.0, 150.0, 255);
    if (original_state.screen == OriginalScreen.Won) { original_draw_label(original_state.assets.font_title, TXT_LEVEL_WON, 235.0, 220.0, 0.4, 1.0, 0.5, 1.0); }
    if (original_state.screen == OriginalScreen.Lost) { original_draw_label(original_state.assets.font_title, TXT_LEVEL_LOST, 230.0, 220.0, 1.0, 0.35, 0.3, 1.0); }
    original_draw_label(original_state.assets.font_small, TXT_TAP_MENU, 215.0, 285.0, 0.9, 0.95, 1.0, 1.0);
}

function original_draw_frame(): void {
    begin_frame();
    clear(0.12, 0.15, 0.25, 1.0);
    if (original_state.screen == OriginalScreen.Game || original_state.screen == OriginalScreen.Won || original_state.screen == OriginalScreen.Lost) {
        original_draw_game();
        if (original_state.screen == OriginalScreen.Won || original_state.screen == OriginalScreen.Lost) { original_draw_end_overlay(); }
    } else {
        original_draw_menu();
    }
    if (original_state.swap_flash_ticks > 0) {
        original_draw_rect(1.0, 1.0, ORIGINAL_W - 2.0, ORIGINAL_H - 2.0, 0.2, 1.0, 0.8, 0.8);
        original_state.swap_flash_ticks -= 1;
    }
    end_frame();
}

function on_code_swap(): void {
    original_state.swap_flash_ticks = 90;
}

function main(): i32 {
    init_window(990, 825, "Brickout Defense");
    if (!original_state.initialized) {
        original_init_text();
        original_load_assets();
        original_state.rng = 13371337;
        original_state.screen = OriginalScreen.MainMenu;
        original_state.selected_shop = OriginalTowerKind.Standard;
        original_state.selected_tower_index = -1;
        original_state.running = true;
        original_state.initialized = true;
    }
    original_update_layout();
    return 0;
}

function tick(): i32 {
    if (should_quit()) { original_state.running = false; }
    if (!original_state.running) { return 1; }
    original_update_layout();
    original_handle_keyboard();
    original_handle_pointer();
    if (original_state.screen == OriginalScreen.Game) { original_update_gameplay(); }
    original_draw_frame();
    return 0;
}

function render(): i32 {
    if (!original_state.running) { return 1; }
    original_update_layout();
    original_draw_frame();
    return 0;
}
