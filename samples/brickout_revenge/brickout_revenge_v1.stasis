}

struct BrickoutConfig {
    magic: i32;
    screen: BrickoutScreenConfig;
    grid: BrickoutGridConfig;
    brick: BrickoutBrickConfig;
    paddle: BrickoutPaddleConfig;
    ball: BrickoutBallConfig;
    wave: BrickoutWaveConfig;
    timing: BrickoutTimingConfig;
    fx: BrickoutFxConfig;
    tower_basic: TowerStats;
    tower_armored: TowerStats;
    tower_reflector: TowerStats;
    score: BrickoutScoreConfig;
}

// Structs
struct Vec2 {
    x: f32;
    y: f32;
}

