    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(midx, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_I(x: f32, y: f32, s: f32): void {
