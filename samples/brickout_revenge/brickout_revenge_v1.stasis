    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, left, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_L(x: f32, y: f32, s: f32): void {
