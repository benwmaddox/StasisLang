import "../../src/stdlib/stdlib.stasis";
import "../../src/stdlib/frame_timer.stasis";
import "../../src/stdlib/sdl_scancodes.stasis";
import "../../src/stdlib/graphics.stasis";
import "../../src/stdlib/audio.stasis";

// Brickout Revenge - Tower Defense meets Breakout
// An auto-battler where you set up brick defenses and watch balls try to destroy them
//
// Live tuning:
// - Run with: `.\stasis.bat run samples\brickout_revenge\brickout_revenge.stasis --backend cranelift --graphics`
// - Edit: `samples/brickout_revenge/data/config.json` (hot-reloaded between ticks)

// External runtime APIs
// - init_window(width: i32, height: i32, title: string) -> bool
// - time() -> i64: returns unix timestamp for seeding PRNG
// - get_time_ms() -> i32: millisecond clock
// - should_quit() -> bool: polls SDL quit events
// - begin_frame(), end_frame(): bracket GPU work
// - clear(r: f32, g: f32, b: f32, a: f32): clears frame buffer
// - draw_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32)
// - gfx_load_sprite(path: string, max_w: i32, max_h: i32) -> i32
// - gfx_draw_sprite(handle: i32, x: i32, y: i32, w: i32, h: i32, rot_deg: i32, a: i32)
// - gfx_poll_reload(handle: i32) -> bool
// - gfx_window_width() -> i32
// - gfx_window_height() -> i32
// - gfx_window_resized() -> bool
// - input_viewport_x_px() -> i32
// - input_viewport_y_px() -> i32
// - input_viewport_w_px() -> i32
// - input_viewport_h_px() -> i32
// - is_key_down(scancode: i32) -> bool

// Pool sizes (compile-time; keep in sync with the array sizes below)
const MAX_BRICKS: i32 = 50;
const MAX_BALLS: i32 = 90;
const MAX_TAP_PULSES: i32 = 16;
const GRID_COLS: i32 = 6;
const GRID_ROWS: i32 = 6;
const UI_MENU_PAD: f32 = 10.0;
const UI_MENU_HEADER_H: f32 = 26.0;
const UI_MENU_SLOT_H: f32 = 30.0;
const UI_MENU_SLOT_GAP: f32 = 10.0;
const SFX_MAX_VOICES: i32 = 12;
const AUDIO_FRAMES_PER_PUSH: i32 = 256;
const PI2: f32 = 6.28318;
const SFX_SELECT: i32 = 1;
const SFX_DRAG_START: i32 = 2;
const SFX_DRAG_PLACE: i32 = 3;
const SFX_DRAG_INVALID: i32 = 4;
const SFX_SHOT: i32 = 5;
const SFX_BOUNCE: i32 = 6;
const SFX_BRICK_BREAK: i32 = 7;
const TAP_PULSE_DURATION_MS: i32 = 2000;
const UI_SIDE_MIN_W: f32 = 220.0;
const UI_BOTTOM_MIN_H: f32 = 160.0;
const UI_PANEL_PAD: f32 = 12.0;
const UI_PANEL_GAP: f32 = 12.0;

// Virtual resolution + safe gameplay area.
// The bottom UI region is reserved for a slide-up menu (and should not be used for gameplay placement).
const VIRTUAL_W: f32 = 360.0;
const VIRTUAL_H: f32 = 720.0;
const UI_RESERVED_H: f32 = 96.0;
const GAME_H: f32 = 624.0;

enum BrickType {
    Basic,
    Armored,
    Reflector
}

enum Phase {
    Setup,
    Battle,
    Win,
    Lose
}

// Math
const PI: f32 = 3.14159;

// Tunable parameters (loaded from JSON via runner data binding in dev)
struct BrickoutScreenConfig {
    w: i32;
    h: i32;
}

struct BrickoutGridConfig {
    origin_x: f32;
    margin_bottom: f32;
    spacing: f32;
}

struct BrickoutBrickConfig {
    width: f32;
    height: f32;
}

struct BrickoutPaddleConfig {
    y: f32;
    width: f32;
    height: f32;
    speed: f32;
}

struct BrickoutBallConfig {
    radius: f32;
    spawn_jitter_x: f32;
    clamp_margin_x: f32;
    vx_rand: f32;
    speed_min_base: f32;
    speed_min_per_wave: f32;
    speed_max_base: f32;
    speed_max_per_wave: f32;
    damage_base: i32;
    damage_wave_div: i32;
    hp_base: i32;
    hp_wave_div: i32;
    hp_scale: i32;
}

struct BrickoutWaveConfig {
    start_wave: i32;
    start_max_balls_wave: i32;
    max_balls_wave_add: i32;
    start_spawn_balls: i32;
}

