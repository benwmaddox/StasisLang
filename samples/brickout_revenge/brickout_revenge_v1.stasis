}

function original_clear_entities(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_TOWERS; i += 1) { original_state.towers[i].active = false; }
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) { original_state.balls[i].active = false; }
    for (i = 0; i < MAX_ORIGINAL_PROJECTILES; i += 1) { original_state.projectiles[i].active = false; }
}

function original_find_tower_slot(): i32 {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_TOWERS; i += 1) {
        if (!original_state.towers[i].active) { return i; }
    }
    return -1;
}

function original_find_ball_slot(): i32 {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) {
        if (!original_state.balls[i].active) { return i; }
    }
    return -1;
}

function original_find_projectile_slot(): i32 {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_PROJECTILES; i += 1) {
        if (!original_state.projectiles[i].active) { return i; }
    }
    return -1;
}

function original_create_tower(x: f32, y: f32, kind: OriginalTowerKind, level: i32, paid_cost: i32): i32 {
    let slot: i32 = original_find_tower_slot();
    if (slot < 0) { return -1; }
    original_state.towers[slot].x = x;
    original_state.towers[slot].y = y;
    original_state.towers[slot].kind = kind;
    original_state.towers[slot].level = level;
    original_state.towers[slot].hp = original_tower_starting_hp(kind, level);
    original_state.towers[slot].max_hp = original_tower_max_hp(kind, level);
    original_state.towers[slot].invested_gold = paid_cost;
    original_state.towers[slot].reload_ticks = 0;
    original_state.towers[slot].fire_ball_serial = -1;
    original_state.towers[slot].fire_hit_tick = -10000;
    original_state.towers[slot].animation_tick = 0;
    original_state.towers[slot].animation_active = kind != OriginalTowerKind.Gold;
    original_state.towers[slot].active = true;
    return slot;
}

function original_count_balls(): i32 {
    let count: i32 = 0;
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) {
        if (original_state.balls[i].active) { count += 1; }
    }
    return count;
}

function original_start_level(level_index: i32): void {
    original_clear_entities();
    original_level_init(level_index);
    original_state.screen = OriginalScreen.Game;
    original_state.level_index = level_index;
    original_state.lives = 20;
    original_state.gold = original_level_initial_gold(level_index);
    original_state.score = 0;
    original_state.spawn_index = 0;
    original_state.spawn_timer = original_spawn_delay_ticks[0];
    original_state.paddle_x = WORLD_LEFT + 40.0;
    original_state.paddle_y = WORLD_TOP + 2.0;
    original_state.selected_tower_index = -1;
    original_state.selected_shop = OriginalTowerKind.Standard;
    original_state.paused = false;

    if (level_index == 1 || level_index == 3) {
        let i: i32 = 0;
        for (i = 0; i < 26; i += 1) {
            let column: i32 = i % 13;
            let row: i32 = i / 13;
            let col_f: f32; col_f.from_i32(column);
            let row_f: f32; row_f.from_i32(row);
            let slot: i32 = original_create_tower(WORLD_LEFT + col_f * 32.0, WORLD_TOP + (13.0 - row_f) * 32.0, OriginalTowerKind.Wall, 0, 0);
            if (slot >= 0) { original_state.towers[slot].hp -= 20; }
        }
    }
    if (level_index == 2) {
        let i: i32 = 0;
        for (i = 0; i < 26; i += 1) {
            let column: i32 = i % 13;
            let row: i32 = i / 13;
            let col_f: f32; col_f.from_i32(column);
            let row_f: f32; row_f.from_i32(row);
            original_create_tower(WORLD_LEFT + col_f * 32.0, WORLD_TOP + (13.0 - row_f) * 32.0, OriginalTowerKind.Gold, 0, 0);
        }
    }
}

function original_spawn_ball(kind: OriginalBallKind, level: i32, x: f32, y: f32, split_generations: i32): i32 {
    let slot: i32 = original_find_ball_slot();
    if (slot < 0) { return -1; }
    let speed_i: i32 = original_ball_speed_min(kind) + original_rand() % 11;
    let speed: f32; speed.from_i32(speed_i);
    let degrees_i: i32 = original_rand() % 181;
    let degrees: f32; degrees.from_i32(degrees_i);
    let angle: f32 = degrees * PI / 180.0;
    original_state.next_ball_serial += 1;
    original_state.balls[slot].x = x;
    original_state.balls[slot].y = y;
    original_state.balls[slot].vx = cos_fast(angle) * speed;
    original_state.balls[slot].vy = sin_fast(angle) * speed;
    original_state.balls[slot].hp = original_ball_scaled_hp(kind, level);
    original_state.balls[slot].damage = original_ball_scaled_damage(kind, level);
    original_state.balls[slot].level = level;
    original_state.balls[slot].kind = kind;
    original_state.balls[slot].split_generations = split_generations;
    original_state.balls[slot].split_timer = 300;
    original_state.balls[slot].behavior_timer = 30;
    original_state.balls[slot].serial = original_state.next_ball_serial;
    original_state.balls[slot].last_explosion_serial = -1;
    original_state.balls[slot].active = true;
    return slot;
}

function original_spawn_group_now(): void {
    if (original_state.spawn_index >= original_spawn_total) { return; }
    let index: i32 = original_state.spawn_index;
    let count: i32 = original_spawn_count[index];
    let i: i32 = 0;
    for (i = 0; i < count; i += 1) {
        original_spawn_ball(original_spawn_kind[index], original_spawn_level[index], 200.0, 100.0, 3);
    }
    original_state.spawn_index = index + 1;
    original_state.spawn_timer = original_spawn_delay_ticks[index];
}

function original_damage_tower(index: i32, damage: i32): void {
    if (index < 0 || index >= MAX_ORIGINAL_TOWERS) { return; }
    if (!original_state.towers[index].active) { return; }
    original_state.towers[index].hp -= damage;
    if (original_state.towers[index].hp <= 0) {
        original_state.towers[index].active = false;
        original_state.score -= 1;
        if (original_state.selected_tower_index == index) { original_state.selected_tower_index = -1; }
    }
}

function original_kill_ball(index: i32, award: bool): void {
    if (index < 0 || index >= MAX_ORIGINAL_BALLS) { return; }
    if (!original_state.balls[index].active) { return; }
    if (award) {
        let is_child_splitter: bool = original_state.balls[index].kind == OriginalBallKind.Splitter && original_state.balls[index].split_generations != 3;
        if (is_child_splitter) {
            original_state.score += 1;
        } else {
            original_state.gold += original_level_kill_gold(original_state.level_index);
            original_state.score += original_state.balls[index].level;
        }
    }
    original_state.balls[index].active = false;
}

function original_damage_ball(index: i32, damage: i32): void {
    if (index < 0 || index >= MAX_ORIGINAL_BALLS) { return; }
    if (!original_state.balls[index].active) { return; }
    original_state.balls[index].hp -= damage;
    if (original_state.balls[index].hp <= 0) { original_kill_ball(index, true); }
}

function original_projectile_speed(kind: OriginalProjectileKind): f32 {
    if (kind == OriginalProjectileKind.Rapid) { return 350.0; }
    if (kind == OriginalProjectileKind.Sniper) { return 390.0; }
    return 190.0;
}

function original_spawn_projectile(tower_index: i32, target_index: i32): void {
    let slot: i32 = original_find_projectile_slot();
    if (slot < 0) { return; }
    let kind: OriginalProjectileKind = original_tower_projectile(original_state.towers[tower_index].kind);
    original_state.next_projectile_serial += 1;
    original_state.projectiles[slot].x = original_state.towers[tower_index].x + 16.0;
    original_state.projectiles[slot].y = original_state.towers[tower_index].y + 16.0;
    original_state.projectiles[slot].speed = original_projectile_speed(kind);
    original_state.projectiles[slot].damage = original_tower_damage(original_state.towers[tower_index].kind, original_state.towers[tower_index].level);
    original_state.projectiles[slot].target_index = target_index;
    original_state.projectiles[slot].ttl_ticks = 600;
    original_state.projectiles[slot].serial = original_state.next_projectile_serial;
    original_state.projectiles[slot].kind = kind;
    original_state.projectiles[slot].active = true;
}

function original_explode(x: f32, y: f32, damage: i32, serial: i32): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) {
        if (original_state.balls[i].active && original_state.balls[i].last_explosion_serial != serial) {
            if (original_dist2(x, y, original_state.balls[i].x + 8.0, original_state.balls[i].y + 8.0) <= 42.0 * 42.0) {
                original_state.balls[i].last_explosion_serial = serial;
                original_damage_ball(i, damage);
            }
        }
    }
}

function original_update_projectiles(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_PROJECTILES; i += 1) {
        if (original_state.projectiles[i].active) {
            let target: i32 = original_state.projectiles[i].target_index;
            if (target < 0 || target >= MAX_ORIGINAL_BALLS || !original_state.balls[target].active) {
                target = -1;
                let j: i32 = 0;
                for (j = 0; j < MAX_ORIGINAL_BALLS; j += 1) {
                    if (target < 0 && original_state.balls[j].active) { target = j; }
                }
                original_state.projectiles[i].target_index = target;
            }
            if (target < 0) {
                original_state.projectiles[i].active = false;
            } else {
                let dx: f32 = original_state.balls[target].x + 8.0 - original_state.projectiles[i].x;
                let dy: f32 = original_state.balls[target].y + 8.0 - original_state.projectiles[i].y;
                let divisor: f32 = original_abs(dx);
                if (original_abs(dy) > divisor) { divisor = original_abs(dy); }
                if (divisor < 0.001) { divisor = 1.0; }
                let step: f32 = original_state.projectiles[i].speed * FIXED_DT;
                original_state.projectiles[i].x += dx / divisor * step;
                original_state.projectiles[i].y += dy / divisor * step;
                original_state.projectiles[i].ttl_ticks -= 1;
                if (original_rects_overlap(original_state.projectiles[i].x - 4.0, original_state.projectiles[i].y - 4.0, 8.0, 8.0, original_state.balls[target].x, original_state.balls[target].y, BALL_SIZE, BALL_SIZE)) {
                    if (original_state.projectiles[i].kind == OriginalProjectileKind.Rocket) {
                        original_explode(original_state.projectiles[i].x, original_state.projectiles[i].y, original_state.projectiles[i].damage, original_state.projectiles[i].serial);
                    } else {
                        original_damage_ball(target, original_state.projectiles[i].damage);
                        if (original_state.projectiles[i].kind == OriginalProjectileKind.Rapid && original_state.balls[target].active) {
                            original_state.balls[target].y += 2.0;
                        }
                    }
                    original_state.projectiles[i].active = false;
                }
                if (original_state.projectiles[i].ttl_ticks <= 0) { original_state.projectiles[i].active = false; }
            }
        }
    }
}

function original_update_towers(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_TOWERS; i += 1) {
        if (original_state.towers[i].active) {
            if (original_state.towers[i].animation_active) {
                original_state.towers[i].animation_tick += 1;
                if (original_state.towers[i].animation_tick >= original_tower_frame_count(original_state.towers[i].kind) * 2) {
                    original_state.towers[i].animation_tick = 0;
                    original_state.towers[i].animation_active = false;
                }
            }
            original_state.towers[i].reload_ticks -= 1;
            let kind: OriginalTowerKind = original_state.towers[i].kind;
            if (kind == OriginalTowerKind.Healer && original_state.towers[i].reload_ticks <= 0) {
                let range_f: f32; range_f.from_i32(original_tower_range(kind, original_state.towers[i].level));
                let j: i32 = 0;
                for (j = 0; j < MAX_ORIGINAL_TOWERS; j += 1) {
                    if (original_state.towers[j].active && original_dist2(original_state.towers[i].x, original_state.towers[i].y, original_state.towers[j].x, original_state.towers[j].y) <= range_f * range_f) {
                        original_state.towers[j].hp += 1;
                        if (original_state.towers[j].hp > original_state.towers[j].max_hp) { original_state.towers[j].hp = original_state.towers[j].max_hp; }
                    }
                }
                original_state.towers[i].animation_tick = 0;
                original_state.towers[i].animation_active = true;
                original_state.towers[i].reload_ticks = original_tower_reload_ticks(kind, original_state.towers[i].level);
            }
            if (kind == OriginalTowerKind.Gold && original_state.towers[i].reload_ticks <= 0) {
                original_state.gold += original_state.towers[i].level + 1;
                original_damage_tower(i, 1 + original_state.towers[i].level / 2);
                if (original_state.towers[i].active) {
                    original_state.towers[i].animation_tick = 0;
                    original_state.towers[i].animation_active = true;
                    original_state.towers[i].reload_ticks = original_tower_reload_ticks(kind, original_state.towers[i].level);
                }
            }
            if (original_tower_can_fire(kind) && original_state.towers[i].reload_ticks <= 0) {
                let range_f: f32; range_f.from_i32(original_tower_range(kind, original_state.towers[i].level));
                let target: i32 = -1;
                let j: i32 = 0;
                for (j = 0; j < MAX_ORIGINAL_BALLS; j += 1) {
                    if (target < 0 && original_state.balls[j].active) {
                        if (original_dist2(original_state.towers[i].x + 16.0, original_state.towers[i].y + 16.0, original_state.balls[j].x + 8.0, original_state.balls[j].y + 8.0) <= range_f * range_f) { target = j; }
                    }
                }
                if (target >= 0) {
                    original_spawn_projectile(i, target);
                    original_state.towers[i].animation_tick = 0;
                    original_state.towers[i].animation_active = true;
                    original_state.towers[i].reload_ticks = original_tower_reload_ticks(kind, original_state.towers[i].level);
                }
            }
        }
    }
}

function original_move_tower_for_ball(tower_index: i32, side: i32): void {
    let nx: f32 = original_state.towers[tower_index].x;
    let ny: f32 = original_state.towers[tower_index].y;
    if (side == 0) { ny -= 16.0; }
    if (side == 1) { nx -= 16.0; }
    if (side == 2) { nx += 16.0; }
    if (side == 3) { ny += 16.0; }
    if (nx >= WORLD_LEFT && nx + TOWER_SIZE <= WORLD_RIGHT && ny >= WORLD_TOP && ny + TOWER_SIZE <= WORLD_BOTTOM) {
        original_state.towers[tower_index].x = nx;
        original_state.towers[tower_index].y = ny;
    }
}

function original_ball_tower_collision(ball_index: i32, tower_index: i32, old_x: f32, old_y: f32): void {
    let fire: bool = original_state.balls[ball_index].kind == OriginalBallKind.Fire;
    if (fire) {
        let serial_changed: bool = original_state.towers[tower_index].fire_ball_serial != original_state.balls[ball_index].serial;
        let cooled_down: bool = original_state.tick_index - original_state.towers[tower_index].fire_hit_tick >= 300;
        if (serial_changed || cooled_down) {
            original_state.towers[tower_index].fire_ball_serial = original_state.balls[ball_index].serial;
            original_state.towers[tower_index].fire_hit_tick = original_state.tick_index;
            original_damage_tower(tower_index, original_state.balls[ball_index].damage);
        }
        return;
    }

    let side: i32 = 3;
    if (old_y + BALL_SIZE <= original_state.towers[tower_index].y) { side = 0; }
    else if (old_x + BALL_SIZE <= original_state.towers[tower_index].x) { side = 1; }
    else if (old_x >= original_state.towers[tower_index].x + TOWER_SIZE) { side = 2; }
    if (original_state.balls[ball_index].kind == OriginalBallKind.Mover) { original_move_tower_for_ball(tower_index, side); }
    original_damage_tower(tower_index, original_state.balls[ball_index].damage);
    if (side == 0 || side == 3) {
        original_state.balls[ball_index].y = old_y;
        original_state.balls[ball_index].vy = 0.0 - original_state.balls[ball_index].vy;
    } else {
        original_state.balls[ball_index].x = old_x;
        original_state.balls[ball_index].vx = 0.0 - original_state.balls[ball_index].vx;
    }
}

function original_update_ball_behavior(index: i32): void {
    let kind: OriginalBallKind = original_state.balls[index].kind;
    if (kind == OriginalBallKind.Curve) {
        original_state.balls[index].behavior_timer -= 1;
        if (original_state.balls[index].behavior_timer <= 0) {
            let vx: f32 = original_state.balls[index].vx;
            let vy: f32 = original_state.balls[index].vy;
            original_state.balls[index].vx = vx * 0.99985 - vy * 0.01745;
            original_state.balls[index].vy = vx * 0.01745 + vy * 0.99985;
            original_state.balls[index].behavior_timer = 3;
        }
    }
    if (kind == OriginalBallKind.Swarm) {
        original_state.balls[index].behavior_timer -= 1;
        if (original_state.balls[index].behavior_timer <= 0) {
            let target: i32 = -1;
            let j: i32 = 0;
            for (j = 0; j < MAX_ORIGINAL_BALLS; j += 1) {
                if (target < 0 && j != index && original_state.balls[j].active) { target = j; }
            }
            if (target >= 0) {
                let dx: f32 = original_state.balls[target].x - original_state.balls[index].x;
                let dy: f32 = original_state.balls[target].y - original_state.balls[index].y;
                let divisor: f32 = original_abs(dx);
                if (original_abs(dy) > divisor) { divisor = original_abs(dy); }
                if (divisor < 1.0) { divisor = 1.0; }
                original_state.balls[index].vx += dx / divisor * 1.5;
                original_state.balls[index].vy += dy / divisor * 1.5;
            }
            original_state.balls[index].behavior_timer = 30;
        }
    }
    if (kind == OriginalBallKind.Splitter) {
        original_state.balls[index].split_timer -= 1;
        if (original_state.balls[index].split_timer <= 0 && original_state.balls[index].split_generations > 0) {
            let generation: i32 = original_state.balls[index].split_generations - 1;
            let left: i32 = original_spawn_ball(OriginalBallKind.Splitter, original_state.balls[index].level, original_state.balls[index].x, original_state.balls[index].y, generation);
            let right: i32 = original_spawn_ball(OriginalBallKind.Splitter, original_state.balls[index].level, original_state.balls[index].x, original_state.balls[index].y, generation);
            if (left >= 0) {
                original_state.balls[left].vx = original_state.balls[index].vx * 0.966 - original_state.balls[index].vy * 0.259;
                original_state.balls[left].vy = original_state.balls[index].vx * 0.259 + original_state.balls[index].vy * 0.966;
                original_state.balls[left].hp = original_state.balls[index].hp / 4 + 1;
            }
            if (right >= 0) {
                original_state.balls[right].vx = original_state.balls[index].vx * 0.966 + original_state.balls[index].vy * 0.259;
                original_state.balls[right].vy = 0.0 - original_state.balls[index].vx * 0.259 + original_state.balls[index].vy * 0.966;
                original_state.balls[right].hp = original_state.balls[index].hp / 4 + 1;
            }
            original_state.balls[index].split_timer = 1800;
        }
    }
}

function original_update_balls(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) {
        if (original_state.balls[i].active) {
            original_update_ball_behavior(i);
            let old_x: f32 = original_state.balls[i].x;
            let old_y: f32 = original_state.balls[i].y;
            original_state.balls[i].x += original_state.balls[i].vx * FIXED_DT;
            original_state.balls[i].y += original_state.balls[i].vy * FIXED_DT;

            if (original_state.balls[i].x < WORLD_LEFT) {
                original_state.balls[i].x = WORLD_LEFT;
                original_state.balls[i].vx = original_abs(original_state.balls[i].vx);
            }
            if (original_state.balls[i].x + BALL_SIZE > WORLD_RIGHT) {
                original_state.balls[i].x = WORLD_RIGHT - BALL_SIZE;
                original_state.balls[i].vx = 0.0 - original_abs(original_state.balls[i].vx);
            }

            if (original_state.balls[i].active && original_state.balls[i].vy < 0.0 && original_rects_overlap(original_state.balls[i].x, original_state.balls[i].y, BALL_SIZE, BALL_SIZE, original_state.paddle_x, original_state.paddle_y, 133.0, 19.0)) {
                original_state.balls[i].y = original_state.paddle_y + 19.0;
                original_state.balls[i].vy = original_abs(original_state.balls[i].vy);
            }

            let t: i32 = 0;
            for (t = 0; t < MAX_ORIGINAL_TOWERS; t += 1) {
                if (original_state.balls[i].active && original_state.towers[t].active) {
                    if (original_rects_overlap(original_state.balls[i].x, original_state.balls[i].y, BALL_SIZE, BALL_SIZE, original_state.towers[t].x, original_state.towers[t].y, TOWER_SIZE, TOWER_SIZE)) {
                        original_ball_tower_collision(i, t, old_x, old_y);
                    }
                }
            }

            if (original_state.balls[i].active && original_state.balls[i].y < WORLD_TOP) {
                original_kill_ball(i, false);
            }
            if (original_state.balls[i].active && original_state.balls[i].y + BALL_SIZE > WORLD_BOTTOM) {
                if (original_state.balls[i].kind != OriginalBallKind.Fire) { original_state.lives -= 1; }
                original_kill_ball(i, false);
            }
        }
    }
}

function original_predict_ball_x(index: i32): f32 {
    let px: f32 = original_state.balls[index].x;
    let py: f32 = original_state.balls[index].y;
    let vx: f32 = original_state.balls[index].vx;
    let vy: f32 = original_state.balls[index].vy;
    let step: i32 = 0;
    for (step = 0; step < 25; step += 1) {
        if (py > original_state.paddle_y + 19.0) {
            px += vx * 0.3;
            py += vy * 0.3;
            if (px < WORLD_LEFT || px + BALL_SIZE > WORLD_RIGHT) { vx = 0.0 - vx; }
        }
    }
    return px;
}

function original_update_paddle(): void {
    let target_x: f32 = WORLD_LEFT + (WORLD_RIGHT - WORLD_LEFT) * 0.5;
    let best_y: f32 = 10000.0;
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) {
        if (original_state.balls[i].active && original_state.balls[i].vy < 0.0 && original_state.balls[i].y > original_state.paddle_y + 19.0 && original_state.balls[i].y < (WORLD_BOTTOM - WORLD_TOP) * 0.5) {
            if (original_state.balls[i].y < best_y) {
                best_y = original_state.balls[i].y;
                target_x = original_predict_ball_x(i);
            }
        }
    }
    let center: f32 = original_state.paddle_x + 66.5;
    let step: f32 = 400.0 * FIXED_DT;
    if (target_x < center - 33.0) { original_state.paddle_x -= step; }
    if (target_x > center + 33.0) { original_state.paddle_x += step; }
    original_state.paddle_x = original_clamp(original_state.paddle_x, WORLD_LEFT, WORLD_RIGHT - 133.0);
}

function original_update_gameplay(): void {
    if (original_state.paused) { return; }
    original_state.tick_index += 1;
    if (original_state.spawn_index < original_spawn_total) {
        original_state.spawn_timer -= 1;
        if (original_state.spawn_timer <= 0) { original_spawn_group_now(); }
    }
    original_update_paddle();
    original_update_towers();
    original_update_projectiles();
    original_update_balls();
    if (original_state.lives <= 0) {
        original_state.screen = OriginalScreen.Lost;
        original_state.paused = true;
    } else if (original_state.spawn_index >= original_spawn_total && original_count_balls() == 0) {
        original_state.screen = OriginalScreen.Won;
        original_state.paused = true;
    }
}

function original_shop_kind(slot: i32): OriginalTowerKind {
    if (slot == 0) { return OriginalTowerKind.Wall; }
    if (slot == 1) { return OriginalTowerKind.Standard; }
    if (slot == 2) {
        if (original_level_uses_gold_tower(original_state.level_index)) { return OriginalTowerKind.Gold; }
        return OriginalTowerKind.Rapid;
    }
    if (slot == 3) { return OriginalTowerKind.Healer; }
    if (slot == 4) { return OriginalTowerKind.Sniper; }
    return OriginalTowerKind.Rocket;
}

function original_point_in_rect(x: f32, y: f32, rx: f32, ry: f32, width: f32, height: f32): bool {
    return x >= rx && x <= rx + width && y >= ry && y <= ry + height;
}

function original_tower_at(x: f32, y: f32): i32 {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_TOWERS; i += 1) {
        if (original_state.towers[i].active && original_point_in_rect(x, y, original_state.towers[i].x, original_state.towers[i].y, TOWER_SIZE, TOWER_SIZE)) { return i; }
    }
    return -1;
}

function original_placement_overlaps(x: f32, y: f32): bool {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_TOWERS; i += 1) {
        if (original_state.towers[i].active && original_rects_overlap(x, y, TOWER_SIZE, TOWER_SIZE, original_state.towers[i].x, original_state.towers[i].y, TOWER_SIZE, TOWER_SIZE)) { return true; }
    }
    return false;
}

function original_try_place_tower(pointer_x: f32, pointer_y: f32): bool {
    let gx: i32; gx.from_f32((pointer_x - WORLD_LEFT - 16.0) / PLACEMENT_STEP);
    let gy: i32; gy.from_f32((pointer_y - WORLD_TOP - 16.0) / PLACEMENT_STEP);
    let gx_f: f32; gx_f.from_i32(gx);
    let gy_f: f32; gy_f.from_i32(gy);
    let x: f32 = WORLD_LEFT + gx_f * PLACEMENT_STEP;
    let y: f32 = WORLD_TOP + gy_f * PLACEMENT_STEP;
    if (x < WORLD_LEFT || x + TOWER_SIZE > WORLD_RIGHT || y < 51.0 || y + TOWER_SIZE > WORLD_BOTTOM) { return false; }
    if (original_placement_overlaps(x, y)) { return false; }
    let cost: i32 = original_tower_cost(original_state.selected_shop, 0);
    if (original_state.gold < cost) { return false; }
    let slot: i32 = original_create_tower(x, y, original_state.selected_shop, 0, cost);
    if (slot < 0) { return false; }
    original_state.gold -= cost;
    original_state.selected_tower_index = slot;
    return true;
}

function original_upgrade_selected(): void {
    let index: i32 = original_state.selected_tower_index;
    if (index < 0 || index >= MAX_ORIGINAL_TOWERS || !original_state.towers[index].active) { return; }
    let level: i32 = original_state.towers[index].level;
    if (level >= 5) { return; }
    let next_level: i32 = level + 1;
    let cost: i32 = original_tower_cost(original_state.towers[index].kind, next_level);
    if (original_state.gold < cost) { return; }
    original_state.gold -= cost;
    original_state.towers[index].invested_gold += cost;
    original_state.towers[index].level = next_level;
    original_state.towers[index].hp = original_tower_starting_hp(original_state.towers[index].kind, next_level);
    original_state.towers[index].max_hp = original_tower_max_hp(original_state.towers[index].kind, next_level);
    let reload: i32 = original_tower_reload_ticks(original_state.towers[index].kind, next_level);
    if (original_state.towers[index].reload_ticks > reload) { original_state.towers[index].reload_ticks = reload; }
}

function original_sell_selected(): void {
    let index: i32 = original_state.selected_tower_index;
    if (index < 0 || index >= MAX_ORIGINAL_TOWERS || !original_state.towers[index].active) { return; }
    original_state.gold += original_state.towers[index].invested_gold * 8 / 10;
    original_state.towers[index].active = false;
    original_state.selected_tower_index = -1;
}

function original_choose_shop_slot(slot: i32): void {
    if (slot < 0 || slot > 5) { return; }
    original_state.selected_shop = original_shop_kind(slot);
    original_state.selected_tower_index = -1;
}

function original_handle_game_pointer(x: f32, y: f32): void {
    if (original_point_in_rect(x, y, 451.0, 43.0, 207.0, 135.0)) {
        let column: i32 = 0;
        if (x >= 520.0) { column = 1; }
        if (x >= 589.0) { column = 2; }
        let row: i32 = 0;
        if (y >= 108.0) { row = 1; }
        original_choose_shop_slot(row * 3 + column);
        return;
    }
    if (original_point_in_rect(x, y, 451.0, 383.0, 80.0, 26.0)) { original_upgrade_selected(); return; }
    if (original_point_in_rect(x, y, 534.0, 383.0, 44.0, 26.0)) { original_sell_selected(); return; }
    if (original_point_in_rect(x, y, 581.0, 383.0, 71.0, 26.0)) { original_state.selected_tower_index = -1; return; }
    if (original_point_in_rect(x, y, 451.0, 412.0, 65.0, 65.0)) { original_state.paused = !original_state.paused; return; }
    if (original_point_in_rect(x, y, 520.0, 412.0, 131.0, 65.0)) { original_spawn_group_now(); return; }
    if (original_point_in_rect(x, y, WORLD_LEFT, WORLD_TOP, WORLD_RIGHT - WORLD_LEFT, WORLD_BOTTOM - WORLD_TOP)) {
        let tower: i32 = original_tower_at(x, y);
        if (tower >= 0) {
            original_state.selected_tower_index = tower;
            original_state.selected_shop = original_state.towers[tower].kind;
        } else {
            original_try_place_tower(x, y);
        }
    }
}

function original_handle_menu_pointer(x: f32, y: f32): void {
    if (original_state.screen == OriginalScreen.MainMenu) {
        if (original_point_in_rect(x, y, 70.0, 150.0, 520.0, 52.0)) { original_state.screen = OriginalScreen.CampaignMenu; return; }
        if (original_point_in_rect(x, y, 70.0, 215.0, 520.0, 52.0)) { original_start_level(2); return; }
        if (original_point_in_rect(x, y, 70.0, 280.0, 520.0, 52.0)) { original_state.screen = OriginalScreen.FormerChallenges; return; }
        if (original_point_in_rect(x, y, 70.0, 345.0, 520.0, 52.0)) { original_state.screen = OriginalScreen.UpgradePlaceholder; return; }
    }
    if (original_state.screen == OriginalScreen.CampaignMenu) {
        if (original_point_in_rect(x, y, 60.0, 175.0, 540.0, 62.0)) { original_start_level(0); return; }
        if (original_point_in_rect(x, y, 60.0, 255.0, 540.0, 62.0)) { original_start_level(1); return; }
    }
    if (original_state.screen == OriginalScreen.FormerChallenges) {
        if (original_point_in_rect(x, y, 60.0, 205.0, 540.0, 62.0)) { original_start_level(3); return; }
    }
    if (original_state.screen == OriginalScreen.UpgradePlaceholder || original_state.screen == OriginalScreen.Won || original_state.screen == OriginalScreen.Lost) {
        original_state.screen = OriginalScreen.MainMenu;
    }
}

function original_handle_pointer(): void {
    let count: i32 = input_pointer_count();
    if (count > 8) { count = 8; }
    let i: i32 = 0;
    for (i = 0; i < count; i += 1) {
        if (input_pointer_went_down(i)) {
            let sx: f32 = input_pointer_x_px(i) + original_state.layout.viewport_x;
            let sy: f32 = input_pointer_y_px(i) + original_state.layout.viewport_y;
            let x: f32 = original_world_x(sx);
            let y: f32 = original_world_y(sy);
            if (x >= 0.0 && x <= ORIGINAL_W && y >= 0.0 && y <= ORIGINAL_H) {
                if (original_state.screen == OriginalScreen.Game) { original_handle_game_pointer(x, y); }
                else { original_handle_menu_pointer(x, y); }
            }
        }
    }
}

function original_handle_number_press(number: i32): void {
    if (original_state.screen == OriginalScreen.Game) {
        original_choose_shop_slot(number - 1);
        return;
    }
    if (original_state.screen == OriginalScreen.MainMenu) {
        if (number == 1) { original_state.screen = OriginalScreen.CampaignMenu; }
        if (number == 2) { original_start_level(2); }
        if (number == 3) { original_state.screen = OriginalScreen.FormerChallenges; }
        if (number == 4) { original_state.screen = OriginalScreen.UpgradePlaceholder; }
        return;
    }
    if (original_state.screen == OriginalScreen.CampaignMenu) {
        if (number == 1) { original_start_level(0); }
        if (number == 2) { original_start_level(1); }
        return;
    }
    if (original_state.screen == OriginalScreen.FormerChallenges && number == 1) { original_start_level(3); }
}

function original_handle_keyboard(): void {
    let escape: bool = is_key_down(Scancode.Escape);
    let pause: bool = is_key_down(KEY_P);
    let next: bool = is_key_down(KEY_N);
    let sell: bool = is_key_down(KEY_S);
    let upgrade: bool = is_key_down(KEY_U);
    let one: bool = is_key_down(KEY_1);
    let two: bool = is_key_down(KEY_2);
    let three: bool = is_key_down(KEY_3);
    let four: bool = is_key_down(KEY_4);
    let five: bool = is_key_down(KEY_5);
    let six: bool = is_key_down(KEY_6);

    if (escape && !original_state.keys.escape) {
        if (original_state.screen == OriginalScreen.Game) { original_state.selected_tower_index = -1; }
        else if (original_state.screen == OriginalScreen.MainMenu) { original_state.running = false; }
        else { original_state.screen = OriginalScreen.MainMenu; }
    }
    if (pause && !original_state.keys.pause && original_state.screen == OriginalScreen.Game) { original_state.paused = !original_state.paused; }
    if (next && !original_state.keys.next && original_state.screen == OriginalScreen.Game) { original_spawn_group_now(); }
    if (sell && !original_state.keys.sell && original_state.screen == OriginalScreen.Game) { original_sell_selected(); }
    if (upgrade && !original_state.keys.upgrade && original_state.screen == OriginalScreen.Game) { original_upgrade_selected(); }
    if (one && !original_state.keys.one) { original_handle_number_press(1); }
    if (two && !original_state.keys.two) { original_handle_number_press(2); }
    if (three && !original_state.keys.three) { original_handle_number_press(3); }
    if (four && !original_state.keys.four) { original_handle_number_press(4); }
    if (five && !original_state.keys.five) { original_handle_number_press(5); }
    if (six && !original_state.keys.six) { original_handle_number_press(6); }

    original_state.keys.escape = escape;
    original_state.keys.pause = pause;
    original_state.keys.next = next;
    original_state.keys.sell = sell;
    original_state.keys.upgrade = upgrade;
    original_state.keys.one = one;
    original_state.keys.two = two;
    original_state.keys.three = three;
    original_state.keys.four = four;
    original_state.keys.five = five;
    original_state.keys.six = six;
}

function original_draw_digit(digit: i32, x: f32, y: f32, scale: f32, r: f32, g: f32, b: f32): void {
    if (digit < 0 || digit > 9) { return; }
    if (digit == 0) { original_draw_cached_label(original_state.assets.font_small, "0", x, y, r, g, b, 1.0); }
    if (digit == 1) { original_draw_cached_label(original_state.assets.font_small, "1", x, y, r, g, b, 1.0); }
    if (digit == 2) { original_draw_cached_label(original_state.assets.font_small, "2", x, y, r, g, b, 1.0); }
    if (digit == 3) { original_draw_cached_label(original_state.assets.font_small, "3", x, y, r, g, b, 1.0); }
    if (digit == 4) { original_draw_cached_label(original_state.assets.font_small, "4", x, y, r, g, b, 1.0); }
    if (digit == 5) { original_draw_cached_label(original_state.assets.font_small, "5", x, y, r, g, b, 1.0); }
    if (digit == 6) { original_draw_cached_label(original_state.assets.font_small, "6", x, y, r, g, b, 1.0); }
    if (digit == 7) { original_draw_cached_label(original_state.assets.font_small, "7", x, y, r, g, b, 1.0); }
    if (digit == 8) { original_draw_cached_label(original_state.assets.font_small, "8", x, y, r, g, b, 1.0); }
    if (digit == 9) { original_draw_cached_label(original_state.assets.font_small, "9", x, y, r, g, b, 1.0); }
}

function original_draw_number(value: i32, x: f32, y: f32, scale: f32, r: f32, g: f32, b: f32): void {
    let n: i32 = value;
    let cursor: f32 = x;
    if (n < 0) {
        original_draw_cached_label(original_state.assets.font_small, "-", cursor, y, r, g, b, 1.0);
        cursor += 6.0 * scale;
        n = 0 - n;
    }
    let divisor: i32 = 100000;
    let started: bool = false;
    for (divisor = 100000; divisor >= 1; divisor = divisor / 10) {
        let digit: i32 = n / divisor;
        if (digit > 0 || started || divisor == 1) {
            original_draw_digit(digit, cursor, y, scale, r, g, b);
            cursor += 6.0 * scale;
            started = true;
        }
        n = n % divisor;
    }
}

function original_ball_asset(kind: OriginalBallKind): i32 {
    if (kind == OriginalBallKind.Standard) { return original_ball_standard_frame(0); }
    if (kind == OriginalBallKind.Fast) { return original_ball_fast_frame(0); }
    if (kind == OriginalBallKind.Slow) { return original_ball_slow_frame(0); }
    if (kind == OriginalBallKind.Curve) { return original_ball_curve_frame(0); }
    if (kind == OriginalBallKind.Swarm) { return original_ball_swarm_frame(0); }
    if (kind == OriginalBallKind.Splitter) { return original_ball_splitter_frame(0); }
    if (kind == OriginalBallKind.Fire) { return original_ball_fire_frame(0); }
    return original_ball_mover_frame(0);
}

function original_ball_animation_asset(kind: OriginalBallKind, frame: i32): i32 {
    if (kind == OriginalBallKind.Standard) { return original_ball_standard_frame(frame); }
    if (kind == OriginalBallKind.Fast) { return original_ball_fast_frame(frame); }
    if (kind == OriginalBallKind.Slow) { return original_ball_slow_frame(frame); }
    if (kind == OriginalBallKind.Curve) { return original_ball_curve_frame(frame); }
    if (kind == OriginalBallKind.Swarm) { return original_ball_swarm_frame(frame); }
    if (kind == OriginalBallKind.Splitter) { return original_ball_splitter_frame(frame); }
    if (kind == OriginalBallKind.Fire) { return original_ball_fire_frame(frame); }
    return original_ball_mover_frame(frame);
}

function original_ball_rotation(vx: f32, vy: f32): i32 {
    let ax: f32 = original_abs(vx);
    let ay: f32 = original_abs(vy);
    let angle: i32 = 0;
    if (ax < 0.001) {
        angle = 90;
    } else {
        let ratio: f32 = ay / ax;
        if (ratio < 0.1989) { angle = 0; }
        else if (ratio < 0.6682) { angle = 23; }
        else if (ratio < 1.4966) { angle = 45; }
        else if (ratio < 5.0273) { angle = 68; }
        else { angle = 90; }
    }
    if (vx < 0.0 && vy >= 0.0) { angle = 180 - angle; }
    if (vx < 0.0 && vy < 0.0) { angle = 180 + angle; }
    if (vx >= 0.0 && vy < 0.0) { angle = 360 - angle; }
    return angle - 135;
}

function original_draw_ball(index: i32): void {
    let kind: OriginalBallKind = original_state.balls[index].kind;
    let frame: i32 = original_state.tick_index / 2;
    let rotation: i32 = original_ball_rotation(original_state.balls[index].vx, original_state.balls[index].vy);
    if (kind == OriginalBallKind.Fire) { rotation = 0; }
    original_draw_sprite_rot(original_ball_animation_asset(kind, frame), original_state.balls[index].x - 1.0, original_state.balls[index].y - 1.0, 18.0, 18.0, rotation, 255);
}

function original_draw_towers(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_TOWERS; i += 1) {
        if (original_state.towers[i].active) {
            let frame: i32 = 0;
            if (original_state.towers[i].animation_active) { frame = original_state.towers[i].animation_tick / 2; }
            original_draw_sprite(original_tower_animation_asset(original_state.towers[i].kind, frame), original_state.towers[i].x, original_state.towers[i].y, 32.0, 32.0, 255);
            original_draw_number(original_state.towers[i].hp, original_state.towers[i].x + 1.0, original_state.towers[i].y + 1.0, 1.0, 0.95, 0.95, 0.95);
            if (i == original_state.selected_tower_index) {
                original_draw_sprite(original_state.assets.tower_selector, original_state.towers[i].x - 1.0, original_state.towers[i].y - 1.0, 34.0, 34.0, 255);
            }
            if (original_tower_can_fire(original_state.towers[i].kind) && original_state.towers[i].reload_ticks <= 0) {
                original_draw_sprite(original_state.assets.tower_ready, original_state.towers[i].x + 27.0, original_state.towers[i].y + 1.0, 4.0, 4.0, 255);
            }
        }
    }
}

function original_draw_projectiles(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_PROJECTILES; i += 1) {
        if (original_state.projectiles[i].active) {
            let handle: i32 = original_state.assets.projectile_standard;
            let size: f32 = 5.0;
            if (original_state.projectiles[i].kind == OriginalProjectileKind.Rapid) { handle = original_state.assets.projectile_rapid; size = 4.0; }
            if (original_state.projectiles[i].kind == OriginalProjectileKind.Sniper) { handle = original_state.assets.projectile_sniper; size = 7.0; }
            if (original_state.projectiles[i].kind == OriginalProjectileKind.Rocket) { handle = original_state.assets.projectile_rocket; size = 9.0; }
            original_draw_sprite(handle, original_state.projectiles[i].x - size * 0.5, original_state.projectiles[i].y - size * 0.5, size, size, 255);
        }
    }
}

function original_draw_tower_name(kind: OriginalTowerKind, x: f32, y: f32): void {
    if (kind == OriginalTowerKind.Wall) { original_draw_label(original_state.assets.font_small, TXT_WALL, x, y, 0.35, 1.0, 1.0, 1.0); }
    if (kind == OriginalTowerKind.Standard) { original_draw_label(original_state.assets.font_small, TXT_STANDARD, x, y, 0.35, 1.0, 1.0, 1.0); }
    if (kind == OriginalTowerKind.Rapid) { original_draw_label(original_state.assets.font_small, TXT_RAPID, x, y, 0.35, 1.0, 1.0, 1.0); }
    if (kind == OriginalTowerKind.Healer) { original_draw_label(original_state.assets.font_small, TXT_HEALER, x, y, 0.35, 1.0, 1.0, 1.0); }
    if (kind == OriginalTowerKind.Sniper) { original_draw_label(original_state.assets.font_small, TXT_SNIPER, x, y, 0.35, 1.0, 1.0, 1.0); }
    if (kind == OriginalTowerKind.Rocket) { original_draw_label(original_state.assets.font_small, TXT_ROCKET, x, y, 0.35, 1.0, 1.0, 1.0); }
    if (kind == OriginalTowerKind.Gold) { original_draw_label(original_state.assets.font_small, TXT_GOLD_MINER, x, y, 0.35, 1.0, 1.0, 1.0); }
}

function original_draw_ball_name(kind: OriginalBallKind, x: f32, y: f32): void {
    if (kind == OriginalBallKind.Standard) { original_draw_label(original_state.assets.font_small, TXT_BASIC_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Fast) { original_draw_label(original_state.assets.font_small, TXT_FAST_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Slow) { original_draw_label(original_state.assets.font_small, TXT_SLOW_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Curve) { original_draw_label(original_state.assets.font_small, TXT_CURVE_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Swarm) { original_draw_label(original_state.assets.font_small, TXT_SWARM_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Splitter) { original_draw_label(original_state.assets.font_small, TXT_SPLITTER, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Fire) { original_draw_label(original_state.assets.font_small, TXT_FIRE_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
    if (kind == OriginalBallKind.Mover) { original_draw_label(original_state.assets.font_small, TXT_MOVER_BALL, x, y, 0.82, 0.95, 1.0, 1.0); }
}

function original_draw_store_information(): void {
    let kind: OriginalTowerKind = original_state.selected_shop;
    let level: i32 = 0;
    let selected: i32 = original_state.selected_tower_index;
    if (selected >= 0 && selected < MAX_ORIGINAL_TOWERS && original_state.towers[selected].active) {
        kind = original_state.towers[selected].kind;
        level = original_state.towers[selected].level;
    }
    original_draw_sprite(original_state.assets.store_info, 451.0, 183.0, 201.0, 197.0, 255);
    original_draw_sprite(original_tower_asset(kind), 459.0, 190.0, 32.0, 32.0, 255);
    original_draw_tower_name(kind, 503.0, 190.0);
    original_draw_label(original_state.assets.font_small, TXT_COST, 503.0, 214.0, 0.85, 0.95, 1.0, 1.0);
    original_draw_number(original_tower_cost(kind, level), 548.0, 217.0, 1.0, 0.85, 0.95, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_DAMAGE, 456.0, 291.0, 0.35, 1.0, 1.0, 1.0);
    original_draw_number(original_tower_damage(kind, level), 568.0, 296.0, 0.9, 0.90, 0.95, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_HEALTH, 456.0, 314.0, 0.35, 1.0, 1.0, 1.0);
    original_draw_number(original_tower_starting_hp(kind, level), 568.0, 319.0, 0.9, 0.90, 0.95, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_RANGE, 456.0, 337.0, 0.35, 1.0, 1.0, 1.0);
    original_draw_number(original_tower_range(kind, level), 568.0, 342.0, 0.9, 0.90, 0.95, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_RELOAD, 456.0, 360.0, 0.35, 1.0, 1.0, 1.0);
    original_draw_number(original_tower_reload_ticks(kind, level) / 60, 568.0, 365.0, 0.9, 0.90, 0.95, 1.0);
    original_draw_sprite(original_state.assets.button_upgrade, 451.0, 383.0, 80.0, 25.0, 255);
    original_draw_sprite(original_state.assets.button_sell, 534.0, 383.0, 44.0, 26.0, 255);
    original_draw_sprite(original_state.assets.button_cancel, 581.0, 383.0, 71.0, 26.0, 255);
}

function original_draw_game(): void {
    original_draw_sprite(original_state.assets.background, 0.0, 0.0, ORIGINAL_W, ORIGINAL_H, 255);
    original_draw_sprite(original_state.assets.paddle, original_state.paddle_x, original_state.paddle_y, 133.0, 19.0, 255);
    original_draw_towers();
    let i: i32 = 0;
    for (i = 0; i < MAX_ORIGINAL_BALLS; i += 1) { if (original_state.balls[i].active) { original_draw_ball(i); } }
    original_draw_projectiles();

    let slot: i32 = 0;
    for (slot = 0; slot < 6; slot += 1) {
        let column: i32 = slot % 3;
        let row: i32 = slot / 3;
        let column_f: f32; column_f.from_i32(column);
        let row_f: f32; row_f.from_i32(row);
        let kind: OriginalTowerKind = original_shop_kind(slot);
        original_draw_sprite(original_store_asset(kind), 451.0 + column_f * 69.0, 43.0 + row_f * 70.0, 65.0, 65.0, 255);
        if (kind == original_state.selected_shop && original_state.selected_tower_index < 0) {
            original_draw_sprite(original_state.assets.outline, 450.0 + column_f * 69.0, 42.0 + row_f * 70.0, 67.0, 67.0, 255);
        }
    }
    original_draw_store_information();
    original_draw_sprite(original_state.assets.button_pause, 451.0, 412.0, 65.0, 65.0, 255);
    original_draw_sprite(original_state.assets.button_next, 520.0, 412.0, 131.0, 65.0, 255);

    original_draw_label(original_state.assets.font_small, TXT_LIVES, 454.0, 3.0, 0.38, 1.0, 1.0, 1.0);
    original_draw_number(original_state.lives, 456.0, 20.0, 0.9, 0.85, 1.0, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_GOLD, 521.0, 3.0, 0.38, 1.0, 1.0, 1.0);
    original_draw_number(original_state.gold, 523.0, 20.0, 0.9, 0.85, 1.0, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_NEXT_ENEMY, 16.0, 500.0, 0.70, 0.95, 1.0, 1.0);
    if (original_state.spawn_index < original_spawn_total) { original_draw_ball_name(original_spawn_kind[original_state.spawn_index], 116.0, 500.0); }
    original_draw_label(original_state.assets.font_small, TXT_LEVELS_LEFT, 456.0, 500.0, 0.70, 0.95, 1.0, 1.0);
    original_draw_number(original_spawn_total - original_state.spawn_index, 580.0, 506.0, 1.0, 0.85, 1.0, 1.0);
    original_draw_label(original_state.assets.font_small, TXT_SCORE, 456.0, 523.0, 0.70, 0.95, 1.0, 1.0);
    original_draw_number(original_state.score, 530.0, 529.0, 1.0, 0.85, 1.0, 1.0);

    let selected: i32 = original_state.selected_tower_index;
    if (selected >= 0 && selected < MAX_ORIGINAL_TOWERS && original_state.towers[selected].active) {
        let range_f: f32; range_f.from_i32(original_tower_range(original_state.towers[selected].kind, original_state.towers[selected].level));
        if (range_f > 0.0) {
            original_draw_sprite(original_state.assets.range_ring, original_state.towers[selected].x + 16.0 - range_f, original_state.towers[selected].y + 16.0 - range_f, range_f * 2.0, range_f * 2.0, 210);
        }
    }
    if (original_state.paused && original_state.screen == OriginalScreen.Game) {
        original_draw_label(original_state.assets.font_title, TXT_PAUSED, 268.0, 240.0, 1.0, 0.95, 0.40, 1.0);
    }
}

function original_draw_menu_box(y: f32): void {
    original_draw_rect(70.0, y, 520.0, 52.0, 0.40, 0.65, 0.95, 1.0);
}

