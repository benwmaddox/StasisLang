function original_abs(value: f32): f32 {
    if (value < 0.0) { return 0.0 - value; }
    return value;
}

function original_min(a: f32, b: f32): f32 {
    if (a < b) { return a; }
    return b;
}

function original_clamp(value: f32, low: f32, high: f32): f32 {
    if (value < low) { return low; }
    if (value > high) { return high; }
    return value;
}

function original_rand(): i32 {
    original_state.rng = original_state.rng * 1103515245 + 12345;
    if (original_state.rng < 0) { original_state.rng = 0 - original_state.rng; }
    return original_state.rng;
}

function original_rand_f32(maximum: f32): f32 {
    let n: i32 = original_rand() % 10000;
    let value: f32;
    value.from_i32(n);
    return value / 10000.0 * maximum;
}

function original_rects_overlap(ax: f32, ay: f32, aw: f32, ah: f32, bx: f32, by: f32, bw: f32, bh: f32): bool {
    return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by;
}

function original_dist2(ax: f32, ay: f32, bx: f32, by: f32): f32 {
    let dx: f32 = ax - bx;
    let dy: f32 = ay - by;
    return dx * dx + dy * dy;
}

function original_update_layout(): void {
    let vx: i32 = input_viewport_x_px();
    let vy: i32 = input_viewport_y_px();
    let vw: i32 = input_viewport_w_px();
    let vh: i32 = input_viewport_h_px();
    if (vw < 1) { vw = gfx_window_width(); }
    if (vh < 1) { vh = gfx_window_height(); }
    original_state.layout.viewport_x.from_i32(vx);
    original_state.layout.viewport_y.from_i32(vy);
    original_state.layout.viewport_w.from_i32(vw);
    original_state.layout.viewport_h.from_i32(vh);
    let sx: f32 = original_state.layout.viewport_w / ORIGINAL_W;
    let sy: f32 = original_state.layout.viewport_h / ORIGINAL_H;
    original_state.layout.scale = original_min(sx, sy);
    if (original_state.layout.scale <= 0.0) { original_state.layout.scale = 1.0; }
    let draw_w: f32 = ORIGINAL_W * original_state.layout.scale;
    let draw_h: f32 = ORIGINAL_H * original_state.layout.scale;
    original_state.layout.offset_x = original_state.layout.viewport_x + (original_state.layout.viewport_w - draw_w) * 0.5;
    original_state.layout.offset_y = original_state.layout.viewport_y + (original_state.layout.viewport_h - draw_h) * 0.5;
}

function original_screen_x(x: f32): f32 { return original_state.layout.offset_x + x * original_state.layout.scale; }
function original_screen_y(y: f32): f32 { return original_state.layout.offset_y + y * original_state.layout.scale; }
function original_screen_len(value: f32): f32 { return value * original_state.layout.scale; }
function original_world_x(screen_x: f32): f32 { return (screen_x - original_state.layout.offset_x) / original_state.layout.scale; }
function original_world_y(screen_y: f32): f32 { return (screen_y - original_state.layout.offset_y) / original_state.layout.scale; }

function original_draw_sprite(handle: i32, x: f32, y: f32, width: f32, height: f32, alpha: i32): void {
    let sx: i32; sx.from_f32(original_screen_x(x));
    let sy: i32; sy.from_f32(original_screen_y(y));
    let sw: i32; sw.from_f32(original_screen_len(width));
    let sh: i32; sh.from_f32(original_screen_len(height));
    if (sw < 1) { sw = 1; }
    if (sh < 1) { sh = 1; }
    gfx_draw_sprite(handle, sx, sy, sw, sh, 0, alpha);
}

function original_draw_sprite_rot(handle: i32, x: f32, y: f32, width: f32, height: f32, rotation: i32, alpha: i32): void {
    let sx: i32; sx.from_f32(original_screen_x(x));
    let sy: i32; sy.from_f32(original_screen_y(y));
    let sw: i32; sw.from_f32(original_screen_len(width));
    let sh: i32; sh.from_f32(original_screen_len(height));
    if (sw < 1) { sw = 1; }
    if (sh < 1) { sh = 1; }
    gfx_draw_sprite(handle, sx, sy, sw, sh, rotation, alpha);
}

function original_draw_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32): void {
    draw_line(original_screen_x(x1), original_screen_y(y1), original_screen_x(x2), original_screen_y(y2), r, g, b, a);
}

function original_draw_rect(x: f32, y: f32, width: f32, height: f32, r: f32, g: f32, b: f32, a: f32): void {
    original_draw_line(x, y, x + width, y, r, g, b, a);
    original_draw_line(x + width, y, x + width, y + height, r, g, b, a);
    original_draw_line(x + width, y + height, x, y + height, r, g, b, a);
    original_draw_line(x, y + height, x, y, r, g, b, a);
}

function original_draw_circle(x: f32, y: f32, radius: f32, r: f32, g: f32, b: f32, a: f32): void {
    let previous_x: f32 = x + radius;
    let previous_y: f32 = y;
    let i: i32 = 1;
    for (i = 1; i <= 16; i += 1) {
        let fi: f32; fi.from_i32(i);
        let angle: f32 = fi / 16.0 * PI * 2.0;
        let px: f32 = x + cos_fast(angle) * radius;
        let py: f32 = y + sin_fast(angle) * radius;
        original_draw_line(previous_x, previous_y, px, py, r, g, b, a);
        previous_x = px;
        previous_y = py;
    }
}

function original_glyph_row(code: i32, row: i32): i32 {
    if (code >= 97 && code <= 122) { code -= 32; }
    if (code == 32) { return 0; }
    if (code == 48) { if (row == 0 || row == 4) { return 7; } return 5; }
    if (code == 49) { if (row == 0) { return 2; } if (row == 1) { return 6; } if (row == 4) { return 7; } return 2; }
    if (code == 50) { if (row == 0 || row == 2 || row == 4) { return 7; } if (row == 1) { return 1; } return 4; }
    if (code == 51) { if (row == 0 || row == 2 || row == 4) { return 7; } return 1; }
    if (code == 52) { if (row == 0 || row == 1) { return 5; } if (row == 2) { return 7; } return 1; }
    if (code == 53) { if (row == 0 || row == 2 || row == 4) { return 7; } if (row == 1) { return 4; } return 1; }
    if (code == 54) { if (row == 0 || row == 2 || row == 4) { return 7; } if (row == 1) { return 4; } return 5; }
    if (code == 55) { if (row == 0) { return 7; } if (row == 1) { return 1; } return 2; }
    if (code == 56) { if (row == 0 || row == 2 || row == 4) { return 7; } return 5; }
    if (code == 57) { if (row == 0 || row == 2 || row == 4) { return 7; } if (row == 1) { return 5; } return 1; }
    if (code == 65) { if (row == 0) { return 2; } if (row == 2) { return 7; } return 5; }
    if (code == 66) { if (row == 0 || row == 2 || row == 4) { return 6; } return 5; }
    if (code == 67) { if (row == 0 || row == 4) { return 7; } return 4; }
    if (code == 68) { if (row == 0 || row == 4) { return 6; } return 5; }
    if (code == 69) { if (row == 0 || row == 4) { return 7; } if (row == 2) { return 6; } return 4; }
    if (code == 70) { if (row == 0) { return 7; } if (row == 2) { return 6; } return 4; }
    if (code == 71) { if (row == 0 || row == 4) { return 7; } if (row == 1) { return 4; } return 5; }
    if (code == 72) { if (row == 2) { return 7; } return 5; }
    if (code == 73) { if (row == 0 || row == 4) { return 7; } return 2; }
    if (code == 74) { if (row < 3) { return 1; } if (row == 3) { return 5; } return 7; }
    if (code == 75) { if (row == 2) { return 6; } return 5; }
    if (code == 76) { if (row == 4) { return 7; } return 4; }
    if (code == 77) { if (row == 1 || row == 2) { return 7; } return 5; }
    if (code == 78) { if (row == 1 || row == 2 || row == 3) { return 7; } return 5; }
    if (code == 79) { if (row == 0 || row == 4) { return 7; } return 5; }
    if (code == 80) { if (row == 0 || row == 2) { return 7; } if (row == 1) { return 5; } return 4; }
    if (code == 81) { if (row == 0) { return 7; } if (row == 4) { return 1; } if (row == 3) { return 7; } return 5; }
    if (code == 82) { if (row == 0 || row == 2) { return 6; } return 5; }
    if (code == 83) { if (row == 0 || row == 2 || row == 4) { return 7; } if (row == 1) { return 4; } return 1; }
    if (code == 84) { if (row == 0) { return 7; } return 2; }
    if (code == 85) { if (row == 4) { return 7; } return 5; }
    if (code == 86) { if (row == 4) { return 2; } return 5; }
    if (code == 87) { if (row == 2 || row == 3) { return 7; } return 5; }
    if (code == 88) { if (row == 2) { return 2; } return 5; }
    if (code == 89) { if (row < 2) { return 5; } return 2; }
    if (code == 90) { if (row == 0 || row == 4) { return 7; } if (row == 1) { return 1; } if (row == 2) { return 2; } return 4; }
    if (code == 45) { if (row == 2) { return 7; } return 0; }
    if (code == 46) { if (row == 4) { return 2; } return 0; }
    if (code == 44) { if (row == 3) { return 2; } if (row == 4) { return 4; } return 0; }
    if (code == 58) { if (row == 1 || row == 3) { return 2; } return 0; }
    if (code == 47) { if (row < 2) { return 1; } if (row == 2) { return 2; } return 4; }
    if (code == 38) { if (row == 0 || row == 2) { return 2; } if (row == 1 || row == 3) { return 5; } return 3; }
    if (code == 39) { if (row < 2) { return 2; } return 0; }
    if (code == 33) { if (row < 3 || row == 4) { return 2; } return 0; }
    if (row == 0) { return 7; }
    if (row == 1) { return 1; }
    if (row == 2) { return 2; }
    if (row == 4) { return 2; }
    return 0;
}

function original_draw_cached_label(font: i32, text: string, x: f32, y: f32, r: f32, g: f32, b: f32, a: f32): void {
    let run: i32 = gfx_cache_text(font, text);
    draw_text_cached(font, run, original_screen_x(x), original_screen_y(y), r, g, b, a);
}

