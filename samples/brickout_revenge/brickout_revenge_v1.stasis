function hud_glyph_A(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    let midx: f32 = x + s;
    draw_line(left, bottom, midx, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, bottom, midx, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(x + 0.5 * s, mid, x + 1.5 * s, mid, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_R(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_K(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_E(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_N(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_U(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_T(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    let midx: f32 = x + s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(midx, top, midx, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_H(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
}

function hud_draw_ms_logic(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_M(cx, y, s);
    cx = cx + adv;
    hud_glyph_S(cx, y, s);
    cx = cx + adv * 2.0;
    hud_glyph_L(cx, y, s);
    cx = cx + adv;
    hud_glyph_O(cx, y, s);
    cx = cx + adv;
    hud_glyph_G(cx, y, s);
    cx = cx + adv;
    hud_glyph_I(cx, y, s);
    cx = cx + adv;
    hud_glyph_C(cx, y, s);
}

function hud_draw_balls(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_B(cx, y, s); cx = cx + adv;
    hud_glyph_A(cx, y, s); cx = cx + adv;
    hud_glyph_L(cx, y, s); cx = cx + adv;
    hud_glyph_L(cx, y, s); cx = cx + adv;
    hud_glyph_S(cx, y, s);
}

function hud_draw_bricks(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_B(cx, y, s); cx = cx + adv;
    hud_glyph_R(cx, y, s); cx = cx + adv;
    hud_glyph_I(cx, y, s); cx = cx + adv;
    hud_glyph_C(cx, y, s); cx = cx + adv;
    hud_glyph_K(cx, y, s); cx = cx + adv;
    hud_glyph_S(cx, y, s);
}

function hud_draw_menu(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_M(cx, y, s); cx = cx + adv;
    hud_glyph_E(cx, y, s); cx = cx + adv;
    hud_glyph_N(cx, y, s); cx = cx + adv;
    hud_glyph_U(cx, y, s);
}

function hud_draw_tech(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_T(cx, y, s); cx = cx + adv;
    hud_glyph_E(cx, y, s); cx = cx + adv;
    hud_glyph_C(cx, y, s); cx = cx + adv;
    hud_glyph_H(cx, y, s);
}

function ui_pick_menu_slot(px: f32, py: f32, panel_x: f32, panel_y: f32, panel_w: f32, panel_h: f32): i32 {
    let slot_w: f32 = panel_w - UI_MENU_PAD * 2.0;
    let slot_y: f32 = panel_y + UI_MENU_HEADER_H + UI_MENU_PAD;
    let i: i32 = 0;
    for (i = 0; i < 3; i = i + 1) {
        let sy: f32 = slot_y + i32_to_f32(i) * (UI_MENU_SLOT_H + UI_MENU_SLOT_GAP);
        if (sy + UI_MENU_SLOT_H > panel_y + panel_h - UI_MENU_PAD) {
            return -1;
        }
        if (point_in_rect(px, py, panel_x + UI_MENU_PAD, sy, slot_w, UI_MENU_SLOT_H)) {
            return i;
        }
    }
    return -1;
}

function draw_menu_panel(x: f32, y: f32, w: f32, h: f32): void {
    draw_filled_rect(x, y, w, h, 0.08, 0.09, 0.12, 0.92);
    draw_rect(x, y, w, h, 0.2, 0.7, 0.9, 0.9);
    draw_line(x, y + UI_MENU_HEADER_H, x + w, y + UI_MENU_HEADER_H, 0.2, 0.7, 0.9, 0.6);
    hud_draw_menu(x + UI_MENU_PAD, y + 6.0, 3.0);

    let slot_w: f32 = w - UI_MENU_PAD * 2.0;
    let slot_y: f32 = y + UI_MENU_HEADER_H + UI_MENU_PAD;
    let i: i32 = 0;
    let slots_done: bool = false;
    for (i = 0; i < 3; i = i + 1) {
        if (!slots_done) {
            let sy: f32 = slot_y + i32_to_f32(i) * (UI_MENU_SLOT_H + UI_MENU_SLOT_GAP);
            if (sy + UI_MENU_SLOT_H > y + h - UI_MENU_PAD) {
                slots_done = true;
            } else {
                draw_rect(x + UI_MENU_PAD, sy, slot_w, UI_MENU_SLOT_H, 0.3, 0.6, 0.8, 0.8);
                let icon_handle: i32 = state.sprites.brick_basic_base;
                if (i == 1) { icon_handle = state.sprites.brick_armored_base; }
                if (i == 2) { icon_handle = state.sprites.brick_reflector_base; }
                if (icon_handle != 0) {
                    let icon_size: f32 = UI_MENU_SLOT_H - 10.0;
                    let max_size: f32 = slot_w - 12.0;
                    if (icon_size > max_size) { icon_size = max_size; }
                    if (icon_size > 4.0) {
                        let icon_x: f32 = x + UI_MENU_PAD + slot_w * 0.5;
                        let icon_y: f32 = sy + UI_MENU_SLOT_H * 0.5;
                        gfx_draw_sprite(icon_handle, f32_to_i32(icon_x), f32_to_i32(icon_y), f32_to_i32(icon_size), f32_to_i32(icon_size), 0, 255);
                    }
                }
                let selected: bool = false;
                if (i == 0 && state.selected_tower == BrickType.Basic) { selected = true; }
                if (i == 1 && state.selected_tower == BrickType.Armored) { selected = true; }
                if (i == 2 && state.selected_tower == BrickType.Reflector) { selected = true; }
                if (selected) {
                    draw_rect(x + UI_MENU_PAD - 2.0, sy - 2.0, slot_w + 4.0, UI_MENU_SLOT_H + 4.0, 0.9, 0.8, 0.3, 0.9);
                }
            }
        }
    }
}

function draw_tech_panel(x: f32, y: f32, w: f32, h: f32): void {
    draw_filled_rect(x, y, w, h, 0.06, 0.08, 0.12, 0.92);
    draw_rect(x, y, w, h, 0.2, 0.6, 0.9, 0.9);
    draw_line(x, y + UI_MENU_HEADER_H, x + w, y + UI_MENU_HEADER_H, 0.2, 0.6, 0.9, 0.6);
    hud_draw_tech(x + UI_MENU_PAD, y + 6.0, 3.0);

    let cx: f32 = x + w * 0.5;
    let top: f32 = y + UI_MENU_HEADER_H + UI_MENU_PAD + 10.0;
    let mid: f32 = y + UI_MENU_HEADER_H + UI_MENU_PAD + 60.0;
    let bot: f32 = y + UI_MENU_HEADER_H + UI_MENU_PAD + 110.0;
    let spread: f32 = w * 0.25;
    let radius: f32 = 8.0;

    draw_line(cx, top, cx - spread, mid, 0.4, 0.8, 0.9, 0.8);
    draw_line(cx, top, cx + spread, mid, 0.4, 0.8, 0.9, 0.8);
    draw_line(cx - spread, mid, cx - spread, bot, 0.4, 0.8, 0.9, 0.8);
    draw_line(cx + spread, mid, cx + spread, bot, 0.4, 0.8, 0.9, 0.8);

    draw_circle(cx, top, radius, 0.4, 0.9, 0.9, 0.9);
    draw_circle(cx - spread, mid, radius, 0.4, 0.9, 0.9, 0.9);
    draw_circle(cx + spread, mid, radius, 0.4, 0.9, 0.9, 0.9);
    draw_circle(cx - spread, bot, radius, 0.4, 0.9, 0.9, 0.9);
    draw_circle(cx + spread, bot, radius, 0.4, 0.9, 0.9, 0.9);
}

function draw_ui_panels(): void {
    if (state.layout.ui_w <= 1.0 || state.layout.ui_h <= 1.0) {
        return;
    }

    let pad: f32 = UI_PANEL_PAD;
    let gap: f32 = UI_PANEL_GAP;
    let ui_x: f32 = state.layout.ui_x;
    let ui_y: f32 = state.layout.ui_y;
    let ui_w: f32 = state.layout.ui_w;
    let ui_h: f32 = state.layout.ui_h;

    if (state.layout.ui_mode == 1) {
        let panel_w: f32 = ui_w - pad * 2.0;
        let panel_h: f32 = (ui_h - pad * 2.0 - gap) * 0.5;
        if (panel_w > 1.0 && panel_h > 1.0) {
            draw_menu_panel(ui_x + pad, ui_y + pad, panel_w, panel_h);
            draw_tech_panel(ui_x + pad, ui_y + pad + panel_h + gap, panel_w, panel_h);
        }
    } else {
        if (state.layout.ui_mode == 2) {
            let panel_w: f32 = (ui_w - pad * 2.0 - gap) * 0.5;
            let panel_h: f32 = ui_h - pad * 2.0;
            if (panel_w > 1.0 && panel_h > 1.0) {
                draw_menu_panel(ui_x + pad, ui_y + pad, panel_w, panel_h);
                draw_tech_panel(ui_x + pad + panel_w + gap, ui_y + pad, panel_w, panel_h);
            }
        }
    }
}

function draw_ui(): void {
    let sw: f32 = VIRTUAL_W;
    let sh: f32 = GAME_H;
    let s: f32 = state.layout.play_scale;

    // Score in top-left
    draw_number(state.score, play_to_screen_x(20.0), play_to_screen_y(10.0), 8.0 * s);

    // Wave indicator in top-right
    draw_number(state.wave, play_to_screen_x(sw - 60.0), play_to_screen_y(10.0), 8.0 * s);

    // Average frame time in bottom-left (in milliseconds with 1 decimal)
    let avg_time_tenths: i32 = frame_timer_avg_tenths(state.frame_timer.samples_ms);
    draw_decimal_1_tenths(avg_time_tenths, play_to_screen_x(20.0), play_to_screen_y(GAME_H - 30.0), 6.0 * s);
    hud_draw_ms_logic(play_to_screen_x(90.0), play_to_screen_y(GAME_H - 28.0), 3.0 * s);

    // Debug: Active counts in bottom-right
    let active_balls_count: i32 = count_active_balls();
    let active_bricks_count: i32 = count_active_bricks();
    hud_draw_balls(play_to_screen_x(sw - 190.0), play_to_screen_y(GAME_H - 52.0), 3.0 * s);
    draw_number(active_balls_count, play_to_screen_x(sw - 80.0), play_to_screen_y(GAME_H - 50.0), 4.0 * s);
    hud_draw_bricks(play_to_screen_x(sw - 190.0), play_to_screen_y(GAME_H - 32.0), 3.0 * s);
    draw_number(active_bricks_count, play_to_screen_x(sw - 80.0), play_to_screen_y(GAME_H - 30.0), 4.0 * s);

    if (state.phase == Phase.Lose) {
        // "LOSE" indicator
        play_draw_rect(sw / 2.0 - 40.0, sh / 2.0 - 20.0, 80.0, 40.0, 1.0, 0.3, 0.3, 1.0);
    }

    draw_ui_panels();
}

function draw_frame(): void {
    // Hot reload during development (no flags for now)
    if (state.sprites.paddle == 0) { } else { gfx_poll_reload(state.sprites.paddle); }
    if (state.sprites.ball == 0) { } else { gfx_poll_reload(state.sprites.ball); }
    if (state.sprites.brick_basic_base == 0) { } else { gfx_poll_reload(state.sprites.brick_basic_base); }
    if (state.sprites.brick_basic_turret == 0) { } else { gfx_poll_reload(state.sprites.brick_basic_turret); }
    if (state.sprites.brick_basic_fx == 0) { } else { gfx_poll_reload(state.sprites.brick_basic_fx); }
    if (state.sprites.brick_armored_base == 0) { } else { gfx_poll_reload(state.sprites.brick_armored_base); }
    if (state.sprites.brick_armored_turret == 0) { } else { gfx_poll_reload(state.sprites.brick_armored_turret); }
    if (state.sprites.brick_armored_fx == 0) { } else { gfx_poll_reload(state.sprites.brick_armored_fx); }
    if (state.sprites.brick_reflector_base == 0) { } else { gfx_poll_reload(state.sprites.brick_reflector_base); }
    if (state.sprites.brick_reflector_fx == 0) { } else { gfx_poll_reload(state.sprites.brick_reflector_fx); }

    draw_bricks();
    draw_balls();
    draw_paddle();
    draw_drag_preview();
    draw_ui();
    draw_tap_pulses();
}

// Timing
function compute_delta_ms(): i32 {
    let current_time: i32 = get_time_ms();
    let delta_ms: i32 = current_time - state.timers.last_time;
    if (delta_ms < 1) { delta_ms = 1; }
    if (delta_ms > 100) { delta_ms = 100; }
    state.timers.last_time = current_time;
    return delta_ms;
}

function update_drag_from_screen(screen_x: f32, screen_y: f32): void {
    state.drag_world_x = screen_to_play_x(screen_x);
    state.drag_world_y = screen_to_play_y(screen_y);
    state.drag_grid_x = world_to_grid_x(state.drag_world_x);
    state.drag_grid_y = world_to_grid_y(state.drag_world_y);

    let in_virtual: bool = point_in_rect(screen_x, screen_y, state.layout.play_x, state.layout.play_y, state.layout.play_w, state.layout.play_h);
    let in_game: bool = in_virtual && state.drag_world_y <= GAME_H;
    let valid: bool = in_game && grid_cell_fits_in_level(state.drag_grid_x, state.drag_grid_y);
    if (valid) {
        if (grid_is_occupied(state.drag_grid_x, state.drag_grid_y)) {
            valid = false;
        }
    }
    if (valid) {
        state.drag_valid = 1;
    } else {
        state.drag_valid = 0;
    }
}

function handle_pointer_input(): void {
    let count: i32 = input_pointer_count();
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        let pid: i32 = input_pointer_id(i);
        let went_down: bool = input_pointer_went_down(i);
        let went_up: bool = input_pointer_went_up(i);
        let is_down: bool = input_pointer_is_down(i);
        let sx: f32 = input_pointer_x_px(i) + state.layout.viewport_x;
        let sy: f32 = input_pointer_y_px(i) + state.layout.viewport_y;

        if (state.drag_active != 0) {
            if (pid == state.drag_pointer_id) {
                if (is_down) {
                    update_drag_from_screen(sx, sy);
                }
                if (went_up) {
                    if (state.drag_valid != 0) {
                        let placed: bool = place_brick_at_grid(state.drag_grid_x, state.drag_grid_y, state.selected_tower);
                        if (placed) {
                            sfx_play(SFX_DRAG_PLACE);
                        } else {
                            sfx_play(SFX_DRAG_INVALID);
                        }
                    } else {
                        sfx_play(SFX_DRAG_INVALID);
                    }
                    state.drag_active = 0;
                    state.drag_pointer_id = -1;
                    state.drag_valid = 0;
                }
            }
        } else {
            if (went_down) {
                let pad: f32 = UI_PANEL_PAD;
                let gap: f32 = UI_PANEL_GAP;
                let ui_x: f32 = state.layout.ui_x;
                let ui_y: f32 = state.layout.ui_y;
                let ui_w: f32 = state.layout.ui_w;
                let ui_h: f32 = state.layout.ui_h;
                let menu_x: f32 = ui_x + pad;
                let menu_y: f32 = ui_y + pad;
                let menu_w: f32 = 0.0;
                let menu_h: f32 = 0.0;
                let have_menu: bool = false;
                if (state.layout.ui_mode == 1) {
                    menu_w = ui_w - pad * 2.0;
                    menu_h = (ui_h - pad * 2.0 - gap) * 0.5;
                    have_menu = true;
                } else {
                    if (state.layout.ui_mode == 2) {
                        menu_w = (ui_w - pad * 2.0 - gap) * 0.5;
                        menu_h = ui_h - pad * 2.0;
                        have_menu = true;
                    }
                }

                if (have_menu && point_in_rect(sx, sy, menu_x, menu_y, menu_w, menu_h)) {
                    let slot: i32 = ui_pick_menu_slot(sx, sy, menu_x, menu_y, menu_w, menu_h);
                    if (slot == 0) { state.selected_tower = BrickType.Basic; state.cursor.brick_type = BrickType.Basic; sfx_play(SFX_SELECT); }
                    if (slot == 1) { state.selected_tower = BrickType.Armored; state.cursor.brick_type = BrickType.Armored; sfx_play(SFX_SELECT); }
                    if (slot == 2) { state.selected_tower = BrickType.Reflector; state.cursor.brick_type = BrickType.Reflector; sfx_play(SFX_SELECT); }
                } else {
                    let in_virtual: bool = point_in_rect(sx, sy, state.layout.play_x, state.layout.play_y, state.layout.play_w, state.layout.play_h);
                    let wx: f32 = screen_to_play_x(sx);
                    let wy: f32 = screen_to_play_y(sy);
                    let in_game: bool = in_virtual && wy <= GAME_H && wx >= 0.0 && wx <= VIRTUAL_W;
                    if (in_game) {
                        state.drag_active = 1;
                        state.drag_pointer_id = pid;
                        update_drag_from_screen(sx, sy);
                        sfx_play(SFX_DRAG_START);
                    }
                }
            }
        }
    }
}

function record_tap_pulses(): void {
    let count: i32 = input_pointer_count();
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        let went_down: bool = input_pointer_went_down(i);
        if (went_down) {
            let x: f32 = input_pointer_x_px(i);
            let y: f32 = input_pointer_y_px(i);
            let vx: f32 = state.layout.viewport_x;
            let vy: f32 = state.layout.viewport_y;
            let j: i32 = 0;
            let placed: bool = false;
            for (j = 0; j < MAX_TAP_PULSES; j = j + 1) {
                if (!placed) {
                    if (state.tap_pulses[j].active == 0) {
                        state.tap_pulses[j].active = 1;
                        state.tap_pulses[j].age_ms = 0;
                        state.tap_pulses[j].x = x + vx;
                        state.tap_pulses[j].y = y + vy;
                        placed = true;
                    }
                }
            }
        }
    }
}

function update_tap_pulses(delta_ms: i32): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_TAP_PULSES; i = i + 1) {
        if (state.tap_pulses[i].active != 0) {
            state.tap_pulses[i].age_ms = state.tap_pulses[i].age_ms + delta_ms;
            if (state.tap_pulses[i].age_ms >= TAP_PULSE_DURATION_MS) {
                state.tap_pulses[i].active = 0;
            }
        }
    }
}

function draw_tap_pulses(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_TAP_PULSES; i = i + 1) {
        if (state.tap_pulses[i].active != 0) {
            let age_f: f32 = i32_to_f32(state.tap_pulses[i].age_ms);
            let dur_f: f32 = i32_to_f32(TAP_PULSE_DURATION_MS);
            let t: f32 = age_f / dur_f;
            if (t > 1.0) { t = 1.0; }
            let radius: f32 = 8.0 + (48.0 * t);
            let alpha: f32 = 0.6 * (1.0 - t);
            draw_circle(state.tap_pulses[i].x, state.tap_pulses[i].y, radius, 0.2, 0.9, 1.0, alpha);
        }
    }
}

function draw_drag_preview(): void {
    if (state.drag_active == 0) { return; }
    if (!grid_in_bounds(state.drag_grid_x, state.drag_grid_y)) { return; }
    let x: f32 = grid_to_world_x(state.drag_grid_x);
    let y: f32 = grid_to_world_y(state.drag_grid_y);
    let w: f32 = state.config.brick.width;
    let h: f32 = state.config.brick.height;
    let r: f32 = 0.2;
    let g: f32 = 0.8;
    let b: f32 = 0.3;
    let a: f32 = 0.4;
    if (state.drag_valid == 0) {
        r = 0.9; g = 0.2; b = 0.2; a = 0.45;
    }
    play_draw_filled_rect(x, y, w, h, r, g, b, 0.12);
    play_draw_rect(x, y, w, h, r, g, b, a);
}

function main(): i32 {
    ensure_config_loaded();

    print_string("Brickout config loaded (magic=1337)\n");
    print_string("screen.w=");
    print_int(state.config.screen.w);
    print_string(" screen.h=");
    print_int(state.config.screen.h);
    print_string("\n");

    let init_ok: bool = init_window(state.config.screen.w, state.config.screen.h, "Brickout Revenge");
    if (!init_ok) {
        return 1;
    }

    maximize_window_for_desktop();
    sync_screen_size();
    print_string("window_px=");
    print_int(state.runtime_screen.w);
    print_string("x");
    print_int(state.runtime_screen.h);
    print_string("\n");

    audio_ready = audio_is_available();
    if (audio_ready) {
        audio_sr = audio_get_sample_rate();
    } else {
        audio_sr = 0;
    }

    state.runtime_screen.w = gfx_window_width();
    state.runtime_screen.h = gfx_window_height();
    state.layout.viewport_x = 0.0;
    state.layout.viewport_y = 0.0;
    state.layout.viewport_w = i32_to_f32(state.runtime_screen.w);
    state.layout.viewport_h = i32_to_f32(state.runtime_screen.h);
    state.layout.play_x = 0.0;
    state.layout.play_y = 0.0;
    state.layout.play_w = i32_to_f32(state.config.screen.w);
    state.layout.play_h = i32_to_f32(state.config.screen.h);
    state.layout.play_scale = 1.0;
    state.layout.ui_x = 0.0;
    state.layout.ui_y = 0.0;
    state.layout.ui_w = 0.0;
    state.layout.ui_h = 0.0;
    state.layout.ui_mode = 0;

    state.sprites.paddle = gfx_load_sprite("samples/brickout_revenge/assets/paddle.svg", 128, 24);
    state.sprites.ball = gfx_load_sprite("samples/brickout_revenge/assets/ball.svg", 32, 32);
    state.sprites.brick_basic_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic.svg", 160, 64);
    state.sprites.brick_basic_turret = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic_turret.svg", 160, 64);
    state.sprites.brick_basic_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic_fx.svg", 160, 64);
    state.sprites.brick_armored_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored.svg", 160, 64);
    state.sprites.brick_armored_turret = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored_turret.svg", 160, 64);
    state.sprites.brick_armored_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored_fx.svg", 160, 64);
    state.sprites.brick_reflector_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_reflector.svg", 160, 64);
    state.sprites.brick_reflector_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_reflector_fx.svg", 160, 64);

    if (state.initialized == 0) {
        // Use get_time_ms() so non-libc hosts (e.g. wasm) don't need C's time().
        seed_rng(get_time_ms());
        init_game(true);
        setup_default_bricks();
        start_wave();

        // Initialize frame time buffer with baseline value
        frame_timer_init(state.frame_timer.samples_ms);
        state.frame_timer.sample_index = frame_timer_reset_index();

        state.initialized = 1;
    }

    state.timers.last_time = get_time_ms();
    state.running = 1;
    return 0;
}

function tick(): i32 {
    if (state.running != 1) {
        return 1;
    }

    let quit: bool = should_quit();
    if (quit) {
        state.running = 0;
    }

    sync_screen_size();
    update_layout();
    apply_config_live();

    state.timers.frame_start = get_time_ms();

    if (is_key_down(Scancode.Escape)) {
        state.running = 0;
    }

    if (state.running != 1) {
        return 1;
    }

    handle_pointer_input();
    record_tap_pulses();

    begin_frame();
    clear(0.05, 0.05, 0.15, 1.0);

    let delta_ms: i32 = compute_delta_ms();
    let delta_f: f32 = i32_to_f32(delta_ms);
    let dt: f32 = delta_f / 1000.0;

    update_tap_pulses(delta_ms);
    update_game(dt, delta_ms);
    audio_update();
    draw_frame();

    // Measure frame time (logic + rendering prep, excluding vsync/swap/sleep)
    let frame_end: i32 = get_time_ms();
    state.timers.tick_time_ms = frame_end - state.timers.frame_start;
    if (state.timers.tick_time_ms < 0) { state.timers.tick_time_ms = 0; }

    // Store in circular buffer for averaging
    state.frame_timer.sample_index =
        frame_timer_push(state.frame_timer.samples_ms, state.frame_timer.sample_index, state.timers.tick_time_ms);

    end_frame();
    return 0;
}

