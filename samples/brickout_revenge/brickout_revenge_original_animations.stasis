function original_ball_standard_frame(frame: i32): i32 {
    let index: i32 = frame % 18;
    if (index < 0) { index += 18; }
    return original_ball_standard_frames[index];
}

function original_ball_curve_frame(frame: i32): i32 {
    let index: i32 = frame % 34;
    if (index < 0) { index += 34; }
    return original_ball_curve_frames[index];
}

