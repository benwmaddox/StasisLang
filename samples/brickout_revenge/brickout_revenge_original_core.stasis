// Pure gameplay definitions recovered from the published Flash build.

const ORIGINAL_FPS: i32 = 60;
const ORIGINAL_LEVEL_COUNT: i32 = 4;
const ORIGINAL_MAX_SPAWNS: i32 = 192;

enum OriginalScreen {
    MainMenu,
    CampaignMenu,
    FormerChallenges,
    UpgradePlaceholder,
    Game,
    Won,
    Lost
}

enum OriginalTowerKind {
    Wall,
    Standard,
    Rapid,
    Healer,
    Sniper,
    Rocket,
    Gold
}

enum OriginalBallKind {
    Standard,
    Fast,
    Slow,
    Curve,
    Swarm,
    Splitter,
    Fire,
    Mover
}

enum OriginalProjectileKind {
    Standard,
    Rapid,
    Sniper,
    Rocket,
    Explosion
}

global original_spawn_kind: OriginalBallKind[192];
global original_spawn_count: i32[192];
global original_spawn_level: i32[192];
global original_spawn_delay_ticks: i32[192];
global original_spawn_total: i32;

function original_seconds_to_ticks(seconds: i32): i32 {
    return seconds * ORIGINAL_FPS;
}

function original_add_spawn(kind: OriginalBallKind, count: i32, level: i32, delay_seconds: i32): void {
    if (original_spawn_total >= ORIGINAL_MAX_SPAWNS) { return; }
    let i: i32 = original_spawn_total;
    original_spawn_kind[i] = kind;
    original_spawn_count[i] = count;
    original_spawn_level[i] = level;
    original_spawn_delay_ticks[i] = original_seconds_to_ticks(delay_seconds);
    original_spawn_total = i + 1;
}

function original_tower_cost(kind: OriginalTowerKind, level: i32): i32 {
    if (kind == OriginalTowerKind.Wall) { return 10; }
    if (kind == OriginalTowerKind.Standard) { return 5 + level; }
    if (kind == OriginalTowerKind.Rapid) { return 15; }
    if (kind == OriginalTowerKind.Healer) { return 50 - 5 * level; }
    if (kind == OriginalTowerKind.Sniper) { return 50 + level; }
    if (kind == OriginalTowerKind.Rocket) { return 30; }
    if (kind == OriginalTowerKind.Gold) {
        if (level == 0) { return 50; }
        return 7 * level;
    }
    return 0;
}

function original_tower_starting_hp(kind: OriginalTowerKind, level: i32): i32 {
    if (kind == OriginalTowerKind.Wall) { return 25 + 20 * level; }
    if (kind == OriginalTowerKind.Gold) { return 20 + 10 * level; }
    return 10 + 5 * level;
}

function original_tower_max_hp(kind: OriginalTowerKind, level: i32): i32 {
    let starting: i32 = original_tower_starting_hp(kind, level);
    if (kind == OriginalTowerKind.Wall) { return starting + starting / 2; }
    return starting;
}

function original_tower_range(kind: OriginalTowerKind, level: i32): i32 {
    if (kind == OriginalTowerKind.Standard) { return 125 + 10 * level; }
    if (kind == OriginalTowerKind.Rapid) { return 125; }
    if (kind == OriginalTowerKind.Healer) { return 70 + 10 * level; }
    if (kind == OriginalTowerKind.Sniper) { return 200 + 15 * level; }
    if (kind == OriginalTowerKind.Rocket) { return 125 + 15 * level; }
    return 0;
}

function original_tower_damage(kind: OriginalTowerKind, level: i32): i32 {
    if (kind == OriginalTowerKind.Standard) { return 10; }
    if (kind == OriginalTowerKind.Rapid) { return 1 + level / 2; }
    if (kind == OriginalTowerKind.Sniper) { return 100 + 100 * level; }
    if (kind == OriginalTowerKind.Rocket) { return 10 + 8 * level; }
    return 0;
}

function original_tower_reload_ticks(kind: OriginalTowerKind, level: i32): i32 {
    if (kind == OriginalTowerKind.Standard) { return 180 - 24 * level; }
    if (kind == OriginalTowerKind.Rapid) { return 126 - 24 * level; }
    if (kind == OriginalTowerKind.Healer) { return 900 - 120 * level; }
    if (kind == OriginalTowerKind.Sniper) { return 1800 - 60 * level; }
    if (kind == OriginalTowerKind.Rocket) { return 600; }
    if (kind == OriginalTowerKind.Gold) { return 1260 - 240 * level; }
    return 999999;
}

function original_tower_projectile(kind: OriginalTowerKind): OriginalProjectileKind {
    if (kind == OriginalTowerKind.Rapid) { return OriginalProjectileKind.Rapid; }
    if (kind == OriginalTowerKind.Sniper) { return OriginalProjectileKind.Sniper; }
    if (kind == OriginalTowerKind.Rocket) { return OriginalProjectileKind.Rocket; }
    return OriginalProjectileKind.Standard;
}

function original_tower_can_fire(kind: OriginalTowerKind): bool {
    return kind == OriginalTowerKind.Standard ||
        kind == OriginalTowerKind.Rapid ||
        kind == OriginalTowerKind.Sniper ||
        kind == OriginalTowerKind.Rocket;
}

function original_ball_base_hp(kind: OriginalBallKind): i32 {
    return 80;
}

function original_ball_base_damage(kind: OriginalBallKind): i32 {
    if (kind == OriginalBallKind.Standard) { return 2; }
    if (kind == OriginalBallKind.Slow) { return 3; }
    return 1;
}

function original_ball_speed_min(kind: OriginalBallKind): i32 {
    if (kind == OriginalBallKind.Fast) { return 80; }
    if (kind == OriginalBallKind.Slow) { return 30; }
    if (kind == OriginalBallKind.Splitter) { return 40; }
    if (kind == OriginalBallKind.Swarm) { return 70; }
    return 50;
}

function original_ball_scaled_hp(kind: OriginalBallKind, level: i32): i32 {
    let hp: i32 = original_ball_base_hp(kind);
    return hp + hp * level / 15;
}

function original_ball_scaled_damage(kind: OriginalBallKind, level: i32): i32 {
    let damage: i32 = original_ball_base_damage(kind);
    return damage + damage * level / 15;
}

function original_level_initial_gold(level_index: i32): i32 {
    if (level_index == 0) { return 500; }
    if (level_index == 2) { return 115; }
    return 120;
}

function original_level_kill_gold(level_index: i32): i32 {
    if (level_index == 2) { return 10; }
    return 15;
}

function original_level_uses_gold_tower(level_index: i32): bool {
    return level_index == 2;
}

function original_level_init(level_index: i32): void {
    original_spawn_total = 0;
    if (level_index == 0) {
        original_init_marathon();
        return;
    }
    if (level_index == 1) {
        original_init_split_and_swarm();
        return;
    }
    if (level_index == 2) {
        original_init_test_level();
        return;
    }
    original_init_earthquake();
}

function original_init_split_and_swarm(): void {
    let level: i32 = 1;
    original_add_spawn(OriginalBallKind.Splitter, 3, level, 25); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 10, level, 25); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 10, level, 25); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 10, level, 25); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 10, level, 25); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 12, level, 1); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 2, level, 1); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 2, level, 1); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 2, level, 5); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 2, level, 5); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 2, level, 5); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 5, level, 5); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 10, level, 15); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 10, level, 15); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 2, level, 15); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 5, level, 30); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 10, level, 10); level += 1;
    original_add_spawn(OriginalBallKind.Splitter, 5, level, 10); level += 1;
    original_add_spawn(OriginalBallKind.Standard, 12, level, 15); level += 1;
    original_add_spawn(OriginalBallKind.Standard, 13, level, 15); level += 1;
    original_add_spawn(OriginalBallKind.Standard, 14, level, 15); level += 1;
    original_add_spawn(OriginalBallKind.Swarm, 30, level, 45);
}

function original_init_earthquake(): void {
    let level: i32 = 1;
    original_add_spawn(OriginalBallKind.Mover, 3, level, 25); level += 1;
    let i: i32 = 1;
    for (i = 1; i < 20; i += 1) {
        original_add_spawn(OriginalBallKind.Mover, 3 + level, level, 25);
        level += 1;
    }
    original_add_spawn(OriginalBallKind.Mover, 50, level, 25);
}

function original_init_test_level(): void {
    original_add_spawn(OriginalBallKind.Standard, 1, 1, 25);
    original_add_spawn(OriginalBallKind.Standard, 2, 1, 25);
    original_add_spawn(OriginalBallKind.Standard, 3, 1, 25);
    original_add_spawn(OriginalBallKind.Standard, 4, 1, 25);
    original_add_spawn(OriginalBallKind.Standard, 5, 1, 25);
    original_add_spawn(OriginalBallKind.Swarm, 2, 1, 11);
    original_add_spawn(OriginalBallKind.Swarm, 2, 1, 11);
    original_add_spawn(OriginalBallKind.Swarm, 2, 1, 11);
    let i: i32 = 0;
    for (i = 0; i < 6; i += 1) { original_add_spawn(OriginalBallKind.Swarm, 2, 1, 5); }
    original_add_spawn(OriginalBallKind.Swarm, 25, 1, 5);
    original_add_spawn(OriginalBallKind.Fire, 10, 1, 15);
    original_add_spawn(OriginalBallKind.Fire, 10, 1, 15);
    original_add_spawn(OriginalBallKind.Standard, 2, 1, 15);
    original_add_spawn(OriginalBallKind.Curve, 5, 1, 30);
    original_add_spawn(OriginalBallKind.Fast, 10, 1, 10);
    original_add_spawn(OriginalBallKind.Splitter, 5, 1, 10);
    original_add_spawn(OriginalBallKind.Standard, 12, 1, 15);
    original_add_spawn(OriginalBallKind.Standard, 13, 1, 15);
    original_add_spawn(OriginalBallKind.Standard, 14, 1, 15);
    original_add_spawn(OriginalBallKind.Swarm, 2, 1, 5);
    original_add_spawn(OriginalBallKind.Swarm, 25, 1, 5);
    original_add_spawn(OriginalBallKind.Curve, 5, 1, 10);
    original_add_spawn(OriginalBallKind.Fast, 10, 1, 10);
    original_add_spawn(OriginalBallKind.Fire, 10, 1, 10);
    original_add_spawn(OriginalBallKind.Slow, 10, 1, 10);
    original_add_spawn(OriginalBallKind.Splitter, 10, 1, 10);
    original_add_spawn(OriginalBallKind.Standard, 10, 1, 20);
    original_add_spawn(OriginalBallKind.Curve, 50, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 10, 1, 15);
    original_add_spawn(OriginalBallKind.Standard, 9, 1, 10);
    original_add_spawn(OriginalBallKind.Standard, 19, 1, 10);
    original_add_spawn(OriginalBallKind.Standard, 29, 1, 10);
    original_add_spawn(OriginalBallKind.Standard, 9, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 19, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 29, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 39, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 49, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 59, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 69, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 79, 1, 30);
    original_add_spawn(OriginalBallKind.Standard, 79, 1, 20);
    original_add_spawn(OriginalBallKind.Standard, 79, 1, 10);
}

function original_add_marathon_block(multiplier: i32, level: i32): i32 {
    let pass: i32 = 0;
    for (pass = 0; pass < 4; pass += 1) {
        original_add_spawn(OriginalBallKind.Standard, multiplier * 5, level, 45); level += 1;
        original_add_spawn(OriginalBallKind.Standard, multiplier * 5, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Standard, multiplier * 5, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Standard, multiplier * 5, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Standard, multiplier * 5, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Fast, multiplier * 2, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Fire, multiplier * 3, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Splitter, multiplier * 3, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Slow, multiplier * 15, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Swarm, level, 1, 15);
        original_add_spawn(OriginalBallKind.Curve, multiplier * 5, level, 15); level += 1;
        original_add_spawn(OriginalBallKind.Mover, multiplier * 2, level, 15); level += 1;
    }
    return level;
}

function original_init_marathon(): void {
    let level: i32 = 0;
    let multiplier: i32 = 1;
    for (multiplier = 1; multiplier < 4; multiplier += 1) {
        level = original_add_marathon_block(multiplier, level);
    }
}
