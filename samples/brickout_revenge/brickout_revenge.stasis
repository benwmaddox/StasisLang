import "../../src/stdlib/stdlib.stasis";
import "../../src/stdlib/frame_timer.stasis";

// Brickout Revenge - Tower Defense meets Breakout
// An auto-battler where you set up brick defenses and watch balls try to destroy them
//
// Live tuning:
// - Run with: `.\stasis.bat run samples\brickout_revenge\brickout_revenge.stasis --backend cranelift --graphics`
// - Edit: `samples/brickout_revenge/data/config.json` (hot-reloaded between ticks)

// External runtime APIs
// - init_window(width: i32, height: i32, title: string) -> bool
// - time() -> i64: returns unix timestamp for seeding PRNG
// - get_time_ms() -> i32: millisecond clock
// - sleep_ms(ms: i32): pause thread
// - should_quit() -> bool: polls SDL quit events
// - begin_frame(), end_frame(): bracket GPU work
// - clear(r: f32, g: f32, b: f32, a: f32): clears frame buffer
// - draw_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32)
// - gfx_load_sprite(path: string) -> i32
// - gfx_draw_sprite(handle: i32, x: f32, y: f32, sx: f32, sy: f32, rot: f32, r: f32, g: f32, b: f32, a: f32)
// - gfx_poll_reload(handle: i32) -> bool
// - is_key_down(scancode: i32) -> bool

// SDL Scancodes
const KEY_SPACE: i32 = 44;
const KEY_ESCAPE: i32 = 41;
const KEY_LEFT: i32 = 80;
const KEY_RIGHT: i32 = 79;
const KEY_UP: i32 = 82;
const KEY_DOWN: i32 = 81;
const KEY_RETURN: i32 = 40;

// Pool sizes (compile-time; keep in sync with the array sizes below)
const MAX_BRICKS: i32 = 50;
const MAX_BALLS: i32 = 90;

// Brick types
const BRICK_BASIC: i32 = 0;
const BRICK_ARMORED: i32 = 1;
const BRICK_REFLECTOR: i32 = 2;

// Game phases
const PHASE_SETUP: i32 = 0;
const PHASE_BATTLE: i32 = 1;
const PHASE_WIN: i32 = 2;
const PHASE_LOSE: i32 = 3;

// Math
const PI: f32 = 3.14159;

// Tunable parameters (loaded from JSON via runner data binding in dev)
struct BrickoutScreenConfig {
    w: i32;
    h: i32;
}

struct BrickoutGridConfig {
    origin_x: f32;
    margin_bottom: f32;
    spacing: f32;
}

struct BrickoutBrickConfig {
    width: f32;
    height: f32;
}

struct BrickoutPaddleConfig {
    y: f32;
    width: f32;
    height: f32;
    speed: f32;
}

struct BrickoutBallConfig {
    radius: f32;
    spawn_jitter_x: f32;
    clamp_margin_x: f32;
    vx_rand: f32;
    speed_min_base: f32;
    speed_min_per_wave: f32;
    speed_max_base: f32;
    speed_max_per_wave: f32;
    damage_base: i32;
    damage_wave_div: i32;
    hp_base: i32;
    hp_wave_div: i32;
    hp_scale: i32;
}

struct BrickoutWaveConfig {
    start_wave: i32;
    start_max_balls_wave: i32;
    max_balls_wave_add: i32;
    start_spawn_balls: i32;
}

struct BrickoutTimingConfig {
    frame_time_ms: i32;
    ball_spawn_cd_ms: i32;
    end_phase_restart_ms: i32;
}

struct BrickoutFxConfig {
    jiggle_threshold: i32;
    jiggle_degrees: f32;
    paddle_aim_degrees: f32;
    paddle_bounce_vx_scale: f32;
}

struct TowerStats {
    range: f32;
    cooldown_ms: i32;
    damage: i32;
    shot_fx_ms: i32;
}

struct BrickoutScoreConfig {
    ball_kill: i32;
    brick_kill: i32;
}

struct BrickoutConfig {
    screen: BrickoutScreenConfig;
    grid: BrickoutGridConfig;
    brick: BrickoutBrickConfig;
    paddle: BrickoutPaddleConfig;
    ball: BrickoutBallConfig;
    wave: BrickoutWaveConfig;
    timing: BrickoutTimingConfig;
    fx: BrickoutFxConfig;
    tower_basic: TowerStats;
    tower_armored: TowerStats;
    tower_reflector: TowerStats;
    score: BrickoutScoreConfig;
}

// Structs
struct Vec2 {
    x: f32;
    y: f32;
}

struct Ball {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    radius: f32;
    damage: i32;
    hp: i32;
    max_hp: i32;
    active: bool;
    bounce_streak: i32;
}

struct Brick {
    x: f32;
    y: f32;
    width: f32;
    height: f32;
    hp: i32;
    max_hp: i32;
    brick_type: i32;
    attack_cd_ms: i32;
    shot_fx_ms: i32;
    shot_tx: f32;
    shot_ty: f32;
    active: bool;
}

struct Paddle {
    x: f32;
    y: f32;
    width: f32;
    height: f32;
    speed: f32;
}

struct Cursor {
    grid_x: i32;
    grid_y: i32;
    brick_type: i32;
}

struct Timers {
    last_time: i32;
    frame_start: i32;
    ball_spawn_cd: i32;
    phase_timer: i32;
    tick_time_ms: i32;
}

struct BrickoutSprites {
    paddle: i32;
    ball: i32;
    brick_basic_base: i32;
    brick_basic_turret: i32;
    brick_basic_fx: i32;
    brick_armored_base: i32;
    brick_armored_turret: i32;
    brick_armored_fx: i32;
    brick_reflector_base: i32;
    brick_reflector_fx: i32;
}

struct GameState {
    config: BrickoutConfig;
    bricks: Brick[50];
    balls: Ball[900];
    paddle: Paddle;
    cursor: Cursor;
    timers: Timers;
    frame_timer: FrameTimer;
    initialized: i32;
    phase: i32;
    wave: i32;
    score: i32;
    balls_spawned: i32;
    max_balls_wave: i32;
    rng_state: i32;
    running: i32;
    sprites: BrickoutSprites;
}

global state: GameState;

// RNG functions
function seed_rng(seed: i32): void {
    state.rng_state = seed;
}

function next_rand(): i32 {
    state.rng_state = state.rng_state * 1103515245 + 12345;
    if (state.rng_state < 0) {
        state.rng_state = 0 - state.rng_state;
    }
    return state.rng_state;
}

function rand_float(max: f32): f32 {
    let r: i32 = next_rand() % 1000;
    let rf: f32 = r;
    return (rf / 1000.0) * max;
}

function rand_range(min: f32, max: f32): f32 {
    return min + rand_float(max - min);
}

// Math helpers
function abs_f32(x: f32): f32 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

function clamp_f32(val: f32, min: f32, max: f32): f32 {
    if (val < min) { return min; }
    if (val > max) { return max; }
    return val;
}

function sign_f32(x: f32): f32 {
    if (x < 0.0) { return -1.0; }
    if (x > 0.0) { return 1.0; }
    return 0.0;
}

function ensure_config_defaults(): void {
    // If JSON data binding didn't run (e.g. non-runner builds), keep reasonable defaults.
    if (state.config.screen.w > 0) {
        return;
    }

    state.config.screen.w = 800;
    state.config.screen.h = 600;

    state.config.grid.origin_x = 50.0;
    state.config.grid.margin_bottom = 50.0;
    state.config.grid.spacing = 5.0;

    state.config.brick.width = 60.0;
    state.config.brick.height = 20.0;

    state.config.paddle.y = 30.0;
    state.config.paddle.width = 100.0;
    state.config.paddle.height = 10.0;
    state.config.paddle.speed = 400.0;

    state.config.ball.radius = 6.0;
    state.config.ball.spawn_jitter_x = 30.0;
    state.config.ball.clamp_margin_x = 100.0;
    state.config.ball.vx_rand = 100.0;
    state.config.ball.speed_min_base = 150.0;
    state.config.ball.speed_min_per_wave = 10.0;
    state.config.ball.speed_max_base = 250.0;
    state.config.ball.speed_max_per_wave = 12.0;
    state.config.ball.damage_base = 1;
    state.config.ball.damage_wave_div = 4;
    state.config.ball.hp_base = 20;
    state.config.ball.hp_wave_div = 2;
    state.config.ball.hp_scale = 10;

    state.config.wave.start_wave = 1;
    state.config.wave.start_max_balls_wave = 5;
    state.config.wave.max_balls_wave_add = 2;
    state.config.wave.start_spawn_balls = MAX_BALLS;

    state.config.timing.frame_time_ms = 16;
    state.config.timing.ball_spawn_cd_ms = 1000;
    state.config.timing.end_phase_restart_ms = 3000;

    state.config.fx.jiggle_threshold = 10;
    state.config.fx.jiggle_degrees = 5.0;
    state.config.fx.paddle_aim_degrees = 15.0;
    state.config.fx.paddle_bounce_vx_scale = 200.0;

    state.config.tower_basic.range = 140.0;
    state.config.tower_basic.cooldown_ms = 220;
    state.config.tower_basic.damage = 1;
    state.config.tower_basic.shot_fx_ms = 90;

    state.config.tower_armored.range = 160.0;
    state.config.tower_armored.cooldown_ms = 320;
    state.config.tower_armored.damage = 2;
    state.config.tower_armored.shot_fx_ms = 90;

    state.config.tower_reflector.range = 190.0;
    state.config.tower_reflector.cooldown_ms = 180;
    state.config.tower_reflector.damage = 1;
    state.config.tower_reflector.shot_fx_ms = 90;

    state.config.score.ball_kill = 1;
    state.config.score.brick_kill = 10;
}

function apply_config_live(): void {
    // Apply a subset of config values every tick so hot-reload edits take effect immediately.
    //
    // Note: This is dev-only behavior; it trades determinism/stability for iteration speed.
    state.paddle.y = state.config.paddle.y;
    state.paddle.width = state.config.paddle.width;
    state.paddle.height = state.config.paddle.height;
    state.paddle.speed = state.config.paddle.speed;

    foreach (let brick in state.bricks) {
        brick.width = state.config.brick.width;
        brick.height = state.config.brick.height;
    }

    foreach (let ball in state.balls) {
        ball.radius = state.config.ball.radius;
    }
}

// Grid helpers - bricks are placed on a grid in the lower portion
function grid_to_world_x(gx: i32): f32 {
    let gxf: f32 = gx;
    return state.config.grid.origin_x + gxf * (state.config.brick.width + state.config.grid.spacing);
}

function grid_to_world_y(gy: i32): f32 {
    let gyf: f32 = gy;
    // Place bricks starting near the bottom and stack upward with the same spacing.
    let sh: f32 = state.config.screen.h;
    return sh - state.config.grid.margin_bottom - state.config.brick.height - gyf * (state.config.brick.height + state.config.grid.spacing);
}

// Initialization
function init_game(reset_progress: bool): void {
    // Clear all bricks
    foreach (let brick in state.bricks) {
        brick.active = false;
        brick.hp = 0;
        brick.max_hp = 0;
        brick.x = 0.0;
        brick.y = 0.0;
        brick.width = state.config.brick.width;
        brick.height = state.config.brick.height;
        brick.brick_type = BRICK_BASIC;
        brick.attack_cd_ms = 0;
        brick.shot_fx_ms = 0;
        brick.shot_tx = 0.0;
        brick.shot_ty = 0.0;
    }

    // Clear all balls
    foreach (let ball in state.balls) {
        ball.active = false;
        ball.x = 0.0;
        ball.y = 0.0;
        ball.vx = 0.0;
        ball.vy = 0.0;
        ball.radius = state.config.ball.radius;
        ball.damage = state.config.ball.damage_base;
        ball.hp = 0;
        ball.max_hp = 0;
        ball.bounce_streak = 0;
    }

    // Init paddle
    let sw: f32 = state.config.screen.w;
    state.paddle.x = sw / 2.0;
    state.paddle.y = state.config.paddle.y;
    state.paddle.width = state.config.paddle.width;
    state.paddle.height = state.config.paddle.height;
    state.paddle.speed = state.config.paddle.speed;

    // Init cursor
    state.cursor.grid_x = 3;
    state.cursor.grid_y = 3;
    state.cursor.brick_type = BRICK_BASIC;

    // Init timers
    state.timers.last_time = get_time_ms();
    state.timers.ball_spawn_cd = 0;
    state.timers.phase_timer = 0;
    state.timers.tick_time_ms = 0;

    frame_timer_init(state.frame_timer.samples_ms);
    state.frame_timer.sample_index = 0;

    // Game state
    // Start immediately in battle; no setup pause.
    state.phase = PHASE_BATTLE;
    state.balls_spawned = 0;
    state.running = 1;

    // Initialize frame time tracking
    // Note: Frame times will be filled with first actual measurement
    // to provide accurate average from the start
    state.frame_timer.sample_index = 0;

    if (reset_progress) {
        state.wave = state.config.wave.start_wave;
        state.score = 0;
        state.max_balls_wave = state.config.wave.start_max_balls_wave;
    }
}

function setup_default_bricks(): void {
    // Stress test: Fill the bottom of the screen with bricks
    let brick_idx: i32 = 0;
    let row: i32 = 0;
    let col: i32 = 0;

    // Fill 5 rows x 10 columns = 50 bricks (MAX_BRICKS)
    for (row = 0; row < 5; row = row + 1) {
        for (col = 0; col < 10; col = col + 1) {
            if (brick_idx < MAX_BRICKS) {
                state.bricks[brick_idx].active = true;
                state.bricks[brick_idx].x = grid_to_world_x(col);
                state.bricks[brick_idx].y = grid_to_world_y(row);
                state.bricks[brick_idx].attack_cd_ms = 0;
                state.bricks[brick_idx].shot_fx_ms = 0;

                // Mix brick types for variety
                let type_selector: i32 = (row + col) % 3;

                // Stress test: bricks have 10-30 HP
                let brick_hp: i32 = 10 + (next_rand() % 21);

                if (type_selector == 0) {
                    state.bricks[brick_idx].brick_type = BRICK_BASIC;
                    state.bricks[brick_idx].hp = brick_hp;
                    state.bricks[brick_idx].max_hp = brick_hp;
                }
                if (type_selector == 1) {
                    state.bricks[brick_idx].brick_type = BRICK_ARMORED;
                    state.bricks[brick_idx].hp = brick_hp;
                    state.bricks[brick_idx].max_hp = brick_hp;
                }
                if (type_selector == 2) {
                    state.bricks[brick_idx].brick_type = BRICK_REFLECTOR;
                    state.bricks[brick_idx].hp = brick_hp;
                    state.bricks[brick_idx].max_hp = brick_hp;
                }

                brick_idx = brick_idx + 1;
            }
        }
    }
}

function dist2(ax: f32, ay: f32, bx: f32, by: f32): f32 {
    let dx: f32 = ax - bx;
    let dy: f32 = ay - by;
    return dx * dx + dy * dy;
}

function update_brick_attacks(delta_ms: i32): void {
    foreach (let brick in state.bricks) {
        if (brick.active) {
            if (brick.attack_cd_ms > 0) {
                brick.attack_cd_ms = brick.attack_cd_ms - delta_ms;
            }
            if (brick.shot_fx_ms > 0) {
                brick.shot_fx_ms = brick.shot_fx_ms - delta_ms;
                if (brick.shot_fx_ms < 0) { brick.shot_fx_ms = 0; }
            }

            if (brick.attack_cd_ms < 1) {
                let range: f32 = state.config.tower_basic.range;
                let cd: i32 = state.config.tower_basic.cooldown_ms;
                let dmg: i32 = state.config.tower_basic.damage;
                let shot_fx_ms: i32 = state.config.tower_basic.shot_fx_ms;

                if (brick.brick_type == BRICK_ARMORED) {
                    range = state.config.tower_armored.range;
                    cd = state.config.tower_armored.cooldown_ms;
                    dmg = state.config.tower_armored.damage;
                    shot_fx_ms = state.config.tower_armored.shot_fx_ms;
                }
                if (brick.brick_type == BRICK_REFLECTOR) {
                    range = state.config.tower_reflector.range;
                    cd = state.config.tower_reflector.cooldown_ms;
                    dmg = state.config.tower_reflector.damage;
                    shot_fx_ms = state.config.tower_reflector.shot_fx_ms;
                }

                let range2: f32 = range * range;
                let bx: f32 = brick.x + brick.width / 2.0;
                let by: f32 = brick.y + brick.height / 2.0;

                let best_i: i32 = -1;
                let best_d2: f32 = range2 + 1.0;

                foreach (let ball, i in state.balls) {
                    if (ball.active) {
                        let d2v: f32 = dist2(bx, by, ball.x, ball.y);
                        if (d2v < best_d2) {
                            if (d2v <= range2) {
                                best_d2 = d2v;
                                best_i = i;
                            }
                        }
                    }
                }

                if (best_i == -1) {
                    // No target in range.
                } else {
                    state.balls[best_i].hp = state.balls[best_i].hp - dmg;
                    if (state.balls[best_i].hp < 1) {
                        state.balls[best_i].active = false;
                        state.score = state.score + state.config.score.ball_kill;
                    }
                    brick.attack_cd_ms = cd;
                    brick.shot_fx_ms = shot_fx_ms;
                    brick.shot_tx = state.balls[best_i].x;
                    brick.shot_ty = state.balls[best_i].y;
                }
            }
        }
    }
}

// Spawn a ball near the paddle, heading downward
function spawn_ball(): void {
    let sw: f32 = state.config.screen.w;
    foreach (let ball in state.balls) {
        if (!ball.active) {
            ball.active = true;
            let jitter: f32 = state.config.ball.spawn_jitter_x;
            ball.x = rand_range(state.paddle.x - jitter, state.paddle.x + jitter);
            let margin: f32 = state.config.ball.clamp_margin_x;
            if (ball.x < margin) { ball.x = margin; }
            if (ball.x > sw - margin) { ball.x = sw - margin; }

            ball.radius = state.config.ball.radius;
            ball.y = state.paddle.y + state.paddle.height / 2.0 + ball.radius + 2.0;
            let vr: f32 = state.config.ball.vx_rand;
            ball.vx = rand_range(0.0 - vr, vr);
            let wf: f32 = state.wave;
            let speed_min: f32 = state.config.ball.speed_min_base + wf * state.config.ball.speed_min_per_wave;
            let speed_max: f32 = state.config.ball.speed_max_base + wf * state.config.ball.speed_max_per_wave;
            ball.vy = rand_range(speed_min, speed_max);
            let div: i32 = state.config.ball.damage_wave_div;
            if (div < 1) { div = 1; }
            ball.damage = state.config.ball.damage_base + (state.wave / div);
            let hp_div: i32 = state.config.ball.hp_wave_div;
            if (hp_div < 1) { hp_div = 1; }
            ball.max_hp = (state.config.ball.hp_base + (state.wave / hp_div)) * state.config.ball.hp_scale;
            ball.hp = ball.max_hp;
            state.balls_spawned = state.balls_spawned + 1;
            return;
        }
    }
}

// Count active entities
function count_active_bricks(): i32 {
    let count: i32 = 0;
    foreach (let brick in state.bricks) {
        if (brick.active) {
            count = count + 1;
        }
    }
    return count;
}

function count_active_balls(): i32 {
    let count: i32 = 0;
    foreach (let ball in state.balls) {
        if (ball.active) {
            count = count + 1;
        }
    }
    return count;
}

// Physics update
function update_balls(dt: f32): void {
    let sw: f32 = state.config.screen.w;
    let sh: f32 = state.config.screen.h;
    foreach (let ball in state.balls) {
        if (ball.active) {
            // Move ball
            ball.x = ball.x + ball.vx * dt;
            ball.y = ball.y + ball.vy * dt;

            // Wall bounces (left, right, bottom)
            let bounced: bool = false;
            if (ball.x < ball.radius) {
                ball.x = ball.radius;
                ball.vx = abs_f32(ball.vx);
                bounced = true;
            }
            if (ball.x > sw - ball.radius) {
                ball.x = sw - ball.radius;
                ball.vx = 0.0 - abs_f32(ball.vx);
                bounced = true;
            }
            if (ball.y > sh - ball.radius) {
                ball.y = sh - ball.radius;
                ball.vy = 0.0 - abs_f32(ball.vy);
                bounced = true;
            }
            if (bounced) {
                ball.bounce_streak = ball.bounce_streak + 1;
                if (ball.bounce_streak >= state.config.fx.jiggle_threshold) {
                    ball.bounce_streak = 0;
                    let jiggle_rad: f32 = state.config.fx.jiggle_degrees * (PI / 180.0);
                    let angle: f32 = rand_range(0.0 - jiggle_rad, jiggle_rad);
                    let c: f32 = cos_fast(angle);
                    let s: f32 = sin_fast(angle);
                    let old_vx: f32 = ball.vx;
                    let old_vy: f32 = ball.vy;
                    ball.vx = old_vx * c - old_vy * s;
                    ball.vy = old_vx * s + old_vy * c;
                }
            }

            // Ball flies past the top - deactivate
            if (ball.y < (0.0 - ball.radius)) {
                ball.active = false;
            }
        }
    }
}

// Paddle AI - tracks nearest ball
function update_paddle(dt: f32): void {
    state.paddle.speed = state.config.paddle.speed;
    // Find nearest ball heading up toward the top paddle
    let nearest_x: f32 = state.paddle.x;
    let nearest_dist: f32 = 99999.0;
    let found: bool = false;

    foreach (let ball in state.balls) {
        if (ball.active) {
            if (ball.vy < 0.0) {
                let dx: f32 = abs_f32(ball.x - state.paddle.x);
                let dy: f32 = abs_f32(ball.y - state.paddle.y);
                let dist: f32 = dx + dy;
                if (dist < nearest_dist) {
                    nearest_dist = dist;
                    nearest_x = ball.x;
                    found = true;
                }
            }
        }
    }

    if (found) {
        // Move paddle toward ball
        let diff: f32 = nearest_x - state.paddle.x;
        let move_dist: f32 = state.paddle.speed * dt;

        if (abs_f32(diff) < move_dist) {
            state.paddle.x = nearest_x;
        } else {
            state.paddle.x = state.paddle.x + sign_f32(diff) * move_dist;
        }
    }

    // Clamp paddle to screen
    let half_w: f32 = state.paddle.width / 2.0;
    let sw: f32 = state.config.screen.w;
    state.paddle.x = clamp_f32(state.paddle.x, half_w, sw - half_w);
}

// Ball-paddle collision
function check_paddle_collisions(): void {
    let px: f32 = state.paddle.x;
    let py: f32 = state.paddle.y;
    let pw: f32 = state.paddle.width;
    let ph: f32 = state.paddle.height;

    foreach (let ball in state.balls) {
        if (ball.active) {
            if (ball.vy < 0.0) {
                // Simple AABB check
                let bx: f32 = ball.x;
                let by: f32 = ball.y;
                let br: f32 = ball.radius;

                let left: f32 = px - pw / 2.0;
                let right: f32 = px + pw / 2.0;
                let top: f32 = py - ph / 2.0;
                let bottom: f32 = py + ph / 2.0;

                // Check AABB collision
                let hit_x: bool = false;
                let hit_y: bool = false;
                if (bx + br > left) {
                    if (bx - br < right) {
                        hit_x = true;
                    }
                }
                if (by + br > top) {
                    if (by - br < bottom) {
                        hit_y = true;
                    }
                }

                if (hit_x) {
                    if (hit_y) {
                        // Bounce with angle based on hit position
                        ball.vy = abs_f32(ball.vy);

                        // Offset determines angle
                        let offset: f32 = (bx - px) / (pw / 2.0);
                        ball.vx = offset * state.config.fx.paddle_bounce_vx_scale;

                        // Move ball out of paddle
                        ball.y = bottom + br + 1.0;
                        ball.bounce_streak = ball.bounce_streak + 1;
                        if (ball.bounce_streak >= state.config.fx.jiggle_threshold) {
                            ball.bounce_streak = 0;
                            // Find first active brick and angle ball toward it (up to 15 degrees)
                            let found_brick: bool = false;
                            let brick_cx: f32 = 0.0;
                            let brick_cy: f32 = 0.0;
                            foreach (let brick in state.bricks) {
                                if (brick.active) {
                                    if (!found_brick) {
                                        brick_cx = brick.x + brick.width / 2.0;
                                        brick_cy = brick.y + brick.height / 2.0;
                                        found_brick = true;
                                    }
                                }
                            }

                            if (found_brick) {
                                // Calculate direction to brick
                                let tx: f32 = brick_cx - bx;
                                let ty: f32 = brick_cy - by;

                                // Use cross product to determine which way to rotate
                                // cross = vx * ty - vy * tx
                                let cross: f32 = ball.vx * ty - ball.vy * tx;

                                // Apply up to 15 degrees rotation toward the brick
                                let max_adjustment: f32 = state.config.fx.paddle_aim_degrees * (PI / 180.0);
                                let angle: f32 = 0.0;
                                if (cross > 0.0) {
                                    // Rotate counterclockwise
                                    angle = max_adjustment;
                                } else {
                                    // Rotate clockwise
                                    angle = 0.0 - max_adjustment;
                                }

                                let c: f32 = cos_fast(angle);
                                let s: f32 = sin_fast(angle);
                                let old_vx: f32 = ball.vx;
                                let old_vy: f32 = ball.vy;
                                ball.vx = old_vx * c - old_vy * s;
                                ball.vy = old_vx * s + old_vy * c;
                            }
                        }
                    }
                }
            }
        }
    }
}

function compute_ball_spawn_cd_ms(): i32 {
    // Stress test: spawn a ball every second
    return state.config.timing.ball_spawn_cd_ms;
}

function start_wave(): void {
    state.balls_spawned = 0;
    state.timers.ball_spawn_cd = compute_ball_spawn_cd_ms();

    // Stress test: spawn a bunch of balls at the start
    let n: i32 = state.config.wave.start_spawn_balls;
    if (n < 0) { n = 0; }
    if (n > MAX_BALLS) { n = MAX_BALLS; }
    let i: i32 = 0;
    for (i = 0; i < n; i = i + 1) {
        spawn_ball();
    }
}

// Ball-brick collision
function check_brick_collisions(): void {
    foreach (let ball in state.balls) {
        if (ball.active) {
            foreach (let brick in state.bricks) {
                if (brick.active) {
                    // AABB collision
                    let bx: f32 = ball.x;
                    let by: f32 = ball.y;
                    let br: f32 = ball.radius;

                    let left: f32 = brick.x;
                    let right: f32 = brick.x + brick.width;
                    let top: f32 = brick.y;
                    let bottom: f32 = brick.y + brick.height;

                    // Check AABB collision
                    let brick_hit_x: bool = false;
                    let brick_hit_y: bool = false;
                    if (bx + br > left) {
                        if (bx - br < right) {
                            brick_hit_x = true;
                        }
                    }
                    if (by + br > top) {
                        if (by - br < bottom) {
                            brick_hit_y = true;
                        }
                    }

                    if (brick_hit_x) {
                        if (brick_hit_y) {
                            // Hit! Damage brick
                            brick.hp = brick.hp - ball.damage;
                            if (brick.hp < 1) {
                                brick.active = false;
                                state.score = state.score + state.config.score.brick_kill;
                            }

                            // Bounce ball
                            // Determine collision side
                            let dx_left: f32 = abs_f32(bx - left);
                            let dx_right: f32 = abs_f32(bx - right);
                            let dy_top: f32 = abs_f32(by - top);
                            let dy_bottom: f32 = abs_f32(by - bottom);

                            let min_d: f32 = dx_left;
                            if (dx_right < min_d) { min_d = dx_right; }
                            if (dy_top < min_d) { min_d = dy_top; }
                            if (dy_bottom < min_d) { min_d = dy_bottom; }

                            // Check if horizontal or vertical bounce
                            let horiz_bounce: bool = false;
                            if (min_d == dx_left) { horiz_bounce = true; }
                            if (min_d == dx_right) { horiz_bounce = true; }

                            if (horiz_bounce) {
                                ball.vx = 0.0 - ball.vx;
                            } else {
                                ball.vy = 0.0 - ball.vy;
                            }
                            ball.bounce_streak = 0;

                            // Reflector type adds randomness
                            if (brick.brick_type == BRICK_REFLECTOR) {
                                ball.vx = ball.vx + rand_range(-50.0, 50.0);
                                ball.vy = ball.vy + rand_range(-50.0, 50.0);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Input handling for setup phase
function handle_setup_input(): void {
    // Arrow keys move cursor
    // (simplified - in full version would track key press/release)
}

// Update game logic
function update_game(dt: f32, delta_ms: i32): void {
    if (state.phase == PHASE_BATTLE) {
        // Spawn balls periodically (stress test: no limit)
        state.timers.ball_spawn_cd = state.timers.ball_spawn_cd - delta_ms;
        if (state.timers.ball_spawn_cd < 0) {
            spawn_ball();
            state.timers.ball_spawn_cd = compute_ball_spawn_cd_ms();
        }

        // Update physics
        update_balls(dt);
        update_paddle(dt);
        update_brick_attacks(delta_ms);
        check_paddle_collisions();
        check_brick_collisions();

        // Check win/lose
        let active_bricks: i32 = count_active_bricks();
        let active_balls: i32 = count_active_balls();

        if (active_bricks == 0) {
            state.phase = PHASE_LOSE; // All bricks destroyed = player loses
            state.timers.phase_timer = 0;
        }

        // Check if all balls spawned and none active = survived wave
        let all_spawned: bool = state.balls_spawned > (state.max_balls_wave - 1);
        if (all_spawned) {
            if (active_balls == 0) {
                // Survived the wave: immediately start the next wave (no pause banner).
                state.wave = state.wave + 1;
                state.max_balls_wave = state.max_balls_wave + state.config.wave.max_balls_wave_add;
                start_wave();
            }
        }
    }

    // Handle end phases (WIN or LOSE)
    let in_end_phase: bool = false;
    if (state.phase == PHASE_LOSE) { in_end_phase = true; }

    if (in_end_phase) {
        state.timers.phase_timer = state.timers.phase_timer + delta_ms;
        if (state.timers.phase_timer > state.config.timing.end_phase_restart_ms) {
            // Restart
            init_game(true);
            setup_default_bricks();
            start_wave();
        }
    }
}

// Drawing functions
function draw_rect(x: f32, y: f32, w: f32, h: f32, r: f32, g: f32, b: f32, a: f32): void {
    // Draw rectangle as 4 lines
    draw_line(x, y, x + w, y, r, g, b, a);
    draw_line(x + w, y, x + w, y + h, r, g, b, a);
    draw_line(x + w, y + h, x, y + h, r, g, b, a);
    draw_line(x, y + h, x, y, r, g, b, a);
}

function draw_filled_rect(x: f32, y: f32, w: f32, h: f32, r: f32, g: f32, b: f32, a: f32): void {
    // Draw filled rectangle with horizontal lines
    let line_y: f32 = y;
    for (line_y = y; line_y < y + h; line_y = line_y + 2.0) {
        draw_line(x, line_y, x + w, line_y, r, g, b, a);
    }
}

function draw_circle(cx: f32, cy: f32, radius: f32, r: f32, g: f32, b: f32, a: f32): void {
    // Draw circle as octagon
    let segments: i32 = 8;
    let i: i32 = 0;
    let prev_x: f32 = cx + radius;
    let prev_y: f32 = cy;

    for (i = 1; i < (segments + 1); i = i + 1) {
        let fi: f32 = i;
        let seg_f: f32 = segments;
        let angle: f32 = (fi / seg_f) * 2.0 * PI;
        let px: f32 = cx + cos_fast(angle) * radius;
        let py: f32 = cy + sin_fast(angle) * radius;
        draw_line(prev_x, prev_y, px, py, r, g, b, a);
        prev_x = px;
        prev_y = py;
    }
}

function draw_bricks(): void {
    let now_ms: i32 = get_time_ms();
    let t_mod: i32 = now_ms % 2000;
    let t_f: f32 = t_mod;
    let phase: f32 = (t_f / 2000.0) * 2.0 * PI;
    let wave: f32 = sin_fast(phase);
    let pulse: f32 = 0.5 + 0.5 * wave;
    let fx_alpha: f32 = 0.10 + 0.20 * pulse;

    foreach (let brick in state.bricks) {
        if (brick.active) {
            let h_base: i32 = state.sprites.brick_basic_base;
            let h_turret: i32 = state.sprites.brick_basic_turret;
            let h_fx: i32 = state.sprites.brick_basic_fx;
            if (brick.brick_type == BRICK_BASIC) {
                h_base = state.sprites.brick_basic_base;
                h_turret = state.sprites.brick_basic_turret;
                h_fx = state.sprites.brick_basic_fx;
            }
            if (brick.brick_type == BRICK_ARMORED) {
                h_base = state.sprites.brick_armored_base;
                h_turret = state.sprites.brick_armored_turret;
                h_fx = state.sprites.brick_armored_fx;
            }
            if (brick.brick_type == BRICK_REFLECTOR) {
                h_base = state.sprites.brick_reflector_base;
                h_turret = 0;
                h_fx = state.sprites.brick_reflector_fx;
            }

            let cx: f32 = brick.x + brick.width / 2.0;
            let cy: f32 = brick.y + brick.height / 2.0;
            let sx: f32 = brick.width / 160.0;  // sprite viewBox width
            let sy: f32 = brick.height / 64.0;  // sprite viewBox height

            if (h_base != 0) {
                gfx_draw_sprite(h_base, cx, cy, sx, sy, 0.0, 1.0, 1.0, 1.0, 1.0);
            }

            // Turret bob/pulse (driven by time; no SVG animation tags)
            if (h_turret != 0) {
                let seed: f32 = cx * 0.013 + cy * 0.021;
                let wobble: f32 = sin_fast(phase + seed);
                let oy: f32 = wobble * 1.4;
                let rot: f32 = wobble * 0.05;
                let a: f32 = 0.85 + 0.15 * (0.5 + 0.5 * wobble);
                gfx_draw_sprite(h_turret, cx, cy + oy, sx, sy, rot, 1.0, 1.0, 1.0, a);
            }

            // Effects layer (pulse alpha)
            if (h_fx != 0) {
                let a: f32 = fx_alpha;
                if (brick.brick_type == BRICK_REFLECTOR) {
                    a = 0.12 + 0.28 * (0.5 + 0.5 * sin_fast(phase * 1.7));
                }
                gfx_draw_sprite(h_fx, cx, cy, sx, sy, 0.0, 1.0, 1.0, 1.0, a);
            }

            // Shot tracer (tower attack feedback)
            if (brick.shot_fx_ms > 0) {
                let a: f32 = brick.shot_fx_ms;
                let alpha: f32 = a / 90.0;
                let sr: f32 = 1.0;
                let sg: f32 = 0.4;
                let sb: f32 = 0.2;
                if (brick.brick_type == BRICK_ARMORED) { sr = 0.6; sg = 0.8; sb = 1.0; }
                if (brick.brick_type == BRICK_REFLECTOR) { sr = 0.7; sg = 0.3; sb = 1.0; }
                draw_line(cx, cy, brick.shot_tx, brick.shot_ty, sr, sg, sb, alpha);
            }

            // Draw HP indicator for armored
            if (brick.hp > 1) {
                let hp_x: f32 = brick.x + brick.width / 2.0 - 5.0;
                let hp_y: f32 = brick.y + brick.height / 2.0;
                draw_line(hp_x, hp_y, hp_x + 10.0, hp_y, 1.0, 1.0, 1.0, 1.0);
            }
        }
    }
}

function draw_balls(): void {
    foreach (let ball in state.balls) {
        if (ball.active) {
            let scale: f32 = (ball.radius * 2.0) / 32.0;
            if (state.sprites.ball == 0) {
                draw_circle(ball.x, ball.y, ball.radius, 1.0, 0.3, 1.0, 1.0);
            } else {
                gfx_draw_sprite(state.sprites.ball, ball.x, ball.y, scale, scale, 0.0, 1.0, 1.0, 1.0, 1.0);
            }

            // Ball HP bar
            if (ball.max_hp > 0) {
                if (ball.hp < ball.max_hp) {
                    let hp_f: f32 = ball.hp;
                    let max_f: f32 = ball.max_hp;
                    let t: f32 = hp_f / max_f;
                    let y: f32 = ball.y - ball.radius - 10.0;
                    draw_line(ball.x - 16.0, y, ball.x + 16.0, y, 0.2, 0.2, 0.2, 0.9);
                    draw_line(ball.x - 16.0, y, ball.x - 16.0 + 32.0 * t, y, 0.9, 0.3, 0.9, 0.9);
                }
            }
        }
    }
}

function draw_paddle(): void {
    let sx: f32 = state.paddle.width / 128.0;
    let sy: f32 = state.paddle.height / 24.0;
    if (state.sprites.paddle == 0) {
        let px: f32 = state.paddle.x - state.paddle.width / 2.0;
        let py: f32 = state.paddle.y - state.paddle.height / 2.0;
        draw_filled_rect(px, py, state.paddle.width, state.paddle.height, 0.3, 1.0, 1.0, 1.0);
    } else {
        gfx_draw_sprite(state.sprites.paddle, state.paddle.x, state.paddle.y, sx, sy, 0.0, 1.0, 1.0, 1.0, 1.0);
    }
}

// 7-segment digit display (from asteroids)
function draw_digit(digit: i32, x: f32, y: f32, scale: f32): void {
    let seg0: bool = false;
    let seg1: bool = false;
    let seg2: bool = false;
    let seg3: bool = false;
    let seg4: bool = false;
    let seg5: bool = false;
    let seg6: bool = false;

    if (digit == 0) { seg0 = true; seg1 = true; seg2 = true; seg3 = true; seg4 = true; seg5 = true; }
    if (digit == 1) { seg1 = true; seg2 = true; }
    if (digit == 2) { seg0 = true; seg1 = true; seg6 = true; seg4 = true; seg3 = true; }
    if (digit == 3) { seg0 = true; seg1 = true; seg6 = true; seg2 = true; seg3 = true; }
    if (digit == 4) { seg5 = true; seg6 = true; seg1 = true; seg2 = true; }
    if (digit == 5) { seg0 = true; seg5 = true; seg6 = true; seg2 = true; seg3 = true; }
    if (digit == 6) { seg0 = true; seg5 = true; seg6 = true; seg2 = true; seg3 = true; seg4 = true; }
    if (digit == 7) { seg0 = true; seg1 = true; seg2 = true; }
    if (digit == 8) { seg0 = true; seg1 = true; seg2 = true; seg3 = true; seg4 = true; seg5 = true; seg6 = true; }
    if (digit == 9) { seg0 = true; seg1 = true; seg5 = true; seg6 = true; seg2 = true; seg3 = true; }

    let top: f32 = y;
    let mid: f32 = y + scale;
    let bot: f32 = y + scale * 2.0;
    let left: f32 = x;
    let right: f32 = x + scale;

    if (seg0) { draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0); }
    if (seg1) { draw_line(right, top, right, mid, 1.0, 1.0, 1.0, 1.0); }
    if (seg2) { draw_line(right, mid, right, bot, 1.0, 1.0, 1.0, 1.0); }
    if (seg3) { draw_line(left, bot, right, bot, 1.0, 1.0, 1.0, 1.0); }
    if (seg4) { draw_line(left, mid, left, bot, 1.0, 1.0, 1.0, 1.0); }
    if (seg5) { draw_line(left, top, left, mid, 1.0, 1.0, 1.0, 1.0); }
    if (seg6) { draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0); }
}

function draw_number(num: i32, x: f32, y: f32, scale: f32): void {
    // Draw up to 4 digits
    let n: i32 = num;
    if (n < 0) { n = 0; }
    if (n > 9999) { n = 9999; }

    let d0: i32 = n % 10;
    let d1: i32 = (n / 10) % 10;
    let d2: i32 = (n / 100) % 10;
    let d3: i32 = (n / 1000) % 10;

    let spacing: f32 = scale * 1.5;

    if (n > 999) {
        draw_digit(d3, x, y, scale);
        draw_digit(d2, x + spacing, y, scale);
        draw_digit(d1, x + spacing * 2.0, y, scale);
        draw_digit(d0, x + spacing * 3.0, y, scale);
    } else {
        if (n > 99) {
            draw_digit(d2, x, y, scale);
            draw_digit(d1, x + spacing, y, scale);
            draw_digit(d0, x + spacing * 2.0, y, scale);
        } else {
            if (n > 9) {
                draw_digit(d1, x, y, scale);
                draw_digit(d0, x + spacing, y, scale);
            } else {
                draw_digit(d0, x, y, scale);
            }
        }
    }
}

function draw_decimal_1(value: f32, x: f32, y: f32, scale: f32): void {
    // Draw a float with 1 decimal place (e.g., 3.5)
    let int_part: i32 = value;
    let int_part_f: f32 = int_part;
    let decimal_f: f32 = (value - int_part_f) * 10.0;
    let decimal_part: i32 = decimal_f;

    // Draw integer part
    draw_number(int_part, x, y, scale);

    // Calculate width of integer part for positioning
    let int_digits: i32 = 1;
    if (int_part > 9) { int_digits = 2; }
    if (int_part > 99) { int_digits = 3; }

    let spacing: f32 = scale * 1.5;
    let int_width: f32 = int_digits;
    let decimal_x: f32 = x + int_width * spacing;

    // Draw decimal point (small filled square)
    let dot_size: f32 = scale * 0.2;
    let dot_y: f32 = y + scale * 1.7;
    draw_filled_rect(decimal_x, dot_y, dot_size, dot_size, 1.0, 1.0, 1.0, 1.0);

    // Draw decimal digit
    let digit_x: f32 = decimal_x + spacing * 0.3;
    draw_digit(decimal_part, digit_x, y, scale);
}

function draw_decimal_1_tenths(value_tenths: i32, x: f32, y: f32, scale: f32): void {
    let int_part: i32 = value_tenths / 10;
    let decimal_part: i32 = value_tenths - int_part * 10;

    // Draw integer part
    draw_number(int_part, x, y, scale);

    // Calculate width of integer part for positioning
    let int_digits: i32 = 1;
    if (int_part > 9) { int_digits = 2; }
    if (int_part > 99) { int_digits = 3; }
    if (int_part > 999) { int_digits = 4; }

    let spacing: f32 = scale * 1.5;
    let int_width: f32 = int_digits;
    let decimal_x: f32 = x + int_width * spacing;

    // Draw decimal point (small filled square)
    let dot_size: f32 = scale * 0.2;
    let dot_y: f32 = y + scale * 1.7;
    draw_filled_rect(decimal_x, dot_y, dot_size, dot_size, 1.0, 1.0, 1.0, 1.0);

    // Draw decimal digit
    let digit_x: f32 = decimal_x + spacing * 0.3;
    draw_digit(decimal_part, digit_x, y, scale);
}

function hud_glyph_M(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    let midx: f32 = x + s;
    draw_line(left, bottom, left, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, bottom, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, midx, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, midx, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_S(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, left, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_L(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_O(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_G(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    let midx: f32 = x + s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(midx, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_I(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    let midx: f32 = x + s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(midx, top, midx, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_C(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_B(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, bottom, right, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_A(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    let midx: f32 = x + s;
    draw_line(left, bottom, midx, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, bottom, midx, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(x + 0.5 * s, mid, x + 1.5 * s, mid, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_R(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(right, top, right, mid, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_glyph_K(x: f32, y: f32, s: f32): void {
    let left: f32 = x;
    let right: f32 = x + 2.0 * s;
    let top: f32 = y;
    let mid: f32 = y + s;
    let bottom: f32 = y + 2.0 * s;
    draw_line(left, top, left, bottom, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, top, 1.0, 1.0, 1.0, 1.0);
    draw_line(left, mid, right, bottom, 1.0, 1.0, 1.0, 1.0);
}

function hud_draw_ms_logic(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_M(cx, y, s);
    cx = cx + adv;
    hud_glyph_S(cx, y, s);
    cx = cx + adv * 2.0;
    hud_glyph_L(cx, y, s);
    cx = cx + adv;
    hud_glyph_O(cx, y, s);
    cx = cx + adv;
    hud_glyph_G(cx, y, s);
    cx = cx + adv;
    hud_glyph_I(cx, y, s);
    cx = cx + adv;
    hud_glyph_C(cx, y, s);
}

function hud_draw_balls(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_B(cx, y, s); cx = cx + adv;
    hud_glyph_A(cx, y, s); cx = cx + adv;
    hud_glyph_L(cx, y, s); cx = cx + adv;
    hud_glyph_L(cx, y, s); cx = cx + adv;
    hud_glyph_S(cx, y, s);
}

function hud_draw_bricks(x: f32, y: f32, s: f32): void {
    let adv: f32 = 3.0 * s;
    let cx: f32 = x;
    hud_glyph_B(cx, y, s); cx = cx + adv;
    hud_glyph_R(cx, y, s); cx = cx + adv;
    hud_glyph_I(cx, y, s); cx = cx + adv;
    hud_glyph_C(cx, y, s); cx = cx + adv;
    hud_glyph_K(cx, y, s); cx = cx + adv;
    hud_glyph_S(cx, y, s);
}

function draw_ui(): void {
    let sw: f32 = state.config.screen.w;
    let sh: f32 = state.config.screen.h;
    // Score in top-left
    draw_number(state.score, 20.0, 10.0, 8.0);

    // Wave indicator in top-right
    draw_number(state.wave, sw - 60.0, 10.0, 8.0);

    // Average frame time in bottom-left (in milliseconds with 1 decimal)
    let avg_time_tenths: i32 = frame_timer_avg_tenths(state.frame_timer.samples_ms);
    draw_decimal_1_tenths(avg_time_tenths, 20.0, sh - 30.0, 6.0);
    hud_draw_ms_logic(90.0, sh - 28.0, 3.0);

    // Debug: Active counts in bottom-right
    let active_balls_count: i32 = count_active_balls();
    let active_bricks_count: i32 = count_active_bricks();
    hud_draw_balls(sw - 190.0, sh - 52.0, 3.0);
    draw_number(active_balls_count, sw - 80.0, sh - 50.0, 4.0);
    hud_draw_bricks(sw - 190.0, sh - 32.0, 3.0);
    draw_number(active_bricks_count, sw - 80.0, sh - 30.0, 4.0);

    if (state.phase == PHASE_LOSE) {
        // "LOSE" indicator
        draw_rect(sw / 2.0 - 40.0, sh / 2.0 - 20.0, 80.0, 40.0, 1.0, 0.3, 0.3, 1.0);
    }
}

function draw_frame(): void {
    // Hot reload during development (no flags for now)
    if (state.sprites.paddle == 0) { } else { gfx_poll_reload(state.sprites.paddle); }
    if (state.sprites.ball == 0) { } else { gfx_poll_reload(state.sprites.ball); }
    if (state.sprites.brick_basic_base == 0) { } else { gfx_poll_reload(state.sprites.brick_basic_base); }
    if (state.sprites.brick_basic_turret == 0) { } else { gfx_poll_reload(state.sprites.brick_basic_turret); }
    if (state.sprites.brick_basic_fx == 0) { } else { gfx_poll_reload(state.sprites.brick_basic_fx); }
    if (state.sprites.brick_armored_base == 0) { } else { gfx_poll_reload(state.sprites.brick_armored_base); }
    if (state.sprites.brick_armored_turret == 0) { } else { gfx_poll_reload(state.sprites.brick_armored_turret); }
    if (state.sprites.brick_armored_fx == 0) { } else { gfx_poll_reload(state.sprites.brick_armored_fx); }
    if (state.sprites.brick_reflector_base == 0) { } else { gfx_poll_reload(state.sprites.brick_reflector_base); }
    if (state.sprites.brick_reflector_fx == 0) { } else { gfx_poll_reload(state.sprites.brick_reflector_fx); }

    draw_bricks();
    draw_balls();
    draw_paddle();
    draw_ui();
}

// Timing
function compute_delta_ms(): i32 {
    let current_time: i32 = get_time_ms();
    let delta_ms: i32 = current_time - state.timers.last_time;
    if (delta_ms < 1) { delta_ms = 1; }
    if (delta_ms > 100) { delta_ms = 100; }
    state.timers.last_time = current_time;
    return delta_ms;
}

function sync_frame_rate(): void {
    let frame_end: i32 = get_time_ms();
    let elapsed: i32 = frame_end - state.timers.frame_start;
    let sleep_time: i32 = state.config.timing.frame_time_ms - elapsed;
    if (sleep_time > 0) {
        sleep_ms(sleep_time);
    }
}

function main(): i32 {
    ensure_config_defaults();

    let init_ok: bool = init_window(state.config.screen.w, state.config.screen.h, "Brickout Revenge");
    if (!init_ok) {
        return 1;
    }

    state.sprites.paddle = gfx_load_sprite("samples/brickout_revenge/assets/paddle.svg");
    state.sprites.ball = gfx_load_sprite("samples/brickout_revenge/assets/ball.svg");
    state.sprites.brick_basic_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic.svg");
    state.sprites.brick_basic_turret = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic_turret.svg");
    state.sprites.brick_basic_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic_fx.svg");
    state.sprites.brick_armored_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored.svg");
    state.sprites.brick_armored_turret = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored_turret.svg");
    state.sprites.brick_armored_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored_fx.svg");
    state.sprites.brick_reflector_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_reflector.svg");
    state.sprites.brick_reflector_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_reflector_fx.svg");

    if (state.initialized == 0) {
        seed_rng(time());
        init_game(true);
        setup_default_bricks();
        start_wave();

        // Initialize frame time buffer with baseline value
        frame_timer_init(state.frame_timer.samples_ms);
        state.frame_timer.sample_index = frame_timer_reset_index();

        state.initialized = 1;
    }

    state.timers.last_time = get_time_ms();
    state.running = 1;
    return 0;
}

function tick(): i32 {
    if (state.running != 1) {
        return 1;
    }

    apply_config_live();

    state.timers.frame_start = get_time_ms();

    let quit: bool = should_quit();
    if (quit) {
        state.running = 0;
    }

    if (is_key_down(KEY_ESCAPE)) {
        state.running = 0;
    }

    if (state.running != 1) {
        return 1;
    }

    begin_frame();
    clear(0.05, 0.05, 0.15, 1.0);

    let delta_ms: i32 = compute_delta_ms();
    let delta_f: f32 = delta_ms;
    let dt: f32 = delta_f / 1000.0;

    update_game(dt, delta_ms);
    draw_frame();

    // Measure frame time (logic + rendering prep, excluding vsync/swap/sleep)
    let frame_end: i32 = get_time_ms();
    state.timers.tick_time_ms = frame_end - state.timers.frame_start;
    if (state.timers.tick_time_ms < 0) { state.timers.tick_time_ms = 0; }

    // Store in circular buffer for averaging
    state.frame_timer.sample_index =
        frame_timer_push(state.frame_timer.samples_ms, state.frame_timer.sample_index, state.timers.tick_time_ms);

    end_frame();
    return 0;
}

