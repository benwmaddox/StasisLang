import "../../src/stdlib/stdlib.stasis";
import "../../src/stdlib/sdl_scancodes.stasis";
import "../../src/stdlib/graphics.stasis";

// Brickout Revenge - Tower Defense meets Breakout
// - Run with: `.\stasis.bat run samples\brickout_revenge\brickout_revenge.stasis --watch`
// - Edit: `samples/brickout_revenge/data/config.json` (hot-reloaded between ticks)


struct ScreenConfig { 
    width: i32;
    height: i32;
}

struct GlobalConfig {
    screen: ScreenConfig;
}

struct Sprites {    
    paddle: i32;
    ball: i32;
    brick_basic_base: i32;
    brick_basic_turret: i32;
    brick_basic_fx: i32;
    brick_armored_base: i32;
    brick_armored_turret: i32;
    brick_armored_fx: i32;
    brick_reflector_base: i32;
    brick_reflector_fx: i32;

}

struct GameState { 
    rng_state : i32;
}
struct GlobalState {     
    game : GameState;
    config : GlobalConfig;
    sprites : Sprites;    
    initialized: bool;
}

global state : GlobalState;


function draw_drag_preview(): void 
{
  return;
}

export function main(): i32 {
    // Require JSON data binding: this sample expects to be run under the native runner so
    // `samples/brickout_revenge/data/config.json` is applied to `state.config` before main().
    // if (state.config.magic != 1337) {
    //     print_string("error: brickout config.json not bound (expected state.config.magic == 1337)\n");
    //     print_string("run: .\\stasis.bat run samples/brickout_revenge/brickout_revenge.stasis --backend cranelift --graphics\n");
    //     return 1;
    // }

    let init_ok: bool = init_window(state.config.screen.width, state.config.screen.height, "Brickout Revenge");
    if (!init_ok) {
        return 1;
    }    

    state.sprites.paddle = gfx_load_sprite("samples/brickout_revenge/assets/paddle.svg", 128, 24);
    state.sprites.ball = gfx_load_sprite("samples/brickout_revenge/assets/ball.svg", 32, 32);
    state.sprites.brick_basic_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic.svg", 160, 64);
    state.sprites.brick_basic_turret = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic_turret.svg", 160, 64);
    state.sprites.brick_basic_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_basic_fx.svg", 160, 64); 
    state.sprites.brick_armored_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored.svg", 160, 64);    
    state.sprites.brick_armored_turret = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored_turret.svg", 160, 64);    
    state.sprites.brick_armored_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_armored_fx.svg", 160, 64);
    state.sprites.brick_reflector_base = gfx_load_sprite("samples/brickout_revenge/assets/brick_reflector.svg", 160, 64);
    state.sprites.brick_reflector_fx = gfx_load_sprite("samples/brickout_revenge/assets/brick_reflector_fx.svg", 160, 64);

    if (state.initialized == false) {
        state.game.rng_state = time();
        //init_game(true);
        //setup_default_bricks();
        //start_wave();

        // Initialize frame time buffer with baseline value
        //frame_timer_init(state.frame_timer.samples_ms);
        //state.frame_timer.sample_index = frame_timer_reset_index();

        state.initialized = true;
    }


    return 0;
}

function swap(){

}

function draw_level() {

}

function tick(): i32 {
    let quit: bool = should_quit();
    if (quit) {
        return 1;
    }
    
    begin_frame();
    clear(0.05, 0.05, 0.15, 1.0);
    
    //update_game(dt, delta_ms);
    draw_frame();

    end_frame();
    return 0;
}


function draw_frame(): void {
    // Hot reload during development (no flags for now)
    // Asset hot reload is automatic in dev (`stasis run --watch`).

    // draw_bricks();
    // draw_balls();
    // draw_paddle();
    // draw_drag_preview();
    // draw_ui();
    // draw_tap_pulses();
}
