import "../../src/stdlib/stdlib.stasis";
import "../../src/stdlib/sdl_scancodes.stasis";
import "../../src/stdlib/graphics.stasis";

// Brickout Revenge - Tower Defense meets Breakout
// - Run with: `.\stasis.bat run samples\brickout_revenge\brickout_revenge.stasis --watch`
// - Edit: `samples/brickout_revenge/data/config.json` (hot-reloaded between ticks)


struct ScreenConfig { 
    width: i32;
    height: i32;
}

struct GlobalConfig {
    screen: ScreenConfig;
}

struct Sprites {    
    paddle: i32;
    ball: i32;
    brick_basic_base: i32;
    brick_basic_turret: i32;
    brick_basic_fx: i32;
    brick_armored_base: i32;
    brick_armored_turret: i32;
    brick_armored_fx: i32;
    brick_reflector_base: i32;
    brick_reflector_fx: i32;

}

// Build render lists as pure data, then submit in bulk once per tick.
// This is the preferred hot-path model: no per-draw host calls.
struct GfxState {
    // Packed sprite stream: [handle,x,y,w,h,rot_deg,a] * 256
    sprites_i32: i32[1792];
    sprite_count: i32;

    // Packed line stream: [x1,y1,x2,y2,r,g,b,a] * 512
    lines_f32: f32[4096];
    line_count: i32;
}

struct GameState { 
    rng_state : i32;
}
struct GlobalState {     
    game : GameState;
    config : GlobalConfig;
    sprites : Sprites;    
    gfx: GfxState;
    initialized: bool;
}

global state : GlobalState;

function render_begin(): void {
    state.gfx.sprite_count = 0;
    state.gfx.line_count = 0;
}

function render_push_sprite(handle: i32, x: i32, y: i32, w: i32, h: i32, rot_deg: i32, a: i32): void {
    let i: i32 = state.gfx.sprite_count;
    if (i >= 256) { return; }
    let base: i32 = i * 7;
    state.gfx.sprites_i32[base + 0] = handle;
    state.gfx.sprites_i32[base + 1] = x;
    state.gfx.sprites_i32[base + 2] = y;
    state.gfx.sprites_i32[base + 3] = w;
    state.gfx.sprites_i32[base + 4] = h;
    state.gfx.sprites_i32[base + 5] = rot_deg;
    state.gfx.sprites_i32[base + 6] = a;
    state.gfx.sprite_count = i + 1;
}

function render_push_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32): void {
    let i: i32 = state.gfx.line_count;
    if (i >= 512) { return; }
    let base: i32 = i * 8;
    state.gfx.lines_f32[base + 0] = x1;
    state.gfx.lines_f32[base + 1] = y1;
    state.gfx.lines_f32[base + 2] = x2;
    state.gfx.lines_f32[base + 3] = y2;
    state.gfx.lines_f32[base + 4] = r;
    state.gfx.lines_f32[base + 5] = g;
    state.gfx.lines_f32[base + 6] = b;
    state.gfx.lines_f32[base + 7] = a;
    state.gfx.line_count = i + 1;
}


function draw_drag_preview(): void 
{
  return;
}

export function main(): i32 {
    // Require JSON data binding: this sample expects to be run under the native runner so
    // `samples/brickout_revenge/data/config.json` is applied to `state.config` before main().
    // if (state.config.magic != 1337) {
    //     print_string("error: brickout config.json not bound (expected state.config.magic == 1337)\n");
    //     print_string("run: .\\stasis.bat run samples/brickout_revenge/brickout_revenge.stasis --backend cranelift --graphics\n");
    //     return 1;
    // }

    let init_ok: bool = init_window(state.config.screen.width, state.config.screen.height, "Brickout Revenge");
    if (!init_ok) {
        return 1;
    }    

    state.sprites.paddle = gfx_load_sprite("assets/paddle.svg", 128, 24);
    state.sprites.ball = gfx_load_sprite("assets/ball.svg", 32, 32);
    state.sprites.brick_basic_base = gfx_load_sprite("assets/brick_basic.svg", 160, 64);
    state.sprites.brick_basic_turret = gfx_load_sprite("assets/brick_basic_turret.svg", 160, 64);
    state.sprites.brick_basic_fx = gfx_load_sprite("assets/brick_basic_fx.svg", 160, 64);
    state.sprites.brick_armored_base = gfx_load_sprite("assets/brick_armored.svg", 160, 64);
    state.sprites.brick_armored_turret = gfx_load_sprite("assets/brick_armored_turret.svg", 160, 64);
    state.sprites.brick_armored_fx = gfx_load_sprite("assets/brick_armored_fx.svg", 160, 64);
    state.sprites.brick_reflector_base = gfx_load_sprite("assets/brick_reflector.svg", 160, 64);
    state.sprites.brick_reflector_fx = gfx_load_sprite("assets/brick_reflector_fx.svg", 160, 64);

    if (state.initialized == false) {
        state.game.rng_state = time();
        //init_game(true);
        //setup_default_bricks();
        //start_wave();

        // Initialize frame time buffer with baseline value
        //frame_timer_init(state.frame_timer.samples_ms);
        //state.frame_timer.sample_index = frame_timer_reset_index();

        state.initialized = true;
    }


    return 0;
}

function swap(){

}

function draw_level() {

}

function tick(): i32 {
    let quit: bool = should_quit();
    if (quit) {
        return 1;
    }
    
    render_begin();

    // Demo: batch build sprites/lines into arrays, then submit once.
    let w: i32 = state.config.screen.width;
    let h: i32 = state.config.screen.height;
    render_push_sprite(state.sprites.paddle, (w / 2) - 64, h - 40, 128, 24, 0, 255);
    render_push_sprite(state.sprites.ball, (w / 2) - 16, (h / 2) - 16, 32, 32, 0, 255);

    render_push_line(0.0, 0.0, i32_to_f32(w), 0.0, 0.2, 0.2, 0.5, 1.0);
    render_push_line(i32_to_f32(w), 0.0, i32_to_f32(w), i32_to_f32(h), 0.2, 0.2, 0.5, 1.0);
    render_push_line(i32_to_f32(w), i32_to_f32(h), 0.0, i32_to_f32(h), 0.2, 0.2, 0.5, 1.0);
    render_push_line(0.0, i32_to_f32(h), 0.0, 0.0, 0.2, 0.2, 0.5, 1.0);

    begin_frame();
    clear(0.05, 0.05, 0.15, 1.0);
    
    //update_game(dt, delta_ms);
    gfx_draw_sprites_i32(state.gfx.sprites_i32, state.gfx.sprite_count);
    draw_lines_f32(state.gfx.lines_f32, state.gfx.line_count);
    draw_frame();

    end_frame();
    return 0;
}


