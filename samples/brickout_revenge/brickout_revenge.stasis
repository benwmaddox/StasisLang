import "../../src/stdlib/stdlib.stasis";
import "../../src/stdlib/sdl_scancodes.stasis";
import "../../src/stdlib/graphics.stasis";

// Brickout Revenge - Tower Defense meets Breakout
// - Run with: `.\stasis.bat run samples\brickout_revenge\brickout_revenge.stasis --watch`
// - Edit: `samples/brickout_revenge/data/config.json` (hot-reloaded between ticks)

struct ScreenConfig {
    width: i32;
    height: i32;
}

struct GlobalConfig {
    screen: ScreenConfig;
}

struct Sprites {
    paddle: Sprite;
    ball: Sprite;
    brick_basic_base: Sprite;
    brick_basic_turret: Sprite;
    brick_basic_fx: Sprite;
    brick_armored_base: Sprite;
    brick_armored_turret: Sprite;
    brick_armored_fx: Sprite;
    brick_reflector_base: Sprite;
    brick_reflector_fx: Sprite;
}

// Lines and sprites use caller-owned, bounded semantic lists.
struct GfxState {
    lines: LineBatch;
    presentation: PresentationList;
}

struct GameState {
    rng_state: i32;
}

struct GlobalState {
    game: GameState;
    config: GlobalConfig;
    sprites: Sprites;
    gfx: GfxState;
    initialized: bool;
}

global state: GlobalState;
global brickout_host_frame: HostFrame;

function render_begin(): void {
    state.gfx.lines.reset_lines();
    state.gfx.presentation.reset_presentation();
}

function render_push_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32): void {
    state.gfx.lines.append_line(x1, y1, x2, y2, r, g, b, a);
}

function draw_drag_preview(): void {
    return;
}

export function main(): i32 {
    // Require JSON data binding: this sample expects to be run under the native runner so
    // `samples/brickout_revenge/data/config.json` is applied to `state.config` before main().
    // if (state.config.magic != 1337) {
    //     print_string("error: brickout config.json not bound (expected state.config.magic == 1337)\n");
    //     print_string("run: .\\stasis.bat run samples/brickout_revenge/brickout_revenge.stasis --backend cranelift --graphics\n");
    //     return 1;
    // }

    let init_ok: bool = init_window(state.config.screen.width, state.config.screen.height, "Brickout Revenge");
    if (!init_ok) {
        return 1;
    }
    brickout_host_frame.refresh();

    state.sprites.paddle.load_sprite_from("assets/paddle.svg", 128, 24);
    state.sprites.ball.load_sprite_from("assets/ball.svg", 32, 32);
    state.sprites.brick_basic_base.load_sprite_from("assets/brick_basic.svg", 160, 64);
    state.sprites.brick_basic_turret.load_sprite_from("assets/brick_basic_turret.svg", 160, 64);
    state.sprites.brick_basic_fx.load_sprite_from("assets/brick_basic_fx.svg", 160, 64);
    state.sprites.brick_armored_base.load_sprite_from("assets/brick_armored.svg", 160, 64);
    state.sprites.brick_armored_turret.load_sprite_from("assets/brick_armored_turret.svg", 160, 64);
    state.sprites.brick_armored_fx.load_sprite_from("assets/brick_armored_fx.svg", 160, 64);
    state.sprites.brick_reflector_base.load_sprite_from("assets/brick_reflector.svg", 160, 64);
    state.sprites.brick_reflector_fx.load_sprite_from("assets/brick_reflector_fx.svg", 160, 64);

    if (state.initialized == false) {
        state.game.rng_state = brickout_host_frame.time_ms;
        //init_game(true);
        //setup_default_bricks();
        //start_wave();

        // Initialize frame time buffer with baseline value
        //frame_timer_init(state.frame_timer.samples_ms);
        //state.frame_timer.sample_index = frame_timer_reset_index();

        state.initialized = true;
    }

    return 0;
}

function swap() {
}

function draw_level() {
}

function tick(): i32 {
    brickout_host_frame.refresh();
    let quit: bool = brickout_host_frame.quit_requested;
    if (quit) {
        return 1;
    }

    render_begin();

    // Demo: batch build sprites/lines into arrays, then submit once.
    let w: i32 = state.config.screen.width;
    let h: i32 = state.config.screen.height;
    let w_f: f32;
    w_f.from_i32(w);
    let h_f: f32;
    h_f.from_i32(h);
    render_push_line(0.0, 0.0, w_f, 0.0, 0.2, 0.2, 0.5, 1.0);
    render_push_line(w_f, 0.0, w_f, h_f, 0.2, 0.2, 0.5, 1.0);
    render_push_line(w_f, h_f, 0.0, h_f, 0.2, 0.2, 0.5, 1.0);
    render_push_line(0.0, h_f, 0.0, 0.0, 0.2, 0.2, 0.5, 1.0);

    begin_frame();
    clear(0.05, 0.05, 0.15, 1.0);

    //update_game(dt, delta_ms);
    let paddle_x: f32;
    let paddle_y: f32;
    paddle_x.from_i32((w / 2) - 64);
    paddle_y.from_i32(h - 40);
    let ball_x: f32;
    let ball_y: f32;
    ball_x.from_i32((w / 2) - 16);
    ball_y.from_i32((h / 2) - 16);
    state.gfx.presentation.append_sprite(state.sprites.paddle.reference(), paddle_x, paddle_y, 128.0, 24.0, 0, 255);
    state.gfx.presentation.append_sprite(state.sprites.ball.reference(), ball_x, ball_y, 32.0, 32.0, 0, 255);
    state.gfx.presentation.replay();
    state.gfx.lines.draw();
    draw_frame();

    end_frame();
    return 0;
}

function draw_frame(): void {
    // Hot reload during development (no flags for now)
    // Asset hot reload is automatic in dev (`stasis run --watch`).

    // draw_bricks();
    // draw_balls();
    // draw_paddle();
    // draw_drag_preview();
    // draw_ui();
    // draw_tap_pulses();
}
