// Brickout Revenge v1 - menu/shop input + helpers.

function update_drag_from_screen(screen_x: f32, screen_y: f32): void {
    state.drag_world_x = screen_to_play_x(screen_x);
    state.drag_world_y = screen_to_play_y(screen_y);
    state.drag_grid_x = world_to_grid_x(state.drag_world_x);
    state.drag_grid_y = world_to_grid_y(state.drag_world_y);

    let in_virtual: bool = point_in_rect(screen_x, screen_y, state.layout.play_x, state.layout.play_y, state.layout.play_w, state.layout.play_h);
    let in_game: bool = in_virtual && state.drag_world_y <= GAME_H;
    let valid: bool = in_game && grid_cell_fits_in_level(state.drag_grid_x, state.drag_grid_y);
    if (valid) {
        if (grid_is_occupied(state.drag_grid_x, state.drag_grid_y)) {
            valid = false;
        }
    }
    if (valid) {
        state.drag_valid = 1;
    } else {
        state.drag_valid = 0;
    }
}

function menu_pick_level(play_x: f32, play_y: f32): i32 {
    let base_x: f32 = 36.0;
    let base_y: f32 = 220.0;
    let w: f32 = VIRTUAL_W - base_x * 2.0;
    let h: f32 = 44.0;
    let gap: f32 = 14.0;
    let i: i32 = 0;
    for (i = 0; i < BRICKOUT_LEVEL_COUNT; i = i + 1) {
        let y: f32 = base_y + i32_to_f32(i) * (h + gap);
        if (point_in_rect(play_x, play_y, base_x, y, w, h)) {
            return i;
        }
    }
    return -1;
}

function shop_visible_y(ui_y: f32, ui_h: f32): f32 {
    let handle_h: f32 = 22.0;
    let vis: f32 = handle_h + state.shop_anim * (ui_h - handle_h);
    return ui_y + (ui_h - vis);
}

function handle_pointer_input_menu(): void {
    let count: i32 = input_pointer_count();
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        if (input_pointer_went_down(i)) {
            let sx: f32 = input_pointer_x_px(i) + state.layout.viewport_x;
            let sy: f32 = input_pointer_y_px(i) + state.layout.viewport_y;
            let in_virtual: bool = point_in_rect(sx, sy, state.layout.play_x, state.layout.play_y, state.layout.play_w, state.layout.play_h);
            if (in_virtual) {
                let wx: f32 = screen_to_play_x(sx);
                let wy: f32 = screen_to_play_y(sy);
                let pick: i32 = menu_pick_level(wx, wy);
                if (pick >= 0) {
                    state.menu_selected_level = pick;
                    sfx_play(SFX_SELECT);
                    start_level(pick);
                }
            }
        }
    }
}

function handle_pointer_input_game(): void {
    let count: i32 = input_pointer_count();
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        let pid: i32 = input_pointer_id(i);
        let went_down: bool = input_pointer_went_down(i);
        let went_up: bool = input_pointer_went_up(i);
        let is_down: bool = input_pointer_is_down(i);
        let sx: f32 = input_pointer_x_px(i) + state.layout.viewport_x;
        let sy: f32 = input_pointer_y_px(i) + state.layout.viewport_y;

        if (state.drag_active != 0) {
            if (pid == state.drag_pointer_id) {
                if (is_down) {
                    update_drag_from_screen(sx, sy);
                }
                if (went_up) {
                    if (state.drag_valid != 0) {
                        let placed: bool = place_brick_at_grid(state.drag_grid_x, state.drag_grid_y, state.selected_tower);
                        if (placed) {
                            sfx_play(SFX_DRAG_PLACE);
                        } else {
                            sfx_play(SFX_DRAG_INVALID);
                        }
                    } else {
                        sfx_play(SFX_DRAG_INVALID);
                    }
                    state.drag_active = 0;
                    state.drag_pointer_id = -1;
                    state.drag_valid = 0;
                }
            }
        } else {
            if (went_down) {
                let ui_x: f32 = state.layout.ui_x;
                let ui_y: f32 = state.layout.ui_y;
                let ui_w: f32 = state.layout.ui_w;
                let ui_h: f32 = state.layout.ui_h;

                // Toggle shop when tapping the handle.
                let handle_h: f32 = 22.0;
                let handle_y: f32 = ui_y + ui_h - handle_h;
                if (point_in_rect(sx, sy, ui_x, handle_y, ui_w, handle_h)) {
                    if (state.shop_open == 0) { state.shop_open = 1; } else { state.shop_open = 0; }
                    sfx_play(SFX_SELECT);
                    continue;
                }

                if (state.shop_anim < 0.9) {
                    continue;
                }

                let pad: f32 = UI_PANEL_PAD;
                let gap: f32 = UI_PANEL_GAP;
                let panel_y: f32 = shop_visible_y(ui_y, ui_h);
                let menu_x: f32 = ui_x + pad;
                let menu_y: f32 = panel_y + pad;
                let menu_w: f32 = 0.0;
                let menu_h: f32 = 0.0;
                let have_menu: bool = false;
                if (state.layout.ui_mode == 1) {
                    menu_w = ui_w - pad * 2.0;
                    menu_h = (ui_h - pad * 2.0 - gap) * 0.5;
                    have_menu = true;
                } else {
                    if (state.layout.ui_mode == 2) {
                        menu_w = (ui_w - pad * 2.0 - gap) * 0.5;
                        menu_h = ui_h - pad * 2.0;
                        have_menu = true;
                    }
                }

                if (have_menu && point_in_rect(sx, sy, menu_x, menu_y, menu_w, menu_h)) {
                    let slot: i32 = ui_pick_menu_slot(sx, sy, menu_x, menu_y, menu_w, menu_h);
                    let t: BrickType = BrickType.Basic;
                    if (slot == 0) { t = BrickType.Basic; }
                    if (slot == 1) { t = BrickType.Armored; }
                    if (slot == 2) { t = BrickType.Reflector; }
                    let cost_scraps: i32 = tower_cost_scraps(t);
                    let cost_power: i32 = tower_cost_power(t);
                    if (!brickout_can_buy(state.economy.scraps, state.economy.power_used, state.economy.power_cap, cost_scraps, cost_power)) {
                        sfx_play(SFX_DRAG_INVALID);
                        continue;
                    }

                    state.selected_tower = t;
                    state.cursor.brick_type = t;
                    state.drag_active = 1;
                    state.drag_pointer_id = pid;
                    update_drag_from_screen(sx, sy);
                    sfx_play(SFX_DRAG_START);
                }
            }
        }
    }
}

function handle_pointer_input(): void {
    if (state.screen == BrickoutScreen.Menu) {
        handle_pointer_input_menu();
        return;
    }
    if (state.screen == BrickoutScreen.Game) {
        handle_pointer_input_game();
    }
}

function draw_main_menu(): void {
    let s: f32 = state.layout.play_scale;
    let title_x: f32 = play_to_screen_x(28.0);
    let title_y: f32 = play_to_screen_y(90.0);
    draw_text(state.ui_font, "Brickout Revenge v1", title_x, title_y, 0.95, 0.95, 0.95, 1.0);
    draw_text(state.ui_font, "Tap a level to start", title_x, title_y + 24.0 * s, 0.75, 0.85, 0.95, 0.9);

    let base_x: f32 = 36.0;
    let base_y: f32 = 220.0;
    let w: f32 = VIRTUAL_W - base_x * 2.0;
    let h: f32 = 44.0;
    let gap: f32 = 14.0;
    let i: i32 = 0;
    for (i = 0; i < BRICKOUT_LEVEL_COUNT; i = i + 1) {
        let y: f32 = base_y + i32_to_f32(i) * (h + gap);
        let sx: f32 = play_to_screen_x(base_x);
        let sy: f32 = play_to_screen_y(y);
        let sw: f32 = play_to_screen_len(w);
        let sh: f32 = play_to_screen_len(h);
        if (i == state.menu_selected_level) {
            draw_filled_rect(sx, sy, sw, sh, 0.12, 0.16, 0.22, 0.95);
            draw_rect(sx, sy, sw, sh, 0.9, 0.8, 0.3, 0.95);
        } else {
            draw_filled_rect(sx, sy, sw, sh, 0.08, 0.10, 0.14, 0.92);
            draw_rect(sx, sy, sw, sh, 0.3, 0.6, 0.8, 0.85);
        }
        if (i == 0) { draw_text(state.ui_font, brickout_level_name_0, sx + 12.0, sy + 14.0 * s, 0.95, 0.95, 0.95, 0.95); }
        if (i == 1) { draw_text(state.ui_font, brickout_level_name_1, sx + 12.0, sy + 14.0 * s, 0.95, 0.95, 0.95, 0.95); }
        if (i == 2) { draw_text(state.ui_font, brickout_level_name_2, sx + 12.0, sy + 14.0 * s, 0.95, 0.95, 0.95, 0.95); }
    }
}

