import "brickout_revenge_original_core.stasis";

test `original standard tower level zero matches recovered values`(): bool {
    if (original_tower_cost(OriginalTowerKind.Standard, 0) != 5) { return false; }
    if (original_tower_starting_hp(OriginalTowerKind.Standard, 0) != 10) { return false; }
    if (original_tower_range(OriginalTowerKind.Standard, 0) != 125) { return false; }
    if (original_tower_damage(OriginalTowerKind.Standard, 0) != 10) { return false; }
    if (original_tower_reload_ticks(OriginalTowerKind.Standard, 0) != 180) { return false; }
    return true;
}

test `original tower upgrade formulas match recovered ActionScript`(): bool {
    if (original_tower_starting_hp(OriginalTowerKind.Wall, 5) != 125) { return false; }
    if (original_tower_max_hp(OriginalTowerKind.Wall, 5) != 187) { return false; }
    if (original_tower_damage(OriginalTowerKind.Sniper, 5) != 600) { return false; }
    if (original_tower_reload_ticks(OriginalTowerKind.Rapid, 5) != 6) { return false; }
    if (original_tower_cost(OriginalTowerKind.Gold, 3) != 21) { return false; }
    return true;
}

test `original ball scaling and identities match recovered values`(): bool {
    if (original_ball_base_damage(OriginalBallKind.Standard) != 2) { return false; }
    if (original_ball_base_damage(OriginalBallKind.Slow) != 3) { return false; }
    if (original_ball_speed_min(OriginalBallKind.Fast) != 80) { return false; }
    if (original_ball_scaled_hp(OriginalBallKind.Standard, 15) != 160) { return false; }
    if (original_ball_scaled_damage(OriginalBallKind.Standard, 15) != 4) { return false; }
    return true;
}

test `original campaign schedules preserve recovered group counts`(): bool {
    original_level_init(0);
    if (original_spawn_total != 144) { return false; }
    if (original_spawn_kind[0] != OriginalBallKind.Standard) { return false; }
    if (original_spawn_count[0] != 5) { return false; }

    original_level_init(1);
    if (original_spawn_total != 22) { return false; }
    if (original_spawn_kind[0] != OriginalBallKind.Splitter) { return false; }
    if (original_spawn_count[21] != 30) { return false; }
    if (original_spawn_kind[21] != OriginalBallKind.Swarm) { return false; }
    return true;
}

test `original challenge and earthquake schedules remain available`(): bool {
    original_level_init(2);
    if (original_spawn_total != 47) { return false; }
    if (original_spawn_kind[15] != OriginalBallKind.Fire) { return false; }

    original_level_init(3);
    if (original_spawn_total != 21) { return false; }
    if (original_spawn_kind[20] != OriginalBallKind.Mover) { return false; }
    if (original_spawn_count[20] != 50) { return false; }
    return true;
}
