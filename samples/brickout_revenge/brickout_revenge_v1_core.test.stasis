import "brickout_revenge_v1_core.stasis";

test `brickout can buy enforces scraps and power cap`(): bool {
    if (!brickout_can_buy(20, 0, 5, 10, 2)) { return false; }
    if (brickout_can_buy(5, 0, 5, 10, 2)) { return false; }
    if (brickout_can_buy(20, 4, 5, 1, 2)) { return false; }
    return true;
}

test `brickout shop anim step clamps open close range`(): bool {
    let opened: f32 = brickout_shop_anim_step(0.95, 1, 0.1, 1.0);
    if (opened < 0.99 || opened > 1.0) { return false; }
    let closed: f32 = brickout_shop_anim_step(0.05, 0, 0.2, 1.0);
    if (closed != 0.0) { return false; }
    return true;
}

test `brickout level reset zeros runtime counters`(): bool {
    brickout_level_tick = 99;
    brickout_level_next_event_index = 11;
    brickout_level_done = 1;
    brickout_level_reset();
    if (brickout_level_tick != 0) { return false; }
    if (brickout_level_next_event_index != 0) { return false; }
    if (brickout_level_done != 0) { return false; }
    return true;
}
