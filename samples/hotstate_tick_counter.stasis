struct CounterState {
    counter: i32;
    ticks: i32;
}

global state: CounterState;

function main(): i32 {
    if (state.counter == 0) {
        print_string("init\n");
    }
    return 0;
}

function tick(): i32 {
    state.ticks = state.ticks + 1;
    state.counter = state.counter + 1;
    if (state.ticks >= 3) {
        print_string("counter=");
        print_int(state.counter);
        print_char(10);
        return 1;
    }
    return 0;
}
