import "../src/stdlib/stdlib.stasis";

// Minimal audio output sample.
// Generates a mono sine wave and pushes interleaved stereo f32 frames.
//
// Builtins:
// - audio_is_available() -> bool
// - audio_get_sample_rate() -> i32
// - audio_get_channels() -> i32
// - audio_get_queued_frames() -> i32
// - audio_get_underruns() -> i32
// - audio_push_f32_interleaved(samples, frames) -> i32

const PI2: f32 = 6.28318;
const TARGET_FPS: i32 = 60;
const FRAME_MS: i32 = 16;

const FRAMES_PER_PUSH: i32 = 512;
global audio_buf: f32[1024]; // 512 frames * 2 channels
global phase: f32;

function fill_sine(sample_rate: i32, freq_hz: f32): void {
    let sr_f: f32 = i32_to_f32(sample_rate);
    let step: f32 = (PI2 * freq_hz) / sr_f;

    let i: i32 = 0;
    for (i = 0; i < FRAMES_PER_PUSH; i = i + 1) {
        let s: f32 = sin_fast(phase) * 0.2;
        let idx: i32 = i * 2;
        audio_buf[idx] = s;
        audio_buf[idx + 1] = s;

        phase = phase + step;
        if (phase > PI2) {
            phase = phase - PI2;
        }
    }
}

function main(): i32 {
    let ok: bool = audio_is_available();
    if (!ok) {
        print_string("audio: not available\n");
        return 1;
    }

    let sr: i32 = audio_get_sample_rate();
    let ch: i32 = audio_get_channels();
    print_string("audio: sample_rate=");
    print_int(sr);
    print_string(" channels=");
    print_int(ch);
    print_char(10);

    let running: i32 = 1;
    let frame: i32 = 0;
    for (frame = 0; running == 1; frame = frame + 1) {
        if (frame > 600) {
            running = 0;
        }

        fill_sine(sr, 440.0);
        audio_push_f32_interleaved(audio_buf, FRAMES_PER_PUSH);

        if (frame % 60 == 0) {
            print_string("audio: queued_frames=");
            print_int(audio_get_queued_frames());
            print_string(" underruns=");
            print_int(audio_get_underruns());
            print_char(10);
        }

        sleep_ms(FRAME_MS);
    }

    return 0;
}
