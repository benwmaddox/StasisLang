import "../stdlib.stasis";
import "../asset_tasks.stasis";

// Graphics command buffer (current)
//
// Policy:
// - Ordering: line, rectangle, sprite, text, and ordered clip calls append to one bounded order stream.
// - Geometry: lines grow forward and rectangles grow backward in one fixed arena.
// - Empty order streams use lines -> rectangles -> sprites -> text order.
// - Coordinates: logical top-left pixels from the HostFrame display contract.

const GFX_CMD_MAGIC: i32 = 1196967473; // 0x47584631 ('GXF1')

const GFX_CMD_VERSION: i32 = 7;

// i32 header indices
const GFX_I_MAGIC: i32 = 0;
const GFX_I_VERSION: i32 = 1;
const GFX_I_FLAGS: i32 = 2;
const GFX_I_LINE_COUNT: i32 = 3;
const GFX_I_SPRITE_COUNT: i32 = 4;
const GFX_I_DROPPED_LINES: i32 = 5;
const GFX_I_DROPPED_SPRITES: i32 = 6;
const GFX_I_TEXT_COUNT: i32 = 7;
const GFX_I_DROPPED_TEXT: i32 = 8;
const GFX_I_TEXT_BYTES_USED: i32 = 9;

// Host-populated display metadata. Guest frame construction leaves these
// reserved slots untouched; they are not part of the command trace.
const GFX_I_LOGICAL_W: i32 = 10;
const GFX_I_LOGICAL_H: i32 = 11;
const GFX_I_NATIVE_W: i32 = 12;
const GFX_I_NATIVE_H: i32 = 13;
const GFX_I_DRAWABLE_W: i32 = 14;
const GFX_I_DRAWABLE_H: i32 = 15;
const GFX_I_SAFE_X: i32 = 16;
const GFX_I_SAFE_Y: i32 = 17;
const GFX_I_SAFE_W: i32 = 18;
const GFX_I_SAFE_H: i32 = 19;
const GFX_I_DISPLAY_GENERATION: i32 = 20;
const GFX_I_DENSITY_GENERATION: i32 = 21;
const GFX_I_ORDER_COUNT: i32 = 22;
const GFX_I_DROPPED_ORDER: i32 = 23;
const GFX_I_RECT_COUNT: i32 = 24;
const GFX_I_DROPPED_RECTS: i32 = 25;
const GFX_I_CLIP_COUNT: i32 = 27;
const GFX_I_DROPPED_CLIPS: i32 = 28;
const GFX_I_SPRITE_RUN_COUNT: i32 = 29;
const GFX_I_DROPPED_SPRITE_RUNS: i32 = 30;
const GFX_I_SPRITE_BASE: i32 = 32;
const GFX_I_ORDER_BASE: i32 = 51232;

// flags
const GFX_FLAG_CLEAR: i32 = 1;
const GFX_FLAG_PRESENT: i32 = 2;

// capacities (must match runtime clamp in `stasis_gfx_submit`)
const GFX_MAX_GEOMETRY: i32 = 10000;
const GFX_GEOMETRY_STRIDE_F32: i32 = 8;
const GFX_MAX_LINES: i32 = 10000;
const GFX_LINE_STRIDE_F32: i32 = 8;
const GFX_MAX_SPRITES: i32 = 4096;
const GFX_SPRITE_STRIDE_I32: i32 = 3; // logical handle, packed RGBA8 tint, feature flags

// dst x/y/w/h, logical source x/y/w/h, pivot x/y, scale x/y, rotation degrees.
const GFX_SPRITE_STRIDE_F32: i32 = 13;
const GFX_MAX_SPRITE_RUNS: i32 = 4096;
const GFX_SPRITE_RUN_STRIDE_I32: i32 = 8;
const GFX_MAX_TEXT: i32 = 2048;
const GFX_TEXT_STRIDE_I32: i32 = 3; // font, byte_offset, byte_len

const GFX_TEXT_STRIDE_F32: i32 = 6; // x,y,r,g,b,a

const GFX_TEXT_MAX_BYTES: i32 = 65536;
const GFX_MAX_CLIPS: i32 = 256;
const GFX_CLIP_STRIDE_F32: i32 = 4; // x,y,w,h
const GFX_MAX_ORDER: i32 = 16656;
const GFX_ORDER_KIND_SCALE: i32 = 16384;
const GFX_ORDER_LINE: i32 = 1;
const GFX_ORDER_SPRITE: i32 = 2;
const GFX_ORDER_TEXT: i32 = 3;
const GFX_ORDER_RECT: i32 = 4;
const GFX_ORDER_CLIP_PUSH: i32 = 5;
const GFX_ORDER_CLIP_POP: i32 = 6;

// f32 layout
const GFX_F_CLEAR_R: i32 = 0;
const GFX_F_CLEAR_G: i32 = 1;
const GFX_F_CLEAR_B: i32 = 2;
const GFX_F_CLEAR_A: i32 = 3;
const GFX_F_LINE_BASE: i32 = 4;
const GFX_F_SPRITE_BASE: i32 = 80004;
const GFX_F_RECT_REVERSE_BASE: i32 = 79996;
const GFX_F_TEXT_BASE: i32 = 133252;
const GFX_F_CLIP_BASE: i32 = 145540;

// NOTE: Array sizes must be integer literals in Stasis today.
// Keep these in sync with the constants above:
// - i32 count = 32 + (4096*3) + (2048*3) + (4096*8) + 16656 = 67888
// - f32 count = 4 + (10000*8) + (4096*13) + (2048*6) + (256*4) = 146564
const GFX_I_TEXT_BASE: i32 = 12320;
const GFX_I_SPRITE_RUN_BASE: i32 = 18464;

global gfx_cmd_i32: i32[67888];
global gfx_cmd_f32: f32[146564];
global gfx_cmd_u8: u8[65536];

// One unpublished generation-scoped reservation may exist at a time. These
// globals are writer ownership metadata, not published frame state.
global gfx_sprite_writer_frame_generation: i32;
global gfx_sprite_writer_next_token: i32;
global gfx_sprite_writer_token: i32;
global gfx_sprite_writer_start: i32;
global gfx_sprite_writer_capacity: i32;
global gfx_sprite_writer_written: i32;
global gfx_sprite_writer_clip: i32;
global gfx_sprite_writer_material: i32;
global gfx_sprite_writer_blend: i32;
global gfx_sprite_writer_filter: i32;
global gfx_sprite_writer_pass: i32;
global gfx_sprite_writer_flags: i32;

// Begin a new frame, resetting all counts (typical immediate-mode usage).
function @inline gfx_cmd_begin(): void {
    gfx_sprite_writer_frame_generation = gfx_sprite_writer_frame_generation + 1;
    if (gfx_sprite_writer_frame_generation <= 0) {
        gfx_sprite_writer_frame_generation = 1;
    }
    gfx_sprite_writer_token = 0;
    gfx_cmd_i32[GFX_I_MAGIC] = GFX_CMD_MAGIC;
    gfx_cmd_i32[GFX_I_VERSION] = GFX_CMD_VERSION;
    gfx_cmd_i32[GFX_I_FLAGS] = 0;
    gfx_cmd_i32[GFX_I_LINE_COUNT] = 0;
    gfx_cmd_i32[GFX_I_SPRITE_COUNT] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_LINES] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_SPRITES] = 0;
    gfx_cmd_i32[GFX_I_TEXT_COUNT] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_TEXT] = 0;
    gfx_cmd_i32[GFX_I_TEXT_BYTES_USED] = 0;
    gfx_cmd_i32[GFX_I_ORDER_COUNT] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_ORDER] = 0;
    gfx_cmd_i32[GFX_I_RECT_COUNT] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_RECTS] = 0;
    gfx_cmd_i32[GFX_I_CLIP_COUNT] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_CLIPS] = 0;
    gfx_cmd_i32[GFX_I_SPRITE_RUN_COUNT] = 0;
    gfx_cmd_i32[GFX_I_DROPPED_SPRITE_RUNS] = 0;
}

function @inline gfx_cmd_append_order(kind: i32, index: i32): bool {
    let order_index: i32 = gfx_cmd_i32[GFX_I_ORDER_COUNT];
    if (order_index < 0 || order_index >= GFX_MAX_ORDER) {
        gfx_cmd_i32[GFX_I_DROPPED_ORDER] = gfx_cmd_i32[GFX_I_DROPPED_ORDER] + 1;
        return false;
    }
    gfx_cmd_i32[GFX_I_ORDER_BASE + order_index] = kind * GFX_ORDER_KIND_SCALE + index;
    gfx_cmd_i32[GFX_I_ORDER_COUNT] = order_index + 1;
    return true;
}

// Append a logical top-origin clip descriptor.  The descriptor is indexed by
// the push entry; pop entries carry index zero and restore the previous clip.
function gfx_cmd_clip_push(x: f32, y: f32, w: f32, h: f32): void {
    let i: i32 = gfx_cmd_i32[GFX_I_CLIP_COUNT];
    if (i < 0 || i >= GFX_MAX_CLIPS) {
        gfx_cmd_i32[GFX_I_DROPPED_CLIPS] = gfx_cmd_i32[GFX_I_DROPPED_CLIPS] + 1;
        return;
    }
    if (!gfx_cmd_append_order(GFX_ORDER_CLIP_PUSH, i)) {
        gfx_cmd_i32[GFX_I_DROPPED_CLIPS] = gfx_cmd_i32[GFX_I_DROPPED_CLIPS] + 1;
        return;
    }
    let base: i32 = GFX_F_CLIP_BASE + i * GFX_CLIP_STRIDE_F32;
    gfx_cmd_f32[base + 0] = x;
    gfx_cmd_f32[base + 1] = y;
    gfx_cmd_f32[base + 2] = w;
    gfx_cmd_f32[base + 3] = h;
    gfx_cmd_i32[GFX_I_CLIP_COUNT] = i + 1;
}

function @inline gfx_cmd_clip_pop(): void {
    if (!gfx_cmd_append_order(GFX_ORDER_CLIP_POP, 0)) {
        gfx_cmd_i32[GFX_I_DROPPED_CLIPS] = gfx_cmd_i32[GFX_I_DROPPED_CLIPS] + 1;
    }
}

function @inline gfx_cmd_clear(r: f32, g: f32, b: f32, a: f32): void {
    gfx_cmd_i32[GFX_I_FLAGS] = GFX_FLAG_CLEAR;
    gfx_cmd_f32[GFX_F_CLEAR_R] = r;
    gfx_cmd_f32[GFX_F_CLEAR_G] = g;
    gfx_cmd_f32[GFX_F_CLEAR_B] = b;
    gfx_cmd_f32[GFX_F_CLEAR_A] = a;
}

function gfx_cmd_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32): void {
    let i: i32 = gfx_cmd_i32[GFX_I_LINE_COUNT];
    let rect_count: i32 = gfx_cmd_i32[GFX_I_RECT_COUNT];
    if (i < 0 || rect_count < 0 || rect_count > GFX_MAX_GEOMETRY || i >= GFX_MAX_GEOMETRY - rect_count) {
        gfx_cmd_i32[GFX_I_DROPPED_LINES] = gfx_cmd_i32[GFX_I_DROPPED_LINES] + 1;
        return;
    }
    if (!gfx_cmd_append_order(GFX_ORDER_LINE, i)) {
        gfx_cmd_i32[GFX_I_DROPPED_LINES] = gfx_cmd_i32[GFX_I_DROPPED_LINES] + 1;
        return;
    }

    let base: i32 = GFX_F_LINE_BASE + i * GFX_LINE_STRIDE_F32;
    gfx_cmd_f32[base + 0] = x1;
    gfx_cmd_f32[base + 1] = y1;
    gfx_cmd_f32[base + 2] = x2;
    gfx_cmd_f32[base + 3] = y2;
    gfx_cmd_f32[base + 4] = r;
    gfx_cmd_f32[base + 5] = g;
    gfx_cmd_f32[base + 6] = b;
    gfx_cmd_f32[base + 7] = a;

    gfx_cmd_i32[GFX_I_LINE_COUNT] = i + 1;
}

function gfx_cmd_rect(x: f32, y: f32, w: f32, h: f32, r: f32, g: f32, b: f32, a: f32): void {
    let i: i32 = gfx_cmd_i32[GFX_I_RECT_COUNT];
    let line_count: i32 = gfx_cmd_i32[GFX_I_LINE_COUNT];
    if (i < 0 || line_count < 0 || line_count > GFX_MAX_GEOMETRY || i >= GFX_MAX_GEOMETRY - line_count) {
        gfx_cmd_i32[GFX_I_DROPPED_RECTS] = gfx_cmd_i32[GFX_I_DROPPED_RECTS] + 1;
        return;
    }
    if (!gfx_cmd_append_order(GFX_ORDER_RECT, i)) {
        gfx_cmd_i32[GFX_I_DROPPED_RECTS] = gfx_cmd_i32[GFX_I_DROPPED_RECTS] + 1;
        return;
    }

    let base: i32 = GFX_F_RECT_REVERSE_BASE - i * GFX_GEOMETRY_STRIDE_F32;
    gfx_cmd_f32[base + 0] = x;
    gfx_cmd_f32[base + 1] = y;
    gfx_cmd_f32[base + 2] = w;
    gfx_cmd_f32[base + 3] = h;
    gfx_cmd_f32[base + 4] = r;
    gfx_cmd_f32[base + 5] = g;
    gfx_cmd_f32[base + 6] = b;
    gfx_cmd_f32[base + 7] = a;

    gfx_cmd_i32[GFX_I_RECT_COUNT] = i + 1;
}

// Reserve one unpublished semantic sprite run. Returns an opaque frame-local
// token, or zero when any required capacity is unavailable.
function @effects(graphics) gfx_cmd_sprite_run_reserve(max_count: i32, clip: i32, material: i32, blend: i32, filter: i32, pass: i32, flags: i32): i32 {
    let start: i32 = gfx_cmd_i32[GFX_I_SPRITE_COUNT];
    let run: i32 = gfx_cmd_i32[GFX_I_SPRITE_RUN_COUNT];
    let order: i32 = gfx_cmd_i32[GFX_I_ORDER_COUNT];
    if (
        max_count <= 0
        || gfx_sprite_writer_token != 0
        || start < 0
        || start > GFX_MAX_SPRITES
        || max_count > GFX_MAX_SPRITES - start
        || run < 0
        || run >= GFX_MAX_SPRITE_RUNS
        || order < 0
        || order >= GFX_MAX_ORDER
        || clip < -1
        || material != 0
        || blend != 0
        || filter != 0
        || pass != 0
        || flags != 0
    ) {
        if (max_count > 0) {
            gfx_cmd_i32[GFX_I_DROPPED_SPRITES] = gfx_cmd_i32[GFX_I_DROPPED_SPRITES] + max_count;
            gfx_cmd_i32[GFX_I_DROPPED_SPRITE_RUNS] = gfx_cmd_i32[GFX_I_DROPPED_SPRITE_RUNS] + 1;
        }
        return 0;
    }
    gfx_sprite_writer_next_token = gfx_sprite_writer_next_token + 1;
    if (gfx_sprite_writer_next_token <= 0) {
        gfx_sprite_writer_next_token = 1;
    }
    gfx_sprite_writer_token = gfx_sprite_writer_next_token;
    gfx_sprite_writer_start = start;
    gfx_sprite_writer_capacity = max_count;
    gfx_sprite_writer_written = 0;
    gfx_sprite_writer_clip = clip;
    gfx_sprite_writer_material = material;
    gfx_sprite_writer_blend = blend;
    gfx_sprite_writer_filter = filter;
    gfx_sprite_writer_pass = pass;
    gfx_sprite_writer_flags = flags;
    return gfx_sprite_writer_token;
}

// Checked sequential direct store into the canonical instance lanes.
function gfx_cmd_sprite_run_write(
    token: i32,
    sprite_ref: SpriteRef,
    tint_rgba: i32,
    instance_flags: i32,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    src_x: f32,
    src_y: f32,
    src_w: f32,
    src_h: f32,
    pivot_x: f32,
    pivot_y: f32,
    scale_x: f32,
    scale_y: f32,
    rotation: f32
): bool {
    if (
        token <= 0
        || token != gfx_sprite_writer_token
        || gfx_sprite_writer_written < 0
        || gfx_sprite_writer_written >= gfx_sprite_writer_capacity
        || sprite_ref == SpriteRef.Invalid
        || instance_flags != 0
        || w <= 0.0
        || h <= 0.0
        || src_x < 0.0
        || src_y < 0.0
        || src_w < 0.0
        || src_h < 0.0
        ||(src_w == 0.0 && src_h != 0.0)
        ||(src_w != 0.0 && src_h == 0.0)
        || scale_x == 0.0
        || scale_y == 0.0
    ) {
        return false;
    }
    let index: i32 = gfx_sprite_writer_start + gfx_sprite_writer_written;
    let base_i: i32 = GFX_I_SPRITE_BASE + index * GFX_SPRITE_STRIDE_I32;
    let base_f: i32 = GFX_F_SPRITE_BASE + index * GFX_SPRITE_STRIDE_F32;
    gfx_cmd_i32[base_i + 0] = sprite_ref;
    gfx_cmd_i32[base_i + 1] = tint_rgba;
    gfx_cmd_i32[base_i + 2] = instance_flags;
    gfx_cmd_f32[base_f + 0] = x;
    gfx_cmd_f32[base_f + 1] = y;
    gfx_cmd_f32[base_f + 2] = w;
    gfx_cmd_f32[base_f + 3] = h;
    gfx_cmd_f32[base_f + 4] = src_x;
    gfx_cmd_f32[base_f + 5] = src_y;
    gfx_cmd_f32[base_f + 6] = src_w;
    gfx_cmd_f32[base_f + 7] = src_h;
    gfx_cmd_f32[base_f + 8] = pivot_x;
    gfx_cmd_f32[base_f + 9] = pivot_y;
    gfx_cmd_f32[base_f + 10] = scale_x;
    gfx_cmd_f32[base_f + 11] = scale_y;
    gfx_cmd_f32[base_f + 12] = rotation;
    gfx_sprite_writer_written = gfx_sprite_writer_written + 1;
    return true;
}

function @effects(graphics) gfx_cmd_sprite_run_finalize(token: i32, actual_count: i32): bool {
    if (token <= 0 || token != gfx_sprite_writer_token || actual_count < 0 || actual_count > gfx_sprite_writer_written) {
        return false;
    }
    if (actual_count == 0) {
        gfx_sprite_writer_token = 0;
        return true;
    }
    let run: i32 = gfx_cmd_i32[GFX_I_SPRITE_RUN_COUNT];
    let order: i32 = gfx_cmd_i32[GFX_I_ORDER_COUNT];
    if (run < 0 || run >= GFX_MAX_SPRITE_RUNS || order < 0 || order >= GFX_MAX_ORDER) {
        return false;
    }
    let base: i32 = GFX_I_SPRITE_RUN_BASE + run * GFX_SPRITE_RUN_STRIDE_I32;
    gfx_cmd_i32[base + 0] = gfx_sprite_writer_start;
    gfx_cmd_i32[base + 1] = actual_count;
    gfx_cmd_i32[base + 2] = gfx_sprite_writer_clip;
    gfx_cmd_i32[base + 3] = gfx_sprite_writer_material;
    gfx_cmd_i32[base + 4] = gfx_sprite_writer_blend;
    gfx_cmd_i32[base + 5] = gfx_sprite_writer_filter;
    gfx_cmd_i32[base + 6] = gfx_sprite_writer_pass;
    gfx_cmd_i32[base + 7] = gfx_sprite_writer_flags;
    gfx_cmd_i32[GFX_I_ORDER_BASE + order] = GFX_ORDER_SPRITE * GFX_ORDER_KIND_SCALE + run;
    // Publish spans only after every instance and header store is complete.
    gfx_cmd_i32[GFX_I_SPRITE_COUNT] = gfx_sprite_writer_start + actual_count;
    gfx_cmd_i32[GFX_I_SPRITE_RUN_COUNT] = run + 1;
    gfx_cmd_i32[GFX_I_ORDER_COUNT] = order + 1;
    gfx_sprite_writer_token = 0;
    return true;
}

function @effects(graphics) gfx_cmd_sprite_run_cancel(token: i32): bool {
    if (token <= 0 || token != gfx_sprite_writer_token) {
        return false;
    }
    gfx_sprite_writer_token = 0;
    return true;
}

function gfx_cmd_sprite_semantic(
    sprite_ref: SpriteRef,
    x: f32,
    y: f32,
    w: f32,
    h: f32,
    src_x: f32,
    src_y: f32,
    src_w: f32,
    src_h: f32,
    pivot_x: f32,
    pivot_y: f32,
    scale_x: f32,
    scale_y: f32,
    rotation: f32,
    tint_rgba: i32
): void {
    let token: i32 = gfx_cmd_sprite_run_reserve(1, -1, 0, 0, 0, 0, 0);
    if (token == 0) {
        return;
    }
    if (
        !gfx_cmd_sprite_run_write(
            token,
            sprite_ref,
            tint_rgba,
            0,
            x,
            y,
            w,
            h,
            src_x,
            src_y,
            src_w,
            src_h,
            pivot_x,
            pivot_y,
            scale_x,
            scale_y,
            rotation
        )
    ) {
        gfx_cmd_sprite_run_cancel(token);
        return;
    }
    gfx_cmd_sprite_run_finalize(token, 1);
}

function gfx_cmd_sprite(sprite_ref: SpriteRef, x: f32, y: f32, w: f32, h: f32, rot_deg: i32, a: i32): void {
    let alpha: i32 = a;
    if (alpha < 0) {
        alpha = 0;
    }
    if (alpha > 255) {
        alpha = 255;
    }
    gfx_cmd_sprite_semantic(sprite_ref, x, y, w, h, 0.0, 0.0, 0.0, 0.0, w * 0.5, h * 0.5, 1.0, 1.0, i32_to_f32(rot_deg), -256 + alpha);
}

function gfx_cmd_text(font: i32, text: utf8[], x: f32, y: f32, r: f32, g: f32, b: f32, a: f32): void {
    let i: i32 = gfx_cmd_i32[GFX_I_TEXT_COUNT];
    if (i >= GFX_MAX_TEXT) {
        gfx_cmd_i32[GFX_I_DROPPED_TEXT] = gfx_cmd_i32[GFX_I_DROPPED_TEXT] + 1;
        return;
    }

    let byte_len: i32 = length_bytes(text);
    if (byte_len < 0) {
        byte_len = 0;
    }
    if (byte_len > 1024) {
        byte_len = 1024;
    } // hard cap per command to keep worst-case bounded

    let used: i32 = gfx_cmd_i32[GFX_I_TEXT_BYTES_USED];
    if (used < 0) {
        used = 0;
    }
    if (used + byte_len + 1 > GFX_TEXT_MAX_BYTES) {
        gfx_cmd_i32[GFX_I_DROPPED_TEXT] = gfx_cmd_i32[GFX_I_DROPPED_TEXT] + 1;
        return;
    }
    if (!gfx_cmd_append_order(GFX_ORDER_TEXT, i)) {
        gfx_cmd_i32[GFX_I_DROPPED_TEXT] = gfx_cmd_i32[GFX_I_DROPPED_TEXT] + 1;
        return;
    }

    sys_memcpy_u8(gfx_cmd_u8, used, text, 0, byte_len);
    gfx_cmd_u8[used + byte_len] = 0;

    let base_i: i32 = GFX_I_TEXT_BASE + i * GFX_TEXT_STRIDE_I32;
    gfx_cmd_i32[base_i + 0] = font;
    gfx_cmd_i32[base_i + 1] = used;
    gfx_cmd_i32[base_i + 2] = byte_len;

    let base_f: i32 = GFX_F_TEXT_BASE + i * GFX_TEXT_STRIDE_F32;
    gfx_cmd_f32[base_f + 0] = x;
    gfx_cmd_f32[base_f + 1] = y;
    gfx_cmd_f32[base_f + 2] = r;
    gfx_cmd_f32[base_f + 3] = g;
    gfx_cmd_f32[base_f + 4] = b;
    gfx_cmd_f32[base_f + 5] = a;

    gfx_cmd_i32[GFX_I_TEXT_BYTES_USED] = used + byte_len + 1;
    gfx_cmd_i32[GFX_I_TEXT_COUNT] = i + 1;
}

// Write a text draw referencing a cached glyph run (no per-frame UTF-8 bytes copied).
// The runtime interprets `byte_offset < 0` as a cached text handle.
function gfx_cmd_text_cached(font: i32, run_handle: i32, x: f32, y: f32, r: f32, g: f32, b: f32, a: f32): void {
    let i: i32 = gfx_cmd_i32[GFX_I_TEXT_COUNT];
    if (i >= GFX_MAX_TEXT) {
        gfx_cmd_i32[GFX_I_DROPPED_TEXT] = gfx_cmd_i32[GFX_I_DROPPED_TEXT] + 1;
        return;
    }
    if (run_handle <= 0) {
        gfx_cmd_i32[GFX_I_DROPPED_TEXT] = gfx_cmd_i32[GFX_I_DROPPED_TEXT] + 1;
        return;
    }
    if (!gfx_cmd_append_order(GFX_ORDER_TEXT, i)) {
        gfx_cmd_i32[GFX_I_DROPPED_TEXT] = gfx_cmd_i32[GFX_I_DROPPED_TEXT] + 1;
        return;
    }

    let base_i: i32 = GFX_I_TEXT_BASE + i * GFX_TEXT_STRIDE_I32;
    gfx_cmd_i32[base_i + 0] = font;
    gfx_cmd_i32[base_i + 1] = 0 - run_handle; // negative => cached run handle
    gfx_cmd_i32[base_i + 2] = 0;

    let base_f: i32 = GFX_F_TEXT_BASE + i * GFX_TEXT_STRIDE_F32;
    gfx_cmd_f32[base_f + 0] = x;
    gfx_cmd_f32[base_f + 1] = y;
    gfx_cmd_f32[base_f + 2] = r;
    gfx_cmd_f32[base_f + 3] = g;
    gfx_cmd_f32[base_f + 4] = b;
    gfx_cmd_f32[base_f + 5] = a;

    gfx_cmd_i32[GFX_I_TEXT_COUNT] = i + 1;
}

function @inline gfx_cmd_submit(): void {
    gfx_cmd_i32[GFX_I_FLAGS] = gfx_cmd_i32[GFX_I_FLAGS] + GFX_FLAG_PRESENT;
}

function @inline gfx_cmd_mark_present(): void {
    gfx_cmd_i32[GFX_I_FLAGS] = gfx_cmd_i32[GFX_I_FLAGS] + GFX_FLAG_PRESENT;
}

function @inline gfx_cmd_line_count(): i32 {
    return gfx_cmd_i32[GFX_I_LINE_COUNT];
}

function @inline gfx_cmd_sprite_count(): i32 {
    return gfx_cmd_i32[GFX_I_SPRITE_COUNT];
}

function @inline gfx_cmd_sprite_run_count(): i32 {
    return gfx_cmd_i32[GFX_I_SPRITE_RUN_COUNT];
}

function @inline gfx_cmd_rect_count(): i32 {
    return gfx_cmd_i32[GFX_I_RECT_COUNT];
}

function @inline gfx_cmd_clip_count(): i32 {
    return gfx_cmd_i32[GFX_I_CLIP_COUNT];
}

function @inline gfx_cmd_text_count(): i32 {
    return gfx_cmd_i32[GFX_I_TEXT_COUNT];
}

function @inline gfx_cmd_order_count(): i32 {
    return gfx_cmd_i32[GFX_I_ORDER_COUNT];
}

function @inline gfx_cmd_dropped_lines(): i32 {
    return gfx_cmd_i32[GFX_I_DROPPED_LINES];
}

function @inline gfx_cmd_dropped_sprites(): i32 {
    return gfx_cmd_i32[GFX_I_DROPPED_SPRITES];
}

function @inline gfx_cmd_dropped_rects(): i32 {
    return gfx_cmd_i32[GFX_I_DROPPED_RECTS];
}

function @inline gfx_cmd_dropped_clips(): i32 {
    return gfx_cmd_i32[GFX_I_DROPPED_CLIPS];
}

function @inline gfx_cmd_dropped_text(): i32 {
    return gfx_cmd_i32[GFX_I_DROPPED_TEXT];
}

function @inline gfx_cmd_dropped_order(): i32 {
    return gfx_cmd_i32[GFX_I_DROPPED_ORDER];
}
