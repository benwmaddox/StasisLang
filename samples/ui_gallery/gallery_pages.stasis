import "/vendor/stasis/stdlib/graphics.stasis";
import "ui_single_pass.stasis";
import "gallery_state.stasis";
import "gallery_common.stasis";

function gallery_draw_stacks(): void {
    let x: f32 = ui_current_x();
    let y: f32 = ui_current_y();
    let w: f32 = ui_current_width();
    let h: f32 = ui_current_height();
    ui_inset(x, y, w, h, 0.0, 0.0, 0.0, 0.0);
    ui_hstack_begin(x, y, w, h, 18.0, UiStackDirection.Forward);
    ui_hstack_next_fixed(330.0);
    gallery_panel(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.05, 0.12, 0.18);
    gallery_label("HORIZONTAL STACK", ui_current_x() + 16.0, ui_current_y() + 14.0, 0.82, 0.94, 1.0, 1.0);
    gallery_label("fixed + fixed + final rest", ui_current_x() + 16.0, ui_current_y() + 40.0, 0.54, 0.72, 0.82, 1.0);
    let stack_x: f32 = ui_current_x() + 16.0;
    let stack_y: f32 = ui_current_y() + 80.0;
    let stack_w: f32 = ui_current_width() - 32.0;
    let stack_h: f32 = 52.0;
    ui_hstack_begin(stack_x, stack_y, stack_w, stack_h, 8.0, UiStackDirection.Forward);
    ui_hstack_next_fixed(54.0);
    fill_rect(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.22, 0.60, 0.72, 1.0);
    ui_hstack_next_fixed(72.0);
    fill_rect(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.88, 0.54, 0.22, 1.0);
    ui_hstack_next_rest();
    fill_rect(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.30, 0.44, 0.56, 1.0);
    ui_hstack_end();
    gallery_label("rest = remaining width", stack_x, stack_y + 66.0, 0.58, 0.78, 0.88, 1.0);

    ui_hstack_next_rest();
    gallery_panel(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.05, 0.12, 0.18);
    gallery_label("NESTED VERTICAL STACK", ui_current_x() + 16.0, ui_current_y() + 14.0, 0.82, 0.94, 1.0, 1.0);
    gallery_label("spacing is explicit and geometry is disposable", ui_current_x() + 16.0, ui_current_y() + 40.0, 0.54, 0.72, 0.82, 1.0);
    let inner_x: f32 = ui_current_x() + 22.0;
    let inner_y: f32 = ui_current_y() + 76.0;
    let inner_w: f32 = ui_current_width() - 44.0;
    let inner_h: f32 = ui_current_height() - 98.0;
    ui_vstack_begin(inner_x, inner_y, inner_w, inner_h, 8.0, UiStackDirection.Forward);
    ui_vstack_next_fixed(42.0);
    fill_rect(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.18, 0.42, 0.56, 1.0);
    gallery_label("title", ui_current_x() + 12.0, ui_current_y() + 11.0, 0.9, 0.96, 1.0, 1.0);
    ui_vstack_next_fixed(42.0);
    fill_rect(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.18, 0.34, 0.46, 1.0);
    gallery_label("row", ui_current_x() + 12.0, ui_current_y() + 11.0, 0.8, 0.9, 0.96, 1.0);
    ui_vstack_next_rest();
    fill_rect(ui_current_x(), ui_current_y(), ui_current_width(), ui_current_height(), 0.12, 0.23, 0.32, 1.0);
    gallery_label("final rest", ui_current_x() + 12.0, ui_current_y() + 11.0, 0.7, 0.84, 0.9, 1.0);
    ui_vstack_end();
    ui_hstack_end();
    gallery_label("No previous-frame x/y is consulted. Resize the window to see both recipes resolve again.", x, y + h - 25.0, 0.62, 0.78, 0.88, 1.0);
}

