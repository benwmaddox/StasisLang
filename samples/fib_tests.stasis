function fib(n: i32): i32 {
    let a: i32;
    let b: i32;
    let i: i32;
    let next: i32;

    a.=(0);
    b.=(1);

    if (n.==(0)) {
        return 0;
    }

    for i.=(1); i.<(n); i.=(i.+(1)) {
        next.=(a.+(b));
        a.=(b);
        b.=(next);
    }

    return b;
}

test `fib 10`() : bool {
    return fib(10).==(55);
}

test `fib 20`() : bool {
    return fib(20).==(6765);
}

test `fib 30`() : bool {
    return fib(30).==(832040);
}

test `fib 35`() : bool {
    return fib(35).==(9227465);
}

test `fib 1000`() : bool {
    return fib(1000).==(1556111435);
}
test `fib 1000000000 failing test`() : bool {
    return fib(1000000000).==(1556111435);
}
