import "../src/stdlib/stdlib.stasis";

// Test enum functionality in Stasis

enum State {
    Idle,
    Jump,
    Run,
    Fall
}

enum Direction {
    North,
    South,
    East,
    West
}

export function main(): i32 {
    // Test enum member values with proper type safety
    let idle: State = State.Idle;
    let jump: State = State.Jump;
    let run: State = State.Run;
    let fall: State = State.Fall;

    // Print enum values (they lower to i32: 0, 1, 2, 3)
    print_int(0);   // Idle
    print_int(1);   // Jump
    print_int(2);   // Run
    print_int(3);   // Fall

    // Test enum comparison
    if (idle == State.Idle) {
        print_int(100);  // Should print 100
    }

    // Test using enum in variable assignment
    let current_state: State = State.Run;
    if (current_state == State.Run) {
        print_int(200);  // Should print 200
    }

    // Test different enum
    let dir: Direction = Direction.North;
    print_int(0);  // North

    let south: Direction = Direction.South;
    print_int(1);  // South

    return 0;
}

test `enum members can be compared`(): bool {
    return State.Idle == State.Idle && State.Jump != State.Idle;
}

test `different enum types are independent`(): bool {
    let state: State = State.Idle;
    let dir: Direction = Direction.North;
    return state == State.Idle && dir == Direction.North;
}

test `enum values can be compared and reassigned`(): bool {
    let state: State = State.Jump;
    if (state == State.Jump) {
        state = State.Idle;
    }
    return state == State.Idle && state != State.Jump;
}
