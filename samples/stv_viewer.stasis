// STV Viewer - preview `.stv` sprite files with a file tree panel.
// Controls: Up/Down to move, Enter to open, Left to go up, Tab toggles mode, Esc to quit.

// SDL scancodes
const KEY_ESCAPE: i32 = 41;
const KEY_LEFT: i32 = 80;
const KEY_UP: i32 = 82;
const KEY_DOWN: i32 = 81;
const KEY_TAB: i32 = 43;
const KEY_RETURN: i32 = 40;

// Layout constants
const TREE_PANEL_RATIO: f32 = 0.30;
const HEADER_HEIGHT: f32 = 52.0;
const STATUS_BAR_HEIGHT: f32 = 28.0;
const PANEL_PADDING: f32 = 12.0;
const FRAME_TIME_MS: i32 = 16;
const KEY_REPEAT_DELAY: i32 = 300;
const KEY_REPEAT_RATE: i32 = 100;

// Directory list constants
const DIR_LIST_MAX_ENTRIES: i32 = 256;
const DIR_LIST_NAME_LEN: i32 = 260;
const PATH_BUFFER: i32 = 520;

// Gallery layout
const MODE_SINGLE: i32 = 0;
const MODE_GALLERY: i32 = 1;
const GALLERY_COLS: i32 = 3;
const GALLERY_ITEM_SIZE: f32 = 160.0;
const GALLERY_SPACING: f32 = 18.0;
const TREE_ITEM_HEIGHT: f32 = 22.0;

struct DirEntry {
    name: string[260];
    is_dir: bool;
}

struct DirList {
    entries: DirEntry[256];
    count: i32;
}

struct KeyState {
    down: bool;
    was_down: bool;
    press_time: i32;
    last_repeat: i32;
}

struct WindowSize {
    width: i32;
    height: i32;
    tree_panel_w: f32;
    preview_w: f32;
    preview_h: f32;
    tree_x: f32;
}

struct ViewerState {
    font: i32;
    mode: i32;
    current_dir: string[260];
    temp_path: string[520];
    selected_path: string[520];
    selected_idx: i32;
    selected_handle: i32;
    window: WindowSize;
    last_window_width: i32;
    last_window_height: i32;
    key_left: KeyState;
    key_up: KeyState;
    key_down: KeyState;
    key_tab: KeyState;
    key_return: KeyState;
    frame_start: i32;
    running: bool;
}

global state: ViewerState;
global dir_list: DirList;
global entry_name: string[260];

// Helper: join directory + filename
function join_path(dst: string[520], base: string[260], name: string[260]): void {
    str_copy(dst, base);
    let len: i32 = str_len(dst);
    if (len > 0) {
        let last: i32 = str_get(dst, len - 1);
        if (last != 47) {  // '/'
            str_append_char(dst, 47);
        }
    }
    str_append(dst, name);
}

function is_name_stv(name: string[260]): bool {
    let len: i32 = str_len(name);
    if (len < 4) {
        return false;
    }
    let c0: i32 = str_get(name, len - 4);
    let c1: i32 = str_get(name, len - 3);
    let c2: i32 = str_get(name, len - 2);
    let c3: i32 = str_get(name, len - 1);
    return c0 == 46 && c1 == 115 && c2 == 116 && c3 == 118;
}

function write_root_dir(dst: string[260]): void {
    str_clear(dst);
    str_append_char(dst, 97);   // 'a'
    str_append_char(dst, 115);  // 's'
    str_append_char(dst, 115);  // 's'
    str_append_char(dst, 101);  // 'e'
    str_append_char(dst, 116);  // 't'
    str_append_char(dst, 115);  // 's'
    str_append_char(dst, 95);   // '_'
    str_append_char(dst, 115);  // 's'
    str_append_char(dst, 114);  // 'r'
    str_append_char(dst, 99);   // 'c'
}

function update_window_layout(): bool {
    let new_w: i32 = 0;
    let new_h: i32 = 0;
    get_window_size(new_w, new_h);
    let changed: bool = new_w != state.last_window_width || new_h != state.last_window_height;
    state.window.width = new_w;
    state.window.height = new_h;
    state.last_window_width = new_w;
    state.last_window_height = new_h;

    let width_f: f32 = state.window.width;
    let height_f: f32 = state.window.height;
    state.window.tree_panel_w = width_f * TREE_PANEL_RATIO;
    state.window.preview_w = width_f - state.window.tree_panel_w - (PANEL_PADDING * 3.0);
    state.window.preview_h = height_f - HEADER_HEIGHT - STATUS_BAR_HEIGHT;
    state.window.tree_x = width_f - state.window.tree_panel_w - PANEL_PADDING;
    return changed;
}

function refresh_directory(): void {
    let result: i32 = list_directory(state.current_dir, dir_list);
    if (result < 0) {
        result = 0;
    }
    dir_list_count = result;
    if (state.selected_idx < 0) {
        state.selected_idx = 0;
    }
    if (state.selected_idx >= dir_list_count) {
        state.selected_idx = dir_list_count - 1;
        if (state.selected_idx < 0) {
            state.selected_idx = 0;
        }
    }
}

function update_selected_preview(): void {
    state.selected_handle = 0;
    str_clear(state.selected_path);
    if (dir_list_count <= 0) {
        return;
    }
    if (state.selected_idx < 0 || state.selected_idx >= dir_list_count) {
        return;
    }
    let idx: i32 = state.selected_idx;
    if (dir_list_entries_is_dir[idx]) {
        return;
    }
    dir_list_entry_copy_name(dir_list, idx, entry_name);
    if (!is_name_stv(entry_name)) {
        return;
    }
    join_path(state.temp_path, state.current_dir, entry_name);
    str_copy(state.selected_path, state.temp_path);
    state.selected_handle = gfx_load_sprite(state.temp_path);
}

function go_up_directory(): void {
    let len: i32 = str_len(state.current_dir);
    if (len <= 0) {
        return;
    }
    let idx: i32 = len - 1;
    let slash_found: bool = false;
    for (; idx >= 0 && !slash_found; idx = idx - 1) {
        let c: i32 = str_get(state.current_dir, idx);
        if (c == 47) {
            str_set(state.current_dir, idx, 0);
            slash_found = true;
        }
    }
    if (!slash_found) {
        str_clear(state.current_dir);
    }
    refresh_directory();
    state.selected_idx = 0;
    update_selected_preview();
}

function handle_input(current_time: i32): void {
    state.key_tab.was_down = state.key_tab.down;
    state.key_tab.down = is_key_down(KEY_TAB);
    if (state.key_tab.down && !state.key_tab.was_down) {
        if (state.mode == MODE_SINGLE) {
            state.mode = MODE_GALLERY;
        } else {
            state.mode = MODE_SINGLE;
        }
    }

    state.key_up.was_down = state.key_up.down;
    state.key_up.down = is_key_down(KEY_UP);
    if (state.key_up.down) {
        if (!state.key_up.was_down) {
            state.key_up.press_time = current_time;
            state.key_up.last_repeat = current_time;
            if (state.selected_idx > 0) {
                state.selected_idx = state.selected_idx - 1;
                update_selected_preview();
            }
        } else {
            let held: i32 = current_time - state.key_up.press_time;
            if (held > KEY_REPEAT_DELAY) {
                let since: i32 = current_time - state.key_up.last_repeat;
                if (since > KEY_REPEAT_RATE) {
                    state.key_up.last_repeat = current_time;
                    if (state.selected_idx > 0) {
                        state.selected_idx = state.selected_idx - 1;
                        update_selected_preview();
                    }
                }
            }
        }
    }

    state.key_down.was_down = state.key_down.down;
    state.key_down.down = is_key_down(KEY_DOWN);
    if (state.key_down.down) {
        if (!state.key_down.was_down) {
            state.key_down.press_time = current_time;
            state.key_down.last_repeat = current_time;
        if (state.selected_idx < dir_list_count - 1) {
            state.selected_idx = state.selected_idx + 1;
            update_selected_preview();
        }
        } else {
            let held2: i32 = current_time - state.key_down.press_time;
            if (held2 > KEY_REPEAT_DELAY) {
                let since2: i32 = current_time - state.key_down.last_repeat;
                if (since2 > KEY_REPEAT_RATE) {
                    state.key_down.last_repeat = current_time;
            if (state.selected_idx < dir_list_count - 1) {
                state.selected_idx = state.selected_idx + 1;
                update_selected_preview();
            }
        }
            }
        }
    }

    state.key_return.was_down = state.key_return.down;
    state.key_return.down = is_key_down(KEY_RETURN);
    if (state.key_return.down && !state.key_return.was_down) {
        if (state.selected_idx >= 0 && state.selected_idx < dir_list_count) {
            let idx: i32 = state.selected_idx;
            if (dir_list_entries_is_dir[idx]) {
                dir_list_entry_copy_name(dir_list, idx, entry_name);
                join_path(state.temp_path, state.current_dir, entry_name);
                str_copy(state.current_dir, state.temp_path);
                refresh_directory();
                state.selected_idx = 0;
            }
            update_selected_preview();
        }
    }

    state.key_left.was_down = state.key_left.down;
    state.key_left.down = is_key_down(KEY_LEFT);
    if (state.key_left.down && !state.key_left.was_down) {
        go_up_directory();
    }
}

function draw_rect_outline(x: f32, y: f32, w: f32, h: f32, r: f32, g: f32, b: f32, a: f32): void {
    draw_line(x, y, x + w, y, r, g, b, a);
    draw_line(x + w, y, x + w, y + h, r, g, b, a);
    draw_line(x + w, y + h, x, y + h, r, g, b, a);
    draw_line(x, y + h, x, y, r, g, b, a);
}

function draw_header(): void {
    draw_text(state.font, "STV Viewer  |  Up/Down select  Enter open  Left up  Tab mode  Esc quit", PANEL_PADDING, 14.0, 0.9, 0.9, 1.0, 1.0);
    draw_text(state.font, "Dir:", PANEL_PADDING, 32.0, 0.7, 0.8, 1.0, 1.0);
    draw_text(state.font, state.current_dir, PANEL_PADDING + 32.0, 32.0, 0.9, 0.9, 1.0, 1.0);
}

function draw_status_bar(): void {
    let height_f: f32 = state.window.height;
    let y: f32 = height_f - STATUS_BAR_HEIGHT + 6.0;
    let label: string = "Mode: Single";
    if (state.mode != MODE_SINGLE) {
        label = "Mode: Gallery";
    }
    draw_text(state.font, label, PANEL_PADDING, y, 0.7, 0.9, 0.7, 1.0);
    if (str_len(state.selected_path) > 0) {
        draw_text(state.font, state.selected_path, PANEL_PADDING + 140.0, y, 0.9, 0.9, 1.0, 1.0);
    }
}

function draw_tree_panel(): void {
    print_string("draw_tree_panel: start\n");
    let x0: f32 = state.window.tree_x;
    let y0: f32 = HEADER_HEIGHT + PANEL_PADDING;
    let w: f32 = state.window.tree_panel_w;
    let h: f32 = state.window.preview_h - PANEL_PADDING;
    print_string("draw_tree_panel: after locals\n");

    draw_rect_outline(x0, y0, w, h, 0.2, 0.2, 0.3, 1.0);
    print_string("draw_tree_panel: after rect\n");
    draw_text(state.font, "Contents", x0 + 10.0, y0 + 8.0, 0.9, 0.9, 1.0, 1.0);
    print_string("draw_tree_panel: after text\n");

    let max_visible: i32 = (h - 28.0) / TREE_ITEM_HEIGHT;
    if (max_visible < 1) {
        max_visible = 1;
    }
    print_string("draw_tree_panel: calculated max_visible\n");

    print_string("draw_tree_panel: about to access dir_list_entries_name[0]\n");
    draw_text(state.font, dir_list_entries_name[0], x0 + 42.0, y0 + 30.0, 0.9, 0.9, 1.0, 1.0);
    print_string("draw_tree_panel: drew entry name\n");
}

function draw_preview_single(): void {
    let x0: f32 = PANEL_PADDING;
    let y0: f32 = HEADER_HEIGHT + PANEL_PADDING;
    let w: f32 = state.window.preview_w;
    let h: f32 = state.window.preview_h - PANEL_PADDING;

    draw_rect_outline(x0, y0, w, h, 0.2, 0.2, 0.3, 1.0);
    draw_text(state.font, "Preview", x0 + 10.0, y0 + 8.0, 0.9, 0.9, 1.0, 1.0);

    if (state.selected_handle != 0) {
        let cx: f32 = x0 + (w * 0.5);
        let cy: f32 = y0 + (h * 0.55);
        gfx_poll_reload(state.selected_handle);
        gfx_draw_sprite(state.selected_handle, cx, cy, 4.0, 4.0, 0.0, 1.0, 1.0, 1.0, 1.0);
        if (state.selected_idx >= 0 && state.selected_idx < dir_list_count) {
            dir_list_entry_copy_name(dir_list, state.selected_idx, entry_name);
            draw_text(state.font, entry_name, x0 + 10.0, y0 + h - 28.0, 0.9, 0.9, 1.0, 1.0);
        }
    } else {
        draw_text(state.font, "Select a .stv file to preview", x0 + 10.0, y0 + 40.0, 0.7, 0.8, 1.0, 1.0);
    }
}

function draw_preview_gallery(): void {
    let x0: f32 = PANEL_PADDING;
    let y0: f32 = HEADER_HEIGHT + PANEL_PADDING;
    let w: f32 = state.window.preview_w;
    let h: f32 = state.window.preview_h - PANEL_PADDING;

    draw_rect_outline(x0, y0, w, h, 0.2, 0.2, 0.3, 1.0);
    draw_text(state.font, "Gallery", x0 + 10.0, y0 + 8.0, 0.9, 0.9, 1.0, 1.0);

    let gallery_cols_f: f32 = GALLERY_COLS;
    let margin_x: f32 = (w - ((gallery_cols_f * GALLERY_ITEM_SIZE) + ((gallery_cols_f - 1.0) * GALLERY_SPACING))) / 2.0;
    if (margin_x < 10.0) {
        margin_x = 10.0;
    }

    let shown: i32 = 0;
    let idx: i32 = 0;
    for (idx = 0; idx < dir_list_count && shown < 12; idx = idx + 1) {
        let entry_is_dir: bool = dir_list_entries_is_dir[idx];
        dir_list_entry_copy_name(dir_list, idx, entry_name);
        if (!entry_is_dir && is_name_stv(entry_name)) {
            let row: i32 = shown / GALLERY_COLS;
            let col: i32 = shown % GALLERY_COLS;
            let row_f: f32 = row;
            let col_f: f32 = col;
            let cx: f32 = x0 + margin_x + (col_f * (GALLERY_ITEM_SIZE + GALLERY_SPACING)) + (GALLERY_ITEM_SIZE * 0.5);
            let cy: f32 = y0 + 48.0 + (row_f * (GALLERY_ITEM_SIZE + 50.0));
            if (cy + (GALLERY_ITEM_SIZE * 0.5) > y0 + h - 12.0) {
                return;
            }

            join_path(state.temp_path, state.current_dir, entry_name);
            let handle: i32 = gfx_load_sprite(state.temp_path);
            if (handle != 0) {
                gfx_poll_reload(handle);
                gfx_draw_sprite(handle, cx, cy, 2.5, 2.5, 0.0, 1.0, 1.0, 1.0, 1.0);
            }

            draw_text(state.font, entry_name, cx - (GALLERY_ITEM_SIZE * 0.5), cy + (GALLERY_ITEM_SIZE * 0.5) + 10.0, 0.9, 0.9, 1.0, 1.0);
            shown = shown + 1;
        }
    }
}

function draw_preview_panel(): void {
    if (state.mode == MODE_SINGLE) {
        draw_preview_single();
    } else {
        draw_preview_gallery();
    }
}

function init_viewer(): void {
    print_string("  1. Loading font...\n");
    state.font = load_font("C:/Windows/Fonts/arial.ttf", 18);
    print_string("  2. Setting mode...\n");
    state.mode = MODE_SINGLE;
    state.selected_idx = 0;
    state.selected_handle = 0;
    print_string("  3. Writing root dir...\n");
    write_root_dir(state.current_dir);
    print_string("  4. Clearing paths...\n");
    str_clear(state.selected_path);
    print_string("  5. Clearing temp_path...\n");
    str_clear(state.temp_path);
    print_string("  6. Calling refresh_directory...\n");
    refresh_directory();
    print_string("  7. Calling update_selected_preview...\n");
    update_selected_preview();

    print_string("  8. Setting key states...\n");
    state.key_left.down = false;
    state.key_up.down = false;
    state.key_down.down = false;
    state.key_tab.down = false;
    state.key_return.down = false;

    print_string("  9. Setting running flag...\n");
    state.running = true;
    print_string("  10. Updating window layout...\n");
    update_window_layout();
    print_string("  11. init_viewer complete\n");
}

test `tree panel ratio stays constant`(): bool {
    let test_width: i32 = 1200;
    let test_width_f: f32 = test_width;
    let tree_w: f32 = test_width_f * TREE_PANEL_RATIO;
    if (tree_w == 360.0) {
        return true;
    }
    return false;
}

function main(): i32 {
    print_string("=== STV Viewer Starting ===\n");
    let init_ok: bool = init_window(1280, 720, "STV Viewer");
    if (!init_ok) {
        print_string("Failed to init window\n");
        return 1;
    }
    print_string("Window initialized\n");

    print_string("Calling init_viewer...\n");
    init_viewer();
    print_string("init_viewer returned\n");

    print_string("Testing draw functions...\n");
    begin_frame();
    clear(0.02, 0.02, 0.05, 1.0);

    print_string("Testing draw_tree_panel alone...\n");
    draw_tree_panel();
    print_string("Completed draw_tree_panel\n");

    end_frame();
    print_string("All drawing completed\n");

    return 0;

    print_string("Executing one iteration\n");
    state.frame_start = get_time_ms();

    print_string("Before update_window_layout\n");
    update_window_layout();
    print_string("Before handle_input\n");
    handle_input(state.frame_start);

    print_string("Before begin_frame\n");
    begin_frame();
    clear(0.02, 0.02, 0.05, 1.0);
    print_string("Before draw_header\n");
    draw_header();
    print_string("Before draw_preview_panel\n");
    draw_preview_panel();
    print_string("Before draw_tree_panel\n");
    draw_tree_panel();
    print_string("Before draw_status_bar\n");
    draw_status_bar();
    print_string("Before end_frame\n");
    end_frame();

    print_string("Done with one iteration\n");
    return 0;
}
