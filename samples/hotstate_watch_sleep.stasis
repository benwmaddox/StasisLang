import "../src/stdlib/graphics.stasis";
struct SleepState {
    counter: i32;
    start_ms: i32;
}

global state: SleepState;

function main(): i32 {
    print_string("run counter=");
    print_int(state.counter);
    print_char(10);

    state.counter = state.counter + 1;
    state.start_ms = get_time_ms();
    return 0;
}

function tick(): i32 {
    let elapsed: i32 = get_time_ms() - state.start_ms;
    if (elapsed >= 3000) {
        return 1;
    }

    return 0;
}

