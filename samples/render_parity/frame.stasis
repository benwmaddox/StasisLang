import "/.stasis_cache/toolchain/src/stdlib/graphics.stasis";

const PARITY_WINDOW_W: i32 = 640;
const PARITY_WINDOW_H: i32 = 360;

global parity_writer: SpriteRunWriter;

function parity_write_sprite(sprite_ref: SpriteRef, x: f32, y: f32, w: f32, h: f32, rotation: i32, alpha: i32): bool {
    return parity_writer.write(
        sprite_ref,
        -256 + alpha,
        0,
        x,
        y,
        w,
        h,
        0.0,
        0.0,
        0.0,
        0.0,
        w * 0.5,
        h * 0.5,
        1.0,
        1.0,
        i32_to_f32(rotation)
    );
}

function build_parity_frame(canvas_sprite: SpriteRef, opaque_sprite: SpriteRef, translucent_sprite: SpriteRef, font: i32, cached_label: TextRun): void {
    begin_frame();
    clear(0.05, 0.08, 0.13, 1.0);

    if (parity_writer.reserve(1, -1, 0, 0, 0, 0, 0)) {
        if (parity_write_sprite(canvas_sprite, 0.0, 0.0, 640.0, 360.0, 0, 96)) {
            parity_writer.finalize(1);
        } else {
            parity_writer.cancel();
        }
    }
    fill_rect(224.0, 148.0, 192.0, 56.0, 0.16, 0.58, 0.32, 0.78);
    // Invalid extents must leave the background probe unchanged on every backend.
    fill_rect(24.0, 12.0, -12.0, 12.0, 1.0, 0.0, 0.0, 1.0);
    fill_rect(12.0, 24.0, 12.0, -12.0, 1.0, 0.0, 0.0, 1.0);
    fill_rect(24.0, 24.0, -12.0, -12.0, 1.0, 0.0, 0.0, 1.0);
    fill_rect(12.0, 12.0, 0.0, 12.0, 1.0, 0.0, 0.0, 1.0);
    fill_rect(12.0, 12.0, 12.0, 0.0, 1.0, 0.0, 0.0, 1.0);
    draw_line(24.0, 36.0, 616.0, 324.0, 1.0, 0.25, 0.15, 1.0);
    draw_line(24.0, 324.0, 616.0, 36.0, 0.10, 0.85, 1.0, 0.85);

    if (parity_writer.reserve(4, -1, 0, 0, 0, 0, 0)) {
        let written: i32 = 0;
        if (parity_write_sprite(canvas_sprite, 32.0, 48.0, 64.0, 64.0, 0, 255)) {
            written += 1;
        }
        if (parity_write_sprite(opaque_sprite, 136.0, 44.0, 96.0, 72.0, 0, 255)) {
            written += 1;
        }
        if (parity_write_sprite(translucent_sprite, 272.0, 44.0, 96.0, 72.0, 0, 180)) {
            written += 1;
        }
        if (parity_write_sprite(opaque_sprite, 440.0, 36.0, 112.0, 84.0, 27, 180)) {
            written += 1;
        }
        if (written == 4) {
            parity_writer.finalize(4);
        } else {
            parity_writer.cancel();
        }
    }
    draw_text(font, "direct parity", 64.0, 252.0, 0.95, 0.95, 1.0, 1.0);
    cached_label.draw(344.0, 252.0, 1.0, 0.85, 0.25, 1.0);
    end_frame();
}

function append_parity_touch_marker(marker_active: i32, marker_x_i32: i32, marker_y_i32: i32): void {
    if (marker_active != 0) {
        fill_rect(i32_to_f32(marker_x_i32) - 8.0, i32_to_f32(marker_y_i32) - 8.0, 16.0, 16.0, 1.0, 0.65, 0.08, 1.0);
    }
}

function append_it028_marker(revision: i32): void {
    fill_rect(48.0 + i32_to_f32(revision) * 64.0, 48.0, 24.0, 24.0, 0.2, 0.9, 0.95, 1.0);
}
