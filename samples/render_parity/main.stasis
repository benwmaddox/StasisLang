@link("stasis_graphics");

import "frame.stasis";

extern function load_font(path: string, size: i32): i32;

struct Sprite {
    handle: i32;
    width: i32;
    height: i32;
}

struct TextRun {
    font: i32;
    handle: i32;
    width: f32;
    height: f32;
}

function @extern("stasis_jit_sprite_load_from") load_sprite_from(self: Sprite, path: string, width: i32, height: i32): bool;
function @extern("stasis_jit_text_run_load_from") load_text_from(self: TextRun, font: i32, text: string): bool;

global gfx_cmd_i32: i32[34608];
global gfx_cmd_f32: f32[125060];
global gfx_cmd_u8: u8[65536];
global host_i32: i32[768];
global host_f32: f32[64];

// The host consumes this request between ticks; mobile shells already own the
// surface and simply ignore the desktop window size request.
global host_req_flags: i32;
global host_req_window_w_px: i32;
global host_req_window_h_px: i32;
global host_req_seq: i32;

// IT-025 reads this guest-owned value through the live JIT global bridge.  It
// is deliberately independent of host display metadata.
global seam_state_checksum: i32;

// IT-027 keeps the canonical HostFrame pointer lanes in guest-owned state so
// the acceptance proof can observe the same values that drive its marker.
global seam_touch_x: i32;
global seam_touch_y: i32;
global seam_touch_dx: i32;
global seam_touch_dy: i32;
global seam_touch_x_norm_x1000: i32;
global seam_touch_y_norm_x1000: i32;
global seam_touch_down_edge: i32;
global seam_touch_up_edge: i32;
global seam_touch_active: i32;
global seam_touch_marker_active: i32;
global seam_touch_checksum: i32;

struct ParityState {
    opaque: Sprite;
    translucent: Sprite;
    canvas: Sprite;
    font: i32;
    label: TextRun;
}

// Command buffers and host_req_* are fixed host ABI globals. Application-owned
// resources stay under the single root state.
global state: ParityState;

function main(): i32 {
    seam_state_checksum = 2500;
    host_req_flags = 1;
    host_req_window_w_px = PARITY_WINDOW_W;
    host_req_window_h_px = PARITY_WINDOW_H;
    host_req_seq += 1;

    state.opaque.load_sprite_from("assets/opaque.svg", 96, 72);
    state.translucent.load_sprite_from("assets/translucent.svg", 96, 72);
    state.canvas.load_sprite_from("assets/full_canvas.svg", PARITY_WINDOW_W, PARITY_WINDOW_H);
    state.font = load_font("assets/parity.ttf", 24);
    if (state.opaque.handle == 0) {
        return 11;
    }
    if (state.translucent.handle == 0) {
        return 12;
    }
    if (state.canvas.handle == 0) {
        return 13;
    }
    if (state.font == 0) {
        return 14;
    }
    state.label.load_text_from(state.font, "cached parity");
    if (state.label.handle == 0) {
        return 15;
    }
    return 0;
}

function tick(): i32 {
    let touch_x: i32;
    let touch_y: i32;
    let touch_dx: i32;
    let touch_dy: i32;
    let touch_x_norm: i32;
    let touch_y_norm: i32;
    touch_x.from_f32(host_f32[0]);
    touch_y.from_f32(host_f32[1]);
    touch_dx.from_f32(host_f32[2]);
    touch_dy.from_f32(host_f32[3]);
    touch_x_norm.from_f32(host_f32[4] * 1000.0);
    touch_y_norm.from_f32(host_f32[5] * 1000.0);
    seam_touch_x = touch_x;
    seam_touch_y = touch_y;
    seam_touch_dx = touch_dx;
    seam_touch_dy = touch_dy;
    seam_touch_x_norm_x1000 = touch_x_norm;
    seam_touch_y_norm_x1000 = touch_y_norm;
    seam_touch_active = host_i32[545];
    seam_touch_down_edge = host_i32[546];
    seam_touch_up_edge = host_i32[547];
    seam_touch_marker_active = seam_touch_active + seam_touch_up_edge;
    seam_touch_checksum = seam_touch_x + seam_touch_y * 3 + seam_touch_dx * 5 + seam_touch_dy * 7 + seam_touch_x_norm_x1000 * 11 + seam_touch_y_norm_x1000 * 13 + seam_touch_active * 17 + seam_touch_down_edge * 19 + seam_touch_up_edge * 23;
    return 0;
}

function render(): i32 {
    build_parity_frame(
        gfx_cmd_i32,
        gfx_cmd_f32,
        gfx_cmd_u8,
        state.canvas.handle,
        state.opaque.handle,
        state.translucent.handle,
        state.font,
        state.label.handle
    );
    append_parity_touch_marker(gfx_cmd_i32, gfx_cmd_f32, seam_touch_marker_active, seam_touch_x, seam_touch_y);
    return 0;
}

function on_code_swap(): void {
    return;
}
