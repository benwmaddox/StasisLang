import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";

// Smoke-test for runtime screenshots.
//
// Runs 1 frame, draws a sprite + line, dumps a BMP to build/, and exits.
// Intended to be reliable (captures actual backbuffer), unlike OS-level screen capture.

global spr: i32;

function main(): i32 {
    let ok: bool = init_window(320, 240, "gfx_screenshot_dump");
    if (!ok) { return 1; }

    spr = gfx_load_sprite("docs/assets/ui/button_9slice_dark/icon_star.png", 64, 64);

    begin_frame();
    clear(0.05, 0.07, 0.12, 1.0);
    draw_line(10.0, 10.0, 310.0, 230.0, 1.0, 1.0, 1.0, 1.0);
    if (spr != 0) {
        gfx_draw_sprite(spr, 128, 88, 64, 64, 0, 255);
    }

    // Read from the current backbuffer. Call before end_frame().
    let dumped: i32 = gfx_dump_bmp("build/gfx_screenshot_dump.bmp");
    end_frame();

    if (dumped == 0) { return 2; }
    return 0;
}

