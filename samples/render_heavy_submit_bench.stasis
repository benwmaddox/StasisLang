import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/gfx_cmd.stasis";

// Heavy render submission benchmark:
// - Per-call: draw_line() + gfx_draw_sprite() in loops (many host boundary calls).
// - Batched: draw_lines_f32() + gfx_draw_sprites_i32() (2 host calls).
// - Cmd (build): build gfx_cmd streams per-iter + gfx_cmd_submit_no_present().
// - Cmd (prebuilt): build gfx_cmd once + submit only.
//
// Notes:
// - Submission only: no end_frame/present, to isolate host boundary overhead.
// - Coordinates are host pixels.
// - Uses get_time_us() for better signal than ms-scale timers.

const LINE_COUNT: i32 = 10000;
const LINE_STRIDE_F32: i32 = 8;
const LINE_DATA_LEN: i32 = 80000; // LINE_COUNT * LINE_STRIDE_F32

const SPRITE_COUNT: i32 = 4000;
const SPRITE_STRIDE_I32: i32 = 7;
const SPRITE_DATA_LEN: i32 = 28000; // SPRITE_COUNT * SPRITE_STRIDE_I32

const WARMUP_ITERS: i32 = 50;
const BENCH_ITERS: i32 = 500;

struct BenchState {
    lines: f32[80000];
    sprites: i32[28000];
    sprite_handle: i32;
}

global state: BenchState;

function fill_lines(): void {
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE_F32;
        let x1_i: i32 = i % 640;
        let y1_i: i32 = i % 360;
        let x2_i: i32 = (i + 13) % 640;
        let y2_i: i32 = (i + 29) % 360;
        state.lines[base + 0] = i32_to_f32(x1_i); // x1
        state.lines[base + 1] = i32_to_f32(y1_i); // y1
        state.lines[base + 2] = i32_to_f32(x2_i); // x2
        state.lines[base + 3] = i32_to_f32(y2_i); // y2
        state.lines[base + 4] = 0.05; // r
        state.lines[base + 5] = 0.85; // g
        state.lines[base + 6] = 0.78; // b
        state.lines[base + 7] = 1.0;  // a
    }
}

function fill_sprites(): void {
    let i: i32 = 0;
    for (i = 0; i < SPRITE_COUNT; i = i + 1) {
        let base: i32 = i * SPRITE_STRIDE_I32;
        let x: i32 = (i * 3) % 640;
        let y: i32 = (i * 5) % 360;
        let w: i32 = 16 + (i % 32);
        let h: i32 = 16 + ((i + 7) % 32);
        let rot: i32 = i % 360;
        state.sprites[base + 0] = state.sprite_handle;
        state.sprites[base + 1] = x;
        state.sprites[base + 2] = y;
        state.sprites[base + 3] = w;
        state.sprites[base + 4] = h;
        state.sprites[base + 5] = rot;
        state.sprites[base + 6] = 255;
    }
}

function submit_per_call(): void {
    clear(0.08, 0.09, 0.11, 1.0);

    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE_F32;
        draw_line(
            state.lines[base + 0],
            state.lines[base + 1],
            state.lines[base + 2],
            state.lines[base + 3],
            state.lines[base + 4],
            state.lines[base + 5],
            state.lines[base + 6],
            state.lines[base + 7]
        );
    }

    for (i = 0; i < SPRITE_COUNT; i = i + 1) {
        let base: i32 = i * SPRITE_STRIDE_I32;
        gfx_draw_sprite(
            state.sprites[base + 0],
            state.sprites[base + 1],
            state.sprites[base + 2],
            state.sprites[base + 3],
            state.sprites[base + 4],
            state.sprites[base + 5],
            state.sprites[base + 6]
        );
    }
}

function submit_batched(): void {
    clear(0.08, 0.09, 0.11, 1.0);
    draw_lines_f32(state.lines, LINE_COUNT);
    gfx_draw_sprites_i32(state.sprites, SPRITE_COUNT);
}

function submit_cmd_build(): void {
    gfx_cmd_begin();
    gfx_cmd_clear(0.08, 0.09, 0.11, 1.0);

    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE_F32;
        gfx_cmd_line(
            state.lines[base + 0],
            state.lines[base + 1],
            state.lines[base + 2],
            state.lines[base + 3],
            state.lines[base + 4],
            state.lines[base + 5],
            state.lines[base + 6],
            state.lines[base + 7]
        );
    }

    for (i = 0; i < SPRITE_COUNT; i = i + 1) {
        let base: i32 = i * SPRITE_STRIDE_I32;
        gfx_cmd_sprite(
            state.sprites[base + 0],
            state.sprites[base + 1],
            state.sprites[base + 2],
            state.sprites[base + 3],
            state.sprites[base + 4],
            state.sprites[base + 5],
            state.sprites[base + 6]
        );
    }

    gfx_cmd_submit_no_present();
}

function build_cmd_once(): void {
    gfx_cmd_begin();
    gfx_cmd_clear(0.08, 0.09, 0.11, 1.0);

    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE_F32;
        gfx_cmd_line(
            state.lines[base + 0],
            state.lines[base + 1],
            state.lines[base + 2],
            state.lines[base + 3],
            state.lines[base + 4],
            state.lines[base + 5],
            state.lines[base + 6],
            state.lines[base + 7]
        );
    }

    for (i = 0; i < SPRITE_COUNT; i = i + 1) {
        let base: i32 = i * SPRITE_STRIDE_I32;
        gfx_cmd_sprite(
            state.sprites[base + 0],
            state.sprites[base + 1],
            state.sprites[base + 2],
            state.sprites[base + 3],
            state.sprites[base + 4],
            state.sprites[base + 5],
            state.sprites[base + 6]
        );
    }
}

function bench_per_call(iters: i32): i32 {
    let it: i32 = 0;
    let start_us: i32 = get_time_us();
    for (it = 0; it < iters; it = it + 1) {
        begin_frame();
        submit_per_call();
    }
    return get_time_us() - start_us;
}

function bench_batched(iters: i32): i32 {
    let it: i32 = 0;
    let start_us: i32 = get_time_us();
    for (it = 0; it < iters; it = it + 1) {
        begin_frame();
        submit_batched();
    }
    return get_time_us() - start_us;
}

function bench_cmd_build(iters: i32): i32 {
    let it: i32 = 0;
    let start_us: i32 = get_time_us();
    for (it = 0; it < iters; it = it + 1) {
        submit_cmd_build();
    }
    return get_time_us() - start_us;
}

function bench_cmd_prebuilt(iters: i32): i32 {
    let it: i32 = 0;
    let start_us: i32 = get_time_us();
    for (it = 0; it < iters; it = it + 1) {
        gfx_cmd_submit_no_present();
    }
    return get_time_us() - start_us;
}

function main(): i32 {
    let ok: bool = init_window(64, 64, "render_heavy_submit_bench");
    if (!ok) {
        print_string("init_window failed\n");
        return 1;
    }

    // Use a single handle repeated across sprite stream.
    state.sprite_handle = gfx_load_sprite("samples/brickout_revenge/assets/ball.svg", 64, 64);

    fill_lines();
    fill_sprites();

    // Correctness: hash the draw-call stream for one iteration of each path.
    gfx_debug_enable_hash(1);

    begin_frame();
    submit_per_call();
    let hash_per: i32 = gfx_debug_get_frame_hash();

    begin_frame();
    submit_batched();
    let hash_batched: i32 = gfx_debug_get_frame_hash();

    submit_cmd_build();
    let hash_cmd: i32 = gfx_debug_get_frame_hash();

    gfx_debug_enable_hash(0);

    print_string("render_heavy_submit_bench\n");
    print_string("lines=");
    print_int(LINE_COUNT);
    print_string(" sprites=");
    print_int(SPRITE_COUNT);
    print_string(" iters=");
    print_int(BENCH_ITERS);
    print_string(" warmup=");
    print_int(WARMUP_ITERS);
    print_char(10);

    print_string("hash per_call=");
    print_int(hash_per);
    print_string(" batched=");
    print_int(hash_batched);
    print_string(" cmd=");
    print_int(hash_cmd);
    print_char(10);

    if (!(hash_per == hash_batched)) {
        print_string("ERROR: hash mismatch per_call vs batched\n");
        return 2;
    }
    if (!(hash_per == hash_cmd)) {
        print_string("ERROR: hash mismatch per_call vs cmd\n");
        return 3;
    }

    bench_per_call(WARMUP_ITERS);
    bench_batched(WARMUP_ITERS);
    bench_cmd_build(WARMUP_ITERS);
    build_cmd_once();
    bench_cmd_prebuilt(WARMUP_ITERS);

    let per_us: i32 = bench_per_call(BENCH_ITERS);
    let batched_us: i32 = bench_batched(BENCH_ITERS);
    let cmd_build_us: i32 = bench_cmd_build(BENCH_ITERS);
    build_cmd_once();
    let cmd_prebuilt_us: i32 = bench_cmd_prebuilt(BENCH_ITERS);

    print_string("per_call_us=");
    print_int(per_us);
    print_string(" batched_us=");
    print_int(batched_us);
    print_string(" cmd_build_us=");
    print_int(cmd_build_us);
    print_string(" cmd_prebuilt_us=");
    print_int(cmd_prebuilt_us);
    print_char(10);

    return 0;
}
