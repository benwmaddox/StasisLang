struct PresentationListProbe {
    count: i32;
    values: i32[4];
}

struct PresentationState {
    padding: ScalarPadding;
    zzz_commands: PresentationListProbe;
}

global seam_state_checksum: i32;
global state: PresentationState;

function append(self: PresentationListProbe, value: i32): void {
    let index: i32 = self.count;
    self.values[index] = value;
    self.count = index + 1;
}

function main(): i32 {
    init_window(640, 360, "Stasis Nested Receiver Seam");
    seam_state_checksum = 0;
    state.padding.b63.f31 = 32;
    return 0;
}

function tick(): i32 {
    state.zzz_commands.count = 0;
    state.zzz_commands.append(725);
    return 0;
}

function render(): i32 {
    clear(0.04, 0.07, 0.12, 1.0);
    if (state.zzz_commands.count == 1 && state.zzz_commands.values[0] == 725) {
        seam_state_checksum = 725;
        fill_rect(96.0, 72.0, 448.0, 216.0, 0.10, 0.80, 0.32, 1.0);
    } else {
        seam_state_checksum = -725;
        fill_rect(96.0, 72.0, 448.0, 216.0, 0.90, 0.12, 0.16, 1.0);
    }
    return 0;
}

function on_code_swap(): void {
    return;
}
