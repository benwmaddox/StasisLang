import "/.stasis_cache/toolchain/src/stdlib/world_camera.stasis";
import "/.stasis_cache/toolchain/src/stdlib/realtime_controls.stasis";

const SAMPLE_WORLD_W: f32 = 4096.0;
const SAMPLE_WORLD_H: f32 = 4096.0;
const SAMPLE_VIEWPORT_Y: f32 = 40.0;
const SAMPLE_VIEWPORT_W: f32 = 640.0;
const SAMPLE_VIEWPORT_H: f32 = 320.0;
const SAMPLE_TILE_SIZE: f32 = 64.0;

global sample_camera: WorldCamera;
global sample_history: WorldCameraHistory;
global sample_tiles: WorldTileRange;
global sample_control_buttons: i32[1];
global sample_control_x: i32[1];
global sample_control_y: i32[1];
global sample_player_x: f32;
global sample_player_y: f32;
global sample_simulation_ticks: i32;
global sample_control_transitions: i32;
global sample_sequence: i32;
global sample_epoch: i32;

function sample_schedule(axis_x: i32, axis_y: i32): i32 {
    let next_sequence: i32 = sample_sequence + 1;
    let scheduled: i32 = realtime_schedule(0, sample_epoch, next_sequence, realtime_current_tick() + 2, 0, axis_x, axis_y);
    if (scheduled != 0) {
        return scheduled;
    }
    sample_sequence = next_sequence;
    sample_control_transitions = sample_control_transitions + 1;
    return 0;
}

function sample_reset(): i32 {
    realtime_stop();
    let started: i32 = realtime_start(60, 120, 20, 2, 1);
    if (started != 0) {
        return started;
    }
    sample_epoch = realtime_current_epoch(0);
    sample_player_x = 320.0;
    sample_player_y = 320.0;
    sample_simulation_ticks = 0;
    sample_control_transitions = 0;
    sample_sequence = 0;
    sample_history.world_camera_history_reset(sample_player_x, sample_player_y);
    sample_camera.world_camera_configure(0.0, 0.0, SAMPLE_WORLD_W, SAMPLE_WORLD_H, 0.0, SAMPLE_VIEWPORT_Y, SAMPLE_VIEWPORT_W, SAMPLE_VIEWPORT_H, 1.0);
    return sample_schedule(1, 0);
}

function sample_simulation_step(): i32 {
    // Control transitions arrive at 20 Hz and apply after two simulation ticks.
    // The persistent scheduler state is read after every independent 60 Hz advance.
    let scheduled: i32 = 0;
    if (sample_simulation_ticks == 20) {
        scheduled = sample_schedule(0, 1);
    } else if (sample_simulation_ticks == 40) {
        scheduled = sample_schedule(-1, 0);
    } else if (sample_simulation_ticks == 60) {
        scheduled = sample_schedule(0, -1);
    }
    if (scheduled != 0) {
        return scheduled;
    }
    let advanced: i32 = realtime_advance();
    if (advanced != 0) {
        return advanced;
    }
    let read: i32 = realtime_read_control(0, sample_control_buttons, sample_control_x, sample_control_y);
    if (read != 0) {
        return read;
    }
    sample_player_x = sample_player_x + i32_to_f32(sample_control_x[0]) * 4.0;
    sample_player_y = sample_player_y + i32_to_f32(sample_control_y[0]) * 4.0;
    sample_simulation_ticks = sample_simulation_ticks + 1;
    sample_history.world_camera_history_advance(sample_player_x, sample_player_y);
    return 0;
}

function sample_cadence_probe(): i32 {
    if (sample_simulation_ticks != 60 || realtime_current_tick() != 60) {
        return 1;
    }
    if (sample_control_transitions != 3 || sample_sequence != 3) {
        return 2;
    }
    if (sample_player_x != 324.0 || sample_player_y != 400.0) {
        return 3;
    }
    return 0;
}

function sample_draw_world(alpha: f32): void {
    let presentation_x: f32 = sample_history.interpolated_x(alpha);
    let presentation_y: f32 = sample_history.interpolated_y(alpha);
    sample_camera.world_camera_follow(presentation_x, presentation_y);
    sample_tiles.world_camera_tile_range_calculate(sample_camera, SAMPLE_TILE_SIZE, 1);
    sample_camera.world_camera_clip_begin();
    let tile_y: i32 = sample_tiles.first_y;
    for (tile_y = sample_tiles.first_y; tile_y < sample_tiles.end_y; tile_y = tile_y + 1) {
        let tile_x: i32 = sample_tiles.first_x;
        for (tile_x = sample_tiles.first_x; tile_x < sample_tiles.end_x; tile_x = tile_x + 1) {
            let world_x: f32 = i32_to_f32(tile_x) * SAMPLE_TILE_SIZE;
            let world_y: f32 = i32_to_f32(tile_y) * SAMPLE_TILE_SIZE;
            let shade: f32 = 0.10;
            if ((tile_x + tile_y) % 2 == 0) {
                shade = 0.15;
            }
            fill_rect(
                sample_camera.world_to_view_x(world_x),
                sample_camera.world_to_view_y(world_y),
                SAMPLE_TILE_SIZE - 1.0,
                SAMPLE_TILE_SIZE - 1.0,
                shade,
                shade + 0.08,
                shade + 0.12,
                1.0
            );
        }
    }
    fill_rect(
        sample_camera.world_to_view_x(presentation_x) - 8.0,
        sample_camera.world_to_view_y(presentation_y) - 8.0,
        16.0,
        16.0,
        0.98,
        0.72,
        0.20,
        1.0
    );
    sample_camera.world_camera_clip_end();
}

function main(): i32 {
    init_window(640, 360, "Deterministic World Camera");
    return sample_reset();
}

function tick(): i32 {
    if (should_quit()) {
        realtime_stop();
        return 1;
    }
    return sample_simulation_step();
}

function render(): i32 {
    begin_frame();
    clear(0.02, 0.03, 0.06, 1.0);
    sample_draw_world(0.5);
    // Screen-anchored HUD: simulation progress, delivered controls, and bounds.
    fill_rect(0.0, 0.0, 640.0, 40.0, 0.03, 0.05, 0.10, 1.0);
    fill_rect(12.0, 11.0, i32_to_f32(sample_simulation_ticks % 120) * 3.0, 8.0, 0.20, 0.80, 0.95, 1.0);
    fill_rect(12.0, 24.0, i32_to_f32(sample_control_transitions) * 24.0, 6.0, 0.98, 0.52, 0.22, 1.0);
    end_frame();
    return 0;
}
