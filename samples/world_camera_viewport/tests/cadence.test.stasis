import "../src/main.stasis";

test `simulation advances sixty ticks without sixty control packets`(): bool {
    if (sample_reset() != 0) {
        return false;
    }
    let i: i32 = 0;
    for (i = 0; i < 60; i = i + 1) {
        if (sample_simulation_step() != 0) {
            return false;
        }
    }
    let passed: bool = sample_cadence_probe() == 0;
    realtime_stop();
    return passed;
}

test `supplied state produces deterministic camera presentation`(): bool {
    if (sample_reset() != 0) {
        return false;
    }
    let i: i32 = 0;
    for (i = 0; i < 24; i = i + 1) {
        if (sample_simulation_step() != 0) {
            return false;
        }
    }
    sample_camera.world_camera_follow(sample_history.interpolated_x(0.5), sample_history.interpolated_y(0.5));
    let first_x: f32 = sample_camera.origin_x;
    let first_y: f32 = sample_camera.origin_y;
    sample_camera.world_camera_follow(sample_history.interpolated_x(0.5), sample_history.interpolated_y(0.5));
    let passed: bool = first_x == sample_camera.origin_x && first_y == sample_camera.origin_y;
    realtime_stop();
    return passed;
}
