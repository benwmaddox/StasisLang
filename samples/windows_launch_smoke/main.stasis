@link("stasis_graphics");

extern function gfx_load_sprite(path: string, max_w: i32, max_h: i32): i32;
extern function load_font(path: string, size: i32): i32;

function @extern("stasis_jit_gfx_cache_text") gfx_cache_text(font: i32, text: string): i32;

global gfx_cmd_i32: i32[67888];
global gfx_cmd_f32: f32[146564];
global gfx_cmd_u8: u8[65536];
global host_req_flags: i32;
global host_req_window_w_px: i32;
global host_req_window_h_px: i32;
global host_req_seq: i32;
global host_i32: i32[768];
global png_sprite: i32;
global svg_sprite: i32;
global smoke_font: i32;
global cached_label: i32;
global ticks: i32;

function main(): i32 {
    host_req_flags = 1;
    host_req_window_w_px = 320;
    host_req_window_h_px = 180;
    host_req_seq += 1;

    png_sprite = gfx_load_sprite("assets/smoke.png", 64, 64);
    svg_sprite = gfx_load_sprite("assets/smoke.svg", 64, 64);
    smoke_font = load_font("/assets/smoke.ttf", 24);
    if (png_sprite == 0) {
        return 21;
    }
    if (svg_sprite == 0) {
        return 22;
    }
    if (smoke_font == 0) {
        return 23;
    }
    cached_label = gfx_cache_text(smoke_font, "WINDOWS LAUNCH OK");
    if (cached_label == 0) {
        return 24;
    }
    ticks = 0;
    return 0;
}

function tick(): i32 {
    ticks += 1;
    return 0;
}

function render(): i32 {
    gfx_cmd_i32[0] = 1196967473;
    gfx_cmd_i32[1] = 7;
    gfx_cmd_i32[2] = 3;
    gfx_cmd_i32[3] = 0;
    gfx_cmd_i32[4] = 2;
    gfx_cmd_i32[22] = 2;
    gfx_cmd_i32[29] = 1;
    gfx_cmd_i32[5] = 0;
    gfx_cmd_i32[6] = 0;
    gfx_cmd_i32[7] = 1;
    gfx_cmd_i32[8] = 0;
    gfx_cmd_i32[9] = 0;
    gfx_cmd_f32[0] = 0.04;
    gfx_cmd_f32[1] = 0.07;
    gfx_cmd_f32[2] = 0.12;
    gfx_cmd_f32[3] = 1.0;
    if (host_i32[545] != 0) {
        gfx_cmd_f32[0] = 0.80;
        gfx_cmd_f32[1] = 0.12;
        gfx_cmd_f32[2] = 0.08;
    }

    gfx_cmd_i32[32] = png_sprite;
    gfx_cmd_i32[33] = 0 - 1;
    gfx_cmd_i32[34] = 0;
    gfx_cmd_f32[80004] = 52.0;
    gfx_cmd_f32[80005] = 34.0;
    gfx_cmd_f32[80006] = 64.0;
    gfx_cmd_f32[80007] = 64.0;
    gfx_cmd_f32[80008] = 0.0;
    gfx_cmd_f32[80009] = 0.0;
    gfx_cmd_f32[80010] = 0.0;
    gfx_cmd_f32[80011] = 0.0;
    gfx_cmd_f32[80012] = 32.0;
    gfx_cmd_f32[80013] = 32.0;
    gfx_cmd_f32[80014] = 1.0;
    gfx_cmd_f32[80015] = 1.0;
    gfx_cmd_f32[80016] = 0.0;

    gfx_cmd_i32[35] = svg_sprite;
    gfx_cmd_i32[36] = 0 - 1;
    gfx_cmd_i32[37] = 0;
    gfx_cmd_f32[80017] = 204.0;
    gfx_cmd_f32[80018] = 34.0;
    gfx_cmd_f32[80019] = 64.0;
    gfx_cmd_f32[80020] = 64.0;
    gfx_cmd_f32[80021] = 0.0;
    gfx_cmd_f32[80022] = 0.0;
    gfx_cmd_f32[80023] = 0.0;
    gfx_cmd_f32[80024] = 0.0;
    gfx_cmd_f32[80025] = 32.0;
    gfx_cmd_f32[80026] = 32.0;
    gfx_cmd_f32[80027] = 1.0;
    gfx_cmd_f32[80028] = 1.0;
    gfx_cmd_f32[80029] = 0.0;

    gfx_cmd_i32[18464] = 0;
    gfx_cmd_i32[18465] = 2;
    gfx_cmd_i32[18466] = 0 - 1;
    gfx_cmd_i32[18467] = 0;
    gfx_cmd_i32[18468] = 0;
    gfx_cmd_i32[18469] = 0;
    gfx_cmd_i32[18470] = 0;
    gfx_cmd_i32[18471] = 0;
    gfx_cmd_i32[51232] = 32768;
    gfx_cmd_i32[51233] = 49152;

    gfx_cmd_i32[12320] = smoke_font;
    gfx_cmd_i32[12321] = 0 - cached_label;
    gfx_cmd_i32[12322] = 0;
    gfx_cmd_f32[133252] = 55.0;
    gfx_cmd_f32[133253] = 126.0;
    gfx_cmd_f32[133254] = 0.95;
    gfx_cmd_f32[133255] = 0.82;
    gfx_cmd_f32[133256] = 0.25;
    gfx_cmd_f32[133257] = 1.0;
    return 0;
}

function on_code_swap(): void {
    return;
}
