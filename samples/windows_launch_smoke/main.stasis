import ".stasis_cache/toolchain/src/stdlib/graphics.stasis";

global png_sprite: Sprite;
global svg_sprite: Sprite;
global smoke_label: TextRun;
global smoke_writer: SpriteRunWriter;
global ticks: i32;

function smoke_write_sprite(sprite: Sprite, x: f32, y: f32): bool {
    let width: f32 = i32_to_f32(sprite.width);
    let height: f32 = i32_to_f32(sprite.height);
    return smoke_writer.write(sprite.handle, -1, 0, x, y, width, height, 0.0, 0.0, 0.0, 0.0, width * 0.5, height * 0.5, 1.0, 1.0, 0.0);
}

function main(): i32 {
    if (!init_window(320, 180, "Stasis Windows launch smoke")) {
        return 20;
    }
    if (!png_sprite.load_sprite_from("assets/smoke.png", 64, 64)) {
        return 21;
    }
    if (!svg_sprite.load_sprite_from("assets/smoke.svg", 64, 64)) {
        return 22;
    }
    let font: i32 = load_font("/assets/smoke.ttf", 24);
    if (font == 0) {
        return 23;
    }
    if (!smoke_label.load_text_from(font, "WINDOWS LAUNCH OK")) {
        return 24;
    }
    ticks = 0;
    return 0;
}

function tick(): i32 {
    ticks += 1;
    return 0;
}

function render(): i32 {
    begin_frame();
    if (input_pointer_count() > 0) {
        clear(0.80, 0.12, 0.08, 1.0);
    } else {
        clear(0.04, 0.07, 0.12, 1.0);
    }
    if (smoke_writer.reserve(2, -1, 0, 0, 0, 0, 0)) {
        let written: i32 = 0;
        if (smoke_write_sprite(png_sprite, 52.0, 34.0)) {
            written += 1;
        }
        if (smoke_write_sprite(svg_sprite, 204.0, 34.0)) {
            written += 1;
        }
        if (written == 2) {
            smoke_writer.finalize(2);
        } else {
            smoke_writer.cancel();
        }
    }
    smoke_label.draw(55.0, 126.0, 0.95, 0.82, 0.25, 1.0);
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
