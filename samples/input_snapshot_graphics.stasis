import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/gfx_cmd.stasis";
import "../src/host_frame.stasis";
import "../src/host_input_snapshot.stasis";

// Input snapshot graphics sample:
// - Host writes the input snapshot into HostFrame once per tick.
// - Guest reads HostFrame into a deterministic InputSnapshot.
// - Tick logic updates state from that snapshot.
// - Guest emits render commands; host presents after tick.

const KEY_SPACE: i32 = 44; // SDL scancode Space

struct SampleState {
    tap_count: i32;
    last_tap_x: i32;
    last_tap_y: i32;
    ticks: i32;
}

global state: SampleState;

function draw_cross(x: f32, y: f32, r: f32, g: f32, b: f32): void {
    let half: f32 = 6.0;
    gfx_cmd_line(x - half, y, x + half, y, r, g, b, 1.0);
    gfx_cmd_line(x, y - half, x, y + half, r, g, b, 1.0);
}

function draw_viewport_outline(): void {
    let vx: f32 = host_viewport_x_px_f32();
    let vy: f32 = host_viewport_y_px_f32();
    let vw: f32 = host_viewport_w_px_f32();
    let vh: f32 = host_viewport_h_px_f32();

    let x0: f32 = vx;
    let y0: f32 = vy;
    let x1: f32 = vx + vw;
    let y1: f32 = vy + vh;

    gfx_cmd_line(x0, y0, x1, y0, 0.25, 0.25, 0.25, 1.0);
    gfx_cmd_line(x1, y0, x1, y1, 0.25, 0.25, 0.25, 1.0);
    gfx_cmd_line(x1, y1, x0, y1, 0.25, 0.25, 0.25, 1.0);
    gfx_cmd_line(x0, y1, x0, y0, 0.25, 0.25, 0.25, 1.0);
}

function tick(): i32 {
    // Tick logic: count taps and track last tap position.
    if (input.key_went_down[KEY_SPACE]) {
        state.tap_count = 0;
    }
    let i: i32 = 0;
    for (i = 0; i < input.pointer_count; i = i + 1) {
        if (input.pointer_went_down[i]) {
            state.tap_count = state.tap_count + 1;
            state.last_tap_x = input.pointer_x_px[i];
            state.last_tap_y = input.pointer_y_px[i];
        }
    }
    state.ticks = state.ticks + 1;

    gfx_cmd_begin();
    gfx_cmd_clear(0.02, 0.02, 0.03, 1.0);

    draw_viewport_outline();

    let count: i32 = input.pointer_count;
    for (i = 0; i < count; i = i + 1) {
        let x: f32 = i32_to_f32(input.pointer_x_px[i]);
        let y: f32 = i32_to_f32(input.pointer_y_px[i]);

        let is_down: bool = input.pointer_is_down[i];
        let went_down: bool = input.pointer_went_down[i];
        let went_up: bool = input.pointer_went_up[i];

        let r: f32 = 0.2;
        let g: f32 = 0.8;
        let b: f32 = 1.0;

        if (is_down) {
            r = 1.0;
            g = 0.9;
            b = 0.2;
        }
        if (went_down) {
            r = 0.2;
            g = 1.0;
            b = 0.2;
        }
        if (went_up) {
            r = 1.0;
            g = 0.2;
            b = 0.2;
        }

        draw_cross(x, y, r, g, b);
    }

    // Highlight last tap.
    if (state.tap_count > 0) {
        draw_cross(i32_to_f32(state.last_tap_x), i32_to_f32(state.last_tap_y), 1.0, 0.2, 0.8);
    }

    gfx_cmd_mark_present();
    return 0;
}

function main(): i32 {
    let ok: bool = init_window(800, 600, "Stasis Input Snapshot");
    if (!ok) {
        return 1;
    }

    return 0;
}
