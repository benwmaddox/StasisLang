import "../../src/stdlib/graphics.stasis";

global visual_sprite: Sprite;
global visual_font: i32;
global visual_text: TextRun;

function main(): i32 {
    init_window(360, 240, "Typed Drawable Visual");
    if (!visual_sprite.load_sprite_from("../render_parity/assets/opaque.svg", 160, 96)) { return 1; }
    visual_font = load_font("../render_parity/assets/parity.ttf", 28);
    if (visual_font <= 0) { return 2; }
    if (!visual_text.load_text_from(visual_font, "TYPED DRAW")) { return 3; }
    if (visual_sprite.width != 160 || visual_sprite.height != 96) { return 4; }
    if (visual_text.width <= 0.0 || visual_text.height <= 0.0) { return 5; }
    return 0;
}

function tick(): i32 { return 0; }

function render(): i32 {
    begin_frame();
    clear(0.04, 0.06, 0.10, 1.0);
    visual_sprite.draw(100.0, 50.0, 255, 0);
    visual_text.draw(103.0, 168.0, 1.0, 0.85, 0.25, 1.0);
    end_frame();
    return 0;
}

function on_code_swap(): void { return; }
