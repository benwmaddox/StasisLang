import "../../src/stdlib/graphics.stasis";

global visual_sprite: i32;
global visual_font: i32;
global visual_text: i32;

function main(): i32 {
    init_window(360, 240, "Raw Drawable Visual");
    visual_sprite = gfx_load_sprite("../render_parity/assets/opaque.svg", 160, 96);
    visual_font = load_font("../render_parity/assets/parity.ttf", 28);
    visual_text = gfx_cache_text(visual_font, "TYPED DRAW");
    if (visual_sprite <= 0 || visual_font <= 0 || visual_text <= 0) { return 1; }
    return 0;
}

function tick(): i32 { return 0; }

function render(): i32 {
    begin_frame();
    clear(0.04, 0.06, 0.10, 1.0);
    gfx_draw_sprite(visual_sprite, 100.0, 50.0, 160.0, 96.0, 0, 255);
    draw_text_cached(visual_font, visual_text, 103.0, 168.0, 1.0, 0.85, 0.25, 1.0);
    end_frame();
    return 0;
}

function on_code_swap(): void { return; }
