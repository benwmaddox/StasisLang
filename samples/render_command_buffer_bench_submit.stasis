import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/gfx_cmd.stasis";

// Render submission microbench:
// - Per-call: many draw_line() calls from Stasis (many host boundary calls).
// - Batched: one draw_lines_f32() call that loops in the runtime.
// - Submit: one gfx_cmd_submit_no_present() call (command buffer) that loops in the runtime.
//
// Notes:
// - This times submission only (no end_frame()), so it isolates host boundary overhead.
// - The command-buffer path uses `gfx_cmd_submit_no_present()` so it also excludes present.

const LINE_COUNT: i32 = 10000;
const LINE_STRIDE: i32 = 8;
const LINE_DATA_LEN: i32 = 80000; // LINE_COUNT * LINE_STRIDE

const WARMUP_ITERS: i32 = 20;
const BENCH_ITERS: i32 = 500;

struct BenchState {
    lines: f32[80000];
}

global state: BenchState;

function fill_lines(): void {
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE;
        let x1_i: i32 = i % 640;
        let y1_i: i32 = i % 360;
        let x2_i: i32 = (i + 13) % 640;
        let y2_i: i32 = (i + 29) % 360;
        state.lines[base + 0] = i32_to_f32(x1_i); // x1
        state.lines[base + 1] = i32_to_f32(y1_i); // y1
        state.lines[base + 2] = i32_to_f32(x2_i); // x2
        state.lines[base + 3] = i32_to_f32(y2_i); // y2
        state.lines[base + 4] = 0.05; // r
        state.lines[base + 5] = 0.85; // g
        state.lines[base + 6] = 0.78; // b
        state.lines[base + 7] = 1.0;  // a
    }
}

function submit_lines_per_call(): void {
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE;
        draw_line(
            state.lines[base + 0],
            state.lines[base + 1],
            state.lines[base + 2],
            state.lines[base + 3],
            state.lines[base + 4],
            state.lines[base + 5],
            state.lines[base + 6],
            state.lines[base + 7]
        );
    }
}

function submit_lines_batched(): void {
    draw_lines_f32(state.lines, LINE_COUNT);
}

function submit_lines_cmd(): void {
    gfx_cmd_begin();
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE;
        gfx_cmd_line(
            state.lines[base + 0],
            state.lines[base + 1],
            state.lines[base + 2],
            state.lines[base + 3],
            state.lines[base + 4],
            state.lines[base + 5],
            state.lines[base + 6],
            state.lines[base + 7]
        );
    }
    gfx_cmd_submit_no_present();
}

function build_lines_cmd_once(): void {
    gfx_cmd_begin();
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * LINE_STRIDE;
        gfx_cmd_line(
            state.lines[base + 0],
            state.lines[base + 1],
            state.lines[base + 2],
            state.lines[base + 3],
            state.lines[base + 4],
            state.lines[base + 5],
            state.lines[base + 6],
            state.lines[base + 7]
        );
    }
}

function bench_per_call(iterations: i32): i32 {
    let it: i32 = 0;
    let start_ms: i32 = get_time_ms();
    for (it = 0; it < iterations; it = it + 1) {
        begin_frame();
        submit_lines_per_call();
    }
    return get_time_ms() - start_ms;
}

function bench_batched(iterations: i32): i32 {
    let it: i32 = 0;
    let start_ms: i32 = get_time_ms();
    for (it = 0; it < iterations; it = it + 1) {
        begin_frame();
        submit_lines_batched();
    }
    return get_time_ms() - start_ms;
}

function bench_submit(iterations: i32): i32 {
    let it: i32 = 0;
    let start_ms: i32 = get_time_ms();
    for (it = 0; it < iterations; it = it + 1) {
        submit_lines_cmd();
    }
    return get_time_ms() - start_ms;
}

function bench_submit_prebuilt(iterations: i32): i32 {
    let it: i32 = 0;
    let start_ms: i32 = get_time_ms();
    for (it = 0; it < iterations; it = it + 1) {
        gfx_cmd_submit_no_present();
    }
    return get_time_ms() - start_ms;
}

function print_header(): void {
    print_string("render_command_buffer_bench_submit\n");
    print_string("lines=");
    print_int(LINE_COUNT);
    print_string(" iterations=");
    print_int(BENCH_ITERS);
    print_string(" warmup=");
    print_int(WARMUP_ITERS);
    print_char(10);
}

function main(): i32 {
    let init_ok: bool = init_window(64, 64, "render_command_buffer_bench_submit");
    if (!init_ok) {
        print_string("init_window failed\n");
        return 1;
    }

    fill_lines();
    print_header();

    // Correctness: hash the draw-call stream for one iteration of each path.
    gfx_debug_enable_hash(1);

    begin_frame();
    submit_lines_per_call();
    let hash_per: i32 = gfx_debug_get_frame_hash();

    begin_frame();
    submit_lines_batched();
    let hash_batch: i32 = gfx_debug_get_frame_hash();

    submit_lines_cmd();
    let hash_submit: i32 = gfx_debug_get_frame_hash();

    gfx_debug_enable_hash(0);

    print_string("hash per_call=");
    print_int(hash_per);
    print_string(" batched=");
    print_int(hash_batch);
    print_string(" submit=");
    print_int(hash_submit);
    print_char(10);

    if (!(hash_per == hash_batch)) {
        print_string("ERROR: hash mismatch per_call vs batched\n");
        return 2;
    }
    if (!(hash_per == hash_submit)) {
        print_string("ERROR: hash mismatch per_call vs submit\n");
        return 3;
    }

    // Warmup to reduce first-run noise.
    bench_per_call(WARMUP_ITERS);
    bench_batched(WARMUP_ITERS);
    bench_submit(WARMUP_ITERS);
    build_lines_cmd_once();
    bench_submit_prebuilt(WARMUP_ITERS);

    let per_ms: i32 = bench_per_call(BENCH_ITERS);
    let batched_ms: i32 = bench_batched(BENCH_ITERS);
    let submit_build_ms: i32 = bench_submit(BENCH_ITERS);
    build_lines_cmd_once();
    let submit_prebuilt_ms: i32 = bench_submit_prebuilt(BENCH_ITERS);

    print_string("per_call_ms=");
    print_int(per_ms);
    print_string(" batched_ms=");
    print_int(batched_ms);
    print_string(" submit_build_ms=");
    print_int(submit_build_ms);
    print_string(" submit_prebuilt_ms=");
    print_int(submit_prebuilt_ms);
    print_char(10);

    return 0;
}
