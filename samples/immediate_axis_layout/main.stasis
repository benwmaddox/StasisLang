import "../../src/stdlib/graphics.stasis";
import "layout.stasis";

struct MenuState {
    font: i32;
    title: TextRun;
    title_width: f32;
    play: TextRun;
    play_width: f32;
    button: Sprite;
    play_clicked: bool;
}

global state: MenuState;

function main(): i32 {
    init_window(360, 720, "Immediate Axis Layout");
    state.font = load_font("../render_parity/assets/parity.ttf", 24);
    state.title.load_text_from(state.font, "STASIS MENU");
    state.title_width = state.title.width;
    state.play.load_text_from(state.font, "PLAY");
    state.play_width = state.play.width;
    state.button.load_sprite_from("../render_parity/assets/opaque.svg", 180, 56);
    state.play_clicked = false;
    if (state.font == 0 || state.title.handle == 0 || state.play.handle == 0 || state.button.handle == 0) {
        return 1;
    }
    return 0;
}

function update_menu_layout(): void {
    menu_layout(
        gfx_safe_viewport_x(),
        gfx_safe_viewport_y(),
        gfx_safe_viewport_width(),
        gfx_safe_viewport_height(),
        state.title_width,
        state.play_width
    );
}

function tick(): i32 {
    update_menu_layout();
    state.play_clicked = false;
    let pointer_count: i32 = input_pointer_count();
    let i: i32 = 0;
    for (i = 0; i < pointer_count; i = i + 1) {
        if (input_pointer_went_up(i)) {
            if (menu_button_contains(
                input_pointer_x_logical(i),
                input_pointer_y_logical(i)
            )) {
                state.play_clicked = true;
            }
        }
    }
    return 0;
}

function render(): i32 {
    begin_frame();
    clear(0.04, 0.06, 0.10, 1.0);
    update_menu_layout();
    state.title.draw(
        menu_title_x, menu_title_y,
        1.0, 0.9, 0.7, 1.0
    );
    state.button.draw(menu_button_x, menu_button_y, 255, 0);
    state.play.draw(
        menu_label_x, menu_label_y,
        1.0, 1.0, 1.0, 1.0
    );
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
