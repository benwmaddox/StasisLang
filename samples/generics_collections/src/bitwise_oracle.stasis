global bitwise_oracle_bump_count: i32;

function bitwise_check_i32(left: i32, right: i32): bool {
    return(left & right) == 16 &&(left ^ right) == -145 &&(left | right) == -129 &&(~left) == 172;
}

function bitwise_check_u8(left: u8, right: u8): bool {
    return(left & right) == 36 &&(left ^ right) == 153 &&(left | right) == 189 &&(~left) == 90 &&((~left) >> 4) == 5;
}

function bitwise_check_u16(left: u16, right: u16): bool {
    return(left & right) == 1360 &&(left ^ right) == 43690 &&(left | right) == 45050 &&(~left) == 23205 &&((~left) >> 4) == 1450;
}

function bitwise_check_u32(left: u32, right: u32): bool {
    return(left & right) == 89130320 &&(left ^ right) == 2863311530 &&(left | right) == 2952441850 &&(~left) == 1520786085;
}

function bitwise_check_i32_shift(value: i32, one: i32, count: i32, expected_left: i32, expected_right: i32): bool {
    return(one << count) == expected_left &&(value >> count) == expected_right;
}

function bitwise_check_u8_shift(value: u8, one: u8, count: i32, expected_left: u8, expected_right: u8): bool {
    return(one << count) == expected_left &&(value >> count) == expected_right &&((value << 1) >> 1) == 0;
}

function bitwise_check_u8_u32_shift(value: u8, one: u8, count: u32, expected_left: u8, expected_right: u8): bool {
    return(one << count) == expected_left &&(value >> count) == expected_right;
}

function bitwise_check_u16_shift(value: u16, one: u16, count: i32, expected_left: u16, expected_right: u16): bool {
    return(one << count) == expected_left &&(value >> count) == expected_right &&((value << 1) >> 1) == 0;
}

function bitwise_check_u32_shift(value: u32, one: u32, count: i32, expected_left: u32, expected_right: u32): bool {
    return(one << count) == expected_left &&(value >> count) == expected_right;
}

function bitwise_check_u8_u16_count(one: u8, count: u16, expected: u8): bool {
    return(one << count) == expected;
}

function bitwise_check_u8_literal(left: u8): bool {
    return(left | 3) == 167 &&(3 | left) == 167;
}

function bitwise_check_literal_contexts(): bool {
    let shifted: u8 = 1 << 8;
    let complemented: u8 = ~0;
    let combined: u8 = 1 | 2;
    let chained: u8 = 1 | 2 | 4;
    let nested_shift: u8 =(1 | 2) << 8;
    let nested_complement: u8 = ~(1 | 2);
    let signed: i32 = -1 | 1;
    let signed_minimum: i32 = -2147483648 | 0;
    return shifted == 1 && complemented == 255 && combined == 3 && chained == 7 && nested_shift == 3 && nested_complement == 252 && signed == -1 && signed_minimum == 0 - 2147483647 - 1;
}

function bitwise_check_flags(flags: u8, mask: u8, expected: u8): bool {
    return(flags & mask) == expected;
}

function bitwise_check_bitwise_precedence(first: i32, second: i32, third: i32, fourth: i32, expected: i32): bool {
    return(first | second ^ third & fourth) == expected;
}

function bitwise_check_add_shift_precedence(left: i32, right: i32, count: i32, expected: i32): bool {
    return(left + right << count) == expected;
}

function bitwise_check_shift_add_precedence(value: i32, first_count: i32, second_count: i32, expected: i32): bool {
    return(value >> first_count + second_count) == expected;
}

function bitwise_mask_u8(value: u8, mask: u8): u8 {
    return value & mask;
}

function bitwise_expect_u8(value: u8, expected: u8): bool {
    return value == expected;
}

function bitwise_check_nested_call(left: u8, right: u8): bool {
    return bitwise_expect_u8(bitwise_mask_u8(left, right), 36);
}

function bitwise_oracle_bump(): bool {
    bitwise_oracle_bump_count = bitwise_oracle_bump_count + 1;
    return true;
}

function bitwise_check_short_circuit(and_left: bool, or_left: bool): bool {
    bitwise_oracle_bump_count = 0;
    if (and_left && bitwise_oracle_bump()) {
        return false;
    }
    if (or_left || bitwise_oracle_bump()) {
    }
    return bitwise_oracle_bump_count == 0;
}

function bitwise_operator_oracle(): i32 {
    if (!bitwise_check_i32(-173, 60)) {
        return 1;
    }
    if (!bitwise_check_u8(165, 60)) {
        return 2;
    }
    if (!bitwise_check_u16(42330, 4080)) {
        return 3;
    }
    if (!bitwise_check_u32(2774181210, 267390960)) {
        return 4;
    }
    if (!bitwise_check_i32_shift(-8, 1, -1, 0 - 2147483647 - 1, -1)) {
        return 5;
    }
    if (!bitwise_check_i32_shift(-8, 1, 31, 0 - 2147483647 - 1, -1)) {
        return 6;
    }
    if (!bitwise_check_i32_shift(-8, 1, 32, 1, -8)) {
        return 7;
    }
    if (!bitwise_check_i32_shift(-8, 1, 33, 2, -4)) {
        return 8;
    }
    if (!bitwise_check_u8_shift(128, 1, -1, 128, 1)) {
        return 9;
    }
    if (!bitwise_check_u8_shift(128, 1, 7, 128, 1)) {
        return 10;
    }
    if (!bitwise_check_u8_shift(128, 1, 8, 1, 128)) {
        return 11;
    }
    if (!bitwise_check_u8_shift(128, 1, 9, 2, 64)) {
        return 12;
    }
    if (!bitwise_check_u16_shift(32768, 1, -1, 32768, 1)) {
        return 13;
    }
    if (!bitwise_check_u16_shift(32768, 1, 15, 32768, 1)) {
        return 14;
    }
    if (!bitwise_check_u16_shift(32768, 1, 16, 1, 32768)) {
        return 15;
    }
    if (!bitwise_check_u16_shift(32768, 1, 17, 2, 16384)) {
        return 16;
    }
    if (!bitwise_check_u32_shift(2147483648, 1, -1, 2147483648, 1)) {
        return 17;
    }
    if (!bitwise_check_u32_shift(2147483648, 1, 31, 2147483648, 1)) {
        return 18;
    }
    if (!bitwise_check_u32_shift(2147483648, 1, 32, 1, 2147483648)) {
        return 19;
    }
    if (!bitwise_check_u32_shift(2147483648, 1, 33, 2, 1073741824)) {
        return 20;
    }
    if (!bitwise_check_u8_u16_count(1, 8, 1)) {
        return 21;
    }
    if (!bitwise_check_u8_literal(165)) {
        return 22;
    }
    if (!bitwise_check_nested_call(165, 60)) {
        return 23;
    }
    if (!bitwise_check_short_circuit(false, true)) {
        return 24;
    }
    if (!bitwise_check_bitwise_precedence(1, 2, 3, 4, 3)) {
        return 25;
    }
    if (!bitwise_check_add_shift_precedence(1, 2, 1, 6)) {
        return 26;
    }
    if (!bitwise_check_shift_add_precedence(8, 1, 1, 2)) {
        return 27;
    }
    if (!bitwise_check_flags(165, 15, 5)) {
        return 28;
    }
    if (!bitwise_check_u8_u32_shift(128, 1, 4294967295, 128, 1)) {
        return 29;
    }
    if (!bitwise_check_u8_u32_shift(128, 1, 8, 1, 128)) {
        return 30;
    }
    if (!bitwise_check_u8_u32_shift(128, 1, 9, 2, 64)) {
        return 31;
    }
    if (!bitwise_check_literal_contexts()) {
        return 32;
    }
    if (!bitwise_check_i32_shift(-8, 1, 0, 1, -8)) {
        return 33;
    }
    if (!bitwise_check_u8_shift(128, 1, 0, 1, 128)) {
        return 34;
    }
    if (!bitwise_check_u8_u32_shift(128, 1, 0, 1, 128)) {
        return 35;
    }
    if (!bitwise_check_u16_shift(32768, 1, 0, 1, 32768)) {
        return 36;
    }
    if (!bitwise_check_u32_shift(2147483648, 1, 0, 1, 2147483648)) {
        return 37;
    }
    return 0;
}
