function math_oracle_one_e300(): f64 {
    let large: f64 = 1.0;
    let index: i32 = 0;
    for (index = 0; index < 300; index = index + 1) {
        large = large * 10.0;
    }
    return large;
}

function math_oracle_text_equals(actual: ascii[], expected: ascii[], expected_length: i32): bool {
    if (length(actual) != expected_length || actual[expected_length] != 0) {
        return false;
    }
    let index: i32 = 0;
    for (index = 0; index < expected_length; index = index + 1) {
        if (actual[index] != expected[index]) {
            return false;
        }
    }
    return true;
}

function math_oracle_text_magnitudes(): bool {
    let tiny: f64 = 1.0;
    let large: f64 = 1.0;
    let carry: f64 = 9.999;
    let index: i32 = 0;
    for (index = 0; index < 300; index = index + 1) {
        tiny = tiny / 10.0;
        large = large * 10.0;
        carry = carry * 10.0;
    }
    if (
        ascii_from_f64_short(math_oracle_text_buffer, tiny, 2) != 9
        || !math_oracle_text_equals(math_oracle_text_buffer, "1.00e-300", 9)
        || ascii_from_f64_short(math_oracle_text_buffer, large, 2) != 8
        || !math_oracle_text_equals(math_oracle_text_buffer, "1.00e300", 8)
        || ascii_from_f64_short(math_oracle_text_buffer, carry, 2) != 8
        || !math_oracle_text_equals(math_oracle_text_buffer, "1.00e301", 8)
    ) {
        return false;
    }
    return true;
}

function math_oracle_text_capacity(): bool {
    let large: f64 = math_oracle_one_e300();
    if (
        ascii_from_f64_short(math_oracle_text_exact, large, 2) != 8
        || !math_oracle_text_equals(math_oracle_text_exact, "1.00e300", 8)
        || math_oracle_text_exact[8] != 0
    ) {
        return false;
    }
    ascii_copy(math_oracle_text_short, "keep");
    math_oracle_text_short[7] = 83;
    if (
        ascii_from_f64_short(math_oracle_text_short, large, 2) != -1
        || length(math_oracle_text_short) != 4
        || !math_oracle_text_equals(math_oracle_text_short, "keep", 4)
        || math_oracle_text_short[7] != 83
    ) {
        return false;
    }
    return true;
}

function math_oracle_text_specials(): bool {
    let infinity: f64 = 1.0 / 0.0;
    let nan: f64 = 0.0 / 0.0;
    let negative_zero: f64 = 0.0 /(0.0 - 1.0);
    if (
        ascii_from_f64_short(math_oracle_text_buffer, infinity, 2) != 3
        || !math_oracle_text_equals(math_oracle_text_buffer, "inf", 3)
        || ascii_from_f64_short(math_oracle_text_buffer, 0.0 - infinity, 2) != 4
        || !math_oracle_text_equals(math_oracle_text_buffer, "-inf", 4)
        || ascii_from_f64_short(math_oracle_text_buffer, nan, 2) != 3
        || !math_oracle_text_equals(math_oracle_text_buffer, "nan", 3)
        || ascii_from_f64_short(math_oracle_text_buffer, negative_zero, 2) != 4
        || !math_oracle_text_equals(math_oracle_text_buffer, "0.00", 4)
    ) {
        return false;
    }
    return true;
}

function math_oracle_text_append(): bool {
    let large: f64 = math_oracle_one_e300();
    ascii_copy(math_oracle_text_buffer, "v=");
    return ascii_append_f64_short(math_oracle_text_buffer, large, 2) == 10 && math_oracle_text_equals(math_oracle_text_buffer, "v=1.00e300", 10);
}

function math_oracle_extended_text(): bool {
    return math_oracle_text_magnitudes() && math_oracle_text_capacity() && math_oracle_text_specials() && math_oracle_text_append();
}

function math_oracle_hash_raw_bits(): i32 {
    let digest: i32 = -2128831035;
    let index: i32 = 0;
    for (index = 0; index < 13; index = index + 1) {
        digest =(digest ^ math_oracle_raw_bits[index]) * 16777619;
    }
    return digest;
}

function math_oracle_run(): bool {
    let negative_zero: f32 = 0.0 / -1.0;
    math_oracle_sqrt_two = math_sqrt(2.0);
    math_oracle_sqrt_tiny = math_sqrt(0.000000000000000000000000000001);
    math_oracle_sqrt_large = math_sqrt(1000000000000000000000000000000.0);
    math_oracle_atan2_three_four = math_atan2_degrees(3.0, 4.0);
    math_oracle_atan2_negative_two_three = math_atan2_degrees(-2.0, 3.0);
    math_oracle_acos_negative_half = math_acos_degrees(-0.5);
    math_oracle_acos_near_one = math_acos_degrees(0.999999);

    if (
        !math_oracle_relative_near(math_oracle_sqrt_two, 1.41421356237, 0.000001)
        || !math_oracle_relative_near(math_oracle_sqrt_tiny, 0.000000000000001, 0.000001)
        || !math_oracle_relative_near(math_oracle_sqrt_large, 1000000000000000.0, 0.000001)
        || !math_oracle_near(math_oracle_atan2_three_four, 36.86989765, 0.01)
        || !math_oracle_near(math_oracle_atan2_negative_two_three, -33.6900675, 0.01)
        || !math_oracle_near(math_oracle_acos_negative_half, 120.0, 0.01)
        || !math_oracle_near(math_oracle_acos_near_one, 0.0810285, 0.01)
        || math_sqrt(-1.0) != 0.0
        || math_sqrt(0.0) != 0.0
        || math_atan2_degrees(0.0, 0.0) != 0.0
        || math_acos_degrees(-2.0) != 180.0
        || math_acos_degrees(2.0) != 0.0
        || math_abs((-2147483647 - 1)) != 2147483647
        || f32_to_bits(negative_zero) !=(-2147483647 - 1)
        || f32_to_bits(math_sqrt(negative_zero)) != 0
        || f32_to_bits(math_abs(negative_zero)) != 0
        || f32_to_bits(math_atan2_degrees(negative_zero, 1.0)) != 0
        || math_atan2_degrees(negative_zero, -1.0) != 180.0
    ) {
        return false;
    }

    if (!math_oracle_extended_f32() || !math_oracle_extended_f64() || !math_oracle_extended_text()) {
        return false;
    }

    math_oracle_raw_bits[0] = f32_to_bits(math_oracle_sqrt_two);
    math_oracle_raw_bits[1] = f32_to_bits(math_oracle_sqrt_tiny);
    math_oracle_raw_bits[2] = f32_to_bits(math_oracle_sqrt_large);
    math_oracle_raw_bits[3] = f32_to_bits(math_oracle_atan2_three_four);
    math_oracle_raw_bits[4] = f32_to_bits(math_oracle_atan2_negative_two_three);
    math_oracle_raw_bits[5] = f32_to_bits(math_oracle_acos_negative_half);
    math_oracle_raw_bits[6] = f32_to_bits(math_oracle_acos_near_one);
    math_oracle_raw_bits[7] = f32_to_bits(math_abs(-3.25));
    math_oracle_raw_bits[8] = f32_to_bits(negative_zero);
    math_oracle_raw_bits[9] = f32_to_bits(math_sqrt(negative_zero));
    math_oracle_raw_bits[10] = f32_to_bits(math_abs(negative_zero));
    math_oracle_raw_bits[11] = f32_to_bits(math_atan2_degrees(negative_zero, 1.0));
    math_oracle_raw_bits[12] = f32_to_bits(math_atan2_degrees(negative_zero, -1.0));
    math_oracle_raw_digest_value = math_oracle_hash_raw_bits();
    return math_oracle_raw_digest_value == -1430176193;
}

function main(): i32 {
    if (!math_oracle_run()) {
        return 21;
    }
    buffer_clear(integer_buffer);
    buffer_clear(wide_buffer);
    buffer_clear(float_buffer);
    buffer_clear(nested_buffer.inner);
    window_clear(sample_window);
    ring_clear(ring);
    entity_pool_clear(entity_pool);
    reset_live_edit_state();
    courier_rig.clear();
    boss_rig.clear();

    if (buffer_capacity(integer_buffer) != 4 || buffer_capacity(float_buffer) != 3) {
        return 1;
    }
    if (
        !buffer_append(integer_buffer, 10)
        || !buffer_append(integer_buffer, 20)
        || !buffer_append(integer_buffer, 30)
        || !buffer_append(integer_buffer, 40)
        || buffer_append(integer_buffer, 50)
    ) {
        return 2;
    }
    if (integer_buffer_sum(integer_buffer) != 100 || integer_buffer.count != 4 || buffer_at(integer_buffer, 2) != 30) {
        return 3;
    }
    buffer_clear(integer_buffer);
    if (integer_buffer.count != 0 || !buffer_append(integer_buffer, 7) || buffer_capacity(wide_buffer) != 8 || !buffer_append(wide_buffer, 70)) {
        return 4;
    }
    if (first_value(integer_buffer.values) != 7 || first_value(wide_buffer.values) != 70) {
        return 5;
    }

    if (
        !buffer_append(float_buffer, 0.5)
        || !buffer_append(float_buffer, 1.5)
        || !buffer_append(float_buffer, 4.0)
        || buffer_append(float_buffer, 8.0)
    ) {
        return 6;
    }
    if (!near(buffer_at(float_buffer, 1), 1.5)) {
        return 7;
    }

    if (
        nested_capacity(nested_buffer) != 2
        || !buffer_append(nested_buffer.inner, 3)
        || !buffer_append(nested_buffer.inner, 4)
        || integer_buffer_sum(nested_buffer.inner) != 7
    ) {
        return 8;
    }

    if (
        !window_push(sample_window, 1.0)
        || !window_push(sample_window, 2.0)
        || !window_push(sample_window, 4.0)
        || window_push(sample_window, 5.0)
        || !near(window_mean(sample_window), 2.3333333)
    ) {
        return 9;
    }

    if (
        !ring_push(ring, 1)
        || !ring_push(ring, 2)
        || !ring_push(ring, 3)
        || ring_push(ring, 4)
        || ring.count != 3
        || ring_peek(ring) != 1
    ) {
        return 10;
    }
    if (
        !ring_drop(ring)
        || !ring_push(ring, 4)
        || ring_peek(ring) != 2
        || !ring_drop(ring)
        || !ring_drop(ring)
        || !ring_drop(ring)
        || ring_drop(ring)
        || ring.count != 0
    ) {
        return 11;
    }
    if (!ring_push(ring, 5) || ring_peek(ring) != 5) {
        return 12;
    }

    if (
        entity_pool_spawn(entity_pool, 100, 1.0, 2.0) != 0
        || entity_pool_spawn(entity_pool, 200, 3.0, 4.0) != 1
        || entity_pool_spawn(entity_pool, 300, 5.0, 6.0) != -1
    ) {
        return 13;
    }
    if (
        entity_pool_id(entity_pool, 0) != 100
        || first_entity_id(entity_pool.entities) != 100
        || !entity_pool_release_last(entity_pool)
        || entity_pool_spawn(entity_pool, 300, 5.0, 6.0) != 1
        || entity_pool_id(entity_pool, 1) != 300
    ) {
        return 14;
    }

    if (
        apply_offset(negative_three, 10) != 7
        || apply_mode(mode_zero, 5) != 5
        || apply_mode(mode_one, 5) != 10
        || apply_mode(mode_two, 5) != 7
    ) {
        return 15;
    }

    if (
        courier_rig.add_bone(-1, 10.0, 0.0, 0.0) != 0
        || courier_rig.add_bone(0, 5.0, 0.0, 45.0) != 1
        || !courier_rig.solve(2.0, 3.0, 90.0)
    ) {
        return 16;
    }
    if (!near(courier_rig.world_x(1), 2.0) || !near(courier_rig.world_y(1), 18.0) || !near(courier_rig.world_angle(1), 135.0)) {
        return 17;
    }
    if (boss_rig.add_bone(-1, 25.0, 0.0, 0.0) != 0 || !boss_rig.solve(0.0, 0.0, 0.0) || !near(boss_rig.world_x(0), 25.0)) {
        return 18;
    }

    if (live_edit_tick() != 8 || live_edit_tick() != 9) {
        return 19;
    }
    if (bitwise_operator_oracle() != 0) {
        return 20;
    }
    web_bounds_probe_index = 0;
    generics_collections_digest_value = generics_collections_state_digest();
    return 0;
}
