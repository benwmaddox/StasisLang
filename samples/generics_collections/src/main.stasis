function near(actual: f32, expected: f32): bool {
    let difference: f32 = actual - expected;
    return difference > -0.001 && difference < 0.001;
}

function tick(): i32 {
    let probed_id: i32 = entity_pool.entities[web_bounds_probe_index].id;
    return probed_id - probed_id;
}

function render(): i32 {
    clear(0.04, 0.08, 0.16, 1.0);
    if (generics_collections_digest_value == 507 && math_oracle_raw_digest_value == -1430176193) {
        fill_rect(48.0, 48.0, 160.0, 96.0, 0.16, 0.72, 0.52, 1.0);
    } else {
        fill_rect(48.0, 48.0, 160.0, 96.0, 0.85, 0.08, 0.08, 1.0);
    }
    return 0;
}

function generics_collections_state_digest(): i32 {
    return integer_buffer_sum(integer_buffer) + integer_buffer_sum(wide_buffer) + integer_buffer_sum(nested_buffer.inner) + ring_peek(ring) + entity_pool_id(
        entity_pool,
        0
    ) + entity_pool_id(entity_pool, 1) + integer_buffer.count + wide_buffer.count + float_buffer.count + nested_buffer.inner.count + sample_window.count + ring.count + entity_pool.count + live_edit_state + courier_rig.count + boss_rig.count;
}

function math_oracle_near(actual: f32, expected: f32, tolerance: f32): bool {
    return math_abs(actual - expected) <= tolerance;
}

function math_oracle_relative_near(actual: f32, expected: f32, tolerance: f32): bool {
    return math_abs(actual - expected) <= math_abs(expected) * tolerance;
}

function math_oracle_close_f64(actual: f64, expected: f64, relative_tolerance: f64, absolute_tolerance: f64): bool {
    return math_abs(actual - expected) <= math_abs(expected) * relative_tolerance + absolute_tolerance;
}

function math_oracle_relative_near_f64(actual: f64, expected: f64, tolerance: f64): bool {
    return math_abs(actual - expected) <= math_abs(expected) * tolerance;
}

