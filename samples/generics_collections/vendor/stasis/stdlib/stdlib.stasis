function ascii_write_f32_fixed(dst: ascii[], value: f32, decimals: i32, base: i32): i32 {
    if (decimals < 0 || decimals > 6 || value != value) {
        return -1;
    }

    let negative: bool = value < 0.0;
    let scaled: f32 = value;
    if (negative) {
        scaled = 0.0 - scaled;
    }

    let digits: i32[46];
    let count: i32 = 0;
    let exp2: i32 = 0;
    let i: i32 = 0;
    if (scaled > 0.0) {
        for (i = 0; i < 192; i = i + 1) {
            if (scaled >= 16777216.0) {
                scaled = scaled / 2.0;
                exp2 = exp2 + 1;
            }
        }
        if (scaled >= 16777216.0) {
            return -1;
        }
        for (i = 0; i < 192; i = i + 1) {
            if (scaled > 0.0 && scaled < 8388608.0) {
                scaled = scaled * 2.0;
                exp2 = exp2 - 1;
            }
        }
    }

    if (scaled == 0.0) {
        digits[0] = 0;
        count = 1;
        negative = false;
    } else {
        if (scaled < 8388608.0 || scaled >= 16777216.0) {
            return -1;
        }
        let mantissa: i32 = f32_to_i32(scaled);
        let remaining: i32 = mantissa;
        for (i = 0; i < 8; i = i + 1) {
            if (remaining > 0) {
                digits[count] = remaining % 10;
                count = count + 1;
                remaining = remaining / 10;
            }
        }

        let pass: i32 = 0;
        for (pass = 0; pass < 6; pass = pass + 1) {
            if (pass < decimals) {
                let carry: i32 = 0;
                let index: i32 = 0;
                for (index = 0; index < count; index = index + 1) {
                    let product: i32 = digits[index] * 5 + carry;
                    digits[index] = product % 10;
                    carry = product / 10;
                }
                if (carry > 0) {
                    digits[count] = carry;
                    count = count + 1;
                }
            }
        }

        let shift: i32 = exp2 + decimals;
        if (shift >= 0) {
            for (pass = 0; pass < 192; pass = pass + 1) {
                if (pass < shift) {
                    let carry: i32 = 0;
                    let index: i32 = 0;
                    for (index = 0; index < count; index = index + 1) {
                        let product: i32 = digits[index] * 2 + carry;
                        digits[index] = product % 10;
                        carry = product / 10;
                    }
                    if (carry > 0) {
                        digits[count] = carry;
                        count = count + 1;
                    }
                }
            }
        } else {
            let right: i32 = 0 - shift;
            let round_up: bool = false;
            for (pass = 0; pass < 192; pass = pass + 1) {
                if (pass < right) {
                    let remainder: i32 = 0;
                    let index: i32 = count - 1;
                    for (index = count - 1; index >= 0; index = index - 1) {
                        let lane: i32 = remainder * 10 + digits[index];
                        digits[index] = lane / 2;
                        remainder = lane % 2;
                    }
                    if (pass == right - 1 && remainder == 1) {
                        round_up = true;
                    }
                    for (index = 0; index < 46; index = index + 1) {
                        if (count > 1 && digits[count - 1] == 0) {
                            count = count - 1;
                        }
                    }
                }
            }
            if (round_up) {
                let carry: i32 = 1;
                let index: i32 = 0;
                for (index = 0; index < 46; index = index + 1) {
                    if (index < count && carry > 0) {
                        let sum: i32 = digits[index] + carry;
                        digits[index] = sum % 10;
                        carry = sum / 10;
                    }
                }
                if (carry > 0) {
                    digits[count] = carry;
                    count = count + 1;
                }
            }
        }
        if (count == 1 && digits[0] == 0) {
            negative = false;
        }
    }

    let sign_count: i32 = 0;
    if (negative) {
        sign_count = 1;
    }
    let payload_length: i32 = count;
    if (decimals > 0) {
        if (count <= decimals) {
            payload_length = decimals + 2;
        } else {
            payload_length = count + 1;
        }
    }
    payload_length = payload_length + sign_count;
    let result_length: i32 = base + payload_length;
    let capacity: i32 = ascii_max_length(dst);
    if (base < 0 || result_length < base || capacity <= result_length) {
        return -1;
    }

    let cursor: i32 = base;
    if (negative) {
        dst[cursor] = 45;
        cursor = cursor + 1;
    }
    if (decimals == 0) {
        for (i = count - 1; i >= 0; i = i - 1) {
            dst[cursor] = to_u8_trunc(48 + digits[i]);
            cursor = cursor + 1;
        }
    } else if (count <= decimals) {
        dst[cursor] = 48;
        cursor = cursor + 1;
        dst[cursor] = 46;
        cursor = cursor + 1;
        let zero_count: i32 = decimals - count;
        for (i = 0; i < zero_count; i = i + 1) {
            dst[cursor] = 48;
            cursor = cursor + 1;
        }
        for (i = count - 1; i >= 0; i = i - 1) {
            dst[cursor] = to_u8_trunc(48 + digits[i]);
            cursor = cursor + 1;
        }
    } else {
        for (i = count - 1; i >= decimals; i = i - 1) {
            dst[cursor] = to_u8_trunc(48 + digits[i]);
            cursor = cursor + 1;
        }
        dst[cursor] = 46;
        cursor = cursor + 1;
        for (i = decimals - 1; i >= 0; i = i - 1) {
            dst[cursor] = to_u8_trunc(48 + digits[i]);
            cursor = cursor + 1;
        }
    }
    dst[result_length] = 0;
    ascii_set_len(dst, result_length);
    return result_length;
}

function ascii_from_f32_fixed(dst: ascii[], value: f32, decimals: i32): i32 {
    return ascii_write_f32_fixed(dst, value, decimals, 0);
}

function ascii_append_f32_fixed(dst: ascii[], value: f32, decimals: i32): i32 {
    return ascii_write_f32_fixed(dst, value, decimals, length(dst));
}

function ascii_pad_left(dst: ascii[], width: i32, fill: u8): i32 {
    let current: i32 = length(dst);
    if (width < 0) {
        return -1;
    }
    if (width <= current) {
        return current;
    }
    let fill_value: i32 = to_i32(fill);
    let capacity: i32 = ascii_max_length(dst);
    if (fill_value <= 0 || fill_value > 127 || capacity <= width) {
        return -1;
    }
    let padding: i32 = width - current;
    let i: i32 = 0;
    for (i = current; i >= 0; i = i - 1) {
        dst[padding + i] = dst[i];
    }
    for (i = 0; i < padding; i = i + 1) {
        dst[i] = fill;
    }
    dst[width] = 0;
    ascii_set_len(dst, width);
    return width;
}

function ascii_cmp(a: ascii[], b: ascii[]): i32 {
    let i: i32 = 0;
    let a_limit: i32 = ascii_scan_limit(a);
    let b_limit: i32 = ascii_scan_limit(b);
    let limit: i32 = a_limit;
    if (b_limit < limit) {
        limit = b_limit;
    }
    for (i = 0; i < limit; i = i + 1) {
        let av: i32 = to_i32(a[i]);
        let bv: i32 = to_i32(b[i]);
        if (av < bv) {
            return -1;
        }
        if (av > bv) {
            return 1;
        }
        if (av == 0) {
            return 0;
        }
    }
    if (a_limit == b_limit) {
        return 0;
    }
    if (a_limit < b_limit) {
        return -1;
    }
    return 1;
}

function ascii_eq(a: ascii[], b: ascii[]): bool {
    return ascii_cmp(a, b) == 0;
}

function ascii_find_byte(s: ascii[], b: u8): i32 {
    let i: i32 = 0;
    let limit: i32 = ascii_scan_limit(s);
    for (i = 0; i < limit; i = i + 1) {
        let cur: u8 = s[i];
        if (cur == b) {
            return i;
        }
        if (cur == 0) {
            return -1;
        }
    }
    return -1;
}

function ascii_find_last_byte(s: ascii[], b: u8): i32 {
    let i: i32 = 0;
    let last: i32 = -1;
    let limit: i32 = ascii_scan_limit(s);
    for (i = 0; i < limit; i = i + 1) {
        let cur: u8 = s[i];
        if (cur == b) {
            last = i;
        }
        if (cur == 0) {
            return last;
        }
    }
    return last;
}

function ascii_starts_with(s: ascii[], prefix: ascii[]): bool {
    let i: i32 = 0;
    let limit: i32 = ascii_scan_limit(prefix);
    for (i = 0; i < limit; i = i + 1) {
        let p: u8 = prefix[i];
        if (p == 0) {
            return true;
        }
        let v: u8 = s[i];
        if (v == 0) {
            return false;
        }
        if (v != p) {
            return false;
        }
    }
    return true;
}

function ascii_ends_with(s: ascii[], suffix: ascii[]): bool {
    let len_s: i32 = length(s);
    let len_suf: i32 = length(suffix);
    if (len_suf > len_s) {
        return false;
    }
    let start: i32 = len_s - len_suf;
    let i: i32 = 0;
    for (i = 0; i < len_suf; i = i + 1) {
        if (s[start + i] != suffix[i]) {
            return false;
        }
    }
    return true;
}

function ascii_find(s: ascii[], needle: ascii[]): i32 {
    let len_s: i32 = length(s);
    let len_n: i32 = length(needle);
    if (len_n == 0) {
        return 0;
    }
    if (len_n > len_s) {
        return -1;
    }
    let i: i32 = 0;
    let j: i32 = 0;
    let match: bool = true;
    for (i = 0; i <(len_s - len_n + 1); i = i + 1) {
        match = true;
        for (j = 0; j < len_n; j = j + 1) {
            if (s[i + j] != needle[j]) {
                match = false;
                j = len_n;
            }
        }
        if (match) {
            return i;
        }
    }
    return -1;
}

function ascii_contains(s: ascii[], needle: ascii[]): bool {
    return ascii_find(s, needle) >= 0;
}

// UTF-8 string buffer helpers.
//
// Layout (see `docs/spec.md`):
// - `utf8[N]`: [byte_length: i32][max_length: i32][char_length: i32][data: u8[N]]
//
// Note: `utf8_set_len_ascii` assumes the payload contains only ASCII bytes, so
// `char_length == byte_length`.

function utf8_max_length(s: utf8[]): i32 {
    let value: i32 = s.max_length;
    if (value < 0) {
        return 0;
    }
    return value;
}

function length_bytes(s: utf8[]): i32 {
    let value: i32 = s.length;
    if (value < 0) {
        return 0;
    }
    let max_len: i32 = s.max_length;
    if (max_len > 0 && value > max_len) {
        return max_len;
    }
    return value;
}

function length_chars(s: utf8[]): i32 {
    let value: i32 = s.char_length;
    if (value < 0) {
        return 0;
    }
    let max_len: i32 = s.max_length;
    if (max_len > 0 && value > max_len) {
        return max_len;
    }
    return value;
}

function utf8_set_byte_len(s: utf8[], len: i32): void {
    let value: i32 = len;
    if (value < 0) {
        value = 0;
    }
    let max_len: i32 = s.max_length;
    if (max_len > 0 && value > max_len) {
        value = max_len;
    }
    s.length = value;
}

function utf8_set_char_len(s: utf8[], len: i32): void {
    let value: i32 = len;
    if (value < 0) {
        value = 0;
    }
    let max_len: i32 = s.max_length;
    if (max_len > 0 && value > max_len) {
        value = max_len;
    }
    s.char_length = value;
}

function utf8_set_len_ascii(s: utf8[], len: i32): void {
    utf8_set_byte_len(s, len);
    utf8_set_char_len(s, len);
}

function utf8_clear_ascii(s: utf8[]): void {
    s[0] = 0;
    utf8_set_len_ascii(s, 0);
}

function utf8_from_ascii(dst: utf8[], src: ascii[], dst_max: i32): i32 {
    let bound: i32 = dst_max;
    let cap: i32 = utf8_max_length(dst);
    if (cap > 0 && bound > cap) {
        bound = cap;
    }
    if (bound <= 0) {
        return 0;
    }

    let i: i32 = 0;
    let limit: i32 = bound - 1;
    let src_limit: i32 = ascii_scan_limit(src);
    for (i = 0; i < limit && i < src_limit; i = i + 1) {
        let b: u8 = src[i];
        if (b == 0) {
            dst[i] = 0;
            utf8_set_len_ascii(dst, i);
            return i;
        }
        dst[i] = b;
    }

    dst[i] = 0;
    utf8_set_len_ascii(dst, i);
    return i;
}
