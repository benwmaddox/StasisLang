    if (d < 0 || d > 9) {
        return 48;
    }
    return 48 + d;
}

function char_to_hex(b: u8): i32 {
    if (char_is_digit(b)) {
        return b - 48;
    }
    if (b >= 65 && b <= 70) {
        return 10 +(b - 65);
    }
    if (b >= 97 && b <= 102) {
        return 10 +(b - 97);
    }
    return -1;
}

function char_from_hex(d: i32): u8 {
    if (d < 0 || d > 15) {
        return 48;
    }
    if (d < 10) {
        return 48 + d;
    }
    return 65 +(d - 10);
}

