}

function char_is_space(b: u8): bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

function char_is_hex(b: u8): bool {
    if (char_is_digit(b)) {
        return true;
    }
    if (b >= 65 && b <= 70) {
        return true;
    }
    return b >= 97 && b <= 102;
}

