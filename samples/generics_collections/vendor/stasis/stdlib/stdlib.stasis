            return -1;
        }
        if (av > bv) {
            return 1;
        }
        if (av == 0) {
            return 0;
        }
    }
    if (a_limit == b_limit) {
        return 0;
    }
    if (a_limit < b_limit) {
        return -1;
    }
    return 1;
}

