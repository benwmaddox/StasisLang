function ascii_write_i32(dst: ascii[], value: i32, base: i32): i32 {
    let negative: bool = value < 0;
    let working: i32 = value;
    if (working > 0) {
        working = 0 - working;
    }

    let digit_count: i32 = 1;
    let remaining: i32 = working;
    let i: i32 = 0;
    for (i = 0; i < 10; i = i + 1) {
        if (remaining <= -10) {
            remaining = remaining / 10;
            digit_count = digit_count + 1;
        }
    }

    let sign_count: i32 = 0;
    if (negative) {
        sign_count = 1;
    }
    let result_length: i32 = base + sign_count + digit_count;
    let capacity: i32 = ascii_max_length(dst);
    if (base < 0 || result_length < base || capacity <= result_length) {
        return -1;
    }

    let cursor: i32 = base;
    if (negative) {
        dst[cursor] = 45;
        cursor = cursor + 1;
    }

    let divisor: i32 = 1;
    for (i = 1; i < digit_count; i = i + 1) {
        divisor = divisor * 10;
    }
    for (i = 0; i < digit_count; i = i + 1) {
        let digit: i32 = 0 -((working / divisor) % 10);
        dst[cursor] = to_u8_trunc(48 + digit);
        cursor = cursor + 1;
        divisor = divisor / 10;
    }
    dst[result_length] = 0;
    ascii_set_len(dst, result_length);
    return result_length;
}

