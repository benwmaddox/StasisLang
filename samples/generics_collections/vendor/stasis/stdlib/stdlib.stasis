function char_is_digit(b: u8): bool {
    return b >= 48 && b <= 57;
}

function char_is_upper(b: u8): bool {
    return b >= 65 && b <= 90;
}

function char_is_lower(b: u8): bool {
    return b >= 97 && b <= 122;
}

function char_is_alpha(b: u8): bool {
    return char_is_upper(b) || char_is_lower(b);
}

