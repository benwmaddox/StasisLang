// Minimal smoke test for data hot-reload binding.
// Run with: .\stasis.bat run samples\data_hotreload_smoke.stasis
//
// The runner binds the first JSON file under data/data_hotreload_smoke/*.json and applies it
// before calling main().

struct Balance {
    health: i32;
}

struct GameState {
    balance: Balance;
    printed: i32;
}

global state: GameState;

function main(): i32 {
    print_string("health=");
    print_int(state.balance.health);
    print_string("\n");
    return 0;
}

function tick(): i32 {
    // Exit immediately so the CLI can finish in watch mode.
    return 1;
}
