global rng_state: i32;

function seed_rng(seed: i32): void {
    rng_state.=(seed);
}

function next_rand(max: i32): i32 {
    rng_state.=(rng_state.*(1103515245).+(12345));
    if (rng_state.<(0)) {
        rng_state.=(0.-(rng_state));
    }
    return rng_state.%((max)).+(1);
}

function print_text_guess(): void {
    // "Guess (1-99, 0 q to quit): "
    print_char(71); print_char(117); print_char(101); print_char(115); print_char(115); print_char(32);
    print_char(40); print_char(49); print_char(45); print_char(57); print_char(57); print_char(44); print_char(32); print_char(48); print_char(32); print_char(113); print_char(32); print_char(116); print_char(111); print_char(32); print_char(113); print_char(117); print_char(105); print_char(116); print_char(41); print_char(58); print_char(32);
}

function print_win(): void {
    print_char(89); print_char(111); print_char(117); print_char(32); print_char(119); print_char(111); print_char(110); print_char(33); print_char(10);
}

function print_higher(): void {
    print_char(72); print_char(105); print_char(103); print_char(104); print_char(101); print_char(114); print_char(10);
}

function print_lower(): void {
    print_char(76); print_char(111); print_char(119); print_char(101); print_char(114); print_char(10);
}

function print_out_of_tries(target: i32): void {
    print_char(79); print_char(117); print_char(116); print_char(32); print_char(111); print_char(102); print_char(32); print_char(116); print_char(114); print_char(105); print_char(101); print_char(115); print_char(46); print_char(32);
    print_char(84); print_char(97); print_char(114); print_char(103); print_char(101); print_char(116); print_char(32); print_char(119); print_char(97); print_char(115); print_char(32);
    print_int(target);
    print_char(10);
}

function print_intro(): void {
    // "I picked a number between 1 and 99."
    print_char(73); print_char(32); print_char(112); print_char(105); print_char(99); print_char(107); print_char(101); print_char(100); print_char(32); print_char(97); print_char(32); print_char(110); print_char(117); print_char(109); print_char(98); print_char(101); print_char(114); print_char(32); print_char(98); print_char(101); print_char(116); print_char(119); print_char(101); print_char(101); print_char(110); print_char(32); print_char(49); print_char(32); print_char(97); print_char(110); print_char(100); print_char(32); print_char(57); print_char(57); print_char(46); print_char(10);
    // "Enter a seed (any integer). 0 quits."
    print_char(69); print_char(110); print_char(116); print_char(101); print_char(114); print_char(32); print_char(97); print_char(32); print_char(115); print_char(101); print_char(101); print_char(100); print_char(32); print_char(40); print_char(97); print_char(110); print_char(121); print_char(32); print_char(105); print_char(110); print_char(116); print_char(101); print_char(103); print_char(101); print_char(114); print_char(41); print_char(46); print_char(32); print_char(48); print_char(32); print_char(113); print_char(117); print_char(105); print_char(116); print_char(115); print_char(46); print_char(10);
}

function main(): i32 {
    print_intro();
    let seed: i32;
    seed.=(read_int());
    if (seed.==(0)) {
        return 0;
    }
    seed_rng(seed);

    let target: i32;
    target.=(next_rand(99));
    if (target.<(1)) { target.=(1); }
    if (target.>(99)) { target.=(target.%((99)).+(1)); }

    let tries: i32;
    for tries.=(0); tries.<(20); tries.=(tries.+(1)) {
        print_text_guess();
        let guess: i32;
        guess.=(read_int());
        if (guess.==(0)) {
            return 0;
        }
        if (guess.<(1) || guess.>(99)) {
            print_invalid();
            continue;
        }
        if (guess.==(target)) {
            print_win();
            return 0;
        }
        if (guess.<(target)) {
            print_higher();
        } else {
            print_lower();
        }
    }

    print_out_of_tries(target);
    return 1;
}
