// Underwater Automation Sample - calm bioluminescent lane factory.
// Single global struct holds all state; arrays are AoS for compiler compatibility.

// External runtime APIs:
// init_window, time, get_time_ms, sleep_ms, should_quit,
// begin_frame, end_frame, clear, draw_line, is_key_down, set_postfx

const KEY_ESCAPE: i32 = 41;

const SCREEN_W_PX: i32 = 960;
const SCREEN_H_PX: i32 = 720;
const SCREEN_W: f32 = 960.0;
const SCREEN_H: f32 = 720.0;
const CELL: f32 = 6.0;
const MAP_W: i32 = 120;
const MAP_H: i32 = 104;
const MAP_SIZE: i32 = 12480;

const MAX_LANES: i32 = 6;
const MAX_CROSSBARS: i32 = 6;
const MAX_MODULES: i32 = 32;
const MAX_UNITS: i32 = 200;

const TARGET_FPS: i32 = 60;
const FRAME_TIME_MS: i32 = 16;
const SPAWN_INTERVAL_MS: i32 = 900;

const TILE_EMPTY: i32 = 0;
const TILE_LANE: i32 = 1;
const TILE_DOCK: i32 = 2;

const MODULE_NONE: i32 = 0;
const MODULE_PRESSURE_LOCK: i32 = 1;
const MODULE_THERMAL_BRACE: i32 = 2;
const MODULE_BIO_LAB: i32 = 3;
const MODULE_RECHARGER: i32 = 4;
const MODULE_ROUTER: i32 = 5;
const MODULE_LIGHT_ANCHOR: i32 = 6;

const UNIT_DRONE: i32 = 0;
const UNIT_PRESSURIZED: i32 = 1;
const UNIT_ABYSSAL: i32 = 2;
const UNIT_PAYLOAD: i32 = 3;

const DEPTH_SHALLOW: i32 = 0;
const DEPTH_MID: i32 = 1;
const DEPTH_DEEP: i32 = 2;

const POSTFX_R: f32 = 0.37;
const POSTFX_G: f32 = 0.95;
const POSTFX_B: f32 = 0.82;

struct TileCell {
    t: i32;
    module: i32;
    depth: i32;
    light: f32;
}

struct ModuleEntry {
    x: i32;
    y: i32;
    kind: i32;
}

struct UnitEntry {
    kind: i32;
    x: i32;
    y: f32;
    progress: f32;
    cooldown: i32;
    alive: bool;
}

struct GameState {
    tiles: TileCell[12480];
    lane_lookup: i32[120];
    lane_columns: i32[6];
    lane_count: i32;
    crossbar_rows: i32[6];
    crossbar_count: i32;

    modules: ModuleEntry[32];
    module_count: i32;

    units: UnitEntry[200];
    unit_count: i32;
    spawn_timer: i32;

    resource_energy: i32;
    resource_data: i32;
    resource_plating: i32;
    delivered_payloads: i32;

    postfx_strength: f32;
    postfx_phase: f32;
    postfx_speed: f32;

    running: bool;
    paused: bool;
    last_tick_ms: i32;
    frame_start_ms: i32;
    lighting_clock_ms: i32;

    rng_state: i32;
}

global state: GameState;

function seed_rng(seed: i32): void {
    state.rng_state = seed;
}

function next_rand(): i32 {
    state.rng_state = state.rng_state * 1664525 + 1013904223;
    if (state.rng_state < 0) {
        state.rng_state = 0 - state.rng_state;
    }
    return state.rng_state;
}

function rand_range(max_exclusive: i32): i32 {
    if (max_exclusive < 1) {
        return 0;
    }
    return next_rand() % max_exclusive;
}

function clamp01(v: f32): f32 {
    if (v < 0.0) {
        return 0.0;
    }
    if (v > 1.0) {
        return 1.0;
    }
    return v;
}

function tile_index(x: i32, y: i32): i32 {
    return y * MAP_W + x;
}

function clear_tiles(): void {
    let i: i32 = 0;
    for (i = 0; i < MAP_SIZE; i = i + 1) {
        state.tiles[i].t = TILE_EMPTY;
        state.tiles[i].module = MODULE_NONE;
        state.tiles[i].depth = DEPTH_SHALLOW;
        state.tiles[i].light = 0.0;
    }
}

function reset_lookup(): void {
    let i: i32 = 0;
    for (i = 0; i < MAP_W; i = i + 1) {
        state.lane_lookup[i] = -1;
    }
}

function add_lane(col: i32): void {
    if (state.lane_count > MAX_LANES - 1) {
        return;
    }
    state.lane_columns[state.lane_count] = col;
    state.lane_lookup[col] = state.lane_count;
    state.lane_count = state.lane_count + 1;

    let y: i32 = 0;
    for (y = 0; y < MAP_H; y = y + 1) {
        let idx: i32 = tile_index(col, y);
        state.tiles[idx].t = TILE_LANE;
    }
}

function add_crossbar(row: i32): void {
    if (state.crossbar_count > MAX_CROSSBARS - 1) {
        return;
    }
    state.crossbar_rows[state.crossbar_count] = row;
    state.crossbar_count = state.crossbar_count + 1;
}

function register_module(x: i32, y: i32, kind: i32): void {
    if (state.module_count < MAX_MODULES) {
        state.modules[state.module_count].x = x;
        state.modules[state.module_count].y = y;
        state.modules[state.module_count].kind = kind;
        state.module_count = state.module_count + 1;
    }
    let idx: i32 = tile_index(x, y);
    state.tiles[idx].module = kind;
}

function setup_depth_bands(): void {
    let band: i32 = MAP_H / 3;
    let y: i32 = 0;
    for (y = 0; y < MAP_H; y = y + 1) {
        let depth: i32 = DEPTH_SHALLOW;
        if (y > band - 1) {
            depth = DEPTH_MID;
        }
        if (y > band * 2 - 1) {
            depth = DEPTH_DEEP;
        }
        let x: i32 = 0;
        for (x = 0; x < MAP_W; x = x + 1) {
            let idx: i32 = tile_index(x, y);
            state.tiles[idx].depth = depth;
            let depth_ratio: f32 = y;
            let map_height: f32 = MAP_H;
            state.tiles[idx].light = 0.15 + (depth_ratio / map_height) * 0.35;
        }
    }
}

function setup_layout(): void {
    clear_tiles();
    reset_lookup();
    state.lane_count = 0;
    state.crossbar_count = 0;
    state.module_count = 0;
    state.unit_count = 0;
    state.spawn_timer = 0;

    add_lane(16);
    add_lane(36);
    add_lane(56);
    add_lane(76);
    add_lane(96);

    add_crossbar(28);
    add_crossbar(56);
    add_crossbar(84);

    register_module(16, 10, MODULE_PRESSURE_LOCK);
    register_module(36, 26, MODULE_PRESSURE_LOCK);
    register_module(56, 40, MODULE_THERMAL_BRACE);
    register_module(76, 58, MODULE_THERMAL_BRACE);
    register_module(96, 72, MODULE_BIO_LAB);
    register_module(56, 86, MODULE_BIO_LAB);
    register_module(36, 48, MODULE_RECHARGER);
    register_module(76, 18, MODULE_RECHARGER);
    register_module(16, 64, MODULE_ROUTER);
    register_module(96, 50, MODULE_ROUTER);
    register_module(56, 20, MODULE_LIGHT_ANCHOR);
    register_module(76, 74, MODULE_LIGHT_ANCHOR);

    let x: i32 = 0;
    for (x = 0; x < MAP_W; x = x + 1) {
        let idx: i32 = tile_index(x, MAP_H - 1);
        state.tiles[idx].t = TILE_DOCK;
    }

    setup_depth_bands();
}

function init_units(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_UNITS; i = i + 1) {
        state.units[i].alive = false;
        state.units[i].kind = UNIT_DRONE;
        state.units[i].x = 0;
        state.units[i].y = 0.0;
        state.units[i].progress = 0.0;
        state.units[i].cooldown = 0;
    }
    state.unit_count = 0;
    state.spawn_timer = 0;
}

function init_state(): void {
    state.running = true;
    state.paused = false;
    state.last_tick_ms = get_time_ms();
    state.frame_start_ms = state.last_tick_ms;
    state.resource_energy = 12;
    state.resource_data = 0;
    state.resource_plating = 8;
    state.delivered_payloads = 0;
    state.postfx_strength = 0.35;
    state.postfx_phase = 0.0;
    state.postfx_speed = 0.4;
    state.lighting_clock_ms = 0;
    setup_layout();
    init_units();
}

function unit_speed(k: i32): f32 {
    if (k == UNIT_DRONE) {
        return 9.0;
    }
    if (k == UNIT_PRESSURIZED) {
        return 10.5;
    }
    if (k == UNIT_ABYSSAL) {
        return 12.0;
    }
    return 8.0;
}

function spawn_unit_at_lane(lane_index: i32): void {
    if (state.unit_count > MAX_UNITS - 1) {
        return;
    }
    let slot: i32 = -1;
    let i: i32 = 0;
    for (i = 0; i < MAX_UNITS; i = i + 1) {
        if (!state.units[i].alive && slot < 0) {
            slot = i;
        }
    }
    if (slot < 0) {
        return;
    }
    state.units[slot].alive = true;
    state.units[slot].kind = UNIT_DRONE;
    state.units[slot].x = state.lane_columns[lane_index];
    state.units[slot].y = 1.0;
    state.units[slot].progress = 0.0;
    state.units[slot].cooldown = 0;
    state.unit_count = state.unit_count + 1;
}

function spawn_wave(): void {
    if (state.lane_count == 0) {
        return;
    }
    let lane: i32 = rand_range(state.lane_count);
    spawn_unit_at_lane(lane);
}

function remove_unit(i: i32): void {
    if (state.units[i].alive) {
        state.units[i].alive = false;
        state.unit_count = state.unit_count - 1;
    }
}

function deliver_payload(i: i32): void {
    state.delivered_payloads = state.delivered_payloads + 1;
    state.resource_data = state.resource_data + 1;
    state.resource_plating = state.resource_plating + 1;
    remove_unit(i);
}

function apply_module(i: i32, module_type: i32, depth: i32): void {
    if (module_type == MODULE_NONE) {
        return;
    }
    if (state.units[i].cooldown > 0) {
        return;
    }

    let utype: i32 = state.units[i].kind;

    if (module_type == MODULE_PRESSURE_LOCK && utype == UNIT_DRONE) {
        state.units[i].kind = UNIT_PRESSURIZED;
        state.units[i].cooldown = 400;
        return;
    }

    if (module_type == MODULE_THERMAL_BRACE && utype == UNIT_PRESSURIZED && depth > DEPTH_MID - 1) {
        state.units[i].kind = UNIT_ABYSSAL;
        state.units[i].cooldown = 400;
        return;
    }

    if (module_type == MODULE_BIO_LAB && utype == UNIT_ABYSSAL && depth == DEPTH_DEEP) {
        state.units[i].kind = UNIT_PAYLOAD;
        state.units[i].cooldown = 400;
        return;
    }

    if (module_type == MODULE_RECHARGER) {
        state.units[i].cooldown = 200;
        return;
    }

    if (module_type == MODULE_ROUTER) {
        let lane_idx: i32 = state.lane_lookup[state.units[i].x];
        if (lane_idx > -1) {
            let dir: i32 = 1;
            if (depth == DEPTH_DEEP) {
                dir = -1;
            }
            let target: i32 = lane_idx + dir;
            if (target < 0) {
                target = 0;
            }
            if (target > state.lane_count - 1) {
                target = state.lane_count - 1;
            }
            state.units[i].x = state.lane_columns[target];
        }
        state.units[i].cooldown = 300;
        return;
    }

    if (module_type == MODULE_LIGHT_ANCHOR) {
        state.postfx_strength = clamp01(state.postfx_strength + 0.02);
        let uy: i32 = state.units[i].y;
        let idx: i32 = tile_index(state.units[i].x, uy);
        state.tiles[idx].light = clamp01(state.tiles[idx].light + 0.1);
        state.units[i].cooldown = 150;
    }
}

function update_units(delta_ms: i32): void {
    let dt: f32 = delta_ms;
    dt = dt / 1000.0;

    let i: i32 = 0;
    for (i = 0; i < MAX_UNITS; i = i + 1) {
        if (state.units[i].alive) {
            if (state.units[i].cooldown > 0) {
                state.units[i].cooldown = state.units[i].cooldown - delta_ms;
                if (state.units[i].cooldown < 0) {
                    state.units[i].cooldown = 0;
                }
            }

            let speed: f32 = unit_speed(state.units[i].kind);
            state.units[i].y = state.units[i].y + speed * dt;
            let y_row: i32 = state.units[i].y;
            if (y_row > MAP_H - 1) {
                remove_unit(i);
            } else {
                let delivered: bool = y_row > MAP_H - 2 && state.units[i].kind == UNIT_PAYLOAD;
                if (delivered) {
                    deliver_payload(i);
                } else {
                    let idx: i32 = tile_index(state.units[i].x, y_row);
                    let module_type: i32 = state.tiles[idx].module;
                    let depth: i32 = state.tiles[idx].depth;
                    apply_module(i, module_type, depth);
                }
            }
        }
    }
}

function update_lighting(delta_ms: i32): void {
    state.lighting_clock_ms = state.lighting_clock_ms + delta_ms;
    if (state.lighting_clock_ms > 1000000) {
        state.lighting_clock_ms = state.lighting_clock_ms - 1000000;
    }

    let flicker_tick: i32 = state.lighting_clock_ms / 33; // ~30Hz wobble
    let y: i32 = 0;
    for (y = 0; y < MAP_H; y = y + 1) {
        let x: i32 = 0;
        for (x = 0; x < MAP_W; x = x + 1) {
            let idx: i32 = tile_index(x, y);
            let depth_band: i32 = state.tiles[idx].depth;
            let base: f32 = 0.16;
            if (depth_band == DEPTH_MID) {
                base = 0.22;
            }
            if (depth_band == DEPTH_DEEP) {
                base = 0.28;
            }

            let noise_seed: i32 = x * 17 + y * 23 + flicker_tick * 13;
            if (noise_seed < 0) {
                noise_seed = 0 - noise_seed;
            }
            noise_seed = noise_seed % 97;
            let flicker: f32 = noise_seed;
            flicker = flicker / 97.0;
            flicker = 0.04 + flicker * 0.08;

            let module_bonus: f32 = 0.0;
            if (state.tiles[idx].module == MODULE_LIGHT_ANCHOR) {
                module_bonus = 0.35;
            }

            let light_value: f32 = base + flicker + module_bonus;
            state.tiles[idx].light = clamp01(light_value);
        }
    }

    let dt_seconds: f32 = delta_ms;
    dt_seconds = dt_seconds / 1000.0;
    state.postfx_phase = state.postfx_phase + dt_seconds * state.postfx_speed;
    if (state.postfx_phase > 100000.0) {
        state.postfx_phase = 0.0;
    }
}

function step_sim(delta_ms: i32): void {
    if (state.paused) {
        return;
    }

    state.spawn_timer = state.spawn_timer + delta_ms;
    if (state.spawn_timer > SPAWN_INTERVAL_MS - 1) {
        spawn_wave();
        state.spawn_timer = state.spawn_timer - SPAWN_INTERVAL_MS;
    }

    update_units(delta_ms);
    update_lighting(delta_ms);
}

function to_screen_x(grid_x: i32): f32 {
    let gx: f32 = grid_x;
    return gx * CELL + 40.0;
}

function to_screen_y(grid_y: i32): f32 {
    let gy: f32 = grid_y;
    return SCREEN_H - (gy * CELL + 80.0);
}

function draw_background(): void {
    let t: f32 = state.postfx_phase;
    let caustic: f32 = sin(t * 0.75);
    let base_r: f32 = 0.03 + 0.01 * caustic * state.postfx_strength;
    let base_g: f32 = 0.10 + 0.02 * caustic * state.postfx_strength;
    let base_b: f32 = 0.14 + 0.03 * caustic * state.postfx_strength;
    clear(base_r, base_g, base_b, 1.0);
}

function draw_depth_bands(): void {
    let band: i32 = MAP_H / 3;
    let y: i32 = 0;
    for (y = band; y < MAP_H; y = y + band) {
        let sy: f32 = to_screen_y(y);
        draw_line(32.0, sy, SCREEN_W - 32.0, sy, 0.08, 0.25, 0.32, 0.6);
    }
}

function draw_lanes(): void {
    let i: i32 = 0;
    for (i = 0; i < state.lane_count; i = i + 1) {
        let x: i32 = state.lane_columns[i];
        let sx: f32 = to_screen_x(x);
        draw_line(sx, to_screen_y(0), sx, to_screen_y(MAP_H - 1), 0.10, 0.55, 0.65, 0.8);
    }

    for (i = 0; i < state.crossbar_count; i = i + 1) {
        let row: i32 = state.crossbar_rows[i];
        let sy: f32 = to_screen_y(row);
        draw_line(to_screen_x(state.lane_columns[0]), sy, to_screen_x(state.lane_columns[state.lane_count - 1]), sy, 0.12, 0.45, 0.55, 0.4);
    }
}

function draw_modules(): void {
    let i: i32 = 0;
    for (i = 0; i < state.module_count; i = i + 1) {
        let mx: f32 = to_screen_x(state.modules[i].x);
        let my: f32 = to_screen_y(state.modules[i].y);
        let t: i32 = state.modules[i].kind;
        let r: f32 = 0.27;
        let g: f32 = 0.76;
        let b: f32 = 0.69;
        if (t == MODULE_PRESSURE_LOCK) {
            r = 0.30; g = 0.80; b = 0.82;
        }
        if (t == MODULE_THERMAL_BRACE) {
            r = 0.28; g = 0.70; b = 0.95;
        }
        if (t == MODULE_BIO_LAB) {
            r = 0.35; g = 0.90; b = 0.65;
        }
        if (t == MODULE_RECHARGER) {
            r = 0.50; g = 0.85; b = 0.60;
        }
        if (t == MODULE_ROUTER) {
            r = 0.85; g = 0.80; b = 0.40;
        }
        if (t == MODULE_LIGHT_ANCHOR) {
            r = 0.70; g = 0.95; b = 0.90;
        }
        draw_line(mx - 4.0, my, mx + 4.0, my, r, g, b, 1.0);
        draw_line(mx, my - 4.0, mx, my + 4.0, r, g, b, 1.0);
    }
}

function draw_units(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_UNITS; i = i + 1) {
        if (state.units[i].alive) {
            let y_row: i32 = state.units[i].y;
            if (!(y_row < 0 || y_row > MAP_H - 1)) {
                let idx: i32 = tile_index(state.units[i].x, y_row);
                let light: f32 = state.tiles[idx].light;
                let depth: i32 = state.tiles[idx].depth;

                let r: f32 = 1.0;
                let g: f32 = 1.0;
                let b: f32 = 1.0;
                if (state.units[i].kind == UNIT_DRONE) {
                    r = 0.90; g = 0.96; b = 1.0;
                }
                if (state.units[i].kind == UNIT_PRESSURIZED) {
                    r = 0.55; g = 0.90; b = 0.98;
                }
                if (state.units[i].kind == UNIT_ABYSSAL) {
                    r = 0.35; g = 0.70; b = 0.95;
                }
                if (state.units[i].kind == UNIT_PAYLOAD) {
                    r = 0.94; g = 0.82; b = 0.42;
                }
                let depth_as_float: f32 = depth;
                let depth_mix: f32 = depth_as_float / 2.0;
                r = r * (0.8 + 0.2 * depth_mix);
                g = g * (0.8 + 0.2 * depth_mix);
                b = b * (0.8 + 0.2 * depth_mix);

                r = r * (0.7 + 0.3 * light);
                g = g * (0.7 + 0.3 * light);
                b = b * (0.7 + 0.3 * light);

                let sx: f32 = to_screen_x(state.units[i].x);
                let sy: f32 = to_screen_y(y_row);
                let y_row_float: f32 = y_row;
                let frac: f32 = state.units[i].y - y_row_float;
                let offset: f32 = frac * CELL;

                let top: f32 = sy + offset + 5.0;
                let bottom: f32 = sy + offset - 5.0;
                draw_line(sx, bottom, sx, top, r, g, b, 1.0);
                draw_line(sx - 2.0, sy + offset, sx + 2.0, sy + offset, r, g, b, 1.0);
            }
        }
    }
}

function draw_overlay(): void {
    let max_payloads: i32 = 20;
    let delivered: i32 = state.delivered_payloads;
    if (delivered > max_payloads) {
        delivered = max_payloads;
    }
    let i: i32 = 0;
    for (i = 0; i < delivered; i = i + 1) {
        let payload_index: f32 = i;
        let payload_bar_x: f32 = 40.0 + payload_index * 10.0;
        draw_line(payload_bar_x, SCREEN_H - 30.0, payload_bar_x + 6.0, SCREEN_H - 30.0, 0.95, 0.85, 0.45, 1.0);
    }
}

function render(): void {
    set_postfx(state.postfx_strength, state.postfx_phase, state.postfx_speed, POSTFX_R, POSTFX_G, POSTFX_B);
    begin_frame();
    draw_background();
    draw_depth_bands();
    draw_lanes();
    draw_modules();
    draw_units();
    draw_overlay();
    end_frame();
}

function handle_input(): void {
    if (is_key_down(KEY_ESCAPE)) {
        state.running = false;
    }
}

// Tests (logic only)
test `unit speeds escalate`() : bool {
    let s0: f32 = unit_speed(UNIT_DRONE);
    let s1: f32 = unit_speed(UNIT_PRESSURIZED);
    let s2: f32 = unit_speed(UNIT_ABYSSAL);
    let s3: f32 = unit_speed(UNIT_PAYLOAD);
    return s0 < s1 && s1 < s2 && s3 < s2;
}

test `pressure lock upgrades drone`() : bool {
    init_state();
    spawn_unit_at_lane(0);
    state.units[0].y = 10.0;
    state.units[0].x = state.lane_columns[0];
    let depth: i32 = state.tiles[tile_index(state.units[0].x, 10)].depth;
    apply_module(0, MODULE_PRESSURE_LOCK, depth);
    return state.units[0].kind == UNIT_PRESSURIZED && state.units[0].cooldown > 0;
}

test `thermal brace requires pressurized`() : bool {
    init_state();
    spawn_unit_at_lane(1);
    state.units[0].y = 40.0;
    state.units[0].x = state.lane_columns[1];
    state.units[0].kind = UNIT_PRESSURIZED;
    let depth: i32 = state.tiles[tile_index(state.units[0].x, 40)].depth;
    apply_module(0, MODULE_THERMAL_BRACE, depth);
    return state.units[0].kind == UNIT_ABYSSAL;
}

test `router shifts to neighbor lane`() : bool {
    init_state();
    spawn_unit_at_lane(0);
    state.units[0].x = state.lane_columns[0];
    apply_module(0, MODULE_ROUTER, DEPTH_SHALLOW);
    let target_x: i32 = state.lane_columns[1];
    return state.units[0].x == target_x;
}

test `light anchor boosts brightness`() : bool {
    init_state();
    let idx: i32 = tile_index(state.lane_columns[0], 20);
    state.tiles[idx].module = MODULE_LIGHT_ANCHOR;
    state.lighting_clock_ms = 0;
    update_lighting(16);
    let lit_with_anchor: f32 = state.tiles[idx].light;

    state.tiles[idx].module = MODULE_NONE;
    update_lighting(16);
    let lit_without_anchor: f32 = state.tiles[idx].light;

    return lit_with_anchor > lit_without_anchor && lit_with_anchor > 0.3;
}

function main(): i32 {
    let ok: bool = init_window(SCREEN_W_PX, SCREEN_H_PX, "Underwater Automation");
    if (!ok) {
        return 1;
    }

    seed_rng(time());
    init_state();

    for (; state.running; ) {
        state.frame_start_ms = get_time_ms();
        handle_input();
        if (should_quit()) {
            state.running = false;
        }

        let now_ms: i32 = get_time_ms();
        let delta_ms: i32 = now_ms - state.last_tick_ms;
        if (delta_ms < 1) {
            delta_ms = 1;
        }
        if (delta_ms > 120) {
            delta_ms = 120;
        }
        state.last_tick_ms = now_ms;

        step_sim(delta_ms);
        render();

        let frame_end_ms: i32 = get_time_ms();
        let elapsed_ms: i32 = frame_end_ms - state.frame_start_ms;
        let sleep_for_ms: i32 = FRAME_TIME_MS - elapsed_ms;
        if (sleep_for_ms > 0) {
            sleep_ms(sleep_for_ms);
        }
    }

    return 0;
}
