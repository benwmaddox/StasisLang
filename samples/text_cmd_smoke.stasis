import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/gfx_cmd.stasis";
import "../src/host_frame.stasis";

// Smoke test: command-buffer text submission.
//
// NOTE: Font path is Windows-specific by default. Change FONT_PATH if needed.

const FONT_PATH: string = "C:/Windows/Fonts/consola.ttf";
const FONT_SIZE: i32 = 20;

global font: i32;

function tick(): void {
    if (font == 0) {
        return;
    }

    gfx_cmd_begin();
    gfx_cmd_clear(0.02, 0.02, 0.03, 1.0);
    gfx_cmd_text(font, "Hello from gfx_cmd_text()", 24.0, 24.0, 0.9, 0.9, 0.95, 1.0);
    gfx_cmd_text(font, "Coordinates are host pixels.", 24.0, 52.0, 0.7, 0.8, 0.9, 1.0);
    gfx_cmd_mark_present();
}

function main(): i32 {
    let ok: bool = init_window(640, 360, "text_cmd_smoke");
    if (!ok) {
        print_string("init_window failed\n");
        return 1;
    }

    font = load_font(FONT_PATH, FONT_SIZE);
    if (font == 0) {
        print_string("load_font failed\n");
        return 2;
    }

    return 0;
}
