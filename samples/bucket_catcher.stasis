import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/stdlib/game_input.stasis";
import "../src/stdlib/game_draw.stasis";
import "../src/stdlib/sdl_scancodes.stasis";

// Bucket Catcher - minimal instructional sample.
//
// Goals:
// - Show a simple game loop (init -> tick -> draw).
// - Demonstrate keyboard + pointer input.
// - Keep state in explicit globals (no hidden allocation).
// - Keep most tuning data in JSON so learners can edit without recompiling.
// - Use PNG sprites for the bucket/ball to show asset binding.
//
// Config binding:
// - A JSON file at samples/bucket_catcher/data/config.json can populate state.config.
// - The runtime runner binds matching keys into the global state (see --data-bind).
// - We still provide defaults in ensure_config_loaded() so the sample runs anywhere.

const MAX_BALLS: i32 = 24;

struct Ball {
    x: f32;
    y: f32;
    vy: f32;
    active: bool;
}

// Tunable parameters (data-bound from JSON in samples/bucket_catcher/data/config.json).
struct BucketConfig {
    json_loaded: bool;
    screen_width: i32;
    screen_height: i32;
    font_path: string;
    font_size_pixels: i32;
    bucket_sprite_path: string;
    ball_sprite_path: string;
    tick_delta_seconds: f32;
    bucket_width: f32;
    bucket_height: f32;
    bucket_bottom_padding: f32;
    bucket_speed: f32;
    bucket_turn_rate: f32;
    ball_radius: f32;
    ball_fall_speed: f32;
    ball_spawn_seconds: f32;
    background_red: f32;
    background_green: f32;
    background_blue: f32;
    bucket_red: f32;
    bucket_green: f32;
    bucket_blue: f32;
    ball_red: f32;
    ball_green: f32;
    ball_blue: f32;
    ui_red: f32;
    ui_green: f32;
    ui_blue: f32;
}

struct GameState {
    config: BucketConfig;
    bucket_x: f32;
    bucket_target_x: f32;
    catches: i32;
    misses: i32;

    balls: Ball[24];
    spawn_timer_seconds: f32;

    ui_font: i32;
    bucket_sprite: i32;
    ball_sprite: i32;
    ui_ascii: ascii[64];
    ui_text: utf8[64];

    rng_state: i32;
    initialized: bool;
}

// Single global state block (instructional style).
global state: GameState;

function seed_rng(seed: i32): void {
    state.rng_state = seed;
}

function next_rand_u32(): i32 {
    // LCG (fast, deterministic, good enough for simple gameplay).
    state.rng_state = state.rng_state * 1103515245 + 12345;
    if (state.rng_state < 0) { state.rng_state = 0 - state.rng_state; }
    return state.rng_state;
}

function rand_range_f32(min_v: f32, max_v: f32): f32 {
    let r: i32 = next_rand_u32();
    let f: f32 = i32_to_f32(r % 65536) / 65535.0;
    return min_v + (max_v - min_v) * f;
}

function ensure_config_loaded(): void {
    if (state.config.json_loaded) {
        if (state.config.screen_width < 1 || state.config.screen_height < 1) {
            state.config.screen_width = 480;
            state.config.screen_height = 800;
        }
        if (state.config.font_path == "") {
            state.config.font_path = "docs/assets/fonts/dejavu-sans-mono.ttf";
        }
        if (state.config.bucket_sprite_path == "") {
            state.config.bucket_sprite_path = "samples/bucket_catcher/assets/bucket.png";
        }
        if (state.config.ball_sprite_path == "") {
            state.config.ball_sprite_path = "samples/bucket_catcher/assets/ball.png";
        }
        return;
    }

    // Defaults for when JSON binding is not present.
    state.config.screen_width = 480;
    state.config.screen_height = 800;
    state.config.font_path = "docs/assets/fonts/dejavu-sans-mono.ttf";
    state.config.font_size_pixels = 20;
    state.config.bucket_sprite_path = "samples/bucket_catcher/assets/bucket.png";
    state.config.ball_sprite_path = "samples/bucket_catcher/assets/ball.png";
    state.config.tick_delta_seconds = 1.0 / 60.0;
    state.config.bucket_width = 110.0;
    state.config.bucket_height = 20.0;
    state.config.bucket_bottom_padding = 24.0;
    state.config.bucket_speed = 520.0;
    state.config.bucket_turn_rate = 10.0;
    state.config.ball_radius = 10.0;
    state.config.ball_fall_speed = 240.0;
    state.config.ball_spawn_seconds = 0.65;
    state.config.background_red = 0.05;
    state.config.background_green = 0.07;
    state.config.background_blue = 0.10;
    state.config.bucket_red = 0.2;
    state.config.bucket_green = 0.8;
    state.config.bucket_blue = 1.0;
    state.config.ball_red = 1.0;
    state.config.ball_green = 0.7;
    state.config.ball_blue = 0.2;
    state.config.ui_red = 0.9;
    state.config.ui_green = 0.9;
    state.config.ui_blue = 0.9;
}

function clamp(v: f32, lo: f32, hi: f32): f32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

function init_game(): void {
    if (!state.initialized) {
        state.initialized = true;
        ensure_config_loaded();
        seed_rng(get_time_ms());

        state.bucket_x = i32_to_f32(state.config.screen_width) * 0.5;
        state.bucket_target_x = state.bucket_x;
        state.catches = 0;
        state.misses = 0;
        state.spawn_timer_seconds = 0.0;

        foreach (let ball in state.balls) {
            ball.active = false;
        }
    }
}

function ensure_window(): bool {
    if (state.ui_font != 0) {
        return true;
    }

    if (!init_window(state.config.screen_width, state.config.screen_height, "Bucket Catcher")) {
        return false;
    }

    // Fonts depend on the graphics context, so load them after the window exists.
    state.ui_font = load_font(state.config.font_path, state.config.font_size_pixels);
    state.bucket_sprite = gfx_load_sprite(
        state.config.bucket_sprite_path,
        f32_to_i32(state.config.bucket_width),
        f32_to_i32(state.config.bucket_height)
    );
    state.ball_sprite = gfx_load_sprite(
        state.config.ball_sprite_path,
        f32_to_i32(state.config.ball_radius * 2.0),
        f32_to_i32(state.config.ball_radius * 2.0)
    );
    return true;
}

function spawn_ball(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_BALLS; i = i + 1) {
        if (!state.balls[i].active) {
            state.balls[i].active = true;
            state.balls[i].x = rand_range_f32(state.config.ball_radius, i32_to_f32(state.config.screen_width) - state.config.ball_radius);
            state.balls[i].y = -state.config.ball_radius;
            state.balls[i].vy = state.config.ball_fall_speed;
            return;
        }
    }
}

function update_input(): void {
    // Pointer input: follow the first active pointer when it is down.
    let count: i32 = input_pointer_count();
    if (count > 0 && input_pointer_is_down(0)) {
        state.bucket_target_x = input_pointer_x_px(0);
    }

    // Keyboard input: steer left/right with arrow keys.
    let move: f32 = 0.0;
    if (input_key_down(Scancode.Left)) { move = move - 1.0; }
    if (input_key_down(Scancode.Right)) { move = move + 1.0; }
    if (move != 0.0) {
        state.bucket_target_x = state.bucket_target_x + move * state.config.bucket_speed * state.config.tick_delta_seconds;
    }

    let half_w: f32 = state.config.bucket_width * 0.5;
    state.bucket_target_x = clamp(state.bucket_target_x, half_w, i32_to_f32(state.config.screen_width) - half_w);
}

function update_bucket(): void {
    // Smoothly approach the target to avoid jittery motion.
    let half_w: f32 = state.config.bucket_width * 0.5;
    let dx: f32 = state.bucket_target_x - state.bucket_x;
    state.bucket_x = state.bucket_x + dx * state.config.bucket_turn_rate * state.config.tick_delta_seconds;
    state.bucket_x = clamp(state.bucket_x, half_w, i32_to_f32(state.config.screen_width) - half_w);
}

function update_balls(): void {
    let bucket_top: f32 = i32_to_f32(state.config.screen_height) - state.config.bucket_bottom_padding - state.config.bucket_height;
    let bucket_left: f32 = state.bucket_x - state.config.bucket_width * 0.5;
    let bucket_right: f32 = state.bucket_x + state.config.bucket_width * 0.5;

    foreach (let ball in state.balls) {
        if (ball.active) {
            ball.y = ball.y + ball.vy * state.config.tick_delta_seconds;

            // Catch: circle overlaps the bucket rectangle.
            if (ball.y + state.config.ball_radius >= bucket_top &&
                ball.y - state.config.ball_radius <= bucket_top + state.config.bucket_height &&
                ball.x >= bucket_left &&
                ball.x <= bucket_right) {
                ball.active = false;
                state.catches = state.catches + 1;
            } else {
                // Miss: fell below the screen.
                if (ball.y - state.config.ball_radius > i32_to_f32(state.config.screen_height)) {
                    ball.active = false;
                    state.misses = state.misses + 1;
                }
            }
        }
    }
}

function update_spawns(): void {
    state.spawn_timer_seconds = state.spawn_timer_seconds + state.config.tick_delta_seconds;
    if (state.spawn_timer_seconds >= state.config.ball_spawn_seconds) {
        state.spawn_timer_seconds = 0.0;
        spawn_ball();
    }
}

function draw_bucket(): void {
    let x0: f32 = state.bucket_x - state.config.bucket_width * 0.5;
    let y0: f32 = i32_to_f32(state.config.screen_height) - state.config.bucket_bottom_padding - state.config.bucket_height;
    let x1: f32 = state.bucket_x + state.config.bucket_width * 0.5;
    let y1: f32 = y0 + state.config.bucket_height;

    if (state.bucket_sprite != 0) {
        gfx_draw_sprite(
            state.bucket_sprite,
            f32_to_i32(x0),
            f32_to_i32(y0),
            f32_to_i32(state.config.bucket_width),
            f32_to_i32(state.config.bucket_height),
            0,
            255
        );
    } else {
        // Outline fallback (clear and cheap).
        draw_line(x0, y0, x1, y0, state.config.bucket_red, state.config.bucket_green, state.config.bucket_blue, 1.0);
        draw_line(x1, y0, x1, y1, state.config.bucket_red, state.config.bucket_green, state.config.bucket_blue, 1.0);
        draw_line(x1, y1, x0, y1, state.config.bucket_red, state.config.bucket_green, state.config.bucket_blue, 1.0);
        draw_line(x0, y1, x0, y0, state.config.bucket_red, state.config.bucket_green, state.config.bucket_blue, 1.0);
    }
}

function draw_balls(): void {
    foreach (let ball in state.balls) {
        if (ball.active) {
            if (state.ball_sprite != 0) {
                gfx_draw_sprite(
                    state.ball_sprite,
                    f32_to_i32(ball.x - state.config.ball_radius),
                    f32_to_i32(ball.y - state.config.ball_radius),
                    f32_to_i32(state.config.ball_radius * 2.0),
                    f32_to_i32(state.config.ball_radius * 2.0),
                    0,
                    255
                );
            } else {
                game_draw_circle(ball.x, ball.y, state.config.ball_radius, state.config.ball_red, state.config.ball_green, state.config.ball_blue, 1.0);
            }
        }
    }
}

function draw_ui(): void {
    if (state.ui_font == 0) { return; }
    ascii_clear(state.ui_ascii);
    ascii_append(state.ui_ascii, "Catches: ");
    ascii_append_i32(state.ui_ascii, state.catches);
    ascii_append(state.ui_ascii, "  Misses: ");
    ascii_append_i32(state.ui_ascii, state.misses);
    from_ascii(state.ui_text, state.ui_ascii, 64);

    draw_text(state.ui_font, state.ui_text, 12.0, 10.0, state.config.ui_red, state.config.ui_green, state.config.ui_blue, 1.0);
}

function tick(): i32 {
    if (!state.initialized || state.ui_font == 0) {
        return 1;
    }

    if (should_quit()) {
        return 0;
    }

    update_input();
    update_bucket();
    update_spawns();
    update_balls();

    begin_frame();
    clear(state.config.background_red, state.config.background_green, state.config.background_blue, 1.0);
    draw_balls();
    draw_bucket();
    draw_ui();
    end_frame();

    return 0;
}

function main(): i32 {
    init_game();
    if (!ensure_window()) {
        return 1;
    }
    return 0;
}
