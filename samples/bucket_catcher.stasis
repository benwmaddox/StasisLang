import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/stdlib/game_input.stasis";
import "../src/stdlib/game_draw.stasis";
import "../src/stdlib/sdl_scancodes.stasis";

// Bucket Catcher - minimal instructional sample.
//
// Goals:
// - Show a simple game loop (init -> tick -> draw).
// - Demonstrate keyboard + pointer input.
// - Keep state in explicit globals (no hidden allocation).
// - Use deterministic updates (fixed dt) for predictability.

const SCREEN_W: i32 = 480;
const SCREEN_H: i32 = 800;

const FONT_PATH: string = "docs/assets/fonts/dejavu-sans-mono.ttf";
const FONT_SIZE_PX: i32 = 20;

const BUCKET_W: f32 = 110.0;
const BUCKET_H: f32 = 20.0;
const BUCKET_Y_PAD: f32 = 24.0;
const BUCKET_SPEED: f32 = 520.0; // pixels/sec (used when keys are held)
const BUCKET_TURN_RATE: f32 = 10.0; // smoothing toward pointer target

const BALL_RADIUS: f32 = 10.0;
const BALL_FALL_SPEED: f32 = 240.0;
const BALL_SPAWN_MS: i32 = 650;
const MAX_BALLS: i32 = 24;

const DT: f32 = 1.0 / 60.0; // fixed dt keeps the math easy to follow

struct Ball {
    x: f32;
    y: f32;
    vy: f32;
    active: bool;
}

struct GameState {
    bucket_x: f32;
    bucket_target_x: f32;
    catches: i32;
    misses: i32;

    balls: Ball[24];
    spawn_timer_ms: i32;

    ui_font: i32;
    ui_ascii: ascii[64];
    ui_text: utf8[64];

    rng_state: i32;
    initialized: bool;
}

// Single global state block (instructional style).
global state: GameState;

function seed_rng(seed: i32): void {
    state.rng_state = seed;
}

function next_rand_u32(): i32 {
    // LCG (fast, deterministic, good enough for simple gameplay).
    state.rng_state = state.rng_state * 1103515245 + 12345;
    if (state.rng_state < 0) { state.rng_state = 0 - state.rng_state; }
    return state.rng_state;
}

function rand_range_f32(min_v: f32, max_v: f32): f32 {
    let r: i32 = next_rand_u32();
    let f: f32 = i32_to_f32(r & 0xFFFF) / 65535.0;
    return min_v + (max_v - min_v) * f;
}

function clamp(v: f32, lo: f32, hi: f32): f32 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

function init_game(): void {
    if (!state.initialized) {
        state.initialized = true;
        seed_rng(i64_to_i32_trunc(time(0)));

        state.bucket_x = i32_to_f32(SCREEN_W) * 0.5;
        state.bucket_target_x = state.bucket_x;
        state.catches = 0;
        state.misses = 0;
        state.spawn_timer_ms = 0;

        foreach (let ball in state.balls) {
            ball.active = false;
        }
    }
}

function ensure_window(): bool {
    if (state.ui_font != 0) {
        return true;
    }

    if (!init_window(SCREEN_W, SCREEN_H, "Bucket Catcher")) {
        return false;
    }

    // Fonts depend on the graphics context, so load them after the window exists.
    state.ui_font = load_font(FONT_PATH, FONT_SIZE_PX);
    return true;
}

function spawn_ball(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_BALLS; i = i + 1) {
        if (!state.balls[i].active) {
            state.balls[i].active = true;
            state.balls[i].x = rand_range_f32(BALL_RADIUS, i32_to_f32(SCREEN_W) - BALL_RADIUS);
            state.balls[i].y = -BALL_RADIUS;
            state.balls[i].vy = BALL_FALL_SPEED;
            return;
        }
    }
}

function update_input(): void {
    // Pointer input: follow the first active pointer when it is down.
    let count: i32 = input_pointer_count();
    if (count > 0 && input_pointer_is_down(0)) {
        state.bucket_target_x = input_pointer_x_px(0);
    }

    // Keyboard input: steer left/right with arrow keys.
    let move: f32 = 0.0;
    if (input_key_down(SCANCODE_LEFT)) { move = move - 1.0; }
    if (input_key_down(SCANCODE_RIGHT)) { move = move + 1.0; }
    if (move != 0.0) {
        state.bucket_target_x = state.bucket_target_x + move * BUCKET_SPEED * DT;
    }

    let half_w: f32 = BUCKET_W * 0.5;
    state.bucket_target_x = clamp(state.bucket_target_x, half_w, i32_to_f32(SCREEN_W) - half_w);
}

function update_bucket(): void {
    // Smoothly approach the target to avoid jittery motion.
    let half_w: f32 = BUCKET_W * 0.5;
    let dx: f32 = state.bucket_target_x - state.bucket_x;
    state.bucket_x = state.bucket_x + dx * BUCKET_TURN_RATE * DT;
    state.bucket_x = clamp(state.bucket_x, half_w, i32_to_f32(SCREEN_W) - half_w);
}

function update_balls(): void {
    let bucket_top: f32 = i32_to_f32(SCREEN_H) - BUCKET_Y_PAD - BUCKET_H;
    let bucket_left: f32 = state.bucket_x - BUCKET_W * 0.5;
    let bucket_right: f32 = state.bucket_x + BUCKET_W * 0.5;

    foreach (let ball in state.balls) {
        if (!ball.active) { continue; }
        ball.y = ball.y + ball.vy * DT;

        // Catch: circle overlaps the bucket rectangle.
        if (ball.y + BALL_RADIUS >= bucket_top &&
            ball.y - BALL_RADIUS <= bucket_top + BUCKET_H &&
            ball.x >= bucket_left &&
            ball.x <= bucket_right) {
            ball.active = false;
            state.catches = state.catches + 1;
            continue;
        }

        // Miss: fell below the screen.
        if (ball.y - BALL_RADIUS > i32_to_f32(SCREEN_H)) {
            ball.active = false;
            state.misses = state.misses + 1;
        }
    }
}

function update_spawns(): void {
    state.spawn_timer_ms = state.spawn_timer_ms + 16;
    if (state.spawn_timer_ms >= BALL_SPAWN_MS) {
        state.spawn_timer_ms = 0;
        spawn_ball();
    }
}

function draw_bucket(): void {
    let x0: f32 = state.bucket_x - BUCKET_W * 0.5;
    let y0: f32 = i32_to_f32(SCREEN_H) - BUCKET_Y_PAD - BUCKET_H;
    let x1: f32 = state.bucket_x + BUCKET_W * 0.5;
    let y1: f32 = y0 + BUCKET_H;

    // Outline (clear and cheap).
    draw_line(x0, y0, x1, y0, 0.2, 0.8, 1.0, 1.0);
    draw_line(x1, y0, x1, y1, 0.2, 0.8, 1.0, 1.0);
    draw_line(x1, y1, x0, y1, 0.2, 0.8, 1.0, 1.0);
    draw_line(x0, y1, x0, y0, 0.2, 0.8, 1.0, 1.0);
}

function draw_balls(): void {
    foreach (let ball in state.balls) {
        if (!ball.active) { continue; }
        game_draw_circle(ball.x, ball.y, BALL_RADIUS, 1.0, 0.7, 0.2, 1.0);
    }
}

function draw_ui(): void {
    if (state.ui_font == 0) { return; }
    ascii_clear(state.ui_ascii);
    ascii_append(state.ui_ascii, "Catches: ");
    ascii_append_i32(state.ui_ascii, state.catches);
    ascii_append(state.ui_ascii, "  Misses: ");
    ascii_append_i32(state.ui_ascii, state.misses);
    from_ascii(state.ui_text, state.ui_ascii, 64);

    draw_text(state.ui_font, state.ui_text, 12.0, 10.0, 0.9, 0.9, 0.9, 1.0);
}

function tick(): i32 {
    if (!state.initialized || state.ui_font == 0) {
        return 1;
    }

    if (should_quit()) {
        return 0;
    }

    update_input();
    update_bucket();
    update_spawns();
    update_balls();

    begin_frame();
    clear(0.05, 0.07, 0.1, 1.0);
    draw_balls();
    draw_bucket();
    draw_ui();
    end_frame();

    return 0;
}

function main(): i32 {
    init_game();
    if (!ensure_window()) {
        return 1;
    }
    return 0;
}
