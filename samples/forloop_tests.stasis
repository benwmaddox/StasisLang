import "../src/stdlib/stdlib.stasis";

// Unit tests for for-loop behavior

function abs_i32(x: i32): i32 {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

function abs_f32(x: f32): f32 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

function approx_eq(a: f32, b: f32, tolerance: f32): bool {
    let diff: f32 = abs_f32(a - b);
    return diff < tolerance;
}

// ============================================
// Basic loop counter tests
// ============================================

test loop_executes_correct_times(): bool {
    let count: i32 = 0;
    let i: i32 = 0;
    count = 0;
    for (i = 0; i < 5; i = i + 1) {
        count = count + 1;
    }
    return count == 5;
}

test loop_counter_reaches_final_value(): bool {
    let i: i32 = 0;
    for (i = 0; i < 10; i = i + 1) {
        // empty body
        let dummy: i32 = 0;
    }
    return i == 10;
}

test loop_with_start_value(): bool {
    let sum: i32 = 0;
    let i: i32 = 0;
    sum = 0;
    for (i = 5; i < 10; i = i + 1) {
        sum = sum + i;
    }
    // 5+6+7+8+9 = 35
    return sum == 35;
}

// ============================================
// Variable assignment in loop tests
// ============================================

test assign_i32_in_loop(): bool {
    let i: i32 = 0;
    let value: i32 = 0;
    for (i = 0; i < 5; i = i + 1) {
        value = i;
    }
    // After loop, value should be 4 (last assignment)
    return value == 4;
}

test assign_f32_in_loop(): bool {
    let i: i32 = 0;
    let value: f32 = 0.0;
    for (i = 0; i < 5; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        value = if32;
    }
    // After loop, value should be 4.0
    return approx_eq(value, 4.0, 0.01);
}

test i32_to_f32_conversion_in_loop(): bool {
    let i: i32 = 0;
    let sum: f32 = 0.0;
    for (i = 0; i < 5; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        sum = sum + if32;
    }
    // 0+1+2+3+4 = 10
    return approx_eq(sum, 10.0, 0.01);
}

test calculation_with_converted_value(): bool {
    let i: i32 = 0;
    let result: f32 = 0.0;
    for (i = 0; i < 3; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        result = 100.0 + if32 * 50.0;
    }
    // After i=0: result = 100
    // After i=1: result = 150
    // After i=2: result = 200
    return approx_eq(result, 200.0, 0.01);
}

// ============================================
// Accumulator pattern tests (like prev_x/prev_y)
// ============================================

test accumulator_i32(): bool {
    let i: i32 = 0;
    let prev: i32 = 0;
    let curr: i32 = 0;
    prev = 0;
    for (i = 1; i < 5; i = i + 1) {
        curr = prev + i;
        prev = curr;
    }
    // prev should accumulate: 0+1=1, 1+2=3, 3+3=6, 6+4=10
    return prev == 10;
}

test accumulator_f32(): bool {
    let i: i32 = 0;
    let prev: f32 = 0.0;
    let curr: f32 = 0.0;
    prev = 0.0;
    for (i = 1; i < 5; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        curr = prev + if32;
        prev = curr;
    }
    return approx_eq(prev, 10.0, 0.01);
}

test prev_curr_pattern_like_asteroids(): bool {
    let i: i32 = 0;
    let prev_x: f32 = 0.0;
    let curr_x: f32 = 0.0;
    let last_prev: f32 = 0.0;
    prev_x = 100.0;
    for (i = 1; i < 4; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        curr_x = 100.0 + if32 * 30.0;
        last_prev = prev_x;
        prev_x = curr_x;
    }
    // After i=1: curr_x=130, prev_x=130
    // After i=2: curr_x=160, prev_x=160
    // After i=3: curr_x=190, prev_x=190
    return approx_eq(prev_x, 190.0, 0.01);
}

// ============================================
// Nested loop tests
// ============================================

test nested_loop_count(): bool {
    let i: i32 = 0;
    let j: i32 = 0;
    let count: i32 = 0;
    for (i = 0; i < 3; i = i + 1) {
        for (j = 0; j < 4; j = j + 1) {
            count = count + 1;
        }
    }
    return count == 12;
}

// ============================================
// Division in loop (like jf / 8.0)
// ============================================

test division_in_loop(): bool {
    let i: i32 = 0;
    let result: f32 = 0.0;
    for (i = 0; i < 4; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        result = if32 / 4.0;
    }
    // After i=3: result = 3/4 = 0.75
    return approx_eq(result, 0.75, 0.01);
}

test angle_calculation_like_asteroids(): bool {
    let i: i32 = 0;
    let angle: f32 = 0.0;
    let PI: f32 = 3.14159;
    angle = 0.0;
    for (i = 1; i < 5; i = i + 1) {
        let if32: f32 = i32_to_f32(i);
        angle = (if32 / 8.0) * 2.0 * PI;
    }
    // After i=4: angle = (4/8) * 2 * PI = PI
    return approx_eq(angle, PI, 0.01);
}

// ============================================
// Pure f32 loop (no conversion) - should work
// ============================================

test pure_f32_loop_no_conversion(): bool {
    let i: i32 = 0;
    let value: f32 = 0.0;
    for (i = 0; i < 5; i = i + 1) {
        value = value + 10.0;
    }
    // Should be 50.0
    return approx_eq(value, 50.0, 0.01);
}

test pure_f32_accumulator(): bool {
    let i: i32 = 0;
    let prev: f32 = 0.0;
    let curr: f32 = 0.0;
    prev = 100.0;
    for (i = 0; i < 3; i = i + 1) {
        curr = prev + 25.0;
        prev = curr;
    }
    // 100+25=125, 125+25=150, 150+25=175
    return approx_eq(prev, 175.0, 0.01);
}

test f32_multiply_in_loop(): bool {
    let i: i32 = 0;
    let value: f32 = 1.0;
    for (i = 0; i < 4; i = i + 1) {
        value = value * 2.0;
    }
    // 1*2*2*2*2 = 16
    return approx_eq(value, 16.0, 0.01);
}

// ============================================
// Array access in loop
// ============================================

global test_array: i32[5];

test array_write_in_loop(): bool {
    let i: i32 = 0;
    for (i = 0; i < 5; i = i + 1) {
        test_array[i] = i * 10;
    }
    return test_array[0] == 0 && test_array[2] == 20 && test_array[4] == 40;
}

test array_read_in_loop(): bool {
    let i: i32 = 0;
    let sum: i32 = 0;
    // First set values
    for (i = 0; i < 5; i = i + 1) {
        test_array[i] = i;
    }
    // Then sum them
    sum = 0;
    for (i = 0; i < 5; i = i + 1) {
        sum = sum + test_array[i];
    }
    return sum == 10;
}
