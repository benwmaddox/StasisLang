// Test optional parentheses for if and for statements

function test_if_without_parens(): i32 {
    let x: i32 = 5;

    // Without parentheses
    if (x == 5) {
        return 1;
    }

    return 0;
}

function test_if_with_parens(): i32 {
    let x: i32 = 5;

    // With parentheses (old style)
    if (x == 5) {
        return 1;
    }

    return 0;
}

function test_for_without_parens(): i32 {
    let sum: i32 = 0;

    // Without parentheses
    let i: i32 = 0;
    for (i = 0; i < 10; i = i + 1) {
        sum = sum + i;
    }

    return sum;
}

function test_for_with_parens(): i32 {
    let sum: i32 = 0;

    // With parentheses (old style)
    let i: i32 = 0;
    for (i = 0; i < 10; i = i + 1) {
        sum = sum + i;
    }

    return sum;
}

function test_nested_if_without_parens(): i32 {
    let x: i32 = 0;
    let y: i32 = 0;
    x = 5;
    y = 10;

    if (x < y) {
        if (x == 5) {
            return 1;
        }
    }

    return 0;
}

function test_if_else_without_parens(): i32 {
    let x: i32 = 5;

    if (x == 10) {
        return 0;
    } else {
        return 1;
    }
}

function main(): i32 {
    let a: i32 = 0;
    let b: i32 = 0;
    let c: i32 = 0;
    let d: i32 = 0;
    let e: i32 = 0;
    let f: i32 = 0;

    a = test_if_without_parens();
    b = test_if_with_parens();
    c = test_for_without_parens();
    d = test_for_with_parens();
    e = test_nested_if_without_parens();
    f = test_if_else_without_parens();

    if (a == 1) {
        if (b == 1) {
            if (c == 45) {
                if (d == 45) {
                    if (e == 1) {
                        if (f == 1) {
                            return 0;
                        }
                    }
                }
            }
        }
    }

    return 1;
}