import "../src/stdlib/stdlib.stasis";

function main(): i32 {
    let x: i32 = 1;
    x += 2 * 3;
    x -= 4 / 2;
    x *= 3;
    x %= 7;
    return x; // (1 + 6) - 2 = 5; 5 * 3 = 15; 15 % 7 = 1
}

test precedence(): bool {
    return 1 + 2 * 3 == 7 && 8 % 3 == 2;
}

test compound(): bool {
    let v: i32 = 10;
    v /= 2;
    v -= 3;
    v += 6;
    v *= 2;
    v %= 13;
    return v == 3;
}