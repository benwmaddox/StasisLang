import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";
import "../src/gfx_cmd.stasis";
import "../src/host_frame.stasis";

// Input pointers sample: draws a crosshair at each active pointer (mouse + touch).
// Uses HostFrame snapshot data (bulk host mode).

const TARGET_FPS: i32 = 60;
const FRAME_TIME_MS: i32 = 16;

function draw_cross(x: f32, y: f32, r: f32, g: f32, b: f32): void {
    let half: f32 = 6.0;
    gfx_cmd_line(x - half, y, x + half, y, r, g, b, 1.0);
    gfx_cmd_line(x, y - half, x, y + half, r, g, b, 1.0);
}

function draw_viewport_outline(): void {
    let vx_i: i32 = host_viewport_x_px();
    let vy_i: i32 = host_viewport_y_px();
    let vw_i: i32 = host_viewport_w_px();
    let vh_i: i32 = host_viewport_h_px();

    let vx: f32 = vx_i;
    let vy: f32 = vy_i;
    let vw: f32 = vw_i;
    let vh: f32 = vh_i;

    let x0: f32 = vx;
    let y0: f32 = vy;
    let x1: f32 = vx + vw;
    let y1: f32 = vy + vh;

    gfx_cmd_line(x0, y0, x1, y0, 0.25, 0.25, 0.25, 1.0);
    gfx_cmd_line(x1, y0, x1, y1, 0.25, 0.25, 0.25, 1.0);
    gfx_cmd_line(x1, y1, x0, y1, 0.25, 0.25, 0.25, 1.0);
    gfx_cmd_line(x0, y1, x0, y0, 0.25, 0.25, 0.25, 1.0);
}

function tick(): i32 {
    gfx_cmd_begin();
    gfx_cmd_clear(0.02, 0.02, 0.03, 1.0);

    draw_viewport_outline();

    let count: i32 = host_pointer_count();
    let i: i32 = 0;
    for (i = 0; i < count; i = i + 1) {
        let x: f32 = host_pointer_x_px(i);
        let y: f32 = host_pointer_y_px(i);

        let is_down: bool = host_pointer_is_down(i);
        let went_down: bool = host_pointer_went_down(i);
        let went_up: bool = host_pointer_went_up(i);

        let r: f32 = 0.2;
        let g: f32 = 0.8;
        let b: f32 = 1.0;

        if (is_down) {
            r = 1.0;
            g = 0.9;
            b = 0.2;
        }
        if (went_down) {
            r = 0.2;
            g = 1.0;
            b = 0.2;
        }
        if (went_up) {
            r = 1.0;
            g = 0.2;
            b = 0.2;
        }

        draw_cross(x, y, r, g, b);
    }

    gfx_cmd_mark_present();
    return 0;
}

function main(): i32 {
    let ok: bool = init_window(800, 600, "Stasis Input Pointers");
    if (!ok) {
        return 1;
    }

    return 0;
}
