import "../src/stdlib/stdlib.stasis";
import "../src/stdlib/graphics.stasis";

// Input pointers sample: draws a crosshair at each active pointer (mouse + touch).
// Uses the input snapshot builtins:
// - input_pointer_count() -> i32
// - input_pointer_* (idx: i32) queries for state/pos.
// - input_viewport_*_px() -> i32 for viewport debugging.

const TARGET_FPS: i32 = 60;
const FRAME_TIME_MS: i32 = 16;

function draw_cross(x: f32, y: f32, r: f32, g: f32, b: f32): void {
    let half: f32 = 6.0;
    draw_line(x - half, y, x + half, y, r, g, b, 1.0);
    draw_line(x, y - half, x, y + half, r, g, b, 1.0);
}

function draw_viewport_outline(): void {
    let vx_i: i32 = input_viewport_x_px();
    let vy_i: i32 = input_viewport_y_px();
    let vw_i: i32 = input_viewport_w_px();
    let vh_i: i32 = input_viewport_h_px();

    let vx: f32 = vx_i;
    let vy: f32 = vy_i;
    let vw: f32 = vw_i;
    let vh: f32 = vh_i;

    let x0: f32 = vx;
    let y0: f32 = vy;
    let x1: f32 = vx + vw;
    let y1: f32 = vy + vh;

    draw_line(x0, y0, x1, y0, 0.25, 0.25, 0.25, 1.0);
    draw_line(x1, y0, x1, y1, 0.25, 0.25, 0.25, 1.0);
    draw_line(x1, y1, x0, y1, 0.25, 0.25, 0.25, 1.0);
    draw_line(x0, y1, x0, y0, 0.25, 0.25, 0.25, 1.0);
}

function main(): i32 {
    let ok: bool = init_window(800, 600, "Stasis Input Pointers");
    if (!ok) {
        return 1;
    }

    let running: i32 = 1;
    let frame: i32 = 0;
    for (frame = 0; running == 1; frame = frame + 1) {
        let quit: bool = should_quit();
        if (quit) {
            running = 0;
        }

        if (running == 1) {
            begin_frame();
            clear(0.02, 0.02, 0.03, 1.0);

            draw_viewport_outline();

            let count: i32 = input_pointer_count();
            let i: i32 = 0;
            for (i = 0; i < count; i = i + 1) {
                let x: f32 = input_pointer_x_px(i);
                let y: f32 = input_pointer_y_px(i);

                let is_down: bool = input_pointer_is_down(i);
                let went_down: bool = input_pointer_went_down(i);
                let went_up: bool = input_pointer_went_up(i);

                let r: f32 = 0.2;
                let g: f32 = 0.8;
                let b: f32 = 1.0;

                if (is_down) {
                    r = 1.0;
                    g = 0.9;
                    b = 0.2;
                }
                if (went_down) {
                    r = 0.2;
                    g = 1.0;
                    b = 0.2;
                }
                if (went_up) {
                    r = 1.0;
                    g = 0.2;
                    b = 0.2;
                }

                draw_cross(x, y, r, g, b);
            }

            end_frame();

            sleep_ms(FRAME_TIME_MS);
        }
    }

    return 0;
}
