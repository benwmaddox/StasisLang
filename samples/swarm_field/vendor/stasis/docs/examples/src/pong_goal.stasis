struct PongSettings {
    court_left: i32 = 0;
    court_right: i32 = 100;
}

struct PongState {
    settings: PongSettings;
    ball_x: i32;
    ball_dx: i32;
    left_score: i32;
    right_score: i32;
}

global pong: PongState;

function court_center(): i32 {
    return(pong.settings.court_left + pong.settings.court_right) / 2;
}

function reset_pong(): void {
    pong.ball_x = court_center();
    pong.ball_dx = 1;
    pong.left_score = 0;
    pong.right_score = 0;
}

function main(): i32 {
    reset_pong();
    return 0;
}

function tick(): i32 {
    pong.ball_x += pong.ball_dx;
    if (pong.ball_x < pong.settings.court_left) {
        pong.right_score += 1;
        pong.ball_x = court_center();
        pong.ball_dx = 1;
    } else if (pong.ball_x > pong.settings.court_right) {
        pong.left_score += 1;
        pong.ball_x = court_center();
        pong.ball_dx = -1;
    }
    return 0;
}

function render(): i32 {
    return 0;
}
