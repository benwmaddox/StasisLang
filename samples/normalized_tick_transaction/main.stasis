global enemies: i32[6];
global enemy_count: i32;
global enemy_remove: i32[6];
global enemy_remove_count: i32;
global enemy_spawn: i32[6];
global enemy_spawn_count: i32;
global effects: i32[4];
global effect_count: i32;
global effect_remove: i32[4];
global effect_remove_count: i32;
global effect_spawn: i32[4];
global effect_spawn_count: i32;
global target_index: i32;
global pending_events: i32[4];
global pending_event_count: i32;
global committed_events: i32[4];
global committed_event_count: i32;
global stage_trace: i32;
global accepted_tick: i32;
global force_reject: i32;

function main(): i32 {
    enemies[0] = 10;
    enemies[1] = 20;
    enemies[2] = 30;
    enemies[3] = 40;
    enemy_count = 4;
    effects[0] = 7;
    effects[1] = 8;
    effect_count = 2;
    target_index = 2;
    pending_event_count = 0;
    committed_event_count = 0;
    stage_trace = 0;
    accepted_tick = 0;
    force_reject = 0;
    return 0;
}

function tick(): i32 {
    stage_trace = 1;
    enemy_remove[0] = 3;
    enemy_remove[1] = 1;
    enemy_remove_count = 2;
    enemy_spawn[0] = 50;
    enemy_spawn[1] = 60;
    enemy_spawn_count = 2;
    effect_remove[0] = 0;
    effect_remove_count = 1;
    effect_spawn[0] = 9;
    effect_spawn_count = 1;
    pending_events[0] = 101;
    pending_events[1] = 202;
    pending_event_count = 2;
    return 0;
}

function commit_tick(): i32 {
    // Enemies are the first declared pool and therefore commit first.
    for (let i: i32 = 0; i < enemy_remove_count; i += 1) {
        if (enemy_remove[i] < 0 || enemy_remove[i] >= enemy_count) { return 11; }
        for (let j: i32 = i + 1; j < enemy_remove_count; j += 1) {
            if (enemy_remove[i] == enemy_remove[j]) { return 12; }
        }
    }
    if (enemy_count - enemy_remove_count + enemy_spawn_count > 6) { return 13; }

    let repaired_target: i32 = -1;
    let write: i32 = 0;
    for (let read: i32 = 0; read < enemy_count; read += 1) {
        let removed: i32 = 0;
        for (let r: i32 = 0; r < enemy_remove_count; r += 1) {
            if (enemy_remove[r] == read) { removed = 1; }
        }
        if (removed == 0) {
            enemies[write] = enemies[read];
            if (read == target_index) { repaired_target = write; }
            write += 1;
        }
    }
    for (let s: i32 = 0; s < enemy_spawn_count; s += 1) {
        enemies[write] = enemy_spawn[s];
        write += 1;
    }
    enemy_count = write;
    target_index = repaired_target;
    enemy_remove_count = 0;
    enemy_spawn_count = 0;
    stage_trace = stage_trace * 10 + 2;

    // Effects are the second declared pool and commit after enemies.
    for (let i: i32 = 0; i < effect_remove_count; i += 1) {
        if (effect_remove[i] < 0 || effect_remove[i] >= effect_count) { return 21; }
        for (let j: i32 = i + 1; j < effect_remove_count; j += 1) {
            if (effect_remove[i] == effect_remove[j]) { return 22; }
        }
    }
    if (effect_count - effect_remove_count + effect_spawn_count > 4) { return 23; }
    write = 0;
    for (let read: i32 = 0; read < effect_count; read += 1) {
        let removed: i32 = 0;
        for (let r: i32 = 0; r < effect_remove_count; r += 1) {
            if (effect_remove[r] == read) { removed = 1; }
        }
        if (removed == 0) {
            effects[write] = effects[read];
            write += 1;
        }
    }
    for (let s: i32 = 0; s < effect_spawn_count; s += 1) {
        effects[write] = effect_spawn[s];
        write += 1;
    }
    effect_count = write;
    effect_remove_count = 0;
    effect_spawn_count = 0;
    stage_trace = stage_trace * 10 + 3;

    if (committed_event_count != 0) { return 31; }
    for (let i: i32 = 0; i < pending_event_count; i += 1) {
        committed_events[i] = pending_events[i];
    }
    committed_event_count = pending_event_count;
    pending_event_count = 0;
    return 0;
}

function normalize_tick(): i32 {
    stage_trace = stage_trace * 10 + 4;
    accepted_tick += 1;
    return 0;
}

function validate_tick(): i32 {
    if (force_reject != 0) { return 41; }
    if (stage_trace != 1234) { return 42; }
    if (enemy_count != 4) { return 43; }
    if (enemies[0] != 10 || enemies[1] != 30 || enemies[2] != 50 || enemies[3] != 60) { return 44; }
    if (target_index != 1) { return 45; }
    if (effect_count != 2 || effects[0] != 8 || effects[1] != 9) { return 46; }
    if (committed_event_count != 2 || committed_events[0] != 101 || committed_events[1] != 202) { return 47; }
    return 0;
}

function render(): i32 {
    return 0;
}

function on_code_swap(): void {
    return;
}
