struct GameState {
    score: i32;
    rendered_generation: i32;
}

global state: GameState;

function main(): i32 {
    state.score = 10;
    return 0;
}

function tick(): i32 {
    state.score += 1;
    return state.score;
}

function render(): i32 {
    state.rendered_generation = 1;
    return 0;
}

function on_code_swap(): void {
    return;
}
