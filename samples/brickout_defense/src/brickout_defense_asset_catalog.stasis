struct BrickoutDefenseAssetLoader {
    current: ImageAsset;
    next_index: i32;
    failed_index: i32;
    ready: bool;
    failed: bool;
}

global brickout_defense_catalog_sprites: Sprite[BRICKOUT_DEFENSE_ASSET_COUNT];
global brickout_defense_catalog_loader: BrickoutDefenseAssetLoader;

function brickout_defense_catalog_request(index: i32): bool {
    if (index == 0) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/background_4x.png", 1320, 1100);
    }
    if (index == 1) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/paddle.png", 133, 19);
    }
    if (index == 2) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/store_wall_4x.png", 260, 260);
    }
    if (index == 3) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/store_standard_4x.png", 260, 260);
    }
    if (index == 4) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/store_rapid_4x.png", 260, 260);
    }
    if (index == 5) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/store_healer_4x.png", 260, 260);
    }
    if (index == 6) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/store_sniper_4x.png", 260, 260);
    }
    if (index == 7) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/store_rocket_4x.png", 260, 260);
    }
    if (index == 8) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/store_gold.png", 65, 65);
    }
    if (index == 9) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/store_info.png", 201, 197);
    }
    if (index == 10) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/button_upgrade.png", 80, 25);
    }
    if (index == 11) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/button_sell.png", 44, 26);
    }
    if (index == 12) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/button_cancel.png", 71, 26);
    }
    if (index == 13) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/button_next_4x.png", 524, 260);
    }
    if (index == 14) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/buttons/button_pause_4x.png", 260, 260);
    }
    if (index == 15) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/tower_selector.png", 34, 34);
    }
    if (index == 16) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/placement/tower_placer_valid_4x.png", 128, 128);
    }
    if (index == 17) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/generated_4x/placement/tower_placer_invalid_4x.png", 128, 128);
    }
    if (index == 18) {
        return brickout_defense_catalog_loader.current.load_image("assets/original/range_ring.svg", 256, 256);
