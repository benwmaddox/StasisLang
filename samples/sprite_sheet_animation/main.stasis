import ".stasis_cache/toolchain/src/stdlib/graphics.stasis";

struct SampleState {
    sheet: SpriteSheet;
}

global state: SampleState;

function main(): i32 {
    init_window(240, 240, "Sprite Sheet Animation");
    if (!state.sheet.load_sprite_sheet_from("assets/sprite_sheet_2x2.png", 2, 2, 48, 48)) {
        return 1;
    }
    return 0;
}

function tick(): i32 {
    return 0;
}

function render(): i32 {
    begin_frame();
    clear(0.04, 0.05, 0.08, 1.0);
    state.sheet.draw_frame(0, 56.0, 56.0, 255, 0);
    state.sheet.draw_frame(1, 136.0, 56.0, 255, 0);
    state.sheet.draw_frame(2, 56.0, 136.0, 255, 0);
    state.sheet.draw_frame(3, 136.0, 136.0, 255, 0);
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
