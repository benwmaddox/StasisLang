// Headless data hot-reload latency sample.
// Run with: .\stasis.bat run samples\data_hotreload_latency.stasis --backend cranelift
// Edit data/data_hotreload_latency/balance.json while running to see updates between ticks.

struct Balance {
    health: i32;
}

struct GameState {
    frame: i32;
    balance: Balance;
    last_health: i32;
}

global state: GameState;

function main(): i32 {
    print_string("initial health=");
    print_int(state.balance.health);
    print_string("\n");
    state.last_health = state.balance.health;
    return 0;
}

function tick(): i32 {
    state.frame = state.frame + 1;

    if (state.balance.health != state.last_health) {
        print_string("health changed=");
        print_int(state.balance.health);
        print_string(" frame=");
        print_int(state.frame);
        print_string("\n");
        state.last_health = state.balance.health;
    }

    // Run long enough for scripted edits.
    if (state.frame > 600) {
        return 1;
    }

    return 0;
}
