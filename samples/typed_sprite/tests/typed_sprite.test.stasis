import "../../../src/stdlib/graphics.stasis";

global tested_sprite: Sprite;
global tested_text: TextRun;

test `invalid sprite replacement preserves receiver atomically`(): bool {
    tested_sprite.width = 16;
    tested_sprite.height = 16;
    if (tested_sprite.load_sprite_from("assets/__typed_drawable_fixture.svg", 0, 48)) {
        return false;
    }
    return !tested_sprite.valid() && tested_sprite.width == 16 && tested_sprite.height == 16;
}

test `sprite release clears receiver and is idempotent`(): bool {
    tested_sprite.width = 16;
    tested_sprite.height = 16;
    tested_sprite.release();
    if (tested_sprite.valid() || tested_sprite.width != 0 || tested_sprite.height != 0) {
        return false;
    }
    tested_sprite.release();
    return !tested_sprite.valid() && tested_sprite.width == 0 && tested_sprite.height == 0;
}

test `zero sprite release remains zero`(): bool {
    tested_sprite.width = 0;
    tested_sprite.height = 0;
    tested_sprite.release();
    return !tested_sprite.valid() && tested_sprite.width == 0 && tested_sprite.height == 0;
}

test `draw ignores invalid sprite metadata`(): bool {
    tested_sprite.width = 80;
    tested_sprite.height = 48;

    begin_frame();
    tested_sprite.draw(2.0, 3.0, 190, 9);
    end_frame();
    return !tested_sprite.valid() && tested_sprite.width == 80 && tested_sprite.height == 48;
}

test `cached text draw uses its font and run handles`(): bool {
    tested_text.font = 4;
    tested_text.handle = 12;
    tested_text.width = 72.5;
    tested_text.height = 18.0;
    begin_frame();
    tested_text.draw(5.0, 6.0, 1.0, 0.8, 0.6, 0.4);
    end_frame();
    return tested_text.font == 4 && tested_text.handle == 12 && tested_text.width == 72.5 && tested_text.height == 18.0;
}

test `invalid cached text replacement preserves receiver atomically`(): bool {
    tested_text.font = 4;
    tested_text.handle = 12;
    tested_text.width = 72.5;
    tested_text.height = 18.0;
    if (tested_text.load_text_from(0, "unused")) {
        return false;
    }
    if (tested_text.font != 4 || tested_text.handle != 12) {
        return false;
    }
    return tested_text.width == 72.5 && tested_text.height == 18.0;
}
