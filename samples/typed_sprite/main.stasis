import "../../src/stdlib/graphics.stasis";

struct FixtureState {
    sprite: Sprite;
    invalid_sprite: Sprite;
    text: TextRun;
    invalid_text: TextRun;
}

global state: FixtureState;

function main(): i32 {
    state.invalid_sprite.handle = 99;
    state.invalid_sprite.width = 8;
    state.invalid_sprite.height = 8;
    if (state.invalid_sprite.load_sprite_from("assets/__typed_drawable_fixture.svg", 0, 92)) {
        return 1;
    }
    if (state.invalid_sprite.handle != 99) {
        return 2;
    }
    if (state.invalid_sprite.width != 8 || state.invalid_sprite.height != 8) {
        return 3;
    }

    state.invalid_text.font = 9;
    state.invalid_text.handle = 12;
    state.invalid_text.width = 40.0;
    state.invalid_text.height = 18.0;
    if (state.invalid_text.load_text_from(0, "unused")) {
        return 4;
    }
    if (state.invalid_text.font != 9 || state.invalid_text.handle != 12) {
        return 5;
    }
    if (state.invalid_text.width != 40.0 || state.invalid_text.height != 18.0) {
        return 6;
    }

    state.sprite.handle = 41;
    state.sprite.width = 136;
    state.sprite.height = 92;

    state.sprite.release();
    if (state.sprite.handle != 0 || state.sprite.width != 0 || state.sprite.height != 0) {
        return 7;
    }
    state.sprite.handle = 41;
    state.sprite.width = 136;
    state.sprite.height = 92;

    begin_frame();
    state.sprite.draw(12.5, 23.5, 211, 17);

    state.text.font = 3;
    state.text.handle = 8;
    state.text.width = 91.5;
    state.text.height = 24.0;
    state.text.draw(31.0, 42.0, 0.9, 0.8, 0.7, 0.6);

    end_frame();
    return 0;
}
