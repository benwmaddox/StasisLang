import "../../src/stdlib/graphics.stasis";

struct FixtureState {
    sprite: Sprite;
    invalid_sprite: Sprite;
    text: TextRun;
    invalid_text: TextRun;
}

global state: FixtureState;

function main(): i32 {
    state.invalid_sprite.handle = 99;
    state.invalid_sprite.width = 8;
    state.invalid_sprite.height = 8;
    if (state.invalid_sprite.load_sprite_from("assets/__typed_drawable_fixture.svg", 0, 92)) {
        return 1;
    }
    if (state.invalid_sprite.handle != 99) {
        return 2;
    }
    if (state.invalid_sprite.width != 8 || state.invalid_sprite.height != 8) {
        return 3;
    }

    state.invalid_text.font = 9;
    state.invalid_text.handle = 12;
    state.invalid_text.width = 40.0;
    state.invalid_text.height = 18.0;
    if (state.invalid_text.load_text_from(0, "unused")) {
        return 4;
    }
    if (state.invalid_text.font != 9 || state.invalid_text.handle != 12) {
        return 5;
    }
    if (state.invalid_text.width != 40.0 || state.invalid_text.height != 18.0) {
        return 6;
    }

    state.sprite.handle = 41;
    state.sprite.width = 136;
    state.sprite.height = 92;

    gfx_cmd_begin();
    state.sprite.draw(12.5, 23.5, 211, 17);

    state.text.font = 3;
    state.text.handle = 8;
    state.text.width = 91.5;
    state.text.height = 24.0;
    state.text.draw(31.0, 42.0, 0.9, 0.8, 0.7, 0.6);

    if (gfx_cmd_sprite_count() != 1) {
        return 7;
    }
    if (gfx_cmd_i32[GFX_I_SPRITE_BASE + 0] != 41) {
        return 8;
    }
    if (gfx_cmd_i32[GFX_I_SPRITE_BASE + 1] != 17) {
        return 9;
    }
    if (gfx_cmd_i32[GFX_I_SPRITE_BASE + 2] != 211) {
        return 10;
    }
    if (gfx_cmd_f32[GFX_F_SPRITE_BASE + 0] != 12.5) {
        return 11;
    }
    if (gfx_cmd_f32[GFX_F_SPRITE_BASE + 1] != 23.5) {
        return 12;
    }
    if (gfx_cmd_f32[GFX_F_SPRITE_BASE + 2] != 136.0) {
        return 13;
    }
    if (gfx_cmd_f32[GFX_F_SPRITE_BASE + 3] != 92.0) {
        return 14;
    }
    if (gfx_cmd_text_count() != 1) {
        return 15;
    }
    if (gfx_cmd_i32[GFX_I_TEXT_BASE + 0] != 3) {
        return 16;
    }
    if (gfx_cmd_i32[GFX_I_TEXT_BASE + 1] != 0 - 8) {
        return 17;
    }
    if (gfx_cmd_f32[GFX_F_TEXT_BASE + 0] != 31.0) {
        return 18;
    }
    if (gfx_cmd_f32[GFX_F_TEXT_BASE + 1] != 42.0) {
        return 19;
    }
    if (gfx_cmd_f32[GFX_F_TEXT_BASE + 2] != 0.9) {
        return 20;
    }
    if (gfx_cmd_f32[GFX_F_TEXT_BASE + 5] != 0.6) {
        return 21;
    }
    return 0;
}
