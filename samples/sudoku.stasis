    print_char(82); print_char(111); print_char(119); print_char(32); print_char(97); print_char(110); print_char(100); print_char(32); print_char(99); print_char(111); print_char(108); print_char(32); print_char(109); print_char(117); print_char(115); print_char(116); print_char(32); print_char(98); print_char(101); print_char(32); print_char(49); print_char(45); print_char(57); print_char(59); print_char(32);
    print_char(118); print_char(97); print_char(108); print_char(117); print_char(101); print_char(32); print_char(109); print_char(117); print_char(115); print_char(116); print_char(32); print_char(98); print_char(101); print_char(32); print_char(48); print_char(45); print_char(57); print_char(32); print_char(40); print_char(48); print_char(32); print_char(99); print_char(108); print_char(101); print_char(97); print_char(114); print_char(115); print_char(41); print_char(46); print_char(10);
