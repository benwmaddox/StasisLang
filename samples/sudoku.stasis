function idx(r: i32, c: i32): i32 {
    return r.*(9).+(c);
}

global puzzle: i32[81];
global grid: i32[81];
global clues: i32[81];

function seed_puzzle(): void {
    let i: i32;
    for i.=(0); i.<(81); i.=(i.+(1)) {
        puzzle[i].=(0);
    }

    puzzle[idx(0, 0)].=(5); puzzle[idx(0, 1)].=(3); puzzle[idx(0, 2)].=(4); puzzle[idx(0, 3)].=(6); puzzle[idx(0, 4)].=(7); puzzle[idx(0, 7)].=(1);
    puzzle[idx(1, 0)].=(6); puzzle[idx(1, 1)].=(7); puzzle[idx(1, 2)].=(2); puzzle[idx(1, 3)].=(1); puzzle[idx(1, 4)].=(9); puzzle[idx(1, 5)].=(5); puzzle[idx(1, 6)].=(3);
    puzzle[idx(2, 0)].=(1); puzzle[idx(2, 1)].=(9); puzzle[idx(2, 2)].=(8); puzzle[idx(2, 3)].=(3); puzzle[idx(2, 5)].=(2); puzzle[idx(2, 7)].=(6);

    puzzle[idx(3, 0)].=(8); puzzle[idx(3, 1)].=(5); puzzle[idx(3, 4)].=(6); puzzle[idx(3, 8)].=(3);
    puzzle[idx(4, 0)].=(4); puzzle[idx(4, 1)].=(2); puzzle[idx(4, 2)].=(6); puzzle[idx(4, 3)].=(8); puzzle[idx(4, 5)].=(3); puzzle[idx(4, 6)].=(7); puzzle[idx(4, 8)].=(1);
    puzzle[idx(5, 0)].=(7); puzzle[idx(5, 1)].=(1); puzzle[idx(5, 2)].=(3); puzzle[idx(5, 4)].=(2); puzzle[idx(5, 5)].=(4); puzzle[idx(5, 8)].=(6);

    puzzle[idx(6, 0)].=(9); puzzle[idx(6, 1)].=(6); puzzle[idx(6, 3)].=(5); puzzle[idx(6, 5)].=(7); puzzle[idx(6, 6)].=(2); puzzle[idx(6, 7)].=(8);
    puzzle[idx(7, 1)].=(8); puzzle[idx(7, 3)].=(4); puzzle[idx(7, 4)].=(1); puzzle[idx(7, 5)].=(9); puzzle[idx(7, 6)].=(6); puzzle[idx(7, 7)].=(3); puzzle[idx(7, 8)].=(5);
    puzzle[idx(8, 0)].=(3); puzzle[idx(8, 2)].=(5); puzzle[idx(8, 4)].=(8); puzzle[idx(8, 7)].=(7); puzzle[idx(8, 8)].=(9);
}

function reset_grid(): void {
    let i: i32;
    for i.=(0); i.<(81); i.=(i.+(1)) {
        grid[i].=(puzzle[i]);
        if (puzzle[i].==(0)) {
            clues[i].=(0);
        } else {
            clues[i].=(1);
        }
    }
}

function row_ok(r: i32, val: i32): bool {
    let c: i32;
    for c.=(0); c.<(9); c.=(c.+(1)) {
        if (grid[idx(r, c)].==(val)) {
            return false;
        }
    }

    return true;
}

function col_ok(c: i32, val: i32): bool {
    let r: i32;
    for r.=(0); r.<(9); r.=(r.+(1)) {
        if (grid[idx(r, c)].==(val)) {
            return false;
        }
    }

    return true;
}

function box_ok(r: i32, c: i32, val: i32): bool {
    let br: i32;
    let bc: i32;
    let rr: i32;
    let cc: i32;
    br.=(r./(3).*(3));
    bc.=(c./(3).*(3));
    for rr.=(0); rr.<(3); rr.=(rr.+(1)) {
        for cc.=(0); cc.<(3); cc.=(cc.+(1)) {
            if (grid[idx(br.+(rr), bc.+(cc))].==(val)) {
                return false;
            }
        }
    }

    return true;
}

function can_place(r: i32, c: i32, val: i32): bool {
    if (!row_ok(r, val)) {
        return false;
    }
    if (!col_ok(c, val)) {
        return false;
    }
    if (!box_ok(r, c, val)) {
        return false;
    }
    return true;
}

function solve_at(pos: i32): bool {
    if (pos.==(81)) {
        return true;
    }

    let r: i32;
    let c: i32;
    r.=(pos./(9));
    c.=(pos.-(r.*(9)));

    if (!grid[idx(r, c)].==(0)) {
        return solve_at(pos.+(1));
    }

    let val: i32;
    for val.=(1); val.<(10); val.=(val.+(1)) {
        if (can_place(r, c, val)) {
            grid[idx(r, c)].=(val);
            if (solve_at(pos.+(1))) {
                return true;
            }
            grid[idx(r, c)].=(0);
        }
    }

    return false;
}

function solve(): bool {
    seed_puzzle();
    reset_grid();
    return solve_at(0);
}

test `sudoku solves seed`() : bool {
    if (!solve()) {
        return false;
    }
    if (!grid[idx(0, 2)].==(4)) {
        return false;
    }
    if (!grid[idx(8, 8)].==(9)) {
        return false;
    }
    return true;
}

function print_board(): void {
    print_sep_line();
    let r: i32;
    let c: i32;
    for r.=(0); r.<(9); r.=(r.+(1)) {
        print_int(r.+(1));
        print_char(32);
        print_char(124); // |
        for c.=(0); c.<(9); c.=(c.+(1)) {
            let p: i32;
            p.=(idx(r, c));
            print_cell(grid[p], clues[p]);
            if (c.==(2) || c.==(5) || c.==(8)) {
                print_char(124);
            } else {
                print_char(32);
            }
        }
        print_char(10);
        if (r.==(2) || r.==(5) || r.==(8)) {
            print_sep_line();
        }
    }
}

function is_complete(): bool {
    let i: i32;
    for i.=(0); i.<(81); i.=(i.+(1)) {
        if (grid[i].==(0)) {
            return false;
        }
    }

    return true;
}

function print_sep_line(): void {
    let i: i32;
    print_char(32); print_char(32); print_char(43); // indent + +
    for i.=(0); i.<(8); i.=(i.+(1)) { print_char(45); }
    print_char(43);
    for i.=(0); i.<(8); i.=(i.+(1)) { print_char(45); }
    print_char(43);
    for i.=(0); i.<(8); i.=(i.+(1)) { print_char(45); }
    print_char(43);
    print_char(10);
}

function print_col_header(): void {
    print_char(32); print_char(32);
    let c: i32;
    for c.=(0); c.<(9); c.=(c.+(1)) {
        print_int(c.+(1));
        print_char(32);
        if (c.==(2) || c.==(5)) {
            print_char(32);
        }
    }
    print_char(10);
}

function play(): i32 {
    seed_puzzle();
    reset_grid();

    for ;; {
        print_col_header();
        print_board();
        if (is_complete()) {
            print_solved();
            return 0;
        }

        print_prompt();
        let cmd: i32;
        cmd.=(read_cmd());
        if (cmd.==(0)) {
            return 0;
        }
        if (cmd.==(113) || cmd.==(81)) { // q or Q
            return 0;
        }
        let r: i32;
        let c: i32;
        let v: i32;
        let invalid_first: bool;
        invalid_first.=(false);
        if (!(cmd.>(47) && cmd.<(58))) {
            invalid_first.=(true);
            discard_line();
            r.=(0); c.=(0); v.=(0);
        } else {
            r.=(cmd.-(48));
            c.=(read_int());
            v.=(read_int());
        }

        let bad: bool;
        bad.=(false);
        if (r.<(1)) { bad.=(true); }
        if (r.>(9)) { bad.=(true); }
        if (c.<(1)) { bad.=(true); }
        if (c.>(9)) { bad.=(true); }
        if (v.<(0)) { bad.=(true); }
        if (v.>(9)) { bad.=(true); }

        if (invalid_first || bad) {
            print_invalid();
        } else {
            let rr: i32;
            let cc: i32;
            rr.=(r.-(1));
            cc.=(c.-(1));
            let pos: i32;
            pos.=(idx(rr, cc));
            if (clues[pos].==(1)) {
                print_clue_error();
            } else {
                if (v.==(0)) {
                    grid[pos].=(0);
                } else {
                    if (!can_place(rr, cc, v)) {
                        print_invalid();
                    } else {
                        grid[pos].=(v);
                    }
                }
                if (is_complete()) {
                    print_solved();
                    return 0;
                }
            }
        }
    }

    return 1;
}

function main(): i32 {
    return play();
}

function discard_line(): void {
    let ch: i32;
    for ;; {
        ch.=(read_char());
        if (ch.==(10) || ch.==(13) || ch.==(0)) {
            return;
        }
    }
    return;
}

function read_cmd(): i32 {
    let ch: i32;
    for ;; {
        ch.=(read_char());
        if (ch.==(0)) {
            return 0;
        }
        if (ch.==(32) || ch.==(9) || ch.==(10) || ch.==(13)) {
            // skip whitespace
        } else {
            return ch;
        }
    }

    return 0;
}




