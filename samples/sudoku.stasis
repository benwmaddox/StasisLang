    print_char(73); print_char(110); print_char(118); print_char(97); print_char(108); print_char(105); print_char(100); print_char(32); print_char(105); print_char(110); print_char(112); print_char(117); print_char(116); print_char(46); print_char(32);
    print_char(85); print_char(115); print_char(101); print_char(32); print_char(114); print_char(111); print_char(119); print_char(32); print_char(99); print_char(111); print_char(108); print_char(32); print_char(118); print_char(97); print_char(108); print_char(117); print_char(101); print_char(32); print_char(108); print_char(105); print_char(107); print_char(101); print_char(32); print_char(34); print_char(50); print_char(32); print_char(49); print_char(32); print_char(51); print_char(34); print_char(46); print_char(10);
}

