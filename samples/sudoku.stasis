function idx(r: i32, c: i32): i32 {
    return r * 9 + c;
}

global puzzle: i32[81];
global grid: i32[81];
global clues: i32[81];
global base_solution: i32[81];
global working_solution: i32[81];
global base_solution_ready: bool;
global random_state: i32;

function seed_puzzle(): void {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        puzzle[i] = 0;
    }

    puzzle[idx(0, 0)] = 5; puzzle[idx(0, 1)] = 3; puzzle[idx(0, 2)] = 4; puzzle[idx(0, 3)] = 6; puzzle[idx(0, 4)] = 7; puzzle[idx(0, 7)] = 1;
    puzzle[idx(1, 0)] = 6; puzzle[idx(1, 1)] = 7; puzzle[idx(1, 2)] = 2; puzzle[idx(1, 3)] = 1; puzzle[idx(1, 4)] = 9; puzzle[idx(1, 5)] = 5; puzzle[idx(1, 6)] = 3;
    puzzle[idx(2, 0)] = 1; puzzle[idx(2, 1)] = 9; puzzle[idx(2, 2)] = 8; puzzle[idx(2, 3)] = 3; puzzle[idx(2, 5)] = 2; puzzle[idx(2, 7)] = 6;

    puzzle[idx(3, 0)] = 8; puzzle[idx(3, 1)] = 5; puzzle[idx(3, 4)] = 6; puzzle[idx(3, 8)] = 3;
    puzzle[idx(4, 0)] = 4; puzzle[idx(4, 1)] = 2; puzzle[idx(4, 2)] = 6; puzzle[idx(4, 3)] = 8; puzzle[idx(4, 5)] = 3; puzzle[idx(4, 6)] = 7; puzzle[idx(4, 8)] = 1;
    puzzle[idx(5, 0)] = 7; puzzle[idx(5, 1)] = 1; puzzle[idx(5, 2)] = 3; puzzle[idx(5, 4)] = 2; puzzle[idx(5, 5)] = 4; puzzle[idx(5, 8)] = 6;

    puzzle[idx(6, 0)] = 9; puzzle[idx(6, 1)] = 6; puzzle[idx(6, 3)] = 5; puzzle[idx(6, 5)] = 7; puzzle[idx(6, 6)] = 2; puzzle[idx(6, 7)] = 8;
    puzzle[idx(7, 1)] = 8; puzzle[idx(7, 3)] = 4; puzzle[idx(7, 4)] = 1; puzzle[idx(7, 5)] = 9; puzzle[idx(7, 6)] = 6; puzzle[idx(7, 7)] = 3; puzzle[idx(7, 8)] = 5;
    puzzle[idx(8, 0)] = 3; puzzle[idx(8, 2)] = 5; puzzle[idx(8, 4)] = 8; puzzle[idx(8, 7)] = 7; puzzle[idx(8, 8)] = 9;
}

function reset_grid(): void {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        grid[i] = puzzle[i];
        if (puzzle[i] == 0) {
            clues[i] = 0;
        } else {
            clues[i] = 1;
        }
    }
}

function row_ok(r: i32, val: i32): bool {
    let c: i32;
    for c = 0; c < 9; c = c + 1 {
        if (grid[idx(r, c)] == val) {
            return false;
        }
    }

    return true;
}

function col_ok(c: i32, val: i32): bool {
    let r: i32;
    for r = 0; r < 9; r = r + 1 {
        if (grid[idx(r, c)] == val) {
            return false;
        }
    }

    return true;
}

function box_ok(r: i32, c: i32, val: i32): bool {
    let br: i32;
    let bc: i32;
    let rr: i32;
    let cc: i32;
    br = r / 3 * 3;
    bc = c / 3 * 3;
    for rr = 0; rr < 3; rr = rr + 1 {
        for cc = 0; cc < 3; cc = cc + 1 {
            if (grid[idx(br + rr, bc + cc)] == val) {
                return false;
            }
        }
    }

    return true;
}

function can_place(r: i32, c: i32, val: i32): bool {
    if (!row_ok(r, val)) {
        return false;
    }
    if (!col_ok(c, val)) {
        return false;
    }
    if (!box_ok(r, c, val)) {
        return false;
    }
    return true;
}

function solve_at(pos: i32): bool {
    if (pos == 81) {
        return true;
    }

    let r: i32;
    let c: i32;
    r = pos / 9;
    c = pos - r * 9;

    if (!grid[idx(r, c)] == 0) {
        return solve_at(pos + 1);
    }

    let val: i32;
    for val = 1; val < 10; val = val + 1 {
        if (can_place(r, c, val)) {
            grid[idx(r, c)] = val;
            if (solve_at(pos + 1)) {
                return true;
            }
            grid[idx(r, c)] = 0;
        }
    }

    return false;
}

function solve(): bool {
    seed_puzzle();
    reset_grid();
    return solve_at(0);
}

test `sudoku solves seed`() : bool {
    if (!solve()) {
        return false;
    }
    if (!grid[idx(0, 2)] == 4) {
        return false;
    }
    if (!grid[idx(8, 8)] == 9) {
        return false;
    }
    return true;
}

test `random puzzle reproducible`() : bool {
    generate_random_puzzle(42);
    let first: i32;
    first = puzzle[0];
    generate_random_puzzle(42);
    return first == puzzle[0];
}

test `random puzzle has enough clues`() : bool {
    generate_random_puzzle(73);
    return count_clues() >= 36;
}

test `line_is_quit detects q`() : bool {
    input_buf[0] = 113; // 'q'
    return line_is_quit(1);
}

test `line_is_quit detects Q`() : bool {
    input_buf[0] = 81; // 'Q'
    return line_is_quit(1);
}

test `line_is_quit ignores digits`() : bool {
    input_buf[0] = 52; // '4'
    return !line_is_quit(1);
}

test `line_is_quit skips bom`() : bool {
    input_buf[0] = 239; // UTF-8 BOM start
    input_buf[1] = 187;
    input_buf[2] = 191;
    input_buf[3] = 113; // 'q'
    return line_is_quit(4);
}

test `parse_move extracts row col val`() : bool {
    // "2 3 4"
    input_buf[0] = 50; // '2'
    input_buf[1] = 32;
    input_buf[2] = 51; // '3'
    input_buf[3] = 32;
    input_buf[4] = 52; // '4'
    parse_next = 0;
    parse_tmp = 0;
    parse_row = 0;
    parse_col = 0;
    parse_val = 0;
    let ok: bool;
    ok = parse_move(5);
    if (!ok) { return false; }
    if (!parse_row == 2) { return false; }
    if (!parse_col == 3) { return false; }
    if (!parse_val == 4) { return false; }
    return true;
}

function print_board(): void {
    print_sep_line();
    let r: i32;
    let c: i32;
    for r = 0; r < 9; r = r + 1 {
        print_int(r + 1);
        print_char(32);
        print_char(124); // |
        for c = 0; c < 9; c = c + 1 {
            let p: i32;
            p = idx(r, c);
            print_cell(grid[p], clues[p]);
            if (c == 2 || c == 5 || c == 8) {
                print_char(124);
            } else {
                print_char(32);
            }
        }
        print_char(10);
        if (r == 2 || r == 5 || r == 8) {
            print_sep_line();
        }
    }
}

function is_complete(): bool {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        if (grid[i] == 0) {
            return false;
        }
    }

    return true;
}

function print_sep_line(): void {
    print_string("  +--------+--------+--------+");
    print_char(10);
}

function print_col_header(): void {
    print_string("  1 2 3  4 5 6  7 8 9");
    print_char(10);
}

function play(): i32 {
    let seed: i32;
    seed = prompt_seed();
    generate_random_puzzle(seed);

    let game_loop: i32;
    for game_loop = 0; game_loop < 1; game_loop = game_loop {
        let skip: bool;
        skip = false;

        print_col_header();
        print_board();
        if (is_complete()) {
            sudoku_print_solved();
            return 0;
        }

        sudoku_print_prompt();
        let line_len: i32;
        line_len = read_line();
        if (line_len == 0) {
            return 0;
        }
        if (line_is_quit(line_len)) {
            return 0;
        }

        let first_idx: i32;
        first_idx = first_non_space_index(line_len);
        if (!skip) {
            if (first_idx == -1) {
                sudoku_print_parse_error();
                skip = true;
            } else {
                let ch: i32;
                ch = input_buf[first_idx];
                if (ch < 48 || ch > 57) {
                    sudoku_print_parse_error();
                    skip = true;
                }
            }
        }

        let parsed: bool;
        parsed = false;
        if (!skip) {
            parsed = parse_move(line_len);
            if (!parsed) {
                sudoku_print_parse_error();
                skip = true;
            }
        }

        let r: i32;
        let c: i32;
        let v: i32;
        if (!skip) {
            r = parse_row;
            c = parse_col;
            v = parse_val;
        } else {
            r = 0; c = 0; v = 0;
        }

        let bad: bool;
        bad = false;
        if (!skip) {
            if (r < 1 || r > 9) { bad = true; }
            if (c < 1 || c > 9) { bad = true; }
            if (v < 0 || v > 9) { bad = true; }

            if (bad) {
                sudoku_print_range_error();
                skip = true;
            }
        }

        let rr: i32;
        let cc: i32;
        rr = r - 1;
        cc = c - 1;
        let pos: i32;
        pos = idx(rr, cc);
        if (!skip) {
            if (clues[pos] == 1) {
                sudoku_print_clue_error();
                skip = true;
            }
        }

        if (!skip) {
            if (v == 0) {
                grid[pos] = 0;
            } else {
                if (!can_place(rr, cc, v)) {
                    sudoku_print_conflict();
                } else {
                    grid[pos] = v;
                }
            }
        }

        if (!skip) {
            if (is_complete()) {
                sudoku_print_solved();
                return 0;
            }
        }
    }

    return 1;
}

function main(): i32 {
    return play();
}

global input_buf: i32[128];
global parse_row: i32;
global parse_col: i32;
global parse_val: i32;
global parse_next: i32;
global parse_tmp: i32;

function read_line(): i32 {
    let i: i32;
    let ch: i32;
    for i = 0; i < 128; i = i {
        ch = read_char();
        if (ch == 0) {
            return i;
        }
        if (ch == 10) {
            return i;
        }
        if (ch == 13) {
            let next: i32;
            next = read_char();
            return i;
        }
        if (i < 128) {
            input_buf[i] = ch;
            i = i + 1;
        } else {
            return i;
        }
    }

    return i;
}

function is_space_or_bom(ch: i32): bool {
    if (ch == 32 || ch == 9 || ch == 13) {
        return true;
    }
    if (ch == 239 || ch == 187 || ch == 191) {
        return true;
    }
    return false;
}

function first_non_space_index(len: i32): i32 {
    let i: i32;
    for i = 0; i < len; i = i + 1 {
        let ch: i32;
        ch = input_buf[i];
        if (!is_space_or_bom(ch)) {
            return i;
        }
    }
    return -1;
}

function line_is_quit(len: i32): bool {
    let i: i32;
    for i = 0; i < len; i = i + 1 {
        let ch: i32;
        ch = input_buf[i];
        if (is_space_or_bom(ch)) {
        } else {
            if (ch == 113 || ch == 81) { return true; }
            return false;
        }
    }
    return false;
}

function skip_ws(len: i32, start: i32): void {
    let k: i32;
    for k = start; k < len; k = k + 1 {
        if (!is_space_or_bom(input_buf[k])) {
            parse_next = k;
            return;
        }
    }
    parse_next = len;
    return;
}

function parse_int_token(len: i32, start: i32): bool {
    let k: i32;
    let has: bool;
    let value: i32;
    has = false;
    value = 0;
    for k = start; k < len; k = k + 1 {
        let ch: i32;
        ch = input_buf[k];
        if (ch < 48 || ch > 57) {
            parse_next = k;
            if (has) {
                parse_tmp = value;
            }
            return has;
        }
        has = true;
        value = value * 10 + (ch - 48);
    }

    parse_next = k;
    if (has) {
        parse_tmp = value;
    }
    return has;
}

function parse_move(len: i32): bool {
    let i: i32;
    i = 0;

    skip_ws(len, i);
    i = parse_next;
    if (!(i < len)) { return false; }

    let ok: bool;
    ok = parse_int_token(len, i);
    if (!ok) { return false; }
    parse_row = parse_tmp;
    i = parse_next;

    skip_ws(len, i);
    i = parse_next;
    if (!(i < len)) { return false; }

    ok = parse_int_token(len, i);
    if (!ok) { return false; }
    parse_col = parse_tmp;
    i = parse_next;

    skip_ws(len, i);
    i = parse_next;
    if (!(i < len)) { return false; }

    ok = parse_int_token(len, i);
    if (!ok) { return false; }
    parse_val = parse_tmp;
    i = parse_next;

    skip_ws(len, i);
    i = parse_next;
    if (i < len) { return false; }

    return true;
}

function prompt_seed(): i32 {
    print_string("Enter puzzle seed (blank for default): ");
    let len: i32;
    len = read_line();
    print_char(10);
    let seed: i32;
    seed = parse_seed_input(len);
    if (seed == 0) {
        seed = 1;
    }
    return seed;
}

function parse_seed_input(len: i32): i32 {
    let i: i32;
    let value: i32;
    value = 0;
    let has_digit: bool;
    has_digit = false;
    for i = 0; i < len; i = i + 1 {
        let ch: i32;
        ch = input_buf[i];
        if (ch >= 48 && ch <= 57) {
            value = value * 10 + (ch - 48);
            has_digit = true;
        }
    }
    return has_digit ? value : 0;
}

function generate_random_puzzle(seed: i32): void {
    ensure_base_solution();
    let normalized: i32;
    normalized = seed;
    if (normalized < 0) {
        normalized = -normalized;
    }
    if (normalized == 0) {
        normalized = 1;
    }
    random_state = normalized;
    copy_solution(base_solution, working_solution);
    let shift: i32;
    shift = ((normalized % 9) + 9) % 9;
    shift_solution_digits(shift);
    permute_rows();
    permute_columns();
    mask_solution();
    reset_grid();
}

function ensure_base_solution(): void {
    if (base_solution_ready) {
        return;
    }

    seed_puzzle();
    reset_grid();
    if (!solve()) {
        return;
    }

    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        base_solution[i] = grid[i];
    }

    base_solution_ready = true;
}

function copy_solution(src: i32[81], dst: i32[81]): void {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        dst[i] = src[i];
    }
}

function shift_solution_digits(shift: i32): void {
    if (shift == 0) {
        return;
    }

    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        let value: i32;
        let shifted: i32;
        value = working_solution[i];
        shifted = (value - 1 + shift) % 9;
        if (shifted < 0) {
            shifted = shifted + 9;
        }
        working_solution[i] = shifted + 1;
    }
}

function permute_rows(): void {
    let band: i32;
    for band = 0; band < 3; band = band + 1 {
        let r1: i32;
        let r2: i32;
        r1 = band * 3 + (next_random() % 3);
        r2 = band * 3 + (next_random() % 3);
        swap_rows(r1, r2);
    }
}

function swap_rows(r1: i32, r2: i32): void {
    if (r1 == r2) {
        return;
    }

    let c: i32;
    for c = 0; c < 9; c = c + 1 {
        let a: i32;
        let b: i32;
        let temp: i32;
        a = r1 * 9 + c;
        b = r2 * 9 + c;
        temp = working_solution[a];
        working_solution[a] = working_solution[b];
        working_solution[b] = temp;
    }
}

function permute_columns(): void {
    let band: i32;
    for band = 0; band < 3; band = band + 1 {
        let c1: i32;
        let c2: i32;
        c1 = band * 3 + (next_random() % 3);
        c2 = band * 3 + (next_random() % 3);
        swap_columns(c1, c2);
    }
}

function swap_columns(c1: i32, c2: i32): void {
    if (c1 == c2) {
        return;
    }

    let r: i32;
    for r = 0; r < 9; r = r + 1 {
        let a: i32;
        let b: i32;
        let temp: i32;
        a = r * 9 + c1;
        b = r * 9 + c2;
        temp = working_solution[a];
        working_solution[a] = working_solution[b];
        working_solution[b] = temp;
    }
}

function mask_solution(): void {
    let kept: i32;
    kept = 0;
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        let keep: i32;
        keep = next_random() % 100;
        if (keep < 55) {
            puzzle[i] = working_solution[i];
            clues[i] = 1;
            kept = kept + 1;
        } else {
            puzzle[i] = 0;
            clues[i] = 0;
        }
    }

    if (kept < 36) {
        for i = 0; i < 81 && kept < 36; i = i + 1 {
            if (puzzle[i] == 0) {
                puzzle[i] = working_solution[i];
                clues[i] = 1;
                kept = kept + 1;
            }
        }
    }
}

function next_random(): i32 {
    random_state = random_state * 1103515245 + 12345;
    if (random_state < 0) {
        random_state = -random_state;
    }
    return random_state;
}

function count_clues(): i32 {
    let i: i32;
    let total: i32;
    total = 0;
    for i = 0; i < 81; i = i + 1 {
        if (clues[i] == 1) {
            total = total + 1;
        }
    }
    return total;
}

function sudoku_print_prompt(): void {
    print_string("Enter row col value (0 clears, q quits): ");
}

function sudoku_print_parse_error(): void {
    print_string("Invalid input. Use row col value like 2 1 3.");
    print_char(10);
}

function sudoku_print_range_error(): void {
    print_string("Row and col must be 1-9; value must be 0-9 (0 clears).");
    print_char(10);
}

function sudoku_print_conflict(): void {
    print_string("Conflicts with row/col/box.");
    print_char(10);
}

function sudoku_print_clue_error(): void {
    print_string("Cannot change a given clue.");
    print_char(10);
}

function sudoku_print_invalid(): void {
    print_string("Invalid placement.");
    print_char(10);
}

function sudoku_print_solved(): void {
    print_string("Solved! Great job!");
    print_char(10);
}
