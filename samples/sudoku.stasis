function idx(r: i32, c: i32): i32 {
    return r * 9 + c;
}

global puzzle: i32[81];
global grid: i32[81];
global clues: i32[81];

function seed_puzzle(): void {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        puzzle[i] = 0;
    }

    puzzle[idx(0, 0)] = 5; puzzle[idx(0, 1)] = 3; puzzle[idx(0, 2)] = 4; puzzle[idx(0, 3)] = 6; puzzle[idx(0, 4)] = 7; puzzle[idx(0, 7)] = 1;
    puzzle[idx(1, 0)] = 6; puzzle[idx(1, 1)] = 7; puzzle[idx(1, 2)] = 2; puzzle[idx(1, 3)] = 1; puzzle[idx(1, 4)] = 9; puzzle[idx(1, 5)] = 5; puzzle[idx(1, 6)] = 3;
    puzzle[idx(2, 0)] = 1; puzzle[idx(2, 1)] = 9; puzzle[idx(2, 2)] = 8; puzzle[idx(2, 3)] = 3; puzzle[idx(2, 5)] = 2; puzzle[idx(2, 7)] = 6;

    puzzle[idx(3, 0)] = 8; puzzle[idx(3, 1)] = 5; puzzle[idx(3, 4)] = 6; puzzle[idx(3, 8)] = 3;
    puzzle[idx(4, 0)] = 4; puzzle[idx(4, 1)] = 2; puzzle[idx(4, 2)] = 6; puzzle[idx(4, 3)] = 8; puzzle[idx(4, 5)] = 3; puzzle[idx(4, 6)] = 7; puzzle[idx(4, 8)] = 1;
    puzzle[idx(5, 0)] = 7; puzzle[idx(5, 1)] = 1; puzzle[idx(5, 2)] = 3; puzzle[idx(5, 4)] = 2; puzzle[idx(5, 5)] = 4; puzzle[idx(5, 8)] = 6;

    puzzle[idx(6, 0)] = 9; puzzle[idx(6, 1)] = 6; puzzle[idx(6, 3)] = 5; puzzle[idx(6, 5)] = 7; puzzle[idx(6, 6)] = 2; puzzle[idx(6, 7)] = 8;
    puzzle[idx(7, 1)] = 8; puzzle[idx(7, 3)] = 4; puzzle[idx(7, 4)] = 1; puzzle[idx(7, 5)] = 9; puzzle[idx(7, 6)] = 6; puzzle[idx(7, 7)] = 3; puzzle[idx(7, 8)] = 5;
    puzzle[idx(8, 0)] = 3; puzzle[idx(8, 2)] = 5; puzzle[idx(8, 4)] = 8; puzzle[idx(8, 7)] = 7; puzzle[idx(8, 8)] = 9;
}

function reset_grid(): void {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        grid[i] = puzzle[i];
        if (puzzle[i] == 0) {
            clues[i] = 0;
        } else {
            clues[i] = 1;
        }
    }
}

function row_ok(r: i32, val: i32): bool {
    let c: i32;
    for c = 0; c < 9; c = c + 1 {
        if (grid[idx(r, c)] == val) {
            return false;
        }
    }

    return true;
}

function col_ok(c: i32, val: i32): bool {
    let r: i32;
    for r = 0; r < 9; r = r + 1 {
        if (grid[idx(r, c)] == val) {
            return false;
        }
    }

    return true;
}

function box_ok(r: i32, c: i32, val: i32): bool {
    let br: i32;
    let bc: i32;
    let rr: i32;
    let cc: i32;
    br = r / 3 * 3;
    bc = c / 3 * 3;
    for rr = 0; rr < 3; rr = rr + 1 {
        for cc = 0; cc < 3; cc = cc + 1 {
            if (grid[idx(br + rr, bc + cc)] == val) {
                return false;
            }
        }
    }

    return true;
}

function can_place(r: i32, c: i32, val: i32): bool {
    if (!row_ok(r, val)) {
        return false;
    }
    if (!col_ok(c, val)) {
        return false;
    }
    if (!box_ok(r, c, val)) {
        return false;
    }
    return true;
}

function solve_at(pos: i32): bool {
    if (pos == 81) {
        return true;
    }

    let r: i32;
    let c: i32;
    r = pos / 9;
    c = pos - r * 9;

    if (!grid[idx(r, c)] == 0) {
        return solve_at(pos + 1);
    }

    let val: i32;
    for val = 1; val < 10; val = val + 1 {
        if (can_place(r, c, val)) {
            grid[idx(r, c)] = val;
            if (solve_at(pos + 1)) {
                return true;
            }
            grid[idx(r, c)] = 0;
        }
    }

    return false;
}

function solve(): bool {
    seed_puzzle();
    reset_grid();
    return solve_at(0);
}

test `sudoku solves seed`() : bool {
    if (!solve()) {
        return false;
    }
    if (!grid[idx(0, 2)] == 4) {
        return false;
    }
    if (!grid[idx(8, 8)] == 9) {
        return false;
    }
    return true;
}

function print_board(): void {
    print_sep_line();
    let r: i32;
    let c: i32;
    for r = 0; r < 9; r = r + 1 {
        print_int(r + 1);
        print_char(32);
        print_char(124); // |
        for c = 0; c < 9; c = c + 1 {
            let p: i32;
            p = idx(r, c);
            print_cell(grid[p], clues[p]);
            if (c == 2 || c == 5 || c == 8) {
                print_char(124);
            } else {
                print_char(32);
            }
        }
        print_char(10);
        if (r == 2 || r == 5 || r == 8) {
            print_sep_line();
        }
    }
}

function is_complete(): bool {
    let i: i32;
    for i = 0; i < 81; i = i + 1 {
        if (grid[i] == 0) {
            return false;
        }
    }

    return true;
}

function print_sep_line(): void {
    let i: i32;
    print_char(32); print_char(32); print_char(43); // indent + +
    for i = 0; i < 8; i = i + 1 { print_char(45); }
    print_char(43);
    for i = 0; i < 8; i = i + 1 { print_char(45); }
    print_char(43);
    for i = 0; i < 8; i = i + 1 { print_char(45); }
    print_char(43);
    print_char(10);
}

function print_col_header(): void {
    print_char(32); print_char(32);
    let c: i32;
    for c = 0; c < 9; c = c + 1 {
        print_int(c + 1);
        print_char(32);
        if (c == 2 || c == 5) {
            print_char(32);
        }
    }
    print_char(10);
}

function play(): i32 {
    seed_puzzle();
    reset_grid();

    let game_loop: i32;
    for game_loop = 0; game_loop < 1; game_loop = game_loop {
        let skip: bool;
        skip = false;

        print_col_header();
        print_board();
        if (is_complete()) {
            sudoku_print_solved();
            return 0;
        }

        sudoku_print_prompt();
        let line_len: i32;
        line_len = read_line();
        if (line_len == 0) {
            skip = true;
        }

        let first: i32;
        if (!skip) {
            first = first_non_space(line_len);
            if (first == -1) {
                skip = true;
            } else {
                if (first == 113 || first == 81) { // q or Q
                    return 0;
                }
            }
        }

        let parsed: bool;
        parsed = false;
        if (!skip) {
            parsed = parse_move(line_len);
            if (!parsed) {
            sudoku_print_parse_error();
            skip = true;
            }
        }

        let r: i32;
        let c: i32;
        let v: i32;
        if (!skip) {
            r = parse_row;
            c = parse_col;
            v = parse_val;
        } else {
            r = 0; c = 0; v = 0;
        }

        let bad: bool;
        bad = false;
        if (!skip) {
            if (r < 1 || r > 9) { bad = true; }
            if (c < 1 || c > 9) { bad = true; }
            if (v < 0 || v > 9) { bad = true; }

            if (bad) {
                sudoku_print_range_error();
                skip = true;
            }
        }

        let rr: i32;
        let cc: i32;
        rr = r - 1;
        cc = c - 1;
        let pos: i32;
        pos = idx(rr, cc);
        if (!skip) {
            if (clues[pos] == 1) {
                sudoku_print_clue_error();
                skip = true;
            }
        }

        if (!skip) {
            if (v == 0) {
                grid[pos] = 0;
            } else {
                if (!can_place(rr, cc, v)) {
                    sudoku_print_conflict();
                } else {
                    grid[pos] = v;
                }
            }
        }

        if (!skip) {
            if (is_complete()) {
                sudoku_print_solved();
                return 0;
            }
        }
    }

    return 1;
}

function main(): i32 {
    return play();
}

global input_buf: i32[128];
global parse_row: i32;
global parse_col: i32;
global parse_val: i32;
global parse_next: i32;
global parse_tmp: i32;

function read_line(): i32 {
    let i: i32;
    let ch: i32;
    for i = 0; i < 128; i = i {
        ch = read_char();
        if (ch == 0) {
            return i;
        }
        if (ch == 10) {
            return i;
        }
        if (ch == 13) {
            let next: i32;
            next = read_char();
            return i;
        }
        if (i < 128) {
            input_buf[i] = ch;
            i = i + 1;
        } else {
            return i;
        }
    }

    return i;
}

function first_non_space(len: i32): i32 {
    let i: i32;
    for i = 0; i < len; i = i + 1 {
        let ch: i32;
        ch = input_buf[i];
        if (!(ch == 32 || ch == 9)) {
            return ch;
        }
    }
    return -1;
}

function skip_ws(len: i32, start: i32): void {
    let k: i32;
    for k = start; k < len; k = k + 1 {
        if (!(input_buf[k] == 32 || input_buf[k] == 9)) {
            parse_next = k;
            return;
        }
    }
    parse_next = len;
    return;
}

function parse_int_token(len: i32, start: i32): bool {
    let k: i32;
    let has: bool;
    let value: i32;
    has = false;
    value = 0;
    for k = start; k < len; k = k + 1 {
        let ch: i32;
        ch = input_buf[k];
        if (ch < 48 || ch > 57) {
            parse_next = k;
            if (has) {
                parse_tmp = value;
            }
            return has;
        }
        has = true;
        value = value * 10 + (ch - 48);
    }

    parse_next = k;
    if (has) {
        parse_tmp = value;
    }
    return has;
}

function parse_move(len: i32): bool {
    let i: i32;
    i = 0;

    skip_ws(len, i);
    i = parse_next;
    if (!(i < len)) { return false; }

    let ok: bool;
    ok = parse_int_token(len, i);
    if (!ok) { return false; }
    parse_row = parse_tmp;
    i = parse_next;

    skip_ws(len, i);
    i = parse_next;
    if (!(i < len)) { return false; }

    ok = parse_int_token(len, i);
    if (!ok) { return false; }
    parse_col = parse_tmp;
    i = parse_next;

    skip_ws(len, i);
    i = parse_next;
    if (!(i < len)) { return false; }

    ok = parse_int_token(len, i);
    if (!ok) { return false; }
    parse_val = parse_tmp;
    i = parse_next;

    skip_ws(len, i);
    i = parse_next;
    if (i < len) { return false; }

    return true;
}

function sudoku_print_prompt(): void {
    print_char(69); print_char(110); print_char(116); print_char(101); print_char(114); print_char(32);
    print_char(114); print_char(111); print_char(119); print_char(32); print_char(99); print_char(111); print_char(108); print_char(32); print_char(118); print_char(97); print_char(108); print_char(117); print_char(101); print_char(32); print_char(40); print_char(48); print_char(32); print_char(99); print_char(108); print_char(101); print_char(97); print_char(114); print_char(115); print_char(44); print_char(32); print_char(113); print_char(32); print_char(113); print_char(117); print_char(105); print_char(116); print_char(115); print_char(41); print_char(58); print_char(32);
}

