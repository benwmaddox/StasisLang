// Asteroids - Minimal Vector Graphics Demo
// Controls: A/D or Arrow keys to rotate, W or Up to thrust, Space to fire, Escape to quit

// External runtime APIs:
// - init_window(width: i32, height: i32, title: string) -> bool: creates the SDL window/context.
// - time() -> i64: returns unix timestamp seconds for seeding the PRNG.
// - get_time_ms() -> i32: millisecond-resolution clock used for timing logic.
// - sleep_ms(ms: i32): pauses the thread to pace the frame loop.
// - should_quit() -> bool: polls SDL events for quit requests.
// - begin_frame(), end_frame(): bracket GPU work for the graphics backend.
// - clear(r: f32, g: f32, b: f32, a: f32): clears the frame buffer.
// - draw_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32): renders debug lines.
// - is_key_down(scancode: i32) -> bool: queries the current keyboard state.

// SDL Scancodes (constants)
const KEY_W: i32 = 26;
const KEY_A: i32 = 4;
const KEY_D: i32 = 7;
const KEY_SPACE: i32 = 44;
const KEY_ESCAPE: i32 = 41;
const KEY_LEFT: i32 = 80;
const KEY_RIGHT: i32 = 79;
const KEY_UP: i32 = 82;

// Screen dimensions (constants)
const SCREEN_W: f32 = 800.0;
const SCREEN_H: f32 = 600.0;

// Limits (constants)
const MAX_ASTEROIDS: i32 = 25;
const MAX_BULLETS: i32 = 5;
const BULLET_LIFETIME_MS: i32 = 1000;
const SHIP_MAX_HP: i32 = 10;
const RESTART_DELAY_MS: i32 = 15000;
const DEATH_ANIM_MS: i32 = 1000;
const LEVEL_START_DELAY_MS: i32 = 15000;

// Math constants
const PI: f32 = 3.14159;
// Trig helpers: sin/cos keep the precise LLVM intrinsics; sin_fast/cos_fast enable fast-math for faster, less accurate gameplay math.

// FPS control
const TARGET_FPS: i32 = 60;
const FRAME_TIME_MS: i32 = 16; // 1000ms / 60fps ≈ 16.67ms

// Struct definitions
struct Ship {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    angle: f32;
}

struct Asteroid {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    size: f32;
    active: bool;
    touching_ship: bool;
}

struct Bullet {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    life: i32;
}

struct Timers {
    last_time: i32;
    frame_start_time: i32;
    fire_cooldown: i32;
    death_anim_ms: i32;
    restart_timer_ms: i32;
    level_start_timer_ms: i32;
}

struct LevelState {
    level: i32;
    next_level: i32;
    num_asteroids: i32;
}

struct GameState {
    ship: Ship;
    asteroids: Asteroid[50];
    bullets: Bullet[5];
    timers: Timers;
    level_state: LevelState;
    rng_state: i32;
    running: i32;
    ship_hp: i32;
    ship_alive: bool;
}

// Single global state struct
global state: GameState;

function seed_rng(seed: i32): void {
    state.rng_state = seed;
}

function next_rand(): i32 {
    state.rng_state = state.rng_state * 1103515245 + 12345;
    if (state.rng_state < 0) {
        state.rng_state = 0 - state.rng_state;
    }
    return state.rng_state;
}

function rand_float(max: f32): f32 {
    let r: i32 = next_rand() % 1000;
    let rf: f32 = r;
    return (rf / 1000.0) * max;
}

function init_ship(): void {
    state.ship.x = SCREEN_W / 2.0;
    state.ship.y = SCREEN_H / 2.0;
    state.ship.vx = 0.0;
    state.ship.vy = 0.0;
    state.ship.angle = 0.0;
    state.ship_hp = SHIP_MAX_HP;
    state.ship_alive = true;
    state.timers.death_anim_ms = 0;
    state.timers.restart_timer_ms = 0;
    state.level_state.level = 1;
    state.timers.level_start_timer_ms = 0;
    state.level_state.next_level = 1;
    state.timers.fire_cooldown = 0;
    state.timers.last_time = get_time_ms();
    state.timers.frame_start_time = 0;
}

function configure_level(level: i32): void {
    state.level_state.level = level;
    state.timers.level_start_timer_ms = 0;
    state.level_state.next_level = level + 1;

    // Determine asteroid count/size/speed by parity
    let count: i32 = 4;
    let size: f32 = 40.0;
    let speed_min: f32 = 0.5;
    let speed_range: f32 = 1.5; // 0.5..2.0

    if (level == 1) {
        count = 4;
        size = 40.0;
        speed_min = 0.5;
        speed_range = 1.5;
    }
    else {
        if ((level % 2) == 0) {
            // Even: bigger/slower
            count = 4 + (level / 2);
            if (count > MAX_ASTEROIDS) {
                count = MAX_ASTEROIDS;
            }
            size = 36.0;
            speed_min = 0.5;
            speed_range = 1.0; // 0.5..1.5
        } else {
            // Odd: more/smaller/faster
            count = 7 + level;
            if (count > MAX_ASTEROIDS) {
                count = MAX_ASTEROIDS;
            }
            size = 18.0;
            speed_min = 2.0;
            speed_range = 3.0; // 2..5
        }
    }

    state.level_state.num_asteroids = count;
    let i: i32 = 0;
    for (i = 0; i < MAX_ASTEROIDS; i = i + 1) {
        // Random spawn across the screen
        let spawn_x: f32 = rand_float(SCREEN_W);
        let spawn_y: f32 = rand_float(SCREEN_H);

        // Random direction and speed
        let dir_angle: f32 = rand_float(6.28318);          // 0..2pi
        let speed: f32 = speed_min + rand_float(speed_range);
        let vx: f32 = cos_fast(dir_angle) * speed;
        let vy: f32 = sin_fast(dir_angle) * speed;

        let active_now: bool = i < count;
        state.asteroids[i].active = active_now;
        if (active_now) {
            state.asteroids[i].size = size;
        } else {
            state.asteroids[i].size = 0.0;
        }
        state.asteroids[i].x = spawn_x;
        state.asteroids[i].y = spawn_y;
        state.asteroids[i].vx = vx;
        state.asteroids[i].vy = vy;
        state.asteroids[i].touching_ship = false;
    }
}

function init_bullets(): void {
    foreach (let bullet in state.bullets) {
        bullet.life = 0;
    }
}

function active_asteroid_count(): i32 {
    let i: i32 = 0;
    let count: i32 = 0;
    for (i = 0; i < MAX_ASTEROIDS; i = i + 1) {
        if (state.asteroids[i].active) {
            count = count + 1;
        }
    }
    return count;
}

function compute_delta_ms(): i32 {
    let current_time: i32 = get_time_ms();
    let delta_ms: i32 = current_time - state.timers.last_time;
    if (delta_ms < 1) {
        delta_ms = 1;
    }
    if (delta_ms > 100) {
        delta_ms = 100;
    }
    state.timers.last_time = current_time;
    return delta_ms;
}

function wrap_position(px: f32, max: f32): f32 {
    let result: f32 = px;
    if (result < 0.0) {
        result = result + max;
    }
    if (result > max) {
        result = result - max;
    }
    return result;
}

function sync_frame_rate(): void {
    // Calculate elapsed time and sleep if ahead of schedule
    let frame_end_time: i32 = get_time_ms();
    let frame_elapsed: i32 = frame_end_time - state.timers.frame_start_time;
    let sleep_time: i32 = FRAME_TIME_MS - frame_elapsed;

    // Only sleep if we have time left in the frame budget
    if (sleep_time > 0) {
        sleep_ms(sleep_time);
    }
    // If sleep_time <= 0, we're behind schedule - skip sleep and continue
}

function update_ship(dt: f32): void {
    if (!state.ship_alive) {
        return;
    }

    // Rotation (A/D or Left/Right arrows) - 5 radians/sec = ~286 degrees/sec
    if (is_key_down(KEY_A) || is_key_down(KEY_LEFT)) {
        state.ship.angle = state.ship.angle - 5.0 * dt;
    }
    if (is_key_down(KEY_D) || is_key_down(KEY_RIGHT)) {
        state.ship.angle = state.ship.angle + 5.0 * dt;
    }

    // Thrust (W or Up arrow)
    if (is_key_down(KEY_W) || is_key_down(KEY_UP)) {
        let thrust: f32 = 150.0 * dt;
        state.ship.vx = state.ship.vx + cos_fast(state.ship.angle) * thrust;
        state.ship.vy = state.ship.vy + sin_fast(state.ship.angle) * thrust;
    }

    // Apply velocity with damping
    state.ship.x = state.ship.x + state.ship.vx * dt;
    state.ship.y = state.ship.y + state.ship.vy * dt;
    state.ship.vx = state.ship.vx * 0.99;
    state.ship.vy = state.ship.vy * 0.99;

    // Wrap around screen
    state.ship.x = wrap_position(state.ship.x, SCREEN_W);
    state.ship.y = wrap_position(state.ship.y, SCREEN_H);
}

function update_asteroids(dt: f32): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ASTEROIDS; i = i + 1) {
        if (state.asteroids[i].active) {
            state.asteroids[i].x = state.asteroids[i].x + state.asteroids[i].vx * dt * 60.0;
            state.asteroids[i].y = state.asteroids[i].y + state.asteroids[i].vy * dt * 60.0;
            state.asteroids[i].x = wrap_position(state.asteroids[i].x, SCREEN_W);
            state.asteroids[i].y = wrap_position(state.asteroids[i].y, SCREEN_H);
        }
    }
}

function fire_bullet(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_BULLETS; i = i + 1) {
        if (state.bullets[i].life == 0) {
            state.bullets[i].x = state.ship.x + cos_fast(state.ship.angle) * 15.0;
            state.bullets[i].y = state.ship.y + sin_fast(state.ship.angle) * 15.0;
            state.bullets[i].vx = cos_fast(state.ship.angle) * 300.0;
            state.bullets[i].vy = sin_fast(state.ship.angle) * 300.0;
            state.bullets[i].life = BULLET_LIFETIME_MS;
            return;
        }
    }
}

function update_bullets(dt: f32, delta_ms: i32): void {
    foreach (let bullet in state.bullets) {
        if (bullet.life > 0) {
            bullet.x = bullet.x + bullet.vx * dt;
            bullet.y = bullet.y + bullet.vy * dt;
            bullet.life = bullet.life - delta_ms;
            if (bullet.life < 0) {
                bullet.life = 0;
            }

            // Wrap bullets
            bullet.x = wrap_position(bullet.x, SCREEN_W);
            bullet.y = wrap_position(bullet.y, SCREEN_H);
        }
    }
}

function abs_f32(x: f32): f32 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

function check_collisions(): void {
    let j: i32 = 0;

    // Bullet-asteroid collisions
    foreach (let bullet in state.bullets) {
        if (bullet.life > 0) {
            for (j = 0; j < MAX_ASTEROIDS; j = j + 1) {
                if (state.asteroids[j].active) {
                    let dx: f32 = bullet.x - state.asteroids[j].x;
                    let dy: f32 = bullet.y - state.asteroids[j].y;
                    let dist_sq: f32 = dx * dx + dy * dy;
                    let radius: f32 = state.asteroids[j].size;
                    if (dist_sq < radius * radius) {
                        bullet.life = 0;
                        state.asteroids[j].active = false;
                    }
                }
            }
        }
    }

    // Ship-asteroid collisions
    if (state.ship_alive) {
        let ship_radius: f32 = 12.0;
        for (j = 0; j < MAX_ASTEROIDS; j = j + 1) {
            if (state.asteroids[j].active) {
                let dx2: f32 = state.ship.x - state.asteroids[j].x;
                let dy2: f32 = state.ship.y - state.asteroids[j].y;
                let dist_sq2: f32 = dx2 * dx2 + dy2 * dy2;
                let sum_r: f32 = ship_radius + state.asteroids[j].size;
                if (dist_sq2 < sum_r * sum_r) {
                    if (!state.asteroids[j].touching_ship) {
                        state.ship_hp = state.ship_hp - 1;
                        state.asteroids[j].touching_ship = true;
                        if (state.ship_hp < 1) {
                            state.ship_hp = 0;
                            trigger_ship_death();
                        }
                    }
                } else {
                    state.asteroids[j].touching_ship = false;
                }
            }
        }
    }
}

function draw_ship(): void {
    if (!state.ship_alive) {
        return;
    }

    let c: f32 = cos_fast(state.ship.angle);
    let s: f32 = sin_fast(state.ship.angle);

    // Ship is a triangle
    let size: f32 = 12.0;

    // Nose
    let nx: f32 = state.ship.x + c * size;
    let ny: f32 = state.ship.y + s * size;

    // Left wing
    let lx: f32 = state.ship.x + cos_fast(state.ship.angle + 2.4) * size;
    let ly: f32 = state.ship.y + sin_fast(state.ship.angle + 2.4) * size;

    // Right wing
    let rx: f32 = state.ship.x + cos_fast(state.ship.angle - 2.4) * size;
    let ry: f32 = state.ship.y + sin_fast(state.ship.angle - 2.4) * size;

    // Draw white lines
    draw_line(nx, ny, lx, ly, 1.0, 1.0, 1.0, 1.0);
    draw_line(lx, ly, rx, ry, 1.0, 1.0, 1.0, 1.0);
    draw_line(rx, ry, nx, ny, 1.0, 1.0, 1.0, 1.0);

    // Draw thrust flame when thrusting
    if (is_key_down(KEY_W) || is_key_down(KEY_UP)) {
        let tx: f32 = state.ship.x - c * size * 1.5;
        let ty: f32 = state.ship.y - s * size * 1.5;
        draw_line(lx, ly, tx, ty, 1.0, 0.5, 0.0, 1.0);
        draw_line(rx, ry, tx, ty, 1.0, 0.5, 0.0, 1.0);
    }
}

function draw_health_bar(): void {
    let bar_w: f32 = 160.0;
    let bar_h: f32 = 8.0;
    let bar_x: f32 = (SCREEN_W - bar_w) * 0.5;
    let bar_y: f32 = 20.0;
    let hp_ratio_num: f32 = state.ship_hp;
    let hp_ratio_den: f32 = SHIP_MAX_HP;
    let hp_ratio: f32 = hp_ratio_num / hp_ratio_den;
    if (hp_ratio < 0.0) {
        hp_ratio = 0.0;
    }
    if (hp_ratio > 1.0) {
        hp_ratio = 1.0;
    }
    let fill_w: f32 = bar_w * hp_ratio;

    // Border
    draw_line(bar_x, bar_y, bar_x + bar_w, bar_y, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x, bar_y + bar_h, bar_x + bar_w, bar_y + bar_h, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x, bar_y, bar_x, bar_y + bar_h, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x + bar_w, bar_y, bar_x + bar_w, bar_y + bar_h, 1.0, 1.0, 1.0, 1.0);

    // Fill
    draw_line(bar_x, bar_y, bar_x + fill_w, bar_y, 0.2, 1.0, 0.2, 1.0);
    draw_line(bar_x, bar_y + bar_h, bar_x + fill_w, bar_y + bar_h, 0.2, 1.0, 0.2, 1.0);
    draw_line(bar_x, bar_y, bar_x, bar_y + bar_h, 0.2, 1.0, 0.2, 1.0);
    draw_line(bar_x + fill_w, bar_y, bar_x + fill_w, bar_y + bar_h, 0.2, 1.0, 0.2, 1.0);
}

function draw_asteroids(): void {
    let i: i32 = 0;
    for (i = 0; i < MAX_ASTEROIDS; i = i + 1) {
        if (state.asteroids[i].active) {
            let x: f32 = state.asteroids[i].x;
            let y: f32 = state.asteroids[i].y;
            let sz: f32 = state.asteroids[i].size;

            // Draw as simple octagon (8 sides)
            let j: i32 = 0;
            let first_x: f32 = x + sz;
            let first_y: f32 = y;
            let prev_x: f32 = first_x;
            let prev_y: f32 = first_y;
            let jf: f32 = 0.0;
            let angle: f32 = 0.0;
            let px: f32 = 0.0;
            let py: f32 = 0.0;

            // Calculate first point
            // (first point already computed above)

            for (j = 1; j < 9; j = j + 1) {
                jf = j;
                angle = (jf / 8.0) * 2.0 * PI;
                px = x + cos_fast(angle) * sz;
                py = y + sin_fast(angle) * sz;
                draw_line(prev_x, prev_y, px, py, 0.7, 0.7, 0.7, 1.0);
                prev_x = px;
                prev_y = py;
            }
        }
    }
}

function draw_bullets(): void {
    foreach (let bullet in state.bullets) {
        if (bullet.life > 0) {
            let x: f32 = bullet.x;
            let y: f32 = bullet.y;

            // Draw as small cross
            draw_line(x - 2.0, y, x + 2.0, y, 1.0, 1.0, 0.0, 1.0);
            draw_line(x, y - 2.0, x, y + 2.0, 1.0, 1.0, 0.0, 1.0);
        }
    }
}

function trigger_ship_death(): void {
    state.ship_alive = false;
    state.timers.death_anim_ms = DEATH_ANIM_MS;
    state.timers.restart_timer_ms = RESTART_DELAY_MS;
    state.timers.level_start_timer_ms = 0;

    // Stop bullets immediately
    foreach (let bullet in state.bullets) {
        bullet.life = 0;
    }
}

function reset_game(): void {
    init_ship();
    configure_level(1);
    init_bullets();
    state.timers.fire_cooldown = 0;
    state.timers.last_time = get_time_ms();
}

function draw_death_effect(): void {
    if (state.timers.death_anim_ms < 1) {
        return;
    }

    let remaining: f32 = state.timers.death_anim_ms;
    let death_total_ms: f32 = 1000.0;
    let t: f32 = remaining / death_total_ms;
    let burst_len: f32 = 60.0 * t;
    let rays: i32 = 12;
    let i: i32 = 0;
    for (i = 0; i < rays; i = i + 1) {
        let fi: f32 = i;
        let rays_f: f32 = rays;
        let angle: f32 = (fi / rays_f) * 6.28318;
        let dx: f32 = cos_fast(angle) * burst_len;
        let dy: f32 = sin_fast(angle) * burst_len;
        draw_line(state.ship.x, state.ship.y, state.ship.x + dx, state.ship.y + dy, 1.0, 0.3, 0.0, t);
    }
}

function draw_segment_digit(digit: i32, x: f32, y: f32, scale: f32): void {
    // 7-seg order: top, upper-right, lower-right, bottom, lower-left, upper-left, middle
    let seg0: bool = false;
    let seg1: bool = false;
    let seg2: bool = false;
    let seg3: bool = false;
    let seg4: bool = false;
    let seg5: bool = false;
    let seg6: bool = false;

    if (digit == 0) {
        seg0 = true;
        seg1 = true;
        seg2 = true;
        seg3 = true;
        seg4 = true;
        seg5 = true;
    }
    if (digit == 1) {
        seg1 = true;
        seg2 = true;
    }
    if (digit == 2) {
        seg0 = true;
        seg1 = true;
        seg6 = true;
        seg4 = true;
        seg3 = true;
    }
    if (digit == 3) {
        seg0 = true;
        seg1 = true;
        seg6 = true;
        seg2 = true;
        seg3 = true;
    }
    if (digit == 4) {
        seg5 = true;
        seg6 = true;
        seg1 = true;
        seg2 = true;
    }
    if (digit == 5) {
        seg0 = true;
        seg5 = true;
        seg6 = true;
        seg2 = true;
        seg3 = true;
    }
    if (digit == 6) {
        seg0 = true;
        seg5 = true;
        seg6 = true;
        seg2 = true;
        seg3 = true;
        seg4 = true;
    }
    if (digit == 7) {
        seg0 = true;
        seg1 = true;
        seg2 = true;
    }
    if (digit == 8) {
        seg0 = true;
        seg1 = true;
        seg2 = true;
        seg3 = true;
        seg4 = true;
        seg5 = true;
        seg6 = true;
    }
    if (digit == 9) {
        seg0 = true;
        seg1 = true;
        seg5 = true;
        seg6 = true;
        seg2 = true;
        seg3 = true;
    }

    let top: f32 = y;
    let mid: f32 = y + scale;
    let bot: f32 = y + scale * 2.0;
    let left: f32 = x;
    let right: f32 = x + scale;

    if (seg0) {
        draw_line(left, top, right, top, 1.0, 1.0, 1.0, 1.0);
    }
    if (seg1) {
        draw_line(right, top, right, mid, 1.0, 1.0, 1.0, 1.0);
    }
    if (seg2) {
        draw_line(right, mid, right, bot, 1.0, 1.0, 1.0, 1.0);
    }
    if (seg3) {
        draw_line(left, bot, right, bot, 1.0, 1.0, 1.0, 1.0);
    }
    if (seg4) {
        draw_line(left, mid, left, bot, 1.0, 1.0, 1.0, 1.0);
    }
    if (seg5) {
        draw_line(left, top, left, mid, 1.0, 1.0, 1.0, 1.0);
    }
    if (seg6) {
        draw_line(left, mid, right, mid, 1.0, 1.0, 1.0, 1.0);
    }
}

function draw_letter(char_id: i32, x: f32, y: f32, scale: f32): void {
    // Minimal stroke letters for "RESTARTING IN"
    if (char_id == 82) { // R
        draw_line(x, y, x, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y, x + scale, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y, x + scale, y + scale, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale, x + scale, y + scale, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 69) { // E
        draw_line(x, y, x, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y, x + scale, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale, x + scale * 0.8, y + scale, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale * 2.0, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 83) { // S
        draw_line(x + scale, y, x, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y, x, y + scale, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale, x + scale, y + scale, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y + scale, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y + scale * 2.0, x, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 84) { // T
        draw_line(x, y, x + scale, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale * 0.5, y, x + scale * 0.5, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 65) { // A
        draw_line(x, y + scale * 2.0, x + scale * 0.5, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale * 0.5, y, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale * 0.2, y + scale, x + scale * 0.8, y + scale, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 73) { // I
        draw_line(x, y, x + scale, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale * 0.5, y, x + scale * 0.5, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale * 2.0, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 78) { // N
        draw_line(x, y + scale * 2.0, x, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y + scale * 2.0, x + scale, y, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 71) { // G
        draw_line(x + scale, y + scale * 0.5, x + scale, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y, x, y, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y, x, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale * 2.0, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y + scale * 2.0, x + scale, y + scale, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y + scale, x + scale * 0.6, y + scale, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 76) { // L
        draw_line(x, y, x, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x, y + scale * 2.0, x + scale, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
    if (char_id == 86) { // V
        draw_line(x, y, x + scale * 0.5, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
        draw_line(x + scale, y, x + scale * 0.5, y + scale * 2.0, 1.0, 1.0, 1.0, 1.0);
    }
}

function draw_restart_overlay(): void {
    if (state.timers.restart_timer_ms < 1) {
        return;
    }

    // Draw a simple stroked "RESTARTING IN" and countdown digits
    let base_x: f32 = SCREEN_W * 0.3;
    let base_y: f32 = SCREEN_H * 0.3;
    let scale: f32 = 12.0;
    let cursor: f32 = base_x;

    // "RESTARTING IN"
    draw_letter(82, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    draw_letter(69, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    draw_letter(83, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    draw_letter(84, cursor, base_y, scale); cursor = cursor + scale * 1.2;
    draw_letter(65, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    draw_letter(82, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    draw_letter(84, cursor, base_y, scale); cursor = cursor + scale * 1.2;
    draw_letter(73, cursor, base_y, scale); cursor = cursor + scale * 1.2;
    draw_letter(78, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    draw_letter(71, cursor, base_y, scale); cursor = cursor + scale * 1.4;
    cursor = cursor + scale * 0.8;
    draw_letter(73, cursor, base_y, scale); cursor = cursor + scale * 1.2;
    draw_letter(78, cursor, base_y, scale); cursor = cursor + scale * 1.4;

    // Countdown digits
    let secs: i32 = state.timers.restart_timer_ms / 1000;
    if ((state.timers.restart_timer_ms % 1000) > 0) {
        // show ceil-like behavior
        secs = secs + 1;
    }
    if (secs > 99) {
        secs = 99;
    }
    let tens: i32 = secs / 10;
    let ones: i32 = secs % 10;
    let digit_y: f32 = base_y + scale * 2.6;
    draw_segment_digit(tens, base_x + scale * 1.0, digit_y, scale * 0.8);
    draw_segment_digit(ones, base_x + scale * 2.2, digit_y, scale * 0.8);

    // Simple progress bar for remaining time
    let bar_w: f32 = scale * 8.0;
    let bar_h: f32 = 6.0;
    let bar_x: f32 = base_x + scale * 0.2;
    let bar_y: f32 = digit_y + scale * 1.6;
    let restart_ms_f: f32 = state.timers.restart_timer_ms;
    let restart_delay_f: f32 = 15000.0;
    let t_remaining: f32 = restart_ms_f / restart_delay_f;
    let fill_w: f32 = bar_w * t_remaining;
    draw_line(bar_x, bar_y, bar_x + bar_w, bar_y, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x, bar_y + bar_h, bar_x + bar_w, bar_y + bar_h, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x, bar_y, bar_x, bar_y + bar_h, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x + bar_w, bar_y, bar_x + bar_w, bar_y + bar_h, 1.0, 1.0, 1.0, 1.0);
    draw_line(bar_x, bar_y, bar_x + fill_w, bar_y, 0.2, 1.0, 0.2, 1.0);
    draw_line(bar_x, bar_y + bar_h, bar_x + fill_w, bar_y + bar_h, 0.2, 1.0, 0.2, 1.0);
}

function draw_level_overlay(): void {
    if (state.timers.level_start_timer_ms < 1) {
        return;
    }

    let base_x: f32 = SCREEN_W * 0.28;
    let base_y: f32 = SCREEN_H * 0.45;
    let scale: f32 = 10.0;
    let cursor: f32 = base_x;

    // "STARTING LEVEL"
    draw_letter(83, cursor, base_y, scale); cursor = cursor + scale * 1.4; // S
    draw_letter(84, cursor, base_y, scale); cursor = cursor + scale * 1.2; // T
    draw_letter(65, cursor, base_y, scale); cursor = cursor + scale * 1.4; // A
    draw_letter(82, cursor, base_y, scale); cursor = cursor + scale * 1.4; // R
    draw_letter(84, cursor, base_y, scale); cursor = cursor + scale * 1.2; // T
    draw_letter(73, cursor, base_y, scale); cursor = cursor + scale * 1.2; // I
    draw_letter(78, cursor, base_y, scale); cursor = cursor + scale * 1.4; // N
    draw_letter(71, cursor, base_y, scale); cursor = cursor + scale * 1.4; // G
    cursor = cursor + scale * 0.8;
    draw_letter(76, cursor, base_y, scale); cursor = cursor + scale * 1.2; // L
    draw_letter(69, cursor, base_y, scale); cursor = cursor + scale * 1.4; // E
    draw_letter(86, cursor, base_y, scale); cursor = cursor + scale * 1.4; // V
    draw_letter(69, cursor, base_y, scale); cursor = cursor + scale * 1.4; // E
    draw_letter(76, cursor, base_y, scale); cursor = cursor + scale * 1.2; // L

    // Level number (two digits)
    let lvl: i32 = state.level_state.next_level;
    if (lvl < 0) { lvl = 0; }
    if (lvl > 99) { lvl = 99; }
    let tens: i32 = lvl / 10;
    let ones: i32 = lvl % 10;
    let digit_y: f32 = base_y + scale * 2.6;
    draw_segment_digit(tens, base_x + scale * 9.0, digit_y, scale * 0.9);
    draw_segment_digit(ones, base_x + scale * 10.4, digit_y, scale * 0.9);

    // Countdown
    let secs: i32 = state.timers.level_start_timer_ms / 1000;
    if ((state.timers.level_start_timer_ms % 1000) > 0) {
        secs = secs + 1;
    }
    if (secs > 99) {
        secs = 99;
    }
    let cd_tens: i32 = secs / 10;
    let cd_ones: i32 = secs % 10;
    let cd_y: f32 = digit_y + scale * 1.8;
    draw_segment_digit(cd_tens, base_x + scale * 9.0, cd_y, scale * 0.8);
    draw_segment_digit(cd_ones, base_x + scale * 10.2, cd_y, scale * 0.8);
}

function handle_fire_input(delta_ms: i32): void {
    if (!state.ship_alive) {
        return;
    }
    if (state.timers.fire_cooldown > 0) {
        state.timers.fire_cooldown = state.timers.fire_cooldown - delta_ms;
    }
    if (is_key_down(KEY_SPACE) && state.timers.fire_cooldown < 1) {
        fire_bullet();
        state.timers.fire_cooldown = 200;
    }
}

function tick_level_progression(delta_ms: i32): void {
    if (!state.ship_alive) {
        return;
    }

    let remaining: i32 = active_asteroid_count();
    if (remaining == 0) {
        if (state.timers.level_start_timer_ms < 1) {
            state.timers.level_start_timer_ms = LEVEL_START_DELAY_MS;
            state.level_state.next_level = state.level_state.level + 1;
        }
    }
    if (state.timers.level_start_timer_ms > 0) {
        state.timers.level_start_timer_ms = state.timers.level_start_timer_ms - delta_ms;
        if (state.timers.level_start_timer_ms < 1) {
            state.timers.level_start_timer_ms = 0;
            // Repair ship by 1 HP on level completion, up to max
            if (state.ship_hp < SHIP_MAX_HP) {
                state.ship_hp = state.ship_hp + 1;
                if (state.ship_hp > SHIP_MAX_HP) {
                    state.ship_hp = SHIP_MAX_HP;
                }
            }
            configure_level(state.level_state.next_level);
        }
    }
}

function tick_death_timers(delta_ms: i32): void {
    if (state.ship_alive) {
        return;
    }
    if (state.timers.death_anim_ms > 0) {
        state.timers.death_anim_ms = state.timers.death_anim_ms - delta_ms;
        if (state.timers.death_anim_ms < 0) {
            state.timers.death_anim_ms = 0;
        }
    }
    if (state.timers.restart_timer_ms > 0) {
        state.timers.restart_timer_ms = state.timers.restart_timer_ms - delta_ms;
        if (state.timers.restart_timer_ms < 0) {
            state.timers.restart_timer_ms = 0;
        }
    } else {
        reset_game();
    }
}

function update_sim(dt: f32, delta_ms: i32): void {
    update_ship(dt);
    update_asteroids(dt);
    update_bullets(dt, delta_ms);
    check_collisions();
    tick_level_progression(delta_ms);
    tick_death_timers(delta_ms);
}

function draw_frame(): void {
    draw_ship();
    draw_asteroids();
    draw_bullets();
    draw_health_bar();
    draw_death_effect();
    draw_restart_overlay();
    draw_level_overlay();
}

function main(): i32 {
    let init_ok: bool = init_window(800, 600, "Stasis Asteroids");
    if (!init_ok) {
        return 1;
    }

    seed_rng(time());
    init_ship();
    configure_level(1);
    init_bullets();

    state.timers.last_time = get_time_ms();
    state.timers.fire_cooldown = 0;
    state.running = 1;

    let frame: i32 = 0;
    for (frame = 0; state.running == 1; frame = frame + 1) {
        // Record frame start time for FPS control
        state.timers.frame_start_time = get_time_ms();

        let quit: bool = should_quit();
        if (quit) {
            state.running = 0;
        }

        if (state.running == 1) {
            begin_frame();
            clear(0.0, 0.0, 0.1, 1.0);

            // Calculate delta time
            let delta_ms: i32 = compute_delta_ms();
            let delta_ms_f: f32 = delta_ms;
            let dt: f32 = delta_ms_f / 1000.0;

            handle_fire_input(delta_ms);
            update_sim(dt, delta_ms);
            draw_frame();

            end_frame();

            // FPS control: sleep for remaining frame time if ahead of schedule
            sync_frame_rate();
        }
    }

    return 0;
}
