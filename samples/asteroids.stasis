// Asteroids - Minimal Vector Graphics Demo
// Controls: A/D or Arrow keys to rotate, W or Up to thrust, Space to fire, Escape to quit

// External runtime APIs:
// - init_window(width: i32, height: i32, title: string) -> bool: creates the SDL window/context.
// - time() -> i64: returns unix timestamp seconds for seeding the PRNG.
// - get_time_ms() -> i32: millisecond-resolution clock used for timing logic.
// - sleep_ms(ms: i32): pauses the thread to pace the frame loop.
// - should_quit() -> bool: polls SDL events for quit requests.
// - begin_frame(), end_frame(): bracket GPU work for the graphics backend.
// - clear(r: f32, g: f32, b: f32, a: f32): clears the frame buffer.
// - draw_line(x1: f32, y1: f32, x2: f32, y2: f32, r: f32, g: f32, b: f32, a: f32): renders debug lines.
// - is_key_down(scancode: i32) -> bool: queries the current keyboard state.

// SDL Scancodes (constants)
const KEY_W: i32 = 26;
const KEY_A: i32 = 4;
const KEY_D: i32 = 7;
const KEY_SPACE: i32 = 44;
const KEY_ESCAPE: i32 = 41;
const KEY_LEFT: i32 = 80;
const KEY_RIGHT: i32 = 79;
const KEY_UP: i32 = 82;

// Screen dimensions (constants)
const SCREEN_W: f32 = 800.0;
const SCREEN_H: f32 = 600.0;

// Limits (constants)
const MAX_ASTEROIDS: i32 = 8;
const MAX_BULLETS: i32 = 5;
const BULLET_LIFETIME_MS: i32 = 1000;

// Math constants
const PI: f32 = 3.14159;
// Trig helpers: sin/cos keep the precise LLVM intrinsics; sin_fast/cos_fast enable fast-math for faster, less accurate gameplay math.

// FPS control
const TARGET_FPS: i32 = 60;
const FRAME_TIME_MS: i32 = 16; // 1000ms / 60fps ≈ 16.67ms

// Struct definitions
struct Ship {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    angle: f32;
}

struct Asteroid {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    size: f32;
    active: bool;
}

struct Bullet {
    x: f32;
    y: f32;
    vx: f32;
    vy: f32;
    life: i32;
}

struct GameState {
    ship: Ship;
    asteroids: Asteroid[8];
    bullets: Bullet[5];
    num_asteroids: i32;
    fire_cooldown: i32;
    running: i32;
    last_time: i32;
    frame_start_time: i32;
    rng_state: i32;
}

// Single global state struct
global state: GameState;

function seed_rng(seed: i32): void {
    state.rng_state = seed;
}

function next_rand(): i32 {
    state.rng_state = state.rng_state * 1103515245 + 12345;
    if (state.rng_state < 0) {
        state.rng_state = 0 - state.rng_state;
    }
    return state.rng_state;
}

function rand_float(max: f32): f32 {
    let r: i32;
    let rf: f32;
    r = next_rand() % 1000;
    rf = r;
    return (rf / 1000.0) * max;
}

function init_ship(): void {
    state.ship.x = SCREEN_W / 2.0;
    state.ship.y = SCREEN_H / 2.0;
    state.ship.vx = 0.0;
    state.ship.vy = 0.0;
    state.ship.angle = 0.0;
}

function init_asteroids(): void {
    state.num_asteroids = 4;
    let i: i32;
    for i = 0; i < MAX_ASTEROIDS; i = i + 1 {
        if (i < state.num_asteroids) {
            state.asteroids[i].active = true;
            state.asteroids[i].size = 40.0;
            state.asteroids[i].vx = 0.5;
            state.asteroids[i].vy = 0.3;
        } else {
            state.asteroids[i].active = false;
        }
    }

    if state.num_asteroids > 0 {
        state.asteroids[0].x = 150.0;
        state.asteroids[0].y = 150.0;
    }
    if state.num_asteroids > 1 {
        state.asteroids[1].x = 650.0;
        state.asteroids[1].y = 150.0;
    }
    if state.num_asteroids > 2 {
        state.asteroids[2].x = 150.0;
        state.asteroids[2].y = 450.0;
    }
    if state.num_asteroids > 3 {
        state.asteroids[3].x = 650.0;
        state.asteroids[3].y = 450.0;
    }
}

function init_bullets(): void {
    foreach let bullet in state.bullets {
        bullet.life = 0;
    }
}

function wrap_position(px: f32, max: f32): f32 {
    let result: f32;
    result = px;
    if (result < 0.0) {
        result = result + max;
    }
    if (result > max) {
        result = result - max;
    }
    return result;
}

function sync_frame_rate(): void {
    // Calculate elapsed time and sleep if ahead of schedule
    let frame_end_time: i32;
    let frame_elapsed: i32;
    let sleep_time: i32;

    frame_end_time = get_time_ms();
    frame_elapsed = frame_end_time - state.frame_start_time;
    sleep_time = FRAME_TIME_MS - frame_elapsed;

    // Only sleep if we have time left in the frame budget
    if sleep_time > 0 {
        sleep_ms(sleep_time);
    }
    // If sleep_time <= 0, we're behind schedule - skip sleep and continue
}

function update_ship(dt: f32): void {
    // Rotation (A/D or Left/Right arrows) - 5 radians/sec = ~286 degrees/sec
    if is_key_down(KEY_A) || is_key_down(KEY_LEFT) {
        state.ship.angle = state.ship.angle - 5.0 * dt;
    }
    if is_key_down(KEY_D) || is_key_down(KEY_RIGHT) {
        state.ship.angle = state.ship.angle + 5.0 * dt;
    }

    // Thrust (W or Up arrow)
    if is_key_down(KEY_W) || is_key_down(KEY_UP) {
        let thrust: f32;
        thrust = 150.0 * dt;
        state.ship.vx = state.ship.vx + cos_fast(state.ship.angle) * thrust;
        state.ship.vy = state.ship.vy + sin_fast(state.ship.angle) * thrust;
    }

    // Apply velocity with damping
    state.ship.x = state.ship.x + state.ship.vx * dt;
    state.ship.y = state.ship.y + state.ship.vy * dt;
    state.ship.vx = state.ship.vx * 0.99;
    state.ship.vy = state.ship.vy * 0.99;

    // Wrap around screen
    state.ship.x = wrap_position(state.ship.x, SCREEN_W);
    state.ship.y = wrap_position(state.ship.y, SCREEN_H);
}

function update_asteroids(dt: f32): void {
    let i: i32;
    for i = 0; i < MAX_ASTEROIDS; i = i + 1 {
        if state.asteroids[i].active {
            state.asteroids[i].x = state.asteroids[i].x + state.asteroids[i].vx * dt * 60.0;
            state.asteroids[i].y = state.asteroids[i].y + state.asteroids[i].vy * dt * 60.0;
            state.asteroids[i].x = wrap_position(state.asteroids[i].x, SCREEN_W);
            state.asteroids[i].y = wrap_position(state.asteroids[i].y, SCREEN_H);
        }
    }
}

function fire_bullet(): void {
    let i: i32;
    for i = 0; i < MAX_BULLETS; i = i + 1 {
        if (state.bullets[i].life == 0) {
            state.bullets[i].x = state.ship.x + cos_fast(state.ship.angle) * 15.0;
            state.bullets[i].y = state.ship.y + sin_fast(state.ship.angle) * 15.0;
            state.bullets[i].vx = cos_fast(state.ship.angle) * 300.0;
            state.bullets[i].vy = sin_fast(state.ship.angle) * 300.0;
            state.bullets[i].life = BULLET_LIFETIME_MS;
            return;
        }
    }
}

function update_bullets(dt: f32, delta_ms: i32): void {
    foreach let bullet in state.bullets {
        if (bullet.life > 0) {
            bullet.x = bullet.x + bullet.vx * dt;
            bullet.y = bullet.y + bullet.vy * dt;
            bullet.life = bullet.life - delta_ms;
            if (bullet.life < 0) {
                bullet.life = 0;
            }

            // Wrap bullets
            bullet.x = wrap_position(bullet.x, SCREEN_W);
            bullet.y = wrap_position(bullet.y, SCREEN_H);
        }
    }
}

function abs_f32(x: f32): f32 {
    if (x < 0.0) {
        return 0.0 - x;
    }
    return x;
}

function check_collisions(): void {
    let j: i32;

    // Bullet-asteroid collisions
    foreach let bullet in state.bullets {
        if (bullet.life > 0) {
            for j = 0; j < MAX_ASTEROIDS; j = j + 1 {
                if state.asteroids[j].active {
                    let dx: f32 = bullet.x - state.asteroids[j].x;
                    let dy: f32 = bullet.y - state.asteroids[j].y;
                    let dist_sq: f32 = dx * dx + dy * dy;
                    let radius: f32;
                    radius = state.asteroids[j].size;
                    if (dist_sq < radius * radius) {
                        bullet.life = 0;
                        state.asteroids[j].active = false;
                    }
                }
            }
        }
    }
}

function draw_ship(): void {
    let c: f32;
    let s: f32;
    c = cos_fast(state.ship.angle);
    s = sin_fast(state.ship.angle);

    // Ship is a triangle
    let size: f32;
    size = 12.0;

    // Nose
    let nx: f32;
    let ny: f32;
    nx = state.ship.x + c * size;
    ny = state.ship.y + s * size;

    // Left wing
    let lx: f32;
    let ly: f32;
    lx = state.ship.x + cos_fast(state.ship.angle + 2.4) * size;
    ly = state.ship.y + sin_fast(state.ship.angle + 2.4) * size;

    // Right wing
    let rx: f32;
    let ry: f32;
    rx = state.ship.x + cos_fast(state.ship.angle - 2.4) * size;
    ry = state.ship.y + sin_fast(state.ship.angle - 2.4) * size;

    // Draw white lines
    draw_line(nx, ny, lx, ly, 1.0, 1.0, 1.0, 1.0);
    draw_line(lx, ly, rx, ry, 1.0, 1.0, 1.0, 1.0);
    draw_line(rx, ry, nx, ny, 1.0, 1.0, 1.0, 1.0);

    // Draw thrust flame when thrusting
    if (is_key_down(KEY_W) || is_key_down(KEY_UP)) {
        let tx: f32;
        let ty: f32;
        tx = state.ship.x - c * size * 1.5;
        ty = state.ship.y - s * size * 1.5;
        draw_line(lx, ly, tx, ty, 1.0, 0.5, 0.0, 1.0);
        draw_line(rx, ry, tx, ty, 1.0, 0.5, 0.0, 1.0);
    }
}

function draw_asteroids(): void {
    let i: i32;
    for i = 0; i < MAX_ASTEROIDS; i = i + 1 {
        if state.asteroids[i].active {
            let x: f32;
            let y: f32;
            let sz: f32;
            x = state.asteroids[i].x;
            y = state.asteroids[i].y;
            sz = state.asteroids[i].size;

            // Draw as simple octagon (8 sides)
            let j: i32;
            let prev_x: f32;
            let prev_y: f32;
            let first_x: f32;
            let first_y: f32;
            let jf: f32;
            let angle: f32;
            let px: f32;
            let py: f32;

            // Calculate first point
            first_x = x + sz;
            first_y = y;
            prev_x = first_x;
            prev_y = first_y;

            for j = 1; j < 9; j = j + 1 {
                jf = j;
                angle = (jf / 8.0) * 2.0 * PI;
                px = x + cos_fast(angle) * sz;
                py = y + sin_fast(angle) * sz;
                draw_line(prev_x, prev_y, px, py, 0.7, 0.7, 0.7, 1.0);
                prev_x = px;
                prev_y = py;
            }
        }
    }
}

function draw_bullets(): void {
    foreach let bullet in state.bullets {
        if (bullet.life > 0) {
            let x: f32;
            let y: f32;
            x = bullet.x;
            y = bullet.y;

            // Draw as small cross
            draw_line(x - 2.0, y, x + 2.0, y, 1.0, 1.0, 0.0, 1.0);
            draw_line(x, y - 2.0, x, y + 2.0, 1.0, 1.0, 0.0, 1.0);
        }
    }
}

function main(): i32 {
    let init_ok: bool;
    init_ok = init_window(800, 600, "Stasis Asteroids");
    if (!init_ok) {
        return 1;
    }

    seed_rng(time());
    init_ship();
    init_asteroids();
    init_bullets();

    state.last_time = get_time_ms();
    state.fire_cooldown = 0;
    state.running = 1;

    let frame: i32;
    for frame = 0; state.running == 1; frame = frame + 1 {
        // Record frame start time for FPS control
        state.frame_start_time = get_time_ms();

        let quit: bool;
        quit = should_quit();
        if quit {
            state.running = 0;
        }

        if state.running == 1 {
            begin_frame();
            clear(0.0, 0.0, 0.1, 1.0);

            // Calculate delta time
            let current_time: i32;
            let delta_ms: i32;
            let dt: f32;
            current_time = get_time_ms();
            delta_ms = current_time - state.last_time;
            if delta_ms < 1 {
                delta_ms = 1;
            }
            if delta_ms > 100 {
                delta_ms = 100;
            }
            let delta_ms_f: f32;
            delta_ms_f = delta_ms;
            dt = delta_ms_f / 1000.0;
            state.last_time = current_time;

            // Handle fire input
            if state.fire_cooldown > 0 {
                state.fire_cooldown = state.fire_cooldown - delta_ms;
            }
            if is_key_down(KEY_SPACE) && state.fire_cooldown < 1 {
                fire_bullet();
                state.fire_cooldown = 200;
            }

            // Update game state
            update_ship(dt);
            update_asteroids(dt);
            update_bullets(dt, delta_ms);
            check_collisions();

            // Draw everything
            draw_ship();
            draw_asteroids();
            draw_bullets();

            end_frame();

            // FPS control: sleep for remaining frame time if ahead of schedule
            sync_frame_rate();
        }
    }

    return 0;
}
