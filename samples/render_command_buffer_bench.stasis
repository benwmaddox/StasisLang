import "../src/stdlib/stdlib.stasis";

// Benchmark: per-call draw submission vs batched command buffers.
// Requires graphics runtime (run with --graphics).
//
// New builtins (this branch):
// - draw_lines_f32(lines, count) -> void        // 8 f32 per line
// - gfx_draw_sprites_i32(cmds, count) -> void   // 7 i32 per sprite
// - gfx_debug_enable_hash(enabled) -> void
// - gfx_debug_get_frame_hash() -> i32

const W: i32 = 800;
const H: i32 = 600;

const LINE_COUNT: i32 = 4000;
const SPRITE_COUNT: i32 = 800;
const FRAMES: i32 = 120;

// lines: [x1,y1,x2,y2,r,g,b,a] repeated
global line_buf: f32[32000]; // LINE_COUNT * 8

// sprites: [handle,x,y,w,h,rot_degrees,a] repeated
global sprite_cmds: i32[5600]; // SPRITE_COUNT * 7

function fill_buffers(sprite_handle: i32): void {
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * 8;
        let fx: f32 = i32_to_f32(i);
        let x1: f32 = (fx * 0.17) % 800.0;
        let y1: f32 = (fx * 0.11) % 600.0;
        let x2: f32 = (x1 + 30.0) % 800.0;
        let y2: f32 = (y1 + 20.0) % 600.0;
        line_buf[base + 0] = x1;
        line_buf[base + 1] = y1;
        line_buf[base + 2] = x2;
        line_buf[base + 3] = y2;
        line_buf[base + 4] = 0.2;
        line_buf[base + 5] = 0.8;
        line_buf[base + 6] = 0.9;
        line_buf[base + 7] = 1.0;
    }

    for (i = 0; i < SPRITE_COUNT; i = i + 1) {
        let base: i32 = i * 7;
        sprite_cmds[base + 0] = sprite_handle;
        sprite_cmds[base + 1] = (i * 17) % W;
        sprite_cmds[base + 2] = (i * 13) % H;
        sprite_cmds[base + 3] = 48;
        sprite_cmds[base + 4] = 48;
        sprite_cmds[base + 5] = (i * 7) % 360;
        sprite_cmds[base + 6] = 255;
    }
}

function submit_per_call(sprite_handle: i32): void {
    let i: i32 = 0;
    for (i = 0; i < LINE_COUNT; i = i + 1) {
        let base: i32 = i * 8;
        draw_line(
            line_buf[base + 0],
            line_buf[base + 1],
            line_buf[base + 2],
            line_buf[base + 3],
            line_buf[base + 4],
            line_buf[base + 5],
            line_buf[base + 6],
            line_buf[base + 7]
        );
    }

    for (i = 0; i < SPRITE_COUNT; i = i + 1) {
        let base: i32 = i * 7;
        gfx_draw_sprite(
            sprite_cmds[base + 0],
            sprite_cmds[base + 1],
            sprite_cmds[base + 2],
            sprite_cmds[base + 3],
            sprite_cmds[base + 4],
            sprite_cmds[base + 5],
            sprite_cmds[base + 6]
        );
    }
}

function submit_batched(): void {
    draw_lines_f32(line_buf, LINE_COUNT);
    gfx_draw_sprites_i32(sprite_cmds, SPRITE_COUNT);
}

function main(): i32 {
    let ok: bool = init_window(W, H, "render_command_buffer_bench");
    if (!ok) {
        print_string("init_window failed\n");
        return 1;
    }

    gfx_debug_enable_hash(1);

    let bird: i32 = gfx_load_sprite("assets_src/flappy-birds/bird.svg", 64, 64);
    if (bird == 0) {
        print_string("gfx_load_sprite failed\n");
        return 1;
    }

    fill_buffers(bird);

    // Accuracy check: hashes should match for identical submissions.
    begin_frame();
    clear(0.0, 0.0, 0.0, 1.0);
    submit_per_call(bird);
    let h1: i32 = gfx_debug_get_frame_hash();
    end_frame();

    begin_frame();
    clear(0.0, 0.0, 0.0, 1.0);
    submit_batched();
    let h2: i32 = gfx_debug_get_frame_hash();
    end_frame();

    if (h1 != h2) {
        print_string("hash mismatch: per_call=");
        print_int(h1);
        print_string(" batched=");
        print_int(h2);
        print_char(10);
        return 2;
    }

    print_string("hash ok: ");
    print_int(h1);
    print_char(10);

    // Benchmark: measure wall-clock ms for N frames of each approach.

    let t0: i32 = get_time_ms();
    let f: i32 = 0;
    for (f = 0; f < FRAMES; f = f + 1) {
        begin_frame();
        clear(0.0, 0.0, 0.0, 1.0);
        submit_per_call(bird);
        end_frame();
    }
    let t1: i32 = get_time_ms();

    let t2: i32 = get_time_ms();
    for (f = 0; f < FRAMES; f = f + 1) {
        begin_frame();
        clear(0.0, 0.0, 0.0, 1.0);
        submit_batched();
        end_frame();
    }
    let t3: i32 = get_time_ms();

    print_string("per_call_ms=");
    print_int(t1 - t0);
    print_string(" batched_ms=");
    print_int(t3 - t2);
    print_char(10);

    return 0;
}
