import "/vendor/stasis/src/stdlib/audio.stasis";
import "/vendor/stasis/src/stdlib/graphics.stasis";

global music: AudioAsset;
global effect: AudioAsset;
global music_voice: AudioVoice;
global audio_stream: AudioStream;
global ticks: i32;
global playback_started: bool;

function main(): i32 {
    init_window(480, 270, "Stasis Compressed Audio Playback");
    if (!audio_stream.open(48000, 2, 1024)) {
        return 1;
    }
    if (audio_stream.sample_rate != 48000 || audio_stream.channels != 2) {
        return 4;
    }
    if (!music.load_audio("assets/tone.mp3") || !effect.load_audio("assets/tone.wav")) {
        return 2;
    }
    ticks = 0;
    return 0;
}

function tick(): i32 {
    audio.refresh(audio_stream);
    if (!playback_started) {
        if (music.failed() || effect.failed()) {
            return 2;
        }
        if (!music.ready() || !effect.ready()) {
            return 0;
        }
        if (!music_voice.play(music, true, 0.18, 0.0)) {
            return 3;
        }
        playback_started = true;
    }
    ticks += 1;
    if (ticks == 120) {
        music_voice.set_paused(true);
    }
    if (ticks == 180) {
        music_voice.set_volume_pan(0.08, 0.0);
        music_voice.set_paused(false);
    }
    if (ticks == 240) {
        effect.play_once(0.25, 0.0);
    }
    if (ticks == 300) {
        music_voice.stop();
    }
    if (ticks == 360) {
        music_voice.play(music, true, 0.12, 0.0);
    }
    return 0;
}

function render(): i32 {
    begin_frame();
    clear(0.03, 0.04, 0.08, 1.0);
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
