{
  "name": "stasis",
  "displayName": "Stasis",
  "description": "Stasis language support (syntax + LSP).",
  "version": "0.0.1",
  "publisher": "stasislang",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/benwmaddox/StasisLang.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:stasis"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stasis",
        "aliases": [
          "Stasis",
          "stasis"
        ],
        "extensions": [
          ".stasis"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stasis",
        "scopeName": "source.stasis",
        "path": "./syntaxes/stasis.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Stasis",
      "properties": {
        "stasis.watchOverlayPipe": {
          "type": "string",
          "default": "",
          "description": "Optional named pipe/socket path used to push unsaved Stasis buffers to a running watch process (maps to STASIS_BUFFER_OVERLAY_PIPE)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js",
    "watch": "tsc -p . -w",
    "package": "vsce package"
  },
  "bundledDependencies": [
    "vscode-languageclient"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "@vscode/vsce": "^3.2.1"
  }
}

