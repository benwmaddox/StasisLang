import "../.stasis_cache/toolchain/src/stdlib/graphics.stasis";

global score: i32;

struct Enemy {
    hp: i32;
    speed: i32;
}

struct State {
    enemies: Enemy[2];
}

global state: State;

function main(): i32 {
    score = 1;
    state.enemies[0].hp = 7;
    state.enemies[0].speed = 2;
    tick();
    return 0;
}

// Adds two score components.
function add_score(amount: i32, bonus: i32): i32 {
    return amount + bonus;
}

function lsp_signature_probe(): i32 {
    let result = add_score(1, 2);
    return result;
}

function tick(): i32 {
    score += 1;
    return 0;
}

function render(): i32 {
    begin_frame();
    clear(0.04, 0.08, 0.16, 1.0);
    draw_line(120.0, 300.0, 680.0, 300.0, 0.9, 0.2, 0.1, 1.0);
    end_frame();
    return 0;
}

function on_code_swap(): void {
    return;
}
