{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stasis",
  "scopeName": "source.stasis",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#tests" },
    { "include": "#annotations" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.stasis", "match": "//.*$" },
        { "name": "comment.block.stasis", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.stasis",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.stasis", "match": "\\\\." }
          ]
        }
      ]
    },
    "tests": {
      "patterns": [
        {
          "name": "meta.declaration.test.stasis",
          "match": "\\b(test)\\b\\s+(`[^`]*`)",
          "captures": {
            "1": { "name": "keyword.declaration.stasis" },
            "2": { "name": "string.quoted.other.backtick.stasis" }
          }
        },
        {
          "name": "string.quoted.other.backtick.stasis",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.stasis", "match": "\\\\." }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        { "name": "storage.modifier.annotation.stasis", "match": "@[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.import.stasis",
          "match": "\\b(import)\\b\\s+(\"(?:\\\\.|[^\"])*\")",
          "captures": {
            "1": { "name": "keyword.control.import.stasis" },
            "2": { "name": "string.quoted.double.stasis" }
          }
        },
        {
          "name": "meta.declaration.type.stasis",
          "begin": "\\b(struct)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)\\b\\s*(?=<)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.stasis" },
            "2": { "name": "entity.name.type.stasis" }
          },
          "end": "(?=\\{)",
          "patterns": [
            { "include": "#generic-parameters" }
          ]
        },
        {
          "name": "meta.declaration.type.stasis",
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.stasis" },
            "2": { "name": "entity.name.type.stasis" }
          }
        },
        {
          "name": "meta.declaration.function.stasis",
          "match": "\\b(function)\\b\\s*(?:@[A-Za-z_][A-Za-z0-9_]*\\s*)*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.stasis" },
            "2": { "name": "entity.name.function.stasis" }
          }
        },
        {
          "name": "meta.declaration.variable.stasis",
          "match": "\\b(global|const|let)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.stasis" },
            "2": { "name": "variable.other.readwrite.stasis" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.stasis", "match": "\\b(if|else|for|foreach|in|continue|return)\\b" },
        { "name": "keyword.declaration.stasis", "match": "\\b(struct|enum|global|const|function|extern|test|let|import)\\b" },
        { "name": "constant.language.stasis", "match": "\\b(true|false)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.stasis", "match": "\\b[0-9]+\\.[0-9]+\\b" },
        { "name": "constant.numeric.integer.stasis", "match": "\\b[0-9]+\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "meta.type.annotation.stasis",
          "begin": "(:)\\s*(?=[A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.separator.type.stasis" }
          },
          "end": "(?=[;,)=\\{]|=|\\bin\\b)",
          "patterns": [
            { "include": "#type-name" }
          ]
        }
      ]
    },
    "generic-parameters": {
      "name": "meta.type.parameters.stasis",
      "begin": "(<)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.typeparameters.begin.stasis" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.typeparameters.end.stasis" }
      },
      "patterns": [
        {
          "name": "entity.name.type.parameter.stasis",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*:)",
          "captures": {
            "0": { "name": "entity.name.type.parameter.stasis" }
          }
        },
        {
          "name": "storage.type.generic-constraint.stasis",
          "match": "\\b(type|i32)\\b"
        },
        {
          "name": "punctuation.separator.typeparameters.stasis",
          "match": ","
        }
      ]
    },
    "type-name": {
      "patterns": [
        {
          "name": "storage.type.builtin.stasis",
          "match": "\\b(void|bool|u8|u16|u32|i32|f32|f64|string|ascii|utf8)\\b"
        },
        { "include": "#generic-type-application" },
        {
          "name": "entity.name.type.stasis",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "generic-type-application": {
      "name": "meta.type.application.stasis",
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(<)",
      "beginCaptures": {
        "1": { "name": "entity.name.type.stasis" },
        "2": { "name": "punctuation.definition.typearguments.begin.stasis" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.typearguments.end.stasis" }
      },
      "patterns": [
        { "include": "#type-name" },
        {
          "name": "constant.numeric.integer.stasis",
          "match": "(?<![A-Za-z0-9_])-?[0-9]+(?![A-Za-z0-9_])"
        },
        {
          "name": "punctuation.separator.typearguments.stasis",
          "match": ","
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.stasis", "match": "(\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|&&|\\|\\||=|\\+|-|\\*|/|%|<|>|!|\\.)" }
      ]
    }
  }
}
