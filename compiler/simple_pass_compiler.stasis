
import "../src/stdlib/stdlib.stasis";
import "compiler_state.stasis";

function compiler_reset_current_parse_metrics(): void {
    Compiler.token_count = 0;
    Compiler.parse_index = 0;
    Compiler.error_count = 0;
    Compiler.status = CompilerStatus.Idle;

    Compiler.layout_hash = 216613626;
    Compiler.tracked_function_count = 0;
    Compiler.parsed_main_declaration_count = 0;
    Compiler.parsed_main_valid_i32_count = 0;
    Compiler.parsed_main_invalid_signature_count = 0;
    Compiler.layout_struct_count = 0;
    Compiler.layout_global_count = 0;
    Compiler.layout_flat_field_count = 0;
    Compiler.layout_memory_size_bytes = 0;
    let reachability_reset_index: i32 = 0;
    for (reachability_reset_index = 0; reachability_reset_index < COMPILER_MAX_TRACKED_FUNCTIONS; reachability_reset_index += 1) {
        Compiler.function_reachable_flags[reachability_reset_index] = 0;
        Compiler.reachability_queue[reachability_reset_index] = 0;
        Compiler.function_signature_start_tokens[reachability_reset_index] = 0;
        Compiler.function_signature_end_tokens[reachability_reset_index] = 0;
        Compiler.function_body_start_tokens[reachability_reset_index] = 0;
        Compiler.function_body_end_tokens[reachability_reset_index] = 0;
        Compiler.function_call_edge_counts[reachability_reset_index] = 0;
        let call_edge_reset_index: i32 = 0;
        for (call_edge_reset_index = 0; call_edge_reset_index < COMPILER_MAX_FUNCTION_CALL_EDGES; call_edge_reset_index += 1) {
            Compiler.function_call_edge_hashes[
                reachability_reset_index * COMPILER_MAX_FUNCTION_CALL_EDGES + call_edge_reset_index
            ] = 0;
        }
    }
    let layout_reachability_reset_index: i32 = 0;
    for (layout_reachability_reset_index = 0; layout_reachability_reset_index < COMPILER_MAX_LAYOUT_STRUCTS; layout_reachability_reset_index += 1) {
        Compiler.layout_struct_reachable_flags[layout_reachability_reset_index] = 0;
        Compiler.layout_struct_reachability_queue[layout_reachability_reset_index] = 0;
    }
    for (layout_reachability_reset_index = 0; layout_reachability_reset_index < COMPILER_MAX_LAYOUT_GLOBALS; layout_reachability_reset_index += 1) {
        Compiler.layout_global_reachable_flags[layout_reachability_reset_index] = 0;
    }

    Compiler.captured_identifier_start = 0;
    Compiler.captured_identifier_len = 0;
    Compiler.current_signature_name_start = 0;
    Compiler.current_signature_name_len = 0;
    Compiler.current_signature_param_count = 0;
    Compiler.current_signature_first_param_type_code = 0;
    Compiler.current_signature_param_name_hashes[0] = 0;
    Compiler.current_signature_param_name_hashes[1] = 0;
    Compiler.current_signature_param_name_hashes[2] = 0;
    Compiler.current_signature_param_name_hashes[3] = 0;
    Compiler.current_signature_return_type_start = 0;
    Compiler.current_signature_return_type_len = 0;
    Compiler.current_simple_i32_return_literal_flag = 0;
    Compiler.current_simple_i32_return_literal_value = 0;
    Compiler.clif_call_conv_code = 1;
    ascii_clear(Compiler.clif_symbol_buffer);

    Compiler.eval_binding_count = 0;
    compiler_eval_clear_field_table();
    Compiler.eval_call_depth = 0;
    Compiler.eval_cursor = 0;
    Compiler.eval_last_i32 = 0;
    Compiler.eval_returned = false;
    Compiler.eval_return_value = 0;
}

function compiler_reset_run_counters(): void {
    Compiler.incremental_scanned_files = 0;
    Compiler.incremental_parsed_files = 0;
    Compiler.incremental_reused_files = 0;
    Compiler.incremental_failed_files = 0;
    Compiler.incremental_layout_changed_files = 0;
    Compiler.incremental_reused_functions = 0;
    Compiler.incremental_changed_functions = 0;
    Compiler.incremental_codegen_functions = 0;
}

function compiler_reset_state(): void {
    ascii_clear(Compiler.source);
    Compiler.source_len = 0;
    Compiler.file_count = 0;
    Compiler.current_file_index = -1;
    let file_function_slot: i32 = 0;
    for (file_function_slot = 0; file_function_slot < COMPILER_MAX_FILE_FUNCTION_SLOTS; file_function_slot += 1) {
        Compiler.file_function_reachable_flags[file_function_slot] = 0;
        Compiler.file_function_call_edge_counts[file_function_slot] = 0;
    }
    let file_function_edge_slot: i32 = 0;
    for (file_function_edge_slot = 0; file_function_edge_slot < COMPILER_MAX_FILE_FUNCTION_CALL_EDGE_SLOTS; file_function_edge_slot += 1) {
        Compiler.file_function_call_edge_hashes[file_function_edge_slot] = 0;
    }
    compiler_clear_required_reachability_roots();
    compiler_reset_current_parse_metrics();
    compiler_reset_run_counters();
}

function compiler_set_source(src: ascii[]): void {
    ascii_clear(Compiler.source);
    ascii_copy(Compiler.source, src);
    Compiler.source_len = length(Compiler.source);
}

function compiler_hash_mix(hash: i32, value: i32): i32 {
    return hash * 16777619 + value + 1;
}

function compiler_hash_ascii(src: ascii[]): i32 {
    let hash: i32 = 216613626;
    let i: i32 = 0;
    let len: i32 = length(src);
    for (i = 0; i < len; i += 1) {
        hash = compiler_hash_mix(hash, u8_to_i32(src[i]));
    }
    return hash;
}

function compiler_hash_source_span(hash: i32, start: i32, len: i32): i32 {
    let out: i32 = hash;
    let i: i32 = 0;
    for (i = 0; i < len; i += 1) {
        out = compiler_hash_mix(out, u8_to_i32(Compiler.source[start + i]));
    }
    return out;
}

function compiler_layout_extend_path_hash(path_hash: i32, segment_hash: i32): i32 {
    let out: i32 = compiler_hash_mix(path_hash, 46);
    return compiler_hash_mix(out, segment_hash);
}

function compiler_layout_find_struct_index(name_hash: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.layout_struct_count; i += 1) {
        if (Compiler.layout_struct_name_hashes[i] == name_hash) {
            return i;
        }
    }
    return -1;
}

function compiler_layout_find_global_index(name_hash: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.layout_global_count; i += 1) {
        if (Compiler.layout_global_name_hashes[i] == name_hash) {
            return i;
        }
    }
    return -1;
}

function compiler_layout_begin_struct(name_hash: i32): i32 {
    let existing: i32 = compiler_layout_find_struct_index(name_hash);
    if (existing >= 0) {
        Compiler.layout_struct_field_counts[existing] = 0;
        return existing;
    }
    if (Compiler.layout_struct_count >= COMPILER_MAX_LAYOUT_STRUCTS) {
        return -1;
    }
    let index: i32 = Compiler.layout_struct_count;
    Compiler.layout_struct_count += 1;
    Compiler.layout_struct_name_hashes[index] = name_hash;
    Compiler.layout_struct_field_counts[index] = 0;
    return index;
}

function compiler_layout_begin_global(name_hash: i32): i32 {
    let existing: i32 = compiler_layout_find_global_index(name_hash);
    if (existing >= 0) {
        Compiler.layout_global_field_counts[existing] = 0;
        return existing;
    }
    if (Compiler.layout_global_count >= COMPILER_MAX_LAYOUT_GLOBALS) {
        return -1;
    }
    let index: i32 = Compiler.layout_global_count;
    Compiler.layout_global_count += 1;
    Compiler.layout_global_name_hashes[index] = name_hash;
    Compiler.layout_global_field_counts[index] = 0;
    return index;
}

function compiler_layout_add_struct_field(struct_index: i32, field_name_hash: i32, field_type_hash: i32): bool {
    if (struct_index < 0 || struct_index >= Compiler.layout_struct_count) {
        return false;
    }
    let count: i32 = Compiler.layout_struct_field_counts[struct_index];
    if (count >= COMPILER_MAX_LAYOUT_FIELDS_PER_DECL) {
        return false;
    }
    let slot: i32 = struct_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + count;
    Compiler.layout_struct_field_name_hashes[slot] = field_name_hash;
    Compiler.layout_struct_field_type_hashes[slot] = field_type_hash;
    Compiler.layout_struct_field_counts[struct_index] = count + 1;
    return true;
}

function compiler_layout_add_global_field(global_index: i32, field_name_hash: i32, field_type_hash: i32): bool {
    if (global_index < 0 || global_index >= Compiler.layout_global_count) {
        return false;
    }
    let count: i32 = Compiler.layout_global_field_counts[global_index];
    if (count >= COMPILER_MAX_LAYOUT_FIELDS_PER_DECL) {
        return false;
    }
    let slot: i32 = global_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + count;
    Compiler.layout_global_field_name_hashes[slot] = field_name_hash;
    Compiler.layout_global_field_type_hashes[slot] = field_type_hash;
    Compiler.layout_global_field_counts[global_index] = count + 1;
    return true;
}

function compiler_layout_find_flat_field_offset(path_hash: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.layout_flat_field_count; i += 1) {
        if (Compiler.layout_flat_field_path_hashes[i] == path_hash) {
            return Compiler.layout_flat_field_offsets[i];
        }
    }
    return -1;
}

function compiler_layout_append_flat_field(path_hash: i32): bool {
    let existing_offset: i32 = compiler_layout_find_flat_field_offset(path_hash);
    if (existing_offset >= 0) {
        return true;
    }
    if (Compiler.layout_flat_field_count >= COMPILER_MAX_LAYOUT_FLAT_FIELDS) {
        return false;
    }
    let slot: i32 = Compiler.layout_flat_field_count;
    Compiler.layout_flat_field_count += 1;
    Compiler.layout_flat_field_path_hashes[slot] = path_hash;
    Compiler.layout_flat_field_offsets[slot] = Compiler.layout_memory_size_bytes;
    Compiler.layout_memory_size_bytes += 4;
    return true;
}

function compiler_layout_resolve_type_into_paths(type_hash: i32, path_hash: i32, depth: i32): bool {
    if (depth > COMPILER_MAX_LAYOUT_FIELDS_PER_DECL) {
        return false;
    }
    if (type_hash == compiler_hash_ascii("i32")) {
        return compiler_layout_append_flat_field(path_hash);
    }

    let struct_index: i32 = compiler_layout_find_struct_index(type_hash);
    if (struct_index < 0) {
        return compiler_layout_append_flat_field(path_hash);
    }

    let field_count: i32 = Compiler.layout_struct_field_counts[struct_index];
    let i: i32 = 0;
    for (i = 0; i < field_count; i += 1) {
        let slot: i32 = struct_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + i;
        let nested_path_hash: i32 = compiler_layout_extend_path_hash(
            path_hash,
            Compiler.layout_struct_field_name_hashes[slot]
        );
        if (
            !compiler_layout_resolve_type_into_paths(
                Compiler.layout_struct_field_type_hashes[slot],
                nested_path_hash,
                depth + 1
            )
        ) {
            return false;
        }
    }
    return true;
}

function compiler_build_flat_layout_paths(): bool {
    Compiler.layout_flat_field_count = 0;
    Compiler.layout_memory_size_bytes = 0;

    let global_index: i32 = 0;
    for (global_index = 0; global_index < Compiler.layout_global_count; global_index += 1) {
        let global_name_hash: i32 = Compiler.layout_global_name_hashes[global_index];
        let field_count: i32 = Compiler.layout_global_field_counts[global_index];
        let field_index: i32 = 0;
        for (field_index = 0; field_index < field_count; field_index += 1) {
            let slot: i32 = global_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
            let field_path_hash: i32 = compiler_layout_extend_path_hash(
                global_name_hash,
                Compiler.layout_global_field_name_hashes[slot]
            );
            if (
                !compiler_layout_resolve_type_into_paths(
                    Compiler.layout_global_field_type_hashes[slot],
                    field_path_hash,
                    0
                )
            ) {
                return false;
            }
        }
    }
    return true;
}

function compiler_push_error(code: i32, pos: i32, detail_a: i32, detail_b: i32): void {
    if (Compiler.error_count >= COMPILER_MAX_ERRORS) {
        return;
    }
    let index: i32 = Compiler.error_count;
    Compiler.error_count += 1;
    Compiler.errors[index].code = code;
    Compiler.errors[index].pos = pos;
    Compiler.errors[index].detail_a = detail_a;
    Compiler.errors[index].detail_b = detail_b;
}

function compiler_get_status_code(): i32 {
    if (Compiler.status == CompilerStatus.Ok) { return 0; }
    if (Compiler.status == CompilerStatus.LexError) { return 1; }
    if (Compiler.status == CompilerStatus.ParseError) { return 2; }
    return 0;
}

function compiler_reset_current_function_tracking(): void {
    Compiler.tracked_function_count = 0;
}

function compiler_record_current_function(
    id_hash: i32,
    sig_hash: i32,
    body_hash: i32,
    return_type_code: i32,
    param_count: i32,
    first_param_type_code: i32,
    simple_i32_return_literal_flag: i32,
    simple_i32_return_literal_value: i32,
    signature_start_token: i32,
    signature_end_token: i32,
    body_start_token: i32,
    body_end_token: i32
): void {
    if (Compiler.tracked_function_count >= COMPILER_MAX_TRACKED_FUNCTIONS) {
        return;
    }
    let index: i32 = Compiler.tracked_function_count;
    Compiler.tracked_function_count += 1;

    Compiler.function_id_hashes[index] = id_hash;
    Compiler.function_sig_hashes[index] = sig_hash;
    Compiler.function_body_hashes[index] = body_hash;
    Compiler.function_signature_start_tokens[index] = signature_start_token;
    Compiler.function_signature_end_tokens[index] = signature_end_token;
    Compiler.function_body_start_tokens[index] = body_start_token;
    Compiler.function_body_end_tokens[index] = body_end_token;
    Compiler.function_return_type_codes[index] = return_type_code;
    Compiler.function_param_counts[index] = param_count;
    Compiler.function_first_param_type_codes[index] = first_param_type_code;
    Compiler.function_simple_i32_return_literal_flags[index] = simple_i32_return_literal_flag;
    Compiler.function_simple_i32_return_literals[index] = simple_i32_return_literal_value;
    let param_base: i32 = index * COMPILER_MAX_TRACKED_PARAM_HASHES;
    Compiler.function_param_name_hashes[param_base + 0] = Compiler.current_signature_param_name_hashes[0];
    Compiler.function_param_name_hashes[param_base + 1] = Compiler.current_signature_param_name_hashes[1];
    Compiler.function_param_name_hashes[param_base + 2] = Compiler.current_signature_param_name_hashes[2];
    Compiler.function_param_name_hashes[param_base + 3] = Compiler.current_signature_param_name_hashes[3];
    compiler_record_function_call_edges(index, body_start_token, body_end_token);
}

function compiler_clear_function_call_edges(index: i32): void {
    if (index < 0 || index >= COMPILER_MAX_TRACKED_FUNCTIONS) {
        return;
    }
    Compiler.function_call_edge_counts[index] = 0;
    let i: i32 = 0;
    for (i = 0; i < COMPILER_MAX_FUNCTION_CALL_EDGES; i += 1) {
        Compiler.function_call_edge_hashes[index * COMPILER_MAX_FUNCTION_CALL_EDGES + i] = 0;
    }
}

function compiler_add_function_call_edge(index: i32, callee_hash: i32): void {
    if (index < 0 || index >= Compiler.tracked_function_count) {
        return;
    }
    if (callee_hash == 0) {
        return;
    }
    let count: i32 = Compiler.function_call_edge_counts[index];
    let edge_index: i32 = 0;
    for (edge_index = 0; edge_index < count; edge_index += 1) {
        if (
            Compiler.function_call_edge_hashes[
                index * COMPILER_MAX_FUNCTION_CALL_EDGES + edge_index
            ] == callee_hash
        ) {
            return;
        }
    }
    if (count >= COMPILER_MAX_FUNCTION_CALL_EDGES) {
        return;
    }
    Compiler.function_call_edge_hashes[
        index * COMPILER_MAX_FUNCTION_CALL_EDGES + count
    ] = callee_hash;
    Compiler.function_call_edge_counts[index] = count + 1;
}

function compiler_record_function_call_edges(index: i32, body_start_token: i32, body_end_token: i32): void {
    compiler_clear_function_call_edges(index);
    if (
        body_start_token < 0 ||
        body_end_token <= body_start_token ||
        body_end_token >= Compiler.token_count
    ) {
        return;
    }
    let cursor: i32 = body_start_token + 1;
    for (cursor = body_start_token + 1; cursor < body_end_token; cursor += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Identifier &&
            parser_token_kind_at(cursor + 1) == TokenKind.LParen
        ) {
            compiler_add_function_call_edge(index, compiler_eval_identifier_hash_at(cursor));
        }
    }
}

function compiler_find_current_function_index(id_hash: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        if (Compiler.function_id_hashes[i] == id_hash) {
            return i;
        }
    }
    return -1;
}

function compiler_clear_function_reachability_flags(): void {
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        Compiler.function_reachable_flags[i] = 0;
        Compiler.reachability_queue[i] = 0;
    }
}

function compiler_mark_function_reachable(index: i32): bool {
    if (index < 0 || index >= Compiler.tracked_function_count) {
        return false;
    }
    if (Compiler.function_reachable_flags[index] == 1) {
        return false;
    }
    Compiler.function_reachable_flags[index] = 1;
    return true;
}

function compiler_mark_functions_reachable_by_hash(id_hash: i32, tail: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        if (Compiler.function_id_hashes[i] == id_hash) {
            if (compiler_mark_function_reachable(i)) {
                if (tail >= COMPILER_MAX_TRACKED_FUNCTIONS) {
                    return -1;
                }
                Compiler.reachability_queue[tail] = i;
                tail += 1;
            }
        }
    }
    return tail;
}

function compiler_clear_required_reachability_roots(): void {
    Compiler.required_reachability_root_count = 0;
    let i: i32 = 0;
    for (i = 0; i < COMPILER_MAX_REQUIRED_REACHABILITY_ROOTS; i += 1) {
        Compiler.required_reachability_root_hashes[i] = 0;
    }
}

function compiler_add_required_reachability_root_hash(id_hash: i32): bool {
    if (id_hash == 0) {
        return false;
    }
    let i: i32 = 0;
    for (i = 0; i < Compiler.required_reachability_root_count; i += 1) {
        if (Compiler.required_reachability_root_hashes[i] == id_hash) {
            return true;
        }
    }
    if (Compiler.required_reachability_root_count >= COMPILER_MAX_REQUIRED_REACHABILITY_ROOTS) {
        return false;
    }
    let slot: i32 = Compiler.required_reachability_root_count;
    Compiler.required_reachability_root_count += 1;
    Compiler.required_reachability_root_hashes[slot] = id_hash;
    return true;
}

function compiler_scan_reachable_callees(function_index: i32, tail: i32): i32 {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return -1;
    }
    let body_start: i32 = Compiler.function_body_start_tokens[function_index];
    let body_end: i32 = Compiler.function_body_end_tokens[function_index];
    if (
        body_start < 0 ||
        body_end <= body_start ||
        body_end >= Compiler.token_count
    ) {
        return -1;
    }

    let cursor: i32 = body_start + 1;
    for (cursor = body_start + 1; cursor < body_end; cursor += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Identifier &&
            parser_token_kind_at(cursor + 1) == TokenKind.LParen
        ) {
            let callee_hash: i32 = compiler_eval_identifier_hash_at(cursor);
            tail = compiler_mark_functions_reachable_by_hash(callee_hash, tail);
            if (tail < 0) {
                return -1;
            }
        }
    }
    return tail;
}

function compiler_build_function_reachability(): bool {
    compiler_clear_function_reachability_flags();

    let tail: i32 = 0;
    tail = compiler_mark_functions_reachable_by_hash(compiler_hash_ascii("main"), tail);
    if (tail < 0) { return false; }
    tail = compiler_mark_functions_reachable_by_hash(compiler_hash_ascii("tick"), tail);
    if (tail < 0) { return false; }
    tail = compiler_mark_functions_reachable_by_hash(compiler_hash_ascii("on_code_swap"), tail);
    if (tail < 0) { return false; }
    let host_root_index: i32 = 0;
    for (host_root_index = 0; host_root_index < Compiler.required_reachability_root_count; host_root_index += 1) {
        tail = compiler_mark_functions_reachable_by_hash(
            Compiler.required_reachability_root_hashes[host_root_index],
            tail
        );
        if (tail < 0) { return false; }
    }

    if (tail == 0) {
        let all_index: i32 = 0;
        for (all_index = 0; all_index < Compiler.tracked_function_count; all_index += 1) {
            Compiler.function_reachable_flags[all_index] = 1;
        }
        return true;
    }

    let head: i32 = 0;
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_TRACKED_FUNCTIONS && head < tail; guard += 1) {
        let function_index: i32 = Compiler.reachability_queue[head];
        head += 1;
        tail = compiler_scan_reachable_callees(function_index, tail);
        if (tail < 0) {
            return false;
        }
    }
    return head >= tail;
}

function compiler_is_function_reachable(function_index: i32): bool {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return false;
    }
    return Compiler.function_reachable_flags[function_index] == 1;
}

function compiler_clear_layout_reachability_flags(): void {
    let i: i32 = 0;
    for (i = 0; i < COMPILER_MAX_LAYOUT_STRUCTS; i += 1) {
        Compiler.layout_struct_reachable_flags[i] = 0;
        Compiler.layout_struct_reachability_queue[i] = 0;
    }
    for (i = 0; i < COMPILER_MAX_LAYOUT_GLOBALS; i += 1) {
        Compiler.layout_global_reachable_flags[i] = 0;
    }
}

function compiler_mark_struct_reachable_by_index(struct_index: i32, tail: i32): i32 {
    if (struct_index < 0 || struct_index >= Compiler.layout_struct_count) {
        return tail;
    }
    if (Compiler.layout_struct_reachable_flags[struct_index] == 1) {
        return tail;
    }
    if (tail < 0 || tail >= COMPILER_MAX_LAYOUT_STRUCTS) {
        return -1;
    }
    Compiler.layout_struct_reachable_flags[struct_index] = 1;
    Compiler.layout_struct_reachability_queue[tail] = struct_index;
    return tail + 1;
}

function compiler_mark_global_references_from_reachable_function(function_index: i32): bool {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return false;
    }
    let body_start: i32 = Compiler.function_body_start_tokens[function_index];
    let body_end: i32 = Compiler.function_body_end_tokens[function_index];
    if (
        body_start < 0 ||
        body_end <= body_start ||
        body_end >= Compiler.token_count
    ) {
        return false;
    }

    let cursor: i32 = body_start + 1;
    for (cursor = body_start + 1; cursor < body_end; cursor += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Identifier &&
            parser_token_kind_at(cursor - 1) != TokenKind.Dot
        ) {
            let identifier_hash: i32 = compiler_eval_identifier_hash_at(cursor);
            let global_index: i32 = compiler_layout_find_global_index(identifier_hash);
            if (global_index >= 0) {
                Compiler.layout_global_reachable_flags[global_index] = 1;
            }
        }
    }
    return true;
}

function compiler_mark_reachable_globals(): bool {
    let function_index: i32 = 0;
    for (function_index = 0; function_index < Compiler.tracked_function_count; function_index += 1) {
        if (compiler_is_function_reachable(function_index)) {
            if (!compiler_mark_global_references_from_reachable_function(function_index)) {
                return false;
            }
        }
    }
    return true;
}

function compiler_mark_struct_type_references_in_token_range(
    start_token: i32,
    end_token: i32,
    tail: i32
): i32 {
    if (
        start_token < 0 ||
        end_token <= start_token ||
        end_token >= Compiler.token_count
    ) {
        return -1;
    }
    let cursor: i32 = start_token;
    for (cursor = start_token; cursor < end_token; cursor += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Colon &&
            parser_token_kind_at(cursor + 1) == TokenKind.Identifier
        ) {
            let type_hash: i32 = compiler_eval_identifier_hash_at(cursor + 1);
            tail = compiler_mark_struct_reachable_by_index(
                compiler_layout_find_struct_index(type_hash),
                tail
            );
            if (tail < 0) {
                return -1;
            }
        }
    }
    return tail;
}

function compiler_mark_structs_from_reachable_function_types(tail: i32): i32 {
    let function_index: i32 = 0;
    for (function_index = 0; function_index < Compiler.tracked_function_count; function_index += 1) {
        if (compiler_is_function_reachable(function_index)) {
            tail = compiler_mark_struct_type_references_in_token_range(
                Compiler.function_signature_start_tokens[function_index],
                Compiler.function_signature_end_tokens[function_index],
                tail
            );
            if (tail < 0) {
                return -1;
            }
            tail = compiler_mark_struct_type_references_in_token_range(
                Compiler.function_body_start_tokens[function_index],
                Compiler.function_body_end_tokens[function_index],
                tail
            );
            if (tail < 0) {
                return -1;
            }
        }
    }
    return tail;
}

function compiler_mark_structs_from_reachable_globals(tail: i32): i32 {
    let global_index: i32 = 0;
    for (global_index = 0; global_index < Compiler.layout_global_count; global_index += 1) {
        if (Compiler.layout_global_reachable_flags[global_index] == 1) {
            let field_count: i32 = Compiler.layout_global_field_counts[global_index];
            let field_index: i32 = 0;
            for (field_index = 0; field_index < field_count; field_index += 1) {
                let slot: i32 = global_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
                tail = compiler_mark_struct_reachable_by_index(
                    compiler_layout_find_struct_index(Compiler.layout_global_field_type_hashes[slot]),
                    tail
                );
                if (tail < 0) {
                    return -1;
                }
            }
        }
    }
    return tail;
}

function compiler_expand_reachable_struct_closure(tail: i32): bool {
    let head: i32 = 0;
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_LAYOUT_STRUCTS && head < tail; guard += 1) {
        let struct_index: i32 = Compiler.layout_struct_reachability_queue[head];
        head += 1;
        if (struct_index < 0 || struct_index >= Compiler.layout_struct_count) {
            return false;
        }

        let field_count: i32 = Compiler.layout_struct_field_counts[struct_index];
        let field_index: i32 = 0;
        for (field_index = 0; field_index < field_count; field_index += 1) {
            let slot: i32 = struct_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
            tail = compiler_mark_struct_reachable_by_index(
                compiler_layout_find_struct_index(Compiler.layout_struct_field_type_hashes[slot]),
                tail
            );
            if (tail < 0) {
                return false;
            }
        }
    }
    return head >= tail;
}

function compiler_prune_unreachable_layout_structs(): void {
    let write_index: i32 = 0;
    let read_index: i32 = 0;
    for (read_index = 0; read_index < Compiler.layout_struct_count; read_index += 1) {
        if (Compiler.layout_struct_reachable_flags[read_index] == 1) {
            if (write_index != read_index) {
                Compiler.layout_struct_name_hashes[write_index] = Compiler.layout_struct_name_hashes[read_index];
                Compiler.layout_struct_field_counts[write_index] = Compiler.layout_struct_field_counts[read_index];
                let field_count: i32 = Compiler.layout_struct_field_counts[read_index];
                let field_index: i32 = 0;
                for (field_index = 0; field_index < field_count; field_index += 1) {
                    let read_slot: i32 = read_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
                    let write_slot: i32 = write_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
                    Compiler.layout_struct_field_name_hashes[write_slot] = Compiler.layout_struct_field_name_hashes[read_slot];
                    Compiler.layout_struct_field_type_hashes[write_slot] = Compiler.layout_struct_field_type_hashes[read_slot];
                }
            }
            write_index += 1;
        }
    }
    Compiler.layout_struct_count = write_index;
}

function compiler_prune_unreachable_layout_globals(): void {
    let write_index: i32 = 0;
    let read_index: i32 = 0;
    for (read_index = 0; read_index < Compiler.layout_global_count; read_index += 1) {
        if (Compiler.layout_global_reachable_flags[read_index] == 1) {
            if (write_index != read_index) {
                Compiler.layout_global_name_hashes[write_index] = Compiler.layout_global_name_hashes[read_index];
                Compiler.layout_global_field_counts[write_index] = Compiler.layout_global_field_counts[read_index];
                let field_count: i32 = Compiler.layout_global_field_counts[read_index];
                let field_index: i32 = 0;
                for (field_index = 0; field_index < field_count; field_index += 1) {
                    let read_slot: i32 = read_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
                    let write_slot: i32 = write_index * COMPILER_MAX_LAYOUT_FIELDS_PER_DECL + field_index;
                    Compiler.layout_global_field_name_hashes[write_slot] = Compiler.layout_global_field_name_hashes[read_slot];
                    Compiler.layout_global_field_type_hashes[write_slot] = Compiler.layout_global_field_type_hashes[read_slot];
                }
            }
            write_index += 1;
        }
    }
    Compiler.layout_global_count = write_index;
}

function compiler_prune_unreachable_layout_metadata(): void {
    compiler_prune_unreachable_layout_structs();
    compiler_prune_unreachable_layout_globals();

    let i: i32 = 0;
    for (i = 0; i < COMPILER_MAX_LAYOUT_STRUCTS; i += 1) {
        if (i < Compiler.layout_struct_count) {
            Compiler.layout_struct_reachable_flags[i] = 1;
        } else {
            Compiler.layout_struct_reachable_flags[i] = 0;
        }
        Compiler.layout_struct_reachability_queue[i] = 0;
    }
    for (i = 0; i < COMPILER_MAX_LAYOUT_GLOBALS; i += 1) {
        if (i < Compiler.layout_global_count) {
            Compiler.layout_global_reachable_flags[i] = 1;
        } else {
            Compiler.layout_global_reachable_flags[i] = 0;
        }
    }
}

function compiler_build_layout_reachability(): bool {
    compiler_clear_layout_reachability_flags();

    if (!compiler_mark_reachable_globals()) {
        return false;
    }

    let tail: i32 = 0;
    tail = compiler_mark_structs_from_reachable_function_types(tail);
    if (tail < 0) {
        return false;
    }
    tail = compiler_mark_structs_from_reachable_globals(tail);
    if (tail < 0) {
        return false;
    }
    if (!compiler_expand_reachable_struct_closure(tail)) {
        return false;
    }

    compiler_prune_unreachable_layout_metadata();
    return true;
}

function compiler_find_file_function_index(file_index: i32, id_hash: i32): i32 {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return -1;
    }
    let i: i32 = 0;
    for (i = 0; i < Compiler.files[file_index].tracked_function_count; i += 1) {
        if (Compiler.files[file_index].function_id_hashes[i] == id_hash) {
            return i;
        }
    }
    return -1;
}
function compiler_store_current_functions_to_file(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }

    Compiler.files[file_index].tracked_function_count = Compiler.tracked_function_count;
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        Compiler.files[file_index].function_id_hashes[i] = Compiler.function_id_hashes[i];
        Compiler.files[file_index].function_sig_hashes[i] = Compiler.function_sig_hashes[i];
        Compiler.files[file_index].function_body_hashes[i] = Compiler.function_body_hashes[i];
        Compiler.files[file_index].function_return_type_codes[i] = Compiler.function_return_type_codes[i];
        Compiler.files[file_index].function_param_counts[i] = Compiler.function_param_counts[i];
        Compiler.files[file_index].function_first_param_type_codes[i] = Compiler.function_first_param_type_codes[i];
        Compiler.files[file_index].function_simple_i32_return_literal_flags[i] = Compiler.function_simple_i32_return_literal_flags[i];
        Compiler.files[file_index].function_simple_i32_return_literals[i] = Compiler.function_simple_i32_return_literals[i];
        let slot: i32 = file_index * COMPILER_MAX_TRACKED_FUNCTIONS + i;
        Compiler.file_function_reachable_flags[slot] = 0;
        Compiler.file_function_call_edge_counts[slot] = Compiler.function_call_edge_counts[i];
        let edge_index: i32 = 0;
        for (edge_index = 0; edge_index < COMPILER_MAX_FUNCTION_CALL_EDGES; edge_index += 1) {
            Compiler.file_function_call_edge_hashes[
                slot * COMPILER_MAX_FUNCTION_CALL_EDGES + edge_index
            ] = Compiler.function_call_edge_hashes[
                i * COMPILER_MAX_FUNCTION_CALL_EDGES + edge_index
            ];
        }
    }

    Compiler.files[file_index].layout_hash = Compiler.layout_hash;
    Compiler.files[file_index].parsed_main_declaration_count = Compiler.parsed_main_declaration_count;
    Compiler.files[file_index].parsed_main_valid_i32_count = Compiler.parsed_main_valid_i32_count;
    Compiler.files[file_index].parsed_main_invalid_signature_count = Compiler.parsed_main_invalid_signature_count;
    Compiler.files[file_index].last_status = Compiler.status;
    Compiler.files[file_index].last_error_code = 0;
    Compiler.files[file_index].last_error_pos = 0;
    Compiler.files[file_index].last_error_detail_a = 0;
    Compiler.files[file_index].last_error_detail_b = 0;
}

function compiler_record_dirty_file_function_metrics(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }

    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        let id_hash: i32 = Compiler.function_id_hashes[i];
        let previous_index: i32 = compiler_find_file_function_index(file_index, id_hash);
        if (previous_index < 0) {
            Compiler.incremental_changed_functions += 1;
            Compiler.incremental_codegen_functions += 1;
        } else {
            if (
                Compiler.function_sig_hashes[i] == Compiler.files[file_index].function_sig_hashes[previous_index] &&
                Compiler.function_body_hashes[i] == Compiler.files[file_index].function_body_hashes[previous_index]
            ) {
                Compiler.incremental_reused_functions += 1;
            } else {
                Compiler.incremental_changed_functions += 1;
                Compiler.incremental_codegen_functions += 1;
            }
        }
    }

    for (i = 0; i < Compiler.files[file_index].tracked_function_count; i += 1) {
        let previous_id_hash: i32 = Compiler.files[file_index].function_id_hashes[i];
        if (compiler_find_current_function_index(previous_id_hash) < 0) {
            Compiler.incremental_changed_functions += 1;
            Compiler.incremental_codegen_functions += 1;
        }
    }
}

function compiler_find_file(path: ascii[]): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.file_count; i += 1) {
        if (ascii_eq(Compiler.files[i].path, path)) {
            return i;
        }
    }
    return -1;
}

function compiler_upsert_file(path: ascii[], src: ascii[]): bool {
    if (length(path) <= 0) {
        compiler_push_error(CompilerErrorCode.IncrementalFilePathEmpty, 0, 0, 0);
        Compiler.status = CompilerStatus.ParseError;
        return false;
    }

    let hash: i32 = compiler_hash_ascii(src);
    let index: i32 = compiler_find_file(path);
    if (index >= 0) {
        if (Compiler.files[index].source_hash == hash) {
            Compiler.files[index].dirty = false;
            return true;
        }
        ascii_clear(Compiler.files[index].source);
        ascii_copy(Compiler.files[index].source, src);
        Compiler.files[index].source_len = length(Compiler.files[index].source);
        Compiler.files[index].source_hash = hash;
        Compiler.files[index].dirty = true;
        return true;
    }

    if (Compiler.file_count >= COMPILER_MAX_FILES) {
        compiler_push_error(
            CompilerErrorCode.IncrementalFileOverflow,
            0,
            Compiler.file_count,
            COMPILER_MAX_FILES
        );
        Compiler.status = CompilerStatus.ParseError;
        return false;
    }

    let new_index: i32 = Compiler.file_count;
    Compiler.file_count = Compiler.file_count + 1;
    ascii_clear(Compiler.files[new_index].path);
    ascii_copy(Compiler.files[new_index].path, path);
    ascii_clear(Compiler.files[new_index].source);
    ascii_copy(Compiler.files[new_index].source, src);
    Compiler.files[new_index].source_len = length(Compiler.files[new_index].source);
    Compiler.files[new_index].source_hash = hash;
    Compiler.files[new_index].dirty = true;
    Compiler.files[new_index].tracked_function_count = 0;
    let new_function_index: i32 = 0;
    for (new_function_index = 0; new_function_index < COMPILER_MAX_TRACKED_FUNCTIONS; new_function_index += 1) {
        let slot: i32 = new_index * COMPILER_MAX_TRACKED_FUNCTIONS + new_function_index;
        Compiler.file_function_reachable_flags[slot] = 0;
        Compiler.file_function_call_edge_counts[slot] = 0;
        let new_edge_index: i32 = 0;
        for (new_edge_index = 0; new_edge_index < COMPILER_MAX_FUNCTION_CALL_EDGES; new_edge_index += 1) {
            Compiler.file_function_call_edge_hashes[
                slot * COMPILER_MAX_FUNCTION_CALL_EDGES + new_edge_index
            ] = 0;
        }
    }
    Compiler.files[new_index].layout_hash = 216613626;
    Compiler.files[new_index].last_status = CompilerStatus.Idle;
    Compiler.files[new_index].last_error_code = 0;
    Compiler.files[new_index].last_error_pos = 0;
    Compiler.files[new_index].last_error_detail_a = 0;
    Compiler.files[new_index].last_error_detail_b = 0;
    return true;
}

function compiler_emit_token(
    kind: TokenKind,
    start: i32,
    end: i32,
    int_value: i32,
    text_start: i32,
    text_len: i32
): bool {
    if (Compiler.token_count >= COMPILER_MAX_TOKENS) {
        compiler_push_error(
            CompilerErrorCode.LexTokenOverflow,
            start,
            Compiler.token_count,
            Compiler.current_file_index
        );
        return false;
    }
    let index: i32 = Compiler.token_count;
    Compiler.token_count += 1;
    Compiler.tokens[index].kind = kind;
    Compiler.tokens[index].start = start;
    Compiler.tokens[index].end = end;
    Compiler.tokens[index].int_value = int_value;
    Compiler.tokens[index].text_start = text_start;
    Compiler.tokens[index].text_len = text_len;
    return true;
}

function compiler_is_space(b: u8): bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

function compiler_is_digit(b: u8): bool {
    return b >= 48 && b <= 57;
}

function compiler_is_ident_start(b: u8): bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

function compiler_is_ident_continue(b: u8): bool {
    return compiler_is_ident_start(b) || compiler_is_digit(b);
}

function compiler_span_eq(start: i32, len: i32, text: ascii[]): bool {
    if (len != length(text)) {
        return false;
    }
    let i: i32 = 0;
    for (i = 0; i < len; i += 1) {
        if (Compiler.source[start + i] != text[i]) {
            return false;
        }
    }
    return true;
}

function compiler_keyword_kind(start: i32, len: i32): TokenKind {
    if (compiler_span_eq(start, len, "function")) { return TokenKind.KwFunction; }
    if (compiler_span_eq(start, len, "extern")) { return TokenKind.KwExtern; }
    if (compiler_span_eq(start, len, "struct")) { return TokenKind.KwStruct; }
    if (compiler_span_eq(start, len, "return")) { return TokenKind.KwReturn; }
    if (compiler_span_eq(start, len, "let")) { return TokenKind.KwLet; }
    if (compiler_span_eq(start, len, "if")) { return TokenKind.KwIf; }
    if (compiler_span_eq(start, len, "else")) { return TokenKind.KwElse; }
    if (compiler_span_eq(start, len, "for")) { return TokenKind.KwFor; }
    if (compiler_span_eq(start, len, "foreach")) { return TokenKind.KwForeach; }
    if (compiler_span_eq(start, len, "in")) { return TokenKind.KwIn; }
    if (compiler_span_eq(start, len, "global")) { return TokenKind.KwGlobal; }
    return TokenKind.Identifier;
}
function compiler_emit_single_char_token(b: u8, index: i32): i32 {
    if (b == 40) { if (!compiler_emit_token(TokenKind.LParen, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 41) { if (!compiler_emit_token(TokenKind.RParen, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 123) { if (!compiler_emit_token(TokenKind.LBrace, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 125) { if (!compiler_emit_token(TokenKind.RBrace, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 91) { if (!compiler_emit_token(TokenKind.LBracket, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 93) { if (!compiler_emit_token(TokenKind.RBracket, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 58) { if (!compiler_emit_token(TokenKind.Colon, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 59) { if (!compiler_emit_token(TokenKind.Semicolon, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 44) { if (!compiler_emit_token(TokenKind.Comma, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 46) { if (!compiler_emit_token(TokenKind.Dot, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 43) { if (!compiler_emit_token(TokenKind.Plus, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 45) { if (!compiler_emit_token(TokenKind.Minus, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 42) { if (!compiler_emit_token(TokenKind.Star, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 47) { if (!compiler_emit_token(TokenKind.Slash, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 37) { if (!compiler_emit_token(TokenKind.Percent, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 61) { if (!compiler_emit_token(TokenKind.Assign, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 60) { if (!compiler_emit_token(TokenKind.Less, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 62) { if (!compiler_emit_token(TokenKind.Greater, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    if (b == 33) { if (!compiler_emit_token(TokenKind.Bang, index, index + 1, 0, index, 1)) { return -1; } return index + 1; }
    return index;
}

function compiler_lex(): bool {
    let i: i32 = 0;
    let len: i32 = Compiler.source_len;
    for (i = 0; i < len; ) {
        let b: u8 = Compiler.source[i];
        if (compiler_is_space(b)) {
            i += 1;
        } else {
            if (b == 47 && i + 1 < len && Compiler.source[i + 1] == 47) {
                i += 2;
                for (; i < len && Compiler.source[i] != 10 && Compiler.source[i] != 13; i += 1) {}
            } else {
                if (compiler_is_ident_start(b)) {
                    let start: i32 = i;
                    let end: i32 = i + 1;
                    for (; end < len && compiler_is_ident_continue(Compiler.source[end]); end += 1) {}
                    let kind: TokenKind = compiler_keyword_kind(start, end - start);
                    if (!compiler_emit_token(kind, start, end, 0, start, end - start)) {
                        return false;
                    }
                    i = end;
                } else {
                    if (compiler_is_digit(b)) {
                        let start: i32 = i;
                        let end: i32 = i + 1;
                        for (; end < len && compiler_is_digit(Compiler.source[end]); end += 1) {}
                        let value: i32 = 0;
                        let j: i32 = 0;
                        for (j = start; j < end; j += 1) {
                            value = value * 10 + (u8_to_i32(Compiler.source[j]) - 48);
                        }
                        if (!compiler_emit_token(TokenKind.IntLiteral, start, end, value, start, end - start)) {
                            return false;
                        }
                        i = end;
                    } else {
                        if (b == 34) {
                            let start: i32 = i;
                            let text_start: i32 = i + 1;
                            let end: i32 = i + 1;
                            for (; end < len && Compiler.source[end] != 34; end += 1) {}
                            if (end >= len) {
                                compiler_push_error(CompilerErrorCode.LexUnterminatedString, start, 0, Compiler.current_file_index);
                                return false;
                            }
                            if (!compiler_emit_token(TokenKind.StringLiteral, start, end + 1, 0, text_start, end - text_start)) {
                                return false;
                            }
                            i = end + 1;
                        } else {
                            let consumed_two: i32 = 0;
                            if (i + 1 < len) {
                                let next: u8 = Compiler.source[i + 1];
                                if (b == 43 && next == 61) { if (!compiler_emit_token(TokenKind.PlusEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 45 && next == 61) { if (!compiler_emit_token(TokenKind.MinusEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 42 && next == 61) { if (!compiler_emit_token(TokenKind.StarEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 47 && next == 61) { if (!compiler_emit_token(TokenKind.SlashEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 37 && next == 61) { if (!compiler_emit_token(TokenKind.PercentEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 61 && next == 61) { if (!compiler_emit_token(TokenKind.EqEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 33 && next == 61) { if (!compiler_emit_token(TokenKind.NotEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 60 && next == 61) { if (!compiler_emit_token(TokenKind.LessEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 62 && next == 61) { if (!compiler_emit_token(TokenKind.GreaterEq, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 38 && next == 38) { if (!compiler_emit_token(TokenKind.AndAnd, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                                if (b == 124 && next == 124) { if (!compiler_emit_token(TokenKind.OrOr, i, i + 2, 0, i, 2)) { return false; } consumed_two = 1; }
                            }
                            if (consumed_two == 1) {
                                i += 2;
                            } else {
                                let next_index: i32 = compiler_emit_single_char_token(b, i);
                                if (next_index < 0) { return false; }
                                if (next_index == i) {
                                    compiler_push_error(CompilerErrorCode.LexUnexpectedChar, i, u8_to_i32(b), Compiler.current_file_index);
                                    return false;
                                }
                                i = next_index;
                            }
                        }
                    }
                }
            }
        }
    }

    if (!compiler_emit_token(TokenKind.Eof, len, len, 0, len, 0)) {
        return false;
    }
    return true;
}

function parser_current_kind(): TokenKind {
    if (Compiler.parse_index < Compiler.token_count) {
        return Compiler.tokens[Compiler.parse_index].kind;
    }
    return TokenKind.Eof;
}

function parser_current_pos(): i32 {
    if (Compiler.parse_index < Compiler.token_count) {
        return Compiler.tokens[Compiler.parse_index].start;
    }
    if (Compiler.token_count > 0) {
        return Compiler.tokens[Compiler.token_count - 1].end;
    }
    return 0;
}

function parser_token_kind_at(index: i32): TokenKind {
    if (index < 0 || index >= Compiler.token_count) {
        return TokenKind.Invalid;
    }
    return Compiler.tokens[index].kind;
}

function parser_error(code: i32): bool {
    compiler_push_error(code, parser_current_pos(), Compiler.parse_index, Compiler.current_file_index);
    return false;
}

function parser_match(kind: TokenKind): bool {
    if (parser_current_kind() == kind) {
        Compiler.parse_index += 1;
        return true;
    }
    return false;
}

function parser_expect(kind: TokenKind, code: i32): bool {
    if (parser_match(kind)) {
        return true;
    }
    return parser_error(code);
}

function parser_capture_identifier(): bool {
    if (parser_current_kind() != TokenKind.Identifier) {
        return parser_error(CompilerErrorCode.ParseExpectIdentifier);
    }
    Compiler.captured_identifier_start = Compiler.tokens[Compiler.parse_index].text_start;
    Compiler.captured_identifier_len = Compiler.tokens[Compiler.parse_index].text_len;
    Compiler.parse_index += 1;
    return true;
}

function parser_captured_identifier_hash(): i32 {
    return compiler_hash_source_span(
        216613626,
        Compiler.captured_identifier_start,
        Compiler.captured_identifier_len
    );
}

function parser_type_code_from_identifier_span(start: i32, len: i32): i32 {
    if (compiler_span_eq(start, len, "i32")) { return 1; }
    return 0;
}

function parser_return_type_code(): i32 {
    if (compiler_span_eq(Compiler.current_signature_return_type_start, Compiler.current_signature_return_type_len, "i32")) {
        return 1;
    }
    if (compiler_span_eq(Compiler.current_signature_return_type_start, Compiler.current_signature_return_type_len, "void")) {
        return 2;
    }
    if (Compiler.current_signature_return_type_len == 0) {
        return 2;
    }
    return 0;
}
function parser_note_main_signature_if_needed(): void {
    if (!compiler_span_eq(Compiler.current_signature_name_start, Compiler.current_signature_name_len, "main")) {
        return;
    }
    Compiler.parsed_main_declaration_count += 1;
    if (
        Compiler.current_signature_param_count == 0 &&
        compiler_span_eq(Compiler.current_signature_return_type_start, Compiler.current_signature_return_type_len, "i32")
    ) {
        Compiler.parsed_main_valid_i32_count += 1;
    } else {
        Compiler.parsed_main_invalid_signature_count += 1;
    }
}

function parser_is_expression_stop(
    kind: TokenKind,
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    return kind == stop_a || kind == stop_b || kind == stop_c;
}

function parser_is_assignment_op(kind: TokenKind): bool {
    return (
        kind == TokenKind.Assign ||
        kind == TokenKind.PlusEq ||
        kind == TokenKind.MinusEq ||
        kind == TokenKind.StarEq ||
        kind == TokenKind.SlashEq ||
        kind == TokenKind.PercentEq
    );
}

function parser_binary_precedence(kind: TokenKind): i32 {
    if (parser_is_assignment_op(kind)) { return 1; }
    if (kind == TokenKind.OrOr) { return 2; }
    if (kind == TokenKind.AndAnd) { return 3; }
    if (kind == TokenKind.EqEq || kind == TokenKind.NotEq) { return 4; }
    if (
        kind == TokenKind.Less ||
        kind == TokenKind.LessEq ||
        kind == TokenKind.Greater ||
        kind == TokenKind.GreaterEq
    ) { return 5; }
    if (kind == TokenKind.Plus || kind == TokenKind.Minus) { return 6; }
    if (kind == TokenKind.Star || kind == TokenKind.Slash || kind == TokenKind.Percent) { return 7; }
    return 0;
}

function parser_parse_primary(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let kind: TokenKind = parser_current_kind();
    if (parser_is_expression_stop(kind, stop_a, stop_b, stop_c)) {
        return false;
    }
    if (
        kind == TokenKind.Identifier ||
        kind == TokenKind.IntLiteral ||
        kind == TokenKind.StringLiteral
    ) {
        Compiler.parse_index += 1;
        return true;
    }
    if (kind == TokenKind.LParen) {
        Compiler.parse_index += 1;
        if (!parser_parse_expression_precedence(TokenKind.RParen, TokenKind.Invalid, TokenKind.Invalid, 1)) {
            return parser_error(CompilerErrorCode.ParseExpectExpression);
        }
        return parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen);
    }
    return parser_error(CompilerErrorCode.ParseExpectExpression);
}

function parser_parse_postfix(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    if (!parser_parse_primary(stop_a, stop_b, stop_c)) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        let kind: TokenKind = parser_current_kind();
        if (kind == TokenKind.LParen) {
            Compiler.parse_index += 1;
            if (parser_current_kind() != TokenKind.RParen) {
                let arg_guard: i32 = 0;
                let done: i32 = 0;
                for (arg_guard = 0; arg_guard < COMPILER_MAX_ARGS && done == 0; arg_guard += 1) {
                    if (!parser_parse_expression_precedence(TokenKind.Comma, TokenKind.RParen, TokenKind.Invalid, 1)) {
                        return parser_error(CompilerErrorCode.ParseExpectExpression);
                    }
                    if (!parser_match(TokenKind.Comma)) {
                        done = 1;
                    }
                }
                if (done == 0) {
                    return parser_error(CompilerErrorCode.ParseArgGuardExhausted);
                }
            }
            if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
                return false;
            }
        } else {
            if (kind == TokenKind.LBracket) {
                Compiler.parse_index += 1;
                if (!parser_parse_expression_precedence(TokenKind.RBracket, TokenKind.Invalid, TokenKind.Invalid, 1)) {
                    return parser_error(CompilerErrorCode.ParseExpectExpression);
                }
                if (!parser_expect(TokenKind.RBracket, CompilerErrorCode.ParseExpectRBracket)) {
                    return false;
                }
            } else {
                if (kind == TokenKind.Dot) {
                    Compiler.parse_index += 1;
                    if (!parser_capture_identifier()) {
                        return false;
                    }
                } else {
                    return true;
                }
            }
        }
    }
    return parser_error(CompilerErrorCode.ParseCallGuardExhausted);
}

function parser_parse_unary(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let kind: TokenKind = parser_current_kind();
    if (kind == TokenKind.Bang || kind == TokenKind.Minus || kind == TokenKind.Plus) {
        Compiler.parse_index += 1;
        return parser_parse_unary(stop_a, stop_b, stop_c);
    }
    return parser_parse_postfix(stop_a, stop_b, stop_c);
}

function parser_parse_expression_precedence(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind,
    min_prec: i32
): bool {
    if (!parser_parse_unary(stop_a, stop_b, stop_c)) {
        return false;
    }

    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD; guard += 1) {
        let op: TokenKind = parser_current_kind();
        if (parser_is_expression_stop(op, stop_a, stop_b, stop_c)) {
            return true;
        }
        let prec: i32 = parser_binary_precedence(op);
        if (prec < min_prec) {
            return true;
        }

        Compiler.parse_index += 1;
        let next_min_prec: i32 = prec + 1;
        if (parser_is_assignment_op(op)) {
            next_min_prec = prec; // right-associative
        }
        if (!parser_parse_expression_precedence(stop_a, stop_b, stop_c, next_min_prec)) {
            return parser_error(CompilerErrorCode.ParseExpectExpression);
        }
    }
    return parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
}

function parser_parse_expression_until(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind,
    missing_expr_code: i32
): bool {
    let start_index: i32 = Compiler.parse_index;
    if (!parser_parse_expression_precedence(stop_a, stop_b, stop_c, 1)) {
        if (Compiler.parse_index == start_index) {
            return parser_error(missing_expr_code);
        }
        return false;
    }
    return true;
}

function parser_parse_expression_statement(): bool {
    if (!parser_parse_expression_until(
        TokenKind.Semicolon,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectExpression
    )) {
        return false;
    }
    return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
}

function parser_parse_return_statement(): bool {
    Compiler.parse_index += 1;
    if (parser_current_kind() == TokenKind.Semicolon) {
        return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
    }
    if (!parser_parse_expression_until(
        TokenKind.Semicolon,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectReturnExpr
    )) {
        return false;
    }
    return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
}

function parser_parse_let_statement(): bool {
    Compiler.parse_index += 1;

    if (!parser_capture_identifier()) {
        return false;
    }

    let has_type: i32 = 0;
    let has_init: i32 = 0;

    if (parser_match(TokenKind.Colon)) {
        has_type = 1;
        if (!parser_capture_identifier()) {
            return false;
        }
    }

    if (parser_match(TokenKind.Assign)) {
        has_init = 1;
        if (!parser_parse_expression_until(
            TokenKind.Semicolon,
            TokenKind.Invalid,
            TokenKind.Invalid,
            CompilerErrorCode.ParseExpectExpression
        )) {
            return false;
        }
    }

    if (has_type == 0 && has_init == 0) {
        return parser_error(CompilerErrorCode.ParseExpectAssignInLet);
    }
    return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
}

function parser_parse_statement_or_block(): bool {
    if (parser_current_kind() == TokenKind.LBrace) {
        Compiler.parse_index += 1;
        let guard: i32 = 0;
        for (guard = 0; guard < COMPILER_MAX_BODY_STMTS; guard += 1) {
            if (parser_current_kind() == TokenKind.RBrace) {
                Compiler.parse_index += 1;
                return true;
            }
            if (parser_current_kind() == TokenKind.Eof) {
                return parser_error(CompilerErrorCode.ParseExpectRBrace);
            }
            if (!parser_parse_statement()) {
                return false;
            }
        }
        return parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
    }
    return parser_parse_statement();
}

function parser_parse_if_statement(): bool {
    Compiler.parse_index += 1;

    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }
    if (!parser_parse_expression_until(
        TokenKind.RParen,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectExpression
    )) {
        return false;
    }
    if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
        return false;
    }
    if (!parser_parse_statement_or_block()) {
        return false;
    }

    if (parser_match(TokenKind.KwElse)) {
        if (parser_current_kind() == TokenKind.KwIf) {
            return parser_parse_if_statement();
        }
        return parser_parse_statement_or_block();
    }
    return true;
}

function parser_parse_for_init_clause(): bool {
    if (parser_current_kind() == TokenKind.KwLet) {
        Compiler.parse_index += 1;
        if (!parser_capture_identifier()) {
            return false;
        }
        if (parser_match(TokenKind.Colon)) {
            if (!parser_capture_identifier()) {
                return false;
            }
        }
        if (!parser_match(TokenKind.Assign)) {
            return parser_error(CompilerErrorCode.ParseExpectAssignInLet);
        }
        return parser_parse_expression_until(
            TokenKind.Semicolon,
            TokenKind.Invalid,
            TokenKind.Invalid,
            CompilerErrorCode.ParseExpectExpression
        );
    }
    return parser_parse_expression_until(
        TokenKind.Semicolon,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectExpression
    );
}

function parser_parse_for_statement(): bool {
    Compiler.parse_index += 1;

    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }

    if (parser_current_kind() == TokenKind.Semicolon) {
        return parser_error(CompilerErrorCode.ParseExpectExpression);
    }
    if (!parser_parse_for_init_clause()) {
        return false;
    }
    if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
        return false;
    }

    if (!parser_parse_expression_until(
        TokenKind.Semicolon,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectExpression
    )) {
        return false;
    }
    if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
        return false;
    }

    if (!parser_parse_expression_until(
        TokenKind.RParen,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectExpression
    )) {
        return false;
    }
    if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
        return false;
    }

    return parser_parse_statement_or_block();
}

function parser_parse_foreach_statement(): bool {
    Compiler.parse_index += 1;

    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }
    if (!parser_capture_identifier()) {
        return false;
    }
    if (parser_match(TokenKind.Comma)) {
        if (!parser_capture_identifier()) {
            return false;
        }
    }
    if (!parser_expect(TokenKind.KwIn, CompilerErrorCode.ParseExpectIn)) {
        return false;
    }
    if (!parser_parse_expression_until(
        TokenKind.RParen,
        TokenKind.Invalid,
        TokenKind.Invalid,
        CompilerErrorCode.ParseExpectExpression
    )) {
        return false;
    }
    if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
        return false;
    }
    return parser_parse_statement_or_block();
}

function parser_parse_statement(): bool {
    let kind: TokenKind = parser_current_kind();
    if (kind == TokenKind.KwReturn) {
        return parser_parse_return_statement();
    }
    if (kind == TokenKind.KwLet) {
        return parser_parse_let_statement();
    }
    if (kind == TokenKind.KwIf) {
        return parser_parse_if_statement();
    }
    if (kind == TokenKind.KwFor) {
        return parser_parse_for_statement();
    }
    if (kind == TokenKind.KwForeach) {
        return parser_parse_foreach_statement();
    }
    if (kind == TokenKind.Semicolon) {
        Compiler.parse_index += 1;
        return true;
    }
    if (kind == TokenKind.LBrace) {
        return parser_parse_statement_or_block();
    }
    return parser_parse_expression_statement();
}
function parser_parse_parameter_list(): bool {
    Compiler.current_signature_param_count = 0;
    Compiler.current_signature_first_param_type_code = 0;
    Compiler.current_signature_param_name_hashes[0] = 0;
    Compiler.current_signature_param_name_hashes[1] = 0;
    Compiler.current_signature_param_name_hashes[2] = 0;
    Compiler.current_signature_param_name_hashes[3] = 0;

    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }
    if (parser_match(TokenKind.RParen)) {
        return true;
    }

    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARAMS; guard += 1) {
        if (!parser_capture_identifier()) {
            return false;
        }
        let param_name_hash: i32 = compiler_hash_source_span(
            216613626,
            Compiler.captured_identifier_start,
            Compiler.captured_identifier_len
        );
        if (Compiler.current_signature_param_count < COMPILER_MAX_TRACKED_PARAM_HASHES) {
            Compiler.current_signature_param_name_hashes[Compiler.current_signature_param_count] = param_name_hash;
        }
        if (!parser_expect(TokenKind.Colon, CompilerErrorCode.ParseExpectColon)) {
            return false;
        }
        if (!parser_capture_identifier()) {
            return false;
        }
        if (Compiler.current_signature_param_count == 0) {
            Compiler.current_signature_first_param_type_code = parser_type_code_from_identifier_span(
                Compiler.captured_identifier_start,
                Compiler.captured_identifier_len
            );
        }
        Compiler.current_signature_param_count += 1;

        if (!parser_match(TokenKind.Comma)) {
            return parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen);
        }
    }
    return parser_error(CompilerErrorCode.ParseParamGuardExhausted);
}

function parser_parse_signature_after_function_keyword(): bool {
    if (!parser_capture_identifier()) {
        return false;
    }
    Compiler.current_signature_name_start = Compiler.captured_identifier_start;
    Compiler.current_signature_name_len = Compiler.captured_identifier_len;

    if (!parser_parse_parameter_list()) {
        return false;
    }

    if (parser_match(TokenKind.Colon)) {
        if (!parser_capture_identifier()) {
            return false;
        }
        Compiler.current_signature_return_type_start = Compiler.captured_identifier_start;
        Compiler.current_signature_return_type_len = Compiler.captured_identifier_len;
    } else {
        Compiler.current_signature_return_type_start = 0;
        Compiler.current_signature_return_type_len = 0;
    }

    parser_note_main_signature_if_needed();
    return true;
}

function parser_record_function_fingerprint(
    signature_start_token: i32,
    signature_end_token: i32,
    body_start_token: i32,
    body_end_token: i32
): void {
    let id_hash: i32 = compiler_hash_source_span(
        216613626,
        Compiler.current_signature_name_start,
        Compiler.current_signature_name_len
    );

    let signature_hash: i32 = compiler_hash_source_span(
        216613626,
        Compiler.tokens[signature_start_token].start,
        Compiler.tokens[signature_end_token].end - Compiler.tokens[signature_start_token].start
    );
    let mixed_signature_hash: i32 = compiler_hash_mix(signature_hash, Compiler.current_signature_param_count);
    let final_signature_hash: i32 = compiler_hash_mix(mixed_signature_hash, id_hash);

    let body_hash: i32 = compiler_hash_source_span(
        216613626,
        Compiler.tokens[body_start_token].start,
        Compiler.tokens[body_end_token].end - Compiler.tokens[body_start_token].start
    );
    let final_body_hash: i32 = compiler_hash_mix(body_hash, id_hash);
    let return_type_code: i32 = parser_return_type_code();

    Compiler.current_simple_i32_return_literal_flag = 0;
    Compiler.current_simple_i32_return_literal_value = 0;
    if (
        return_type_code == 1 &&
        body_end_token - body_start_token == 4 &&
        Compiler.tokens[body_start_token].kind == TokenKind.LBrace &&
        Compiler.tokens[body_start_token + 1].kind == TokenKind.KwReturn &&
        Compiler.tokens[body_start_token + 2].kind == TokenKind.IntLiteral &&
        Compiler.tokens[body_start_token + 3].kind == TokenKind.Semicolon &&
        Compiler.tokens[body_start_token + 4].kind == TokenKind.RBrace
    ) {
        Compiler.current_simple_i32_return_literal_flag = 1;
        Compiler.current_simple_i32_return_literal_value = Compiler.tokens[body_start_token + 2].int_value;
    }

    compiler_record_current_function(
        id_hash,
        final_signature_hash,
        final_body_hash,
        return_type_code,
        Compiler.current_signature_param_count,
        Compiler.current_signature_first_param_type_code,
        Compiler.current_simple_i32_return_literal_flag,
        Compiler.current_simple_i32_return_literal_value,
        signature_start_token,
        signature_end_token,
        body_start_token,
        body_end_token
    );
}

function compiler_abs_i32(value: i32): i32 {
    if (value < 0) {
        if (value == -2147483648) {
            return 2147483647;
        }
        return 0 - value;
    }
    return value;
}

function compiler_emit_symbol_name_for_index(index: i32, out: ascii[]): void {
    ascii_clear(out);
    ascii_append(out, "fn_");
    ascii_push_i32(out, compiler_abs_i32(Compiler.function_id_hashes[index]));
    ascii_push(out, 95);
    ascii_push_i32(out, compiler_abs_i32(Compiler.function_sig_hashes[index]));
    ascii_push(out, 95);
    ascii_push_i32(out, index);
}

function compiler_emit_clif_call_conv(out: ascii[]): void {
    if (Compiler.clif_call_conv_code == 2) {
        ascii_append(out, "system_v");
        return;
    }
    ascii_append(out, "windows_fastcall");
}

function compiler_emit_clif_i32_param_list(out: ascii[], param_count: i32): bool {
    if (param_count < 0 || param_count > COMPILER_MAX_TRACKED_PARAM_HASHES) {
        return false;
    }
    ascii_append(out, "(");
    let i: i32 = 0;
    for (i = 0; i < param_count; i += 1) {
        if (i > 0) {
            ascii_append(out, ", ");
        }
        ascii_append(out, "i32");
    }
    ascii_append(out, ")");
    return true;
}

function compiler_find_param_index_for_identifier_hash(function_index: i32, identifier_hash: i32): i32 {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return -1;
    }
    let param_count: i32 = Compiler.function_param_counts[function_index];
    if (param_count < 0) {
        return -1;
    }
    if (param_count > COMPILER_MAX_TRACKED_PARAM_HASHES) {
        param_count = COMPILER_MAX_TRACKED_PARAM_HASHES;
    }

    let param_base: i32 = function_index * COMPILER_MAX_TRACKED_PARAM_HASHES;
    let i: i32 = 0;
    for (i = 0; i < param_count; i += 1) {
        if (Compiler.function_param_name_hashes[param_base + i] == identifier_hash) {
            return i;
        }
    }
    return -1;
}

function compiler_emit_simple_operand_register(
    function_index: i32,
    token_index: i32,
    literal_slot: i32,
    out: ascii[]
): i32 {
    if (token_index < 0 || token_index >= Compiler.token_count) {
        return -1;
    }
    let kind: TokenKind = Compiler.tokens[token_index].kind;
    if (kind == TokenKind.Identifier) {
        return compiler_find_param_index_for_identifier_hash(
            function_index,
            compiler_eval_identifier_hash_at(token_index)
        );
    }
    if (kind == TokenKind.IntLiteral) {
        ascii_append(out, "v");
        ascii_push_i32(out, literal_slot);
        ascii_append(out, " = iconst.i32 ");
        ascii_push_i32(out, Compiler.tokens[token_index].int_value);
        ascii_append(out, "\n");
        return literal_slot;
    }
    return -1;
}

function compiler_emit_simple_binary_instruction(
    op: TokenKind,
    result_reg: i32,
    left_reg: i32,
    right_reg: i32,
    out: ascii[]
): bool {
    ascii_append(out, "v");
    ascii_push_i32(out, result_reg);
    ascii_append(out, " = ");

    if (op == TokenKind.Plus) {
        ascii_append(out, "iadd");
    } else {
        if (op == TokenKind.Minus) {
            ascii_append(out, "isub");
        } else {
            if (op == TokenKind.Star) {
                ascii_append(out, "imul");
            } else {
                if (op == TokenKind.Slash) {
                    ascii_append(out, "sdiv");
                } else {
                    if (op == TokenKind.Percent) {
                        ascii_append(out, "srem");
                    } else {
                        return false;
                    }
                }
            }
        }
    }

    ascii_append(out, " v");
    ascii_push_i32(out, left_reg);
    ascii_append(out, ", v");
    ascii_push_i32(out, right_reg);
    ascii_append(out, "\n");
    return true;
}

function compiler_emit_simple_i32_param_return_body(function_index: i32, out: ascii[]): bool {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return false;
    }
    let param_count: i32 = Compiler.function_param_counts[function_index];
    if (param_count <= 0 || param_count > COMPILER_MAX_TRACKED_PARAM_HASHES) {
        return false;
    }
    if (Compiler.function_first_param_type_codes[function_index] != 1) {
        return false;
    }
    if (Compiler.function_return_type_codes[function_index] != 1) {
        return false;
    }

    let body_start: i32 = Compiler.function_body_start_tokens[function_index];
    let body_end: i32 = Compiler.function_body_end_tokens[function_index];
    if (
        body_start < 0 ||
        body_end <= body_start ||
        Compiler.tokens[body_start].kind != TokenKind.LBrace ||
        Compiler.tokens[body_end].kind != TokenKind.RBrace
    ) {
        return false;
    }
    if (Compiler.tokens[body_start + 1].kind != TokenKind.KwReturn) {
        return false;
    }
    if (Compiler.tokens[body_end - 1].kind != TokenKind.Semicolon) {
        return false;
    }

    let expr_start: i32 = body_start + 2;
    let expr_end: i32 = body_end - 2;
    if (expr_start > expr_end) {
        return false;
    }

    let has_outer_parens: bool = false;
    if (
        Compiler.tokens[expr_start].kind == TokenKind.LParen &&
        Compiler.tokens[expr_end].kind == TokenKind.RParen
    ) {
        has_outer_parens = true;
        expr_start += 1;
        expr_end -= 1;
        if (expr_start > expr_end) {
            return false;
        }
    }

    let return_reg: i32 = -1;
    if (expr_start == expr_end) {
        return_reg = compiler_emit_simple_operand_register(
            function_index,
            expr_start,
            param_count,
            out
        );
        if (return_reg < 0) {
            return false;
        }
    } else {
        if (expr_end - expr_start == 2) {
            let left_is_literal: bool = Compiler.tokens[expr_start].kind == TokenKind.IntLiteral;
            let right_is_literal: bool = Compiler.tokens[expr_start + 2].kind == TokenKind.IntLiteral;

            let left_slot: i32 = param_count;
            let right_slot: i32 = param_count;
            if (left_is_literal) {
                right_slot = param_count + 1;
            }

            let left_reg: i32 = compiler_emit_simple_operand_register(
                function_index,
                expr_start,
                left_slot,
                out
            );
            if (left_reg < 0) {
                return false;
            }
            let right_reg: i32 = compiler_emit_simple_operand_register(
                function_index,
                expr_start + 2,
                right_slot,
                out
            );
            if (right_reg < 0) {
                return false;
            }

            let temp_count: i32 = 0;
            if (left_is_literal) {
                temp_count += 1;
            }
            if (right_is_literal) {
                temp_count += 1;
            }

            return_reg = param_count + temp_count;
            if (
                !compiler_emit_simple_binary_instruction(
                    Compiler.tokens[expr_start + 1].kind,
                    return_reg,
                    left_reg,
                    right_reg,
                    out
                )
            ) {
                return false;
            }
        } else {
            if (
                has_outer_parens &&
                expr_end - expr_start == 4 &&
                Compiler.tokens[expr_start].kind == TokenKind.LParen &&
                Compiler.tokens[expr_end].kind == TokenKind.RParen
            ) {
                let left_is_literal_nested: bool = Compiler.tokens[expr_start + 1].kind == TokenKind.IntLiteral;
                let right_is_literal_nested: bool = Compiler.tokens[expr_start + 3].kind == TokenKind.IntLiteral;

                let left_slot_nested: i32 = param_count;
                let right_slot_nested: i32 = param_count;
                if (left_is_literal_nested) {
                    right_slot_nested = param_count + 1;
                }

                let left_reg_nested: i32 = compiler_emit_simple_operand_register(
                    function_index,
                    expr_start + 1,
                    left_slot_nested,
                    out
                );
                if (left_reg_nested < 0) {
                    return false;
                }
                let right_reg_nested: i32 = compiler_emit_simple_operand_register(
                    function_index,
                    expr_start + 3,
                    right_slot_nested,
                    out
                );
                if (right_reg_nested < 0) {
                    return false;
                }

                let temp_count_nested: i32 = 0;
                if (left_is_literal_nested) {
                    temp_count_nested += 1;
                }
                if (right_is_literal_nested) {
                    temp_count_nested += 1;
                }

                return_reg = param_count + temp_count_nested;
                if (
                    !compiler_emit_simple_binary_instruction(
                        Compiler.tokens[expr_start + 2].kind,
                        return_reg,
                        left_reg_nested,
                        right_reg_nested,
                        out
                    )
                ) {
                    return false;
                }
            } else {
                return false;
            }
        }
    }

    ascii_append(out, "return v");
    ascii_push_i32(out, return_reg);
    ascii_append(out, "\n}\n");
    return true;
}

function compiler_eval_current_kind(): TokenKind {
    if (Compiler.eval_cursor < 0 || Compiler.eval_cursor >= Compiler.token_count) {
        return TokenKind.Eof;
    }
    return Compiler.tokens[Compiler.eval_cursor].kind;
}

function compiler_eval_kind_at(index: i32): TokenKind {
    if (index < 0 || index >= Compiler.token_count) {
        return TokenKind.Eof;
    }
    return Compiler.tokens[index].kind;
}

function compiler_eval_identifier_hash_at(token_index: i32): i32 {
    if (token_index < 0 || token_index >= Compiler.token_count) {
        return 0;
    }
    return compiler_hash_source_span(
        216613626,
        Compiler.tokens[token_index].text_start,
        Compiler.tokens[token_index].text_len
    );
}

function compiler_eval_find_binding_index(name_hash: i32): i32 {
    let i: i32 = 0;
    let found: i32 = -1;
    for (i = 0; i < Compiler.eval_binding_count; i += 1) {
        if (Compiler.eval_binding_name_hashes[i] == name_hash) {
            found = i;
        }
    }
    return found;
}

function compiler_eval_set_binding(name_hash: i32, value: i32): bool {
    let existing: i32 = compiler_eval_find_binding_index(name_hash);
    if (existing >= 0) {
        Compiler.eval_binding_values[existing] = value;
        return true;
    }
    if (Compiler.eval_binding_count >= COMPILER_MAX_EVAL_BINDINGS) {
        return false;
    }
    let slot: i32 = Compiler.eval_binding_count;
    Compiler.eval_binding_count += 1;
    Compiler.eval_binding_name_hashes[slot] = name_hash;
    Compiler.eval_binding_values[slot] = value;
    return true;
}

function compiler_eval_clear_field_table(): void {
    Compiler.eval_field_count = 0;
    let i: i32 = 0;
    for (i = 0; i < COMPILER_MAX_EVAL_BINDINGS; i += 1) {
        Compiler.eval_field_used[i] = 0;
        Compiler.eval_field_path_hashes[i] = 0;
        Compiler.eval_field_values[i] = 0;
    }
}

function compiler_eval_field_start_slot(path_hash: i32): i32 {
    let hash: i32 = path_hash;
    if (hash < 0) {
        hash = 0 - hash;
        if (hash < 0) {
            hash = 0;
        }
    }
    return hash % COMPILER_MAX_EVAL_BINDINGS;
}

function compiler_eval_find_field_index(path_hash: i32): i32 {
    if (Compiler.eval_field_count <= 0) {
        return -1;
    }
    let start: i32 = compiler_eval_field_start_slot(path_hash);
    let probe: i32 = 0;
    for (probe = 0; probe < COMPILER_MAX_EVAL_BINDINGS; probe += 1) {
        let slot: i32 = (start + probe) % COMPILER_MAX_EVAL_BINDINGS;
        if (Compiler.eval_field_used[slot] == 0) {
            return -1;
        }
        if (Compiler.eval_field_path_hashes[slot] == path_hash) {
            return slot;
        }
    }
    return -1;
}

function compiler_eval_set_field(path_hash: i32, value: i32): bool {
    let start: i32 = compiler_eval_field_start_slot(path_hash);
    let probe: i32 = 0;
    for (probe = 0; probe < COMPILER_MAX_EVAL_BINDINGS; probe += 1) {
        let slot: i32 = (start + probe) % COMPILER_MAX_EVAL_BINDINGS;
        if (Compiler.eval_field_used[slot] == 0) {
            if (Compiler.eval_field_count >= COMPILER_MAX_EVAL_BINDINGS) {
                return false;
            }
            Compiler.eval_field_used[slot] = 1;
            Compiler.eval_field_path_hashes[slot] = path_hash;
            Compiler.eval_field_values[slot] = value;
            Compiler.eval_field_count += 1;
            return true;
        }
        if (Compiler.eval_field_path_hashes[slot] == path_hash) {
            Compiler.eval_field_values[slot] = value;
            return true;
        }
    }
    return false;
}

function compiler_eval_assignment_op_index_at(start_index: i32): i32 {
    if (compiler_eval_kind_at(start_index) != TokenKind.Identifier) {
        return -1;
    }
    let cursor: i32 = start_index + 1;
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        if (
            compiler_eval_kind_at(cursor) == TokenKind.Dot &&
            compiler_eval_kind_at(cursor + 1) == TokenKind.Identifier
        ) {
            cursor += 2;
        } else {
            if (parser_is_assignment_op(compiler_eval_kind_at(cursor))) {
                return cursor;
            }
            return -1;
        }
    }
    return -1;
}

function compiler_eval_is_assignment_start(): bool {
    return compiler_eval_assignment_op_index_at(Compiler.eval_cursor) >= 0;
}

function compiler_eval_compute_assignment_value(op: TokenKind, current_value: i32, rhs: i32): bool {
    if (op == TokenKind.Assign) {
        Compiler.eval_last_i32 = rhs;
        return true;
    }
    if (op == TokenKind.PlusEq) {
        Compiler.eval_last_i32 = current_value + rhs;
        return true;
    }
    if (op == TokenKind.MinusEq) {
        Compiler.eval_last_i32 = current_value - rhs;
        return true;
    }
    if (op == TokenKind.StarEq) {
        Compiler.eval_last_i32 = current_value * rhs;
        return true;
    }
    if (op == TokenKind.SlashEq) {
        if (rhs == 0) {
            return false;
        }
        Compiler.eval_last_i32 = current_value / rhs;
        return true;
    }
    if (op == TokenKind.PercentEq) {
        if (rhs == 0) {
            return false;
        }
        Compiler.eval_last_i32 = current_value % rhs;
        return true;
    }
    return false;
}

function compiler_eval_find_matching_rbrace(lbrace_token: i32): i32 {
    if (lbrace_token < 0 || lbrace_token >= Compiler.token_count) {
        return -1;
    }
    let depth: i32 = 0;
    let i: i32 = 0;
    for (i = lbrace_token; i < Compiler.token_count; i += 1) {
        let kind: TokenKind = Compiler.tokens[i].kind;
        if (kind == TokenKind.LBrace) {
            depth += 1;
        } else {
            if (kind == TokenKind.RBrace) {
                depth -= 1;
                if (depth == 0) {
                    return i;
                }
            }
        }
    }
    return -1;
}

function compiler_eval_is_stop(
    kind: TokenKind,
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    return kind == stop_a || kind == stop_b || kind == stop_c;
}

function compiler_eval_binary_precedence(kind: TokenKind): i32 {
    if (kind == TokenKind.OrOr) { return 2; }
    if (kind == TokenKind.AndAnd) { return 3; }
    if (kind == TokenKind.EqEq || kind == TokenKind.NotEq) { return 4; }
    if (
        kind == TokenKind.Less ||
        kind == TokenKind.LessEq ||
        kind == TokenKind.Greater ||
        kind == TokenKind.GreaterEq
    ) { return 5; }
    if (kind == TokenKind.Plus || kind == TokenKind.Minus) { return 6; }
    if (kind == TokenKind.Star || kind == TokenKind.Slash || kind == TokenKind.Percent) { return 7; }
    return 0;
}

function compiler_eval_apply_binary(op: TokenKind, left: i32, right: i32): bool {
    if (op == TokenKind.Plus) {
        Compiler.eval_last_i32 = left + right;
        return true;
    }
    if (op == TokenKind.Minus) {
        Compiler.eval_last_i32 = left - right;
        return true;
    }
    if (op == TokenKind.Star) {
        Compiler.eval_last_i32 = left * right;
        return true;
    }
    if (op == TokenKind.Slash) {
        if (right == 0) {
            return false;
        }
        Compiler.eval_last_i32 = left / right;
        return true;
    }
    if (op == TokenKind.Percent) {
        if (right == 0) {
            return false;
        }
        Compiler.eval_last_i32 = left % right;
        return true;
    }
    if (op == TokenKind.EqEq) {
        Compiler.eval_last_i32 = 0;
        if (left == right) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.NotEq) {
        Compiler.eval_last_i32 = 0;
        if (left != right) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.Less) {
        Compiler.eval_last_i32 = 0;
        if (left < right) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.LessEq) {
        Compiler.eval_last_i32 = 0;
        if (left <= right) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.Greater) {
        Compiler.eval_last_i32 = 0;
        if (left > right) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.GreaterEq) {
        Compiler.eval_last_i32 = 0;
        if (left >= right) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.AndAnd) {
        Compiler.eval_last_i32 = 0;
        if (left != 0 && right != 0) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    if (op == TokenKind.OrOr) {
        Compiler.eval_last_i32 = 0;
        if (left != 0 || right != 0) {
            Compiler.eval_last_i32 = 1;
        }
        return true;
    }
    return false;
}

function compiler_eval_call_arg_value(
    arg_index: i32,
    arg0: i32,
    arg1: i32,
    arg2: i32,
    arg3: i32
): i32 {
    if (arg_index == 0) { return arg0; }
    if (arg_index == 1) { return arg1; }
    if (arg_index == 2) { return arg2; }
    if (arg_index == 3) { return arg3; }
    return 0;
}

function compiler_eval_execute_block_until(end_token: i32): bool {
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_BODY_STMTS; guard += 1) {
        if (Compiler.eval_returned) {
            return true;
        }
        if (Compiler.eval_cursor >= end_token) {
            return true;
        }
        if (!compiler_eval_execute_statement()) {
            return false;
        }
    }
    return false;
}

function compiler_eval_call_function_by_hash(
    id_hash: i32,
    arg_count: i32,
    arg0: i32,
    arg1: i32,
    arg2: i32,
    arg3: i32
): bool {
    let function_index: i32 = compiler_find_current_function_index(id_hash);
    if (function_index < 0) {
        return false;
    }
    return compiler_eval_execute_function(function_index, arg_count, arg0, arg1, arg2, arg3);
}

function compiler_eval_parse_primary(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let kind: TokenKind = compiler_eval_current_kind();
    if (compiler_eval_is_stop(kind, stop_a, stop_b, stop_c)) {
        return false;
    }

    if (kind == TokenKind.IntLiteral) {
        Compiler.eval_last_i32 = Compiler.tokens[Compiler.eval_cursor].int_value;
        Compiler.eval_cursor += 1;
        return true;
    }

    if (kind == TokenKind.Identifier) {
        let token_index: i32 = Compiler.eval_cursor;
        let identifier_hash: i32 = compiler_eval_identifier_hash_at(token_index);
        Compiler.eval_cursor += 1;

        if (compiler_eval_current_kind() == TokenKind.LParen) {
            Compiler.eval_cursor += 1;

            let arg_count: i32 = 0;
            let arg0: i32 = 0;
            let arg1: i32 = 0;
            let arg2: i32 = 0;
            let arg3: i32 = 0;

            if (compiler_eval_current_kind() != TokenKind.RParen) {
                let done: i32 = 0;
                let arg_guard: i32 = 0;
                for (arg_guard = 0; arg_guard < COMPILER_MAX_ARGS && done == 0; arg_guard += 1) {
                    if (!compiler_eval_parse_expression_precedence(
                        TokenKind.Comma,
                        TokenKind.RParen,
                        TokenKind.Invalid,
                        1
                    )) {
                        return false;
                    }
                    if (arg_count >= COMPILER_MAX_EVAL_CALL_ARGS) {
                        return false;
                    }
                    if (arg_count == 0) { arg0 = Compiler.eval_last_i32; }
                    if (arg_count == 1) { arg1 = Compiler.eval_last_i32; }
                    if (arg_count == 2) { arg2 = Compiler.eval_last_i32; }
                    if (arg_count == 3) { arg3 = Compiler.eval_last_i32; }
                    arg_count += 1;

                    if (compiler_eval_current_kind() == TokenKind.Comma) {
                        Compiler.eval_cursor += 1;
                    } else {
                        done = 1;
                    }
                }
                if (done == 0) {
                    return false;
                }
            }

            if (compiler_eval_current_kind() != TokenKind.RParen) {
                return false;
            }
            Compiler.eval_cursor += 1;
            return compiler_eval_call_function_by_hash(
                identifier_hash,
                arg_count,
                arg0,
                arg1,
                arg2,
                arg3
            );
        }

        let path_hash: i32 = identifier_hash;
        let has_field_path: bool = false;
        let path_guard: i32 = 0;
        let path_done: i32 = 0;
        for (path_guard = 0; path_guard < COMPILER_MAX_CALL_NEST && path_done == 0; path_guard += 1) {
            if (compiler_eval_current_kind() != TokenKind.Dot) {
                path_done = 1;
            } else {
                has_field_path = true;
                Compiler.eval_cursor += 1;
                if (compiler_eval_current_kind() != TokenKind.Identifier) {
                    return false;
                }
                path_hash = compiler_hash_mix(path_hash, 46);
                path_hash = compiler_hash_mix(path_hash, compiler_eval_identifier_hash_at(Compiler.eval_cursor));
                Compiler.eval_cursor += 1;
            }
        }
        if (path_done == 0) {
            return false;
        }

        if (has_field_path) {
            let field_index: i32 = compiler_eval_find_field_index(path_hash);
            if (field_index >= 0) {
                Compiler.eval_last_i32 = Compiler.eval_field_values[field_index];
                return true;
            }
            Compiler.eval_last_i32 = 0;
            return true;
        }

        let binding_index: i32 = compiler_eval_find_binding_index(identifier_hash);
        if (binding_index >= 0) {
            Compiler.eval_last_i32 = Compiler.eval_binding_values[binding_index];
            return true;
        }
        if (compiler_span_eq(
            Compiler.tokens[token_index].text_start,
            Compiler.tokens[token_index].text_len,
            "true"
        )) {
            Compiler.eval_last_i32 = 1;
            return true;
        }
        if (compiler_span_eq(
            Compiler.tokens[token_index].text_start,
            Compiler.tokens[token_index].text_len,
            "false"
        )) {
            Compiler.eval_last_i32 = 0;
            return true;
        }
        return false;
    }

    if (kind == TokenKind.LParen) {
        Compiler.eval_cursor += 1;
        if (!compiler_eval_parse_expression_precedence(
            TokenKind.RParen,
            TokenKind.Invalid,
            TokenKind.Invalid,
            1
        )) {
            return false;
        }
        if (compiler_eval_current_kind() != TokenKind.RParen) {
            return false;
        }
        Compiler.eval_cursor += 1;
        return true;
    }

    return false;
}

function compiler_eval_parse_unary(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let kind: TokenKind = compiler_eval_current_kind();
    if (kind == TokenKind.Bang || kind == TokenKind.Minus || kind == TokenKind.Plus) {
        Compiler.eval_cursor += 1;
        if (!compiler_eval_parse_unary(stop_a, stop_b, stop_c)) {
            return false;
        }
        if (kind == TokenKind.Bang) {
            if (Compiler.eval_last_i32 == 0) {
                Compiler.eval_last_i32 = 1;
            } else {
                Compiler.eval_last_i32 = 0;
            }
            return true;
        }
        if (kind == TokenKind.Minus) {
            Compiler.eval_last_i32 = 0 - Compiler.eval_last_i32;
            return true;
        }
        return true;
    }
    return compiler_eval_parse_primary(stop_a, stop_b, stop_c);
}

function compiler_eval_skip_primary(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let kind: TokenKind = compiler_eval_current_kind();
    if (compiler_eval_is_stop(kind, stop_a, stop_b, stop_c)) {
        return false;
    }

    if (kind == TokenKind.IntLiteral || kind == TokenKind.Identifier) {
        Compiler.eval_cursor += 1;
        let postfix_guard: i32 = 0;
        let postfix_done: i32 = 0;
        for (postfix_guard = 0; postfix_guard < COMPILER_MAX_CALL_NEST && postfix_done == 0; postfix_guard += 1) {
            if (compiler_eval_current_kind() == TokenKind.LParen) {
                Compiler.eval_cursor += 1;
                if (compiler_eval_current_kind() != TokenKind.RParen) {
                    let done: i32 = 0;
                    let arg_guard: i32 = 0;
                    for (arg_guard = 0; arg_guard < COMPILER_MAX_ARGS && done == 0; arg_guard += 1) {
                        if (!compiler_eval_skip_expression_precedence(
                            TokenKind.Comma,
                            TokenKind.RParen,
                            TokenKind.Invalid,
                            1
                        )) {
                            return false;
                        }
                        if (compiler_eval_current_kind() == TokenKind.Comma) {
                            Compiler.eval_cursor += 1;
                        } else {
                            done = 1;
                        }
                    }
                    if (done == 0) {
                        return false;
                    }
                }
                if (compiler_eval_current_kind() != TokenKind.RParen) {
                    return false;
                }
                Compiler.eval_cursor += 1;
            } else {
                if (compiler_eval_current_kind() == TokenKind.Dot) {
                    Compiler.eval_cursor += 1;
                    if (compiler_eval_current_kind() != TokenKind.Identifier) {
                        return false;
                    }
                    Compiler.eval_cursor += 1;
                } else {
                    postfix_done = 1;
                }
            }
        }
        if (postfix_done == 0) {
            return false;
        }
        return true;
    }

    if (kind == TokenKind.LParen) {
        Compiler.eval_cursor += 1;
        if (!compiler_eval_skip_expression_precedence(
            TokenKind.RParen,
            TokenKind.Invalid,
            TokenKind.Invalid,
            1
        )) {
            return false;
        }
        if (compiler_eval_current_kind() != TokenKind.RParen) {
            return false;
        }
        Compiler.eval_cursor += 1;
        return true;
    }

    return false;
}

function compiler_eval_skip_unary(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let kind: TokenKind = compiler_eval_current_kind();
    if (kind == TokenKind.Bang || kind == TokenKind.Minus || kind == TokenKind.Plus) {
        Compiler.eval_cursor += 1;
        return compiler_eval_skip_unary(stop_a, stop_b, stop_c);
    }
    return compiler_eval_skip_primary(stop_a, stop_b, stop_c);
}

function compiler_eval_skip_expression_precedence(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind,
    min_prec: i32
): bool {
    if (!compiler_eval_skip_unary(stop_a, stop_b, stop_c)) {
        return false;
    }

    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD; guard += 1) {
        let op: TokenKind = compiler_eval_current_kind();
        if (compiler_eval_is_stop(op, stop_a, stop_b, stop_c)) {
            return true;
        }
        let prec: i32 = compiler_eval_binary_precedence(op);
        if (prec < min_prec) {
            return true;
        }

        Compiler.eval_cursor += 1;
        if (!compiler_eval_skip_expression_precedence(stop_a, stop_b, stop_c, prec + 1)) {
            return false;
        }
    }
    return false;
}

function compiler_eval_parse_expression_precedence(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind,
    min_prec: i32
): bool {
    if (!compiler_eval_parse_unary(stop_a, stop_b, stop_c)) {
        return false;
    }

    let left: i32 = Compiler.eval_last_i32;
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD; guard += 1) {
        let op: TokenKind = compiler_eval_current_kind();
        if (compiler_eval_is_stop(op, stop_a, stop_b, stop_c)) {
            Compiler.eval_last_i32 = left;
            return true;
        }
        let prec: i32 = compiler_eval_binary_precedence(op);
        if (prec < min_prec) {
            Compiler.eval_last_i32 = left;
            return true;
        }

        Compiler.eval_cursor += 1;
        let skipped_rhs: i32 = 0;
        if (op == TokenKind.AndAnd && left == 0) {
            if (!compiler_eval_skip_expression_precedence(stop_a, stop_b, stop_c, prec + 1)) {
                return false;
            }
            Compiler.eval_last_i32 = 0;
            left = 0;
            skipped_rhs = 1;
        }
        if (skipped_rhs == 0) {
            if (op == TokenKind.OrOr && left != 0) {
                if (!compiler_eval_skip_expression_precedence(stop_a, stop_b, stop_c, prec + 1)) {
                    return false;
                }
                Compiler.eval_last_i32 = 1;
                left = 1;
                skipped_rhs = 1;
            }
        }
        if (skipped_rhs == 0) {
            if (!compiler_eval_parse_expression_precedence(stop_a, stop_b, stop_c, prec + 1)) {
                return false;
            }
            if (!compiler_eval_apply_binary(op, left, Compiler.eval_last_i32)) {
                return false;
            }
            left = Compiler.eval_last_i32;
        }
    }
    return false;
}

function compiler_eval_parse_expression_until(
    stop_a: TokenKind,
    stop_b: TokenKind,
    stop_c: TokenKind
): bool {
    let start: i32 = Compiler.eval_cursor;
    if (!compiler_eval_parse_expression_precedence(stop_a, stop_b, stop_c, 1)) {
        return false;
    }
    if (Compiler.eval_cursor == start) {
        return false;
    }
    return true;
}

function compiler_eval_skip_statement(): bool {
    let kind: TokenKind = compiler_eval_current_kind();
    if (kind == TokenKind.LBrace) {
        let end_token: i32 = compiler_eval_find_matching_rbrace(Compiler.eval_cursor);
        if (end_token < 0) {
            return false;
        }
        Compiler.eval_cursor = end_token + 1;
        return true;
    }

    if (kind == TokenKind.KwIf) {
        Compiler.eval_cursor += 1;
        if (compiler_eval_current_kind() != TokenKind.LParen) {
            return false;
        }
        Compiler.eval_cursor += 1;
        let depth: i32 = 1;
        let done: i32 = 0;
        let guard: i32 = 0;
        for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD && done == 0; guard += 1) {
            let cond_kind: TokenKind = compiler_eval_current_kind();
            if (cond_kind == TokenKind.Eof) {
                return false;
            }
            if (cond_kind == TokenKind.LParen) {
                depth += 1;
            } else {
                if (cond_kind == TokenKind.RParen) {
                    depth -= 1;
                }
            }
            Compiler.eval_cursor += 1;
            if (depth == 0) {
                done = 1;
            }
        }
        if (depth != 0) {
            return false;
        }
        if (!compiler_eval_skip_statement()) {
            return false;
        }
        if (compiler_eval_current_kind() == TokenKind.KwElse) {
            Compiler.eval_cursor += 1;
            if (!compiler_eval_skip_statement()) {
                return false;
            }
        }
        return true;
    }

    let paren_depth: i32 = 0;
    let bracket_depth: i32 = 0;
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD; guard += 1) {
        let scan_kind: TokenKind = compiler_eval_current_kind();
        if (scan_kind == TokenKind.Eof) {
            return false;
        }
        if (scan_kind == TokenKind.Semicolon && paren_depth == 0 && bracket_depth == 0) {
            Compiler.eval_cursor += 1;
            return true;
        }
        if (scan_kind == TokenKind.LParen) {
            paren_depth += 1;
        } else {
            if (scan_kind == TokenKind.RParen) {
                if (paren_depth > 0) {
                    paren_depth -= 1;
                }
            }
        }
        if (scan_kind == TokenKind.LBracket) {
            bracket_depth += 1;
        } else {
            if (scan_kind == TokenKind.RBracket) {
                if (bracket_depth > 0) {
                    bracket_depth -= 1;
                }
            }
        }
        Compiler.eval_cursor += 1;
    }
    return false;
}

function compiler_eval_execute_if_statement(): bool {
    Compiler.eval_cursor += 1;
    if (compiler_eval_current_kind() != TokenKind.LParen) {
        return false;
    }
    Compiler.eval_cursor += 1;
    if (!compiler_eval_parse_expression_until(TokenKind.RParen, TokenKind.Invalid, TokenKind.Invalid)) {
        return false;
    }
    let condition_value: i32 = Compiler.eval_last_i32;
    if (compiler_eval_current_kind() != TokenKind.RParen) {
        return false;
    }
    Compiler.eval_cursor += 1;

    if (condition_value != 0) {
        if (!compiler_eval_execute_statement()) {
            return false;
        }
        if (compiler_eval_current_kind() == TokenKind.KwElse) {
            Compiler.eval_cursor += 1;
            if (!compiler_eval_skip_statement()) {
                return false;
            }
        }
        return true;
    }

    if (!compiler_eval_skip_statement()) {
        return false;
    }
    if (compiler_eval_current_kind() == TokenKind.KwElse) {
        Compiler.eval_cursor += 1;
        if (!compiler_eval_execute_statement()) {
            return false;
        }
    }
    return true;
}

function compiler_eval_execute_let_statement(): bool {
    Compiler.eval_cursor += 1;
    if (compiler_eval_current_kind() != TokenKind.Identifier) {
        return false;
    }
    let name_hash: i32 = compiler_eval_identifier_hash_at(Compiler.eval_cursor);
    Compiler.eval_cursor += 1;

    if (compiler_eval_current_kind() == TokenKind.Colon) {
        Compiler.eval_cursor += 1;
        if (compiler_eval_current_kind() != TokenKind.Identifier) {
            return false;
        }
        Compiler.eval_cursor += 1;
    }

    if (compiler_eval_current_kind() != TokenKind.Assign) {
        return false;
    }
    Compiler.eval_cursor += 1;
    if (!compiler_eval_parse_expression_until(TokenKind.Semicolon, TokenKind.Invalid, TokenKind.Invalid)) {
        return false;
    }
    let value: i32 = Compiler.eval_last_i32;
    if (compiler_eval_current_kind() != TokenKind.Semicolon) {
        return false;
    }
    Compiler.eval_cursor += 1;
    return compiler_eval_set_binding(name_hash, value);
}

function compiler_eval_apply_assignment_op(path_hash: i32, is_field_path: bool, op: TokenKind, rhs: i32): bool {
    let current_value: i32 = 0;
    if (is_field_path) {
        let field_index: i32 = compiler_eval_find_field_index(path_hash);
        if (field_index >= 0) {
            current_value = Compiler.eval_field_values[field_index];
        }
    } else {
        let binding_index: i32 = compiler_eval_find_binding_index(path_hash);
        if (binding_index < 0) {
            return false;
        }
        current_value = Compiler.eval_binding_values[binding_index];
    }

    if (!compiler_eval_compute_assignment_value(op, current_value, rhs)) {
        return false;
    }

    if (is_field_path) {
        return compiler_eval_set_field(path_hash, Compiler.eval_last_i32);
    }

    let binding_index: i32 = compiler_eval_find_binding_index(path_hash);
    if (binding_index < 0) {
        return false;
    }
    Compiler.eval_binding_values[binding_index] = Compiler.eval_last_i32;
    return true;
}

function compiler_eval_eval_assignment_until(stop_kind: TokenKind): bool {
    if (compiler_eval_current_kind() != TokenKind.Identifier) {
        return false;
    }
    let path_hash: i32 = compiler_eval_identifier_hash_at(Compiler.eval_cursor);
    let is_field_path: bool = false;
    Compiler.eval_cursor += 1;

    let path_guard: i32 = 0;
    let path_done: i32 = 0;
    for (path_guard = 0; path_guard < COMPILER_MAX_CALL_NEST && path_done == 0; path_guard += 1) {
        if (compiler_eval_current_kind() != TokenKind.Dot) {
            path_done = 1;
        } else {
            is_field_path = true;
            Compiler.eval_cursor += 1;
            if (compiler_eval_current_kind() != TokenKind.Identifier) {
                return false;
            }
            path_hash = compiler_hash_mix(path_hash, 46);
            path_hash = compiler_hash_mix(path_hash, compiler_eval_identifier_hash_at(Compiler.eval_cursor));
            Compiler.eval_cursor += 1;
        }
    }
    if (path_done == 0) {
        return false;
    }

    let op: TokenKind = compiler_eval_current_kind();
    if (!parser_is_assignment_op(op)) {
        return false;
    }
    Compiler.eval_cursor += 1;
    if (!compiler_eval_parse_expression_until(stop_kind, TokenKind.Invalid, TokenKind.Invalid)) {
        return false;
    }
    return compiler_eval_apply_assignment_op(path_hash, is_field_path, op, Compiler.eval_last_i32);
}

function compiler_eval_eval_expression_or_assignment_until(stop_kind: TokenKind): bool {
    if (compiler_eval_is_assignment_start()) {
        return compiler_eval_eval_assignment_until(stop_kind);
    }
    return compiler_eval_parse_expression_until(stop_kind, TokenKind.Invalid, TokenKind.Invalid);
}

function compiler_eval_find_clause_end(start: i32, stop_kind: TokenKind): i32 {
    if (start < 0 || start >= Compiler.token_count) {
        return -1;
    }
    let paren_depth: i32 = 0;
    let bracket_depth: i32 = 0;
    let i: i32 = 0;
    for (i = start; i < Compiler.token_count; i += 1) {
        let kind: TokenKind = Compiler.tokens[i].kind;
        if (kind == stop_kind && paren_depth == 0 && bracket_depth == 0) {
            return i;
        }
        if (kind == TokenKind.LParen) {
            paren_depth += 1;
        } else {
            if (kind == TokenKind.RParen && paren_depth > 0) {
                paren_depth -= 1;
            }
        }
        if (kind == TokenKind.LBracket) {
            bracket_depth += 1;
        } else {
            if (kind == TokenKind.RBracket && bracket_depth > 0) {
                bracket_depth -= 1;
            }
        }
    }
    return -1;
}

function compiler_eval_execute_for_statement(): bool {
    Compiler.eval_cursor += 1;
    if (compiler_eval_current_kind() != TokenKind.LParen) {
        return false;
    }
    Compiler.eval_cursor += 1;

    let for_scope_start: i32 = Compiler.eval_binding_count;
    let for_init_is_let: i32 = 0;
    if (compiler_eval_current_kind() == TokenKind.KwLet) {
        for_init_is_let = 1;
        if (!compiler_eval_execute_let_statement()) {
            return false;
        }
    } else {
        if (!compiler_eval_eval_expression_or_assignment_until(TokenKind.Semicolon)) {
            return false;
        }
        if (compiler_eval_current_kind() != TokenKind.Semicolon) {
            return false;
        }
        Compiler.eval_cursor += 1;
    }

    let condition_start: i32 = Compiler.eval_cursor;
    let condition_end: i32 = compiler_eval_find_clause_end(condition_start, TokenKind.Semicolon);
    if (condition_end < 0) {
        return false;
    }
    Compiler.eval_cursor = condition_end + 1;

    let step_start: i32 = Compiler.eval_cursor;
    let step_end: i32 = compiler_eval_find_clause_end(step_start, TokenKind.RParen);
    if (step_end < 0) {
        return false;
    }
    Compiler.eval_cursor = step_end + 1;

    let body_start: i32 = Compiler.eval_cursor;
    if (!compiler_eval_skip_statement()) {
        return false;
    }
    let body_after: i32 = Compiler.eval_cursor;

    let done: i32 = 0;
    let ok: i32 = 1;
    let loop_guard: i32 = 0;
    for (loop_guard = 0; loop_guard < COMPILER_MAX_BODY_STMTS && done == 0; loop_guard += 1) {
        Compiler.eval_cursor = condition_start;
        if (!compiler_eval_eval_expression_or_assignment_until(TokenKind.Semicolon)) {
            ok = 0;
            done = 1;
        } else {
            if (compiler_eval_current_kind() != TokenKind.Semicolon || Compiler.eval_cursor != condition_end) {
                ok = 0;
                done = 1;
            } else {
                if (Compiler.eval_last_i32 == 0) {
                    done = 1;
                } else {
                    Compiler.eval_cursor = body_start;
                    if (!compiler_eval_execute_statement()) {
                        ok = 0;
                        done = 1;
                    } else {
                        if (Compiler.eval_returned) {
                            done = 1;
                        } else {
                            Compiler.eval_cursor = step_start;
                            if (!compiler_eval_eval_expression_or_assignment_until(TokenKind.RParen)) {
                                ok = 0;
                                done = 1;
                            } else {
                                if (compiler_eval_current_kind() != TokenKind.RParen || Compiler.eval_cursor != step_end) {
                                    ok = 0;
                                    done = 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (done == 0) {
        ok = 0;
    }

    Compiler.eval_cursor = body_after;
    if (for_init_is_let == 1) {
        Compiler.eval_binding_count = for_scope_start;
    }
    return ok == 1;
}

function compiler_eval_execute_assignment_statement(): bool {
    if (!compiler_eval_eval_assignment_until(TokenKind.Semicolon)) {
        return false;
    }
    if (compiler_eval_current_kind() != TokenKind.Semicolon) {
        return false;
    }
    Compiler.eval_cursor += 1;
    return true;
}

function compiler_eval_execute_statement(): bool {
    let kind: TokenKind = compiler_eval_current_kind();
    if (kind == TokenKind.KwReturn) {
        Compiler.eval_cursor += 1;
        if (!compiler_eval_parse_expression_until(TokenKind.Semicolon, TokenKind.Invalid, TokenKind.Invalid)) {
            return false;
        }
        if (compiler_eval_current_kind() != TokenKind.Semicolon) {
            return false;
        }
        Compiler.eval_cursor += 1;
        Compiler.eval_returned = true;
        Compiler.eval_return_value = Compiler.eval_last_i32;
        return true;
    }
    if (kind == TokenKind.KwLet) {
        return compiler_eval_execute_let_statement();
    }
    if (kind == TokenKind.KwIf) {
        return compiler_eval_execute_if_statement();
    }
    if (kind == TokenKind.KwFor) {
        return compiler_eval_execute_for_statement();
    }
    if (kind == TokenKind.LBrace) {
        let block_end: i32 = compiler_eval_find_matching_rbrace(Compiler.eval_cursor);
        if (block_end < 0) {
            return false;
        }
        Compiler.eval_cursor += 1;
        if (!compiler_eval_execute_block_until(block_end)) {
            return false;
        }
        Compiler.eval_cursor = block_end + 1;
        return true;
    }
    if (kind == TokenKind.Semicolon) {
        Compiler.eval_cursor += 1;
        return true;
    }
    if (compiler_eval_is_assignment_start()) {
        return compiler_eval_execute_assignment_statement();
    }
    if (!compiler_eval_parse_expression_until(TokenKind.Semicolon, TokenKind.Invalid, TokenKind.Invalid)) {
        return false;
    }
    if (compiler_eval_current_kind() != TokenKind.Semicolon) {
        return false;
    }
    Compiler.eval_cursor += 1;
    return true;
}

function compiler_eval_execute_function(
    function_index: i32,
    arg_count: i32,
    arg0: i32,
    arg1: i32,
    arg2: i32,
    arg3: i32
): bool {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return false;
    }
    if (Compiler.function_return_type_codes[function_index] != 1) {
        return false;
    }
    if (Compiler.function_param_counts[function_index] != arg_count) {
        return false;
    }
    if (arg_count > COMPILER_MAX_TRACKED_PARAM_HASHES) {
        return false;
    }
    if (Compiler.eval_call_depth >= COMPILER_MAX_EVAL_CALL_DEPTH) {
        return false;
    }

    let function_id_hash: i32 = Compiler.function_id_hashes[function_index];
    let i: i32 = 0;
    for (i = 0; i < Compiler.eval_call_depth; i += 1) {
        if (Compiler.eval_call_stack_id_hashes[i] == function_id_hash) {
            return false;
        }
    }

    let saved_binding_count: i32 = Compiler.eval_binding_count;
    let saved_cursor: i32 = Compiler.eval_cursor;
    let saved_returned: bool = Compiler.eval_returned;
    let saved_return_value: i32 = Compiler.eval_return_value;

    Compiler.eval_call_stack_id_hashes[Compiler.eval_call_depth] = function_id_hash;
    Compiler.eval_call_depth += 1;

    let ok: bool = true;
    let param_base: i32 = function_index * COMPILER_MAX_TRACKED_PARAM_HASHES;
    for (i = 0; i < arg_count; i += 1) {
        let param_name_hash: i32 = Compiler.function_param_name_hashes[param_base + i];
        if (param_name_hash == 0) {
            ok = false;
        } else {
            if (!compiler_eval_set_binding(
                param_name_hash,
                compiler_eval_call_arg_value(i, arg0, arg1, arg2, arg3)
            )) {
                ok = false;
            }
        }
    }

    Compiler.eval_returned = false;
    Compiler.eval_return_value = 0;

    if (ok) {
        let body_start: i32 = Compiler.function_body_start_tokens[function_index];
        let body_end: i32 = Compiler.function_body_end_tokens[function_index];
        if (body_start < 0 || body_end <= body_start) {
            ok = false;
        } else {
            Compiler.eval_cursor = body_start + 1;
            if (!compiler_eval_execute_block_until(body_end)) {
                ok = false;
            }
            if (!Compiler.eval_returned) {
                ok = false;
            }
        }
    }

    let evaluated_return: i32 = Compiler.eval_return_value;
    Compiler.eval_binding_count = saved_binding_count;
    Compiler.eval_cursor = saved_cursor;
    Compiler.eval_returned = saved_returned;
    Compiler.eval_return_value = saved_return_value;
    Compiler.eval_call_depth -= 1;

    if (!ok) {
        return false;
    }
    Compiler.eval_last_i32 = evaluated_return;
    return true;
}

function compiler_try_eval_noarg_i32_function(function_index: i32): bool {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return false;
    }
    if (Compiler.function_return_type_codes[function_index] != 1) {
        return false;
    }
    if (Compiler.function_param_counts[function_index] != 0) {
        return false;
    }

    Compiler.eval_binding_count = 0;
    compiler_eval_clear_field_table();
    Compiler.eval_call_depth = 0;
    Compiler.eval_cursor = 0;
    Compiler.eval_last_i32 = 0;
    Compiler.eval_returned = false;
    Compiler.eval_return_value = 0;
    return compiler_eval_execute_function(function_index, 0, 0, 0, 0, 0);
}

function compiler_emit_function_clif_for_index(index: i32, out: ascii[]): void {
    ascii_clear(out);
    if (index < 0 || index >= Compiler.tracked_function_count) {
        return;
    }
    if (compiler_emit_global_i32_store_return_body(index, out)) {
        return;
    }

    compiler_emit_symbol_name_for_index(index, Compiler.clif_symbol_buffer);
    let return_type_code: i32 = Compiler.function_return_type_codes[index];
    let param_count: i32 = Compiler.function_param_counts[index];
    let emit_i32_param_signature: bool = (
        param_count > 0 &&
        param_count <= COMPILER_MAX_TRACKED_PARAM_HASHES &&
        Compiler.function_first_param_type_codes[index] == 1
    );

    ascii_append(out, "function %");
    ascii_append(out, Compiler.clif_symbol_buffer);
    if (emit_i32_param_signature) {
        if (!compiler_emit_clif_i32_param_list(out, param_count)) {
            ascii_clear(out);
            return;
        }
        if (return_type_code != 2) {
            ascii_append(out, " -> i32 ");
        } else {
            ascii_append(out, " ");
        }
    } else {
        if (return_type_code == 2) {
            ascii_append(out, "() ");
        } else {
            ascii_append(out, "() -> i32 ");
        }
    }
    compiler_emit_clif_call_conv(out);
    ascii_append(out, " {\nblock0:\n");

    if (return_type_code == 2) {
        ascii_append(out, "return\n}\n");
        return;
    }

    if (compiler_emit_simple_i32_param_return_body(index, out)) {
        return;
    }

    let value: i32 = Compiler.function_body_hashes[index];
    let evaluated: bool = compiler_try_eval_noarg_i32_function(index);
    if (evaluated) {
        value = Compiler.eval_last_i32;
    } else {
        if (Compiler.function_simple_i32_return_literal_flags[index] == 1) {
            value = Compiler.function_simple_i32_return_literals[index];
        }
    }
    let value_reg: i32 = 0;
    if (emit_i32_param_signature) {
        value_reg = param_count;
    }
    ascii_append(out, "v");
    ascii_push_i32(out, value_reg);
    ascii_append(out, " = iconst.i32 ");
    ascii_push_i32(out, value);
    ascii_append(out, "\nreturn v");
    ascii_push_i32(out, value_reg);
    ascii_append(out, "\n}\n");
}

function parser_parse_extern_declaration(): bool {
    Compiler.parse_index += 1;
    if (!parser_expect(TokenKind.KwFunction, CompilerErrorCode.ParseExpectFunctionAfterExtern)) {
        return false;
    }
    if (!parser_parse_signature_after_function_keyword()) {
        return false;
    }
    if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
        return false;
    }
    return true;
}

function parser_parse_function_declaration(): bool {
    let signature_start_token: i32 = Compiler.parse_index;
    if (!parser_expect(TokenKind.KwFunction, CompilerErrorCode.ParseExpectFunctionOrExtern)) {
        return false;
    }
    if (!parser_parse_signature_after_function_keyword()) {
        return false;
    }
    let signature_end_token: i32 = Compiler.parse_index - 1;
    let body_start_token: i32 = Compiler.parse_index;

    if (!parser_parse_statement_or_block()) {
        return false;
    }
    let body_end_token: i32 = Compiler.parse_index - 1;
    if (Compiler.tokens[body_start_token].kind != TokenKind.LBrace || Compiler.tokens[body_end_token].kind != TokenKind.RBrace) {
        return parser_error(CompilerErrorCode.ParseExpectLBrace);
    }

    parser_record_function_fingerprint(
        signature_start_token,
        signature_end_token,
        body_start_token,
        body_end_token
    );
    return true;
}

function parser_parse_layout_declaration_block(): bool {
    let decl_kind: TokenKind = parser_current_kind();
    let is_global_decl: bool = decl_kind == TokenKind.KwGlobal;
    let start_token: i32 = Compiler.parse_index;
    Compiler.parse_index += 1;
    if (!parser_capture_identifier()) {
        return false;
    }
    let decl_name_hash: i32 = parser_captured_identifier_hash();
    let decl_index: i32 = -1;
    if (is_global_decl) {
        decl_index = compiler_layout_begin_global(decl_name_hash);
    } else {
        decl_index = compiler_layout_begin_struct(decl_name_hash);
    }
    if (decl_index < 0) {
        return parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
    }

    if (!parser_expect(TokenKind.LBrace, CompilerErrorCode.ParseExpectLBrace)) {
        return false;
    }

    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_BODY_STMTS && parser_current_kind() != TokenKind.RBrace; guard += 1) {
        if (!parser_capture_identifier()) {
            return false;
        }
        let field_name_hash: i32 = parser_captured_identifier_hash();
        if (!parser_expect(TokenKind.Colon, CompilerErrorCode.ParseExpectColon)) {
            return false;
        }
        if (!parser_capture_identifier()) {
            return false;
        }
        let field_type_hash: i32 = parser_captured_identifier_hash();
        if (is_global_decl) {
            if (!compiler_layout_add_global_field(decl_index, field_name_hash, field_type_hash)) {
                return parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
            }
        } else {
            if (!compiler_layout_add_struct_field(decl_index, field_name_hash, field_type_hash)) {
                return parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
            }
        }
        if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
            return false;
        }
    }
    if (guard >= COMPILER_MAX_BODY_STMTS) {
        return parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
    }
    if (!parser_expect(TokenKind.RBrace, CompilerErrorCode.ParseExpectRBrace)) {
        return false;
    }

    let end_token: i32 = Compiler.parse_index - 1;
    let start_pos: i32 = Compiler.tokens[start_token].start;
    let span_len: i32 = Compiler.tokens[end_token].end - start_pos;
    Compiler.layout_hash = compiler_hash_source_span(Compiler.layout_hash, start_pos, span_len);
    if (parser_current_kind() == TokenKind.Semicolon) {
        Compiler.parse_index += 1;
    }
    return true;
}

function compiler_is_global_i32_store_return_shape(function_index: i32): bool {
    if (function_index < 0 || function_index >= Compiler.tracked_function_count) {
        return false;
    }
    if (Compiler.function_param_counts[function_index] != 0) {
        return false;
    }
    if (Compiler.function_return_type_codes[function_index] != 1) {
        return false;
    }
    if (Compiler.layout_memory_size_bytes <= 0 || Compiler.layout_flat_field_count <= 0) {
        return false;
    }

    let body_start: i32 = Compiler.function_body_start_tokens[function_index];
    let body_end: i32 = Compiler.function_body_end_tokens[function_index];
    if (
        body_start < 0 ||
        body_end <= body_start ||
        Compiler.tokens[body_start].kind != TokenKind.LBrace ||
        Compiler.tokens[body_end].kind != TokenKind.RBrace
    ) {
        return false;
    }

    let cursor: i32 = body_start + 1;
    if (parser_token_kind_at(cursor) != TokenKind.Identifier) {
        return false;
    }
    let assign_path_hash: i32 = compiler_eval_identifier_hash_at(cursor);
    cursor += 1;

    let path_guard: i32 = 0;
    let path_done: i32 = 0;
    for (path_guard = 0; path_guard < COMPILER_MAX_CALL_NEST && path_done == 0; path_guard += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Dot &&
            parser_token_kind_at(cursor + 1) == TokenKind.Identifier
        ) {
            assign_path_hash = compiler_layout_extend_path_hash(
                assign_path_hash,
                compiler_eval_identifier_hash_at(cursor + 1)
            );
            cursor += 2;
        } else {
            path_done = 1;
        }
    }
    if (path_done == 0) {
        return false;
    }

    if (parser_token_kind_at(cursor) != TokenKind.Assign) {
        return false;
    }
    cursor += 1;
    if (parser_token_kind_at(cursor) != TokenKind.IntLiteral) {
        return false;
    }
    cursor += 1;
    if (parser_token_kind_at(cursor) != TokenKind.Semicolon) {
        return false;
    }
    cursor += 1;
    if (parser_token_kind_at(cursor) != TokenKind.KwReturn) {
        return false;
    }
    cursor += 1;
    if (parser_token_kind_at(cursor) != TokenKind.Identifier) {
        return false;
    }
    let return_path_hash: i32 = compiler_eval_identifier_hash_at(cursor);
    cursor += 1;

    let return_path_guard: i32 = 0;
    let return_path_done: i32 = 0;
    for (return_path_guard = 0; return_path_guard < COMPILER_MAX_CALL_NEST && return_path_done == 0; return_path_guard += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Dot &&
            parser_token_kind_at(cursor + 1) == TokenKind.Identifier
        ) {
            return_path_hash = compiler_layout_extend_path_hash(
                return_path_hash,
                compiler_eval_identifier_hash_at(cursor + 1)
            );
            cursor += 2;
        } else {
            return_path_done = 1;
        }
    }
    if (return_path_done == 0) {
        return false;
    }

    if (return_path_hash != assign_path_hash) {
        return false;
    }
    if (parser_token_kind_at(cursor) != TokenKind.Semicolon) {
        return false;
    }
    cursor += 1;
    if (cursor != body_end) {
        return false;
    }
    if (compiler_layout_find_flat_field_offset(assign_path_hash) < 0) {
        return false;
    }
    return true;
}

function compiler_find_global_i32_store_return_owner_index(): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        if (compiler_is_global_i32_store_return_shape(i)) {
            return i;
        }
    }
    return -1;
}

function compiler_emit_global_i32_store_return_body(function_index: i32, out: ascii[]): bool {
    if (!compiler_is_global_i32_store_return_shape(function_index)) {
        return false;
    }

    let body_start: i32 = Compiler.function_body_start_tokens[function_index];
    let cursor: i32 = body_start + 1;
    let assign_path_hash: i32 = compiler_eval_identifier_hash_at(cursor);
    cursor += 1;
    let path_guard: i32 = 0;
    let path_done: i32 = 0;
    for (path_guard = 0; path_guard < COMPILER_MAX_CALL_NEST && path_done == 0; path_guard += 1) {
        if (
            parser_token_kind_at(cursor) == TokenKind.Dot &&
            parser_token_kind_at(cursor + 1) == TokenKind.Identifier
        ) {
            assign_path_hash = compiler_layout_extend_path_hash(
                assign_path_hash,
                compiler_eval_identifier_hash_at(cursor + 1)
            );
            cursor += 2;
        } else {
            path_done = 1;
        }
    }
    if (path_done == 0) {
        return false;
    }
    if (parser_token_kind_at(cursor) != TokenKind.Assign) {
        return false;
    }
    cursor += 1;
    if (parser_token_kind_at(cursor) != TokenKind.IntLiteral) {
        return false;
    }
    let assigned_value: i32 = Compiler.tokens[cursor].int_value;

    let field_offset: i32 = compiler_layout_find_flat_field_offset(assign_path_hash);
    if (field_offset < 0) {
        return false;
    }
    let owner_index: i32 = compiler_find_global_i32_store_return_owner_index();
    if (owner_index < 0) {
        return false;
    }

    ascii_clear(Compiler.clif_symbol_buffer);
    ascii_append(Compiler.clif_symbol_buffer, "sp_global_mem_layout_");
    ascii_push_i32(Compiler.clif_symbol_buffer, compiler_abs_i32(Compiler.layout_hash));

    let memory_size: i32 = Compiler.layout_memory_size_bytes;
    if (memory_size < 4) {
        memory_size = 4;
    }

    if (owner_index == function_index) {
        ascii_append(out, "global ");
    } else {
        ascii_append(out, "global_import ");
    }
    ascii_append(out, Compiler.clif_symbol_buffer);
    ascii_append(out, ": i8[");
    ascii_push_i32(out, memory_size);
    ascii_append(out, "]\n");

    compiler_emit_symbol_name_for_index(function_index, Compiler.clif_symbol_buffer);
    ascii_append(out, "function %");
    ascii_append(out, Compiler.clif_symbol_buffer);
    ascii_append(out, "() -> i32 ");
    compiler_emit_clif_call_conv(out);
    ascii_append(out, " {\nblock0:\n");

    ascii_clear(Compiler.clif_symbol_buffer);
    ascii_append(Compiler.clif_symbol_buffer, "sp_global_mem_layout_");
    ascii_push_i32(Compiler.clif_symbol_buffer, compiler_abs_i32(Compiler.layout_hash));

    ascii_append(out, "v0 = global_value ");
    ascii_append(out, Compiler.clif_symbol_buffer);
    ascii_append(out, "\n");
    ascii_append(out, "v1 = iconst.i64 ");
    ascii_push_i32(out, field_offset);
    ascii_append(out, "\n");
    ascii_append(out, "v2 = iadd v0, v1\n");
    ascii_append(out, "v3 = iconst.i32 ");
    ascii_push_i32(out, assigned_value);
    ascii_append(out, "\n");
    ascii_append(out, "store v3, v2\n");
    ascii_append(out, "v4 = load.i32 v2\n");
    ascii_append(out, "return v4\n}\n");
    return true;
}

function compiler_parse_program(): bool {
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD; guard += 1) {
        let kind: TokenKind = parser_current_kind();
        if (kind == TokenKind.Eof) {
            return true;
        }
        if (kind == TokenKind.KwExtern) {
            if (!parser_parse_extern_declaration()) { return false; }
        } else {
            if (kind == TokenKind.KwFunction) {
                if (!parser_parse_function_declaration()) { return false; }
            } else {
                if (kind == TokenKind.KwGlobal) {
                    if (!parser_parse_layout_declaration_block()) { return false; }
                } else {
                    if (kind == TokenKind.KwStruct) {
                        if (!parser_parse_layout_declaration_block()) { return false; }
                    } else {
                        return parser_error(CompilerErrorCode.ParseExpectFunctionOrExtern);
                    }
                }
            }
        }
    }
    return parser_error(CompilerErrorCode.ParseItemGuardExhausted);
}
function compiler_validate_semantics(): bool {
    if (!compiler_build_function_reachability()) {
        compiler_push_error(
            CompilerErrorCode.ParseBodyGuardExhausted,
            parser_current_pos(),
            Compiler.tracked_function_count,
            Compiler.current_file_index
        );
        return false;
    }
    if (!compiler_build_layout_reachability()) {
        compiler_push_error(
            CompilerErrorCode.ParseBodyGuardExhausted,
            parser_current_pos(),
            Compiler.layout_struct_count,
            Compiler.current_file_index
        );
        return false;
    }
    if (!compiler_build_flat_layout_paths()) {
        compiler_push_error(
            CompilerErrorCode.ParseBodyGuardExhausted,
            parser_current_pos(),
            Compiler.layout_flat_field_count,
            Compiler.current_file_index
        );
        return false;
    }
    return true;
}

function compiler_parse_current_source(file_index: i32): bool {
    Compiler.current_file_index = file_index;
    compiler_reset_current_parse_metrics();
    compiler_reset_current_function_tracking();

    if (!compiler_lex()) {
        Compiler.status = CompilerStatus.LexError;
        return false;
    }
    if (!compiler_parse_program()) {
        Compiler.status = CompilerStatus.ParseError;
        return false;
    }
    if (!compiler_validate_semantics()) {
        Compiler.status = CompilerStatus.ParseError;
        return false;
    }
    Compiler.status = CompilerStatus.Ok;
    return true;
}

function compiler_copy_file_source_to_current(file_index: i32): void {
    ascii_clear(Compiler.source);
    ascii_copy(Compiler.source, Compiler.files[file_index].source);
    Compiler.source_len = Compiler.files[file_index].source_len;
}

function compiler_capture_last_error_for_file(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }
    if (Compiler.error_count <= 0) {
        Compiler.files[file_index].last_error_code = 0;
        Compiler.files[file_index].last_error_pos = 0;
        Compiler.files[file_index].last_error_detail_a = 0;
        Compiler.files[file_index].last_error_detail_b = 0;
        return;
    }
    let last: i32 = Compiler.error_count - 1;
    Compiler.files[file_index].last_error_code = Compiler.errors[last].code;
    Compiler.files[file_index].last_error_pos = Compiler.errors[last].pos;
    Compiler.files[file_index].last_error_detail_a = Compiler.errors[last].detail_a;
    Compiler.files[file_index].last_error_detail_b = Compiler.errors[last].detail_b;
}

function compiler_clear_file_function_reachability_flags(): void {
    let file_index: i32 = 0;
    for (file_index = 0; file_index < Compiler.file_count; file_index += 1) {
        let file_slot_base: i32 = file_index * COMPILER_MAX_TRACKED_FUNCTIONS;
        let function_index: i32 = 0;
        for (function_index = 0; function_index < Compiler.files[file_index].tracked_function_count; function_index += 1) {
            let slot: i32 = file_slot_base + function_index;
            Compiler.file_function_reachable_flags[slot] = 0;
        }
    }
}

function compiler_mark_file_functions_reachable_by_hash(id_hash: i32): bool {
    if (id_hash == 0) {
        return false;
    }
    let marked_any: bool = false;
    let file_index: i32 = 0;
    for (file_index = 0; file_index < Compiler.file_count; file_index += 1) {
        let file_slot_base: i32 = file_index * COMPILER_MAX_TRACKED_FUNCTIONS;
        let function_index: i32 = 0;
        for (function_index = 0; function_index < Compiler.files[file_index].tracked_function_count; function_index += 1) {
            let slot: i32 = file_slot_base + function_index;
            if (
                Compiler.files[file_index].function_id_hashes[function_index] == id_hash &&
                Compiler.file_function_reachable_flags[slot] == 0
            ) {
                Compiler.file_function_reachable_flags[slot] = 1;
                marked_any = true;
            }
        }
    }
    return marked_any;
}

function compiler_mark_all_file_functions_reachable(): void {
    let file_index: i32 = 0;
    for (file_index = 0; file_index < Compiler.file_count; file_index += 1) {
        let file_slot_base: i32 = file_index * COMPILER_MAX_TRACKED_FUNCTIONS;
        let function_index: i32 = 0;
        for (function_index = 0; function_index < Compiler.files[file_index].tracked_function_count; function_index += 1) {
            let slot: i32 = file_slot_base + function_index;
            Compiler.file_function_reachable_flags[slot] = 1;
        }
    }
}

function compiler_expand_file_function_reachability(): bool {
    let max_steps: i32 = COMPILER_MAX_FILES * COMPILER_MAX_TRACKED_FUNCTIONS;
    let step: i32 = 0;
    for (step = 0; step < max_steps; step += 1) {
        let changed_in_step: bool = false;
        let file_index: i32 = 0;
        for (file_index = 0; file_index < Compiler.file_count; file_index += 1) {
            let file_slot_base: i32 = file_index * COMPILER_MAX_TRACKED_FUNCTIONS;
            let function_index: i32 = 0;
            for (function_index = 0; function_index < Compiler.files[file_index].tracked_function_count; function_index += 1) {
                let slot: i32 = file_slot_base + function_index;
                if (Compiler.file_function_reachable_flags[slot] == 1) {
                    let edge_count: i32 = Compiler.file_function_call_edge_counts[slot];
                    let edge_index: i32 = 0;
                    for (edge_index = 0; edge_index < edge_count; edge_index += 1) {
                        let callee_hash: i32 = Compiler.file_function_call_edge_hashes[
                            slot * COMPILER_MAX_FUNCTION_CALL_EDGES + edge_index
                        ];
                        if (compiler_mark_file_functions_reachable_by_hash(callee_hash)) {
                            changed_in_step = true;
                        }
                    }
                }
            }
        }
        if (!changed_in_step) {
            return true;
        }
    }
    return false;
}

function compiler_build_cross_file_function_reachability_from_files(): bool {
    compiler_clear_file_function_reachability_flags();
    let found_root: bool = false;
    if (compiler_mark_file_functions_reachable_by_hash(compiler_hash_ascii("main"))) {
        found_root = true;
    }
    if (compiler_mark_file_functions_reachable_by_hash(compiler_hash_ascii("tick"))) {
        found_root = true;
    }
    if (compiler_mark_file_functions_reachable_by_hash(compiler_hash_ascii("on_code_swap"))) {
        found_root = true;
    }
    let required_index: i32 = 0;
    for (required_index = 0; required_index < Compiler.required_reachability_root_count; required_index += 1) {
        if (
            compiler_mark_file_functions_reachable_by_hash(
                Compiler.required_reachability_root_hashes[required_index]
            )
        ) {
            found_root = true;
        }
    }

    if (!found_root) {
        compiler_mark_all_file_functions_reachable();
        return true;
    }
    return compiler_expand_file_function_reachability();
}

function compiler_file_function_is_reachable(file_index: i32, function_index: i32): bool {
    if (
        file_index < 0 ||
        file_index >= Compiler.file_count ||
        function_index < 0 ||
        function_index >= Compiler.files[file_index].tracked_function_count
    ) {
        return false;
    }
    let slot: i32 = file_index * COMPILER_MAX_TRACKED_FUNCTIONS + function_index;
    return Compiler.file_function_reachable_flags[slot] == 1;
}

function compiler_aggregate_from_files(): void {
    Compiler.parsed_main_declaration_count = 0;
    Compiler.parsed_main_valid_i32_count = 0;
    Compiler.parsed_main_invalid_signature_count = 0;
    Compiler.layout_hash = 216613626;
    Compiler.tracked_function_count = 0;

    let i: i32 = 0;
    for (i = 0; i < Compiler.file_count; i += 1) {
        Compiler.parsed_main_declaration_count += Compiler.files[i].parsed_main_declaration_count;
        Compiler.parsed_main_valid_i32_count += Compiler.files[i].parsed_main_valid_i32_count;
        Compiler.parsed_main_invalid_signature_count += Compiler.files[i].parsed_main_invalid_signature_count;
        Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, Compiler.files[i].layout_hash);
    }
}

function compiler_run_incremental_pipeline(): i32 {
    compiler_reset_run_counters();
    Compiler.error_count = 0;
    Compiler.status = CompilerStatus.Idle;
    Compiler.current_file_index = -1;

    if (Compiler.file_count <= 0) {
        if (!compiler_parse_current_source(-1)) {
            return compiler_get_status_code();
        }
        return compiler_get_status_code();
    }

    Compiler.incremental_scanned_files = Compiler.file_count;
    let i: i32 = 0;
    for (i = 0; i < Compiler.file_count; i += 1) {
        if (Compiler.files[i].dirty) {
            compiler_copy_file_source_to_current(i);
            if (!compiler_parse_current_source(i)) {
                Compiler.incremental_failed_files += 1;
                Compiler.files[i].last_status = Compiler.status;
                compiler_capture_last_error_for_file(i);
                return compiler_get_status_code();
            }

            Compiler.incremental_parsed_files += 1;
            if (Compiler.files[i].layout_hash != Compiler.layout_hash) {
                Compiler.incremental_layout_changed_files += 1;
            }
            compiler_record_dirty_file_function_metrics(i);
            compiler_store_current_functions_to_file(i);
            Compiler.files[i].dirty = false;
        } else {
            Compiler.incremental_reused_files += 1;
            Compiler.incremental_reused_functions += Compiler.files[i].tracked_function_count;
        }
    }

    if (!compiler_build_cross_file_function_reachability_from_files()) {
        compiler_push_error(CompilerErrorCode.ParseBodyGuardExhausted, 0, Compiler.file_count, 0);
        Compiler.status = CompilerStatus.ParseError;
        return compiler_get_status_code();
    }
    compiler_aggregate_from_files();
    Compiler.status = CompilerStatus.Ok;
    return compiler_get_status_code();
}

function run_incremental_compiler(): i32 {
    return compiler_run_incremental_pipeline();
}

function compiler_validate_entry_main_i32(): i32 {
    if (Compiler.parsed_main_declaration_count == 0) {
        compiler_push_error(CompilerErrorCode.EntryMissingMain, 0, 0, 0);
        return CompilerErrorCode.EntryMissingMain;
    }
    if (Compiler.parsed_main_declaration_count > 1) {
        compiler_push_error(CompilerErrorCode.EntryMultipleMain, 0, Compiler.parsed_main_declaration_count, 0);
        return CompilerErrorCode.EntryMultipleMain;
    }
    if (
        Compiler.parsed_main_valid_i32_count != 1 ||
        Compiler.parsed_main_invalid_signature_count > 0
    ) {
        compiler_push_error(
            CompilerErrorCode.EntryInvalidMainSignature,
            0,
            Compiler.parsed_main_valid_i32_count,
            Compiler.parsed_main_invalid_signature_count
        );
        return CompilerErrorCode.EntryInvalidMainSignature;
    }
    return 0;
}

function run_incremental_compiler_with_main_entry(): i32 {
    let status: i32 = compiler_run_incremental_pipeline();
    if (status != 0) {
        return status;
    }
    return compiler_validate_entry_main_i32();
}
