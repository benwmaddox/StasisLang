import "../src/stdlib/stdlib.stasis";
import "compiler_state.stasis";

function compiler_reset_state(): void {
    ascii_clear(Compiler.source);
    Compiler.source_len = 0;
    Compiler.file_count = 0;
    Compiler.current_file_index = -1;
    Compiler.token_count = 0;
    Compiler.parse_index = 0;
    Compiler.status = CompilerStatus.Idle;
    Compiler.error_count = 0;
    Compiler.parsed_function_count = 0;
    Compiler.parsed_extern_count = 0;
    Compiler.parsed_return_count = 0;
    Compiler.parsed_call_count = 0;
    Compiler.parsed_let_count = 0;
    Compiler.parsed_if_count = 0;
    Compiler.parsed_for_count = 0;
    Compiler.parsed_foreach_count = 0;
    Compiler.parsed_assignment_count = 0;
    Compiler.parsed_global_count = 0;
    Compiler.layout_hash = 216613626;
    Compiler.tracked_function_count = 0;
    Compiler.parsed_main_declaration_count = 0;
    Compiler.parsed_main_valid_i32_count = 0;
    Compiler.parsed_main_invalid_signature_count = 0;
    Compiler.captured_identifier_start = 0;
    Compiler.captured_identifier_len = 0;
    Compiler.current_signature_name_start = 0;
    Compiler.current_signature_name_len = 0;
    Compiler.current_signature_param_count = 0;
    Compiler.current_signature_return_type_start = 0;
    Compiler.current_signature_return_type_len = 0;
    Compiler.incremental_scanned_files = 0;
    Compiler.incremental_parsed_files = 0;
    Compiler.incremental_reused_files = 0;
    Compiler.incremental_failed_files = 0;
    Compiler.incremental_layout_changed_files = 0;
    Compiler.incremental_reused_functions = 0;
    Compiler.incremental_changed_functions = 0;
    Compiler.incremental_codegen_functions = 0;
}

function compiler_set_source(src: ascii[]): void {
    // Backward-compatible single-file path.
    ascii_clear(Compiler.source);
    ascii_copy(Compiler.source, src);
    Compiler.source_len = length(Compiler.source);
}

function compiler_hash_ascii(src: ascii[]): i32 {
    // Simple deterministic rolling hash.
    let hash: i32 = 216613626;
    let len: i32 = length(src);
    let i: i32 = 0;
    for (i = 0; i < len; i += 1) {
        hash = hash * 16777619 + u8_to_i32(src[i]) + 1;
    }
    return hash;
}

function compiler_hash_mix(hash: i32, value: i32): i32 {
    return hash * 16777619 + value + 1;
}

function compiler_hash_source_span(hash: i32, start: i32, len: i32): i32 {
    let result: i32 = hash;
    let i: i32 = 0;
    for (i = 0; i < len; i += 1) {
        result = compiler_hash_mix(result, u8_to_i32(Compiler.source[start + i]));
    }
    return result;
}

function compiler_reset_current_function_tracking(): void {
    Compiler.tracked_function_count = 0;
}

function compiler_clear_file_function_tracking(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }
    Compiler.files[file_index].tracked_function_count = 0;
}

function compiler_record_current_function(id_hash: i32, sig_hash: i32, body_hash: i32): void {
    if (Compiler.tracked_function_count >= COMPILER_MAX_TRACKED_FUNCTIONS) {
        return;
    }
    let index: i32 = Compiler.tracked_function_count;
    Compiler.tracked_function_count += 1;
    Compiler.function_id_hashes[index] = id_hash;
    Compiler.function_sig_hashes[index] = sig_hash;
    Compiler.function_body_hashes[index] = body_hash;
}

function compiler_find_file_function_index(file_index: i32, id_hash: i32): i32 {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return -1;
    }
    let i: i32 = 0;
    for (i = 0; i < Compiler.files[file_index].tracked_function_count; i += 1) {
        if (Compiler.files[file_index].function_id_hashes[i] == id_hash) {
            return i;
        }
    }
    return -1;
}

function compiler_find_current_function_index(id_hash: i32): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        if (Compiler.function_id_hashes[i] == id_hash) {
            return i;
        }
    }
    return -1;
}

function compiler_record_dirty_file_function_metrics(file_index: i32): void {
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        let id_hash: i32 = Compiler.function_id_hashes[i];
        let previous_index: i32 = compiler_find_file_function_index(file_index, id_hash);
        if (previous_index < 0) {
            Compiler.incremental_changed_functions += 1;
            Compiler.incremental_codegen_functions += 1;
        } else {
            if (
                Compiler.function_sig_hashes[i] == Compiler.files[file_index].function_sig_hashes[previous_index] &&
                Compiler.function_body_hashes[i] == Compiler.files[file_index].function_body_hashes[previous_index]
            ) {
                Compiler.incremental_reused_functions += 1;
            } else {
                Compiler.incremental_changed_functions += 1;
                Compiler.incremental_codegen_functions += 1;
            }
        }
    }

    for (i = 0; i < Compiler.files[file_index].tracked_function_count; i += 1) {
        let previous_id_hash: i32 = Compiler.files[file_index].function_id_hashes[i];
        if (compiler_find_current_function_index(previous_id_hash) < 0) {
            Compiler.incremental_changed_functions += 1;
        }
    }
}

function compiler_store_current_functions_to_file(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }
    Compiler.files[file_index].tracked_function_count = Compiler.tracked_function_count;
    let i: i32 = 0;
    for (i = 0; i < Compiler.tracked_function_count; i += 1) {
        Compiler.files[file_index].function_id_hashes[i] = Compiler.function_id_hashes[i];
        Compiler.files[file_index].function_sig_hashes[i] = Compiler.function_sig_hashes[i];
        Compiler.files[file_index].function_body_hashes[i] = Compiler.function_body_hashes[i];
    }
}

function compiler_find_file(path: ascii[]): i32 {
    let i: i32 = 0;
    for (i = 0; i < Compiler.file_count; i += 1) {
        if (ascii_eq(Compiler.files[i].path, path)) {
            return i;
        }
    }
    return -1;
}

function compiler_upsert_file(path: ascii[], src: ascii[]): bool {
    if (length(path) == 0) {
        compiler_push_error(CompilerErrorCode.IncrementalFilePathEmpty, 0, 0, 0);
        return false;
    }

    let hash: i32 = compiler_hash_ascii(src);
    let index: i32 = compiler_find_file(path);

    if (index >= 0) {
        if (Compiler.files[index].source_hash == hash) {
            Compiler.files[index].dirty = false;
            return true;
        }

        ascii_clear(Compiler.files[index].source);
        ascii_copy(Compiler.files[index].source, src);
        Compiler.files[index].source_len = length(Compiler.files[index].source);
        Compiler.files[index].source_hash = hash;
        Compiler.files[index].dirty = true;
        return true;
    }

    if (Compiler.file_count >= COMPILER_MAX_FILES) {
        compiler_push_error(CompilerErrorCode.IncrementalFileOverflow, 0, Compiler.file_count, COMPILER_MAX_FILES);
        return false;
    }

    let new_index: i32 = Compiler.file_count;
    Compiler.file_count += 1;

    ascii_clear(Compiler.files[new_index].path);
    ascii_copy(Compiler.files[new_index].path, path);

    ascii_clear(Compiler.files[new_index].source);
    ascii_copy(Compiler.files[new_index].source, src);
    Compiler.files[new_index].source_len = length(Compiler.files[new_index].source);
    Compiler.files[new_index].source_hash = hash;
    Compiler.files[new_index].dirty = true;
    Compiler.files[new_index].last_status = CompilerStatus.Idle;
    Compiler.files[new_index].parsed_function_count = 0;
    Compiler.files[new_index].parsed_extern_count = 0;
    Compiler.files[new_index].parsed_return_count = 0;
    Compiler.files[new_index].parsed_call_count = 0;
    Compiler.files[new_index].parsed_let_count = 0;
    Compiler.files[new_index].parsed_if_count = 0;
    Compiler.files[new_index].parsed_for_count = 0;
    Compiler.files[new_index].parsed_foreach_count = 0;
    Compiler.files[new_index].parsed_assignment_count = 0;
    Compiler.files[new_index].parsed_global_count = 0;
    Compiler.files[new_index].layout_hash = 216613626;
    Compiler.files[new_index].tracked_function_count = 0;
    Compiler.files[new_index].parsed_main_declaration_count = 0;
    Compiler.files[new_index].parsed_main_valid_i32_count = 0;
    Compiler.files[new_index].parsed_main_invalid_signature_count = 0;
    Compiler.files[new_index].last_error_code = 0;
    Compiler.files[new_index].last_error_pos = 0;
    Compiler.files[new_index].last_error_detail_a = 0;
    Compiler.files[new_index].last_error_detail_b = 0;
    return true;
}

function compiler_get_status_code(): i32 {
    if (Compiler.status == CompilerStatus.Ok) { return 0; }
    if (Compiler.status == CompilerStatus.LexError) { return 1; }
    if (Compiler.status == CompilerStatus.ParseError) { return 2; }
    return -1;
}

function compiler_run_incremental_pipeline(): i32 {
    Compiler.error_count = 0;
    Compiler.parsed_function_count = 0;
    Compiler.parsed_extern_count = 0;
    Compiler.parsed_return_count = 0;
    Compiler.parsed_call_count = 0;
    Compiler.parsed_let_count = 0;
    Compiler.parsed_if_count = 0;
    Compiler.parsed_for_count = 0;
    Compiler.parsed_foreach_count = 0;
    Compiler.parsed_assignment_count = 0;
    Compiler.parsed_global_count = 0;
    Compiler.layout_hash = 216613626;
    Compiler.tracked_function_count = 0;
    Compiler.parsed_main_declaration_count = 0;
    Compiler.parsed_main_valid_i32_count = 0;
    Compiler.parsed_main_invalid_signature_count = 0;
    Compiler.incremental_scanned_files = 0;
    Compiler.incremental_parsed_files = 0;
    Compiler.incremental_reused_files = 0;
    Compiler.incremental_failed_files = 0;
    Compiler.incremental_layout_changed_files = 0;
    Compiler.incremental_reused_functions = 0;
    Compiler.incremental_changed_functions = 0;
    Compiler.incremental_codegen_functions = 0;

    if (Compiler.file_count == 0) {
        // Backward-compatible single-source mode used by compiler_set_source().
        if (Compiler.source_len <= 0) {
            Compiler.status = CompilerStatus.Ok;
            return compiler_get_status_code();
        }

        Compiler.incremental_scanned_files = 1;
        Compiler.current_file_index = -1;
        Compiler.token_count = 0;
        Compiler.parse_index = 0;
        compiler_reset_current_function_tracking();

        if (!compiler_lex()) {
            Compiler.status = CompilerStatus.LexError;
            Compiler.incremental_failed_files = 1;
            return compiler_get_status_code();
        }

        if (!compiler_parse_program()) {
            Compiler.status = CompilerStatus.ParseError;
            Compiler.incremental_failed_files = 1;
            return compiler_get_status_code();
        }

        Compiler.incremental_parsed_files = 1;
        Compiler.incremental_changed_functions = Compiler.tracked_function_count;
        Compiler.incremental_codegen_functions = Compiler.tracked_function_count;
        Compiler.status = CompilerStatus.Ok;
        return compiler_get_status_code();
    }

    let i: i32 = 0;
    for (i = 0; i < Compiler.file_count; i += 1) {
        Compiler.incremental_scanned_files += 1;

        if (!Compiler.files[i].dirty) {
            Compiler.incremental_reused_files += 1;
            if (Compiler.files[i].last_status != CompilerStatus.Ok) {
                Compiler.incremental_failed_files += 1;
                compiler_replay_cached_error_for_file(i);
            } else {
                Compiler.incremental_reused_functions += Compiler.files[i].tracked_function_count;
            }
        } else {
            Compiler.current_file_index = i;
            let previous_layout_hash: i32 = Compiler.files[i].layout_hash;
            ascii_clear(Compiler.source);
            ascii_copy(Compiler.source, Compiler.files[i].source);
            Compiler.source_len = Compiler.files[i].source_len;
            Compiler.token_count = 0;
            Compiler.parse_index = 0;

            // Per-file counters from the active parse.
            Compiler.parsed_function_count = 0;
            Compiler.parsed_extern_count = 0;
            Compiler.parsed_return_count = 0;
            Compiler.parsed_call_count = 0;
            Compiler.parsed_let_count = 0;
            Compiler.parsed_if_count = 0;
            Compiler.parsed_for_count = 0;
            Compiler.parsed_foreach_count = 0;
            Compiler.parsed_assignment_count = 0;
            Compiler.parsed_global_count = 0;
            Compiler.layout_hash = 216613626;
            compiler_reset_current_function_tracking();
            Compiler.parsed_main_declaration_count = 0;
            Compiler.parsed_main_valid_i32_count = 0;
            Compiler.parsed_main_invalid_signature_count = 0;

            if (!compiler_lex()) {
                Compiler.files[i].last_status = CompilerStatus.LexError;
                Compiler.files[i].parsed_function_count = 0;
                Compiler.files[i].parsed_extern_count = 0;
                Compiler.files[i].parsed_return_count = 0;
                Compiler.files[i].parsed_call_count = 0;
                Compiler.files[i].parsed_let_count = 0;
                Compiler.files[i].parsed_if_count = 0;
                Compiler.files[i].parsed_for_count = 0;
                Compiler.files[i].parsed_foreach_count = 0;
                Compiler.files[i].parsed_assignment_count = 0;
                Compiler.files[i].parsed_global_count = 0;
                Compiler.files[i].layout_hash = 216613626;
                compiler_clear_file_function_tracking(i);
                Compiler.files[i].parsed_main_declaration_count = 0;
                Compiler.files[i].parsed_main_valid_i32_count = 0;
                Compiler.files[i].parsed_main_invalid_signature_count = 0;
                compiler_capture_last_error_for_file(i);
                Compiler.files[i].dirty = false;
                Compiler.incremental_failed_files += 1;
            } else {
                if (!compiler_parse_program()) {
                    Compiler.files[i].last_status = CompilerStatus.ParseError;
                    Compiler.files[i].parsed_function_count = 0;
                    Compiler.files[i].parsed_extern_count = 0;
                    Compiler.files[i].parsed_return_count = 0;
                    Compiler.files[i].parsed_call_count = 0;
                    Compiler.files[i].parsed_let_count = 0;
                    Compiler.files[i].parsed_if_count = 0;
                    Compiler.files[i].parsed_for_count = 0;
                    Compiler.files[i].parsed_foreach_count = 0;
                    Compiler.files[i].parsed_assignment_count = 0;
                    Compiler.files[i].parsed_global_count = 0;
                    Compiler.files[i].layout_hash = 216613626;
                    compiler_clear_file_function_tracking(i);
                    Compiler.files[i].parsed_main_declaration_count = 0;
                    Compiler.files[i].parsed_main_valid_i32_count = 0;
                    Compiler.files[i].parsed_main_invalid_signature_count = 0;
                    compiler_capture_last_error_for_file(i);
                    Compiler.files[i].dirty = false;
                    Compiler.incremental_failed_files += 1;
                } else {
                    Compiler.files[i].parsed_function_count = Compiler.parsed_function_count;
                    Compiler.files[i].parsed_extern_count = Compiler.parsed_extern_count;
                    Compiler.files[i].parsed_return_count = Compiler.parsed_return_count;
                    Compiler.files[i].parsed_call_count = Compiler.parsed_call_count;
                    Compiler.files[i].parsed_let_count = Compiler.parsed_let_count;
                    Compiler.files[i].parsed_if_count = Compiler.parsed_if_count;
                    Compiler.files[i].parsed_for_count = Compiler.parsed_for_count;
                    Compiler.files[i].parsed_foreach_count = Compiler.parsed_foreach_count;
                    Compiler.files[i].parsed_assignment_count = Compiler.parsed_assignment_count;
                    Compiler.files[i].parsed_global_count = Compiler.parsed_global_count;
                    Compiler.files[i].layout_hash = Compiler.layout_hash;
                    if (previous_layout_hash != Compiler.layout_hash) {
                        Compiler.incremental_layout_changed_files += 1;
                    }
                    compiler_record_dirty_file_function_metrics(i);
                    compiler_store_current_functions_to_file(i);
                    Compiler.files[i].parsed_main_declaration_count = Compiler.parsed_main_declaration_count;
                    Compiler.files[i].parsed_main_valid_i32_count = Compiler.parsed_main_valid_i32_count;
                    Compiler.files[i].parsed_main_invalid_signature_count = Compiler.parsed_main_invalid_signature_count;
                    Compiler.files[i].last_error_code = 0;
                    Compiler.files[i].last_error_pos = 0;
                    Compiler.files[i].last_error_detail_a = 0;
                    Compiler.files[i].last_error_detail_b = 0;
                    Compiler.files[i].last_status = CompilerStatus.Ok;
                    Compiler.files[i].dirty = false;
                    Compiler.incremental_parsed_files += 1;
                }
            }
        }
    }

    // Aggregate stable counts from file cache.
    Compiler.parsed_function_count = 0;
    Compiler.parsed_extern_count = 0;
    Compiler.parsed_return_count = 0;
    Compiler.parsed_call_count = 0;
    Compiler.parsed_let_count = 0;
    Compiler.parsed_if_count = 0;
    Compiler.parsed_for_count = 0;
    Compiler.parsed_foreach_count = 0;
    Compiler.parsed_assignment_count = 0;
    Compiler.parsed_global_count = 0;
    Compiler.layout_hash = 216613626;
    Compiler.parsed_main_declaration_count = 0;
    Compiler.parsed_main_valid_i32_count = 0;
    Compiler.parsed_main_invalid_signature_count = 0;
    let has_lex_error: i32 = 0;
    let has_parse_error: i32 = 0;
    for (i = 0; i < Compiler.file_count; i += 1) {
        Compiler.parsed_function_count += Compiler.files[i].parsed_function_count;
        Compiler.parsed_extern_count += Compiler.files[i].parsed_extern_count;
        Compiler.parsed_return_count += Compiler.files[i].parsed_return_count;
        Compiler.parsed_call_count += Compiler.files[i].parsed_call_count;
        Compiler.parsed_let_count += Compiler.files[i].parsed_let_count;
        Compiler.parsed_if_count += Compiler.files[i].parsed_if_count;
        Compiler.parsed_for_count += Compiler.files[i].parsed_for_count;
        Compiler.parsed_foreach_count += Compiler.files[i].parsed_foreach_count;
        Compiler.parsed_assignment_count += Compiler.files[i].parsed_assignment_count;
        Compiler.parsed_global_count += Compiler.files[i].parsed_global_count;
        Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, Compiler.files[i].layout_hash);
        Compiler.parsed_main_declaration_count += Compiler.files[i].parsed_main_declaration_count;
        Compiler.parsed_main_valid_i32_count += Compiler.files[i].parsed_main_valid_i32_count;
        Compiler.parsed_main_invalid_signature_count += Compiler.files[i].parsed_main_invalid_signature_count;
        if (Compiler.files[i].last_status == CompilerStatus.LexError) {
            has_lex_error = 1;
        }
        if (Compiler.files[i].last_status == CompilerStatus.ParseError) {
            has_parse_error = 1;
        }
    }

    if (has_lex_error == 1) {
        Compiler.status = CompilerStatus.LexError;
    } else {
        if (has_parse_error == 1) {
            Compiler.status = CompilerStatus.ParseError;
        } else {
            Compiler.status = CompilerStatus.Ok;
        }
    }

    return compiler_get_status_code();
}

function run_incremental_compiler(): i32 {
    return compiler_run_incremental_pipeline();
}

function compiler_validate_entry_main_i32(): i32 {
    if (Compiler.parsed_main_declaration_count <= 0) {
        return CompilerErrorCode.EntryMissingMain;
    }
    if (Compiler.parsed_main_declaration_count > 1) {
        return CompilerErrorCode.EntryMultipleMain;
    }
    if (Compiler.parsed_main_valid_i32_count != 1) {
        return CompilerErrorCode.EntryInvalidMainSignature;
    }
    if (Compiler.parsed_main_invalid_signature_count > 0) {
        return CompilerErrorCode.EntryInvalidMainSignature;
    }
    return 0;
}

function run_incremental_compiler_with_main_entry(): i32 {
    let pipeline_code: i32 = compiler_run_incremental_pipeline();
    if (pipeline_code != 0) {
        return pipeline_code;
    }
    return compiler_validate_entry_main_i32();
}

function compiler_capture_last_error_for_file(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }
    if (Compiler.error_count <= 0) {
        return;
    }
    let last: i32 = Compiler.error_count - 1;
    Compiler.files[file_index].last_error_code = Compiler.errors[last].code;
    Compiler.files[file_index].last_error_pos = Compiler.errors[last].pos;
    Compiler.files[file_index].last_error_detail_a = Compiler.errors[last].detail_a;
    Compiler.files[file_index].last_error_detail_b = Compiler.errors[last].detail_b;
}

function compiler_replay_cached_error_for_file(file_index: i32): void {
    if (file_index < 0 || file_index >= Compiler.file_count) {
        return;
    }
    if (Compiler.files[file_index].last_error_code == 0) {
        return;
    }
    compiler_push_error(
        Compiler.files[file_index].last_error_code,
        Compiler.files[file_index].last_error_pos,
        Compiler.files[file_index].last_error_detail_a,
        Compiler.files[file_index].last_error_detail_b
    );
}

function compiler_push_error(code: i32, pos: i32, detail_a: i32, detail_b: i32): void {
    if (Compiler.error_count >= COMPILER_MAX_ERRORS) {
        return;
    }
    let index: i32 = Compiler.error_count;
    Compiler.errors[index].code = code;
    Compiler.errors[index].pos = pos;
    Compiler.errors[index].detail_a = detail_a;
    Compiler.errors[index].detail_b = detail_b;
    Compiler.error_count += 1;
}

function compiler_emit_token(
    kind: TokenKind,
    start: i32,
    end: i32,
    int_value: i32,
    text_start: i32,
    text_len: i32
): bool {
    if (Compiler.token_count >= COMPILER_MAX_TOKENS) {
        compiler_push_error(CompilerErrorCode.LexTokenOverflow, start, Compiler.token_count, Compiler.current_file_index);
        return false;
    }
    let index: i32 = Compiler.token_count;
    Compiler.tokens[index].kind = kind;
    Compiler.tokens[index].start = start;
    Compiler.tokens[index].end = end;
    Compiler.tokens[index].int_value = int_value;
    Compiler.tokens[index].text_start = text_start;
    Compiler.tokens[index].text_len = text_len;
    Compiler.token_count += 1;
    return true;
}

function compiler_is_space(b: u8): bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

function compiler_is_digit(b: u8): bool {
    return b >= 48 && b <= 57;
}

function compiler_is_ident_start(b: u8): bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

function compiler_is_ident_continue(b: u8): bool {
    return compiler_is_ident_start(b) || compiler_is_digit(b);
}

function compiler_is_keyword_function(start: i32, len: i32): bool {
    if (len != 8) { return false; }
    if (Compiler.source[start + 0] != 102) { return false; } // f
    if (Compiler.source[start + 1] != 117) { return false; } // u
    if (Compiler.source[start + 2] != 110) { return false; } // n
    if (Compiler.source[start + 3] != 99) { return false; }  // c
    if (Compiler.source[start + 4] != 116) { return false; } // t
    if (Compiler.source[start + 5] != 105) { return false; } // i
    if (Compiler.source[start + 6] != 111) { return false; } // o
    if (Compiler.source[start + 7] != 110) { return false; } // n
    return true;
}

function compiler_is_keyword_extern(start: i32, len: i32): bool {
    if (len != 6) { return false; }
    if (Compiler.source[start + 0] != 101) { return false; } // e
    if (Compiler.source[start + 1] != 120) { return false; } // x
    if (Compiler.source[start + 2] != 116) { return false; } // t
    if (Compiler.source[start + 3] != 101) { return false; } // e
    if (Compiler.source[start + 4] != 114) { return false; } // r
    if (Compiler.source[start + 5] != 110) { return false; } // n
    return true;
}

function compiler_is_keyword_return(start: i32, len: i32): bool {
    if (len != 6) { return false; }
    if (Compiler.source[start + 0] != 114) { return false; } // r
    if (Compiler.source[start + 1] != 101) { return false; } // e
    if (Compiler.source[start + 2] != 116) { return false; } // t
    if (Compiler.source[start + 3] != 117) { return false; } // u
    if (Compiler.source[start + 4] != 114) { return false; } // r
    if (Compiler.source[start + 5] != 110) { return false; } // n
    return true;
}

function compiler_is_keyword_let(start: i32, len: i32): bool {
    if (len != 3) { return false; }
    if (Compiler.source[start + 0] != 108) { return false; } // l
    if (Compiler.source[start + 1] != 101) { return false; } // e
    if (Compiler.source[start + 2] != 116) { return false; } // t
    return true;
}

function compiler_is_keyword_if(start: i32, len: i32): bool {
    if (len != 2) { return false; }
    if (Compiler.source[start + 0] != 105) { return false; } // i
    if (Compiler.source[start + 1] != 102) { return false; } // f
    return true;
}

function compiler_is_keyword_else(start: i32, len: i32): bool {
    if (len != 4) { return false; }
    if (Compiler.source[start + 0] != 101) { return false; } // e
    if (Compiler.source[start + 1] != 108) { return false; } // l
    if (Compiler.source[start + 2] != 115) { return false; } // s
    if (Compiler.source[start + 3] != 101) { return false; } // e
    return true;
}

function compiler_is_keyword_for(start: i32, len: i32): bool {
    if (len != 3) { return false; }
    if (Compiler.source[start + 0] != 102) { return false; } // f
    if (Compiler.source[start + 1] != 111) { return false; } // o
    if (Compiler.source[start + 2] != 114) { return false; } // r
    return true;
}

function compiler_is_keyword_foreach(start: i32, len: i32): bool {
    if (len != 7) { return false; }
    if (Compiler.source[start + 0] != 102) { return false; } // f
    if (Compiler.source[start + 1] != 111) { return false; } // o
    if (Compiler.source[start + 2] != 114) { return false; } // r
    if (Compiler.source[start + 3] != 101) { return false; } // e
    if (Compiler.source[start + 4] != 97) { return false; }  // a
    if (Compiler.source[start + 5] != 99) { return false; }  // c
    if (Compiler.source[start + 6] != 104) { return false; } // h
    return true;
}

function compiler_is_keyword_in(start: i32, len: i32): bool {
    if (len != 2) { return false; }
    if (Compiler.source[start + 0] != 105) { return false; } // i
    if (Compiler.source[start + 1] != 110) { return false; } // n
    return true;
}

function compiler_is_keyword_global(start: i32, len: i32): bool {
    if (len != 6) { return false; }
    if (Compiler.source[start + 0] != 103) { return false; } // g
    if (Compiler.source[start + 1] != 108) { return false; } // l
    if (Compiler.source[start + 2] != 111) { return false; } // o
    if (Compiler.source[start + 3] != 98) { return false; }  // b
    if (Compiler.source[start + 4] != 97) { return false; }  // a
    if (Compiler.source[start + 5] != 108) { return false; } // l
    return true;
}

function compiler_lex_identifier_or_keyword(start: i32, end: i32): bool {
    let len: i32 = end - start;
    if (compiler_is_keyword_function(start, len)) {
        return compiler_emit_token(TokenKind.KwFunction, start, end, 0, start, len);
    }
    if (compiler_is_keyword_extern(start, len)) {
        return compiler_emit_token(TokenKind.KwExtern, start, end, 0, start, len);
    }
    if (compiler_is_keyword_return(start, len)) {
        return compiler_emit_token(TokenKind.KwReturn, start, end, 0, start, len);
    }
    if (compiler_is_keyword_let(start, len)) {
        return compiler_emit_token(TokenKind.KwLet, start, end, 0, start, len);
    }
    if (compiler_is_keyword_if(start, len)) {
        return compiler_emit_token(TokenKind.KwIf, start, end, 0, start, len);
    }
    if (compiler_is_keyword_else(start, len)) {
        return compiler_emit_token(TokenKind.KwElse, start, end, 0, start, len);
    }
    if (compiler_is_keyword_for(start, len)) {
        return compiler_emit_token(TokenKind.KwFor, start, end, 0, start, len);
    }
    if (compiler_is_keyword_foreach(start, len)) {
        return compiler_emit_token(TokenKind.KwForeach, start, end, 0, start, len);
    }
    if (compiler_is_keyword_in(start, len)) {
        return compiler_emit_token(TokenKind.KwIn, start, end, 0, start, len);
    }
    if (compiler_is_keyword_global(start, len)) {
        return compiler_emit_token(TokenKind.KwGlobal, start, end, 0, start, len);
    }
    return compiler_emit_token(TokenKind.Identifier, start, end, 0, start, len);
}

function compiler_emit_single_char_token(b: u8, index: i32): i32 {
    if (b == 40) {
        if (!compiler_emit_token(TokenKind.LParen, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 41) {
        if (!compiler_emit_token(TokenKind.RParen, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 123) {
        if (!compiler_emit_token(TokenKind.LBrace, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 125) {
        if (!compiler_emit_token(TokenKind.RBrace, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 91) {
        if (!compiler_emit_token(TokenKind.LBracket, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 93) {
        if (!compiler_emit_token(TokenKind.RBracket, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 58) {
        if (!compiler_emit_token(TokenKind.Colon, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 59) {
        if (!compiler_emit_token(TokenKind.Semicolon, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 44) {
        if (!compiler_emit_token(TokenKind.Comma, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 46) {
        if (!compiler_emit_token(TokenKind.Dot, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 43) {
        if (!compiler_emit_token(TokenKind.Plus, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 45) {
        if (!compiler_emit_token(TokenKind.Minus, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 42) {
        if (!compiler_emit_token(TokenKind.Star, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 47) {
        if (!compiler_emit_token(TokenKind.Slash, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 37) {
        if (!compiler_emit_token(TokenKind.Percent, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 61) {
        if (!compiler_emit_token(TokenKind.Assign, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 60) {
        if (!compiler_emit_token(TokenKind.Less, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 62) {
        if (!compiler_emit_token(TokenKind.Greater, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    if (b == 33) {
        if (!compiler_emit_token(TokenKind.Bang, index, index + 1, 0, index, 1)) { return -1; }
        return 1;
    }
    return 0;
}

function compiler_lex(): bool {
    let len: i32 = Compiler.source_len;
    let i: i32 = 0;
    for (i = 0; i < len; i += 1) {
        let b: u8 = Compiler.source[i];

        if (compiler_is_space(b)) {
            // Skip whitespace.
        } else {
            if (b == 47 && i + 1 < len && Compiler.source[i + 1] == 47) {
                // Line comments: // ...
                let found_nl: i32 = 0;
                let nl_pos: i32 = len;
                let j: i32 = 0;
                for (j = i + 2; j < len && found_nl == 0; j += 1) {
                    let c: u8 = Compiler.source[j];
                    if (c == 10 || c == 13) {
                        nl_pos = j;
                        found_nl = 1;
                    }
                }
                if (found_nl == 1) {
                    i = nl_pos;
                } else {
                    i = len;
                }
            } else {
                if (compiler_is_ident_start(b)) {
                    let start: i32 = i;
                    let end: i32 = i + 1;
                    let j: i32 = 0;
                    for (j = i + 1; j < len; j += 1) {
                        if (!compiler_is_ident_continue(Compiler.source[j])) {
                            end = j;
                            j = len;
                        } else {
                            end = j + 1;
                        }
                    }
                    if (!compiler_lex_identifier_or_keyword(start, end)) {
                        return false;
                    }
                    i = end - 1;
                } else {
                    if (compiler_is_digit(b)) {
                        let start: i32 = i;
                        let end: i32 = i + 1;
                        let value: i32 = u8_to_i32(b) - 48;
                        let j: i32 = 0;
                        for (j = i + 1; j < len; j += 1) {
                            let c: u8 = Compiler.source[j];
                            if (!compiler_is_digit(c)) {
                                end = j;
                                j = len;
                            } else {
                                value = value * 10 + (u8_to_i32(c) - 48);
                                end = j + 1;
                            }
                        }
                        if (!compiler_emit_token(TokenKind.IntLiteral, start, end, value, start, end - start)) {
                            return false;
                        }
                        i = end - 1;
                    } else {
                        if (b == 34) {
                            let start: i32 = i;
                            let found_end: i32 = 0;
                            let end: i32 = i + 1;
                            let j: i32 = 0;
                            for (j = i + 1; j < len && found_end == 0; j += 1) {
                                let c: u8 = Compiler.source[j];
                                if (c == 34) {
                                    found_end = 1;
                                    end = j + 1;
                                }
                            }
                            if (found_end == 0) {
                                compiler_push_error(CompilerErrorCode.LexUnterminatedString, start, 0, Compiler.current_file_index);
                                return false;
                            }
                            let text_start: i32 = start + 1;
                            let text_len: i32 = end - start - 2;
                            if (!compiler_emit_token(TokenKind.StringLiteral, start, end, 0, text_start, text_len)) {
                                return false;
                            }
                            i = end - 1;
                        } else {
                            let consumed_two_char: i32 = 0;
                            if (i + 1 < len) {
                                let next: u8 = Compiler.source[i + 1];
                                if (b == 43 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.PlusEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 45 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.MinusEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 42 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.StarEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 47 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.SlashEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 37 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.PercentEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 61 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.EqEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 33 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.NotEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 60 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.LessEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 62 && next == 61) {
                                    if (!compiler_emit_token(TokenKind.GreaterEq, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 38 && next == 38) {
                                    if (!compiler_emit_token(TokenKind.AndAnd, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                                if (consumed_two_char == 0 && b == 124 && next == 124) {
                                    if (!compiler_emit_token(TokenKind.OrOr, i, i + 2, 0, i, 2)) { return false; }
                                    i += 1;
                                    consumed_two_char = 1;
                                }
                            }
                            if (consumed_two_char == 0) {
                                let emitted: i32 = compiler_emit_single_char_token(b, i);
                                if (emitted == -1) {
                                    return false;
                                }
                                if (emitted == 0) {
                                    compiler_push_error(CompilerErrorCode.LexUnexpectedChar, i, u8_to_i32(b), Compiler.current_file_index);
                                    return false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if (!compiler_emit_token(TokenKind.Eof, len, len, 0, len, 0)) {
        return false;
    }
    return true;
}

function parser_current_kind(): TokenKind {
    if (Compiler.parse_index < Compiler.token_count) {
        return Compiler.tokens[Compiler.parse_index].kind;
    }
    return TokenKind.Eof;
}

function parser_current_pos(): i32 {
    if (Compiler.parse_index < Compiler.token_count) {
        return Compiler.tokens[Compiler.parse_index].start;
    }
    if (Compiler.token_count > 0) {
        return Compiler.tokens[Compiler.token_count - 1].end;
    }
    return 0;
}

function parser_error(code: CompilerErrorCode): void {
    compiler_push_error(code, parser_current_pos(), Compiler.parse_index, Compiler.current_file_index);
}

function parser_match(kind: TokenKind): bool {
    if (parser_current_kind() == kind) {
        Compiler.parse_index += 1;
        return true;
    }
    return false;
}

function parser_expect(kind: TokenKind, err_code: CompilerErrorCode): bool {
    if (parser_match(kind)) {
        return true;
    }
    parser_error(err_code);
    return false;
}

function parser_expect_identifier(): bool {
    if (parser_expect_identifier_capture()) {
        return true;
    }
    return false;
}

function parser_expect_identifier_capture(): bool {
    if (parser_current_kind() == TokenKind.Identifier) {
        Compiler.captured_identifier_start = Compiler.tokens[Compiler.parse_index].text_start;
        Compiler.captured_identifier_len = Compiler.tokens[Compiler.parse_index].text_len;
        Compiler.parse_index += 1;
        return true;
    }
    parser_error(CompilerErrorCode.ParseExpectIdentifier);
    return false;
}

function parser_parse_type_name(): bool {
    if (!parser_expect_identifier()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        if (!parser_match(TokenKind.LBracket)) {
            return true;
        }
        if (parser_current_kind() == TokenKind.IntLiteral) {
            Compiler.parse_index += 1;
        }
        if (!parser_expect(TokenKind.RBracket, CompilerErrorCode.ParseExpectRBracket)) {
            return false;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_identifier_text_eq(start: i32, len: i32, expected: ascii[]): bool {
    if (start < 0 || len < 0) {
        return false;
    }
    if (len != length(expected)) {
        return false;
    }
    let i: i32 = 0;
    for (i = 0; i < len; i += 1) {
        if (Compiler.source[start + i] != expected[i]) {
            return false;
        }
    }
    return true;
}

function parser_record_signature_main_entry(): void {
    if (!parser_identifier_text_eq(Compiler.current_signature_name_start, Compiler.current_signature_name_len, "main")) {
        return;
    }

    Compiler.parsed_main_declaration_count += 1;
    if (
        Compiler.current_signature_param_count == 0 &&
        parser_identifier_text_eq(Compiler.current_signature_return_type_start, Compiler.current_signature_return_type_len, "i32")
    ) {
        Compiler.parsed_main_valid_i32_count += 1;
    } else {
        Compiler.parsed_main_invalid_signature_count += 1;
    }
}

function parser_record_function_fingerprint(
    signature_start_token: i32,
    signature_end_token: i32,
    body_start_token: i32,
    body_end_token: i32
): void {
    if (signature_start_token < 0 || signature_end_token < signature_start_token) {
        return;
    }
    if (body_start_token < 0 || body_end_token < body_start_token) {
        return;
    }

    let id_hash: i32 = compiler_hash_source_span(
        216613626,
        Compiler.current_signature_name_start,
        Compiler.current_signature_name_len
    );

    let signature_start: i32 = Compiler.tokens[signature_start_token].start;
    let signature_end: i32 = Compiler.tokens[signature_end_token].end;
    let signature_hash: i32 = compiler_hash_source_span(
        216613626,
        signature_start,
        signature_end - signature_start
    );
    signature_hash = compiler_hash_mix(signature_hash, Compiler.current_signature_param_count);
    signature_hash = compiler_hash_mix(signature_hash, id_hash);

    let body_start: i32 = Compiler.tokens[body_start_token].start;
    let body_end: i32 = Compiler.tokens[body_end_token].end;
    let body_hash: i32 = compiler_hash_source_span(
        216613626,
        body_start,
        body_end - body_start
    );
    body_hash = compiler_hash_mix(body_hash, id_hash);

    compiler_record_current_function(id_hash, signature_hash, body_hash);
}

function parser_mix_layout_identifier_capture(): void {
    Compiler.layout_hash = compiler_hash_source_span(
        Compiler.layout_hash,
        Compiler.captured_identifier_start,
        Compiler.captured_identifier_len
    );
}

function parser_parse_type_name_layout_hash(): bool {
    if (!parser_expect_identifier_capture()) {
        return false;
    }
    parser_mix_layout_identifier_capture();
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        if (!parser_match(TokenKind.LBracket)) {
            return true;
        }
        Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, 91);
        if (parser_current_kind() == TokenKind.IntLiteral) {
            Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, Compiler.tokens[Compiler.parse_index].int_value);
            Compiler.parse_index += 1;
        } else {
            Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, -1);
        }
        if (!parser_expect(TokenKind.RBracket, CompilerErrorCode.ParseExpectRBracket)) {
            return false;
        }
        Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, 93);
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_global_declaration(): bool {
    Compiler.parsed_global_count += 1;
    Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, 103); // g
    if (!parser_expect_identifier_capture()) {
        return false;
    }
    parser_mix_layout_identifier_capture();
    if (!parser_expect(TokenKind.LBrace, CompilerErrorCode.ParseExpectLBrace)) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_BODY_STMTS; guard += 1) {
        if (parser_match(TokenKind.RBrace)) {
            return true;
        }
        if (!parser_expect_identifier_capture()) {
            return false;
        }
        parser_mix_layout_identifier_capture();
        if (!parser_expect(TokenKind.Colon, CompilerErrorCode.ParseExpectColon)) {
            return false;
        }
        if (!parser_parse_type_name_layout_hash()) {
            return false;
        }
        if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
            return false;
        }
        Compiler.layout_hash = compiler_hash_mix(Compiler.layout_hash, 59); // ;
    }
    parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
    return false;
}

function parser_parse_param_list(): bool {
    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }
    Compiler.current_signature_param_count = 0;
    if (parser_match(TokenKind.RParen)) {
        return true;
    }

    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARAMS; guard += 1) {
        if (!parser_expect_identifier()) {
            return false;
        }
        if (!parser_expect(TokenKind.Colon, CompilerErrorCode.ParseExpectColon)) {
            return false;
        }
        if (!parser_parse_type_name()) {
            return false;
        }
        Compiler.current_signature_param_count += 1;
        if (parser_match(TokenKind.Comma)) {
            // Continue with next parameter.
        } else {
            if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
                return false;
            }
            return true;
        }
    }

    parser_error(CompilerErrorCode.ParseParamGuardExhausted);
    return false;
}

function parser_parse_signature(is_extern: bool): bool {
    if (!parser_expect_identifier_capture()) {
        return false;
    }
    Compiler.current_signature_name_start = Compiler.captured_identifier_start;
    Compiler.current_signature_name_len = Compiler.captured_identifier_len;
    if (!parser_parse_param_list()) {
        return false;
    }
    if (!parser_expect(TokenKind.Colon, CompilerErrorCode.ParseExpectColon)) {
        return false;
    }
    if (!parser_expect_identifier_capture()) {
        return false;
    }
    Compiler.current_signature_return_type_start = Compiler.captured_identifier_start;
    Compiler.current_signature_return_type_len = Compiler.captured_identifier_len;
    if (!is_extern) {
        parser_record_signature_main_entry();
    }
    return true;
}

function parser_parse_primary(): bool {
    let kind: TokenKind = parser_current_kind();
    if (kind == TokenKind.LParen) {
        Compiler.parse_index += 1;
        if (!parser_parse_expression()) {
            return false;
        }
        return parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen);
    }
    if (kind == TokenKind.Identifier || kind == TokenKind.IntLiteral || kind == TokenKind.StringLiteral) {
        Compiler.parse_index += 1;
        return true;
    }
    parser_error(CompilerErrorCode.ParseExpectExpression);
    return false;
}

function parser_parse_expression(): bool {
    return parser_parse_assignment();
}

function parser_is_assignment_operator(kind: TokenKind): bool {
    if (kind == TokenKind.Assign) { return true; }
    if (kind == TokenKind.PlusEq) { return true; }
    if (kind == TokenKind.MinusEq) { return true; }
    if (kind == TokenKind.StarEq) { return true; }
    if (kind == TokenKind.SlashEq) { return true; }
    if (kind == TokenKind.PercentEq) { return true; }
    return false;
}

function parser_parse_postfix(): bool {
    if (!parser_parse_primary()) {
        return false;
    }

    let call_guard: i32 = 0;
    for (call_guard = 0; call_guard < COMPILER_MAX_CALL_NEST; call_guard += 1) {
        if (parser_match(TokenKind.LParen)) {
            Compiler.parsed_call_count += 1;
            if (parser_match(TokenKind.RParen)) {
                // Empty arg call.
            } else {
                if (!parser_parse_expression()) {
                    return false;
                }
                let arg_guard: i32 = 0;
                for (arg_guard = 0; arg_guard < COMPILER_MAX_ARGS; arg_guard += 1) {
                    if (parser_match(TokenKind.Comma)) {
                        if (!parser_parse_expression()) {
                            return false;
                        }
                    } else {
                        arg_guard = COMPILER_MAX_ARGS;
                    }
                }
                if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
                    return false;
                }
            }
        } else {
            if (parser_match(TokenKind.Dot)) {
                if (!parser_expect_identifier()) {
                    return false;
                }
            } else {
                if (parser_match(TokenKind.LBracket)) {
                    if (!parser_parse_expression()) {
                        return false;
                    }
                    if (!parser_expect(TokenKind.RBracket, CompilerErrorCode.ParseExpectRBracket)) {
                        return false;
                    }
                } else {
                    return true;
                }
            }
        }
    }

    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_unary(): bool {
    if (parser_match(TokenKind.Bang)) {
        return parser_parse_unary();
    }
    if (parser_match(TokenKind.Minus)) {
        return parser_parse_unary();
    }
    if (parser_match(TokenKind.Plus)) {
        return parser_parse_unary();
    }
    return parser_parse_postfix();
}

function parser_parse_multiplicative(): bool {
    if (!parser_parse_unary()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        let matched_op: i32 = 0;
        if (parser_match(TokenKind.Star)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.Slash)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.Percent)) {
            matched_op = 1;
        }
        if (matched_op == 0) {
            return true;
        }
        if (!parser_parse_unary()) {
            return false;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_additive(): bool {
    if (!parser_parse_multiplicative()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        let matched_op: i32 = 0;
        if (parser_match(TokenKind.Plus)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.Minus)) {
            matched_op = 1;
        }
        if (matched_op == 0) {
            return true;
        }
        if (!parser_parse_multiplicative()) {
            return false;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_comparison(): bool {
    if (!parser_parse_additive()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        let matched_op: i32 = 0;
        if (parser_match(TokenKind.Less)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.LessEq)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.Greater)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.GreaterEq)) {
            matched_op = 1;
        }
        if (matched_op == 0) {
            return true;
        }
        if (!parser_parse_additive()) {
            return false;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_equality(): bool {
    if (!parser_parse_comparison()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        let matched_op: i32 = 0;
        if (parser_match(TokenKind.EqEq)) {
            matched_op = 1;
        }
        if (matched_op == 0 && parser_match(TokenKind.NotEq)) {
            matched_op = 1;
        }
        if (matched_op == 0) {
            return true;
        }
        if (!parser_parse_comparison()) {
            return false;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_logical_and(): bool {
    if (!parser_parse_equality()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        if (parser_match(TokenKind.AndAnd)) {
            if (!parser_parse_equality()) {
                return false;
            }
        } else {
            return true;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_logical_or(): bool {
    if (!parser_parse_logical_and()) {
        return false;
    }
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_CALL_NEST; guard += 1) {
        if (parser_match(TokenKind.OrOr)) {
            if (!parser_parse_logical_and()) {
                return false;
            }
        } else {
            return true;
        }
    }
    parser_error(CompilerErrorCode.ParseCallGuardExhausted);
    return false;
}

function parser_parse_assignment(): bool {
    if (!parser_parse_logical_or()) {
        return false;
    }
    let kind: TokenKind = parser_current_kind();
    if (parser_is_assignment_operator(kind)) {
        Compiler.parse_index += 1;
        Compiler.parsed_assignment_count += 1;
        return parser_parse_assignment();
    }
    return true;
}

function parser_parse_block(): bool {
    if (!parser_expect(TokenKind.LBrace, CompilerErrorCode.ParseExpectLBrace)) {
        return false;
    }

    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_BODY_STMTS; guard += 1) {
        if (parser_match(TokenKind.RBrace)) {
            return true;
        }
        if (!parser_parse_statement()) {
            return false;
        }
    }

    parser_error(CompilerErrorCode.ParseBodyGuardExhausted);
    return false;
}

function parser_parse_let_statement(): bool {
    if (!parser_expect_identifier()) {
        return false;
    }
    let has_type: i32 = 0;
    let has_initializer: i32 = 0;
    if (parser_match(TokenKind.Colon)) {
        has_type = 1;
        if (!parser_parse_type_name()) {
            return false;
        }
    }
    if (parser_match(TokenKind.Assign)) {
        has_initializer = 1;
        Compiler.parsed_assignment_count += 1;
        if (!parser_parse_expression()) {
            return false;
        }
    }
    if (has_type == 0 && has_initializer == 0) {
        parser_error(CompilerErrorCode.ParseExpectAssignInLet);
        return false;
    }
    return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
}

function parser_parse_if_statement(): bool {
    Compiler.parsed_if_count += 1;
    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }
    if (!parser_parse_expression()) {
        return false;
    }
    if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
        return false;
    }
    if (!parser_parse_block()) {
        return false;
    }
    if (parser_match(TokenKind.KwElse)) {
        if (parser_match(TokenKind.KwIf)) {
            return parser_parse_if_statement();
        }
        if (!parser_parse_block()) {
            return false;
        }
    }
    return true;
}

function parser_parse_let_clause_without_semicolon(): bool {
    if (!parser_expect_identifier()) {
        return false;
    }
    let has_type: i32 = 0;
    if (parser_match(TokenKind.Colon)) {
        has_type = 1;
        if (!parser_parse_type_name()) {
            return false;
        }
    }
    if (!parser_match(TokenKind.Assign)) {
        parser_error(CompilerErrorCode.ParseExpectAssignInLet);
        return false;
    }
    Compiler.parsed_assignment_count += 1;
    if (!parser_parse_expression()) {
        return false;
    }
    if (has_type == 1) {
        // Declaration with explicit type and initializer.
    }
    return true;
}

function parser_parse_for_statement(): bool {
    Compiler.parsed_for_count += 1;
    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }

    if (parser_match(TokenKind.KwLet)) {
        Compiler.parsed_let_count += 1;
        if (!parser_parse_let_clause_without_semicolon()) {
            return false;
        }
    } else {
        if (!parser_parse_expression()) {
            return false;
        }
    }

    if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
        return false;
    }

    if (!parser_parse_expression()) {
        return false;
    }
    if (!parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon)) {
        return false;
    }

    if (!parser_parse_expression()) {
        return false;
    }
    if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
        return false;
    }

    return parser_parse_block();
}

function parser_parse_foreach_statement(): bool {
    Compiler.parsed_foreach_count += 1;
    if (!parser_expect(TokenKind.LParen, CompilerErrorCode.ParseExpectLParen)) {
        return false;
    }
    parser_match(TokenKind.KwLet);
    if (!parser_expect_identifier()) {
        return false;
    }
    if (parser_match(TokenKind.Comma)) {
        if (!parser_expect_identifier()) {
            return false;
        }
    }
    if (!parser_expect(TokenKind.KwIn, CompilerErrorCode.ParseExpectIn)) {
        return false;
    }
    if (!parser_parse_expression()) {
        return false;
    }
    if (!parser_expect(TokenKind.RParen, CompilerErrorCode.ParseExpectRParen)) {
        return false;
    }

    return parser_parse_block();
}

function parser_parse_statement(): bool {
    if (parser_match(TokenKind.KwLet)) {
        Compiler.parsed_let_count += 1;
        return parser_parse_let_statement();
    }
    if (parser_match(TokenKind.KwIf)) {
        return parser_parse_if_statement();
    }
    if (parser_match(TokenKind.KwFor)) {
        return parser_parse_for_statement();
    }
    if (parser_match(TokenKind.KwForeach)) {
        return parser_parse_foreach_statement();
    }
    if (parser_current_kind() == TokenKind.LBrace) {
        return parser_parse_block();
    }
    if (parser_match(TokenKind.KwReturn)) {
        Compiler.parsed_return_count += 1;
        if (parser_match(TokenKind.Semicolon)) {
            return true;
        }
        if (!parser_parse_expression()) {
            parser_error(CompilerErrorCode.ParseExpectReturnExpr);
            return false;
        }
        return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
    }
    if (!parser_parse_expression()) {
        return false;
    }
    return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
}

function parser_parse_function_body(): bool {
    return parser_parse_block();
}

function parser_parse_item(): bool {
    if (parser_match(TokenKind.KwGlobal)) {
        return parser_parse_global_declaration();
    }

    if (parser_match(TokenKind.KwExtern)) {
        if (!parser_expect(TokenKind.KwFunction, CompilerErrorCode.ParseExpectFunctionAfterExtern)) {
            return false;
        }
        if (!parser_parse_signature(true)) {
            return false;
        }
        Compiler.parsed_extern_count += 1;
        return parser_expect(TokenKind.Semicolon, CompilerErrorCode.ParseExpectSemicolon);
    }

    if (parser_match(TokenKind.KwFunction)) {
        let signature_start_token: i32 = Compiler.parse_index;
        if (!parser_parse_signature(false)) {
            return false;
        }
        let signature_end_token: i32 = Compiler.parse_index - 1;
        let body_start_token: i32 = Compiler.parse_index;
        Compiler.parsed_function_count += 1;
        if (!parser_parse_function_body()) {
            return false;
        }
        let body_end_token: i32 = Compiler.parse_index - 1;
        parser_record_function_fingerprint(
            signature_start_token,
            signature_end_token,
            body_start_token,
            body_end_token
        );
        return true;
    }

    parser_error(CompilerErrorCode.ParseExpectFunctionOrExtern);
    return false;
}

function compiler_parse_program(): bool {
    Compiler.parse_index = 0;
    let guard: i32 = 0;
    for (guard = 0; guard < COMPILER_MAX_PARSE_GUARD; guard += 1) {
        if (parser_current_kind() == TokenKind.Eof) {
            return true;
        }
        if (!parser_parse_item()) {
            return false;
        }
    }
    parser_error(CompilerErrorCode.ParseItemGuardExhausted);
    return false;
}

