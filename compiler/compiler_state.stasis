const COMPILER_MAX_SOURCE: i32 = 131072;
const COMPILER_MAX_TOKENS: i32 = 32768;
const COMPILER_MAX_ERRORS: i32 = 64;
const COMPILER_MAX_FILES: i32 = 128;
const COMPILER_MAX_PATH: i32 = 260;
const COMPILER_MAX_PARSE_GUARD: i32 = 32768;
const COMPILER_MAX_PARAMS: i32 = 64;
const COMPILER_MAX_ARGS: i32 = 256;
const COMPILER_MAX_BODY_STMTS: i32 = 16384;
const COMPILER_MAX_CALL_NEST: i32 = 1024;
const COMPILER_MAX_TRACKED_FUNCTIONS: i32 = 512;

enum CompilerErrorCode {
    None = 0,
    EntryMissingMain = 41,
    EntryInvalidMainSignature = 42,
    EntryMultipleMain = 43,
    LexUnexpectedChar = 1001,
    LexUnterminatedString = 1002,
    LexTokenOverflow = 1003,
    ParseExpectFunctionOrExtern = 2001,
    ParseExpectFunctionAfterExtern = 2002,
    ParseExpectIdentifier = 2003,
    ParseExpectLParen = 2004,
    ParseExpectRParen = 2005,
    ParseExpectColon = 2006,
    ParseExpectSemicolon = 2007,
    ParseExpectLBrace = 2008,
    ParseExpectRBrace = 2009,
    ParseExpectExpression = 2010,
    ParseExpectReturnExpr = 2011,
    ParseItemGuardExhausted = 2012,
    ParseParamGuardExhausted = 2013,
    ParseArgGuardExhausted = 2014,
    ParseBodyGuardExhausted = 2015,
    ParseCallGuardExhausted = 2016,
    ParseExpectAssignInLet = 2017,
    ParseExpectRBracket = 2018,
    ParseExpectIn = 2019,
    IncrementalFileOverflow = 3001,
    IncrementalFilePathEmpty = 3002
}

enum CompilerStatus {
    Idle,
    Ok,
    LexError,
    ParseError
}

enum TokenKind {
    Invalid,
    Identifier,
    IntLiteral,
    StringLiteral,
    KwFunction,
    KwExtern,
    KwReturn,
    KwLet,
    KwIf,
    KwElse,
    KwFor,
    KwForeach,
    KwIn,
    KwGlobal,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Colon,
    Semicolon,
    Comma,
    Dot,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Assign,
    PlusEq,
    MinusEq,
    StarEq,
    SlashEq,
    PercentEq,
    EqEq,
    NotEq,
    Less,
    LessEq,
    Greater,
    GreaterEq,
    AndAnd,
    OrOr,
    Bang,
    Eof
}

struct CompilerToken {
    kind: TokenKind;
    start: i32;
    end: i32;
    int_value: i32;
    text_start: i32;
    text_len: i32;
}

struct CompilerError {
    code: i32;
    pos: i32;
    detail_a: i32;
    detail_b: i32;
}

struct CompilerFile {
    path: ascii[260];
    source: ascii[131072];
    source_len: i32;
    source_hash: i32;
    dirty: bool;
    last_status: CompilerStatus;
    parsed_function_count: i32;
    parsed_extern_count: i32;
    parsed_return_count: i32;
    parsed_call_count: i32;
    parsed_let_count: i32;
    parsed_if_count: i32;
    parsed_for_count: i32;
    parsed_foreach_count: i32;
    parsed_assignment_count: i32;
    parsed_global_count: i32;
    layout_hash: i32;
    tracked_function_count: i32;
    function_id_hashes: i32[512];
    function_sig_hashes: i32[512];
    function_body_hashes: i32[512];
    parsed_main_declaration_count: i32;
    parsed_main_valid_i32_count: i32;
    parsed_main_invalid_signature_count: i32;
    last_error_code: i32;
    last_error_pos: i32;
    last_error_detail_a: i32;
    last_error_detail_b: i32;
}

struct CompilerState {
    source: ascii[131072];
    source_len: i32;

    files: CompilerFile[128];
    file_count: i32;
    current_file_index: i32;

    tokens: CompilerToken[32768];
    token_count: i32;
    parse_index: i32;

    status: CompilerStatus;
    errors: CompilerError[64];
    error_count: i32;

    parsed_function_count: i32;
    parsed_extern_count: i32;
    parsed_return_count: i32;
    parsed_call_count: i32;
    parsed_let_count: i32;
    parsed_if_count: i32;
    parsed_for_count: i32;
    parsed_foreach_count: i32;
    parsed_assignment_count: i32;
    parsed_global_count: i32;
    layout_hash: i32;
    tracked_function_count: i32;
    function_id_hashes: i32[512];
    function_sig_hashes: i32[512];
    function_body_hashes: i32[512];
    parsed_main_declaration_count: i32;
    parsed_main_valid_i32_count: i32;
    parsed_main_invalid_signature_count: i32;

    captured_identifier_start: i32;
    captured_identifier_len: i32;
    current_signature_name_start: i32;
    current_signature_name_len: i32;
    current_signature_param_count: i32;
    current_signature_return_type_start: i32;
    current_signature_return_type_len: i32;

    incremental_scanned_files: i32;
    incremental_parsed_files: i32;
    incremental_reused_files: i32;
    incremental_failed_files: i32;
    incremental_layout_changed_files: i32;
    incremental_reused_functions: i32;
    incremental_changed_functions: i32;
    incremental_codegen_functions: i32;
}

global Compiler: CompilerState;

