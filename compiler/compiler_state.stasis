const COMPILER_MAX_SOURCE: i32 = 262144;
const COMPILER_MAX_TOKENS: i32 = 32768;
const COMPILER_MAX_ERRORS: i32 = 64;
const COMPILER_MAX_FILES: i32 = 128;
const COMPILER_MAX_PATH: i32 = 260;
const COMPILER_MAX_PARSE_GUARD: i32 = 32768;
const COMPILER_MAX_PARAMS: i32 = 64;
const COMPILER_MAX_ARGS: i32 = 256;
const COMPILER_MAX_BODY_STMTS: i32 = 16384;
const COMPILER_MAX_CALL_NEST: i32 = 1024;
const COMPILER_MAX_TRACKED_FUNCTIONS: i32 = 512;
const COMPILER_MAX_TRACKED_PARAM_HASHES: i32 = 4;
const COMPILER_MAX_EVAL_BINDINGS: i32 = 256;
const COMPILER_MAX_EVAL_CALL_DEPTH: i32 = 16;
const COMPILER_MAX_EVAL_CALL_ARGS: i32 = 4;
const COMPILER_MAX_LAYOUT_STRUCTS: i32 = 64;
const COMPILER_MAX_LAYOUT_GLOBALS: i32 = 64;
const COMPILER_MAX_LAYOUT_FIELDS_PER_DECL: i32 = 32;
const COMPILER_MAX_LAYOUT_FLAT_FIELDS: i32 = 2048;
const COMPILER_MAX_FUNCTION_CALL_EDGES: i32 = 8;
const COMPILER_MAX_REQUIRED_REACHABILITY_ROOTS: i32 = 64;
const COMPILER_MAX_FILE_FUNCTION_SLOTS: i32 = 65536;
const COMPILER_MAX_FILE_FUNCTION_CALL_EDGE_SLOTS: i32 = 524288;
const COMPILER_MAX_FILE_FUNCTION_HASH_BUCKETS: i32 = 65536;

enum CompilerErrorCode {
    None = 0,
    EntryMissingMain = 41,
    EntryInvalidMainSignature = 42,
    EntryMultipleMain = 43,
    LexUnexpectedChar = 1001,
    LexUnterminatedString = 1002,
    LexTokenOverflow = 1003,
    ParseExpectFunctionOrExtern = 2001,
    ParseExpectFunctionAfterExtern = 2002,
    ParseExpectIdentifier = 2003,
    ParseExpectLParen = 2004,
    ParseExpectRParen = 2005,
    ParseExpectColon = 2006,
    ParseExpectSemicolon = 2007,
    ParseExpectLBrace = 2008,
    ParseExpectRBrace = 2009,
    ParseExpectExpression = 2010,
    ParseExpectReturnExpr = 2011,
    ParseItemGuardExhausted = 2012,
    ParseParamGuardExhausted = 2013,
    ParseArgGuardExhausted = 2014,
    ParseBodyGuardExhausted = 2015,
    ParseCallGuardExhausted = 2016,
    ParseExpectAssignInLet = 2017,
    ParseExpectRBracket = 2018,
    ParseExpectIn = 2019,
    ParseExpectFunctionAfterExport = 2020,
    ParseExpectAssignInConst = 2021,
    ParseExpectStringLiteral = 2022,
    SemanticFromConversionExpression = 4001,
    IncrementalFileOverflow = 3001,
    IncrementalFilePathEmpty = 3002
}

enum CompilerStatus {
    Idle,
    Ok,
    LexError,
    ParseError
}

enum TokenKind {
    Invalid,
    Identifier,
    IntLiteral,
    StringLiteral,
    KwFunction,
    KwExtern,
    KwImport,
    KwConst,
    KwStruct,
    KwEnum,
    KwExport,
    KwReturn,
    KwLet,
    KwIf,
    KwElse,
    KwFor,
    KwForeach,
    KwIn,
    KwGlobal,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Colon,
    Semicolon,
    Comma,
    Dot,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Assign,
    PlusEq,
    MinusEq,
    StarEq,
    SlashEq,
    PercentEq,
    EqEq,
    NotEq,
    Less,
    LessEq,
    Greater,
    GreaterEq,
    AndAnd,
    OrOr,
    Bang,
    At,
    Eof
}

struct CompilerToken {
    kind: TokenKind;
    start: i32;
    end: i32;
    int_value: i32;
    text_start: i32;
    text_len: i32;
}

struct CompilerError {
    code: i32;
    pos: i32;
    detail_a: i32;
    detail_b: i32;
}

struct CompilerFile {
    path: ascii[260];
    source: ascii[262144];
    source_len: i32;
    source_hash: i32;
    dirty: bool;
    last_status: CompilerStatus;
    layout_hash: i32;
    tracked_function_count: i32;
    function_id_hashes: i32[512];
    function_sig_hashes: i32[512];
    function_body_hashes: i32[512];
    function_return_type_codes: i32[512];
    function_param_counts: i32[512];
    function_first_param_type_codes: i32[512];
    function_simple_i32_return_literal_flags: i32[512];
    function_simple_i32_return_literals: i32[512];
    parsed_main_declaration_count: i32;
    parsed_main_valid_i32_count: i32;
    parsed_main_invalid_signature_count: i32;
    last_error_code: i32;
    last_error_pos: i32;
    last_error_detail_a: i32;
    last_error_detail_b: i32;
}

struct CompilerState {
    source: ascii[262144];
    source_len: i32;

    files: CompilerFile[128];
    file_count: i32;
    current_file_index: i32;

    tokens: CompilerToken[32768];
    token_count: i32;
    parse_index: i32;

    status: CompilerStatus;
    errors: CompilerError[64];
    error_count: i32;

    layout_hash: i32;
    tracked_function_count: i32;
    function_id_hashes: i32[512];
    function_sig_hashes: i32[512];
    function_body_hashes: i32[512];
    function_signature_start_tokens: i32[512];
    function_signature_end_tokens: i32[512];
    function_body_start_tokens: i32[512];
    function_body_end_tokens: i32[512];
    function_param_name_hashes: i32[2048];
    function_return_type_codes: i32[512];
    function_param_counts: i32[512];
    function_first_param_type_codes: i32[512];
    function_simple_i32_return_literal_flags: i32[512];
    function_simple_i32_return_literals: i32[512];
    function_call_edge_counts: i32[512];
    function_call_edge_hashes: i32[4096];
    file_function_reachable_flags: i32[65536];
    file_function_call_edge_counts: i32[65536];
    file_function_call_edge_hashes: i32[524288];
    file_function_hash_bucket_heads: i32[65536];
    file_function_hash_next: i32[65536];
    file_function_slot_file_indices: i32[65536];
    file_function_slot_function_indices: i32[65536];
    function_reachable_flags: i32[512];
    reachability_queue: i32[512];
    required_reachability_root_count: i32;
    required_reachability_root_hashes: i32[64];
    parsed_main_declaration_count: i32;
    parsed_main_valid_i32_count: i32;
    parsed_main_invalid_signature_count: i32;
    layout_struct_count: i32;
    layout_struct_name_hashes: i32[64];
    layout_struct_field_counts: i32[64];
    layout_struct_field_name_hashes: i32[2048];
    layout_struct_field_type_hashes: i32[2048];
    layout_struct_reachable_flags: i32[64];
    layout_struct_reachability_queue: i32[64];
    layout_global_count: i32;
    layout_global_name_hashes: i32[64];
    layout_global_field_counts: i32[64];
    layout_global_field_name_hashes: i32[2048];
    layout_global_field_type_hashes: i32[2048];
    layout_global_reachable_flags: i32[64];
    layout_flat_field_count: i32;
    layout_flat_field_path_hashes: i32[2048];
    layout_flat_field_offsets: i32[2048];
    layout_memory_size_bytes: i32;

    captured_identifier_start: i32;
    captured_identifier_len: i32;
    current_signature_name_start: i32;
    current_signature_name_len: i32;
    current_signature_param_count: i32;
    current_signature_first_param_type_code: i32;
    current_signature_param_name_hashes: i32[4];
    current_signature_return_type_start: i32;
    current_signature_return_type_len: i32;
    current_simple_i32_return_literal_flag: i32;
    current_simple_i32_return_literal_value: i32;
    clif_call_conv_code: i32;
    clif_symbol_buffer: ascii[128];

    eval_binding_count: i32;
    eval_binding_name_hashes: i32[256];
    eval_binding_values: i32[256];
    eval_field_count: i32;
    eval_field_used: i32[256];
    eval_field_path_hashes: i32[256];
    eval_field_values: i32[256];
    eval_call_depth: i32;
    eval_call_stack_id_hashes: i32[16];
    eval_cursor: i32;
    eval_last_i32: i32;
    eval_returned: bool;
    eval_return_value: i32;

    incremental_scanned_files: i32;
    incremental_parsed_files: i32;
    incremental_reused_files: i32;
    incremental_failed_files: i32;
    incremental_layout_changed_files: i32;
    incremental_reused_functions: i32;
    incremental_changed_functions: i32;
    incremental_codegen_functions: i32;
}

global Compiler: CompilerState;

